<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Pin the patched native SQLite bundle (3.x line) so the transitive SQLitePCLRaw.lib.e_sqlite3
         2.1.11 with GHSA-2m69-gcr7-jv3q (High) is not used. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- Pin the patched System.Security.Cryptography.Pkcs (9.x line, what SqlClient resolves to here) so the
         transitive 9.0.13 with GHSA-846f-f764-76mx (High) and GHSA-2fmv-rv2c-59x7 (Moderate) is not used.
         Flows into Matmon.Probe and Matmon.Agent; Matmon.Host lifts it to 10.x for MimeKit and pins its own. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

</Project>

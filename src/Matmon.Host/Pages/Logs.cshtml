@page
@model Matmon.Host.Pages.LogsModel
@{
    ViewData["Title"] = "System";
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("System", "/Config"), new BreadcrumbItem("Logs") };

    // The lowest level shown. As before, no level in the address means "Info & up", and a level the list does not know
    // selects nothing - the view then shows everything (Trace), which is what the old select fell back to.
    // The same view as Matmon.Cloud's Admin > Logs: the search in the toolbar, the level in a dialog of its own, Live and
    // Refresh at the toolbar's end (logs.js, initializeLogViewer).
    var levels = new (string Value, string Label)[]
    {
        ("Trace", "All"),
        ("Debug", "Debug & up"),
        ("Information", "Info & up"),
        ("Warning", "Warning & up"),
        ("Error", "Error & up"),
        ("Critical", "Critical only")
    };
    var level = Model.Level is null ? "Information" : Model.Level;
    if (!levels.Any(l => l.Value == level))
    {
        level = "Trace";
    }
    var levelLabel = levels.First(l => l.Value == level).Label;
}

<partial name="_SystemTabs" model="@("logs")" />

<div class="mat-list" data-log>
    <div class="mat-toolbar" role="toolbar" aria-label="Log tools">
        <div class="mat-input-icon mat-toolbar__search">
            @MatUi.Icon("search")
            <input class="mat-input" type="search" id="log-search" value="@Model.Q" placeholder="Message or source…" aria-label="Search the log"
                   autocomplete="off" enterkeyhint="search" data-shortcut="/" data-log-search />
        </div>
        <span class="mat-toolbar__spacer"></span>
        <span class="mat-toolbar__info"><span data-log-count>0</span> lines · buffer @Model.Capacity</span>
        <div class="mat-toolbar__end">
            <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn@(level != "Information" ? " is-active" : string.Empty)" data-dialog-open="log-level" aria-haspopup="dialog" data-log-level-button>
                @MatUi.Icon("sliders")<span>Level</span><small data-log-level-label>@levelLabel</small>
            </button>
            <label class="mat-switch"><input type="checkbox" id="log-live" checked data-log-live /><span class="mat-switch__track"></span><span>Live</span></label>
            <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn" data-log-refresh>@MatUi.Icon("refresh")<span>Refresh</span></button>
        </div>
    </div>

    <div class="mat-table-wrap" data-log-table>
        <table class="mat-table mat-table--compact">
            <caption class="mat-sr-only">Application log, newest first</caption>
            <thead>
                <tr>
                    <th scope="col">Time</th>
                    <th scope="col">Level</th>
                    <th scope="col" class="mat-hide-sm">Source</th>
                    <th scope="col">Message</th>
                </tr>
            </thead>
            <tbody data-log-rows></tbody>
        </table>
    </div>

    <div class="mat-empty" data-log-empty hidden>
        <span class="mat-empty__icon">@MatUi.Icon("file-text")</span>
        <div class="mat-empty__title">No log lines match</div>
        <p>Change the search or the level - or wait for the next lines while Live is on.</p>
    </div>

    <div class="mat-actions">
        <form method="post" asp-page-handler="Clear">
            <input type="hidden" name="Level" value="@Model.Level" />
            <input type="hidden" name="Q" value="@Model.Q" />
            <button type="submit" class="mat-btn mat-btn--danger" data-confirm="Clear the in-memory log buffer?" data-confirm-ok="Clear">@MatUi.Icon("trash")<span>Clear</span></button>
        </form>
    </div>
</div>

<dialog class="mat-dialog mat-dialog--sm" id="log-level" aria-labelledby="log-level-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">
            @MatUi.Icon("sliders")
            <h2 class="mat-dialog__title" id="log-level-title">Level</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
        </div>
        <div class="mat-dialog__body mat-form">
            <fieldset class="mat-field mat-fieldset">
                <legend class="mat-label">Show lines from</legend>
                <div class="mat-options">
                    @foreach (var l in levels)
                    {
                        <label class="mat-option"><input type="radio" id="log-level-@l.Value.ToLowerInvariant()" name="log-level" value="@l.Value" checked="@(l.Value == level)" data-log-level /><span>@l.Label</span></label>
                    }
                </div>
            </fieldset>
            <p class="mat-hint">The view follows the choice at once.</p>
        </div>
        <div class="mat-dialog__foot">
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="button" class="mat-btn mat-btn--primary" data-dialog-close>@MatUi.Icon("check")<span>Done</span></button>
            </div>
        </div>
    </div>
</dialog>

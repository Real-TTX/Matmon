@page "/agents"
@model Matmon.Host.Pages.AgentsModel
@{
    ViewData["Title"] = "Probes";
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("Probes", "/Probes"), new BreadcrumbItem("Agents") };
    var isAdmin = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
    var issuedExpires = Model.IssuedExpiresUtc is { } expiresUtc
        ? new DateTimeOffset(DateTime.SpecifyKind(expiresUtc, DateTimeKind.Utc))
        : (DateTimeOffset?)null;
}

<partial name="_ProbesTabs" model="@("agents")" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.IssuedCode))
{
    @* The code just issued: shown on exactly this render, then gone for good (only its hash is stored; the plain code stays
       in this process's memory so the download buttons keep working for its lifetime). It gets read out over the phone,
       so it is big and monospaced. *@
    <div class="mat-alert mat-alert--success" role="status">
        @MatUi.Icon("key")
        <div class="mat-alert__body">
            <span class="mat-alert__title">Enrolment code@(string.IsNullOrWhiteSpace(Model.IssuedName) ? string.Empty : $" for {Model.IssuedName}")</span>
            <span>Single use@(issuedExpires is { } expires ? $", valid until {expires.ToDisplay():g}" : string.Empty). Shown only now - the downloads below keep working until it is used or expires.</span>
            <div class="mat-input-group">
                <input class="mat-input mat-mono agent-code-input" id="agent-issued-code" value="@Model.IssuedCode" readonly aria-label="Enrolment code" />
                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#agent-issued-code">@MatUi.Icon("copy")<span>Copy</span></button>
            </div>
        </div>
    </div>

    @if (Model.IssuedReplaces)
    {
        <div class="mat-alert mat-alert--warning" role="status">
            @MatUi.Icon("alert")
            <div class="mat-alert__body">This code re-installs the agent <strong>@Model.IssuedName</strong> - its host, sensors, history and alerts stay. Whatever runs as that agent now is locked out once the new install enrols.</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.IssuedHostName))
    {
        <div class="mat-alert mat-alert--info" role="status">
            @MatUi.Icon("info")
            <div class="mat-alert__body">When the agent enrols, the host <strong>@Model.IssuedHostName</strong> becomes its machine: its sensors run on the agent from then on.</div>
        </div>
    }

    <section class="mat-card" id="agent-install">
        <div class="mat-card__head">
            @MatUi.Icon("download")
            <h2 class="mat-card__title">Install the agent</h2>
        </div>
        <div class="mat-card__body mat-stack">
            @if (Model.IssuedViaRemote)
            {
                <p class="mat-muted">The agent talks through the probe <strong>@Model.IssuedVia!.Name</strong>, which passes everything on to this instance - the machine only has to reach that probe.</p>
            }
            @if (Model.IssuedAgentUrl is null)
            {
                <div class="mat-alert mat-alert--warning" role="status">
                    @MatUi.Icon("alert")
                    @if (Model.IssuedViaRemote)
                    {
                        <div class="mat-alert__body">Nobody has set the address agents use to reach the probe <strong>@Model.IssuedVia!.Name</strong>. Set it in <a asp-page="/ElementEditor" asp-route-selectedId="@Model.IssuedVia.Id" asp-route-returnUrl="/agents">the probe's settings</a>, then create a new code.</div>
                    }
                    else
                    {
                        <div class="mat-alert__body">This instance does not know the address agents should connect to. Set the public address under <a asp-page="/Config" asp-route-tab="general">System &gt; General</a> (or open Matmon directly once), then create a new code.</div>
                    }
                </div>
            }
            else
            {
                @if (Model.Packages.Count == 0)
                {
                    <div class="mat-alert mat-alert--warning" role="status">
                        @MatUi.Icon("alert")
                        <div class="mat-alert__body">@(Model.Catalog.Problem ?? "This instance has no agent packages to hand out right now.")</div>
                    </div>
                }
                else
                {
                    <div class="mat-stack mat-stack--sm">
                        <span class="mat-label">Download - the code is inside, so the agent sets itself up</span>
                        <div class="mat-btn-row mat-btn-row--plain">
                            @foreach (var package in Model.Packages)
                            {
                                <a class="mat-btn @(package.Platform.IsWindows ? "mat-btn--primary" : "mat-btn--secondary")" href="@Model.InstallerUrl(package, Model.IssuedEnrollmentId!.Value)">@MatUi.Icon("download")<span>@AgentsModel.InstallerLabel(package.Platform)</span></a>
                            }
                        </div>
                        <span class="mat-hint">Windows: double-click and press Install. Linux / macOS: <code>chmod +x</code> the file, then <code>sudo ./&lt;file&gt; install</code>.</span>
                    </div>
                }

                <div data-tabs>
                    <div class="mat-tabs" role="tablist" aria-label="Install command">
                        <button type="button" class="mat-tab" role="tab" id="tab-agent-windows" aria-controls="panel-agent-windows" aria-selected="true">PowerShell</button>
                        <button type="button" class="mat-tab" role="tab" id="tab-agent-unix" aria-controls="panel-agent-unix" aria-selected="false" tabindex="-1">Linux / macOS</button>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-agent-windows" aria-labelledby="tab-agent-windows">
                        <p class="mat-muted">Or run this in PowerShell as Administrator.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-install-windows">@Model.BuildWindowsCommand(Model.IssuedCode)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-install-windows">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-agent-unix" aria-labelledby="tab-agent-unix" hidden>
                        <p class="mat-muted">Or run this in a terminal - it asks for the password for sudo. Linux with systemd, macOS 12 or later.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-install-unix">@Model.BuildUnixCommand(Model.IssuedCode)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-install-unix">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.IssuedRolloutKey))
{
    @* The rollout key just made: shown on exactly this render, only its hash is kept. *@
    <div class="mat-alert mat-alert--success" role="status">
        @MatUi.Icon("key")
        <div class="mat-alert__body">
            <span class="mat-alert__title">Rollout key &ldquo;@Model.IssuedRolloutName&rdquo;</span>
            <span>For many machines - every one waits below for your approval. Shown only now: copy it into your deployment.</span>
            <div class="mat-input-group">
                <input class="mat-input mat-mono" id="agent-issued-rollout" value="@Model.IssuedRolloutKey" readonly aria-label="Rollout key" />
                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#agent-issued-rollout">@MatUi.Icon("copy")<span>Copy</span></button>
            </div>
        </div>
    </div>

    <section class="mat-card" id="agent-rollout-install">
        <div class="mat-card__head">
            @MatUi.Icon("download")
            <h2 class="mat-card__title">Roll the agent out</h2>
        </div>
        <div class="mat-card__body mat-stack">
            @if (Model.IssuedRolloutVia is { ParentId: not null } rolloutVia)
            {
                <p class="mat-muted">The machines talk through the probe <strong>@rolloutVia.Name</strong>, which passes everything on to this instance - they only have to reach that probe.</p>
            }
            @if (Model.IssuedRolloutUrl is null)
            {
                <div class="mat-alert mat-alert--warning" role="status">
                    @MatUi.Icon("alert")
                    <div class="mat-alert__body">This instance does not know the address the machines should connect to. Set the public address under <a asp-page="/Config" asp-route-tab="general">System &gt; General</a> (or, for a remote probe, its address for agents), then make a new key.</div>
                </div>
            }
            else
            {
                <div data-tabs>
                    <div class="mat-tabs" role="tablist" aria-label="Rollout method">
                        <button type="button" class="mat-tab" role="tab" id="tab-rollout-msi" aria-controls="panel-rollout-msi" aria-selected="true">Windows MSI</button>
                        <button type="button" class="mat-tab" role="tab" id="tab-rollout-ps" aria-controls="panel-rollout-ps" aria-selected="false" tabindex="-1">PowerShell</button>
                        <button type="button" class="mat-tab" role="tab" id="tab-rollout-unix" aria-controls="panel-rollout-unix" aria-selected="false" tabindex="-1">Linux / macOS</button>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-rollout-msi" aria-labelledby="tab-rollout-msi">
                        <p class="mat-muted">For Intune, a GPO start script, PDQ or your RMM tool: install the MSI silently with the address and the key. Running it again on a machine that has the agent only updates the program.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-rollout-msi">@Model.BuildMsiCommand(Model.IssuedRolloutKey)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-rollout-msi">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                        @if (Model.MsiUrl is { } msi)
                        {
                            <div class="mat-btn-row mat-btn-row--plain">
                                <a class="mat-btn mat-btn--primary" href="@msi" rel="noreferrer">@MatUi.Icon("download")<span>Download the MSI</span></a>
                            </div>
                        }
                        else
                        {
                            <p class="mat-hint">This build follows no agent feed, so there is no MSI to link here - take it from the release of your channel.</p>
                        }
                        <p class="mat-hint">Intune: a Windows app (Win32 or line-of-business) with the command above. GPO software installation cannot pass the two values - use a computer start-up script with the command, or an MST transform that sets MATMON_URL and MATMON_KEY. Removing the MSI removes the agent.</p>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-rollout-ps" aria-labelledby="tab-rollout-ps" hidden>
                        <p class="mat-muted">Run as Administrator on each machine, or push it with your remote management.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-rollout-ps">@Model.RolloutWindowsCommand(Model.IssuedRolloutKey)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-rollout-ps">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-rollout-unix" aria-labelledby="tab-rollout-unix" hidden>
                        <p class="mat-muted">Run as root - by hand, or from Ansible, Salt or a cloud-init script. Linux with systemd, macOS 12 or later.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-rollout-unix">@Model.RolloutUnixCommand(Model.IssuedRolloutKey)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-rollout-unix">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.WaitingAgents.Count > 0)
{
    <section class="mat-section" id="agent-approval">
        <div class="mat-section__head">
            <h2>Waiting for approval</h2>
            <p class="mat-section__lead">@Model.WaitingAgents.Count machine@(Model.WaitingAgents.Count == 1 ? string.Empty : "s") enrolled with a rollout key</p>
        </div>
        @if (isAdmin)
        {
            <form method="post" asp-page-handler="Approve" id="agent-approve" hidden></form>
            <form method="post" asp-page-handler="Reject" id="agent-reject" hidden></form>
        }
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Machines waiting for approval</caption>
                <thead>
                    <tr>
                        <th scope="col">Machine</th>
                        <th scope="col">Rollout key</th>
                        <th scope="col" class="mat-hide-sm">Enrolled</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var waiting in Model.WaitingAgents)
                    {
                        <tr>
                            <td data-label="Machine">
                                <div class="probe-cell">
                                    <strong>@(waiting.MachineName ?? waiting.ProbeId)</strong>
                                    <span class="probe-cell__meta">@(waiting.OperatingSystem ?? "unknown system")@(waiting.AgentVersion is null ? string.Empty : $" · {waiting.AgentVersion}")</span>
                                    @if (Model.ReplacedHostName(waiting) is { } replaced)
                                    {
                                        <span class="mat-chips"><span class="mat-tag" title="The same machine is already in the tree - approving re-installs that host: its sensors and history stay">re-install of @replaced</span></span>
                                    }
                                </div>
                            </td>
                            <td data-label="Rollout key">@Model.RolloutKeyName(waiting)</td>
                            <td data-label="Enrolled" class="mat-hide-sm mat-mono">@waiting.RequestedUtc.ToDisplay().ToString("g")@(waiting.RemoteAddress is null ? string.Empty : $" · {waiting.RemoteAddress}")</td>
                            <td class="mat-table__cell-actions">
                                @if (isAdmin)
                                {
                                    <div class="mat-table__actions">
                                        <button type="submit" form="agent-approve" name="pendingId" value="@waiting.Id" class="mat-btn mat-btn--primary mat-btn--sm">@MatUi.Icon("check")<span>Approve</span></button>
                                        <button type="submit" form="agent-reject" name="pendingId" value="@waiting.Id" class="mat-btn mat-btn--secondary mat-btn--sm"
                                                data-confirm="Reject @(waiting.MachineName ?? waiting.ProbeId)? The machine stays locked out until it enrols again." data-confirm-ok="Reject">@MatUi.Icon("x")<span>Reject</span></button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (isAdmin && Model.WaitingAgents.Count > 1)
        {
            <form method="post" asp-page-handler="ApproveAll" class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--secondary" data-confirm="Approve all @Model.WaitingAgents.Count machines? Each becomes a host and is monitored." data-confirm-ok="Approve all">@MatUi.Icon("check")<span>Approve all</span></button>
            </form>
        }
    </section>
}

<section class="mat-section">
    <div class="mat-section__head">
        <h2>Installed agents</h2>
        <p class="mat-section__lead">@Model.Agents.Count enrolled</p>
    </div>
    <div class="mat-list">
        @if (Model.Agents.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@MatUi.Icon("server")</span>
                <div class="mat-empty__title">No agents yet</div>
                <p>Create an enrolment code below to add one.</p>
                @if (isAdmin)
                {
                    <a class="mat-btn mat-btn--primary" href="#agent-add">@MatUi.Icon("plus")<span>Add an agent</span></a>
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Installed agents with their state</caption>
                    <thead>
                        <tr>
                            <th scope="col">Agent</th>
                            <th scope="col">System</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="mat-hide-sm">Last seen</th>
                            <th scope="col" class="mat-num">Sensors</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model.Agents)
                        {
                            var state = agent.State.Equals("Offline", StringComparison.OrdinalIgnoreCase)
                                ? "error"
                                : agent.State.Equals("Waiting", StringComparison.OrdinalIgnoreCase) ? "warning" : "ok";
                            var updateProblem = !string.IsNullOrWhiteSpace(agent.UpdateStatus)
                                && (agent.UpdateStatus.Contains("rolled back") || agent.UpdateStatus.Contains("failed"));

                            <tr>
                                <td data-label="Agent">
                                    <div class="probe-cell">
                                        @if (isAdmin)
                                        {
                                            <a asp-page="/ElementEditor" asp-route-selectedId="@agent.ElementId" asp-route-returnUrl="/agents"><strong>@agent.Name</strong></a>
                                        }
                                        else
                                        {
                                            <strong>@agent.Name</strong>
                                        }
                                        <span class="probe-cell__meta mat-mono">@agent.ProbeId</span>
                                        <span class="probe-cell__meta" title="The probe this agent talks through - the nearest probe above its host">Via: @(agent.ViaProbeName ?? "-")</span>
                                        @if (agent.ViaProbeElementId is not null && agent.State != "Waiting"
                                             && !string.Equals(agent.RelayedByName, Model.RelayNameFor(agent), StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="probe-cell__warn" title="Where the agent's heartbeats actually arrive from differs from where it sits in the tree. Its sensors still run on the agent.">@MatUi.Icon("alert")<span>Reports @(agent.RelayedByName is null ? "straight to the primary" : $"through {agent.RelayedByName}")</span></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(agent.DuplicateWarning))
                                        {
                                            <span class="probe-cell__warn">@MatUi.Icon("alert")<span>Duplicate agent: @agent.DuplicateWarning</span></span>
                                        }
                                    </div>
                                </td>
                                <td data-label="System">
                                    <div class="probe-cell">
                                        <span>@(string.IsNullOrWhiteSpace(agent.Host) || agent.Host == "-" ? "-" : agent.Host)</span>
                                        @if (!string.IsNullOrWhiteSpace(agent.OperatingSystem) && agent.OperatingSystem != "-")
                                        {
                                            <span class="probe-cell__meta">@agent.OperatingSystem</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(agent.Version))
                                        {
                                            <span class="probe-cell__meta mat-mono">@agent.Version</span>
                                            @if (Model.IsUpdatePending(agent, out var offeredVersion))
                                            {
                                                <span class="mat-pill mat-pill--info" title="The agent updates itself to the build this instance serves within about an hour">Update pending → @offeredVersion</span>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(agent.UpdateStatus))
                                        {
                                            <span class="probe-cell__meta@(updateProblem ? " probe-cell__meta--problem" : string.Empty)">@agent.UpdateStatus</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <div class="probe-cell">
                                        <span class="@MatUi.PillClass(state)">@agent.State</span>
                                        <span class="probe-cell__meta">@agent.Message</span>
                                    </div>
                                </td>
                                <td data-label="Last seen" class="mat-hide-sm mat-mono">@(agent.LastSeenUtc.HasValue ? agent.LastSeenUtc.Value.ToDisplay().ToString("g") : "-")</td>
                                <td data-label="Sensors" class="mat-num mat-mono">@agent.SensorCount</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        @if (isAdmin)
                                        {
                                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-menu-toggle="agent-menu-@agent.ElementId" data-menu-place="bottom"
                                                    aria-haspopup="menu" aria-expanded="false" aria-label="Actions for @agent.Name" data-tip="Actions">@MatUi.Icon("more-horizontal")</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@* The row menus. "New install code" posts the one hidden form (it carries the anti-forgery token): reinstalling this machine?
   A code that gives the new install this agent back. *@
<form method="post" id="agent-row-actions" hidden></form>
@foreach (var agent in Model.Agents)
{
    <div class="mat-menu" id="agent-menu-@agent.ElementId" role="menu" aria-label="Actions for @agent.Name" hidden>
        @if (isAdmin)
        {
            <a class="mat-menu__item" role="menuitem" asp-page="/ElementEditor" asp-route-selectedId="@agent.ElementId" asp-route-returnUrl="/agents">@MatUi.Icon("edit")<span>Edit</span></a>
            <button type="button" class="mat-menu__item" role="menuitem" data-dialog-open="agent-host-@agent.ElementId" aria-haspopup="dialog">@MatUi.Icon("server")<span>Change host</span></button>
            <div class="mat-menu__sep" role="separator"></div>
            <button type="submit" form="agent-row-actions" class="mat-menu__item" role="menuitem"
                    asp-page="/Agents" asp-page-handler="Reinstall" name="agentHostId" value="@agent.ElementId"
                    title="Reinstalling this machine? A code that gives the new install this agent back.">@MatUi.Icon("key")<span>New install code</span></button>
            <button type="button" class="mat-menu__item" role="menuitem" data-dialog-open="agent-remove-@agent.ElementId" aria-haspopup="dialog">@MatUi.Icon("trash")<span>Remove…</span></button>
        }
    </div>
    @if (isAdmin)
    {
        <dialog class="mat-dialog" id="agent-host-@agent.ElementId" aria-labelledby="agent-host-@(agent.ElementId)-title">
            <form method="post" class="mat-dialog__form mat-form" novalidate asp-page-handler="RebindHost">
                <input type="hidden" name="agentHostId" value="@agent.ElementId" />
                <div class="mat-dialog__head">
                    @MatUi.Icon("server")
                    <h2 class="mat-dialog__title" id="agent-host-@(agent.ElementId)-title">Move @agent.Name to another host</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-stack">
                    <div class="mat-field">
                        <span class="mat-label">Host</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "hostElementId", DomId = $"picker-agent-rebind-{agent.ElementId:N}", Placeholder = "Pick a host", Options = Model.HostOptions })" />
                        <span class="mat-hint">That host becomes the agent: it stays where it is, and the probe above it is the one the agent talks through from then on. System Health, the update sensor and the connection sensor move along; @agent.Name keeps everything else as an ordinary host.</span>
                    </div>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("check")<span>Move the agent</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </form>
        </dialog>
        <dialog class="mat-dialog" id="agent-remove-@agent.ElementId" aria-labelledby="agent-remove-@(agent.ElementId)-title">
            <form method="post" class="mat-dialog__form mat-form" novalidate asp-page="/ElementEditor" asp-page-handler="DeleteElement">
                <input type="hidden" name="ElementEditor.Id" value="@agent.ElementId" />
                <div class="mat-dialog__head">
                    @MatUi.Icon("trash")
                    <h2 class="mat-dialog__title" id="agent-remove-@(agent.ElementId)-title">Remove @agent.Name</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-stack">
                    <p>First uninstall the agent on that machine:</p>
                    <ul class="mat-stack">
                        <li><strong>Windows:</strong> Settings > Apps > Installed apps > Matmon Agent > Uninstall.</li>
                        <li><strong>Linux / macOS:</strong> <code class="mat-mono">sudo matmon-agent uninstall</code></li>
                    </ul>
                    <p>Then delete it here: the agent's host with its sensors and history is removed from Matmon.</p>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--danger">@MatUi.Icon("trash")<span>Delete from Matmon</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </form>
        </dialog>
    }
}

<details class="mat-collapse">
    <summary><span>Plain downloads without a code - for installing by hand (<span class="mat-mono">matmon-agent enroll</span>)</span>@MatUi.Icon("chevron-down", "mat-accordion__chev")</summary>
    <div class="mat-accordion__body">
        <p class="mat-hint">
            The agent program per platform, without an address or code inside. To add a machine, create a code above - its download installs in one step.
            @if (Model.ServedVersion is { } served)
            {
                <span>Agent version <span class="mat-mono">@served</span> (this instance: <span class="mat-mono">@Model.InstanceVersion</span>).</span>
            }
        </p>

    @if (Model.Packages.Count == 0)
    {
        <div class="mat-empty mat-empty--framed">
            <span class="mat-empty__icon">@MatUi.Icon("download")</span>
            <div class="mat-empty__title">No agent packages available</div>
            <p>@(Model.Catalog.Problem ?? $"Put the packages into {Model.PackagesPath}.")</p>
        </div>
    }
    else
    {
        @if (Model.Catalog.Problem is { } problem)
        {
            <div class="mat-alert mat-alert--warning" role="status">@MatUi.Icon("alert")<div class="mat-alert__body">@problem</div></div>
        }

        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Agent packages without an enrolment code</caption>
                <thead>
                    <tr>
                        <th scope="col">Platform</th>
                        <th scope="col" class="mat-num">Size</th>
                        <th scope="col" class="mat-hide-sm">SHA-256</th>
                        <th scope="col"><span class="mat-sr-only">Download</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in Model.Packages)
                    {
                        <tr>
                            <td data-label="Platform">
                                <div class="probe-cell">
                                    <strong>@package.Platform.DisplayName</strong>
                                    <span class="probe-cell__meta">@AgentsModel.SourceLabel(package)@(package.Version is null ? string.Empty : $" · {package.Version}")</span>
                                    @if (package.Signature is not null)
                                    {
                                        <span class="@MatUi.PillClass("ok")" data-tip="Signed by the build - checked before an agent runs an update">Signed</span>
                                    }
                                    else
                                    {
                                        <span class="@MatUi.PillClass("plain")" data-tip="An unsigned (local) build - agents verify only its SHA-256">Unsigned</span>
                                    }
                                </div>
                            </td>
                            <td data-label="Size" class="mat-num mat-mono">@package.Megabytes.ToString("0.0") MB</td>
                            <td data-label="SHA-256" class="mat-hide-sm mat-mono" title="@package.Sha256">@package.Sha256[..16]…</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/api/agent/packages/@package.Platform.RuntimeId" download="@package.Platform.FileName">@MatUi.Icon("download")<span>Plain</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</details>

@if (isAdmin)
{
    <section class="mat-card" id="agent-add">
        <div class="mat-card__head">
            @MatUi.Icon("plus")
            <h2 class="mat-card__title">Add an agent</h2>
        </div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">Agents do not count against the plan's probe limit.</p>
            <form method="post" asp-page-handler="Create" class="mat-form" novalidate>
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" for="NewName">Name</label>
                        <input asp-for="NewName" class="mat-input" placeholder="e.g. FILESRV-01" maxlength="120" />
                        <span class="mat-hint">Optional - defaults to the machine's host name.</span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="NewValidityHours">Valid for</label>
                        <select asp-for="NewValidityHours" class="mat-select">
                            @foreach (var hours in Model.ValidityChoices)
                            {
                                <option value="@hours">@(hours switch { 1 => "1 hour", 24 => "24 hours", 168 => "7 days", _ => $"{hours} hours" })</option>
                            }
                        </select>
                    </div>
                    <div class="mat-field mat-field--full">
                        <span class="mat-label">Place in</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "NewParentId", DomId = "picker-agent-place", SelectedId = Model.NewParentId, Placeholder = "The primary", Options = Model.PlaceOptions })" />
                        <span class="mat-hint">Where the new host goes. Under a remote probe the agent talks to that probe, which passes everything on - for a machine that cannot reach this instance itself.</span>
                    </div>
                    <div class="mat-field mat-field--full">
                        <span class="mat-label">Or an existing host</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "NewHostId", DomId = "picker-agent-host", SelectedId = Model.NewHostId, Placeholder = "A new host, named after the machine", Options = Model.HostOptions })" />
                        <span class="mat-hint">Optional - when the machine is already in the tree. It stays where it is, becomes the agent, and its sensors run on the agent.</span>
                    </div>
                </div>
                <div class="mat-btn-row">
                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create enrolment code</span></button>
                </div>
            </form>
        </div>
    </section>

    @if (Model.PendingEnrollments.Count > 0)
    {
        <section class="mat-section">
            <div class="mat-section__head">
                <h2>Unused codes</h2>
                <p class="mat-section__lead">@Model.PendingEnrollments.Count waiting for an agent</p>
            </div>
            @* One hidden form carries the handler and the anti-forgery token; each Revoke button posts it with its own code. *@
            <form method="post" asp-page-handler="Revoke" id="agent-revoke" hidden></form>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Unused enrolment codes</caption>
                    <thead>
                        <tr>
                            <th scope="col">For</th>
                            <th scope="col">Created</th>
                            <th scope="col">Expires</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pending in Model.PendingEnrollments)
                        {
                            <tr>
                                <td data-label="For">
                                    <div class="probe-cell">
                                        <strong>@(pending.Name ?? "host name of the machine")</strong>
                                        <span class="mat-chips">
                                            @if (Model.IsReinstall(pending))
                                            {
                                                <span class="mat-tag" title="Re-installs this agent - its host, sensors and history stay">re-install</span>
                                            }
                                            else if (pending.HostElementId is not null)
                                            {
                                                <span class="mat-tag" title="This existing host becomes the agent">existing host</span>
                                            }
                                            @if (Model.ViaOf(pending) is { ParentId: not null } via)
                                            {
                                                <span class="mat-tag" title="The agent talks through this probe">via @via.Name</span>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Created" class="mat-mono">@pending.CreatedUtc.ToDisplay().ToString("g")@(string.IsNullOrWhiteSpace(pending.CreatedBy) ? string.Empty : $" · {pending.CreatedBy}")</td>
                                <td data-label="Expires" class="mat-mono">@pending.ExpiresUtc.ToDisplay().ToString("g")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        @if (Model.Packages.Count > 0 && Model.CanDownload(pending.Id))
                                        {
                                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-menu-toggle="agent-download-@pending.Id" data-menu-place="bottom"
                                                    aria-haspopup="menu" aria-expanded="false">@MatUi.Icon("download")<span>Download</span></button>
                                        }
                                        <button type="submit" form="agent-revoke" name="enrollmentId" value="@pending.Id" class="mat-btn mat-btn--secondary mat-btn--sm">@MatUi.Icon("x")<span>Revoke</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @* The ready-to-install downloads of each code that was created since this instance started (the plain code is
               only kept in memory - after a restart a code can still be typed in, but not downloaded with). *@
            @foreach (var pending in Model.PendingEnrollments.Where(pending => Model.Packages.Count > 0 && Model.CanDownload(pending.Id)))
            {
                <div class="mat-menu" id="agent-download-@pending.Id" role="menu" aria-label="Downloads for this code" hidden>
                    @foreach (var package in Model.Packages)
                    {
                        <a class="mat-menu__item" role="menuitem" href="@Model.InstallerUrl(package, pending.Id)">@MatUi.Icon("download")<span>@AgentsModel.InstallerLabel(package.Platform)</span></a>
                    }
                </div>
            }
        </section>
    }

    <section class="mat-card" id="rollout">
        <div class="mat-card__head">
            @MatUi.Icon("users")
            <h2 class="mat-card__title">Roll out to many machines</h2>
        </div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">One key for a whole deployment - the Windows MSI through Intune, a GPO or your RMM tool, or a script on Linux and macOS. Every machine that enrols with it waits under &ldquo;Waiting for approval&rdquo; and is only monitored once you approve it. A machine that is installed again is recognised and keeps its host.</p>
            <form method="post" asp-page-handler="CreateRollout" class="mat-form" novalidate>
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" for="RolloutName">Name</label>
                        <input asp-for="RolloutName" class="mat-input" placeholder="e.g. Office PCs Hamburg" maxlength="120" required data-msg-required="Give the key a name." />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="RolloutValidityDaysChoice">Valid for</label>
                        <select asp-for="RolloutValidityDaysChoice" class="mat-select">
                            @foreach (var days in Model.RolloutValidityChoices)
                            {
                                <option value="@days">@(days switch { 0 => "Until revoked", 365 => "1 year", _ => $"{days} days" })</option>
                            }
                        </select>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="RolloutMaxDevices">Machines at most</label>
                        <input asp-for="RolloutMaxDevices" class="mat-input" type="number" min="1" max="100000" placeholder="No limit" />
                        <span class="mat-hint">Optional. A machine installed again does not count twice.</span>
                    </div>
                    <div class="mat-field mat-field--full">
                        <span class="mat-label">Place approved machines in</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "RolloutParentId", DomId = "picker-rollout-place", SelectedId = Model.RolloutParentId, Placeholder = "The primary", Options = Model.PlaceOptions })" />
                        <span class="mat-hint">A folder or a probe. Under a remote probe the machines talk to that probe, which passes everything on.</span>
                    </div>
                </div>
                <div class="mat-btn-row">
                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("key")<span>Create rollout key</span></button>
                </div>
            </form>

            @if (Model.RolloutKeys.Count > 0)
            {
                var now = DateTimeOffset.UtcNow;
                <form method="post" asp-page-handler="RevokeRollout" id="rollout-revoke" hidden></form>
                <form method="post" asp-page-handler="DeleteRollout" id="rollout-delete" hidden></form>
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">Rollout keys</caption>
                        <thead>
                            <tr>
                                <th scope="col">Key</th>
                                <th scope="col">Machines</th>
                                <th scope="col" class="mat-hide-sm">Valid until</th>
                                <th scope="col"><span class="mat-sr-only">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in Model.RolloutKeys)
                            {
                                var state = AgentsModel.RolloutState(key, now);
                                <tr>
                                    <td data-label="Key">
                                        <div class="probe-cell">
                                            <strong>@key.Name</strong>
                                            <span class="probe-cell__meta">into @Model.RolloutPlaceName(key)@(string.IsNullOrWhiteSpace(key.CreatedBy) ? string.Empty : $" · by {key.CreatedBy}")</span>
                                            <span class="@MatUi.PillClass(state == "Active" ? "ok" : "plain")">@state</span>
                                        </div>
                                    </td>
                                    <td data-label="Machines" class="mat-mono">@key.DeviceCount@(key.MaxDevices is { } max ? $" / {max}" : string.Empty)@(key.LastUsedUtc is { } used ? $" · last {used.ToDisplay():g}" : string.Empty)</td>
                                    <td data-label="Valid until" class="mat-hide-sm mat-mono">@(key.ExpiresUtc is { } expires ? expires.ToDisplay().ToString("g") : "until revoked")</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            @if (state is "Active" or "Full")
                                            {
                                                <button type="submit" form="rollout-revoke" name="keyId" value="@key.Id" class="mat-btn mat-btn--secondary mat-btn--sm"
                                                        data-confirm="Revoke &ldquo;@key.Name&rdquo;? No new machine can enrol with it; agents already approved keep working." data-confirm-ok="Revoke">@MatUi.Icon("x")<span>Revoke</span></button>
                                            }
                                            else
                                            {
                                                <button type="submit" form="rollout-delete" name="keyId" value="@key.Id" class="mat-btn mat-btn--ghost mat-btn--sm">@MatUi.Icon("trash")<span>Remove</span></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

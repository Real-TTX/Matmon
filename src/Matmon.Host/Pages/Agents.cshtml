@page "/agents"
@model Matmon.Host.Pages.AgentsModel
@{
    ViewData["Title"] = "Probes";
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("Probes", "/Probes"), new BreadcrumbItem("Agents") };
    var isAdmin = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
    var issuedExpires = Model.IssuedExpiresUtc is { } expiresUtc
        ? new DateTimeOffset(DateTime.SpecifyKind(expiresUtc, DateTimeKind.Utc))
        : (DateTimeOffset?)null;
}

<partial name="_ProbesTabs" model="@("agents")" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.IssuedCode))
{
    @* The code just issued: shown on exactly this render, then gone for good (only its hash is stored; the plain code stays
       in this process's memory so the download buttons keep working for its lifetime). It gets read out over the phone,
       so it is big and monospaced. *@
    <div class="mat-alert mat-alert--success" role="status">
        @MatUi.Icon("key")
        <div class="mat-alert__body">
            <span class="mat-alert__title">Enrolment code@(string.IsNullOrWhiteSpace(Model.IssuedName) ? string.Empty : $" for {Model.IssuedName}")</span>
            <span>Single use@(issuedExpires is { } expires ? $", valid until {expires.ToDisplay():g}" : string.Empty). Shown only now - the downloads below keep working until it is used or expires.</span>
            <div class="mat-input-group">
                <input class="mat-input mat-mono agent-code-input" id="agent-issued-code" value="@Model.IssuedCode" readonly aria-label="Enrolment code" />
                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#agent-issued-code">@MatUi.Icon("copy")<span>Copy</span></button>
            </div>
        </div>
    </div>

    @if (Model.IssuedReplaces)
    {
        <div class="mat-alert mat-alert--warning" role="status">
            @MatUi.Icon("alert")
            <div class="mat-alert__body">This code takes over the existing probe <strong>@Model.IssuedName</strong> - sensors, history and alerts stay. Whatever runs as that probe now is locked out once the new agent enrols; remove it afterwards.</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.IssuedHostName))
    {
        <div class="mat-alert mat-alert--warning" role="status">
            @MatUi.Icon("alert")
            <div class="mat-alert__body">When the agent enrols, the host <strong>@Model.IssuedHostName</strong> moves under its probe; settings it inherited from its old place (credentials, schedules) no longer apply.</div>
        </div>
    }

    <section class="mat-card" id="agent-install">
        <div class="mat-card__head">
            @MatUi.Icon("download")
            <h2 class="mat-card__title">Install the agent</h2>
        </div>
        <div class="mat-card__body mat-stack">
            @if (Model.InstanceUrl is null)
            {
                <div class="mat-alert mat-alert--warning" role="status">
                    @MatUi.Icon("alert")
                    <div class="mat-alert__body">This instance does not know the address agents should connect to. Set the public address under <a asp-page="/Config" asp-route-tab="general">System &gt; General</a> (or open Matmon directly once), then create a new code.</div>
                </div>
            }
            else
            {
                @if (Model.Packages.Count == 0)
                {
                    <div class="mat-alert mat-alert--warning" role="status">
                        @MatUi.Icon("alert")
                        <div class="mat-alert__body">@(Model.Catalog.Problem ?? "This instance has no agent packages to hand out right now.")</div>
                    </div>
                }
                else
                {
                    <div class="mat-stack mat-stack--sm">
                        <span class="mat-label">Download - the code is inside, so the agent sets itself up</span>
                        <div class="mat-btn-row mat-btn-row--plain">
                            @foreach (var package in Model.Packages)
                            {
                                <a class="mat-btn @(package.Platform.IsWindows ? "mat-btn--primary" : "mat-btn--secondary")" href="@Model.InstallerUrl(package, Model.IssuedEnrollmentId!.Value)">@MatUi.Icon("download")<span>@AgentsModel.InstallerLabel(package.Platform)</span></a>
                            }
                        </div>
                        <span class="mat-hint">Windows: double-click and press Install. Linux / macOS: <code>chmod +x</code> the file, then <code>sudo ./&lt;file&gt; install</code>.</span>
                    </div>
                }

                <div data-tabs>
                    <div class="mat-tabs" role="tablist" aria-label="Install command">
                        <button type="button" class="mat-tab" role="tab" id="tab-agent-windows" aria-controls="panel-agent-windows" aria-selected="true">PowerShell</button>
                        <button type="button" class="mat-tab" role="tab" id="tab-agent-unix" aria-controls="panel-agent-unix" aria-selected="false" tabindex="-1">Linux / macOS</button>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-agent-windows" aria-labelledby="tab-agent-windows">
                        <p class="mat-muted">Or run this in PowerShell as Administrator.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-install-windows">@Model.BuildWindowsCommand(Model.IssuedCode)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-install-windows">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-agent-unix" aria-labelledby="tab-agent-unix" hidden>
                        <p class="mat-muted">Or run this in a terminal - it asks for the password for sudo. Linux with systemd, macOS 12 or later.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code agent-oneliner"><code id="agent-install-unix">@Model.BuildUnixCommand(Model.IssuedCode)</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#agent-install-unix">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="mat-section">
    <div class="mat-section__head">
        <h2>Installed agents</h2>
        <p class="mat-section__lead">@Model.Agents.Count enrolled</p>
    </div>
    <div class="mat-list">
        @if (Model.Agents.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@MatUi.Icon("server")</span>
                <div class="mat-empty__title">No agents yet</div>
                <p>Create an enrolment code below to add one.</p>
                @if (isAdmin)
                {
                    <a class="mat-btn mat-btn--primary" href="#agent-add">@MatUi.Icon("plus")<span>Add an agent</span></a>
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Installed agents with their state</caption>
                    <thead>
                        <tr>
                            <th scope="col">Agent</th>
                            <th scope="col">System</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="mat-hide-sm">Last seen</th>
                            <th scope="col" class="mat-num">Sensors</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model.Agents)
                        {
                            var state = agent.State.Equals("Offline", StringComparison.OrdinalIgnoreCase)
                                ? "error"
                                : agent.State.Equals("Waiting", StringComparison.OrdinalIgnoreCase) ? "warning" : "ok";
                            var updateProblem = !string.IsNullOrWhiteSpace(agent.UpdateStatus)
                                && (agent.UpdateStatus.Contains("rolled back") || agent.UpdateStatus.Contains("failed"));

                            <tr>
                                <td data-label="Agent">
                                    <div class="probe-cell">
                                        <strong>@agent.Name</strong>
                                        <span class="probe-cell__meta mat-mono">@agent.ProbeId</span>
                                        @if (!string.IsNullOrWhiteSpace(agent.BoundHostName))
                                        {
                                            <span class="probe-cell__meta" title="The machine this agent runs on - its sensors live under this host">
                                                Host:
                                                @if (isAdmin)
                                                {
                                                    <a asp-page="/ElementEditor" asp-route-selectedId="@agent.BoundHostId" asp-route-returnUrl="/agents">@agent.BoundHostName</a>
                                                }
                                                else
                                                {
                                                    @agent.BoundHostName
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="probe-cell__warn" title="Its host was deleted or moved out of the agent. A new install code gives it a host again.">@MatUi.Icon("alert")<span>Not bound to a host</span></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(agent.DuplicateWarning))
                                        {
                                            <span class="probe-cell__warn">@MatUi.Icon("alert")<span>Duplicate agent: @agent.DuplicateWarning</span></span>
                                        }
                                    </div>
                                </td>
                                <td data-label="System">
                                    <div class="probe-cell">
                                        <span>@(string.IsNullOrWhiteSpace(agent.Host) || agent.Host == "-" ? "-" : agent.Host)</span>
                                        @if (!string.IsNullOrWhiteSpace(agent.OperatingSystem) && agent.OperatingSystem != "-")
                                        {
                                            <span class="probe-cell__meta">@agent.OperatingSystem</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(agent.Version))
                                        {
                                            <span class="probe-cell__meta mat-mono">@agent.Version</span>
                                            @if (Model.IsUpdatePending(agent, out var offeredVersion))
                                            {
                                                <span class="mat-pill mat-pill--info" title="The agent updates itself to the build this instance serves within about an hour">Update pending → @offeredVersion</span>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(agent.UpdateStatus))
                                        {
                                            <span class="probe-cell__meta@(updateProblem ? " probe-cell__meta--problem" : string.Empty)">@agent.UpdateStatus</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <div class="probe-cell">
                                        <span class="@MatUi.PillClass(state)">@agent.State</span>
                                        <span class="probe-cell__meta">@agent.Message</span>
                                    </div>
                                </td>
                                <td data-label="Last seen" class="mat-hide-sm mat-mono">@(agent.LastSeenUtc.HasValue ? agent.LastSeenUtc.Value.ToDisplay().ToString("g") : "-")</td>
                                <td data-label="Sensors" class="mat-num mat-mono">@agent.SensorCount</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-menu-toggle="agent-menu-@agent.ElementId" data-menu-place="bottom"
                                                aria-haspopup="menu" aria-expanded="false" aria-label="Actions for @agent.Name" data-tip="Actions">@MatUi.Icon("more-horizontal")</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@* The row menus. "New install code" posts the one hidden form (it carries the anti-forgery token): reinstalling this machine?
   A code that gives the new install this probe back. *@
<form method="post" id="agent-row-actions" hidden></form>
@foreach (var agent in Model.Agents)
{
    <div class="mat-menu" id="agent-menu-@agent.ElementId" role="menu" aria-label="Actions for @agent.Name" hidden>
        <a class="mat-menu__item" role="menuitem" asp-page="/Monitoring" asp-route-monitoringProbe="@agent.ElementId">@MatUi.Icon("activity")<span>Sensors</span></a>
        <a class="mat-menu__item" role="menuitem" asp-page="/ProbeUsage" asp-route-probeElementId="@agent.ElementId">@MatUi.Icon("bar-chart")<span>Usage</span></a>
        @if (isAdmin)
        {
            <a class="mat-menu__item" role="menuitem" asp-page="/ElementEditor" asp-route-selectedId="@agent.ElementId" asp-route-returnUrl="/agents">@MatUi.Icon("edit")<span>Edit</span></a>
            <button type="button" class="mat-menu__item" role="menuitem" data-dialog-open="agent-host-@agent.ElementId" aria-haspopup="dialog">@MatUi.Icon("server")<span>Change host</span></button>
            <div class="mat-menu__sep" role="separator"></div>
            <button type="submit" form="agent-row-actions" class="mat-menu__item" role="menuitem"
                    asp-page="/Agents" asp-page-handler="CreateForProbe" name="probeElementId" value="@agent.ElementId"
                    title="Reinstalling this machine? A code that gives the new install this probe back.">@MatUi.Icon("key")<span>New install code</span></button>
            <button type="button" class="mat-menu__item" role="menuitem" data-dialog-open="agent-remove-@agent.ElementId" aria-haspopup="dialog">@MatUi.Icon("trash")<span>Remove…</span></button>
        }
    </div>
    @if (isAdmin)
    {
        <dialog class="mat-dialog" id="agent-host-@agent.ElementId" aria-labelledby="agent-host-@(agent.ElementId)-title">
            <form method="post" class="mat-dialog__form mat-form" novalidate asp-page-handler="RebindHost">
                <input type="hidden" name="probeElementId" value="@agent.ElementId" />
                <div class="mat-dialog__head">
                    @MatUi.Icon("server")
                    <h2 class="mat-dialog__title" id="agent-host-@(agent.ElementId)-title">Host of @agent.Name</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-stack">
                    <div class="mat-field">
                        <span class="mat-label">Host</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "hostElementId", DomId = $"picker-agent-rebind-{agent.ElementId:N}", Placeholder = string.IsNullOrWhiteSpace(agent.BoundHostName) ? "Pick a host" : agent.BoundHostName, Options = Model.HostOptions })" />
                        <span class="mat-hint">The host moves under the agent, so its sensors run on the agent; settings it inherited from its old place (credentials, schedules) no longer apply. System Health and the update sensor move along. The old host stays where it is.</span>
                    </div>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("check")<span>Bind to this host</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </form>
        </dialog>
        <dialog class="mat-dialog" id="agent-remove-@agent.ElementId" aria-labelledby="agent-remove-@(agent.ElementId)-title">
            <form method="post" class="mat-dialog__form mat-form" novalidate asp-page="/ElementEditor" asp-page-handler="DeleteElement">
                <input type="hidden" name="ElementEditor.Id" value="@agent.ElementId" />
                <div class="mat-dialog__head">
                    @MatUi.Icon("trash")
                    <h2 class="mat-dialog__title" id="agent-remove-@(agent.ElementId)-title">Remove @agent.Name</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-stack">
                    <p>First uninstall the agent on that machine:</p>
                    <ul class="mat-stack">
                        <li><strong>Windows:</strong> tray icon > Uninstall…, or Settings > Apps > Installed apps > Matmon Agent.</li>
                        <li><strong>Linux / macOS:</strong> <code class="mat-mono">sudo matmon-agent uninstall</code></li>
                    </ul>
                    <p>Then delete it here: the agent, its host and their sensors and history are removed from Matmon.</p>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--danger">@MatUi.Icon("trash")<span>Delete from Matmon</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </form>
        </dialog>
    }
}

<section class="mat-section">
    <div class="mat-section__head">
        <h2>Agent packages</h2>
        <p class="mat-section__lead">
            @if (Model.ServedVersion is { } served)
            {
                <span>Agents get <span class="mat-mono">@served</span> - the newest of this channel; this instance is <span class="mat-mono">@Model.InstanceVersion</span></span>
            }
            else
            {
                <span>Build <span class="mat-mono">@Model.InstanceVersion</span></span>
            }
        </p>
    </div>

    @if (Model.Packages.Count == 0)
    {
        <div class="mat-empty mat-empty--framed">
            <span class="mat-empty__icon">@MatUi.Icon("download")</span>
            <div class="mat-empty__title">No agent packages available</div>
            <p>@(Model.Catalog.Problem ?? $"Put the packages into {Model.PackagesPath}.")</p>
        </div>
    }
    else
    {
        @if (Model.Catalog.Problem is { } problem)
        {
            <div class="mat-alert mat-alert--warning" role="status">@MatUi.Icon("alert")<div class="mat-alert__body">@problem</div></div>
        }

        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Agent packages without an enrolment code</caption>
                <thead>
                    <tr>
                        <th scope="col">Platform</th>
                        <th scope="col" class="mat-num">Size</th>
                        <th scope="col" class="mat-hide-sm">SHA-256</th>
                        <th scope="col"><span class="mat-sr-only">Download</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in Model.Packages)
                    {
                        <tr>
                            <td data-label="Platform">
                                <div class="probe-cell">
                                    <strong>@package.Platform.DisplayName</strong>
                                    <span class="probe-cell__meta">@AgentsModel.SourceLabel(package)@(package.Version is null ? string.Empty : $" · {package.Version}")</span>
                                    @if (package.Signature is not null)
                                    {
                                        <span class="@MatUi.PillClass("ok")" data-tip="Signed by the build - checked before an agent runs an update">Signed</span>
                                    }
                                    else
                                    {
                                        <span class="@MatUi.PillClass("plain")" data-tip="An unsigned (local) build - agents verify only its SHA-256">Unsigned</span>
                                    }
                                </div>
                            </td>
                            <td data-label="Size" class="mat-num mat-mono">@package.Megabytes.ToString("0.0") MB</td>
                            <td data-label="SHA-256" class="mat-hide-sm mat-mono" title="@package.Sha256">@package.Sha256[..16]…</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/api/agent/packages/@package.Platform.RuntimeId" download="@package.Platform.FileName">@MatUi.Icon("download")<span>Plain</span></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (isAdmin)
{
    <section class="mat-card" id="agent-add">
        <div class="mat-card__head">
            @MatUi.Icon("plus")
            <h2 class="mat-card__title">Add an agent</h2>
        </div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">Agents do not count against the plan's probe limit.</p>
            <form method="post" asp-page-handler="Create" class="mat-form" novalidate>
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" for="NewName">Name</label>
                        <input asp-for="NewName" class="mat-input" placeholder="e.g. FILESRV-01" maxlength="120" />
                        <span class="mat-hint">Optional - defaults to the machine's host name.</span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="NewValidityHours">Valid for</label>
                        <select asp-for="NewValidityHours" class="mat-select">
                            @foreach (var hours in Model.ValidityChoices)
                            {
                                <option value="@hours">@(hours switch { 1 => "1 hour", 24 => "24 hours", 168 => "7 days", _ => $"{hours} hours" })</option>
                            }
                        </select>
                    </div>
                    <div class="mat-field mat-field--full">
                        <span class="mat-label">Host</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "NewHostId", DomId = "picker-agent-host", SelectedId = Model.NewHostId, Placeholder = "A new host, named after the machine", Options = Model.HostOptions })" />
                        <span class="mat-hint">Optional - the machine the agent runs on. An existing host moves under the agent; settings it inherited from its old place (credentials, schedules) no longer apply.</span>
                    </div>
                </div>
                <div class="mat-btn-row">
                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create enrolment code</span></button>
                </div>
            </form>
        </div>
    </section>

    @if (Model.PendingEnrollments.Count > 0)
    {
        <section class="mat-section">
            <div class="mat-section__head">
                <h2>Unused codes</h2>
                <p class="mat-section__lead">@Model.PendingEnrollments.Count waiting for an agent</p>
            </div>
            @* One hidden form carries the handler and the anti-forgery token; each Revoke button posts it with its own code. *@
            <form method="post" asp-page-handler="Revoke" id="agent-revoke" hidden></form>
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Unused enrolment codes</caption>
                    <thead>
                        <tr>
                            <th scope="col">For</th>
                            <th scope="col">Created</th>
                            <th scope="col">Expires</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pending in Model.PendingEnrollments)
                        {
                            <tr>
                                <td data-label="For">
                                    <div class="probe-cell">
                                        <strong>@(pending.Name ?? "host name of the machine")</strong>
                                        @if (pending.ProbeElementId is not null || pending.HostElementId is not null)
                                        {
                                            <span class="mat-chips">
                                                @if (pending.ProbeElementId is not null)
                                                {
                                                    <span class="mat-tag" title="Takes over this existing probe instead of creating a new one">re-install</span>
                                                }
                                                @if (pending.HostElementId is not null)
                                                {
                                                    <span class="mat-tag" title="Binds the agent to this existing host - it moves under the agent's probe">existing host</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td data-label="Created" class="mat-mono">@pending.CreatedUtc.ToDisplay().ToString("g")@(string.IsNullOrWhiteSpace(pending.CreatedBy) ? string.Empty : $" · {pending.CreatedBy}")</td>
                                <td data-label="Expires" class="mat-mono">@pending.ExpiresUtc.ToDisplay().ToString("g")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        @if (Model.Packages.Count > 0 && Model.CanDownload(pending.Id))
                                        {
                                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-menu-toggle="agent-download-@pending.Id" data-menu-place="bottom"
                                                    aria-haspopup="menu" aria-expanded="false">@MatUi.Icon("download")<span>Download</span></button>
                                        }
                                        <button type="submit" form="agent-revoke" name="enrollmentId" value="@pending.Id" class="mat-btn mat-btn--secondary mat-btn--sm">@MatUi.Icon("x")<span>Revoke</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @* The ready-to-install downloads of each code that was created since this instance started (the plain code is
               only kept in memory - after a restart a code can still be typed in, but not downloaded with). *@
            @foreach (var pending in Model.PendingEnrollments.Where(pending => Model.Packages.Count > 0 && Model.CanDownload(pending.Id)))
            {
                <div class="mat-menu" id="agent-download-@pending.Id" role="menu" aria-label="Downloads for this code" hidden>
                    @foreach (var package in Model.Packages)
                    {
                        <a class="mat-menu__item" role="menuitem" href="@Model.InstallerUrl(package, pending.Id)">@MatUi.Icon("download")<span>@AgentsModel.InstallerLabel(package.Platform)</span></a>
                    }
                </div>
            }
        </section>
    }
}

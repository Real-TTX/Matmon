@page "/workspace"
@model WorkspaceModel
@{
    ViewData["Title"] = "Infrastructure";
}

<nav class="mat-grid mat-grid--4" aria-label="Infrastructure">
    <a class="mat-card" asp-page="/Index">
        <div class="mat-card__body mat-row mat-row--nowrap mat-gap-2">@MatUi.Icon("network")<strong>Monitoring</strong></div>
    </a>
    <a class="mat-card" asp-page="/Monitoring">
        <div class="mat-card__body mat-row mat-row--nowrap mat-gap-2">@MatUi.Icon("activity")<strong>Sensors</strong></div>
    </a>
    <a class="mat-card" asp-page="/Templates">
        <div class="mat-card__body mat-row mat-row--nowrap mat-gap-2">@MatUi.Icon("template")<strong>Templates</strong></div>
    </a>
    <a class="mat-card" asp-page="/Notifications">
        <div class="mat-card__body mat-row mat-row--nowrap mat-gap-2">@MatUi.Icon("bell")<strong>Notifications</strong></div>
    </a>
</nav>

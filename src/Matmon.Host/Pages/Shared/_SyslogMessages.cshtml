@model Matmon.Host.Pages.SyslogMessagesViewModel
@* The Syslog tab of the Events page: what the network's devices report, kept here after they reboot and forget it.
   Rendered inside Events.cshtml; its data comes from the Events page's SyslogData / SyslogCounts / SyslogSenders handlers.
   A live view (logs.js, initializeSyslogMessages): the search is a field in the toolbar, the time window, the sender, the
   severity and the regex switch sit in the Filter dialog and apply at once (LIST-03), each filter in effect is a chip
   (LIST-04), Live and Refresh are at the toolbar's end. Every message goes onto the page with textContent - anything on
   the network can send a line. The view loads when its tab is first shown. *@
@{
    // The window a link without one opens with (EventsModel.SyslogWindow): a filter only counts as "in effect" when it
    // differs from it.
    const int DefaultWindow = 60;
}

<div class="mat-stack" id="syslog-messages" data-page-size="@Model.PageSize" data-has-messages="@(Model.HasMessages ? "true" : "false")"
     data-enabled="@(Model.ReceiverEnabled ? "true" : "false")" data-default-window="@DefaultWindow">
    <section class="mat-card">
        <div class="mat-card__body mat-row">
            <span class="@MatUi.PillClass(Model.Head.State)">@Model.Head.Label</span>
            <span>@Model.Head.Text</span>
            @if (!string.IsNullOrWhiteSpace(Model.LastReceivedText))
            {
                <span class="mat-text-muted">@Model.LastReceivedText</span>
            }
            @if (Model.CanConfigure)
            {
                <a class="mat-btn mat-btn--secondary mat-btn--sm mm-push-end" asp-page="/SystemSyslog">@MatUi.Icon("settings")<span>@(Model.ReceiverEnabled ? "Settings" : "Turn it on")</span></a>
            }
        </div>
    </section>

    <div class="mat-list">
        <div class="mat-toolbar" role="toolbar" aria-label="Syslog tools">
            <div class="mat-input-icon mat-toolbar__search">
                @MatUi.Icon("search")
                <input class="mat-input" type="search" id="slSearch" value="@Model.Q" placeholder="Text in the message…" aria-label="Search the messages"
                       autocomplete="off" enterkeyhint="search" />
            </div>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-toolbar__info" id="slSummary" aria-live="polite"></span>
            <div class="mat-toolbar__end">
                <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn" id="slFilterButton" data-dialog-open="sl-filter" aria-haspopup="dialog">
                    @MatUi.Icon("sliders")<span>Filter</span><span class="mat-badge" id="slFilterBadge" hidden>0</span>
                </button>
                <label class="mat-switch"><input type="checkbox" id="slLive" checked /><span class="mat-switch__track"></span><span>Live</span></label>
                <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn" id="slRefresh">@MatUi.Icon("refresh")<span>Refresh</span></button>
            </div>
        </div>

        <div class="mat-chips" role="group" aria-label="Filters in effect" id="slChips" hidden></div>

        <div class="mat-alert mat-alert--danger" role="alert" id="slErrorBox" hidden>
            @MatUi.Icon("x-circle")
            <div class="mat-alert__body" id="slError"></div>
        </div>

        <div class="mat-table-wrap" id="slTable">
            <table class="mat-table mat-table--compact">
                <caption class="mat-sr-only">Syslog messages, the newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Received</th>
                        <th scope="col">Severity</th>
                        <th scope="col">Sender</th>
                        <th scope="col" class="mat-hide-sm">Program</th>
                        <th scope="col">Message</th>
                    </tr>
                </thead>
                <tbody id="slRows"></tbody>
            </table>
        </div>

        <div class="mat-empty" id="slEmptyBox" hidden>
            <span class="mat-empty__icon">@MatUi.Icon("list")</span>
            <div class="mat-empty__title" id="slEmptyTitle"></div>
            <p id="slEmpty"></p>
        </div>

        <div class="mat-actions" id="slMoreRow" hidden>
            <button type="button" class="mat-btn mat-btn--secondary" id="slMore">@MatUi.Icon("chevron-down")<span>Load older messages</span></button>
        </div>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="sl-filter" aria-labelledby="sl-filter-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @MatUi.Icon("sliders")
                <h2 class="mat-dialog__title" id="sl-filter-title">Filter</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <div class="mat-field">
                    <label class="mat-label" for="slWindow">Time</label>
                    <select class="mat-select" id="slWindow">
                        @foreach (var choice in Matmon.Host.Services.SyslogPageSupport.Windows)
                        {
                            <option value="@choice.Minutes" selected="@(Model.Window == choice.Minutes)">@choice.Label</option>
                        }
                        @if (Matmon.Host.Services.SyslogPageSupport.Windows.All(choice => choice.Minutes != Model.Window))
                        {
                            <option value="@Model.Window" selected>Last @Model.Window minutes</option>
                        }
                    </select>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="slSource">Sender</label>
                    <input class="mat-input mat-mono" id="slSource" list="slSenders" value="@Model.Source" placeholder="IP or host name" autocomplete="off" />
                    <datalist id="slSenders"></datalist>
                    <span class="mat-hint">An address or a host name; the senders of the last 30 days are suggested.</span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="slSeverity">Severity</label>
                    <select class="mat-select" id="slSeverity">
                        @foreach (var choice in Matmon.Host.Services.SyslogPageSupport.SeverityChoices)
                        {
                            <option value="@choice.Value" selected="@((Model.Severity ?? string.Empty) == choice.Value)">@choice.Label</option>
                        }
                    </select>
                </div>
                <div class="mat-field">
                    <label class="mat-check">
                        <input type="checkbox" id="slRegex" checked="@Model.Regex" />
                        <span class="mat-check__text"><strong>Regular expression</strong><small class="mat-muted">Treat the search as a regular expression.</small></span>
                    </label>
                </div>
                <p class="mat-hint">The list follows every choice at once.</p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" data-dialog-close>@MatUi.Icon("check")<span>Done</span></button>
                    <span class="mat-btn-row__spacer"></span>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--end" id="slReset">Reset everything</button>
                </div>
            </div>
        </div>
    </dialog>
</div>

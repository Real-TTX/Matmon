@model ISensorThresholdEditor
@{
    var hasFixedChannels = Model.SensorChannelMode == SensorChannelMode.Fixed;
}
<div class="sensor-threshold-section" data-threshold-section data-sensor-tab="thresholds">
    <div class="panel-header">
        <h2 class="section-title">@MatmonIcons.Render("signal")<span>Channels & thresholds</span></h2>
        <span class="channel-mode-pill" data-mode="@(hasFixedChannels ? "fixed" : "dynamic")">@(hasFixedChannels ? "FIXED" : "DYNAMIC")</span>
    </div>

    @if (Model.SensorChannelThresholdFields.Count == 0)
    {
        <div class="empty-state">No channels yet.</div>
    }
    else
    {
        @if (Model.SensorChannelThresholdVisibleCount == 0)
        {
            <div class="empty-state">
                @if (hasFixedChannels)
                {
                    <text>No channels yet.</text>
                }
                else
                {
                    <text>This sensor discovers its channels at runtime — they appear after the first run. Use <strong>Test</strong> to preview them, or add one manually below.</text>
                }
            </div>
        }
        <div class="sensor-threshold-list" data-threshold-list>
            @for (var i = 0; i < Model.SensorChannelThresholdFields.Count; i++)
            {
                var field = Model.SensorChannelThresholdFields[i];
                var isHidden = i >= Model.SensorChannelThresholdVisibleCount || field.IsDeleted;
                <div class="sensor-threshold-card" data-threshold-row data-threshold-deleted="@(field.IsDeleted ? "true" : "false")" data-threshold-virtual="@(field.IsVirtual ? "true" : "false")" data-threshold-orphaned="@(field.IsOrphaned ? "true" : "false")" hidden="@(isHidden ? "hidden" : null)">
                    <input type="hidden" asp-for="SensorChannelThresholdFields[i].IsDefault" />
                    <input type="hidden" asp-for="SensorChannelThresholdFields[i].IsDeleted" />
                    <input type="hidden" asp-for="SensorChannelThresholdFields[i].IsVirtual" />
                    <div class="sensor-threshold-head">
                        <div>
                            <div class="sensor-threshold-name">@(!string.IsNullOrWhiteSpace(field.ChannelLabel) ? field.ChannelLabel : "Channel")@if (field.IsVirtual){<span class="tree-tag is-mini sensor-threshold-virtual-pill">virtual</span>}@if (field.IsOrphaned){<span class="tree-tag is-mini sensor-threshold-orphan-pill" title="Configured, but not in the sensor's latest run. Delete it if the channel is gone for good.">no longer reported</span>}</div>
                            <div class="sensor-threshold-help">
                                @(!string.IsNullOrWhiteSpace(field.ChannelKey) ? field.ChannelKey : "channel key")
                                @if (!string.IsNullOrWhiteSpace(field.Unit))
                                {
                                    <text> / @field.Unit</text>
                                }
                            </div>
                        </div>
                        <div class="sensor-threshold-head-actions">
                            <button type="button"
                                    class="workspace-secondary-submit sensor-threshold-default @(field.IsDefault ? "is-active" : string.Empty)"
                                    data-threshold-default
                                    aria-pressed="@(field.IsDefault ? "true" : "false")"
                                    title="Set as primary channel (used for the overview, graph &amp; statistics)">
                                @MatmonIcons.Render("chart")
                                <span data-threshold-default-label>@(field.IsDefault ? "Primary" : "Set primary")</span>
                            </button>
                            @if (!hasFixedChannels && !field.IsVirtual)
                            {
                                <button type="button"
                                        class="workspace-danger-submit sensor-threshold-delete"
                                        data-threshold-delete
                                        aria-label="Delete channel"
                                        title="Delete channel">
                                    @MatmonIcons.Render("trash")
                                    <span class="workspace-sr-only">Delete channel</span>
                                </button>
                            }
                        </div>
                    </div>

                    @if (field.IsVirtual)
                    {
                        <input type="hidden" asp-for="SensorChannelThresholdFields[i].ChannelKey" />
                        <div class="sensor-threshold-virtual-note">Derived status channel (healthy = 1, problem = 0). It has no thresholds — its value is the sensor's overall state. Pick it as the primary channel to make that state the sensor's main value &amp; graph.</div>
                    }
                    else
                    {
                        <div class="sensor-threshold-grid">
                            <label>
                                <span>Channel</span>
                                <input asp-for="SensorChannelThresholdFields[i].ChannelKey" class="form-control workspace-input" placeholder="latency" readonly="@(hasFixedChannels ? "readonly" : null)" />
                            </label>
                            <label>
                                <span>Warning</span>
                                <div class="sensor-threshold-rule">
                                    <select asp-for="SensorChannelThresholdFields[i].WarningComparison" class="form-select workspace-select" asp-items="WorkspaceModel.ThresholdComparisonOptions"></select>
                                    <input asp-for="SensorChannelThresholdFields[i].WarningValue" type="number" step="any" class="form-control workspace-input" placeholder="@field.WarningValuePlaceholder" />
                                </div>
                            </label>
                            <label>
                                <span>Critical</span>
                                <div class="sensor-threshold-rule">
                                    <select asp-for="SensorChannelThresholdFields[i].CriticalComparison" class="form-select workspace-select" asp-items="WorkspaceModel.ThresholdComparisonOptions"></select>
                                    <input asp-for="SensorChannelThresholdFields[i].CriticalValue" type="number" step="any" class="form-control workspace-input" placeholder="@field.CriticalValuePlaceholder" />
                                </div>
                            </label>
                        </div>
                    }

                    <div class="sensor-threshold-options">
                        <label class="sensor-threshold-visual">
                            <span>Display</span>
                            <select asp-for="SensorChannelThresholdFields[i].Visual" class="form-select workspace-select">
                                <option value="auto">Auto (by unit)</option>
                                <option value="value">Value</option>
                                <option value="progress">Progress bar</option>
                                <option value="gauge">Gauge</option>
                                <option value="graph">Graph</option>
                            </select>
                        </label>
                        <input type="hidden" asp-for="SensorChannelThresholdFields[i].LogByDefault" />
                        <label class="sensor-threshold-log workspace-check-field" title="Record this channel into long-term statistics">
                            <input type="checkbox" asp-for="SensorChannelThresholdFields[i].Logged" />
                            <span>Log to statistics@(field.LogByDefault ? null : " (off by default)")</span>
                        </label>
                    </div>
                </div>
            }
        </div>

        @if (!hasFixedChannels && Model.SensorChannelThresholdFields.Count > Model.SensorChannelThresholdVisibleCount)
        {
            <div class="sensor-threshold-actions">
                <button type="button" class="workspace-secondary-submit" data-threshold-add>@MatmonIcons.Render("plus")<span>Add channel</span></button>
            </div>
        }
    }
</div>

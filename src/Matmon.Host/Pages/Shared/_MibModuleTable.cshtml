@model IReadOnlyList<Matmon.Core.Domain.MibModuleStatus>
@* One table of MIB modules (System > SNMP MIBs), drawn straight into the card that holds it. ViewData: MibUploadedAt (the
   upload times, adds the column), MibCanDelete (a Remove button per row), MibCaption (what the table is, for a screen reader). *@
@{
    var uploadedAt = ViewData["MibUploadedAt"] as IReadOnlyDictionary<string, DateTimeOffset>;
    var canDelete = ViewData["MibCanDelete"] is true;
    var caption = ViewData["MibCaption"] as string ?? "MIB modules";
}
<div class="mat-table-wrap">
    <table class="mat-table">
        <caption class="mat-sr-only">@caption</caption>
        <thead>
            <tr>
                <th scope="col">Module</th>
                <th scope="col" class="mat-num">Objects</th>
                <th scope="col" class="mat-hide-sm">Revision</th>
                <th scope="col">State</th>
                @if (uploadedAt is not null)
                {
                    <th scope="col" class="mat-hide-sm">Uploaded</th>
                }
                @if (canDelete)
                {
                    <th scope="col"><span class="mat-sr-only">Actions</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var module in Model)
            {
                var problems = module.MissingImports.Count + module.Errors.Count + module.UnresolvedCount;
                <tr>
                    <td data-label="Module" class="mat-table__primary mat-mono">@module.Name</td>
                    <td data-label="Objects" class="mat-num mat-mono">@module.NodeCount</td>
                    <td data-label="Revision" class="mat-hide-sm mat-mono">@FormatRevision(module.LastUpdated)</td>
                    <td data-label="State">
                        @if (problems == 0)
                        {
                            <span class="mat-pill mat-pill--ok">OK</span>
                        }
                        else
                        {
                            <span class="mat-pill mat-pill--warn">@problems issue@(problems == 1 ? "" : "s")</span>
                            <div class="mat-small mat-text-muted">
                                @if (module.MissingImports.Count > 0)
                                {
                                    <div>Missing: @string.Join(", ", module.MissingImports)</div>
                                }
                                @if (module.UnresolvedCount > 0)
                                {
                                    <div>@module.UnresolvedCount object@(module.UnresolvedCount == 1 ? "" : "s") without a known parent</div>
                                }
                                @foreach (var error in module.Errors.Take(3))
                                {
                                    <div>@error</div>
                                }
                                @if (module.Errors.Count > 3)
                                {
                                    <div>… and @(module.Errors.Count - 3) more</div>
                                }
                            </div>
                        }
                    </td>
                    @if (uploadedAt is not null)
                    {
                        <td data-label="Uploaded" class="mat-hide-sm mat-mono">@(uploadedAt.TryGetValue(module.Name, out var at) ? at.ToDisplay().ToString("yyyy-MM-dd HH:mm") : "")</td>
                    }
                    @if (canDelete)
                    {
                        <td class="mat-table__cell-actions">
                            <div class="mat-table__actions">
                                <form method="post" asp-page="/Mibs" asp-page-handler="Delete">
                                    <input type="hidden" name="module" value="@module.Name" />
                                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Remove @module.Name" data-tip="Remove"
                                            data-confirm="Remove @module.Name?" data-confirm-ok="Remove">@MatUi.Icon("trash")</button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
@functions {
    // LAST-UPDATED is "YYYYMMDDHHMMZ" (or the SMIv1-era "YYMMDDHHMMZ").
    private static string FormatRevision(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }
        var digits = value.TrimEnd('Z', 'z');
        return digits.Length switch
        {
            >= 8 when digits.Length == 12 => $"{digits[..4]}-{digits[4..6]}-{digits[6..8]}",
            10 => $"19{digits[..2]}-{digits[2..4]}-{digits[4..6]}",
            _ => value
        };
    }
}

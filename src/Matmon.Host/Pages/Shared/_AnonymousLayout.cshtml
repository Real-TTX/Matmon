@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@inject Matmon.Host.Ui.MatUiToolkit Toolkit
@{
    // A page without the menu (SHELL-11): sign-in, the second factor, first-run setup and the setup assistant, errors.
    // A centred card on the plain page background - the page draws the card (mat-auth__card), this draws the frame and
    // the footer. A managing partner's white label applies here too: its product name, its accent, its favicon.
    var partnerProductName = WorkspaceStore.GetServicePartnerProductName();
    var brandName = string.IsNullOrWhiteSpace(partnerProductName) ? "Matmon" : partnerProductName;
    var partnerAccent = Matmon.Core.Domain.BrandingSafety.SafeHexColor(WorkspaceStore.GetServicePartnerBrandColor());
    var partnerHasSmallLogo = WorkspaceStore.GetServicePartnerHasSmallLogo();
    var title = ViewData["Title"]?.ToString() ?? brandName;
}
<!DOCTYPE html>
@* data-console-mode="full": a page of its own (the setup assistant, sign-in, an error) - inside the Matmon.Cloud console it fills the whole console instead of sitting under the cloud's menu (cloud.js reads it when the frame loads). *@
<html lang="en" data-app="matmon" data-console-mode="full" data-custom-accent="@partnerAccent" data-rendered="@DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <partial name="_PwaHead" />
    <title>@title · @brandName</title>
    @if (partnerHasSmallLogo)
    {
        <link rel="icon" href="/api/branding/favicon" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    }
    <script src="~/js/matmon.boot.js" asp-append-version="true"></script>
    <script src="/matui/matui.boot.js?v=@Toolkit.Hash"></script>
    <link rel="stylesheet" href="/matui/matui.css?v=@Toolkit.Hash" />
    <partial name="_AppStyles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="mat-skip" href="#main">Skip to the content</a>
    @Html.Raw(Toolkit.Sprite)
    <main class="mat-auth" id="main">
        @RenderBody()
        <footer class="mat-footer mat-footer--center mat-footer--plain">
            <p class="mat-footer__text">@brandName @Matmon.Probe.MatmonVersion.Current@(partnerProductName is not null ? " · powered by Matmon" : string.Empty)</p>
            <button type="button" class="mat-theme" data-theme-toggle data-theme-state="system" aria-label="Theme: System. Click for Light." title="Theme: System. Click for Light.">
                <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
            </button>
        </footer>
    </main>
    <script src="/matui/matui.js?v=@Toolkit.Hash"></script>
    <partial name="_AppScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

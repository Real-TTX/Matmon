@model WorkspaceModel
@inject Matmon.Host.Services.MibLibrary Mibs
@{
    // The walk result, shared by SensorCreate and SensorAssistant. Names, enum labels, units and descriptions come
    // from the instance's MIBs at render time; the MIB bar uploads more MIBs and relabels these rows in place
    // (initializeSnmpWalkMibs in sensor-run.js, scoped to [data-snmp-walk]), so nobody has to walk again after adding a vendor MIB.
    var items = Model.NewSensor.SnmpWalkItems;
    var named = items.Count(item => Mibs.Translate(item.Oid) is { IsObject: true });
    var isAdmin = User.IsInRole(MatmonUserRole.Admin.ToString());
}
<div class="mat-stack snmp-walk" data-snmp-walk>
    <div class="mat-row snmp-mib-bar" data-snmp-mib-bar>
        <span class="mat-text-muted snmp-mib-summary" data-snmp-mib-summary>
            @MatUi.Icon("book")
            <span>@Mibs.Registry.Modules.Count MIBs loaded@(items.Count > 0 ? $" · names for {named} of {items.Count} OIDs" : "")</span>
        </span>
        @if (isAdmin)
        {
            <label class="mat-btn mat-btn--secondary mat-btn--sm snmp-mib-upload">
                @MatUi.Icon("upload")
                <span>Upload MIB</span>
                <input type="file" multiple accept=".mib,.my,.txt,.zip" hidden data-snmp-mib-upload data-upload-url="/system/mibs?handler=Upload" />
            </label>
            <a class="mat-btn mat-btn--ghost mat-btn--sm" href="/system/mibs" target="_blank" rel="noopener">@MatUi.Icon("external")<span>Manage MIBs</span></a>
        }
        <span class="mat-text-muted snmp-mib-status" data-snmp-mib-status role="status" aria-live="polite"></span>
    </div>

    @if (items.Count > 0)
    {
        @* Picking from a long walk: narrow it (text, numbers only), then tick or untick what is shown in one go. *@
        <div class="mat-row snmp-walk-tools" data-snmp-walk-tools>
            <div class="mat-input-icon snmp-walk-filter">
                @MatUi.Icon("filter")
                <input type="search" class="mat-input" placeholder="Filter by name, OID or value…" aria-label="Filter the walk by name, OID or value" autocomplete="off" data-snmp-walk-filter />
            </div>
            <label class="mat-switch">
                <input type="checkbox" data-snmp-walk-numeric />
                <span class="mat-switch__track"></span>
                <span>Numbers only</span>
            </label>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-snmp-walk-tick="on">@MatUi.Icon("check")<span>Tick shown</span></button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-snmp-walk-tick="off">@MatUi.Icon("x")<span>Untick all</span></button>
            <span class="mat-text-muted snmp-walk-count" data-snmp-walk-count role="status" aria-live="polite">@items.Count(item => item.Selected) of @items.Count ticked</span>
        </div>
        <input type="hidden" name="NewSensor.SnmpWalkId" value="@Model.NewSensor.SnmpWalkId" />
        <div class="mat-table-wrap">
            <table class="mat-table mat-table--compact" data-snmp-walk-list>
                <caption class="mat-sr-only">The OIDs the walk found - tick the ones to monitor</caption>
                <thead>
                    <tr>
                        <th scope="col" class="mat-table__select"><input type="checkbox" data-snmp-walk-all aria-label="Tick or untick every row shown" title="Tick or untick every row shown" /></th>
                        <th scope="col">Name and OID</th>
                        <th scope="col">Value</th>
                        <th scope="col" class="mat-hide-sm">Type</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < items.Count; i++)
                    {
                        var item = items[i];
                        var translation = Mibs.Translate(item.Oid) is { IsObject: true } known ? known : null;
                        var units = translation?.Node.Units;
                        <tr class="@(item.IsNumeric ? "is-numeric" : "is-text")" data-snmp-walk-row data-numeric="@(item.IsNumeric ? "true" : "false")" data-oid="@item.Oid" data-raw-value="@item.Value" title="@translation?.Node.Description">
                            <td data-label="Monitor" class="mat-table__select">
                                <input type="checkbox" id="snmp-walk-@i" name="NewSensor.SnmpWalkSelected" value="@item.Oid" checked="@item.Selected" aria-label="Monitor @(translation?.Name ?? item.Oid)" />
                            </td>
                            <td data-label="Name">
                                <label class="snmp-walk-main" for="snmp-walk-@i">
                                    <strong class="snmp-walk-name" data-snmp-walk-name hidden="@(translation is null)">@translation?.Name</strong>
                                    <span class="mat-mono snmp-walk-oid @(translation is null ? null : "is-secondary")" data-snmp-walk-oid>@item.Oid</span>
                                </label>
                            </td>
                            <td data-label="Value" class="snmp-walk-value" data-snmp-walk-value>@(translation?.FormatValue(item.Value) ?? item.Value)@(units is null ? null : $" {units}")</td>
                            <td data-label="Type" class="mat-hide-sm">
                                <span class="mat-chips">
                                    <span class="mat-tag" data-snmp-walk-module hidden="@(translation is null)">@translation?.Node.Module</span>
                                    <span class="mat-tag mat-mono">@item.Syntax</span>
                                    @if (item.IsNumeric)
                                    {
                                        <span class="mat-pill mat-pill--accent">numeric</span>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

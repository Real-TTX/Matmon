@model Matmon.Host.Ui.MapCarouselNavModel
@*
    Slide controls for a wallboard. One partial for both viewers - it used to be copy-pasted into Maps.cshtml
    and MapPublic.cshtml, which is how the two drifted.

    WHERE it is rendered matters: for "Below the board" the caller puts it AFTER the .map-stage, so it sits under
    the board in normal flow; the overlay modes render it inside the stage, where the absolute positioning
    anchors to the board.

    The slide names are pill tabs in MatUi's look, but deliberately NOT role="tab": they switch a carousel, not
    tab panels, and MatUi's tab behaviour must not claim them. initializeMapCarousel marks the active one.
*@
<div class="map-carousel-nav" data-map-carousel-nav data-map-pagination="@Model.Mode.ToString().ToLowerInvariant()">
    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-carousel-prev aria-label="Previous slide">@MatUi.Icon("chevron-left")</button>
    <div class="mat-tabs mat-tabs--pills map-carousel-dots" role="group" aria-label="Slides">
        @for (var dot = 0; dot < Model.SlideNames.Count; dot++)
        {
            <button type="button" class="mat-tab map-carousel-dot@(dot == 0 ? " is-active" : "")" data-map-carousel-dot data-slide-index="@dot" aria-current="@(dot == 0 ? "true" : null)">@Model.SlideNames[dot]</button>
        }
    </div>
    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-carousel-next aria-label="Next slide">@MatUi.Icon("chevron-right")</button>
</div>

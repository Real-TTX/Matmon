@model Matmon.Host.Pages.MapCompareFieldsModel
@{
    // One partial for the server-rendered tile panels AND the tile <template> the designer clones, so the two
    // markups cannot drift. A select can only post one of its options, so a stored value that is no longer
    // reported anywhere (the sensor was removed, a typed key) is folded in - otherwise any unrelated save
    // would silently switch the chart to the first option.
    var current = Model.ChannelValue ?? string.Empty;
    var known = Model.Options.Any(option => string.Equals(option.Value, current, StringComparison.OrdinalIgnoreCase));
    var ungrouped = Model.Options.Where(option => option.Group is null);
    var groups = Model.Options.Where(option => option.Group is not null).GroupBy(option => option.Group!.Name);
    // Ids in ASP.NET's own shape (Input_Tiles_3__X), so the designer's slide duplication, which rewrites
    // "Input_Tiles_<n>__", gives a cloned panel its own ids - and a label never points at another tile's field.
    // In the <template> the prefix holds "__index__", which the designer replaces like every other occurrence.
    var idBase = Model.NamePrefix.Replace('.', '_').Replace('[', '_').Replace(']', '_') + "_";
    var channelId = idBase + "ListChannelKey_compare";
    var windowId = idBase + "GraphWindowHours_series";
}
<div class="mat-field" data-map-property-series-only>
    <label class="mat-label" for="@channelId">Compare</label>
    <select id="@channelId" name="@(Model.NamePrefix).ListChannelKey" class="mat-select" data-map-compare-channel>
        @foreach (var option in ungrouped)
        {
            <option value="@option.Value" selected="@(string.Equals(option.Value, current, StringComparison.OrdinalIgnoreCase))">@option.Text</option>
        }
        @foreach (var group in groups)
        {
            <optgroup label="@group.Key">
                @foreach (var option in group)
                {
                    <option value="@option.Value" selected="@(string.Equals(option.Value, current, StringComparison.OrdinalIgnoreCase))">@option.Text</option>
                }
            </optgroup>
        }
        @if (!known && current.Length > 0)
        {
            <option value="@current" selected>@current (not reported right now)</option>
        }
    </select>
    <span class="mat-hint">All lines share one scale. To compare different machines, pick a measurement; an exact channel only matches sensors that report that key.</span>
</div>
<div class="mat-field" data-map-property-series-only>
    <label class="mat-label" for="@windowId">Time window</label>
    <select id="@windowId" name="@(Model.NamePrefix).GraphWindowHours" class="mat-select" data-map-graph-window>
        @foreach (var hours in Matmon.Core.Domain.MonitoringMapTile.GraphWindowChoices)
        {
            <option value="@hours" selected="@(hours == Model.WindowHours)">@(hours switch { 1 => "Last hour", 72 => "Last 3 days", 168 => "Last 7 days (averages)", 336 => "Last 14 days (averages)", _ => $"Last {hours} hours" })</option>
        }
    </select>
    <span class="mat-hint">7 and 14 days show averages.</span>
</div>

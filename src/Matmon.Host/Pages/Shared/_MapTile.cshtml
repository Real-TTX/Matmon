@model Matmon.Host.Ui.MapTileRenderModel
@{
    var tile = Model.Tile;
    // One shared card for the dashboard viewer, the public wallboard AND (in editable mode) the designer -
    // true WYSIWYG instead of the designer showing a hand-built "mock" of what the tile might look like.
    var editorAttributes = Model.Editable
        ? $"data-map-tile data-tile-index=\"{Model.Index}\" data-slide-id=\"{Model.SlideId}\""
        : string.Empty;
    var showHead = tile.ShowTitle || tile.ShowStateBadge || Model.Editable;
    // A collection widget renders its own body (rows / SLA figure / clock / heading) and would otherwise ALSO
    // get the generic value + subtitle + kind footer underneath, printing the same number twice and stealing
    // the height the rows need. Heading and Clock drop the footer entirely - they are chrome, not readings.
    var isCollection = tile.Kind is MonitoringMapTileKind.SensorList or MonitoringMapTileKind.AlertFeed
        or MonitoringMapTileKind.Sla or MonitoringMapTileKind.Clock or MonitoringMapTileKind.Heading
        or MonitoringMapTileKind.Image or MonitoringMapTileKind.GeoMap;
    var isChrome = tile.Kind is MonitoringMapTileKind.Clock or MonitoringMapTileKind.Heading;
    // First paint of the clock is server-rendered in the MAP timezone so the tile is never blank and a
    // screenshot/print is correct; initializeMapClocks then ticks it.
    // The one place the head's title is decided, so the footer below can ask "am I about to repeat this?"
    var shownTitle = tile.ShowTitle
        ? (string.IsNullOrWhiteSpace(tile.Title) ? (Model.ElementName ?? Model.KindLabel) : tile.Title)
        : null;
    var clockNow = tile.Kind == MonitoringMapTileKind.Clock
        ? TimeZoneInfo.ConvertTime(DateTimeOffset.Now, MapTileRender.ResolveTimeZone(Model.TimeZoneId))
        : default;
}
<article class="map-tile@(Model.Editable ? " map-tile-editor" : " map-tile-display")@(tile.ShowCard ? "" : " is-plain")"
         data-tile-id="@tile.Id"
         data-state="@Model.StateKey"
         data-kind="@tile.Kind.ToString().ToLowerInvariant()"
         data-visual="@Model.EffectiveVisualType.ToString().ToLowerInvariant()"
         @* How much the tile can say, decided by its height in row units - a one-row tile is a line, a
            two-row tile is a reading, a three-row tile can afford a detail. Emitted server-side rather than
            asked with a container query, because a query container cannot style ITSELF from its own size and
            the tile is the container. *@
         data-density="@(tile.RowSpan <= 1 ? "s" : tile.RowSpan == 2 ? "m" : "l")"
         @Html.Raw(editorAttributes)
         @* Placement and size, both in grid cells. A tile with no column/row yet (added this second, not
            saved) falls back to "auto" so the browser puts it somewhere sensible until the save normalises it. *@
         style="--tile-col: @(tile.Column > 0 ? tile.Column.ToString() : "auto"); --tile-row: @(tile.Row > 0 ? tile.Row.ToString() : "auto"); --tile-span: @tile.ColumnSpan; --tile-rows: @tile.RowSpan; @MapTileRender.TileStyle(tile, Model.StateKey)"
         hidden="@(Model.IsDeleted ? "hidden" : null)">
    @if (Model.Editable)
    {
        <input type="hidden" name="@(Model.FieldNamePrefix).Id" value="@tile.Id" />
        <input type="hidden" name="@(Model.FieldNamePrefix).SlideId" value="@Model.SlideId" data-map-tile-slide-id />
        <input type="hidden" name="@(Model.FieldNamePrefix).IsDeleted" value="@(Model.IsDeleted ? "true" : "false")" data-map-tile-deleted />
        <input type="hidden" name="@(Model.FieldNamePrefix).Column" value="@tile.Column" data-map-tile-column />
        <input type="hidden" name="@(Model.FieldNamePrefix).Row" value="@tile.Row" data-map-tile-row />
        <input type="hidden" name="@(Model.FieldNamePrefix).Order" value="@tile.Order" data-map-tile-order />
    }

    @* The head is an EYEBROW, not a heading: on a board read from across a room the reading is the hero and
       the name is its caption, so the name sits above it small and quiet rather than competing with it in
       bold. The state badge only appears when the state is worth a word - an "OK" pill on a green card is a
       label for something the colour already said - so a healthy tile gets a dot instead. *@
    @if (showHead)
    {
        <div class="map-tile-head@(Model.Editable ? " map-tile-drag-handle" : "")" data-map-drag-handle="@(Model.Editable ? "" : null)">
            <span class="map-tile-icon">@MatmonIcons.Render(Model.IconKey)</span>
            @if (tile.ShowTitle)
            {
                <strong data-tile-title>@shownTitle</strong>
            }
            @if (tile.ShowStateBadge)
            {
                @if (Model.StateKey == "ok")
                {
                    <span class="map-tile-state-dot" data-state="@Model.StateKey" title="@Model.StateLabel" aria-label="@Model.StateLabel"></span>
                    <span class="state-pill is-collapsed" data-state="@Model.StateKey" data-tile-state-label hidden>@Model.StateLabel</span>
                }
                else
                {
                    <span class="state-pill" data-state="@Model.StateKey" data-tile-state-label>@Model.StateLabel</span>
                }
            }
            @if (Model.Editable)
            {
                <button type="button" class="map-tile-remove" data-map-remove-tile aria-label="Remove tile">@MatmonIcons.Render("trash")</button>
            }
        </div>
    }

    <div class="map-tile-body">

    @* --- Collection widgets ------------------------------------------------------------------------- *@
    @if (tile.Kind == MonitoringMapTileKind.Heading)
    {
        <div class="map-tile-heading">
            <strong>@(string.IsNullOrWhiteSpace(tile.Title) ? "Heading" : tile.Title)</strong>
            @if (!string.IsNullOrWhiteSpace(tile.Text))
            {
                <small>@tile.Text</small>
            }
        </div>
    }
    else if (tile.Kind == MonitoringMapTileKind.Clock)
    {
        @* Server-rendered first paint so the tile is never blank (and prints/screenshots correctly), then
           initializeMapClocks ticks it in the MAP's timezone - not the browser's, because the public
           wallboard has nobody signed in and every other timestamp on the board is server-side. *@
        <div class="map-tile-clock" data-map-clock data-time-zone="@Model.TimeZoneId">
            <strong data-clock-time>@clockNow.ToString("HH:mm")</strong>
            <small data-clock-date>@clockNow.ToString("ddd dd MMM")</small>
        </div>
    }
    else if (Model.Sla is { } sla)
    {
        <div class="map-tile-sla">
            <strong>@(sla.Percent is { } pct ? pct.ToString("0.##") + " %" : "-")</strong>
            <small>@sla.Label</small>
        </div>
    }
    else if (Model.Rows is { } rows)
    {
        @if (rows.Count == 0)
        {
            <p class="map-tile-rows-empty">@(tile.Kind == MonitoringMapTileKind.AlertFeed ? "No open alerts" : "No sensors")</p>
        }
        else
        {
            <ul class="map-tile-rows">
                @foreach (var row in rows)
                {
                    <li class="map-tile-row" data-state="@row.Tone">
                        <span class="map-tile-row-label">
                            <strong>@row.Label</strong>
                            @if (!string.IsNullOrWhiteSpace(row.Detail))
                            {
                                <small>@row.Detail</small>
                            }
                        </span>
                        @if (!string.IsNullOrWhiteSpace(row.Value))
                        {
                            <span class="map-tile-row-value">@row.Value</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.TimeText))
                        {
                            <span class="map-tile-row-time">@row.TimeText</span>
                        }
                    </li>
                }
            </ul>
        }
    }
    else if (tile.Kind == MonitoringMapTileKind.Image || tile.Kind == MonitoringMapTileKind.GeoMap)
    {
        @* One frame for both: the world map is just a different picture behind the same pin layer, and pins
           are positioned in percent so they hold at any rendered size and under any object-fit. *@
        <div class="map-tile-canvas" data-map-pin-canvas>
            @if (tile.Kind == MonitoringMapTileKind.GeoMap)
            {
                @* Not an <img>: an SVG loaded through one is its OWN document, so the file's
                   fill="currentColor" resolved against the SVG's initial colour - black - and the map was a
                   black silhouette in both themes, invisible on a dark card. As a CSS mask it is still one
                   cached external asset, but the colour comes from this page. *@
                <span class="map-tile-worldmap" aria-hidden="true"></span>
            }
            else if (tile.ImageAssetId is { } assetId)
            {
                <img class="map-tile-image" src="/api/map-assets/@assetId" alt="@(tile.Title ?? "Map image")"
                     style="object-fit: @MapTileRender.ImageFitCss(tile.ImageFit);" />
            }
            else
            {
                <span class="map-tile-canvas-empty">No image uploaded</span>
            }

            @foreach (var pin in Model.Pins ?? [])
            {
                <span class="map-pin" data-state="@pin.Tone" data-pin-style="@pin.Style"
                      style="left: @pin.X.ToString(System.Globalization.CultureInfo.InvariantCulture)%; top: @pin.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)%;"
                      title="@pin.Label">
                    <span class="map-pin-dot" aria-hidden="true"></span>
                    @if (pin.ShowLabel || pin.Style == "tile")
                    {
                        <span class="map-pin-label">
                            <strong>@pin.Label</strong>
                            @if (!string.IsNullOrWhiteSpace(pin.Value))
                            {
                                <small>@pin.Value</small>
                            }
                        </span>
                    }
                </span>
            }
        </div>
    }

    @if (tile.Kind == MonitoringMapTileKind.Graph)
    {
        <div class="map-tile-graph-frame">
            @if (!string.IsNullOrWhiteSpace(Model.GraphLinePath))
            {
                <svg class="map-tile-graph" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                    @if (tile.GraphType == MonitoringMapTileGraphType.Area && !string.IsNullOrWhiteSpace(Model.GraphAreaPath))
                    {
                        <path class="map-graph-area" d="@Model.GraphAreaPath" data-tile-graph-area></path>
                    }
                    @if (tile.GraphType == MonitoringMapTileGraphType.Bars && !string.IsNullOrWhiteSpace(Model.GraphBarPath))
                    {
                        <path class="map-graph-bars" d="@Model.GraphBarPath" data-tile-graph-bars></path>
                    }
                    else
                    {
                        <path class="map-graph-line" d="@Model.GraphLinePath" data-tile-graph-line></path>
                    }
                </svg>
            }
            else
            {
                <span>No graph data yet</span>
            }
        </div>
    }

    @if (Model.ProgressPercent.HasValue && Model.EffectiveVisualType == MonitoringMapTileVisualType.Gauge)
    {
        @* A real dial: a 180-degree arc carrying pathLength="100", so the fill is set straight from the
           percentage with no path maths anywhere. It used to be a 360-degree conic-gradient donut - a ring
           chart, not a gauge, and it contradicted the very schematic the palette draws for this widget.
           The big figure is the READING (with its unit); the caption underneath is the scale, because a
           needle two thirds of the way round is unreadable if nothing says two thirds of what. *@
        <div class="map-tile-gauge" data-tile-progress style="--map-progress: @MapTileRender.FormatProgressPercent(Model.ProgressPercent)">
            @* The readout sits in a box that is exactly the ARC's box, not the tile's. The SVG is fitted by
               height, so on a wide, short tile (a stacked phone card) the arc is only a fraction of the tile
               wide - a readout sized against the tile spilled straight over the stroke. *@
            <span class="map-gauge-dial">
                <svg class="map-gauge" viewBox="0 0 100 58" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                    <path class="map-gauge-track" d="M8 52 A42 42 0 0 1 92 52" pathLength="100" />
                    <path class="map-gauge-fill" d="M8 52 A42 42 0 0 1 92 52" pathLength="100" />
                </svg>
                <span class="map-gauge-readout">
                    <strong data-tile-value>@(string.IsNullOrWhiteSpace(Model.Value) ? MapTileRender.FormatProgressLabel(Model.ProgressPercent) : Model.Value)</strong>
                    <small data-tile-progress-label>@Model.ProgressLabel</small>
                </span>
            </span>
        </div>
    }
    else if (Model.ProgressPercent.HasValue && Model.EffectiveVisualType == MonitoringMapTileVisualType.ProgressBar)
    {
        <div class="map-tile-progress-wrap">
            <div class="map-tile-progress" data-tile-progress style="--map-progress: @MapTileRender.FormatProgressPercent(Model.ProgressPercent)">
                <span></span>
            </div>
            <small data-tile-progress-label>@Model.ProgressLabel</small>
        </div>
    }

    @* "Gauge" only suppresses the plain reading when a dial was actually DRAWN. A gauge pointed at a channel
       with no scale draws none (see MapDisplayProvider.ResolveSensorProgressPercent), and skipping the value
       as well left that tile completely blank - the reading is still the point of the widget. *@
    @* A GRAPH's widget is the trend; printing the latest reading underneath it at the value tile's size put a
       52cqh figure in a tile that had already spent its height on the chart, and it simply overflowed. The
       number is still on the tile - in the caption line, where it belongs next to a curve. *@
    @if (!isCollection && tile.Kind != MonitoringMapTileKind.Graph && !string.IsNullOrWhiteSpace(Model.Value)
        && (Model.EffectiveVisualType != MonitoringMapTileVisualType.Gauge || !Model.ProgressPercent.HasValue))
    {
        <div class="map-tile-value" data-tile-value>@Model.Value</div>
    }

    </div>

    @* ONE detail line, and only when it says something the eyebrow did not. An SLA tile already prints its
       window under the percentage; a subtitle that repeats the sensor type under a tile named after the
       sensor is a line of wallboard height spent on nothing. *@
    @if (!isChrome && Model.Sla is null)
    {
        // The kind label only earns a line when nothing else names the tile ("State" under every state tile
        // is a caption you read once), and the target name only when it differs from the eyebrow above it.
        var showElementName = tile.ShowElementName
            && !string.IsNullOrWhiteSpace(Model.ElementName)
            && !string.Equals(shownTitle, Model.ElementName, StringComparison.OrdinalIgnoreCase);
        var showKindLabel = !tile.ShowTitle;
        <div class="map-tile-foot">
        <p data-tile-subtitle>@Model.Subtitle</p>
        @if (showKindLabel || showElementName)
        {
            <small data-map-tile-kind-label>
                @if (showKindLabel)
                {
                    @Model.KindLabel
                }
                @if (showKindLabel && showElementName)
                {
                    <text> - </text>
                }
                @if (showElementName)
                {
                    @Model.ElementName
                }
            </small>
        }
        </div>
    }

    @if (Model.Editable)
    {
        <span class="map-tile-size-badge" data-map-tile-size-badge aria-hidden="true">@tile.ColumnSpan &times; @tile.RowSpan</span>
        <span class="map-tile-resize-handle" data-map-resize-handle aria-hidden="true"></span>
    }
</article>

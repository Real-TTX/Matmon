@model Matmon.Host.Ui.MapSlideRenderModel
@{
    var slide = Model.Slide;
    var map = Model.Map;
    var showHeader = map.ShowSlideHeaders && slide.ShowHeader &&
        (!string.IsNullOrWhiteSpace(slide.Title) || !string.IsNullOrWhiteSpace(slide.Subtitle));
    // v3: the slide IS a CSS grid and the browser does the wrapping, so there is no px geometry to emit -
    // only how many columns, how tall a row unit is and the gap. --map-rows is what a wallboard scales to fit.
    var slideStyle = $"--map-columns: {Math.Max(1, map.Columns)}; --map-rows: {Math.Max(1, map.Rows)}; --tile-gap: {map.TilePadding}px; --map-margin: {map.OuterMargin}px;"
        + (string.IsNullOrWhiteSpace(slide.BackgroundColor) ? string.Empty : $" --slide-bg: {slide.BackgroundColor};");
    // DOM order IS the layout now (grid auto-placement), so this sort is the single place the flow order is
    // applied - the viewer, the wallboard and the designer all read it from here.
    var orderedTiles = Model.Tiles.OrderBy(t => t.Tile.Order).ToList();
}
<section class="map-slide@(Model.Editable ? " map-slide-editable" : "")"
         data-map-slide
         data-slide-id="@slide.Id"
         data-slide-index="@Model.SlideIndex"
         data-slide-duration="@(slide.DurationSeconds?.ToString() ?? "")"
         style="@slideStyle"
         hidden="@(Model.SlideIndex == 0 ? null : "hidden")">
    @if (showHeader)
    {
        <header class="map-slide-header">
            @if (!string.IsNullOrWhiteSpace(slide.Title))
            {
                <h2>@slide.Title</h2>
            }
            @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
            {
                <p>@slide.Subtitle</p>
            }
        </header>
    }
    @if (Model.Editable)
    {
        @* Column guides: one stripe per column, laid out by the SAME grid as the tiles, so they cannot drift
           from where a tile will actually land. A flow has no fixed rows, so there is nothing to draw across. *@
        <div class="map-grid-guides" aria-hidden="true">
            @for (var column = 0; column < Math.Max(1, map.Columns); column++)
            {
                <span class="map-grid-column"></span>
            }
        </div>
    }
    @foreach (var tile in orderedTiles)
    {
        <partial name="_MapTile" model="tile" />
    }
</section>

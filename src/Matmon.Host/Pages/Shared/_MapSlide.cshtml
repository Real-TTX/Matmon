@model Matmon.Host.Ui.MapSlideRenderModel
@{
    var slide = Model.Slide;
    var map = Model.Map;
    var showHeader = map.ShowSlideHeaders && slide.ShowHeader &&
        (!string.IsNullOrWhiteSpace(slide.Title) || !string.IsNullOrWhiteSpace(slide.Subtitle));
    // The slide IS a CSS grid and the browser does the layout, so there is no px geometry to emit - only how
    // many columns, how many rows fill a screen and the gap. All of it is geometry that is data, so it travels
    // as custom properties (each written with its name). A slide without its own background gets "initial", the
    // guaranteed-invalid value, so the stylesheet's fallback (the board background) applies.
    var columns = Math.Max(1, map.Columns);
    var rows = Math.Max(1, map.Rows);
    var slideBackground = BrandingSafety.SafeHexColor(slide.BackgroundColor) ?? "initial";
    // DOM order IS the reading order, so this sort is the single place it is applied - the viewer, the
    // wallboard and the designer all read it from here, and the stacked phone view needs nothing else.
    var orderedTiles = Model.Tiles.OrderBy(t => t.Tile.Order).ToList();
}
<section class="map-slide@(Model.Editable ? " map-slide-editable" : "")"
         data-map-slide
         data-slide-id="@slide.Id"
         data-slide-index="@Model.SlideIndex"
         data-slide-duration="@(slide.DurationSeconds?.ToString() ?? "")"
         style="--map-columns: @columns; --map-rows: @rows; --tile-gap: @(map.TilePadding)px; --map-margin: @(map.OuterMargin)px; --slide-bg: @slideBackground"
         hidden="@(Model.SlideIndex == 0 ? null : "hidden")">
    @if (showHeader)
    {
        <header class="map-slide-header">
            @if (!string.IsNullOrWhiteSpace(slide.Title))
            {
                <h2>@slide.Title</h2>
            }
            @if (!string.IsNullOrWhiteSpace(slide.Subtitle))
            {
                <p>@slide.Subtitle</p>
            }
        </header>
    }
    @if (Model.Editable)
    {
        @* Cell guides, laid out by the SAME grid definition as the tiles, so they cannot drift from where a
           tile will actually land. One screen's worth of cells. *@
        <div class="map-grid-guides" aria-hidden="true">
            @for (var cell = 0; cell < columns * rows; cell++)
            {
                <span class="map-grid-cell-guide"></span>
            }
        </div>
    }
    @foreach (var tile in orderedTiles)
    {
        <partial name="_MapTile" model="tile" />
    }
</section>

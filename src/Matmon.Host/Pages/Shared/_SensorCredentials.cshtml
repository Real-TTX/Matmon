@using Matmon.Core.Domain
@model ISensorCredentialEditor
@{
    var credentialFields = Model.SensorParameterFields.Where(field => field.IsCredential).ToList();
}
@if (credentialFields.Count > 0)
{
    <div class="workspace-span-2 sensor-credential-section" data-sensor-tab="credentials">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("key")<span>Credentials</span></h2>
            <span class="panel-hint">auto by type</span>
        </div>
        <div class="workspace-inline-note">Auto / inherit uses the first inherited credential with the matching sensor type. Select a specific bundle only when this sensor should override that automatic choice.</div>

        @if (Model.CredentialOptions.Count > 0)
        {
            <label class="workspace-span-2 sensor-credential-select-field">
                <span>Credential selection</span>
                <select asp-for="SelectedCredentialId" class="form-select workspace-select" asp-items="Model.CredentialOptions" data-sensor-credential-select></select>
            </label>
        }

        <div class="sensor-parameter-list">
            @for (var i = 0; i < Model.SensorParameterFields.Count; i++)
            {
                var field = Model.SensorParameterFields[i];
                if (!field.IsCredential)
                {
                    continue;
                }

                <div class="sensor-parameter-card"
                     data-sensor-parameter-field
                     data-parameter-key="@field.Key"
                     data-visible-when-key="@field.VisibleWhenParameterKey"
                     data-visible-when-values="@field.VisibleWhenValuesText"
                     data-inherited-value="@field.InheritedValue"
                     data-effective-value="@field.EffectiveValue"
                     hidden="@(!field.IsVisible ? "hidden" : null)">
                    <input type="hidden" asp-for="SensorParameterFields[i].Key" />
                    <div class="sensor-parameter-head">
                        <div>
                            <div class="sensor-parameter-name">@field.Label</div>
                            @if (!string.IsNullOrWhiteSpace(field.Description))
                            {
                                <div class="sensor-parameter-help">@field.Description</div>
                            }
                        </div>
                        @if (field.Required)
                        {
                            <span class="sensor-required">required</span>
                        }
                    </div>

                    @switch (field.Kind)
                    {
                        case SensorParameterKind.ValueList:
                        case SensorParameterKind.Boolean:
                            <select asp-for="SensorParameterFields[i].Value" class="form-select workspace-select" asp-items="field.Options"></select>
                            break;
                        case SensorParameterKind.Secret:
                            @* Keep a just-typed secret across a Test/Preview/validation re-post — only on POST,
                               so a stored secret is never echoed on the initial GET. *@
                            <input asp-for="SensorParameterFields[i].Value" type="password" autocomplete="off" class="form-control workspace-input" value="@(string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase) ? field.Value : null)" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                            break;
                        default:
                            <input asp-for="SensorParameterFields[i].Value" type="text" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                            break;
                    }
                </div>
            }
        </div>
    </div>
}

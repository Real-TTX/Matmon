@using Matmon.Core.Domain
@model ISensorCredentialEditor
@*
    The credential selector and the credential fields of a sensor: the sensor editors' tab panel "credentials"
    (id panel-credentials, its tab is tab-credentials). Rendered only when the sensor type has credential fields - a page
    shows the tab under the same condition. ViewData["SensorEditorPanels"] = false draws it without the panel (the
    assistant); ViewData["SensorEditorTab"] = "credentials" opens the panel.
*@
@{
    var credentialFields = Model.SensorParameterFields.Where(field => field.IsCredential).ToList();
    var asPanel = ViewData["SensorEditorPanels"] is not false;
    var open = string.Equals(ViewData["SensorEditorTab"] as string, "credentials", StringComparison.OrdinalIgnoreCase);
    var isPost = string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase);
}
@if (credentialFields.Count > 0)
{
    <div class="@(asPanel ? "mat-tabpanel mat-stack" : "mat-stack")" role="@(asPanel ? "tabpanel" : null)" id="@(asPanel ? "panel-credentials" : null)" aria-labelledby="@(asPanel ? "tab-credentials" : null)" hidden="@(asPanel && !open)">
        <section class="mat-card sensor-credential-section">
            <div class="mat-card__head">
                @MatUi.Icon("key")
                <h2 class="mat-card__title">Credentials</h2>
                <span class="mat-text-muted mm-push-end">auto by type</span>
            </div>
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">Auto / inherit uses the first inherited credential with the matching sensor type. Select a specific bundle only when this sensor should override that automatic choice.</p>

                @if (Model.CredentialOptions.Count > 0)
                {
                    <div class="mat-field">
                        <label class="mat-label" asp-for="SelectedCredentialId">Credential selection</label>
                        <select asp-for="SelectedCredentialId" class="mat-select" asp-items="Model.CredentialOptions" data-sensor-credential-select></select>
                    </div>
                }

                <div class="mat-form__grid">
                    @for (var i = 0; i < Model.SensorParameterFields.Count; i++)
                    {
                        var field = Model.SensorParameterFields[i];
                        if (!field.IsCredential)
                        {
                            continue;
                        }
                        var placeholder = field.DisplayPlaceholder ?? field.Placeholder;

                        <div class="mat-field"
                             data-sensor-parameter-field
                             data-parameter-key="@field.Key"
                             data-visible-when-key="@field.VisibleWhenParameterKey"
                             data-visible-when-values="@field.VisibleWhenValuesText"
                             data-inherited-value="@field.InheritedValue"
                             data-effective-value="@field.EffectiveValue"
                             hidden="@(!field.IsVisible)">
                            <input type="hidden" asp-for="SensorParameterFields[i].Key" />
                            <label class="mat-label" asp-for="SensorParameterFields[i].Value">
                                <span>@field.Label</span>
                                @if (field.Required)
                                {
                                    <span class="mat-req" aria-hidden="true">*</span>
                                    <span class="mat-sr-only">(required)</span>
                                }
                            </label>

                            @switch (field.Kind)
                            {
                                case SensorParameterKind.ValueList:
                                case SensorParameterKind.Boolean:
                                    <select asp-for="SensorParameterFields[i].Value" class="mat-select" asp-items="field.Options"></select>
                                    break;
                                case SensorParameterKind.Secret:
                                    @* Keep a just-typed secret across a Test/Preview/validation re-post - only on POST,
                                       so a stored secret is never echoed on the initial GET. *@
                                    <input asp-for="SensorParameterFields[i].Value" type="password" autocomplete="off" class="mat-input" value="@(isPost ? field.Value : null)" placeholder="@placeholder" />
                                    break;
                                default:
                                    <input asp-for="SensorParameterFields[i].Value" type="text" class="mat-input" placeholder="@placeholder" />
                                    break;
                            }

                            @if (!string.IsNullOrWhiteSpace(field.Description))
                            {
                                <span class="mat-hint">@field.Description</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
}

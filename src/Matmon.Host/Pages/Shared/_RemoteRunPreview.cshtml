@model WorkspaceModel
@*
    When a "Test" or SNMP-discover is routed to a remote probe the run is asynchronous: the primary only
    queued a run job. This card carries the job id so sensor-run.js (initializeRemoteRunPreviews) can poll
    GET /api/run-jobs/{id} and render the channel preview / discovered OIDs into [data-remote-run-body] once the
    probe reports back. The local (in-process) path is fully synchronous and renders nothing here.
*@
@if (Model.RemoteTestJobId is Guid testJobId)
{
    <section class="mat-card remote-run-preview" data-remote-run-job="@testJobId" data-remote-run-kind="sensor" data-remote-run-probe="@Model.RemoteRunProbeName" role="status" aria-live="polite">
        <div class="mat-card__body mat-stack mat-stack--sm" data-remote-run-body>
            <p class="mat-row remote-run-preview-status" data-remote-run-status>
                <span class="mat-spinner mat-spinner--sm" aria-hidden="true"></span>
                <span>Testing on probe @Model.RemoteRunProbeName…</span>
            </p>
        </div>
    </section>
}
@if (Model.RemoteSnmpDiscoverJobId is Guid snmpJobId)
{
    <section class="mat-card remote-run-preview" data-remote-run-job="@snmpJobId" data-remote-run-kind="snmp" data-remote-run-probe="@Model.RemoteRunProbeName" role="status" aria-live="polite">
        <div class="mat-card__body mat-stack mat-stack--sm" data-remote-run-body>
            <p class="mat-row remote-run-preview-status" data-remote-run-status>
                <span class="mat-spinner mat-spinner--sm" aria-hidden="true"></span>
                <span>Discovering OIDs on probe @Model.RemoteRunProbeName…</span>
            </p>
        </div>
    </section>
}

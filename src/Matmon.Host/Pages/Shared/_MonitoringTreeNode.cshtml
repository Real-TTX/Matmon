@model WorkspaceMonitoringTreeNode
@*
    One node of the monitoring tree (Sensors page, tree view), recursively: a container (probe, folder, host) is a row with
    its toggle, kind, name, details, tags, counts and its action menu, then its children - the sensors as a strip of chips,
    then the child containers. A sensor at the top level is a single chip. monitoring.js reads the data-tree-* attributes
    (expand/collapse, move) and opens a row's menu at the pointer on right-click; dashboard.js updates the chips live by
    data-series-key (value, unit, data-state, the sparkline, data-role="state").
    The menus are MatUi menus (data-menu-toggle + .mat-menu) inside their node, so closest("[data-tree-node]") finds it.
*@
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    // Viewers are read-only: gate every mutating affordance behind admin (the write-guard enforces
    // it server-side too - this just hides the controls).
    var isAdmin = User.IsInRole(MatmonUserRole.Admin.ToString());
    var canAddFolder = isAdmin && (Model.Kind == MonitoringElementKind.Probe || Model.Kind == MonitoringElementKind.Folder);
    var canAddHost = isAdmin && (Model.Kind == MonitoringElementKind.Probe || Model.Kind == MonitoringElementKind.Folder);
    var canAddSensor = isAdmin && Model.Kind != MonitoringElementKind.Sensor;
    var canDiscover = isAdmin && Model.Kind is MonitoringElementKind.Probe or MonitoringElementKind.Folder or MonitoringElementKind.Host;
    var hasChildActions = canAddFolder || canAddHost || canAddSensor;
    var isRootMasterProbe = Model.Kind == MonitoringElementKind.Probe && Model.Depth == 0;
    var isProbeRoot = Model.Kind == MonitoringElementKind.Probe && Model.Depth > 0;
    var sensorChildren = Model.Children.Where(child => child.Kind == MonitoringElementKind.Sensor).ToArray();
    var branchChildren = Model.Children.Where(child => child.Kind != MonitoringElementKind.Sensor).ToArray();
    var isSensorNode = Model.Kind == MonitoringElementKind.Sensor;
    var kindKey = Model.Kind.ToString().ToLowerInvariant();
    // Delete is available on every element (with confirmation) except the local root
    // probe, which the store refuses to delete anyway. Viewers can't delete.
    var canDelete = isAdmin && !isRootMasterProbe;
    // A viewer gets a container's menu only where it holds something for them (a probe's usage page).
    var hasMenu = isAdmin || Model.Kind == MonitoringElementKind.Probe;
    // Sibling ids passed down by the parent so a node can reorder among its siblings
    // (Move up/down). Null = no sibling on that side.
    var prevSiblingId = ViewData["PrevSiblingId"] as Guid?;
    var nextSiblingId = ViewData["NextSiblingId"] as Guid?;

    // The glyph of a chip's state (its shape says the state too, not only its colour; the word is there for screen readers).
    string StatusIcon(WorkspaceMonitoringTreeNode node) => node.StateKey switch
    {
        "ok" => "check",
        "warning" => "alert",
        "error" => "x",
        "paused" or "disabled" => "pause",
        _ => MatmonIcons.SpriteName(node.KindIconKey)
    };
}

<article class="monitoring-tree-node @(Model.Children.Count > 0 ? "is-branch" : "is-leaf") @(isRootMasterProbe ? "is-master-probe" : string.Empty) @(isProbeRoot ? "is-probe-root" : string.Empty)"
         data-tree-node
         data-tree-node-id="@Model.Id"
         data-tree-kind="@kindKey"
         data-tree-depth="@Model.Depth"
         data-tree-path="@Model.Path"
         data-state="@Model.StateKey"
         data-acknowledged="@(Model.IsAcknowledged ? "true" : "false")">
    @if (isSensorNode)
    {
        <div class="monitoring-sensor-strip is-single-sensor">
            <article class="monitoring-sensor-chip"
                     data-series-key="@Model.SeriesKey"
                     data-tree-node
                     data-tree-node-id="@Model.Id"
                     data-tree-kind="sensor"
                     data-tree-depth="@Model.Depth"
                     data-tree-path="@Model.Path"
                     data-state="@Model.StateKey"
                     data-acknowledged="@(Model.IsAcknowledged ? "true" : "false")">
                <a class="monitoring-sensor-chip-main" asp-page="/SensorDetails" asp-route-sensorId="@Model.Id" title="@Model.Path">
                    <span class="monitoring-sensor-status">@MatUi.Icon(StatusIcon(Model))<span class="mat-sr-only" data-role="state">@Model.StateLabel</span></span>
                    <span class="tree-name monitoring-sensor-name">@Model.Name</span>
                    <span class="monitoring-sensor-value">
                        <span data-role="current-value">@(Model.CurrentValue.HasValue ? Model.CurrentValue.Value.ToString("0.###") : "-")</span>
                        <span data-role="current-unit">@Model.Unit</span>
                    </span>
                    <span class="monitoring-sensor-meta">
                        <span>@(Model.SensorTypeLabel ?? Model.SensorTypeKey ?? "Sensor")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.LastCheck))
                        {
                            <span>@Model.LastCheck</span>
                        }
                        @if (Model.Tags.Count > 0)
                        {
                            <span class="monitoring-sensor-tags" data-tag-overflow>
                                @foreach (var tag in Model.Tags)
                                {
                                    <span class="mat-tag" data-tag-chip>@tag</span>
                                }
                            </span>
                        }
                    </span>
                    <svg class="sparkline monitoring-sensor-graph" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                        <path data-role="area"></path>
                        <path data-role="line"></path>
                    </svg>
                </a>
                <div class="monitoring-sensor-overlay-actions">
                    <a class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm" asp-page="/SensorDetails" asp-route-sensorId="@Model.Id" aria-label="Open @Model.Name" data-tip="Open sensor">@MatUi.Icon("eye")</a>
                    @if (isAdmin)
                    {
                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm" data-menu-toggle="sensor-menu-@Model.Id" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false" aria-label="Actions for @Model.Name" data-tip="Actions">@MatUi.Icon("more-horizontal")</button>
                    }
                </div>
                @if (isAdmin)
                {
                    <div class="mat-menu" id="sensor-menu-@Model.Id" role="menu" aria-label="Actions for @Model.Name" hidden>
                        <form method="post" class="mat-menu__form" asp-page-handler="RunSensor" asp-route-sensorId="@Model.Id" asp-route-returnUrl="@returnUrl">
                            <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("play")<span>Run now</span></button>
                        </form>
                        <div class="mat-menu__sep" role="separator"></div>
                        <a class="mat-menu__item" role="menuitem" asp-page="/SensorDetails" asp-route-sensorId="@Model.Id">@MatUi.Icon("bar-chart")<span>Details</span></a>
                        <a class="mat-menu__item" role="menuitem" asp-page="/ElementEditor" asp-route-selectedId="@Model.Id">@MatUi.Icon("edit")<span>Edit</span></a>
                        <button type="button" class="mat-menu__item" role="menuitem" data-tree-move-start>@MatUi.Icon("route")<span data-tree-move-start-text>Move</span></button>
                        <div class="mat-menu__sep" role="separator"></div>
                        <form method="post" class="mat-menu__form" asp-page-handler="ToggleSensorPause" asp-route-sensorId="@Model.Id" asp-route-returnUrl="@returnUrl">
                            <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon(Model.IsPaused ? "play" : "pause")<span>@(Model.IsPaused ? "Resume" : "Pause")</span></button>
                        </form>
                        @if (canDelete)
                        {
                            <div class="mat-menu__sep" role="separator"></div>
                            <form method="post" class="mat-menu__form" asp-page-handler="DeleteElement">
                                <input type="hidden" name="ElementEditor.Id" value="@Model.Id" />
                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem"
                                        data-confirm="Delete this sensor?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete</span></button>
                            </form>
                        }
                    </div>
                }
            </article>
        </div>
    }
    else
    {
        <div class="monitoring-tree-row">
            @if (branchChildren.Length > 0 || sensorChildren.Length > 0)
            {
                <button type="button"
                        class="monitoring-tree-toggle"
                        data-tree-toggle
                        data-tree-label="@Model.Name"
                        aria-expanded="true"
                        aria-label="Collapse @Model.Name">
                    @MatUi.Icon("chevron-right")
                </button>
            }
            else
            {
                <span class="monitoring-tree-toggle is-spacer" aria-hidden="true"></span>
            }

            <span class="tree-kind" data-kind="@kindKey" title="@Model.Kind">@MatmonIcons.Render(Model.KindIconKey)<span class="mat-sr-only">@Model.Kind</span></span>

            <div class="monitoring-tree-main">
                <span class="tree-name">@Model.Name</span>
                @if (Model.IsAgentHost)
                {
                    <span class="mat-pill mat-pill--info mm-agent-badge" title="A Matmon agent runs on this machine">@MatUi.Icon("plug")<span>Agent</span></span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Details))
                {
                    <span class="monitoring-tree-details">@Model.Details</span>
                }
                @if (Model.Tags.Count > 0)
                {
                    <span class="monitoring-tree-tags">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="mat-tag">@tag</span>
                        }
                    </span>
                }
            </div>

            <div class="monitoring-tree-side">
                @* Container summary as pills (no state pill: the row's left edge already shows the rolled-up state). *@
                <span class="mat-pill mat-pill--plain">@Model.SensorCount @(Model.SensorCount == 1 ? "Sensor" : "Sensors")</span>
                @if (Model.WarningCount > 0)
                {
                    <span class="mat-pill mat-pill--warn">@Model.WarningCount Warning</span>
                }
                @if (Model.ErrorCount > 0)
                {
                    <span class="mat-pill mat-pill--error">@Model.ErrorCount Error</span>
                }
                @if (Model.IsHighlighted)
                {
                    <span class="mat-pill mat-pill--accent">@MatUi.Icon("star")<span>Highlight</span></span>
                }
                <div class="monitoring-tree-actions">
                    @if (hasMenu)
                    {
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-menu-toggle="tree-menu-@Model.Id" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false" aria-label="Actions for @Model.Name" data-tip="Actions">@MatUi.Icon("more-horizontal")</button>
                        <div class="mat-menu" id="tree-menu-@Model.Id" role="menu" aria-label="Actions for @Model.Name" hidden>
                            @if (canDiscover)
                            {
                                <form method="post" class="mat-menu__form" asp-page="/Discovery" asp-page-handler="Scope">
                                    <input type="hidden" name="scopeElementId" value="@Model.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("search")<span>Discover sensors</span></button>
                                </form>
                            }
                            @if (Model.Kind == MonitoringElementKind.Probe)
                            {
                                <a class="mat-menu__item" role="menuitem" asp-page="/ProbeUsage" asp-route-probeElementId="@Model.Id" asp-route-returnUrl="@returnUrl">@MatUi.Icon("bar-chart")<span>Usage</span></a>
                            }
                            @if (isAdmin)
                            {
                                <a class="mat-menu__item" role="menuitem" asp-page="/ElementEditor" asp-route-selectedId="@Model.Id">@MatUi.Icon("edit")<span>Edit</span></a>
                                <button type="button" class="mat-menu__item" role="menuitem" data-tree-move-start>@MatUi.Icon("route")<span data-tree-move-start-text>Move</span></button>
                                @if (prevSiblingId.HasValue)
                                {
                                    <form method="post" class="mat-menu__form" asp-page-handler="MoveElementBefore" asp-route-elementId="@Model.Id" asp-route-siblingId="@prevSiblingId.Value" asp-route-returnUrl="@returnUrl">
                                        <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("arrow-up")<span>Move up</span></button>
                                    </form>
                                }
                                @if (nextSiblingId.HasValue)
                                {
                                    <form method="post" class="mat-menu__form" asp-page-handler="MoveElementAfter" asp-route-elementId="@Model.Id" asp-route-siblingId="@nextSiblingId.Value" asp-route-returnUrl="@returnUrl">
                                        <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("arrow-down")<span>Move down</span></button>
                                    </form>
                                }
                                <div class="mat-menu__sep" role="separator"></div>
                                <form method="post" class="mat-menu__form" asp-page-handler="RunElementSensors" asp-route-elementId="@Model.Id" asp-route-returnUrl="@returnUrl">
                                    <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("play")<span>Run all</span></button>
                                </form>
                                <form method="post" class="mat-menu__form" asp-page-handler="PauseElement" asp-route-returnUrl="@returnUrl">
                                    <input type="hidden" name="elementId" value="@Model.Id" />
                                    <input type="hidden" name="paused" value="true" />
                                    <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("pause")<span>Pause all</span></button>
                                </form>
                                <form method="post" class="mat-menu__form" asp-page-handler="PauseElement" asp-route-returnUrl="@returnUrl">
                                    <input type="hidden" name="elementId" value="@Model.Id" />
                                    <input type="hidden" name="paused" value="false" />
                                    <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("play")<span>Resume all</span></button>
                                </form>
                            }
                            @if (hasChildActions)
                            {
                                <div class="mat-menu__sep" role="separator"></div>
                                @if (canAddFolder)
                                {
                                    <a class="mat-menu__item" role="menuitem" asp-page="/FolderCreate" asp-route-selectedId="@Model.Id" asp-route-returnUrl="@returnUrl">@MatUi.Icon("folder")<span>Create folder</span></a>
                                }
                                @if (canAddHost)
                                {
                                    <a class="mat-menu__item" role="menuitem" asp-page="/HostCreate" asp-route-selectedId="@Model.Id" asp-route-returnUrl="@returnUrl">@MatUi.Icon("monitor")<span>Create host</span></a>
                                }
                                @if (canAddSensor)
                                {
                                    <a class="mat-menu__item" role="menuitem" asp-page="/SensorCreate" asp-route-selectedId="@Model.Id" asp-route-returnUrl="@returnUrl">@MatUi.Icon("activity")<span>Create sensor</span></a>
                                }
                            }
                            @if (canDelete)
                            {
                                <div class="mat-menu__sep" role="separator"></div>
                                <form method="post" class="mat-menu__form" asp-page-handler="DeleteElement">
                                    <input type="hidden" name="ElementEditor.Id" value="@Model.Id" />
                                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                    <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem"
                                            data-confirm="Delete this element and all children?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete</span></button>
                                </form>
                            }
                        </div>
                    }
                    <button type="button" class="mat-btn mat-btn--primary mat-btn--sm" data-tree-move-target hidden aria-label="Move element here" title="Move element here">@MatUi.Icon("arrow-right")<span>Move here</span></button>
                </div>
            </div>
        </div>

        @if (branchChildren.Length > 0 || sensorChildren.Length > 0)
        {
            <div class="monitoring-tree-children">
                @if (sensorChildren.Length > 0)
                {
                    <div class="monitoring-sensor-strip monitoring-tree-sensor-level">
                        @for (var sensorIndex = 0; sensorIndex < sensorChildren.Length; sensorIndex++)
                        {
                            var sensor = sensorChildren[sensorIndex];

                            <article class="monitoring-sensor-chip"
                                     data-series-key="@sensor.SeriesKey"
                                     data-tree-node
                                     data-tree-node-id="@sensor.Id"
                                     data-tree-kind="sensor"
                                     data-tree-depth="@sensor.Depth"
                                     data-tree-path="@sensor.Path"
                                     data-state="@sensor.StateKey"
                                     data-acknowledged="@(sensor.IsAcknowledged ? "true" : "false")">
                                <a class="monitoring-sensor-chip-main" asp-page="/SensorDetails" asp-route-sensorId="@sensor.Id" title="@sensor.Path">
                                    <span class="monitoring-sensor-status">@MatUi.Icon(StatusIcon(sensor))<span class="mat-sr-only" data-role="state">@sensor.StateLabel</span></span>
                                    <span class="tree-name monitoring-sensor-name">@sensor.Name</span>
                                    <span class="monitoring-sensor-value">
                                        <span data-role="current-value">@(sensor.CurrentValue.HasValue ? sensor.CurrentValue.Value.ToString("0.###") : "-")</span>
                                        <span data-role="current-unit">@sensor.Unit</span>
                                    </span>
                                    <span class="monitoring-sensor-meta">
                                        <span>@(sensor.SensorTypeLabel ?? sensor.SensorTypeKey ?? "Sensor")</span>
                                        @if (!string.IsNullOrWhiteSpace(sensor.LastCheck))
                                        {
                                            <span>@sensor.LastCheck</span>
                                        }
                                        @if (sensor.Tags.Count > 0)
                                        {
                                            <span class="monitoring-sensor-tags" data-tag-overflow>
                                                @foreach (var tag in sensor.Tags)
                                                {
                                                    <span class="mat-tag" data-tag-chip>@tag</span>
                                                }
                                            </span>
                                        }
                                    </span>
                                    <svg class="sparkline monitoring-sensor-graph" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                                        <path data-role="area"></path>
                                        <path data-role="line"></path>
                                    </svg>
                                </a>
                                <div class="monitoring-sensor-overlay-actions">
                                    <a class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm" asp-page="/SensorDetails" asp-route-sensorId="@sensor.Id" aria-label="Open @sensor.Name" data-tip="Open sensor">@MatUi.Icon("eye")</a>
                                    @if (isAdmin)
                                    {
                                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm" data-menu-toggle="sensor-menu-@sensor.Id" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false" aria-label="Actions for @sensor.Name" data-tip="Actions">@MatUi.Icon("more-horizontal")</button>
                                    }
                                </div>
                                @if (isAdmin)
                                {
                                    <div class="mat-menu" id="sensor-menu-@sensor.Id" role="menu" aria-label="Actions for @sensor.Name" hidden>
                                        <form method="post" class="mat-menu__form" asp-page-handler="RunSensor" asp-route-sensorId="@sensor.Id" asp-route-returnUrl="@returnUrl">
                                            <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("play")<span>Run now</span></button>
                                        </form>
                                        <div class="mat-menu__sep" role="separator"></div>
                                        <a class="mat-menu__item" role="menuitem" asp-page="/SensorDetails" asp-route-sensorId="@sensor.Id">@MatUi.Icon("bar-chart")<span>Details</span></a>
                                        <a class="mat-menu__item" role="menuitem" asp-page="/ElementEditor" asp-route-selectedId="@sensor.Id">@MatUi.Icon("edit")<span>Edit</span></a>
                                        <button type="button" class="mat-menu__item" role="menuitem" data-tree-move-start>@MatUi.Icon("route")<span data-tree-move-start-text>Move</span></button>
                                        @if (sensorIndex > 0)
                                        {
                                            <form method="post" class="mat-menu__form" asp-page-handler="MoveElementBefore" asp-route-elementId="@sensor.Id" asp-route-siblingId="@sensorChildren[sensorIndex - 1].Id" asp-route-returnUrl="@returnUrl">
                                                <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("back")<span>Move left</span></button>
                                            </form>
                                        }
                                        @if (sensorIndex < sensorChildren.Length - 1)
                                        {
                                            <form method="post" class="mat-menu__form" asp-page-handler="MoveElementAfter" asp-route-elementId="@sensor.Id" asp-route-siblingId="@sensorChildren[sensorIndex + 1].Id" asp-route-returnUrl="@returnUrl">
                                                <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("arrow-right")<span>Move right</span></button>
                                            </form>
                                        }
                                        <form method="post" class="mat-menu__form" asp-page-handler="ToggleSensorPause" asp-route-sensorId="@sensor.Id" asp-route-returnUrl="@returnUrl">
                                            <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon(sensor.IsPaused ? "play" : "pause")<span>@(sensor.IsPaused ? "Resume" : "Pause")</span></button>
                                        </form>
                                        <div class="mat-menu__sep" role="separator"></div>
                                        <form method="post" class="mat-menu__form" asp-page-handler="DeleteElement">
                                            <input type="hidden" name="ElementEditor.Id" value="@sensor.Id" />
                                            <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem"
                                                    data-confirm="Delete this sensor?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete</span></button>
                                        </form>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }

                @for (var i = 0; i < branchChildren.Length; i++)
                {
                    var childViewData = new ViewDataDictionary(ViewData)
                    {
                        ["PrevSiblingId"] = i > 0 ? branchChildren[i - 1].Id : (Guid?)null,
                        ["NextSiblingId"] = i < branchChildren.Length - 1 ? branchChildren[i + 1].Id : (Guid?)null
                    };
                    <partial name="_MonitoringTreeNode" model="branchChildren[i]" view-data="childViewData" />
                }
            </div>
        }
    }
</article>

@model string
@*
    The schematic a widget shows in the palette. Drawn rather than described: "Gauge" and "Progress" are the
    same tile Kind with a different VisualType, and a word list makes them look identical - the whole reason
    the palette has separate entries for them is that they LOOK different. Everything is on one 48x27 (16:9)
    viewBox in currentColor, so a card can tint the whole preview by setting `color` and it follows the theme.

    The key comes from MapWidgetCatalog.PreviewKey, which derives it from what the widget actually renders -
    so a new catalog entry gets a sensible schematic without a second lookup table to keep in sync.
*@
<svg class="map-tool-preview" viewBox="0 0 48 27" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "group":
            <g class="mtp-fill">
                <rect x="6" y="5" width="16" height="7" rx="2" />
                <rect x="26" y="5" width="16" height="7" rx="2" />
                <rect x="6" y="15" width="16" height="7" rx="2" opacity="0.5" />
                <rect x="26" y="15" width="16" height="7" rx="2" opacity="0.5" />
            </g>
            break;

        case "value":
            <rect class="mtp-fill" x="9" y="7" width="30" height="10" rx="2" />
            <rect class="mtp-soft" x="9" y="20" width="16" height="3" rx="1.5" />
            break;

        case "gauge":
            <path class="mtp-track" d="M10 20a14 14 0 0 1 28 0" fill="none" stroke-width="4" stroke-linecap="round" />
            <path class="mtp-stroke" d="M10 20a14 14 0 0 1 9.2-13.2" fill="none" stroke-width="4" stroke-linecap="round" />
            <circle class="mtp-fill" cx="24" cy="20" r="2.4" />
            break;

        case "progress":
            <rect class="mtp-track" x="7" y="11" width="34" height="5" rx="2.5" />
            <rect class="mtp-fill" x="7" y="11" width="21" height="5" rx="2.5" />
            <rect class="mtp-soft" x="7" y="20" width="12" height="3" rx="1.5" />
            break;

        case "graph":
            <path class="mtp-stroke" d="M6 19 13 13 20 16 27 8 34 12 42 6" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path class="mtp-area" d="M6 19 13 13 20 16 27 8 34 12 42 6V23H6Z" />
            break;

        case "multigraph":
            @* Three lines, one of them clearly the one that moved - which is the whole reason this widget
               is separate from "graph", so the schematic has to show it. Plus a legend strip. *@
            <path class="mtp-stroke" d="M6 18 13 16 20 17 27 14 34 15 42 13" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />
            <path class="mtp-stroke" d="M6 20 13 19 20 20 27 18 34 19 42 18" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />
            <path class="mtp-stroke" d="M6 17 13 15 20 16 27 6 34 9 42 7" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <g class="mtp-fill">
                <rect x="6" y="24" width="3" height="3" rx="1.5" />
                <rect x="11" y="25" width="9" height="2" rx="1" opacity="0.55" />
                <rect x="24" y="24" width="3" height="3" rx="1.5" opacity="0.5" />
                <rect x="29" y="25" width="9" height="2" rx="1" opacity="0.35" />
            </g>
            break;

        case "list":
            <g class="mtp-fill">
                <rect x="6" y="5" width="18" height="3" rx="1.5" />
                <rect x="34" y="5" width="8" height="3" rx="1.5" opacity="0.55" />
                <rect x="6" y="12" width="22" height="3" rx="1.5" />
                <rect x="34" y="12" width="8" height="3" rx="1.5" opacity="0.55" />
                <rect x="6" y="19" width="14" height="3" rx="1.5" />
                <rect x="34" y="19" width="8" height="3" rx="1.5" opacity="0.55" />
            </g>
            break;

        case "alerts":
            <g class="mtp-fill">
                <circle cx="8" cy="6.5" r="2.2" />
                <rect x="14" y="5" width="28" height="3" rx="1.5" />
                <circle cx="8" cy="13.5" r="2.2" opacity="0.6" />
                <rect x="14" y="12" width="22" height="3" rx="1.5" opacity="0.6" />
                <circle cx="8" cy="20.5" r="2.2" opacity="0.35" />
                <rect x="14" y="19" width="25" height="3" rx="1.5" opacity="0.35" />
            </g>
            break;

        case "sla":
            <rect class="mtp-fill" x="7" y="6" width="22" height="9" rx="2" />
            <g class="mtp-soft">
                <rect x="7" y="19" width="34" height="3" rx="1.5" />
            </g>
            <rect class="mtp-stroke-fill" x="7" y="19" width="26" height="3" rx="1.5" />
            break;

        case "clock":
            <circle class="mtp-track" cx="24" cy="13.5" r="9.5" fill="none" stroke-width="2.5" />
            <path class="mtp-stroke" d="M24 8v5.5l4 2.5" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            break;

        case "heading":
            <rect class="mtp-fill" x="6" y="9" width="28" height="6" rx="2" />
            <rect class="mtp-soft" x="6" y="18" width="18" height="3" rx="1.5" />
            break;

        case "text":
            <g class="mtp-soft">
                <rect x="6" y="6" width="36" height="3" rx="1.5" />
                <rect x="6" y="12" width="30" height="3" rx="1.5" />
                <rect x="6" y="18" width="21" height="3" rx="1.5" />
            </g>
            break;

        case "image":
            <rect class="mtp-track" x="6" y="4" width="36" height="19" rx="3" fill="none" stroke-width="2" />
            <path class="mtp-fill" d="M10 20l7.5-8 5.5 5.5 4-4L38 20Z" />
            <circle class="mtp-fill" cx="33" cy="10" r="2.6" opacity="0.6" />
            break;

        case "pins":
            <rect class="mtp-track" x="6" y="4" width="36" height="19" rx="3" fill="none" stroke-width="2" />
            <g class="mtp-fill">
                <circle cx="15" cy="11" r="2.8" />
                <circle cx="27" cy="17" r="2.8" opacity="0.6" />
                <circle cx="35" cy="9" r="2.8" opacity="0.35" />
            </g>
            break;

        case "geo":
            <ellipse class="mtp-track" cx="24" cy="13.5" rx="18" ry="9.5" fill="none" stroke-width="2" />
            <path class="mtp-soft" d="M12 10c3-2 7-1 9 1s6 1 8-1 5 0 6 2-3 5-8 5-9-2-12-3-6-2-3-4Z" />
            <g class="mtp-fill">
                <circle cx="17" cy="11" r="2.4" />
                <circle cx="31" cy="16" r="2.4" opacity="0.55" />
            </g>
            break;

        default: // "state" - one thing, its status and a reading
            <circle class="mtp-fill" cx="11" cy="9" r="3.6" />
            <rect class="mtp-fill" x="19" y="7.5" width="23" height="3" rx="1.5" />
            <rect class="mtp-soft" x="6" y="17" width="30" height="4" rx="2" />
            break;
    }
</svg>

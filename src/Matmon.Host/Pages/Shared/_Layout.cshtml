<!DOCTYPE html>
@inject Matmon.Host.Services.MatmonRuntimeOptions RuntimeOptions
@inject Matmon.Host.Services.IDashboardSnapshotProvider DashboardSnapshotProvider
@inject Matmon.Host.Services.CloudUpdateState CloudUpdate
@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@{
    // Embedded mode: when reached through the Matmon.Cloud "embed" tunnel, render the page chromeless
    // (no own sidebar / mobile nav) so the cloud console can show a single menu around the iframe.
    var embedded = string.Equals(Context.Request.Headers["X-Matmon-Embed"].ToString(), "1", StringComparison.Ordinal);
    // White-label: a managing partner can set a product name that replaces "Matmon" in the brand + title.
    var partnerProductName = WorkspaceStore.GetServicePartnerProductName();
    var brandName = string.IsNullOrWhiteSpace(partnerProductName) ? "Matmon" : partnerProductName;
    var partnerName = WorkspaceStore.GetServicePartnerName();
    var partnerHasLogo = WorkspaceStore.GetServicePartnerHasLogo();
    var partnerIsOem = WorkspaceStore.GetServicePartnerLogoIsOem();
    var partnerSlogan = WorkspaceStore.GetServicePartnerSlogan();
    var partnerSidebarStyle = WorkspaceStore.GetServicePartnerSidebarStyle();
    var partnerHasSmallLogo = WorkspaceStore.GetServicePartnerHasSmallLogo();
}
<html lang="de" data-embedded="@(embedded ? "1" : "0")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @brandName</title>
    @if (partnerHasSmallLogo)
    {
        <link rel="icon" href="/api/branding/favicon" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    }
    <script>
        (() => {
            const storageKey = "matmon-theme";
            let mode = "system";
            try {
                const stored = localStorage.getItem(storageKey);
                if (stored === "light" || stored === "dark" || stored === "system") {
                    mode = stored;
                }
            } catch {
                mode = "system";
            }

            const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            const dark = mode === "dark" || (mode === "system" && prefersDark);
            document.documentElement.dataset.theme = dark ? "dark" : "light";
            document.documentElement.dataset.themeMode = mode;
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Matmon.Host.styles.css" asp-append-version="true" />
    @{
        // Reseller co-branding: re-theme the whole app to the managing partner's accent colour. Cheap accessor
        // (no logo clone) + render-time re-validation to #RRGGBB, so a garbage/malicious cached value can never
        // reach inline CSS. Overrides both themes with !important so it wins over the site.css :root/light rules.
        var partnerAccent = Matmon.Core.Domain.BrandingSafety.SafeHexColor(WorkspaceStore.GetServicePartnerBrandColor());
        var partnerAccent2 = Matmon.Core.Domain.BrandingSafety.SafeHexColor(WorkspaceStore.GetServicePartnerSecondaryColor());
    }
    @if (partnerAccent is not null)
    {
        <style>
            :root, html[data-theme="light"], html[data-theme="dark"] {
                --matmon-accent: @partnerAccent !important;
                --matmon-accent-2: @(partnerAccent2 ?? $"color-mix(in srgb, {partnerAccent} 58%, #ffffff)") !important;
            }
        </style>
    }
    @if (embedded)
    {
        <style>
            .app-shell { display: block !important; }
            .app-sidebar, .mobile-nav-bar, .sidebar-backdrop, .workspace-summary-strip, .breadcrumb-bar { display: none !important; }
            .app-main, .app-content { width: 100%; }
        </style>
    }
</head>
<body class="matmon-shell">
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        string NavClass(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;

        // Section-aware sidebar highlight (mirrors the cloud shell): a nav item stays active on ALL of its
        // section's sub-pages (editors, tabs), matched by URL-path prefix rather than exact page name.
        var currentPath = Context.Request.Path.Value ?? string.Empty;
        bool PathStarts(string prefix) => currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
        // /monitoring is a shared prefix (Sensors + the Templates editor + the Probe-usage page live under it),
        // so Templates/Probes are resolved first and excluded from Sensors (most-specific-prefix wins). Root "/"
        // must be exact - it is a prefix of every path.
        var dashboardActive = string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase);
        var probesActive = PathStarts("/probes") || PathStarts("/system/probes") || PathStarts("/monitoring/probe");
        var templatesActive = PathStarts("/templates") || PathStarts("/monitoring/template");
        var mapsActive = PathStarts("/maps");
        var notificationsActive = PathStarts("/notifications");
        var eventsActive = PathStarts("/events");
        var discoveryActive = PathStarts("/discovery");
        var systemActive = PathStarts("/config") || PathStarts("/system/users") || PathStarts("/backup");
        var logsActive = PathStarts("/logs");
        var sensorsActive = PathStarts("/monitoring") && !templatesActive && !probesActive;
        string Active(bool on) => on ? "is-active" : string.Empty;
        var isSecondaryMode = RuntimeOptions.Mode == Matmon.Core.AppMode.Secondary;
        var isAdmin = User.IsInRole(MatmonUserRole.Admin.ToString());
        var suppressWorkspaceSummary = string.Equals(ViewData["WorkspaceSummarySuppress"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        Matmon.Host.Services.WorkspaceSummary? workspaceSummary = null;

        if (User.Identity?.IsAuthenticated == true && !isSecondaryMode)
        {
            try
            {
                workspaceSummary = DashboardSnapshotProvider.GetWorkspaceSummary();
            }
            catch
            {
                workspaceSummary = null;
            }
        }

        ViewData["WorkspaceSummary"] = workspaceSummary;

        // Server-render the sidebar alert badge from the cheap summary so it shows real
        // numbers on first paint (the client refresh then keeps it live). Mirrors the
        // tone/state/hint logic in site.js so the JS update is visually a no-op.
        // All alert-based so the badge agrees with the Alerts page. Big number = open
        // (unacknowledged) alerts; Err/Warn tiles = active alerts by severity (these persist
        // after the sensor recovers, Alerta-style - counting sensor states diverged from the page).
        var openAlerts = workspaceSummary?.OpenAlertCount ?? 0;
        var ackAlerts = workspaceSummary?.AcknowledgedAlertCount ?? 0;
        var errorAlerts = workspaceSummary?.ErrorAlertCount ?? 0;
        var warningAlerts = workspaceSummary?.WarningAlertCount ?? 0;
        var pausedSensors = workspaceSummary?.PausedSensorCount ?? 0;
        var hasErrors = errorAlerts > 0;
        var hasWarnings = warningAlerts > 0 || ackAlerts > 0 || pausedSensors > 0;
        var alertTone = hasErrors ? "error" : (hasWarnings ? "warning" : "ok");
        var alertState = errorAlerts > 0 ? "Error" : (warningAlerts > 0 ? "Warning" : (ackAlerts > 0 ? "Ack" : (pausedSensors > 0 ? "Paused" : "OK")));
        var hintParts = new List<string>();
        if (errorAlerts > 0) { hintParts.Add($"{errorAlerts} error"); }
        if (warningAlerts > 0) { hintParts.Add($"{warningAlerts} warning"); }
        if (ackAlerts > 0) { hintParts.Add($"{ackAlerts} ack"); }
        if (pausedSensors > 0) { hintParts.Add($"{pausedSensors} paused"); }
        var alertHint = hintParts.Count > 0 ? string.Join(" / ", hintParts) : "All clear";
    }
    @if (embedded)
    {
        // For the Matmon.Cloud console: publish this instance's own effective nav (role- and mode-aware) so the
        // cloud sidebar mirrors exactly what the instance shows - not a hardcoded guess. cloud.js reads this from
        // the (same-origin) iframe on load and rebuilds the console menu; older instances that don't emit it fall
        // back to the cloud's static menu.
        var embedNav = new List<object>();
        if (isSecondaryMode)
        {
            embedNav.Add(new { label = "Probe", path = "" });
        }
        else
        {
            embedNav.Add(new { label = "Dashboard", path = "" });
            embedNav.Add(new { label = "Alerts", path = "Alerts" });
            embedNav.Add(new { label = "Sensors", path = "Monitoring" });
            embedNav.Add(new { label = "Probes", path = "Probes" });
            embedNav.Add(new { label = "Discovery", path = "Discovery" });
            embedNav.Add(new { label = "Maps", path = "Maps" });
            embedNav.Add(new { label = "Templates", path = "Templates" });
            embedNav.Add(new { label = "Notifications", path = "Notifications" });
            embedNav.Add(new { label = "Events", path = "Events" });
            if (isAdmin) { embedNav.Add(new { label = "System", path = "Config" }); }
        }
        <script type="application/json" id="matmon-embed-nav">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(embedNav))</script>
    }
    <div class="app-shell">
        <div class="mobile-nav-bar">
            <button type="button"
                    class="mobile-nav-toggle"
                    data-sidebar-toggle
                    aria-controls="app-sidebar"
                    aria-expanded="false"
                    aria-label="Open navigation menu">
                @MatmonIcons.Render("menu")
            </button>
            @* The mobile slot is a fixed 1.35rem square: only ever put a square asset in it (the partner favicon
               or the Matmon glyph) - the wide main logo would be stretched/distorted, and an OEM wide-lockup here
               would also duplicate the product name printed below. So the name text stays with a square icon. *@
            <img class="mobile-nav-logo" src="@(partnerHasSmallLogo ? "/api/branding/favicon" : "/favicon.svg")" alt="" aria-hidden="true" />
            <div class="mobile-nav-copy">
                <span class="mobile-nav-brand">@(partnerProductName ?? "MATMON")</span>
                <strong>@(ViewData["Title"]?.ToString() ?? brandName)</strong>
            </div>
        </div>

        <aside class="topbar app-sidebar" id="app-sidebar">
            <div class="container-fluid px-2 py-2 sidebar-inner">
                <div class="sidebar-brand-block">
                    @if (partnerProductName is not null)
                    {
                        var isRow = partnerSidebarStyle == 1;
                        <a class="brand" asp-area="" asp-page="/Index" style="@(isRow ? "flex-direction:row;align-items:center;gap:10px;" : "flex-direction:column;align-items:flex-start;gap:6px;")text-transform:none;letter-spacing:normal;font-size:1rem;">
                            @if (partnerHasLogo)
                            {
                                <img src="/api/branding/logo" alt="@partnerProductName" style="@(isRow ? "max-height:40px;width:auto;" : "max-height:44px;max-width:100%;width:auto;")height:auto;object-fit:contain;" />
                            }
                            @if (!(partnerHasLogo && partnerIsOem))
                            {
                                <span style="display:flex;flex-direction:column;gap:2px;line-height:1.15;">
                                    <span>@partnerProductName</span>
                                    @if (!string.IsNullOrWhiteSpace(partnerSlogan))
                                    {
                                        <span style="font-size:.7rem;font-weight:400;opacity:.7;">@partnerSlogan</span>
                                    }
                                </span>
                            }
                        </a>
                    }
                    else
                    {
                        <a class="brand" asp-area="" asp-page="/Index">
                            @MatmonIcons.Render("monitoring")
                            <span>MATMON</span>
                        </a>
                    }
                    <div class="brand-note">@(partnerProductName is not null && !string.IsNullOrWhiteSpace(partnerName) ? $"Managed by {partnerName}" : (isSecondaryMode ? "Secondary probe node" : "Lightweight monitoring"))</div>
                </div>

                @if (User.Identity?.IsAuthenticated == true && !isSecondaryMode)
                {
                    <div class="sidebar-alert-status @NavClass("/Alerts")" data-nav-alert-status data-tone="@alertTone">
                        <a class="sidebar-alert-status-main" asp-area="" asp-page="/Alerts" asp-route-alertFilter="open">
                            <span class="sidebar-alert-status-label">Alerts</span>
                            <span class="sidebar-alert-status-value">
                                <span class="sidebar-alert-status-count" data-nav-alert-count>@openAlerts</span>
                                <span class="sidebar-alert-status-state" data-nav-alert-state>@alertState</span>
                            </span>
                            <span class="sidebar-alert-status-hint" data-nav-alert-hint>@alertHint</span>
                        </a>
                        <span class="sidebar-alert-status-meta" aria-label="Alert summary">
                            <a asp-area="" asp-page="/Alerts" asp-route-alertFilter="error" data-tone="error"><strong data-nav-error-count>@errorAlerts</strong><small>Err</small></a>
                            <a asp-area="" asp-page="/Alerts" asp-route-alertFilter="warning" data-tone="warning"><strong data-nav-warning-count>@warningAlerts</strong><small>Warn</small></a>
                            <a asp-area="" asp-page="/Alerts" asp-route-alertFilter="ack" data-tone="ack"><strong data-nav-ack-count>@ackAlerts</strong><small>Ack</small></a>
                            <a asp-area="" asp-page="/Monitoring" asp-route-MonitoringKind="sensor" asp-route-MonitoringState="paused" data-tone="paused"><strong data-nav-paused-inline-count>@pausedSensors</strong><small>Pause</small></a>
                        </span>
                    </div>
                }

                <nav class="topnav sidebar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (isSecondaryMode)
                        {
                            <a asp-area="" asp-page="/Index" class="topnav-link @NavClass("/Index")">Probe</a>
                        }
                        else
                        {
                            <a asp-area="" asp-page="/Index" class="topnav-link @Active(dashboardActive)">Dashboard</a>
                            <a asp-area="" asp-page="/Monitoring" class="topnav-link @Active(sensorsActive)">Sensors</a>
                            <a asp-area="" asp-page="/Probes" class="topnav-link @Active(probesActive)">Probes</a>
                            <a asp-area="" asp-page="/Discovery" class="topnav-link @Active(discoveryActive)">Discovery</a>
                            <a asp-area="" asp-page="/Maps" class="topnav-link @Active(mapsActive)">Maps</a>
                            <a asp-area="" asp-page="/Templates" class="topnav-link @Active(templatesActive)">Templates</a>
                            <a asp-area="" asp-page="/Notifications" class="topnav-link @Active(notificationsActive)">Notifications</a>
                            <a asp-area="" asp-page="/Events" class="topnav-link @Active(eventsActive)">Events</a>
                            @if (isAdmin)
                            {
                                <a asp-area="" asp-page="/Config" class="topnav-link @Active(systemActive)">System</a>
                                <a asp-area="" asp-page="/Logs" class="topnav-link @Active(logsActive)">Logs</a>
                            }
                        }
                    }
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-footer-tools">
                        <button type="button" class="sidebar-icon-button topnav-theme-toggle" data-theme-toggle title="Theme">
                            <span class="theme-toggle-icon" data-theme-icon="light">@MatmonIcons.Render("sun")</span>
                            <span class="theme-toggle-icon" data-theme-icon="dark">@MatmonIcons.Render("moon")</span>
                            <span class="theme-toggle-icon" data-theme-icon="system">@MatmonIcons.Render("theme-system")</span>
                            <span class="workspace-sr-only" data-theme-label>System</span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var accountName = User.Identity?.Name ?? "Account";
                            var accountRole = User.Claims.FirstOrDefault(claim => claim.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Viewer";
                            var accountInitial = string.IsNullOrWhiteSpace(accountName)
                                ? "A"
                                : accountName.Trim().Substring(0, 1).ToUpperInvariant();

                            <details class="account-menu">
                                <summary class="account-menu-trigger">
                                    <span class="account-avatar">@accountInitial</span>
                                    <span class="account-trigger-copy">
                                        <span class="account-trigger-label">Account</span>
                                        <span class="account-trigger-name">@accountName</span>
                                    </span>
                                    <span class="account-trigger-chevron">@MatmonIcons.Render("arrow-right")</span>
                                </summary>
                                <div class="account-menu-panel">
                                    <div class="account-menu-meta">
                                        <span>Signed in</span>
                                        <strong>@accountName</strong>
                                        <small>@accountRole</small>
                                    </div>
                                    <a asp-area="" asp-page="/Account" class="account-menu-action">
                                        <span>Account</span>
                                    </a>
                                    <form asp-page="/Logout" method="post" class="account-menu-form">
                                        <button type="submit" class="account-menu-action">
                                            <span>Log out</span>
                                        </button>
                                    </form>
                                </div>
                            </details>
                        }
                        else
                        {
                            <a asp-area="" asp-page="/Login" class="account-login-button @NavClass("/Login")">
                                @MatmonIcons.Render("lock")
                                <span>Login</span>
                            </a>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(partnerName) && partnerProductName is null)
                    {
                        <div class="sidebar-version" style="opacity:.85;font-size:.72rem;">Managed by @partnerName</div>
                    }

                    <a class="sidebar-version" asp-area="" asp-page="/About" title="@(CloudUpdate.UpdateAvailable ? $"A newer build is available{(CloudUpdate.LatestVersion is { } lv ? $": {lv}" : "")} - see About" : $"About {brandName}")">
                        <span class="sidebar-version-brand">@brandName</span>
                        <span class="sidebar-version-tag">@Matmon.Host.Services.MatmonVersion.Current</span>
                        @if (CloudUpdate.UpdateAvailable)
                        {
                            <span class="sidebar-version-tag" style="background:rgba(95,141,255,.18);color:var(--matmon-accent,#5f8dff);font-weight:700;">Update</span>
                        }
                    </a>
                    @if (partnerProductName is not null)
                    {
                        <div class="sidebar-version" style="opacity:.55;font-size:.66rem;">powered by Matmon</div>
                    }
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop" data-sidebar-backdrop hidden></div>

        <div class="app-main">

            <main class="container-fluid px-2 app-content">
                @{
                    var breadcrumbTrail = ViewData["Breadcrumbs"] as IEnumerable<BreadcrumbItem>;
                    var breadcrumbs = BreadcrumbBuilder.Build(
                        Context.Request.Path.Value ?? string.Empty,
                        ViewData["Title"]?.ToString(),
                        breadcrumbTrail);
                }

                @if (breadcrumbs.Count > 0)
                {
                    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
                        <ol class="breadcrumb-list">
                            @for (var index = 0; index < breadcrumbs.Count; index++)
                            {
                                var crumb = breadcrumbs[index];
                                var isLast = index == breadcrumbs.Count - 1;

                                <li class="breadcrumb-item">
                                    @if (!isLast && !string.IsNullOrWhiteSpace(crumb.Page))
                                    {
                                        <a class="breadcrumb-link" asp-page="@crumb.Page">@crumb.Label</a>
                                    }
                                    else
                                    {
                                        <span class="breadcrumb-current" aria-current="page">@crumb.Label</span>
                                    }
                                </li>

                                @if (!isLast)
                                {
                                    <li class="breadcrumb-separator" aria-hidden="true">
                                        @MatmonIcons.Render("arrow-right")
                                    </li>
                                }
                            }
                        </ol>
                    </nav>
                }

                @if (workspaceSummary is not null && !suppressWorkspaceSummary)
                {
                    <section class="workspace-summary-strip" aria-label="Workspace summary">
                                <div class="workspace-summary-card">
                            <div class="workspace-summary-main">
                                <span class="workspace-summary-kicker">Primary</span>
                                <strong>@workspaceSummary.WorkspaceName</strong>
                            </div>
                            <div class="workspace-summary-metrics">
                                <a class="workspace-summary-chip" asp-page="/Probes" aria-label="Configured probes">
                                    @MatmonIcons.Render("probe")
                                    <strong>@workspaceSummary.ConfiguredProbeCount</strong>
                                    <span>Probes</span>
                                </a>
                                <a class="workspace-summary-chip" asp-page="/Monitoring" asp-route-monitoringKind="sensor" aria-label="Total sensors">
                                    @MatmonIcons.Render("sensor")
                                    <strong>@workspaceSummary.SensorCount</strong>
                                    <span>Sensors</span>
                                </a>
                            </div>
                        </div>
                    </section>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

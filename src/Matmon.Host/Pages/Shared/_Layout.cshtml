@inject Matmon.Host.Ui.InstanceShellBuilder ShellBuilder
@inject Matmon.Host.Ui.MatUiToolkit Toolkit
@{
    // The MatUi shell (SHELL-01..19): the menu on the left with the brand above it, the user and the theme button at its
    // foot and the version below them, the breadcrumb in the header bar, then the page. InstanceShellBuilder decides WHAT
    // is drawn (brand / white label, menu, counts, user); this file only draws it.
    // A page sets: ViewData["Title"], optionally ["PageSub"] (the line under the title), ["Width"] = "narrow" | "wide",
    // ["OwnHead"] = true when it draws its own <div class="mat-page__head">, ["Breadcrumbs"] for a custom trail.
    // Inside the Matmon.Cloud console (X-Matmon-Embed: 1) the page renders chromeless: the cloud draws one menu around it.
    var shell = ShellBuilder.Build(Context, ViewData);
    var title = ViewData["Title"]?.ToString() ?? shell.BrandName;
    var sub = ViewData["PageSub"] as string;
    var ownHead = ViewData["OwnHead"] is true;
    var width = ViewData["Width"] as string;
    var pageClass = "mat-page" + (width == "narrow" ? " mat-page--narrow" : width == "wide" ? " mat-page--wide" : string.Empty);
    var crumbs = BreadcrumbBuilder.Build(Context.Request.Path.Value ?? string.Empty, ViewData["Title"]?.ToString(), ViewData["Breadcrumbs"] as IEnumerable<BreadcrumbItem>);
    var brandClass = shell.PartnerLogoOnly ? "mat-nav__brand-link--logo-only" : shell.BrandStacked ? "mm-brand--stacked" : null;

    // A crumb names a page ("/Config") and may carry a query or a tab ("/Config?tab=users", "/notifications#senders"):
    // asp-page cannot resolve those, so the page part goes through Url.Page (a plain path if it is no page name) and the
    // rest is appended. Such crumbs used to come out without a link.
    string CrumbHref(string page)
    {
        var cut = page.IndexOfAny(['?', '#']);
        var name = cut < 0 ? page : page[..cut];
        return (Url.Page(name) ?? name) + (cut < 0 ? string.Empty : page[cut..]);
    }
}
<!DOCTYPE html>
<html lang="en" data-app="matmon" data-embedded="@(shell.Embedded ? "1" : "0")" data-custom-accent="@shell.PartnerAccent">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="@(shell.PartnerAccent ?? "#295cff")" />
    <title>@title · @shell.BrandName</title>
    @if (shell.PartnerFavicon)
    {
        <link rel="icon" href="/api/branding/favicon" />
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    }
    <script src="~/js/matmon.boot.js" asp-append-version="true"></script>
    <script src="/matui/matui.boot.js?v=@Toolkit.Hash"></script>
    <link rel="stylesheet" href="/matui/matui.css?v=@Toolkit.Hash" />
    <partial name="_AppStyles" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="mat-skip" href="#main">Skip to the content</a>
    @Html.Raw(Toolkit.Sprite)
    @if (shell.Embedded)
    {
        @* For the Matmon.Cloud console: this instance's own menu (role- and mode-aware), which the cloud reads from the
           same-origin frame and mirrors - a data block, not a script. *@
        <script type="application/json" id="matmon-embed-nav">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(shell.EmbedNav))</script>
    }

    <div class="mat-app@(shell.Embedded ? " mm-embedded" : string.Empty)">
        @if (!shell.Embedded)
        {
            <aside class="mat-nav" id="mat-nav">
                <div class="mat-nav__brand">
                    <a asp-page="/Index" aria-label="@shell.BrandName, start page" class="@brandClass">
                        @if (shell.PartnerLogo)
                        {
                            <img class="mat-brandmark" src="/api/branding/logo" alt="@shell.BrandName" />
                        }
                        else
                        {
                            <img class="mat-brandmark" src="~/brand/matmon-mark-flat.svg" alt="" width="38" height="38" />
                        }
                        <span>
                            <span class="mat-nav__name">@shell.BrandName</span>
                            <span class="mat-nav__tagline">@shell.Tagline</span>
                        </span>
                    </a>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="Close the menu">@MatUi.Icon("x")</button>
                </div>

                @if (shell.Info is not null)
                {
                    <partial name="_NavInfo" model="shell.Info" />
                }

                @if (shell.Authed)
                {
                    <nav class="mat-nav__scroll" aria-label="Main">
                        <ul class="mat-nav__list">
                            @foreach (var group in shell.Menu)
                            {
                                if (group.Title is not null)
                                {
                                    <li class="mat-nav__group" role="presentation">@group.Title</li>
                                }
                                foreach (var item in group.Items)
                                {
                                    <li>
                                        <a class="mat-nav__item@(item.Active ? " is-active" : string.Empty)" asp-page="@item.Page" aria-current="@(item.Active ? "page" : null)">
                                            @MatUi.Icon(item.Icon)<span>@item.Title</span>
                                            @if (item.BadgeKey is not null)
                                            {
                                                var tone = item.BadgeTone is null ? " mat-nav__badge--plain" : $" mat-nav__badge--{item.BadgeTone}";
                                                <span class="mat-nav__badge@(tone)" data-nav-badge="@item.BadgeKey" hidden="@(item.BadgeCount == 0)">@item.BadgeCount<span class="mat-sr-only"> @(item.BadgeKey == "paused" ? "paused" : "open")</span></span>
                                            }
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </nav>
                }

                <div class="mat-nav__foot">
                    <div class="mat-nav__account">
                        @if (shell.Authed)
                        {
                            <button type="button" class="mat-user" data-menu-toggle="user-menu" aria-haspopup="menu" aria-expanded="false">
                                <span class="mat-avatar" aria-hidden="true">@MatUi.Initials(shell.UserName)</span>
                                <span class="mat-user__text">
                                    <span class="mat-user__name">@shell.UserName</span>
                                    <span class="mat-user__role">@shell.UserRole</span>
                                </span>
                                @MatUi.Icon("chevron-up", "mat-user__chev")
                            </button>
                        }
                        else
                        {
                            <a class="mat-btn mat-btn--secondary" asp-page="/Login">@MatUi.Icon("login")<span>Sign in</span></a>
                        }
                        <button type="button" class="mat-theme" data-theme-toggle data-theme-state="system" aria-label="Theme: System. Click for Light." title="Theme: System. Click for Light.">
                            <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                            <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                            <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                        </button>
                    </div>
                    <div class="mat-nav__version">
                        <a asp-page="/About" title="@(shell.UpdateAvailable ? $"A newer build is available{(shell.LatestVersion is { } lv ? $": {lv}" : "")} - see About" : $"About {shell.BrandName}")">@shell.BrandName @shell.Version</a>
                        @if (shell.UpdateAvailable)
                        {
                            <a class="mat-pill mat-pill--accent" asp-page="/About">Update</a>
                        }
                        @if (shell.ManagedBy is not null)
                        {
                            <span class="mat-text-muted">Managed by @shell.ManagedBy</span>
                        }
                        @if (shell.PoweredBy)
                        {
                            <span class="mat-text-muted">powered by Matmon</span>
                        }
                    </div>
                </div>
            </aside>
        }

        <div class="mat-main">
            @if (!shell.Embedded)
            {
                <header class="mat-topbar">
                    <button type="button" class="mat-burger" data-nav-toggle aria-label="Open the menu" aria-controls="mat-nav" aria-expanded="false">@MatUi.Icon("menu")</button>
                    <nav class="mat-crumbs" aria-label="Breadcrumb">
                        <ol>
                            @if (crumbs.Count == 0)
                            {
                                <li aria-current="page">@(ViewData["Title"]?.ToString() ?? shell.BrandName)</li>
                            }
                            else
                            {
                                @for (var i = 0; i < crumbs.Count; i++)
                                {
                                    var crumb = crumbs[i];
                                    if (i == crumbs.Count - 1 || string.IsNullOrWhiteSpace(crumb.Page))
                                    {
                                        <li aria-current="@(i == crumbs.Count - 1 ? "page" : null)">@crumb.Label</li>
                                    }
                                    else
                                    {
                                        <li><a href="@CrumbHref(crumb.Page)">@crumb.Label</a></li>
                                    }
                                }
                            }
                        </ol>
                    </nav>
                    @await RenderSectionAsync("TopbarActions", required: false)
                </header>
            }
            else if (IsSectionDefined("TopbarActions"))
            {
                // Embedded in the cloud console there is no header bar; a page that defines its actions must not throw
                // "section defined but not rendered".
                IgnoreSection("TopbarActions");
            }

            <main class="@pageClass" id="main">
                @if (!ownHead)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(sub))
                            {
                                <p class="mat-page__sub">@sub</p>
                            }
                        </div>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @if (shell.Authed && !shell.Embedded)
    {
        <div class="mat-menu" id="user-menu" role="menu" aria-label="@shell.UserName" hidden>
            <div class="mat-menu__head">
                <span class="mat-avatar" aria-hidden="true">@MatUi.Initials(shell.UserName)</span>
                <div><strong>@shell.UserName</strong><small>@shell.UserRole</small></div>
            </div>
            <a class="mat-menu__item" role="menuitem" asp-page="/Account">@MatUi.Icon("user")<span>Account</span></a>
            <a class="mat-menu__item" role="menuitem" asp-page="/About">@MatUi.Icon("info")<span>About @shell.BrandName</span></a>
            <div class="mat-menu__sep" role="separator"></div>
            <form method="post" asp-page="/Logout">
                <button type="submit" class="mat-menu__item" role="menuitem">@MatUi.Icon("logout")<span>Sign out</span></button>
            </form>
        </div>
    }

    <script src="/matui/matui.js?v=@Toolkit.Hash"></script>
    <partial name="_AppScripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
@inject Matmon.Host.Services.MatmonRuntimeOptions RuntimeOptions
@inject Matmon.Host.Services.IDashboardSnapshotProvider DashboardSnapshotProvider
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Matmon</title>
    <script>
        (() => {
            const storageKey = "matmon-theme";
            let theme = "dark";
            try {
                const stored = localStorage.getItem(storageKey);
                if (stored === "light" || stored === "dark") {
                    theme = stored;
                }
            } catch {
                theme = "dark";
            }

            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Matmon.Host.styles.css" asp-append-version="true" />
</head>
<body class="matmon-shell">
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        string NavClass(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
        var isSecondaryMode = RuntimeOptions.Mode == Matmon.Core.AppMode.Secondary;
        var isAdmin = User.IsInRole(MatmonUserRole.Admin.ToString());
        var suppressWorkspaceSummary = string.Equals(ViewData["WorkspaceSummarySuppress"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        Matmon.Host.Services.WorkspaceSummary? workspaceSummary = null;

        if (User.Identity?.IsAuthenticated == true && !isSecondaryMode)
        {
            try
            {
                workspaceSummary = DashboardSnapshotProvider.GetWorkspaceSummary();
            }
            catch
            {
                workspaceSummary = null;
            }
        }

        ViewData["WorkspaceSummary"] = workspaceSummary;

        // Server-render the sidebar alert badge from the cheap summary so it shows real
        // numbers on first paint (the client refresh then keeps it live). Mirrors the
        // tone/state/hint logic in site.js so the JS update is visually a no-op.
        var openAlerts = workspaceSummary?.OpenAlertCount ?? 0;
        var ackAlerts = workspaceSummary?.AcknowledgedAlertCount ?? 0;
        var errorSensors = workspaceSummary?.ErrorSensorCount ?? 0;
        var warningSensors = workspaceSummary?.WarningSensorCount ?? 0;
        var pausedSensors = workspaceSummary?.PausedSensorCount ?? 0;
        var hasErrors = openAlerts > 0 || errorSensors > 0;
        var hasWarnings = warningSensors > 0 || ackAlerts > 0 || pausedSensors > 0;
        var alertTone = hasErrors ? "error" : (hasWarnings ? "warning" : "ok");
        var alertState = hasErrors ? "Error" : (warningSensors > 0 ? "Warning" : (ackAlerts > 0 ? "Ack" : (pausedSensors > 0 ? "Paused" : "OK")));
        var hintParts = new List<string>();
        if (openAlerts > 0) { hintParts.Add($"{openAlerts} open"); }
        if (errorSensors > 0) { hintParts.Add($"{errorSensors} error"); }
        if (warningSensors > 0) { hintParts.Add($"{warningSensors} warning"); }
        if (ackAlerts > 0) { hintParts.Add($"{ackAlerts} ack"); }
        if (pausedSensors > 0) { hintParts.Add($"{pausedSensors} paused"); }
        var alertHint = hintParts.Count > 0 ? string.Join(" / ", hintParts) : "All clear";
    }
    <div class="app-shell">
        <div class="mobile-nav-bar">
            <button type="button"
                    class="mobile-nav-toggle"
                    data-sidebar-toggle
                    aria-controls="app-sidebar"
                    aria-expanded="false"
                    aria-label="Open navigation menu">
                @MatmonIcons.Render("menu")
            </button>
            <div class="mobile-nav-copy">
                <span class="mobile-nav-brand">MATMON</span>
                <strong>@(ViewData["Title"]?.ToString() ?? "Matmon")</strong>
            </div>
        </div>

        <aside class="topbar app-sidebar" id="app-sidebar">
            <div class="container-fluid px-2 py-2 sidebar-inner">
                <div class="sidebar-brand-block">
                    <a class="brand" asp-area="" asp-page="/Index">
                        @MatmonIcons.Render("monitoring")
                        <span>MATMON</span>
                    </a>
                    <div class="brand-note">@(isSecondaryMode ? "Secondary probe node" : "Lightweight monitoring")</div>
                </div>

                @if (User.Identity?.IsAuthenticated == true && !isSecondaryMode)
                {
                    <div class="sidebar-alert-status @NavClass("/Alerts")" data-nav-alert-status data-tone="@alertTone">
                        <a class="sidebar-alert-status-main" asp-area="" asp-page="/Alerts" asp-route-alertFilter="open">
                            <span class="sidebar-alert-status-label">Alerts</span>
                            <span class="sidebar-alert-status-value">
                                <span class="sidebar-alert-status-count" data-nav-alert-count>@openAlerts</span>
                                <span class="sidebar-alert-status-state" data-nav-alert-state>@alertState</span>
                            </span>
                            <span class="sidebar-alert-status-hint" data-nav-alert-hint>@alertHint</span>
                        </a>
                        <span class="sidebar-alert-status-meta" aria-label="Alert summary">
                            <a asp-area="" asp-page="/Monitoring" asp-route-MonitoringKind="sensor" asp-route-MonitoringState="error" data-tone="error"><strong data-nav-error-count>@errorSensors</strong><small>Err</small></a>
                            <a asp-area="" asp-page="/Monitoring" asp-route-MonitoringKind="sensor" asp-route-MonitoringState="warning" data-tone="warning"><strong data-nav-warning-count>@warningSensors</strong><small>Warn</small></a>
                            <a asp-area="" asp-page="/Alerts" asp-route-alertFilter="ack" data-tone="ack"><strong data-nav-ack-count>@ackAlerts</strong><small>Ack</small></a>
                            <a asp-area="" asp-page="/Monitoring" asp-route-MonitoringKind="sensor" asp-route-MonitoringState="paused" data-tone="paused"><strong data-nav-paused-inline-count>@pausedSensors</strong><small>Pause</small></a>
                        </span>
                    </div>
                }

                <nav class="topnav sidebar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (isSecondaryMode)
                        {
                            <a asp-area="" asp-page="/Index" class="topnav-link @NavClass("/Index")">Probe</a>
                        }
                        else
                        {
                            <a asp-area="" asp-page="/Index" class="topnav-link @NavClass("/Index")">Monitoring</a>
                            <a asp-area="" asp-page="/Monitoring" class="topnav-link @NavClass("/Monitoring")">Sensors</a>
                            <a asp-area="" asp-page="/Probes" class="topnav-link @NavClass("/Probes")">Probes</a>
                            <a asp-area="" asp-page="/Discovery" class="topnav-link @NavClass("/Discovery")">Discovery</a>
                            <a asp-area="" asp-page="/Maps" class="topnav-link @NavClass("/Maps")">Maps</a>
                            <a asp-area="" asp-page="/Templates" class="topnav-link @NavClass("/Templates")">Templates</a>
                            <a asp-area="" asp-page="/Notifications" class="topnav-link @NavClass("/Notifications")">Notifications</a>
                            <a asp-area="" asp-page="/Events" class="topnav-link @NavClass("/Events")">Events</a>
                            @if (isAdmin)
                            {
                                <a asp-area="" asp-page="/Config" class="topnav-link @NavClass("/Config")">System</a>
                            }
                        }
                    }
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-footer-tools">
                        <button type="button" class="sidebar-icon-button topnav-theme-toggle" data-theme-toggle title="Toggle theme">
                            <span class="theme-toggle-icon theme-toggle-icon-light-target">@MatmonIcons.Render("sun")</span>
                            <span class="theme-toggle-icon theme-toggle-icon-dark-target">@MatmonIcons.Render("moon")</span>
                            <span class="workspace-sr-only" data-theme-label>Bright</span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var accountName = User.Identity?.Name ?? "Account";
                            var accountRole = User.Claims.FirstOrDefault(claim => claim.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Viewer";
                            var accountInitial = string.IsNullOrWhiteSpace(accountName)
                                ? "A"
                                : accountName.Trim().Substring(0, 1).ToUpperInvariant();

                            <details class="account-menu">
                                <summary class="account-menu-trigger">
                                    <span class="account-avatar">@accountInitial</span>
                                    <span class="account-trigger-copy">
                                        <span class="account-trigger-label">Account</span>
                                        <span class="account-trigger-name">@accountName</span>
                                    </span>
                                    <span class="account-trigger-chevron">@MatmonIcons.Render("arrow-right")</span>
                                </summary>
                                <div class="account-menu-panel">
                                    <div class="account-menu-meta">
                                        <span>Signed in</span>
                                        <strong>@accountName</strong>
                                        <small>@accountRole</small>
                                    </div>
                                    <form asp-page="/Logout" method="post" class="account-menu-form">
                                        <button type="submit" class="account-menu-action">
                                            @MatmonIcons.Render("arrow-left")
                                            <span>Logout</span>
                                        </button>
                                    </form>
                                </div>
                            </details>
                        }
                        else
                        {
                            <a asp-area="" asp-page="/Login" class="account-login-button @NavClass("/Login")">
                                @MatmonIcons.Render("lock")
                                <span>Login</span>
                            </a>
                        }
                    </div>

                    <a class="sidebar-version" asp-area="" asp-page="/About" title="About Matmon">
                        <span class="sidebar-version-brand">Matmon</span>
                        <span class="sidebar-version-tag">@Matmon.Host.Services.MatmonVersion.Current</span>
                    </a>
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop" data-sidebar-backdrop hidden></div>

        <div class="app-main">

            <main class="container-fluid px-2 app-content">
                @{
                    var breadcrumbTrail = ViewData["Breadcrumbs"] as IEnumerable<BreadcrumbItem>;
                    var breadcrumbs = BreadcrumbBuilder.Build(
                        Context.Request.Path.Value ?? string.Empty,
                        ViewData["Title"]?.ToString(),
                        breadcrumbTrail);
                }

                @if (breadcrumbs.Count > 0)
                {
                    <nav class="breadcrumb-bar" aria-label="Breadcrumb">
                        <ol class="breadcrumb-list">
                            @for (var index = 0; index < breadcrumbs.Count; index++)
                            {
                                var crumb = breadcrumbs[index];
                                var isLast = index == breadcrumbs.Count - 1;

                                <li class="breadcrumb-item">
                                    @if (!isLast && !string.IsNullOrWhiteSpace(crumb.Page))
                                    {
                                        <a class="breadcrumb-link" asp-page="@crumb.Page">@crumb.Label</a>
                                    }
                                    else
                                    {
                                        <span class="breadcrumb-current" aria-current="page">@crumb.Label</span>
                                    }
                                </li>

                                @if (!isLast)
                                {
                                    <li class="breadcrumb-separator" aria-hidden="true">
                                        @MatmonIcons.Render("arrow-right")
                                    </li>
                                }
                            }
                        </ol>
                    </nav>
                }

                @if (workspaceSummary is not null && !suppressWorkspaceSummary)
                {
                    <section class="workspace-summary-strip" aria-label="Workspace summary">
                                <div class="workspace-summary-card">
                            <div class="workspace-summary-main">
                                <span class="workspace-summary-kicker">Primary</span>
                                <strong>@workspaceSummary.WorkspaceName</strong>
                            </div>
                            <div class="workspace-summary-metrics">
                                <a class="workspace-summary-chip" asp-page="/Probes" aria-label="Configured probes">
                                    @MatmonIcons.Render("probe")
                                    <strong>@workspaceSummary.ConfiguredProbeCount</strong>
                                    <span>Probes</span>
                                </a>
                                <a class="workspace-summary-chip" asp-page="/Monitoring" asp-route-monitoringKind="sensor" aria-label="Total sensors">
                                    @MatmonIcons.Render("sensor")
                                    <strong>@workspaceSummary.SensorCount</strong>
                                    <span>Sensors</span>
                                </a>
                            </div>
                        </div>
                    </section>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

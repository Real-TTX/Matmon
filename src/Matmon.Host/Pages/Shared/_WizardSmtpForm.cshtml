@model Matmon.Host.Pages.WizardModel
@* Local SMTP setup form for the wizard's notifications step. Used both when no cloud is connected and,
   behind a "use your own SMTP server" disclosure, when the cloud is connected (never both on one page, so the ids are
   unique). Posts to the Wizard page's ConfigureNotifications handler (asp-page-handler carries the antiforgery token +
   the correct action). The handler needs a host and both addresses; the form asks for them before it is sent. *@
<form method="post" asp-page-handler="ConfigureNotifications" class="mat-form" novalidate>
    <div class="mat-form__grid">
        <div class="mat-field">
            <label class="mat-label" for="wizard-smtp-host">SMTP host <span class="mat-req" aria-hidden="true">*</span></label>
            <input class="mat-input mat-mono" id="wizard-smtp-host" name="smtpHost" placeholder="smtp.example.com" autocomplete="off" required data-msg-required="Please enter the SMTP host." />
            <span class="mat-error" aria-live="polite"></span>
        </div>
        <div class="mat-field">
            <label class="mat-label" for="wizard-smtp-port">Port</label>
            <input class="mat-input mat-mono" id="wizard-smtp-port" name="smtpPort" type="number" value="587" inputmode="numeric" />
            <span class="mat-error" aria-live="polite"></span>
        </div>
        <div class="mat-field">
            <label class="mat-label" for="wizard-smtp-user">Username</label>
            <input class="mat-input" id="wizard-smtp-user" name="username" autocomplete="off" />
        </div>
        <div class="mat-field">
            <label class="mat-label" for="wizard-smtp-password">Password</label>
            <div class="mat-input-icon mat-input-icon--end">
                <input class="mat-input" id="wizard-smtp-password" name="password" type="password" autocomplete="new-password" />
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm mat-input-icon__btn" data-password-toggle="wizard-smtp-password" aria-pressed="false" aria-label="Show the password" data-tip="Show or hide">@MatUi.Icon("eye", "mat-toggle-on")@MatUi.Icon("eye-off", "mat-toggle-off")</button>
            </div>
        </div>
        <div class="mat-field">
            <label class="mat-label" for="wizard-smtp-from">From address <span class="mat-req" aria-hidden="true">*</span></label>
            <input class="mat-input" id="wizard-smtp-from" name="fromEmail" type="email" placeholder="matmon@yourdomain" autocomplete="off" required
                   data-msg-required="Please enter the address the alerts come from." data-msg-type="Please enter an address like matmon@yourdomain." />
            <span class="mat-error" aria-live="polite"></span>
        </div>
        <div class="mat-field">
            <label class="mat-label" for="wizard-smtp-to">Send alerts to <span class="mat-req" aria-hidden="true">*</span></label>
            <input class="mat-input" id="wizard-smtp-to" name="toEmail" type="email" placeholder="you@yourdomain" autocomplete="off" required
                   data-msg-required="Please enter the address that gets the alerts." data-msg-type="Please enter an address like you@yourdomain." />
            <span class="mat-error" aria-live="polite"></span>
        </div>
    </div>
    <label class="mat-check"><input type="checkbox" id="wizard-smtp-ssl" name="useSsl" value="true" checked /><span class="mat-check__text">Use SSL/TLS</span></label>
    <div class="mat-btn-row mat-btn-row--plain">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("bell")<span>Set up e-mail alerts</span></button>
    </div>
</form>

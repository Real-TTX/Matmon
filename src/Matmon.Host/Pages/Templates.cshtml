@page "/templates"
@model WorkspaceModel
@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@inject Matmon.Host.Services.CloudTemplateStoreClient StoreClient
@{
    ViewData["Title"] = "Templates";
    var returnUrl = Request.Path + Request.QueryString;
    var isAdmin = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
    var templates = Model.View.Templates;
    var sensorTemplateCount = templates.Count(template => template.IsSensorTemplate);
    var linkedTemplateCount = templates.Count(template => !string.IsNullOrWhiteSpace(template.ParentName));
    var configuredTemplateCount = templates.Count(template =>
        template.ParameterCount > 0 ||
        template.ThresholdCount > 0 ||
        template.CredentialCount > 0 ||
        !string.Equals(template.Summary, "default", StringComparison.OrdinalIgnoreCase));
    var impactedSensorLinks = templates.Sum(template => template.ImpactCount);
    var scopeOrder = new[] { "Any", "Probe", "Folder", "Host", "Sensor" };
    var groupedTemplates = templates
        .GroupBy(template => template.Scope)
        .OrderBy(group =>
        {
            var index = Array.IndexOf(scopeOrder, group.Key);
            return index < 0 ? 99 : index;
        })
        .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    static string Plural(int count, string singular) => $"{count} {singular}{(count == 1 ? string.Empty : "s")}";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (isAdmin)
{
    // Sets added from the template store that have another version there now (the cloud is asked at most every 30 minutes).
    var storeUpdates = (await Matmon.Host.Services.TemplateStoreUpdates.FindAsync(WorkspaceStore, StoreClient, ViewContext.HttpContext.RequestAborted))
        .Where(set => set.UpdateAvailable).ToList();
    if (storeUpdates.Count > 0)
    {
        <div class="mat-alert mat-alert--info" role="status">@MatUi.Icon("refresh")<div class="mat-alert__body">
            @(storeUpdates.Count == 1 ? "A newer version of a template set is in the store:" : "Newer versions of template sets are in the store:")
            @for (var i = 0; i < storeUpdates.Count; i++)
            {
                var update = storeUpdates[i];
                if (i > 0)
                {
                    <span>, </span>
                }
                <a href="/templates/store?show=@Uri.EscapeDataString(update.Slug)">@(update.Title ?? update.Slug)</a> <span class="mat-mono">@(string.IsNullOrEmpty(update.Installed) ? "" : update.Installed + " → ")@update.Live</span>
            }
        </div></div>
    }
}

<div class="mat-stats">
    <div class="mat-stat">
        <span class="mat-stat__label">Total</span>
        <span class="mat-stat__value">@templates.Count</span>
        <span class="mat-stat__delta">@configuredTemplateCount configured</span>
    </div>
    <div class="mat-stat">
        <span class="mat-stat__label">Sensor templates</span>
        <span class="mat-stat__value">@sensorTemplateCount</span>
        <span class="mat-stat__delta">For one sensor type</span>
    </div>
    <div class="mat-stat">
        <span class="mat-stat__label">Inherited</span>
        <span class="mat-stat__value">@linkedTemplateCount</span>
        <span class="mat-stat__delta">Based on another template</span>
    </div>
    <div class="mat-stat">
        <span class="mat-stat__label">Affected sensors</span>
        <span class="mat-stat__value">@impactedSensorLinks</span>
        <span class="mat-stat__delta">Created from a template</span>
    </div>
</div>

<div class="mat-list">
    @if (templates.Count == 0)
    {
        <div class="mat-empty mat-empty--first">
            <span class="mat-empty__icon">@MatUi.Icon("template")</span>
            <div class="mat-empty__title">No templates yet</div>
            <a class="mat-btn mat-btn--primary" asp-page="/TemplateEditor" asp-route-returnUrl="@returnUrl">@MatUi.Icon("plus")<span>New template</span></a>
        </div>
    }
    else
    {
        <div class="mat-toolbar" role="toolbar" aria-label="Templates tools">
            <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn" data-groups-set="toggle" data-groups-target="#templates-table">@MatUi.Icon("chevron-down")<span>Open or close all scopes</span></button>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-toolbar__info" aria-live="polite">@configuredTemplateCount configured / @templates.Count total</span>
        </div>

        <div class="mat-table-wrap">
            <table class="mat-table" id="templates-table" data-groups="templates">
                <caption class="mat-sr-only">Templates by scope</caption>
                <thead>
                    <tr>
                        <th scope="col">Template</th>
                        <th scope="col" class="mat-hide-sm">Based on</th>
                        <th scope="col" class="mat-hide-sm">Configuration</th>
                        <th scope="col" class="mat-num">Affected</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                @foreach (var group in groupedTemplates)
                {
                    <tbody class="mat-group" data-group="@group.Key">
                        <tr class="mat-group__head">
                            <td class="mat-group__cell" colspan="5">
                                <div class="mat-group__bar">
                                    <button type="button" class="mat-group__toggle" data-group-toggle aria-expanded="true">
                                        @MatUi.Icon("chevron-down", "mat-group__chev")<span class="mat-group__title">@group.Key</span><span class="mat-badge mat-badge--soft">@group.Count()<span class="mat-sr-only"> @(group.Count() == 1 ? "template" : "templates")</span></span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        @foreach (var template in group.OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <tr class="mat-group__item">
                                <td data-label="Template" class="mat-table__primary">
                                    <div class="mat-table__name">
                                        @MatUi.Icon(template.IsSensorTemplate ? "activity" : "template")
                                        <span>
                                            <a asp-page="/TemplateEditor" asp-route-selectedTemplateId="@template.Id" asp-route-returnUrl="@returnUrl">@template.Name</a>
                                            @if (!string.IsNullOrWhiteSpace(template.SensorTypeLabel))
                                            {
                                                <small>@template.SensorTypeLabel</small>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Based on" class="mat-hide-sm">@(string.IsNullOrWhiteSpace(template.ParentName) ? "Base defaults" : template.ParentName)</td>
                                <td data-label="Configuration" class="mat-hide-sm">
                                    <span class="mat-text-muted">@template.Summary · @(Plural(template.ParameterCount, "param")) · @(Plural(template.ThresholdCount, "threshold")) · @(Plural(template.CredentialCount, "credential"))</span>
                                </td>
                                <td data-label="Affected" class="mat-num">
                                    @template.ImpactCount
                                    @if (template.InheritedImpactCount > 0)
                                    {
                                        <small class="mat-text-muted">(@template.InheritedImpactCount inherited)</small>
                                    }
                                </td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        @if (template.IsSensorTemplate && !string.IsNullOrWhiteSpace(template.SensorTypeKey))
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/SensorCreate" asp-route-selectedTemplateId="@template.Id" asp-route-returnUrl="@returnUrl" aria-label="New sensor from @template.Name" data-tip="New sensor">@MatUi.Icon("plus")</a>
                                        }
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/Templates" asp-page-handler="ExportTemplates" asp-route-id="@template.Id" download aria-label="Export @template.Name" data-tip="Export as a file">@MatUi.Icon("download")</a>
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/TemplateEditor" asp-route-selectedTemplateId="@template.Id" asp-route-returnUrl="@returnUrl" aria-label="Edit @template.Name" data-tip="Edit">@MatUi.Icon("edit")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    }

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" asp-page="/TemplateEditor" asp-route-returnUrl="@returnUrl">@MatUi.Icon("plus")<span>New template</span></a>
        @if (isAdmin)
        {
            <a class="mat-btn mat-btn--secondary" asp-page="/TemplateStore">@MatUi.Icon("store")<span>Store</span></a>
            <button type="button" class="mat-btn mat-btn--secondary" data-dialog-open="templates-import" aria-haspopup="dialog">@MatUi.Icon("upload")<span>Import</span></button>
        }
        @if (templates.Count > 0)
        {
            <a class="mat-btn mat-btn--secondary" asp-page="/Templates" asp-page-handler="ExportTemplates" download>@MatUi.Icon("download")<span>Export all</span></a>
        }
    </div>
</div>

@if (isAdmin)
{
    <dialog class="mat-dialog" id="templates-import" aria-labelledby="templates-import-title">
        <form method="post" asp-page="/Templates" asp-page-handler="ImportTemplates" enctype="multipart/form-data" class="mat-dialog__form mat-form" novalidate>
            <div class="mat-dialog__head">
                @MatUi.Icon("upload")
                <h2 class="mat-dialog__title" id="templates-import-title">Import templates</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-stack">
                <div class="mat-field">
                    <label class="mat-label" for="templates-import-file">Template file <span class="mat-req" aria-hidden="true">*</span></label>
                    <div class="mat-upload" data-upload>
                        <input class="mat-upload__input" type="file" id="templates-import-file" name="templateFile" accept=".json,application/json" required data-msg-required="Choose a template file." aria-describedby="templates-import-hint" />
                    </div>
                    <span class="mat-hint" id="templates-import-hint">A file exported from Matmon. Credentials come without their secrets: fill them in afterwards.</span>
                    <span class="mat-error" aria-live="polite"></span>
                </div>
                <label class="mat-check">
                    <input type="checkbox" name="replaceExisting" value="true" aria-describedby="templates-import-replace-hint" />
                    <span class="mat-check__text">Update templates that have the same name</span>
                </label>
                <span class="mat-hint" id="templates-import-replace-hint">On: a template of the same name is updated in place - it keeps its sensors' link and the credentials filled in here. Off: the file's templates are added beside yours, a name that exists gets "(imported)".</span>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("upload")<span>Import</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                </div>
            </div>
        </form>
    </dialog>
}

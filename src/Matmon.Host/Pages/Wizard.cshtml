@page "/setup/wizard"
@model WizardModel
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Set up Matmon";
    ViewData["AnonymousMainExtraClass"] = "anonymous-main-top";

    var steps = new (string Key, string Icon, string Label)[]
    {
        ("welcome", "spark", "Welcome"),
        ("structure", "folder", "Structure"),
        ("networks", "network", "Networks"),
        ("discovery", "search", "Discovery"),
        ("probes", "probe", "Remote probes"),
        ("notifications", "bell", "Notifications"),
        ("done", "check", "Done"),
    };

    string StepUrl(string? key) => key is null ? "/" : $"/setup/wizard?step={key}";
}

<section class="dashboard-shell setup-wizard">
    <div class="page-header setup-wizard-header">
        <div class="page-title">
            @MatmonIcons.Render("spark")
            <h1>Set up Matmon</h1>
        </div>
        <a class="workspace-secondary-submit setup-wizard-skip" href="/">@MatmonIcons.Render("x")<span>Skip setup</span></a>
    </div>

    <ol class="setup-wizard-rail" aria-label="Setup progress">
        @for (var i = 0; i < steps.Length; i++)
        {
            var s = steps[i];
            var state = i < Model.StepIndex ? "is-done" : (i == Model.StepIndex ? "is-current" : string.Empty);
            <li class="setup-wizard-step @state">
                <span class="setup-wizard-step-mark">@(i < Model.StepIndex ? MatmonIcons.Render("check") : MatmonIcons.Render(s.Icon))</span>
                <span class="setup-wizard-step-label">@s.Label</span>
            </li>
        }
    </ol>

    <div class="panel setup-wizard-panel">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
        }
        @if (Model.Step != "welcome" && Model.Step != "done")
        {
            <p class="setup-wizard-progress">Step @Model.ActionStepNumber of @Model.ActionStepCount · optional</p>
        }

        <div class="setup-wizard-body">
            @switch (Model.Step)
            {
                case "welcome":
                    <h2 class="section-title">@MatmonIcons.Render("spark")<span>Your account is ready</span></h2>
                    <p>Welcome to Matmon. Let's get it monitoring your network. The next steps are all <strong>optional</strong> — do them now or skip and come back later from the menu.</p>
                    <ul class="setup-wizard-list">
                        <li>@MatmonIcons.Render("search")<span>Discover devices on your network</span></li>
                        <li>@MatmonIcons.Render("probe")<span>Add remote probes for other sites</span></li>
                        <li>@MatmonIcons.Render("bell")<span>Set up alert notifications</span></li>
                    </ul>
                    break;

                case "structure":
                    <h2 class="section-title">@MatmonIcons.Render("folder")<span>Organize your monitoring</span></h2>
                    <p>Create a starter folder structure under your node so sensors stay tidy from day one. You can rename, add or remove folders anytime.</p>
                    <ul class="setup-wizard-tree">
                        @foreach (var (name, children) in WizardModel.StarterTree)
                        {
                            <li>
                                <span class="setup-wizard-tree-item">@MatmonIcons.Render("folder")<span>@name</span></span>
                                @if (children.Length > 0)
                                {
                                    <ul>
                                        @foreach (var child in children)
                                        {
                                            <li><span class="setup-wizard-tree-item">@MatmonIcons.Render("folder")<span>@child</span></span></li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                    <form method="post" asp-page-handler="CreateStructure">
                        <button type="submit" class="workspace-submit setup-wizard-open">@MatmonIcons.Render("plus")<span>Create these folders</span></button>
                    </form>
                    @if (Model.ExistingFolders.Count > 0)
                    {
                        <p class="setup-wizard-muted">Already under your node: @string.Join(", ", Model.ExistingFolders)</p>
                    }
                    break;

                case "networks":
                    <h2 class="section-title">@MatmonIcons.Render("network")<span>Your node's networks</span></h2>
                    <p>Add the subnets this node should monitor. They're stored on the node and discovery uses them to find devices. Optional — add now or later.</p>

                    @if (Model.ConfiguredSubnets.Count > 0)
                    {
                        <ul class="setup-wizard-chips">
                            @foreach (var net in Model.ConfiguredSubnets)
                            {
                                <li class="tree-tag setup-wizard-net">
                                    @MatmonIcons.Render("network")<span>@net</span>
                                    <form method="post" asp-page-handler="RemoveNetwork">
                                        <input type="hidden" name="cidr" value="@net" />
                                        <button type="submit" class="setup-wizard-net-remove" aria-label="Remove @net" title="Remove">@MatmonIcons.Render("x")</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="setup-wizard-muted">No subnets configured yet.</p>
                    }

                    <form method="post" asp-page-handler="AddNetwork" class="setup-wizard-add">
                        <input type="text" name="cidr" class="workspace-input" placeholder="e.g. 192.168.1.0/24" autocomplete="off" />
                        <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Add</span></button>
                    </form>

                    @if (Model.SuggestedNetworks.Count > 0)
                    {
                        <p class="setup-wizard-muted">Detected on this host — click to add:</p>
                        <div class="setup-wizard-suggestions">
                            @foreach (var net in Model.SuggestedNetworks)
                            {
                                <form method="post" asp-page-handler="AddNetwork">
                                    <input type="hidden" name="cidr" value="@net" />
                                    <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("plus")<span>@net</span></button>
                                </form>
                            }
                        </div>
                    }
                    break;

                case "discovery":
                    <h2 class="section-title">@MatmonIcons.Render("search")<span>Discover your devices</span></h2>
                    <p>Scan your node's networks to find hosts and services. Start the scan right here — found devices are listed in Discovery, where you turn them into sensors.</p>
                    @if (Model.ConfiguredSubnets.Count > 0)
                    {
                        <ul class="setup-wizard-chips">
                            @foreach (var net in Model.ConfiguredSubnets)
                            {
                                <li class="tree-tag">@MatmonIcons.Render("network")<span>@net</span></li>
                            }
                        </ul>
                        <form method="post" asp-page-handler="StartDiscovery">
                            <button type="submit" class="workspace-submit setup-wizard-open">@MatmonIcons.Render("search")<span>Start a scan</span></button>
                        </form>
                        <p class="setup-wizard-muted"><a href="/Discovery" target="_blank" rel="noopener">Open Discovery ↗</a> to watch progress and import what's found.</p>
                    }
                    else
                    {
                        <p class="setup-wizard-muted">No networks configured yet — add a subnet in the Networks step first.</p>
                        <a class="workspace-secondary-submit setup-wizard-open" href="/setup/wizard?step=networks">@MatmonIcons.Render("arrow-left")<span>Back to Networks</span></a>
                    }
                    break;

                case "probes":
                    <h2 class="section-title">@MatmonIcons.Render("probe")<span>Add remote probes</span></h2>
                    <p>A remote probe monitors another site or devices behind NAT/firewalls — it connects <em>outbound</em> to this server, so no inbound ports are needed. You'll get a token and a ready-to-run Docker command.</p>
                    <a class="workspace-submit setup-wizard-open" href="/system/probes/new" target="_blank" rel="noopener">@MatmonIcons.Render("plus")<span>Add a remote probe</span>@MatmonIcons.Render("arrow-right")</a>
                    <p class="setup-wizard-muted">Opens in a new tab. Skip this if you only monitor from this server.</p>
                    break;

                case "notifications":
                    <h2 class="section-title">@MatmonIcons.Render("bell")<span>Get notified</span></h2>
                    <p>Alerts are most useful when they reach you. Set up an e-mail sender, a recipient and a rule so Matmon can tell you when something breaks.</p>
                    <a class="workspace-submit setup-wizard-open" href="/notifications" target="_blank" rel="noopener">@MatmonIcons.Render("bell")<span>Set up notifications</span>@MatmonIcons.Render("arrow-right")</a>
                    <p class="setup-wizard-muted">Opens in a new tab — configure a sender + receiver + rule.</p>
                    break;

                case "done":
                    <h2 class="section-title">@MatmonIcons.Render("check")<span>You're all set</span></h2>
                    <p>Matmon is ready to go. You can revisit Discovery, probes and notifications anytime from the menu. Head to the dashboard to see your monitoring come to life.</p>
                    break;
            }
        </div>

        <div class="setup-wizard-actions">
            @if (Model.PrevStep is not null)
            {
                <a class="workspace-secondary-submit" href="@StepUrl(Model.PrevStep)">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
            }
            <span class="setup-wizard-actions-spacer"></span>
            @if (Model.Step == "welcome")
            {
                <a class="workspace-submit" href="@StepUrl(Model.NextStep)"><span>Get started</span>@MatmonIcons.Render("arrow-right")</a>
            }
            else if (Model.Step == "done")
            {
                <a class="workspace-submit" href="/"><span>Go to dashboard</span>@MatmonIcons.Render("arrow-right")</a>
            }
            else
            {
                <a class="workspace-secondary-submit" href="@StepUrl(Model.NextStep)"><span>Skip</span></a>
                <a class="workspace-submit" href="@StepUrl(Model.NextStep)"><span>Continue</span>@MatmonIcons.Render("arrow-right")</a>
            }
        </div>
    </div>
</section>

@page "/setup/wizard"
@model WizardModel
@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Setup assistant";

    // The steps in the order of WizardModel.StepOrder. The bar at the top (mat-steps) shows how far along the assistant
    // is; the label of the current step is the line under the title.
    var steps = new (string Key, string Label)[]
    {
        ("welcome", "Welcome"),
        ("cloud", "Cloud & license"),
        ("restore", "Restore"),
        ("notifications", "Notifications"),
        ("structure", "Structure & networks"),
        ("discovery", "Devices & probes"),
        ("twofactor", "Security"),
        ("done", "Done"),
    };

    string StepUrl(string? key) => key is null ? "/" : $"/setup/wizard?step={key}";
    var primaryUrl = Model.PrimaryUrl;
    var currentIndex = Math.Clamp(Model.StepIndex, 0, steps.Length - 1);
    var current = steps[currentIndex];

    // The brand at the top of the card: a managing partner's logo, or nothing under a white label without one, else the
    // Matmon mark; a white label's product name replaces "Matmon" in the text.
    var partnerProductName = WorkspaceStore.GetServicePartnerProductName();
    var partnerHasLogo = WorkspaceStore.GetServicePartnerHasLogo();
    var brandName = partnerProductName ?? "Matmon";
}

<div class="mat-auth__card mm-auth-card--wide">
    <div class="mat-auth__brand">
        @if (partnerHasLogo)
        {
            <img class="mm-auth-logo" src="/api/branding/logo" alt="" />
        }
        else if (partnerProductName is null)
        {
            <img class="mat-brandmark--light mm-authlogo" src="/brand/matmon-logo-horizontal.svg" alt="" width="233" height="44" /><img class="mat-brandmark--dark mm-authlogo" src="/brand/matmon-logo-horizontal-dark.svg" alt="" width="233" height="44" />
        }
        <h1>Set up @brandName</h1>
        <p class="mat-muted">Step @Model.StepNumber of @Model.StepCount: @current.Label</p>
    </div>

    <ol class="mat-steps" aria-label="Setup progress">
        @for (var i = 0; i < steps.Length; i++)
        {
            if (i < currentIndex)
            {
                <li class="is-done"><span class="mat-sr-only">Step @(i + 1), @steps[i].Label, done</span></li>
            }
            else if (i == currentIndex)
            {
                <li class="is-active" aria-current="step"><span class="mat-sr-only">Step @(i + 1), @steps[i].Label, current</span></li>
            }
            else
            {
                <li><span class="mat-sr-only">Step @(i + 1), @steps[i].Label</span></li>
            }
        }
    </ol>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
    }

    <section class="mm-wizard__step" aria-labelledby="wizard-step-title">
        @switch (Model.Step)
        {
            case "welcome":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("sparkles")<span>Your account is ready</span></h2>
                @if (Model.SignsInWithCloud)
                {
                    <p>You sign in with your Matmon Cloud account. A few optional steps follow - the cloud connection first.</p>
                }
                else
                {
                    <p>A few optional steps, starting with the cloud connection.</p>
                }
                break;

            case "cloud":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("cloud")<span>Connect to Matmon Cloud</span></h2>
                @if (Model.CloudEnvLinkActive)
                {
                    <div class="mat-alert mat-alert--warning" role="status">
                        @MatUi.Icon("alert")
                        <div class="mat-alert__body">
                            This installation is <strong>already linked</strong> to the cloud instance <code>@Model.CloudEnvLinkInstanceId</code> at <strong>@Model.CloudLinkUrl</strong> -
                            by its <em>environment</em> (<code>Matmon__CloudInstanceId</code> / <code>Matmon__CloudInstanceToken</code>), license included (<strong>@Model.License.DisplayName</strong>).
                            A new installation started with this environment always becomes that instance again.
                        </div>
                    </div>
                    <p>Keep the link, or unlink and connect this installation yourself - as a <strong>new</strong> instance or by taking an old one over.</p>
                    @* Both actions are handlers of System > Cloud and come back here (returnUrl): one form, the second button
                       posts to its own handler (formaction). *@
                    <form method="post" asp-page="/Config" asp-page-handler="CloudKeepEnvLink" class="mat-form" novalidate>
                        <input type="hidden" name="returnUrl" value="/setup/wizard?step=cloud" />
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("check")<span>Keep this link</span></button>
                            <button type="submit" class="mat-btn mat-btn--secondary" asp-page="/Config" asp-page-handler="CloudUnlinkEnvLink"
                                    data-confirm="Unlink this installation from that cloud instance?" data-confirm-ok="Unlink">@MatUi.Icon("x")<span>Unlink and connect as new</span></button>
                        </div>
                    </form>
                }
                else if (Model.CloudConnected)
                {
                    <p class="mm-wizard__state">@MatUi.Icon("check-circle")<span>Connected to <strong>@Model.CloudLinkUrl</strong> · plan <strong>@Model.License.DisplayName</strong></span></p>
                    @if (Model.SignsInWithCloud)
                    {
                        <div class="mat-alert mat-alert--info" role="status">
                            @MatUi.Icon("info")
                            <div class="mat-alert__body">
                                You sign in through this connection - keep it. Should the cloud ever be out of reach, a local password
                                (on <a href="/Account">your account page</a>) or a recovery file in the data folder still gets you in.
                            </div>
                        </div>
                    }
                    <form method="post" asp-page-handler="CloudMonitoring" class="mat-form" novalidate>
                        <label class="mat-check"><input type="checkbox" id="wizard-notify-problems" name="notifyOnProblems" value="true" checked /><span class="mat-check__text">E-mail me if this instance goes offline (and when it recovers)</span></label>
                        <label class="mat-check"><input type="checkbox" id="wizard-cloud-backup" name="cloudBackup" value="true" checked="@Model.NightlyCloudBackup" /><span class="mat-check__text">Back up the configuration to Matmon.Cloud every night</span></label>
                        @if (Model.License.TunnelEnabled)
                        {
                            <label class="mat-check"><input type="checkbox" id="wizard-remote-access" name="remoteAccess" value="true" checked="@Model.RemoteAccessEnabled" /><span class="mat-check__text">Remote access: operate this instance from Matmon.Cloud</span></label>
                        }
                        else
                        {
                            <label class="mat-check"><input type="checkbox" id="wizard-remote-access" disabled /><span class="mat-check__text">Remote access: operate this instance from Matmon.Cloud <span class="mat-muted">(not in the @Model.License.DisplayName plan)</span></span></label>
                        }
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("bell")<span>Save</span></button>
                        </div>
                    </form>
                    <p class="mat-muted">Manage the link in <a href="/Config?tab=cloud" target="_blank" rel="noopener">System → Cloud @MatUi.Icon("external")</a>.</p>
                }
                else
                {
                    <form method="post" asp-page="/Config" asp-page-handler="CloudClaim" class="mat-form" novalidate>
                        <input type="hidden" name="returnUrl" value="/setup/wizard?step=cloud" />
                        <div class="mat-form__grid">
                            <div class="mat-field">
                                <label class="mat-label" for="wizard-cloud-url">Cloud URL</label>
                                <input class="mat-input mat-mono" id="wizard-cloud-url" name="CloudProvision.Url" value="@Model.DefaultCloudUrl" inputmode="url" autocomplete="off" />
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" for="wizard-cloud-name">Instance name</label>
                                <input class="mat-input" id="wizard-cloud-name" name="CloudProvision.Name" value="@Model.SuggestedInstanceName" autocomplete="off" />
                            </div>
                        </div>
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("cloud")<span>Connect</span></button>
                        </div>
                    </form>

                    <details class="mat-collapse">
                        <summary><span>No cloud? Apply a license token manually (offline / air-gapped)</span>@MatUi.Icon("chevron-down", "mat-accordion__chev")</summary>
                        <div class="mat-accordion__body">
                            <form method="post" asp-page-handler="SetLicenseToken" class="mat-form" novalidate>
                                <p class="mat-muted">Without the cloud: <strong>@Model.License.DisplayName</strong>. Paste a signed license token issued by Matmon.Cloud:</p>
                                <div class="mat-field">
                                    <label class="mat-label" for="wizard-license-token">License token</label>
                                    <textarea class="mat-textarea mat-mono" id="wizard-license-token" name="LicenseTokenInput" rows="3" placeholder="Paste the signed token…"></textarea>
                                </div>
                                <div class="mat-btn-row mat-btn-row--plain">
                                    <button type="submit" class="mat-btn mat-btn--secondary">@MatUi.Icon("check")<span>Apply license</span></button>
                                </div>
                            </form>
                        </div>
                    </details>
                }
                break;

            case "restore":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("restore")<span>Restore from a cloud backup</span></h2>
                @if (!Model.CloudConnected)
                {
                    <p>Needs the cloud link. <a href="@StepUrl("cloud")">Connect to Matmon.Cloud</a> first, or skip.</p>
                }
                else if (!Model.AccountBackupsAvailable)
                {
                    <div class="mat-alert mat-alert--warning" role="status">@MatUi.Icon("alert")<div class="mat-alert__body">Couldn't reach Matmon.Cloud to list your backups. You can restore later from <a href="/Config?tab=backup" target="_blank" rel="noopener">System → Cloud → Backup @MatUi.Icon("external")</a>.</div></div>
                }
                else if (Model.AccountBackups.Count == 0)
                {
                    <p class="mm-wizard__state">@MatUi.Icon("check-circle")<span>No backups on your cloud account yet.</span></p>
                }
                else
                {
                    <p>Only the <strong>configuration</strong> is restored - no telemetry; your new admin account is kept.</p>
                    <div class="mat-stack">
                        @foreach (var backup in Model.AccountBackups)
                        {
                            var encrypted = backup.IsEncrypted;
                            var passphraseId = $"wizard-passphrase-{backup.Id}";
                            <div class="mat-card">
                                <div class="mat-card__head">@MatUi.Icon("cloud")<h3 class="mat-card__title">@backup.InstanceName</h3></div>
                                <div class="mat-card__body">
                                    <form method="post" asp-page-handler="RestoreFromCloud" class="mat-form" novalidate>
                                        <input type="hidden" name="backupId" value="@backup.Id" />
                                        <p class="mat-muted"><span class="mat-mono">@backup.CreatedUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span> · @backup.Label</p>
                                        @if (encrypted)
                                        {
                                            <div class="mat-field mm-wizard__inline">
                                                <label class="mat-label" for="@passphraseId">Passphrase</label>
                                                <div class="mat-input-icon mat-input-icon--end">
                                                    <input class="mat-input" id="@passphraseId" type="password" name="passphrase" placeholder="Required - this backup is encrypted" autocomplete="off"
                                                           required data-msg-required="This backup is encrypted - please enter its passphrase." />
                                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm mat-input-icon__btn" data-password-toggle="@passphraseId" aria-pressed="false" aria-label="Show the passphrase" data-tip="Show or hide">@MatUi.Icon("eye", "mat-toggle-on")@MatUi.Icon("eye-off", "mat-toggle-off")</button>
                                                </div>
                                                <span class="mat-error" aria-live="polite"></span>
                                            </div>
                                        }
                                        <div class="mat-btn-row mat-btn-row--plain">
                                            <button type="submit" class="mat-btn mat-btn--secondary"
                                                    data-confirm="Restore this backup? It overwrites the current configuration (your admin account is kept)." data-confirm-ok="Restore">@MatUi.Icon("restore")<span>Restore this backup</span></button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                break;

            case "notifications":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("bell")<span>Get notified</span></h2>
                @if (Model.CloudConnected)
                {
                    @if (Model.CloudRelayEnabled)
                    {
                        <p class="mm-wizard__state">@MatUi.Icon("check-circle")<span>Alerts are delivered through <strong>Matmon.Cloud</strong>. Pick recipients per rule under <a href="/notifications" target="_blank" rel="noopener">Notifications @MatUi.Icon("external")</a>.</span></p>
                        <form method="post" asp-page-handler="EnableCloudRelay" class="mat-form" novalidate>
                            <input type="hidden" name="enable" value="false" />
                            <div class="mat-btn-row mat-btn-row--plain">
                                <button type="submit" class="mat-btn mat-btn--secondary">Turn cloud delivery off</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p>Alert e-mail can go out through Matmon.Cloud - no SMTP server needed.</p>
                        <form method="post" asp-page-handler="EnableCloudRelay" class="mat-form" novalidate>
                            <input type="hidden" name="enable" value="true" />
                            <div class="mat-btn-row mat-btn-row--plain">
                                <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("cloud")<span>Deliver alerts via Matmon.Cloud</span></button>
                            </div>
                        </form>
                    }
                    <details class="mat-collapse">
                        <summary><span>Use your own SMTP server instead</span>@MatUi.Icon("chevron-down", "mat-accordion__chev")</summary>
                        <div class="mat-accordion__body">
                            @await Html.PartialAsync("_WizardSmtpForm", Model)
                        </div>
                    </details>
                }
                else
                {
                    <p>E-mail alerts on Warning and Critical.</p>
                    @if (Model.EmailConfigured)
                    {
                        <p class="mm-wizard__state">@MatUi.Icon("check-circle")<span>E-mail is configured. Manage it in <a href="/notifications" target="_blank" rel="noopener">Notifications @MatUi.Icon("external")</a>.</span></p>
                    }
                    else
                    {
                        @await Html.PartialAsync("_WizardSmtpForm", Model)
                    }
                }
                break;

            case "structure":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("folder")<span>Organize &amp; scope your monitoring</span></h2>
                <h3 class="mm-wizard__sub">Folders</h3>
                <p class="mat-muted">Only missing folders are created.</p>
                <ul class="mm-wizard__folders">
                    @foreach (var folder in Model.StarterFolders)
                    {
                        var folderClass = "mm-wizard__folder" + (folder.Depth > 0 ? " is-child" : string.Empty) + (folder.Exists ? " is-done" : string.Empty);
                        <li class="@folderClass">
                            @(folder.Exists ? MatUi.Icon("check-circle") : MatUi.Icon("folder"))<span>@folder.Label</span>
                            @if (folder.Exists)
                            {
                                <span class="mat-pill mat-pill--ok mm-push-end">exists</span>
                            }
                        </li>
                    }
                </ul>
                @if (Model.AllFoldersExist)
                {
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="button" class="mat-btn mat-btn--primary" disabled>@MatUi.Icon("check")<span>All folders exist</span></button>
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="CreateStructure" class="mat-form" novalidate>
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create @Model.MissingFolderCount missing folder@(Model.MissingFolderCount == 1 ? string.Empty : "s")</span></button>
                        </div>
                    </form>
                }

                <h3 class="mm-wizard__sub">Networks</h3>
                @if (Model.ConfiguredSubnets.Count > 0)
                {
                    @* One form for every remove button: the button that was pressed posts its network as "cidr". *@
                    <form method="post" asp-page-handler="RemoveNetwork" id="wizard-remove-network" hidden></form>
                    <div class="mat-chips" role="group" aria-label="Networks of this node">
                        @foreach (var net in Model.ConfiguredSubnets)
                        {
                            <span class="mat-chip">@MatUi.Icon("network")<span class="mat-mono">@net</span><button type="submit" class="mat-chip__x" form="wizard-remove-network" name="cidr" value="@net" aria-label="Remove @net" data-tip="Remove">@MatUi.Icon("x")</button></span>
                        }
                    </div>
                }
                else
                {
                    <p class="mat-muted">No subnets configured yet.</p>
                }
                <form method="post" asp-page-handler="AddNetwork" class="mat-form" novalidate>
                    <div class="mat-field mm-wizard__inline">
                        <label class="mat-label" for="wizard-cidr">Add a network</label>
                        <div class="mat-input-group">
                            <input class="mat-input mat-mono" id="wizard-cidr" type="text" name="cidr" placeholder="e.g. 192.168.1.0/24" autocomplete="off" />
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Add</span></button>
                        </div>
                    </div>
                </form>
                @if (Model.SuggestedNetworks.Count > 0)
                {
                    <form method="post" asp-page-handler="AddNetwork" id="wizard-add-detected" hidden></form>
                    <div class="mat-stack mat-stack--sm">
                        <p class="mat-muted">Detected - click to add:</p>
                        <div class="mat-row">
                            @foreach (var net in Model.SuggestedNetworks)
                            {
                                <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" form="wizard-add-detected" name="cidr" value="@net">@MatUi.Icon("plus")<span class="mat-mono">@net</span></button>
                            }
                        </div>
                    </div>
                }
                break;

            case "discovery":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("search")<span>Find your devices</span></h2>
                <h3 class="mm-wizard__sub">Discovery scan</h3>
                @if (Model.ConfiguredSubnets.Count > 0)
                {
                    <div class="mat-chips" role="group" aria-label="Networks to scan">
                        @foreach (var net in Model.ConfiguredSubnets)
                        {
                            <span class="mat-chip">@MatUi.Icon("network")<span class="mat-mono">@net</span></span>
                        }
                    </div>
                    <form method="post" asp-page-handler="StartDiscovery" class="mat-form" novalidate>
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("search")<span>Start a scan</span></button>
                        </div>
                    </form>
                    <p class="mat-muted"><a href="/Discovery" target="_blank" rel="noopener">Open Discovery @MatUi.Icon("external")</a> to import what's found.</p>
                }
                else
                {
                    <p class="mat-muted">No networks yet - add one in the previous step.</p>
                    <div class="mat-btn-row mat-btn-row--plain">
                        <a class="mat-btn mat-btn--secondary" href="/setup/wizard?step=structure">@MatUi.Icon("back")<span>Back to networks</span></a>
                    </div>
                }

                <h3 class="mm-wizard__sub">Remote probes</h3>
                <p class="mat-muted">For another site or devices behind NAT; the probe connects outbound to this server.</p>
                @if (Model.RemoteProbes.Count > 0)
                {
                    <p class="mm-wizard__state">@MatUi.Icon("check-circle")<span>@Model.RemoteProbes.Count remote probe@(Model.RemoteProbes.Count == 1 ? string.Empty : "s") already added. Deploy each with its command (replace <code>@primaryUrl</code> with an address the probe can reach):</span></p>
                    @for (var i = 0; i < Model.RemoteProbes.Count; i++)
                    {
                        var probe = Model.RemoteProbes[i];
                        var commandId = $"wizard-probe-command-{i}";
                        <div class="mat-card">
                            <div class="mat-card__head">@MatUi.Icon("server")<h4 class="mat-card__title">@probe.Name</h4></div>
                            <div class="mat-card__body">
                                <div class="mm-snippet">
                                    <pre class="mat-code" id="@commandId"><code>docker run -d \
  -e Matmon__Mode=Secondary \
  -e Matmon__ProbeId=@probe.ProbeId \
  -e Matmon__ProbeToken=@probe.Token \
  -e Matmon__PrimaryUrl=@primaryUrl \
  ghcr.io/real-ttx/matmon:latest</code></pre>
                                    <button type="button" class="mat-btn mat-btn--secondary mat-btn--icon mat-btn--sm" data-copy="#@commandId" aria-label="Copy the command for @probe.Name" data-tip="Copy">@MatUi.Icon("copy")</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="mat-muted">No remote probes yet.</p>
                }
                <form method="post" asp-page-handler="CreateProbe" class="mat-form" novalidate>
                    <div class="mat-field mm-wizard__inline">
                        <label class="mat-label" for="wizard-probe-name">New remote probe</label>
                        <div class="mat-input-group">
                            <input class="mat-input" id="wizard-probe-name" type="text" name="name" placeholder="Probe name, e.g. Branch office" autocomplete="off" />
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create probe</span></button>
                        </div>
                    </div>
                </form>
                break;

            case "twofactor":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("lock")<span>Secure your account</span></h2>
                @if (Model.TwoFactorEnabled)
                {
                    <p class="mm-wizard__state">@MatUi.Icon("check-circle")<span>Two-factor authentication is enabled. Manage it on your <a href="/Account" target="_blank" rel="noopener">Account @MatUi.Icon("external")</a>.</span></p>
                }
                else if (Model.Enrollment is not null)
                {
                    <p>Scan this QR code with your authenticator app (or enter the key), then type the 6-digit code to turn on two-factor.</p>
                    <div class="mm-wizard__totp">
                        <div class="mm-wizard__qr" role="img" aria-label="QR code for your authenticator app">@Html.Raw(Model.QrSvg)</div>
                        <div class="mat-field mm-wizard__key">
                            <label class="mat-label" for="wizard-totp-key">Manual key</label>
                            <div class="mat-input-group">
                                <input class="mat-input mat-mono" id="wizard-totp-key" value="@Model.Enrollment.SecretBase32" readonly />
                                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#wizard-totp-key">@MatUi.Icon("copy")<span>Copy</span></button>
                            </div>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="ConfirmTotp" class="mat-form" novalidate>
                        <div class="mat-field">
                            <label class="mat-label" for="wizard-totp-code">Code from the app</label>
                            <div class="mat-otp" data-otp data-length="6" data-chars="digits" data-submit="#wizard-totp-go">
                                <input class="mat-otp__input" id="wizard-totp-code" name="TotpCode" inputmode="numeric" autocomplete="one-time-code" required pattern="[0-9]{6}"
                                       data-msg-required="Please enter the six digits of the code." data-msg-pattern="The code has six digits." />
                            </div>
                            <span class="mat-error" aria-live="polite"></span>
                        </div>
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary" id="wizard-totp-go">@MatUi.Icon("check")<span>Enable</span></button>
                        </div>
                    </form>
                }
                else
                {
                    <p>With an authenticator app, a stolen password alone can't sign in.</p>
                    <form method="post" asp-page-handler="StartTotp" class="mat-form" novalidate>
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("lock")<span>Set up two-factor</span></button>
                        </div>
                    </form>
                }
                break;

            case "done":
                <h2 class="mm-wizard__title" id="wizard-step-title">@MatUi.Icon("check")<span>You're all set</span></h2>
                <p>@brandName is ready.</p>
                break;
        }
    </section>

    @* Moving through the assistant: forward (Get started / Continue / Go to dashboard), Skip, Back, and leaving it. *@
    <div class="mat-btn-row">
        @if (Model.Step == "welcome")
        {
            <a class="mat-btn mat-btn--primary" href="@StepUrl(Model.NextStep)"><span>Get started</span>@MatUi.Icon("arrow-right")</a>
        }
        else if (Model.Step == "done")
        {
            <a class="mat-btn mat-btn--primary" href="/"><span>Go to dashboard</span>@MatUi.Icon("arrow-right")</a>
        }
        else
        {
            <a class="mat-btn mat-btn--primary" href="@StepUrl(Model.NextStep)"><span>Continue</span>@MatUi.Icon("arrow-right")</a>
            @* Whoever signs in through the cloud cannot skip the cloud step - it is how they get in. *@
            @if (!(Model.Step == "cloud" && Model.SignsInWithCloud))
            {
                <a class="mat-btn mat-btn--secondary" href="@StepUrl(Model.NextStep)"><span>Skip</span></a>
            }
        }
        @if (Model.PrevStep is not null)
        {
            <a class="mat-btn mat-btn--secondary" href="@StepUrl(Model.PrevStep)">@MatUi.Icon("back")<span>Back</span></a>
        }
        @if (Model.Step != "done")
        {
            <span class="mat-btn-row__spacer"></span>
            <a class="mat-btn mat-btn--ghost mat-btn--end" href="/">@MatUi.Icon("x")<span>Skip setup</span></a>
        }
    </div>
</div>

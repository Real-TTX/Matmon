@page "/setup/wizard"
@model WizardModel
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Set up Matmon";
    ViewData["AnonymousMainExtraClass"] = "anonymous-main-top";

    var steps = new (string Key, string Icon, string Label)[]
    {
        ("welcome", "spark", "Welcome"),
        ("cloud", "cloud", "Cloud & license"),
        ("restore", "download", "Restore"),
        ("notifications", "bell", "Notifications"),
        ("structure", "folder", "Structure & networks"),
        ("discovery", "search", "Devices & probes"),
        ("twofactor", "lock", "Security"),
        ("done", "check", "Done"),
    };

    string StepUrl(string? key) => key is null ? "/" : $"/setup/wizard?step={key}";
    var primaryUrl = Model.PrimaryUrl;
}

<section class="dashboard-shell setup-wizard">
    <div class="page-header setup-wizard-header">
        <div class="page-title">
            @MatmonIcons.Render("spark")
            <h1>Set up Matmon</h1>
        </div>
        <a class="workspace-secondary-submit setup-wizard-skip" href="/">@MatmonIcons.Render("x")<span>Skip setup</span></a>
    </div>

    @{
        var current = steps[Math.Clamp(Model.StepIndex, 0, steps.Length - 1)];
    }
    <div class="setup-wizard-progress" aria-label="Setup progress">
        <div class="setup-wizard-progress-head">
            <span class="setup-wizard-progress-step">@MatmonIcons.Render(current.Icon)<span>@current.Label</span></span>
            <span class="setup-wizard-progress-count">Step @Model.StepNumber / @Model.StepCount</span>
        </div>
        <div class="setup-wizard-progress-track" role="progressbar" aria-valuenow="@Model.StepNumber" aria-valuemin="1" aria-valuemax="@Model.StepCount">
            <span class="setup-wizard-progress-bar" style="width:@Model.ProgressPercent%"></span>
        </div>
    </div>

    <div class="panel setup-wizard-panel">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
        }
        <div class="setup-wizard-body">
            @switch (Model.Step)
            {
                case "welcome":
                    <h2 class="section-title">@MatmonIcons.Render("spark")<span>Your account is ready</span></h2>
                    <p>A few quick, optional steps to get monitoring going. We'll start with the cloud connection - it decides whether you even need to set up e-mail or a license by hand. Skip anything you don't need; you can change it all later.</p>
                    break;

                case "cloud":
                    <h2 class="section-title">@MatmonIcons.Render("cloud")<span>Connect to Matmon Cloud</span></h2>
                    @if (Model.CloudConnected)
                    {
                        <p class="setup-wizard-muted">@MatmonIcons.Render("check") Connected to <strong>@Model.CloudLinkUrl</strong>. Your license is managed automatically (currently <strong>@Model.License.DisplayName</strong>), and you can relay alert e-mail through the cloud in the next step - no SMTP needed.</p>
                        <form method="post" asp-page-handler="CloudMonitoring" class="setup-wizard-form">
                            <label class="setup-wizard-check"><input type="checkbox" name="notifyOnProblems" value="true" checked /> <span>E-mail me if this instance goes offline (and when it recovers)</span></label>
                            <button type="submit" class="workspace-submit">@MatmonIcons.Render("bell")<span>Save</span></button>
                        </form>
                        <p class="setup-wizard-muted" style="margin-top:10px;">Manage the link anytime in <a href="/Config?tab=cloud" target="_blank" rel="noopener">System → Cloud ↗</a>.</p>
                    }
                    else
                    {
                        <p>Optional but recommended: link this instance to Matmon.Cloud for remote status, a dead-man switch, alert relay (send alerts without your own mail server), Full Access, and automatic license management. You stay in control - disconnect anytime.</p>
                        <form method="post" asp-page="/Config" asp-page-handler="CloudClaim" class="setup-wizard-form">
                            <input type="hidden" name="returnUrl" value="/setup/wizard?step=cloud" />
                            <div class="setup-wizard-grid">
                                <label class="workspace-field"><span>Cloud URL</span><input name="CloudProvision.Url" class="workspace-input" value="@Model.DefaultCloudUrl" /></label>
                                <label class="workspace-field"><span>Instance name</span><input name="CloudProvision.Name" class="workspace-input" value="@Model.SuggestedInstanceName" autocomplete="off" /></label>
                            </div>
                            <button type="submit" class="workspace-submit">@MatmonIcons.Render("cloud")<span>Connect</span></button>
                        </form>
                        <p class="setup-wizard-muted" style="margin-top:8px;">You'll confirm the link in your Matmon Cloud account, then land back here.</p>

                        <details class="setup-wizard-details" style="margin-top:14px;">
                            <summary>No cloud? Apply a license token manually (offline / air-gapped)</summary>
                            <p class="setup-wizard-muted" style="margin:8px 0;">Without the cloud you're on the <strong>@Model.License.DisplayName</strong> tier. For an air-gapped install, paste a signed license token issued by Matmon.Cloud:</p>
                            <form method="post" asp-page-handler="SetLicenseToken" class="setup-wizard-form">
                                <label class="workspace-field"><span>License token</span><textarea name="LicenseTokenInput" class="workspace-input" rows="3" placeholder="Paste the signed token…"></textarea></label>
                                <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("check")<span>Apply license</span></button>
                            </form>
                        </details>
                    }
                    break;

                case "restore":
                    <h2 class="section-title">@MatmonIcons.Render("download")<span>Restore from a cloud backup</span></h2>
                    @if (!Model.CloudConnected)
                    {
                        <p>Restoring a previous configuration needs the cloud link. <a href="@StepUrl("cloud")">Connect to Matmon.Cloud</a> first, or skip this step if you're setting up fresh.</p>
                    }
                    else if (!Model.AccountBackupsAvailable)
                    {
                        <p class="setup-wizard-muted">@MatmonIcons.Render("cloud") Couldn't reach Matmon.Cloud to list your backups right now. Skip this step - you can always restore later from <a href="/Config?tab=backup" target="_blank" rel="noopener">System → Cloud → Backup ↗</a>.</p>
                    }
                    else if (Model.AccountBackups.Count == 0)
                    {
                        <p class="setup-wizard-muted">@MatmonIcons.Render("check") No backups on your cloud account yet. Nothing to restore - carry on setting up. (Once any of your instances stores a cloud backup, it'll appear here for disaster recovery.)</p>
                    }
                    else
                    {
                        <p>Bring this fresh instance back from a backup on your cloud account - handy when you're re-installing a dead instance. Only the <strong>configuration</strong> is restored (no telemetry, and your new admin account is kept).</p>
                        <ul class="setup-wizard-tree">
                            @foreach (var backup in Model.AccountBackups)
                            {
                                var encrypted = backup.Label.Contains("(encrypted)", StringComparison.OrdinalIgnoreCase);
                                <li class="setup-wizard-restore-item">
                                    <form method="post" asp-page-handler="RestoreFromCloud" class="setup-wizard-form" onsubmit="return confirm('Restore this backup? It overwrites the current configuration (your admin account is kept).');">
                                        <input type="hidden" name="backupId" value="@backup.Id" />
                                        <div class="setup-wizard-restore-head">
                                            @MatmonIcons.Render("cloud")
                                            <span><strong>@backup.InstanceName</strong> · @backup.CreatedUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · @backup.Label</span>
                                        </div>
                                        @if (encrypted)
                                        {
                                            <label class="workspace-field"><span>Passphrase</span><input type="password" name="passphrase" class="workspace-input" placeholder="Required - this backup is encrypted" autocomplete="off" /></label>
                                        }
                                        <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("download")<span>Restore this backup</span></button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    break;

                case "notifications":
                    <h2 class="section-title">@MatmonIcons.Render("bell")<span>Get notified</span></h2>
                    @if (Model.CloudConnected)
                    {
                        @if (Model.CloudRelayEnabled)
                        {
                            <p class="setup-wizard-muted">@MatmonIcons.Render("check") Alerts are delivered through <strong>Matmon.Cloud</strong> - no mail server of your own required. Pick recipients per rule under <a href="/notifications" target="_blank" rel="noopener">Notifications ↗</a>.</p>
                            <form method="post" asp-page-handler="EnableCloudRelay" class="setup-wizard-form">
                                <input type="hidden" name="enable" value="false" />
                                <button type="submit" class="workspace-secondary-submit">Turn cloud delivery off</button>
                            </form>
                        }
                        else
                        {
                            <p>You're connected to Matmon.Cloud, so alert e-mail can go out through the cloud gateway - the simplest option, no SMTP server needed.</p>
                            <form method="post" asp-page-handler="EnableCloudRelay" class="setup-wizard-form">
                                <input type="hidden" name="enable" value="true" />
                                <button type="submit" class="workspace-submit">@MatmonIcons.Render("cloud")<span>Deliver alerts via Matmon.Cloud</span></button>
                            </form>
                        }
                        <details class="setup-wizard-details" style="margin-top:14px;">
                            <summary>Use your own SMTP server instead</summary>
                            @await Html.PartialAsync("_WizardSmtpForm", Model)
                        </details>
                    }
                    else
                    {
                        <p>Set up e-mail alerts on Warning/Critical. (Connect Matmon.Cloud in the previous step to skip this and relay alerts through the cloud instead.)</p>
                        @if (Model.EmailConfigured)
                        {
                            <p class="setup-wizard-muted">@MatmonIcons.Render("check") E-mail is configured. Manage it in <a href="/notifications" target="_blank" rel="noopener">Notifications ↗</a>.</p>
                        }
                        else
                        {
                            @await Html.PartialAsync("_WizardSmtpForm", Model)
                        }
                    }
                    break;

                case "structure":
                    <h2 class="section-title">@MatmonIcons.Render("folder")<span>Organize &amp; scope your monitoring</span></h2>
                    <p>Create a starter folder structure, and tell this node which networks it may scan.</p>

                    <h3 class="setup-wizard-subhead">Folders</h3>
                    <p class="setup-wizard-muted" style="margin-top:0;">This starter structure - only the missing folders are created, existing ones are left as they are.</p>
                    <ul class="setup-wizard-tree">
                        @foreach (var folder in Model.StarterFolders)
                        {
                            <li class="setup-wizard-folder@(folder.Depth > 0 ? " is-child" : string.Empty)@(folder.Exists ? " is-done" : string.Empty)">
                                <span class="setup-wizard-tree-item">@(folder.Exists ? MatmonIcons.Render("check") : MatmonIcons.Render("folder"))<span>@folder.Label</span></span>
                                @if (folder.Exists)
                                {
                                    <span class="setup-wizard-folder-tag">exists</span>
                                }
                            </li>
                        }
                    </ul>
                    @if (Model.AllFoldersExist)
                    {
                        <button type="button" class="workspace-submit setup-wizard-open" disabled>@MatmonIcons.Render("check")<span>All folders exist</span></button>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="CreateStructure">
                            <button type="submit" class="workspace-submit setup-wizard-open">@MatmonIcons.Render("plus")<span>Create @Model.MissingFolderCount missing folder@(Model.MissingFolderCount == 1 ? string.Empty : "s")</span></button>
                        </form>
                    }

                    <h3 class="setup-wizard-subhead" style="margin-top:18px;">Networks</h3>
                    @if (Model.ConfiguredSubnets.Count > 0)
                    {
                        <ul class="setup-wizard-chips">
                            @foreach (var net in Model.ConfiguredSubnets)
                            {
                                <li class="tree-tag setup-wizard-net">
                                    @MatmonIcons.Render("network")<span>@net</span>
                                    <form method="post" asp-page-handler="RemoveNetwork">
                                        <input type="hidden" name="cidr" value="@net" />
                                        <button type="submit" class="setup-wizard-net-remove" aria-label="Remove @net" title="Remove">@MatmonIcons.Render("x")</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="setup-wizard-muted">No subnets configured yet.</p>
                    }
                    <form method="post" asp-page-handler="AddNetwork" class="setup-wizard-add">
                        <input type="text" name="cidr" class="workspace-input" placeholder="e.g. 192.168.1.0/24" autocomplete="off" />
                        <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Add</span></button>
                    </form>
                    @if (Model.SuggestedNetworks.Count > 0)
                    {
                        <p class="setup-wizard-muted">Detected - click to add:</p>
                        <div class="setup-wizard-suggestions">
                            @foreach (var net in Model.SuggestedNetworks)
                            {
                                <form method="post" asp-page-handler="AddNetwork">
                                    <input type="hidden" name="cidr" value="@net" />
                                    <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("plus")<span>@net</span></button>
                                </form>
                            }
                        </div>
                    }
                    break;

                case "discovery":
                    <h2 class="section-title">@MatmonIcons.Render("search")<span>Find your devices</span></h2>
                    <p>Scan the networks from the previous step, and (optionally) add remote probes for other sites.</p>

                    <h3 class="setup-wizard-subhead">Discovery scan</h3>
                    @if (Model.ConfiguredSubnets.Count > 0)
                    {
                        <ul class="setup-wizard-chips">
                            @foreach (var net in Model.ConfiguredSubnets)
                            {
                                <li class="tree-tag">@MatmonIcons.Render("network")<span>@net</span></li>
                            }
                        </ul>
                        <form method="post" asp-page-handler="StartDiscovery">
                            <button type="submit" class="workspace-submit setup-wizard-open">@MatmonIcons.Render("search")<span>Start a scan</span></button>
                        </form>
                        <p class="setup-wizard-muted"><a href="/Discovery" target="_blank" rel="noopener">Open Discovery ↗</a> to import what's found.</p>
                    }
                    else
                    {
                        <p class="setup-wizard-muted">No networks yet - add a subnet in the previous step (Structure &amp; networks) first.</p>
                        <a class="workspace-secondary-submit setup-wizard-open" href="/setup/wizard?step=structure">@MatmonIcons.Render("arrow-left")<span>Back to networks</span></a>
                    }

                    <h3 class="setup-wizard-subhead" style="margin-top:18px;">Remote probes</h3>
                    <p class="setup-wizard-muted" style="margin-top:0;">Optional - monitor another site or devices behind NAT. The probe connects outbound to this server.</p>
                    @if (Model.RemoteProbes.Count > 0)
                    {
                        <p class="setup-wizard-muted">@MatmonIcons.Render("check") @Model.RemoteProbes.Count remote probe@(Model.RemoteProbes.Count == 1 ? string.Empty : "s") already added. Deploy each with its command (replace <code>@primaryUrl</code> with an address the probe can reach):</p>
                        @foreach (var probe in Model.RemoteProbes)
                        {
                            <div class="setup-wizard-probe">
                                <strong class="setup-wizard-tree-item">@MatmonIcons.Render("probe")<span>@probe.Name</span></strong>
                                <pre class="setup-wizard-code">docker run -d \
  -e Matmon__Mode=Secondary \
  -e Matmon__ProbeId=@probe.ProbeId \
  -e Matmon__ProbeToken=@probe.Token \
  -e Matmon__PrimaryUrl=@primaryUrl \
  ghcr.io/real-ttx/matmon:latest</pre>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="setup-wizard-muted">No remote probes yet - add one below to get its deploy command.</p>
                    }
                    <form method="post" asp-page-handler="CreateProbe" class="setup-wizard-add">
                        <input type="text" name="name" class="workspace-input" placeholder="Probe name, e.g. Branch office" autocomplete="off" />
                        <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create probe</span></button>
                    </form>
                    break;

                case "twofactor":
                    <h2 class="section-title">@MatmonIcons.Render("lock")<span>Secure your account</span></h2>
                    @if (Model.TwoFactorEnabled)
                    {
                        <p class="setup-wizard-muted">@MatmonIcons.Render("check") Two-factor authentication is enabled. Manage it on your <a href="/Account" target="_blank" rel="noopener">Account ↗</a>.</p>
                    }
                    else if (Model.Enrollment is not null)
                    {
                        <p>Scan this QR code with your authenticator app (or enter the key), then type the 6-digit code to turn on two-factor.</p>
                        <div class="setup-wizard-2fa" style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;">
                            <div class="setup-wizard-qr" style="width:168px;height:168px;">@Html.Raw(Model.QrSvg)</div>
                            <p class="setup-wizard-muted">Manual key:<br /><code>@Model.Enrollment.SecretBase32</code></p>
                        </div>
                        <form method="post" asp-page-handler="ConfirmTotp" class="setup-wizard-add">
                            <input type="text" name="TotpCode" class="workspace-input" placeholder="123456" inputmode="numeric" autocomplete="one-time-code" />
                            <button type="submit" class="workspace-submit">@MatmonIcons.Render("check")<span>Enable</span></button>
                        </form>
                    }
                    else
                    {
                        <p>Add a second factor (an authenticator app) so a stolen password alone can't sign in. Optional, but recommended for the admin account.</p>
                        <form method="post" asp-page-handler="StartTotp">
                            <button type="submit" class="workspace-submit setup-wizard-open">@MatmonIcons.Render("lock")<span>Set up two-factor</span></button>
                        </form>
                    }
                    break;

                case "done":
                    <h2 class="section-title">@MatmonIcons.Render("check")<span>You're all set</span></h2>
                    <p>Matmon is ready. Revisit any of these from the menu anytime.</p>
                    break;
            }
        </div>

        <div class="setup-wizard-actions">
            @if (Model.PrevStep is not null)
            {
                <a class="workspace-secondary-submit" href="@StepUrl(Model.PrevStep)">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
            }
            <span class="setup-wizard-actions-spacer"></span>
            @if (Model.Step == "welcome")
            {
                <a class="workspace-submit" href="@StepUrl(Model.NextStep)"><span>Get started</span>@MatmonIcons.Render("arrow-right")</a>
            }
            else if (Model.Step == "done")
            {
                <a class="workspace-submit" href="/"><span>Go to dashboard</span>@MatmonIcons.Render("arrow-right")</a>
            }
            else
            {
                <a class="workspace-secondary-submit" href="@StepUrl(Model.NextStep)"><span>Skip</span></a>
                <a class="workspace-submit" href="@StepUrl(Model.NextStep)"><span>Continue</span>@MatmonIcons.Render("arrow-right")</a>
            }
        </div>
    </div>
</section>

@page "/Maps/Edit"
@model MapEditorModel
@{
    ViewData["Title"] = Model.IsCreateMode ? "New Map" : $"Edit {Model.Input.Name}";
    var logicalSize = MonitoringMap.LogicalSizeFor(Model.Input.AspectRatioWidth, Model.Input.AspectRatioHeight);
}

<section class="dashboard-shell maps-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("dashboard")
            <h1>@(Model.IsCreateMode ? "New Map" : "Edit Map")</h1>
        </div>
        <div class="page-actions">
            <a class="workspace-secondary-submit" asp-page="/Maps" asp-route-mapId="@Model.Input.Id">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="workspace-banner workspace-banner-error">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <span>@error.ErrorMessage</span>
            }
        </div>
    }

    <form method="post" class="map-editor-form" data-map-designer-form>
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="Input.PublicEnabled" data-map-public-enabled />
        <input type="hidden" asp-for="Input.ShowSlideHeaders" data-map-show-slide-headers />
        <script type="application/json" data-map-constraints>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TileConstraintsJson))</script>
        <div class="icon-picker-modal" data-icon-picker-modal hidden>
            <div class="icon-picker-backdrop" data-icon-picker-close></div>
            <div class="icon-picker-dialog" role="dialog" aria-modal="true" aria-label="Choose icon">
                <div class="icon-picker-head">
                    <div class="icon-picker-search">
                        @MatmonIcons.Render("search")
                        <input type="text" class="form-control workspace-input" placeholder="Search icons…" data-icon-picker-search autocomplete="off" />
                    </div>
                    <button type="button" class="workspace-secondary-submit" data-icon-picker-close aria-label="Close">@MatmonIcons.Render("x")</button>
                </div>
                <div class="icon-picker-grid" data-icon-picker-grid>
                    <button type="button" class="icon-picker-cell is-clear" data-icon-key="" data-icon-search="auto default none clear">
                        <span class="icon-picker-glyph">@MatmonIcons.Render("square")</span>
                        <span class="icon-picker-name">Auto</span>
                    </button>
                    @foreach (var iconKey in Matmon.Host.Ui.MatmonIcons.Keys)
                    {
                        <button type="button" class="icon-picker-cell" data-icon-key="@iconKey" data-icon-search="@iconKey">
                            <span class="icon-picker-glyph">@MatmonIcons.Render(iconKey)</span>
                            <span class="icon-picker-name">@iconKey</span>
                        </button>
                    }
                </div>
                <div class="icon-picker-empty" data-icon-picker-empty hidden>No matching icons.</div>
            </div>
        </div>

        <section class="panel map-editor-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("move")<span>Designer</span></h2>
                <span class="panel-hint">Drag from the toolbox, select map title or tile, edit properties</span>
            </div>

            <div class="map-editor-toolbar">
                <div class="map-slide-strip" data-map-slide-strip>
                    <div class="map-slide-tabs" data-map-slide-tabs>
                        @for (var slideIndex = 0; slideIndex < Model.Input.Slides.Count; slideIndex++)
                        {
                            var slide = Model.Input.Slides[slideIndex];
                            <button type="button" class="map-slide-tab @(slideIndex == 0 ? "is-active" : "")" data-map-slide-tab data-slide-id="@slide.Id"
                                    data-slide-title="@slide.Title" data-slide-subtitle="@slide.Subtitle"
                                    data-slide-duration="@slide.DurationSeconds" data-slide-bg="@slide.BackgroundColor"
                                    data-slide-show-header="@(slide.ShowHeader ? "true" : "false")">@slide.Name</button>
                        }
                    </div>
                    <div class="map-slide-actions">
                        <button type="button" class="map-slide-action" data-map-slide-add title="Add slide">@MatmonIcons.Render("plus")<span>Slide</span></button>
                        <button type="button" class="map-slide-action" data-map-slide-rename title="Rename current slide">@MatmonIcons.Render("pencil")</button>
                        <button type="button" class="map-slide-action map-slide-action-danger" data-map-slide-delete title="Delete current slide">@MatmonIcons.Render("trash")</button>
                    </div>
                    <div data-map-slide-inputs hidden></div>
                </div>

                <label class="map-editor-scale" title="Zoom the design canvas">
                    <span class="workspace-label">Zoom</span>
                    <input type="range" min="0.5" max="2" step="0.1" value="1" class="map-scale-range" data-map-scale />
                    <span class="map-scale-output" data-map-scale-output>100%</span>
                </label>
            </div>

            <div class="map-designer-shell">
                <aside class="map-toolbox" aria-label="Map toolbox">
                    <div class="map-designer-side-title">
                        @MatmonIcons.Render("spark")
                        <strong>Toolbox</strong>
                    </div>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Element" data-map-tool-title="State">
                        @MatmonIcons.Render("sensor")
                        <span><strong>State</strong><small>One sensor, host, folder or probe</small></span>
                    </button>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Value" data-map-tool-title="Value">
                        @MatmonIcons.Render("square")
                        <span><strong>Value</strong><small>Large default channel value</small></span>
                    </button>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Graph" data-map-tool-title="Graph">
                        @MatmonIcons.Render("chart")
                        <span><strong>Graph</strong><small>Sensor trend sparkline</small></span>
                    </button>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Status" data-map-tool-title="Summary">
                        @MatmonIcons.Render("dashboard")
                        <span><strong>Summary</strong><small>Aggregated health below a target</small></span>
                    </button>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Value" data-map-tool-title="Gauge" data-map-tool-visual="@MonitoringMapTileVisualType.Gauge">
                        @MatmonIcons.Render("chart")
                        <span><strong>Gauge</strong><small>Radial gauge of a percent channel</small></span>
                    </button>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Value" data-map-tool-title="Progress" data-map-tool-visual="@MonitoringMapTileVisualType.ProgressBar">
                        @MatmonIcons.Render("signal")
                        <span><strong>Progress</strong><small>Progress bar of a percent channel</small></span>
                    </button>
                    <button type="button" class="map-tool-button" draggable="true" data-map-tool-kind="@MonitoringMapTileKind.Text" data-map-tool-title="Text">
                        @MatmonIcons.Render("list")
                        <span><strong>Text</strong><small>Label, notes or instructions</small></span>
                    </button>
                </aside>

                <div class="map-designer-workbench">
                    <button type="button" class="map-designer-map-title" data-map-select-map>
                        <span class="map-designer-map-title-icon">@MatmonIcons.Render("dashboard")</span>
                        <span>
                            <strong data-map-title-preview>@Model.Input.Name</strong>
                            <small data-map-description-preview>@(string.IsNullOrWhiteSpace(Model.Input.Description) ? "No description" : Model.Input.Description)</small>
                        </span>
                        <em data-map-grid-preview>@Model.Input.AspectRatioWidth:@Model.Input.AspectRatioHeight canvas</em>
                    </button>

                    <div class="map-stage" data-map-stage data-map-fit="fit" style="--map-w: @logicalSize.Width; --map-h: @logicalSize.Height;">
                        <div class="map-slide map-slide-editable"
                             data-map-slide
                             data-map-designer
                             data-next-tile-index="@Model.Input.Tiles.Count"
                             style="--map-w: @logicalSize.Width; --map-h: @logicalSize.Height;">
                            @for (var index = 0; index < Model.TileRenderModels.Count; index++)
                            {
                                <partial name="_MapTile" model="Model.TileRenderModels[index]" />
                            }
                        </div>
                    </div>
                </div>

                <aside class="map-property-editor" aria-label="Tile properties">
                    <div class="map-designer-side-title">
                        @MatmonIcons.Render("gear")
                        <strong>Properties</strong>
                    </div>
                    <section class="map-property-panel map-property-map-panel" data-map-property-map-panel>
                        <label class="workspace-field">
                            <span class="workspace-label">Name</span>
                            <input asp-for="Input.Name" class="form-control workspace-input" data-map-name />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Description</span>
                            <input asp-for="Input.Description" class="form-control workspace-input" data-map-description />
                        </label>
                        <div class="workspace-field">
                            <span class="workspace-label">Aspect ratio</span>
                            <div class="map-aspect-presets">
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="16" data-aspect-h="9">16:9</button>
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="16" data-aspect-h="10">16:10</button>
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="21" data-aspect-h="9">21:9</button>
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="4" data-aspect-h="3">4:3</button>
                            </div>
                            <div class="map-aspect-custom">
                                <input asp-for="Input.AspectRatioWidth" type="number" min="1" max="64" class="form-control workspace-input" data-map-aspect-w aria-label="Aspect ratio width" />
                                <span class="map-aspect-colon">:</span>
                                <input asp-for="Input.AspectRatioHeight" type="number" min="1" max="64" class="form-control workspace-input" data-map-aspect-h aria-label="Aspect ratio height" />
                            </div>
                            <span class="workspace-inline-note">Only the ratio matters — the board scales to any screen. Tiles keep their logical-pixel position/size (a fixed 1920px-wide canvas) regardless of ratio.</span>
                        </div>
                        <label class="workspace-field">
                            <span class="workspace-label">Wallboard fit</span>
                            <select asp-for="Input.WallboardFit" class="form-select workspace-select">
                                <option value="@MonitoringMapWallboardFit.Fit">Keep ratio (letterbox)</option>
                                <option value="@MonitoringMapWallboardFit.Stretch">Stretch to fill screen</option>
                            </select>
                        </label>
                        <div class="map-property-section">
                            <span class="workspace-label">Wallboard</span>
                            <label class="workspace-field">
                                <span class="workspace-label">Auto-rotate (seconds per slide)</span>
                                <input asp-for="Input.AutoRotateSeconds" type="number" min="3" max="600" class="form-control workspace-input" />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Page indicator</span>
                                <select asp-for="Input.PaginationMode" class="form-select workspace-select">
                                    <option value="@MonitoringMapPaginationMode.Below">Below the board</option>
                                    <option value="@MonitoringMapPaginationMode.OverlayAlways">Overlay - always visible</option>
                                    <option value="@MonitoringMapPaginationMode.OverlayOnActivity">Overlay - on mouse-move / change</option>
                                    <option value="@MonitoringMapPaginationMode.Hidden">Hidden (auto-rotate only)</option>
                                </select>
                            </label>
                            <div class="map-property-hint">
                                Auto-rotate &amp; the page indicator are used by the public wallboard with more than one slide. The in-app viewer stays on manual controls.
                            </div>
                        </div>
                        <div class="map-property-hint">
                            This edits the map itself. Click a tile to switch the property editor to that control.
                        </div>
                    </section>
                    <div class="map-property-empty" data-map-property-empty hidden>
                        Select the map title or a tile to edit its properties.
                    </div>
                    <div data-map-property-host>
                        @for (var index = 0; index < Model.Input.Tiles.Count; index++)
                        {
                            var tile = Model.Input.Tiles[index];
                            <section class="map-property-panel" data-map-property-panel data-tile-index="@index" hidden>
                                <label class="workspace-field">
                                    <span class="workspace-label">Title</span>
                                    <input asp-for="Input.Tiles[index].Title" class="form-control workspace-input" data-map-property-title />
                                </label>
                                <div class="workspace-field">
                                    <span class="workspace-label">Tile type</span>
                                    <input type="hidden" asp-for="Input.Tiles[index].Kind" data-map-property-kind />
                                    <input type="hidden" asp-for="Input.Tiles[index].VisualType" data-map-property-visual-type />
                                    <span class="map-property-readonly" data-map-property-kind-label>@MapTileRender.KindLabel(tile.Kind)</span>
                                </div>
                                <label class="workspace-field" data-map-property-target>
                                    <span class="workspace-label">Target</span>
                                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = $"Input.Tiles[{index}].TargetToken", DomId = $"picker-map-tile-{index}", SelectedValue = Model.Input.Tiles[index].TargetToken, AllowTags = true, Placeholder = "No element", Options = Model.TilePickerOptions, ValueAttribute = "data-map-property-element" })" />
                                </label>
                                <label class="workspace-field" data-map-property-text-only>
                                    <span class="workspace-label">Text</span>
                                    <textarea asp-for="Input.Tiles[index].Text" class="form-control workspace-input" rows="4" data-map-property-text></textarea>
                                </label>
                                <label class="workspace-field" data-map-property-graph-only>
                                    <span class="workspace-label">Graph type</span>
                                    <select asp-for="Input.Tiles[index].GraphType" asp-items="Model.GraphTypeOptions" class="form-select workspace-select" data-map-property-graph-type></select>
                                </label>
                                <div class="map-property-section">
                                    <span class="workspace-label">Appearance</span>
                                    <div class="workspace-field icon-picker-field">
                                        <span class="workspace-label">Icon</span>
                                        <input type="hidden" asp-for="Input.Tiles[index].IconKey" data-map-property-icon data-icon-picker-value />
                                        <button type="button" class="form-control workspace-input icon-picker-trigger" data-icon-picker-trigger>
                                            <span class="icon-picker-trigger-glyph" data-icon-picker-trigger-glyph>@MatmonIcons.Render(string.IsNullOrWhiteSpace(tile.IconKey) ? "square" : tile.IconKey)</span>
                                            <span class="icon-picker-trigger-label" data-icon-picker-trigger-label>@(string.IsNullOrWhiteSpace(tile.IconKey) ? "Auto (by type)" : tile.IconKey)</span>
                                            <span class="icon-picker-trigger-caret" aria-hidden="true">▾</span>
                                        </button>
                                    </div>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Background</span>
                                        <input asp-for="Input.Tiles[index].BackgroundColor" class="form-control workspace-input" placeholder="auto or #101827" data-map-property-background />
                                    </label>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Accent</span>
                                        <input asp-for="Input.Tiles[index].AccentColor" class="form-control workspace-input" placeholder="auto or #78d5c8" data-map-property-accent />
                                    </label>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Text color</span>
                                        <input asp-for="Input.Tiles[index].TextColor" class="form-control workspace-input" placeholder="auto or #ffffff" data-map-property-text-color />
                                    </label>
                                </div>
                                <div class="map-property-checks">
                                    <label><input asp-for="Input.Tiles[index].ShowCard" data-map-property-show-card /> <span>Card background</span></label>
                                    <label><input asp-for="Input.Tiles[index].ShowTitle" data-map-property-show-title /> <span>Show title</span></label>
                                    <label><input asp-for="Input.Tiles[index].ShowStateBadge" data-map-property-show-badge /> <span>Show state badge</span></label>
                                    <label><input asp-for="Input.Tiles[index].ShowElementName" /> <span>Show target name</span></label>
                                </div>
                                <input asp-for="Input.Tiles[index].Width" type="hidden" data-map-tile-width />
                                <input asp-for="Input.Tiles[index].Height" type="hidden" data-map-tile-height />
                                <div class="map-property-size-readout" data-map-property-size>Size @tile.Width &times; @tile.Height px</div>
                                <div class="map-property-hint" data-map-property-hint></div>
                            </section>
                        }
                    </div>
                </aside>
            </div>

            <template data-map-tile-template>
                <article class="map-tile map-tile-editor"
                         data-map-tile
                         data-tile-index="__index__"
                         data-slide-id="__slideId__"
                         data-tile-id="__id__"
                         data-state="unknown"
                         data-kind="__kind__"
                         data-visual="__visual__"
                         style="--tile-x: __x__; --tile-y: __y__; --tile-w: __w__; --tile-h: __h__;">
                    <input type="hidden" name="Input.Tiles[__index__].Id" value="__id__" />
                    <input type="hidden" name="Input.Tiles[__index__].SlideId" value="__slideId__" data-map-tile-slide-id />
                    <input type="hidden" name="Input.Tiles[__index__].IsDeleted" value="false" data-map-tile-deleted />
                    <input type="hidden" name="Input.Tiles[__index__].X" value="__x__" data-map-tile-x />
                    <input type="hidden" name="Input.Tiles[__index__].Y" value="__y__" data-map-tile-y />

                    <div class="map-tile-head map-tile-drag-handle" data-map-drag-handle>
                        <span class="map-tile-icon">@MatmonIcons.Render("square")</span>
                        <strong data-tile-title>__title__</strong>
                        <button type="button" class="map-tile-remove" data-map-remove-tile aria-label="Remove tile">@MatmonIcons.Render("trash")</button>
                    </div>
                    <p data-tile-subtitle>No target selected</p>
                    <small data-map-tile-kind-label>__kindLabel__</small>
                    <span class="map-tile-size-badge" data-map-tile-size-badge aria-hidden="true">__w__ × __h__</span>
                    <span class="map-tile-resize-handle" data-map-resize-handle aria-hidden="true"></span>
                </article>
                <section class="map-property-panel" data-map-property-panel data-tile-index="__index__" hidden>
                    <label class="workspace-field">
                        <span class="workspace-label">Title</span>
                        <input name="Input.Tiles[__index__].Title" value="__title__" class="form-control workspace-input" data-map-property-title />
                    </label>
                    <div class="workspace-field">
                        <span class="workspace-label">Tile type</span>
                        <input type="hidden" name="Input.Tiles[__index__].Kind" value="__kind__" data-map-property-kind />
                        <input type="hidden" name="Input.Tiles[__index__].VisualType" value="__visual__" data-map-property-visual-type />
                        <span class="map-property-readonly" data-map-property-kind-label>__kindLabel__</span>
                    </div>
                    <label class="workspace-field" data-map-property-target>
                        <span class="workspace-label">Target</span>
                        <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "Input.Tiles[__index__].TargetToken", DomId = "picker-map-tile-__index__", SelectedValue = null, AllowTags = true, Placeholder = "No element", Options = Model.TilePickerOptions, ValueAttribute = "data-map-property-element" })" />
                    </label>
                    <label class="workspace-field" data-map-property-text-only>
                        <span class="workspace-label">Text</span>
                        <textarea name="Input.Tiles[__index__].Text" class="form-control workspace-input" rows="4" data-map-property-text></textarea>
                    </label>
                    <label class="workspace-field" data-map-property-graph-only>
                        <span class="workspace-label">Graph type</span>
                        <select name="Input.Tiles[__index__].GraphType" class="form-select workspace-select" data-map-property-graph-type>
                            <option value="@MonitoringMapTileGraphType.Line">Line</option>
                            <option value="@MonitoringMapTileGraphType.Area">Area</option>
                            <option value="@MonitoringMapTileGraphType.Bars">Bars</option>
                            <option value="@MonitoringMapTileGraphType.Smooth">Smooth</option>
                        </select>
                    </label>
                    <div class="map-property-section">
                        <span class="workspace-label">Appearance</span>
                        <div class="workspace-field icon-picker-field">
                            <span class="workspace-label">Icon</span>
                            <input type="hidden" name="Input.Tiles[__index__].IconKey" value="" data-map-property-icon data-icon-picker-value />
                            <button type="button" class="form-control workspace-input icon-picker-trigger" data-icon-picker-trigger>
                                <span class="icon-picker-trigger-glyph" data-icon-picker-trigger-glyph>@MatmonIcons.Render("square")</span>
                                <span class="icon-picker-trigger-label" data-icon-picker-trigger-label>Auto (by type)</span>
                                <span class="icon-picker-trigger-caret" aria-hidden="true">▾</span>
                            </button>
                        </div>
                        <label class="workspace-field">
                            <span class="workspace-label">Background</span>
                            <input name="Input.Tiles[__index__].BackgroundColor" class="form-control workspace-input" placeholder="auto or #101827" data-map-property-background />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Accent</span>
                            <input name="Input.Tiles[__index__].AccentColor" class="form-control workspace-input" placeholder="auto or #78d5c8" data-map-property-accent />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Text color</span>
                            <input name="Input.Tiles[__index__].TextColor" class="form-control workspace-input" placeholder="auto or #ffffff" data-map-property-text-color />
                        </label>
                    </div>
                    <div class="map-property-checks">
                        <label><input name="Input.Tiles[__index__].ShowCard" type="hidden" value="false" /><input name="Input.Tiles[__index__].ShowCard" type="checkbox" value="true" checked data-map-property-show-card /> <span>Card background</span></label>
                        <label><input name="Input.Tiles[__index__].ShowTitle" type="hidden" value="false" /><input name="Input.Tiles[__index__].ShowTitle" type="checkbox" value="true" checked data-map-property-show-title /> <span>Show title</span></label>
                        <label><input name="Input.Tiles[__index__].ShowStateBadge" type="hidden" value="false" /><input name="Input.Tiles[__index__].ShowStateBadge" type="checkbox" value="true" checked data-map-property-show-badge /> <span>Show state badge</span></label>
                        <label><input name="Input.Tiles[__index__].ShowElementName" type="hidden" value="false" /><input name="Input.Tiles[__index__].ShowElementName" type="checkbox" value="true" checked /> <span>Show target name</span></label>
                    </div>
                    <input name="Input.Tiles[__index__].Width" value="__w__" type="hidden" data-map-tile-width />
                    <input name="Input.Tiles[__index__].Height" value="__h__" type="hidden" data-map-tile-height />
                    <div class="map-property-size-readout" data-map-property-size>Size __w__ x __h__ px</div>
                    <div class="map-property-hint" data-map-property-hint></div>
                </section>
            </template>

            <div class="page-actions workspace-toolbar">
                <button type="submit" asp-page-handler="Save" class="workspace-submit">@MatmonIcons.Render("check")<span>Save map</span></button>
                @if (!Model.IsCreateMode)
                {
                    <span class="workspace-form-actions-spacer"></span>
                    <button type="submit" asp-page-handler="Delete" formnovalidate class="workspace-danger-submit" onclick="return confirm('Delete this map?');">@MatmonIcons.Render("trash")<span>Delete map</span></button>
                }
            </div>
        </section>
    </form>
</section>

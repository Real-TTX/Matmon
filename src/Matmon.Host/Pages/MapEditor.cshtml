@page "/Maps/Edit"
@model MapEditorModel
@{
    ViewData["Title"] = Model.IsCreateMode ? "New Map" : $"Edit {Model.Input.Name}";
    ViewData["Width"] = "wide";

    string WindowLabel(int hours) => hours switch
    {
        1 => "Last hour",
        72 => "Last 3 days",
        168 => "Last 7 days (averages)",
        336 => "Last 14 days (averages)",
        _ => $"Last {hours} hours"
    };

    // Ids in ASP.NET's own shape - Input_Tiles_<n>__<Field>, exactly what asp-for generates - so the designer's
    // slide duplication, which rewrites "Input_Tiles_<n>__", gives every cloned field and label its own id. In
    // the <template> the index is "__index__", which the designer replaces like every other occurrence:
    // "Input_Tiles___index____Title" becomes "Input_Tiles_7__Title".
    string TileId(int index) => $"Input_Tiles_{index}__";
    const string TemplateTileId = "Input_Tiles___index____";

    // The stored value is folded into the option list: a select can only post one of its own options, so a board
    // saved at 25 s would have been silently rewritten to the first entry the moment anything else on this page
    // was saved.
    var rotationChoices = new[] { 5, 10, 15, 20, 30, 45, 60, 120, 300 }
        .Append(Model.Input.AutoRotateSeconds).Distinct().OrderBy(value => value).ToArray();
}

@* Only VIEW actions up here. Back / Save / Delete belong to the form and sit in its one action row at the foot. *@
@section TopbarActions {
    @if (!Model.IsCreateMode)
    {
        <div class="mat-topbar__actions">
            <a class="mat-btn mat-btn--ghost mat-btn--icon" asp-page="/Maps" asp-route-mapId="@Model.Input.Id" target="_blank" rel="noopener" aria-label="Preview the saved board in a new tab" data-tip="Preview">@MatUi.Icon("eye")</a>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-map-fullscreen aria-label="Show the canvas full screen" data-tip="Full screen">@MatUi.Icon("tv")</button>
        </div>
    }
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="mat-alert mat-alert--danger" role="alert">
        @MatUi.Icon("x-circle")
        <div class="mat-alert__body">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    </div>
}

<form method="post" id="map-editor-form" class="mat-form map-editor-form" data-map-designer-form novalidate>
    <input type="hidden" asp-for="Input.Id" />
    <script type="application/json" data-map-designer-config>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DesignerConfigJson))</script>

    @* The icon picker: one shared dialog for every tile panel, driven by initializeIconPicker (pickers.js), which
       shows and hides it through its hidden attribute; the designer bridges that to MatUi's dialog (open, focus,
       Escape, the scroll lock). *@
    <dialog class="mat-dialog mat-dialog--lg" id="map-icon-picker" aria-labelledby="map-icon-picker-title" data-icon-picker-modal>
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @MatUi.Icon("image")
                <h2 class="mat-dialog__title" id="map-icon-picker-title">Choose an icon</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close data-icon-picker-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-stack">
                <div class="mat-input-icon">
                    @MatUi.Icon("search")
                    <input type="search" class="mat-input" placeholder="Search icons…" data-icon-picker-search autocomplete="off" aria-label="Search icons" autofocus />
                </div>
                <div class="icon-picker-grid" data-icon-picker-grid>
                    <button type="button" class="icon-picker-cell is-clear" data-icon-key="" data-icon-search="auto default none clear">
                        <span class="icon-picker-glyph">@MatmonIcons.Render("square")</span>
                        <span class="icon-picker-name">Auto</span>
                    </button>
                    @foreach (var iconKey in Matmon.Host.Ui.MatmonIcons.Keys)
                    {
                        <button type="button" class="icon-picker-cell" data-icon-key="@iconKey" data-icon-search="@iconKey">
                            <span class="icon-picker-glyph">@MatmonIcons.Render(iconKey)</span>
                            <span class="icon-picker-name">@iconKey</span>
                        </button>
                    }
                </div>
                <p class="mat-muted icon-picker-empty" data-icon-picker-empty hidden>No matching icons.</p>
            </div>
        </div>
    </dialog>

    @* Three tabs, one per object you can edit: the working surface, the slides, the board. data-tabs sits on the
       tab list itself rather than around the panels, so a tab-like control INSIDE a panel (the element picker's
       mode switch, ...) can never be taken for one of these. *@
    <div class="mat-tabs" role="tablist" aria-label="Map designer" data-tabs data-tab-hash>
        <button type="button" class="mat-tab" role="tab" id="tab-editor" aria-controls="panel-editor" aria-selected="true">@MatUi.Icon("grid")<span>Editor</span></button>
        <button type="button" class="mat-tab" role="tab" id="tab-slides" aria-controls="panel-slides" aria-selected="false" tabindex="-1">@MatUi.Icon("layers")<span>Slides</span></button>
        <button type="button" class="mat-tab" role="tab" id="tab-board" aria-controls="panel-board" aria-selected="false" tabindex="-1">@MatUi.Icon("settings")<span>Board</span></button>
    </div>

    @* --- Editor: toolbox | canvas | properties ------------------------------------------------------------ *@
    <div class="mat-tabpanel map-designer" role="tabpanel" id="panel-editor" aria-labelledby="tab-editor">
        <div class="map-designer-shell">
            @* The palette is rendered from MapWidgetCatalog, not hand-written buttons: several entries are the same
               tile Kind with a different VisualType (Gauge and Progress are both a Value tile), which is the
               distinction a user picks by and the enum cannot express. Adding a widget is one catalog entry. *@
            <aside class="map-toolbox" aria-label="Widget library">
                <h2 class="map-designer-side-title">@MatUi.Icon("sparkles")<span>Widgets</span></h2>
                <div class="mat-input-icon">
                    @MatUi.Icon("search")
                    <input type="search" class="mat-input" placeholder="Search widgets…" data-map-tool-search autocomplete="off" aria-label="Search widgets" />
                </div>
                <div class="map-toolbox-list">
                    @foreach (var group in MapWidgetCatalog.ByCategory())
                    {
                        <div class="map-toolbox-group" data-map-tool-group>
                            <span class="map-toolbox-group-label">@MapWidgetCatalog.CategoryLabel(group.Key)</span>
                            <div class="map-toolbox-group-items">
                                @foreach (var widget in group)
                                {
                                    @* A drawn preview, not a word: the description is what the entry MEANS, the
                                       schematic is what it LOOKS like, and on a wallboard the second is what you
                                       are actually choosing between. The description is the tooltip. *@
                                    <button type="button" class="map-tool-button" draggable="true"
                                            title="@widget.Description"
                                            data-map-tool-widget="@widget.Key"
                                            data-map-tool-kind="@widget.Kind"
                                            data-map-tool-title="@widget.Label"
                                            data-map-tool-visual="@widget.VisualType"
                                            data-map-tool-search="@($"{widget.Label} {widget.Description} {widget.SearchTerms}".ToLowerInvariant())">
                                        <partial name="_MapWidgetPreview" model="@MapWidgetCatalog.PreviewKey(widget)" />
                                        <span class="map-tool-label">@widget.Label</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    <p class="mat-muted map-toolbox-empty" data-map-tool-empty hidden>No matching widget.</p>
                </div>
            </aside>

            <div class="map-designer-workbench">
                @* Canvas head. The board is shown at its real size, so the only geometry facts worth stating are
                   how many columns it has and how many rows fill a screen. Clicking the title selects the board
                   itself, which is how you get back from a widget to the board. *@
                <div class="map-canvas-head">
                    <button type="button" class="map-canvas-title" data-map-select-map>
                        <strong data-map-title-preview>@Model.Input.Name</strong>
                        <small>
                            <b data-map-grid-preview>@Model.Input.Columns</b> columns
                            <span class="map-canvas-sep">|</span> <b>@Model.Input.Rows</b> rows per screen
                        </small>
                    </button>
                    @* A switcher, not a list: managing slides lives on the Slides tab, but changing slide must not
                       mean leaving the board you are drawing on. *@
                    <label class="map-canvas-slide-switch">
                        @MatUi.Icon("layers")
                        <span class="mat-sr-only">Slide</span>
                        <select class="mat-select mat-select--sm" data-map-slide-switch></select>
                    </label>
                </div>

                <div class="map-stage" data-map-stage>
                    <div class="map-slide map-slide-editable"
                         data-map-slide
                         data-map-designer
                         data-next-tile-index="@Model.Input.Tiles.Count"
                         style="--map-columns: @Model.Input.Columns; --map-rows: @Model.Input.Rows; --tile-gap: @(Model.Input.TilePadding)px; --map-margin: @(Model.Input.OuterMargin)px">
                        @* A CELL grid, laid out by the SAME grid definition as the tiles so a guide cannot drift
                           from where a tile will actually land. One screen's worth is rendered here; the designer
                           re-renders it to cover however tall the board grows. *@
                        <div class="map-grid-guides" aria-hidden="true">
                            @for (var cell = 0; cell < Math.Max(1, Model.Input.Columns) * Math.Max(1, Model.Input.Rows); cell++)
                            {
                                <span class="map-grid-cell-guide"></span>
                            }
                        </div>
                        @* An empty slide is where a layout MEANS something, so that is where it is offered -
                           rather than as cards that quietly replace whatever you had. Shown by the designer only
                           while the active slide has no widgets. *@
                        <div class="map-canvas-empty" data-map-canvas-empty hidden>
                            <strong>This slide is empty</strong>
                            <div class="map-toolbox-templates" data-map-layout-templates>
                                <span class="map-canvas-empty-title">Start from a layout</span>
                                <p class="mat-muted">Or drag a widget in from the library on the left.</p>
                                @* Thumbnails generated from the SAME slots the template applies - a hand-drawn
                                   thumbnail could disagree with it. The slots are geometry that is data, so they
                                   travel as custom properties. *@
                                <div class="map-layout-cards">
                                    @foreach (var template in MapWidgetCatalog.LayoutTemplates)
                                    {
                                        <button type="button" class="map-layout-card" data-map-layout="@template.Key"
                                                data-layout-min-columns="@template.MinColumns" data-layout-min-rows="@template.MinRows"
                                                title="@template.Description">
                                            <span class="map-layout-thumb" aria-hidden="true"
                                                  style="--thumb-cols: @template.MinColumns; --thumb-rows: @template.MinRows">
                                                @foreach (var slot in template.Slots)
                                                {
                                                    <span style="--slot-col: @slot.Column; --slot-span: @slot.ColumnSpan; --slot-row: @slot.Row; --slot-rows: @slot.RowSpan"></span>
                                                }
                                            </span>
                                            <span class="map-layout-card-meta">
                                                <strong>@template.Label</strong>
                                                <small>@template.Description</small>
                                            </span>
                                        </button>
                                    }
                                </div>
                                <p class="map-layout-warning" data-map-layout-too-small hidden>
                                    Some layouts need more columns than this board has.
                                </p>
                            </div>
                        </div>
                        @for (var index = 0; index < Model.TileRenderModels.Count; index++)
                        {
                            <partial name="_MapTile" model="Model.TileRenderModels[index]" />
                        }
                    </div>
                </div>
            </div>

            <aside class="map-property-editor" aria-label="Properties">
                <h2 class="map-designer-side-title">@MatUi.Icon("sliders")<span data-map-property-scope-label>Properties</span></h2>

                @* Tab bar for the TILE panels. It sits outside them because only one tile panel is visible at a
                   time - keeping the bar here means the chosen tab survives clicking from tile to tile. Toggle
                   buttons in MatUi's tab look, not role="tab": they switch a group inside whichever panel is
                   shown, which MatUi's tab behaviour (panels by id) cannot express. Hidden unless a tile is
                   selected. *@
                <div class="mat-tabs map-property-tabs" data-map-property-tabs role="group" aria-label="Widget properties" hidden>
                    <button type="button" class="mat-tab is-active" data-map-property-tab="general" aria-pressed="true">General</button>
                    <button type="button" class="mat-tab" data-map-property-tab="data" aria-pressed="false">Data</button>
                    <button type="button" class="mat-tab" data-map-property-tab="display" aria-pressed="false">Display</button>
                    <button type="button" class="mat-tab" data-map-property-tab="advanced" aria-pressed="false">Advanced</button>
                </div>

                @* Nothing selected: the CANVAS view settings instead of an empty box. View-only (remembered per
                   browser, never saved on the map) - the board's own geometry stays on the Board tab, so there is
                   exactly one input per stored property. *@
                <div class="map-property-empty mat-stack" data-map-property-empty>
                    <p class="mat-muted">Select a widget on the canvas to edit it.</p>
                    <div class="map-view-settings mat-stack mat-stack--sm">
                        <span class="mat-label">Canvas view</span>
                        <label class="mat-switch">
                            <input type="checkbox" checked data-map-view-grid />
                            <span class="mat-switch__track"></span>
                            <span>Show grid</span>
                        </label>
                        <label class="mat-switch">
                            <input type="checkbox" checked data-map-view-rulers />
                            <span class="mat-switch__track"></span>
                            <span>Show rulers</span>
                        </label>
                        <span class="mat-hint">This browser only.</span>
                    </div>
                </div>

                <div data-map-property-host>
                    @for (var index = 0; index < Model.Input.Tiles.Count; index++)
                    {
                        var tile = Model.Input.Tiles[index];
                        var tileId = TileId(index);
                        var iconKey = string.IsNullOrWhiteSpace(tile.IconKey) ? "square" : tile.IconKey;
                        @* Grouped into the General / Data / Display / Advanced groups the aside's
                           [data-map-property-tabs] bar drives. Every field is a direct child of its group (the
                           designer hides a tab whose group has nothing visible). Mirror any field change in the
                           <template> below. *@
                        <section class="map-property-panel" data-map-property-panel data-tile-index="@index" hidden>
                            @* What you have selected, at a glance, with its one destructive action. The designer
                               keeps icon / title / kind in step with the tile. *@
                            <header class="mat-card map-property-head">
                                <div class="mat-card__body map-property-head-body">
                                    <span class="map-property-head-icon" data-map-property-head-icon>@MatmonIcons.Render(iconKey)</span>
                                    <span class="map-property-head-text">
                                        <strong class="mat-card__title" data-map-property-head-title>@(string.IsNullOrWhiteSpace(tile.Title) ? MapTileRender.KindLabel(tile.Kind) : tile.Title)</strong>
                                        <small data-map-property-head-kind>@MapTileRender.KindLabel(tile.Kind)</small>
                                    </span>
                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-property-remove aria-label="Delete widget" data-tip="Delete widget">@MatUi.Icon("trash")</button>
                                </div>
                            </header>

                            <div class="map-prop-group" data-map-prop-group="general">
                                <div class="mat-field">
                                    <label class="mat-label" for="@(tileId)Title">Title</label>
                                    <input asp-for="Input.Tiles[index].Title" class="mat-input" data-map-property-title />
                                </div>
                                <div class="mat-field">
                                    <span class="mat-label">Widget</span>
                                    <input type="hidden" asp-for="Input.Tiles[index].Kind" data-map-property-kind />
                                    <input type="hidden" asp-for="Input.Tiles[index].VisualType" data-map-property-visual-type />
                                    <span class="map-property-readonly" data-map-property-kind-label>@MapTileRender.KindLabel(tile.Kind)</span>
                                </div>
                                @* Size is editable here, not only by dragging the handle: a number field is keyboard
                                   reachable and lets you type an exact span, and it is the SAME input the drag writes
                                   into, so the two can never disagree. *@
                                <div class="mat-form__grid map-property-pair">
                                    <div class="mat-field">
                                        <label class="mat-label" for="@(tileId)ColumnSpan">Width (columns)</label>
                                        <input asp-for="Input.Tiles[index].ColumnSpan" type="number" min="1" max="@Model.Input.Columns" class="mat-input" data-map-tile-column-span />
                                    </div>
                                    <div class="mat-field">
                                        <label class="mat-label" for="@(tileId)RowSpan">Height (rows)</label>
                                        <input asp-for="Input.Tiles[index].RowSpan" type="number" min="1" max="@MonitoringMapTileConstraints.MaxRowSpan" class="mat-input" data-map-tile-row-span />
                                    </div>
                                </div>
                                <p class="map-property-size-readout" data-map-property-size>Size @tile.ColumnSpan &times; @tile.RowSpan cells</p>
                                <p class="map-property-hint" data-map-property-hint></p>
                            </div>

                            <div class="map-prop-group" data-map-prop-group="data" hidden>
                                <div class="mat-field" data-map-property-target>
                                    <span class="mat-label">Target</span>
                                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = $"Input.Tiles[{index}].TargetToken", DomId = $"picker-map-tile-{index}", SelectedValue = Model.Input.Tiles[index].TargetToken, AllowTags = true, Placeholder = "No element", Options = Model.TilePickerOptions, ValueAttribute = "data-map-property-element" })" />
                                </div>
                                <div class="mat-field">
                                    <label class="mat-label" for="@(tileId)LinkMapId">Opens map</label>
                                    <select asp-for="Input.Tiles[index].LinkMapId" asp-items="Model.MapLinkOptions" class="mat-select">
                                        <option value="">Nothing</option>
                                    </select>
                                    <span class="mat-hint">Without a target the tile shows the worst state on that map.</span>
                                </div>
                                <div class="mat-field" data-map-property-text-only>
                                    <label class="mat-label" for="@(tileId)Text">Text</label>
                                    <textarea asp-for="Input.Tiles[index].Text" class="mat-textarea" rows="4" data-map-property-text></textarea>
                                </div>
                                <div class="mat-field" data-map-property-graph-only>
                                    <label class="mat-label" for="@(tileId)GraphType">Graph type</label>
                                    <select asp-for="Input.Tiles[index].GraphType" asp-items="Model.GraphTypeOptions" class="mat-select" data-map-property-graph-type></select>
                                </div>
                                @* The same property as the multi-graph's window (its field is in _MapCompareFields); only
                                   the field of the current kind is enabled, see syncDuplicateFields. *@
                                <div class="mat-field" data-map-property-graph-only>
                                    <label class="mat-label" for="@(tileId)GraphWindowHours_graph">Time window</label>
                                    <select id="@(tileId)GraphWindowHours_graph" name="Input.Tiles[@index].GraphWindowHours" class="mat-select">
                                        @foreach (var hours in MonitoringMapTile.GraphWindowChoices)
                                        {
                                            <option value="@hours" selected="@(hours == Model.Input.Tiles[index].GraphWindowHours)">@WindowLabel(hours)</option>
                                        }
                                    </select>
                                </div>
                                <div class="mat-field" data-map-property-list-only>
                                    <label class="mat-label" for="@(tileId)ListMode">Order</label>
                                    <select asp-for="Input.Tiles[index].ListMode" class="mat-select">
                                        <option value="@MonitoringMapListMode.Worst">Worst state first</option>
                                        <option value="@MonitoringMapListMode.TopValue">Highest value first</option>
                                        <option value="@MonitoringMapListMode.BottomValue">Lowest value first</option>
                                        <option value="@MonitoringMapListMode.Alphabetical">By name</option>
                                    </select>
                                </div>
                                @* A value / gauge / progress tile has to be told WHICH channel it shows - a host
                                   sensor reports CPU, memory, disk and SMART, and "whichever is default" is a coin
                                   toss. The scale is separate because a dial needs one: a percentage channel brings
                                   its own 0..100, anything else has to say where full is. *@
                                <div class="mat-field" data-map-property-value-only>
                                    <label class="mat-label" for="@(tileId)ChannelKey">Channel</label>
                                    <input asp-for="Input.Tiles[index].ChannelKey" class="mat-input mat-mono" placeholder="Default channel" />
                                    <span class="mat-hint">A key from the sensor's Channels tab, e.g. <code>cpu</code>. Empty = its default channel.</span>
                                </div>
                                <div class="mat-form__grid map-property-pair" data-map-property-value-only>
                                    <div class="mat-field">
                                        <label class="mat-label" for="@(tileId)GaugeMin">Scale from</label>
                                        <input asp-for="Input.Tiles[index].GaugeMin" type="number" step="any" class="mat-input" placeholder="0" />
                                    </div>
                                    <div class="mat-field">
                                        <label class="mat-label" for="@(tileId)GaugeMax">Scale to</label>
                                        <input asp-for="Input.Tiles[index].GaugeMax" type="number" step="any" class="mat-input" placeholder="100" />
                                    </div>
                                </div>
                                <p class="mat-hint" data-map-property-value-only>In the channel's own unit. Leave empty for a percentage channel; without a scale the tile shows the plain number.</p>
                                <div class="mat-field" data-map-property-list-only>
                                    <label class="mat-label" for="@(tileId)ListChannelKey_rank">Rank by channel</label>
                                    <input asp-for="Input.Tiles[index].ListChannelKey" id="@(tileId)ListChannelKey_rank" class="mat-input mat-mono" placeholder="Default channel" />
                                    <span class="mat-hint">Empty = each sensor's default channel.</span>
                                </div>
                                <div class="mat-field" data-map-property-rows-only>
                                    <label class="mat-label" for="@(tileId)ListLimit_rows">Rows</label>
                                    <input asp-for="Input.Tiles[index].ListLimit" id="@(tileId)ListLimit_rows" type="number" min="1" max="50" class="mat-input" />
                                </div>
                                @* A multi-graph reuses ListChannelKey / ListLimit rather than growing two more
                                   properties, but its labels have to say what they mean HERE: the channel is what makes
                                   the lines comparable, not a ranking key. *@
                                <partial name="_MapCompareFields" model="@(new Matmon.Host.Pages.MapCompareFieldsModel($"Input.Tiles[{index}]", Model.Input.Tiles[index].ListChannelKey, Model.Input.Tiles[index].GraphWindowHours, Model.CompareChannelOptions))" />
                                @* More than one target. A chart comparing "these four switches" is a set the tree has
                                   no single node for. Each row is the same element picker used everywhere else, rendered
                                   by the designer from the one hidden field below - the editor clones whole tiles by
                                   rewriting field names. *@
                                <div class="mat-field" data-map-property-series-only>
                                    <span class="mat-label">More targets</span>
                                    <input type="hidden" asp-for="Input.Tiles[index].TargetTokensText" data-map-targets-value />
                                    <div class="map-target-rows" data-map-targets-editor></div>
                                    <span class="mat-hint">Adds every sensor under each target.</span>
                                </div>
                                <div class="mat-field" data-map-property-series-only>
                                    <label class="mat-label" for="@(tileId)ListLimit_lines">Lines</label>
                                    <input asp-for="Input.Tiles[index].ListLimit" id="@(tileId)ListLimit_lines" type="number" min="1" max="8" class="mat-input" />
                                    <span class="mat-hint">At most 8.</span>
                                </div>
                                <div class="mat-field" data-map-property-sla-only>
                                    <label class="mat-label" for="@(tileId)SlaWindowDays">Window (days)</label>
                                    <input asp-for="Input.Tiles[index].SlaWindowDays" type="number" min="1" max="365" class="mat-input" />
                                    <span class="mat-hint">A warning counts as up.</span>
                                </div>
                                <div class="mat-field" data-map-property-embed-only>
                                    <label class="mat-label" for="@(tileId)EmbedUrl">Address</label>
                                    <input asp-for="Input.Tiles[index].EmbedUrl" id="@(tileId)EmbedUrl" type="url" class="mat-input mat-mono" placeholder="https://camera.local/snapshot.jpg" />
                                    <label class="mat-check"><input asp-for="Input.Tiles[index].EmbedImage" /><span class="mat-check__text">A picture - reload it every "Refresh" seconds (Advanced, default 30)</span></label>
                                    <span class="mat-hint">A page whose server forbids framing stays empty; on the public wallboard every viewer's browser loads the address itself.</span>
                                </div>
                                <div class="mat-field" data-map-property-image-only>
                                    <label class="mat-label" for="@(tileId)ImageFile">Picture</label>
                                    <input type="hidden" asp-for="Input.Tiles[index].ImageAssetId" data-map-property-image-id />
                                    <div class="map-image-upload">
                                        <input type="file" id="@(tileId)ImageFile" accept="image/png,image/jpeg" class="mat-input" data-map-image-file />
                                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-image-clear>Remove</button>
                                    </div>
                                    <span class="mat-hint" data-map-image-status>PNG or JPEG, up to 4 MB.</span>
                                </div>
                                <div class="mat-field" data-map-property-image-only>
                                    <label class="mat-label" for="@(tileId)ImageFit">Fit</label>
                                    <select asp-for="Input.Tiles[index].ImageFit" class="mat-select" data-map-property-image-fit>
                                        <option value="@MonitoringMapImageFit.Contain">Fit inside (no cropping)</option>
                                        <option value="@MonitoringMapImageFit.Cover">Fill and crop</option>
                                        <option value="@MonitoringMapImageFit.Stretch">Stretch</option>
                                    </select>
                                </div>
                                <div class="mat-field" data-map-property-pins-only>
                                    <span class="mat-label">Pins</span>
                                    <input type="hidden" asp-for="Input.Tiles[index].PinsJson" data-map-property-pins />
                                    <div class="map-pin-editor" data-map-pin-editor></div>
                                    <div class="mat-row">
                                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-pin-place>@MatUi.Icon("compass")<span>Place on picture</span></button>
                                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-pin-add>@MatUi.Icon("plus")<span>Add pin</span></button>
                                    </div>
                                    <span class="mat-hint" data-map-pin-hint></span>
                                </div>
                                <div class="mat-field" data-map-property-pins-only>
                                    <span class="mat-label">Links</span>
                                    <input type="hidden" asp-for="Input.Tiles[index].LinksJson" data-map-property-links />
                                    <div class="map-pin-editor" data-map-link-editor></div>
                                    <div class="mat-row">
                                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-link-add>@MatUi.Icon("link")<span>Add link</span></button>
                                    </div>
                                    <span class="mat-hint">A line between two pins, coloured by its own target - an interface sensor writes its traffic on it.</span>
                                </div>
                            </div>

                            <div class="map-prop-group" data-map-prop-group="display" hidden>
                                <div class="mat-field icon-picker-field">
                                    <span class="mat-label" id="@(tileId)IconKey_label">Icon</span>
                                    <input type="hidden" asp-for="Input.Tiles[index].IconKey" data-map-property-icon data-icon-picker-value />
                                    <button type="button" class="mat-select icon-picker-trigger" data-icon-picker-trigger aria-haspopup="dialog" aria-labelledby="@(tileId)IconKey_label @(tileId)IconKey_current">
                                        <span class="icon-picker-trigger-glyph" data-icon-picker-trigger-glyph>@MatmonIcons.Render(iconKey)</span>
                                        <span class="icon-picker-trigger-label" id="@(tileId)IconKey_current" data-icon-picker-trigger-label>@(string.IsNullOrWhiteSpace(tile.IconKey) ? "Auto (by type)" : tile.IconKey)</span>
                                    </button>
                                </div>
                                <div class="mat-field">
                                    <label class="mat-label" for="@(tileId)BackgroundColor">Background</label>
                                    <input asp-for="Input.Tiles[index].BackgroundColor" class="mat-input mat-mono" placeholder="auto or #101827" data-map-property-background />
                                </div>
                                <div class="mat-field">
                                    <label class="mat-label" for="@(tileId)AccentColor">Accent</label>
                                    <input asp-for="Input.Tiles[index].AccentColor" class="mat-input mat-mono" placeholder="auto or #78d5c8" data-map-property-accent />
                                </div>
                                <div class="mat-field">
                                    <label class="mat-label" for="@(tileId)TextColor">Text colour</label>
                                    <input asp-for="Input.Tiles[index].TextColor" class="mat-input mat-mono" placeholder="auto or #ffffff" data-map-property-text-color />
                                </div>
                                @* Real checkboxes, so they post, take focus and need no JS. asp-for renders each
                                   one's hidden "false" partner at the end of the form, after the checkbox. *@
                                <div class="map-property-switches mat-stack mat-stack--sm">
                                    <label class="mat-switch">
                                        <input asp-for="Input.Tiles[index].ShowCard" data-map-property-show-card />
                                        <span class="mat-switch__track"></span>
                                        <span>Card background</span>
                                    </label>
                                    <label class="mat-switch">
                                        <input asp-for="Input.Tiles[index].ShowTitle" data-map-property-show-title />
                                        <span class="mat-switch__track"></span>
                                        <span>Show title</span>
                                    </label>
                                    <label class="mat-switch">
                                        <input asp-for="Input.Tiles[index].ShowStateBadge" data-map-property-show-badge />
                                        <span class="mat-switch__track"></span>
                                        <span>Show state badge</span>
                                    </label>
                                    <label class="mat-switch">
                                        <input asp-for="Input.Tiles[index].ShowElementName" />
                                        <span class="mat-switch__track"></span>
                                        <span>Show target name</span>
                                    </label>
                                </div>
                            </div>

                            <div class="map-prop-group" data-map-prop-group="advanced" hidden>
                                @* Four buckets, not six states: "up / warning / down / unknown" is how someone
                                   configuring a wallboard thinks. MonitoringMapColorRules is where the six
                                   SensorStates collapse into these four, in one place. *@
                                <span class="mat-label">Colour rules</span>
                                <div class="map-color-rules">
                                    @foreach (var bucket in MonitoringMapColorRules.Buckets)
                                    {
                                        var current = tile.ColorRules.TryGetValue(bucket.Key, out var hex) ? hex : string.Empty;
                                        var swatch = BrandingSafety.SafeHexColor(current) ?? MonitoringMapColorRules.DefaultHex(bucket.Key);
                                        var ruleId = tileId + "ColorRules_" + bucket.Key;
                                        <div class="map-color-rule">
                                            <label class="map-color-rule-label" for="@ruleId">@bucket.Label</label>
                                            @* The swatch is a view control only - the TEXT field is what posts. A colour
                                               input cannot express "leave it to the theme", which is the default and the
                                               answer most boards want, so it seeds the text rather than replacing it. *@
                                            <input type="color" class="map-color-swatch" value="@swatch"
                                                   data-map-color-swatch="@bucket.Key" aria-label="@bucket.Label colour"
                                                   tabindex="-1" />
                                            <input type="text" class="mat-input mat-input--sm mat-mono" id="@ruleId"
                                                   name="Input.Tiles[@index].ColorRules[@bucket.Key]" value="@current"
                                                   placeholder="theme" data-map-color-rule="@bucket.Key" />
                                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-color-clear="@bucket.Key"
                                                    aria-label="Reset @bucket.Label to the theme colour" data-tip="Theme colour">@MatUi.Icon("x")</button>
                                        </div>
                                    }
                                </div>
                                <p class="mat-hint">#rrggbb. Empty = the theme colour.</p>
                                <div class="mat-field">
                                    <label class="mat-label" for="@(tileId)RefreshSeconds">Refresh (seconds)</label>
                                    <input asp-for="Input.Tiles[index].RefreshSeconds" type="number" min="0" max="3600" class="mat-input" placeholder="0" />
                                    <span class="mat-hint">0 = the board's own cadence.</span>
                                </div>
                            </div>
                        </section>
                    }
                </div>
            </aside>
        </div>
    </div>

    @* --- Slides: the list (add / rename / reorder / duplicate / delete) and the SELECTED slide's fields -------- *@
    <div class="mat-tabpanel" role="tabpanel" id="panel-slides" aria-labelledby="tab-slides" hidden>
        <div class="mat-grid">
            @* The list of slides, on the tab called Slides. The canvas keeps a switcher instead. *@
            <section class="mat-card">
                <div class="mat-card__head">
                    @MatUi.Icon("layers")
                    <h2 class="mat-card__title">Slides</h2>
                    <span class="mat-badge mat-badge--soft" data-map-slide-count>@Model.Input.Slides.Count</span>
                    <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm mm-push-end" data-map-slide-add>@MatUi.Icon("plus")<span>Add slide</span></button>
                </div>
                <div class="mat-card__body">
                    @* JS-rendered rows are cloned from the first server-rendered row, so the two markups cannot
                       drift. A row's own class is only map-slide-row (+ is-active). *@
                    <div class="map-slide-rows" data-map-slide-tabs>
                        @for (var slideIndex = 0; slideIndex < Model.Input.Slides.Count; slideIndex++)
                        {
                            var slide = Model.Input.Slides[slideIndex];
                            <div class="map-slide-row@(slideIndex == 0 ? " is-active" : "")" data-map-slide-tab data-slide-id="@slide.Id"
                                 data-slide-title="@slide.Title" data-slide-subtitle="@slide.Subtitle"
                                 data-slide-duration="@slide.DurationSeconds" data-slide-bg="@slide.BackgroundColor"
                                 data-slide-show-header="@(slide.ShowHeader ? "true" : "false")"
                                 draggable="true">
                                <span class="map-slide-row-grip" aria-hidden="true">@MatUi.Icon("menu")</span>
                                <span class="map-slide-row-index">@(slideIndex + 1)</span>
                                <span class="map-slide-row-name">@slide.Name</span>
                                <span class="map-slide-row-duration">@(slide.DurationSeconds is { } seconds ? $"{seconds}s" : "—")</span>
                                <span class="map-slide-row-actions">
                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-slide-settings aria-label="Slide properties" data-tip="Properties">@MatUi.Icon("settings")</button>
                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-slide-duplicate aria-label="Duplicate slide" data-tip="Duplicate">@MatUi.Icon("copy")</button>
                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-slide-delete aria-label="Delete slide" data-tip="Delete">@MatUi.Icon("trash")</button>
                                </span>
                            </div>
                        }
                    </div>
                    <div data-map-slide-inputs hidden></div>
                </div>
            </section>

            @* Slide fields are not model-bound: the designer owns the slide list and re-renders the hidden
               Input.Slides[..] inputs from it. *@
            <section class="mat-card" data-map-slide-panel>
                <div class="mat-card__head">@MatUi.Icon("edit")<h2 class="mat-card__title">Selected slide</h2></div>
                <div class="mat-card__body mat-stack">
                    <div class="mat-field">
                        <label class="mat-label" for="map-slide-name">Slide name</label>
                        <input type="text" class="mat-input" id="map-slide-name" data-map-slide-field="name" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="map-slide-title">Heading</label>
                        <input type="text" class="mat-input" id="map-slide-title" data-map-slide-field="title" placeholder="Shown on the board" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="map-slide-subtitle">Sub-heading</label>
                        <input type="text" class="mat-input" id="map-slide-subtitle" data-map-slide-field="subtitle" />
                    </div>
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="map-slide-duration">Duration (seconds)</label>
                            <input type="number" min="3" max="600" class="mat-input" id="map-slide-duration" data-map-slide-field="durationSeconds" placeholder="Map default" />
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="map-slide-background">Background</label>
                            <input type="text" class="mat-input mat-mono" id="map-slide-background" data-map-slide-field="backgroundColor" placeholder="auto or #0b1220" />
                        </div>
                    </div>
                    <label class="mat-switch">
                        <input type="checkbox" data-map-slide-field="showHeader" />
                        <span class="mat-switch__track"></span>
                        <span>Show this slide heading</span>
                    </label>
                    @* Emptying a slide is its own, named action - not a side effect of clicking a layout card. It
                       says how many widgets it throws away before it does. *@
                    <div class="mat-row">
                        <button type="button" class="mat-btn mat-btn--danger" data-map-slide-clear>@MatUi.Icon("trash")<span>Clear this slide</span></button>
                    </div>
                </div>
            </section>
        </div>
    </div>

    @* --- Board ----------------------------------------------------------------------------------------- *@
    <div class="mat-tabpanel" role="tabpanel" id="panel-board" aria-labelledby="tab-board" hidden>
        <div class="mat-grid">
            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("settings")<h2 class="mat-card__title">Board</h2></div>
                <div class="mat-card__body mat-stack">
                    <div class="mat-field">
                        <label class="mat-label" for="Input_Name">Name</label>
                        <input asp-for="Input.Name" class="mat-input" data-map-name />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="Input_Description">Description</label>
                        <input asp-for="Input.Description" class="mat-input" data-map-description />
                    </div>
                    @* Round-trip only. A board has no fixed canvas and no letterbox, so these three no longer decide
                       anything - they are posted back so an older board's stored values survive a save. *@
                    <input type="hidden" asp-for="Input.AspectRatioWidth" />
                    <input type="hidden" asp-for="Input.AspectRatioHeight" />
                    <input type="hidden" asp-for="Input.WallboardFit" />
                    <div class="mat-field">
                        <label class="mat-label" for="Input_DisplayTimeZoneId">Board timezone</label>
                        <input asp-for="Input.DisplayTimeZoneId" class="mat-input mat-mono" placeholder="Platform default, e.g. Europe/Berlin" list="map-timezone-list" />
                        <datalist id="map-timezone-list">
                            @foreach (var zone in TimeZoneInfo.GetSystemTimeZones().Select(z => z.Id).OrderBy(z => z, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@zone"></option>
                            }
                        </datalist>
                        <span class="mat-hint">Used by the clock widget.</span>
                    </div>
                    <label class="mat-switch">
                        <input asp-for="Input.PublicEnabled" data-map-public-enabled />
                        <span class="mat-switch__track"></span>
                        <span>Publish an anonymous link</span>
                    </label>
                    <span class="mat-hint">Anyone holding the link sees the board without signing in. Turning this off disables the link at once.</span>
                    <label class="mat-switch">
                        <input asp-for="Input.AlertSound" />
                        <span class="mat-switch__track"></span>
                        <span>Beep on the wallboard when a tile turns red</span>
                    </label>
                    <span class="mat-hint">Add <code>?focus=problems</code> to the address to dim every tile that is fine.</span>
                </div>
            </section>

            @* Grid geometry is authoritative: change the column count and every widget flows with it. *@
            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("grid")<h2 class="mat-card__title">Grid</h2></div>
                <div class="mat-card__body mat-stack">
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="Input_Columns">Columns</label>
                            <input asp-for="Input.Columns" type="number" min="2" max="48" class="mat-input" data-map-columns />
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="Input_Rows">Rows per screen</label>
                            <input asp-for="Input.Rows" type="number" min="2" max="32" class="mat-input" data-map-rows />
                            <span class="mat-hint">A taller board scrolls.</span>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="Input_TilePadding">Gap (px)</label>
                            <input asp-for="Input.TilePadding" type="number" min="0" max="80" class="mat-input" data-map-tile-padding />
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="Input_OuterMargin">Margin (px)</label>
                            <input asp-for="Input.OuterMargin" type="number" min="0" max="160" class="mat-input" data-map-outer-margin />
                        </div>
                    </div>
                    <span class="mat-hint">Fewer columns shrink widgets that no longer fit; adding columns back does not undo that.</span>
                </div>
            </section>

            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("play")<h2 class="mat-card__title">Slide rotation</h2></div>
                <div class="mat-card__body mat-stack">
                    <label class="mat-switch">
                        <input asp-for="Input.AutoRotateEnabled" data-map-autorotate />
                        <span class="mat-switch__track"></span>
                        <span>Autoplay</span>
                    </label>
                    <div class="mat-field">
                        <label class="mat-label" for="Input_AutoRotateSeconds">Default duration</label>
                        <select asp-for="Input.AutoRotateSeconds" class="mat-select">
                            @foreach (var seconds in rotationChoices)
                            {
                                <option value="@seconds">@seconds seconds</option>
                            }
                        </select>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="Input_PaginationMode">Page indicator</label>
                        <select asp-for="Input.PaginationMode" class="mat-select">
                            <option value="@MonitoringMapPaginationMode.Below">Below the board</option>
                            <option value="@MonitoringMapPaginationMode.OverlayAlways">Overlay - always visible</option>
                            <option value="@MonitoringMapPaginationMode.OverlayOnActivity">Overlay - on activity</option>
                            <option value="@MonitoringMapPaginationMode.Hidden">Hidden</option>
                        </select>
                    </div>
                </div>
            </section>
        </div>
    </div>

    @* One pin row, cloned per pin by the designer. The target uses the SAME element picker as everything else
       (cloned, ids rewritten). Nothing here is model-bound: the designer serialises the rows into the tile's
       single PinsJson field. *@
    <template data-map-pin-template>
        <div class="map-pin-row" data-map-pin-row data-pin-id="__pinId__">
            <div class="map-pin-row-main">
                <input type="text" class="mat-input mat-input--sm" data-pin-field="label" placeholder="Label" aria-label="Pin label" />
                <select class="mat-select mat-select--sm" data-pin-field="style" aria-label="Pin style">
                    <option value="Dot">Dot</option>
                    <option value="Tile">Mini tile</option>
                    <option value="Device">Device</option>
                </select>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-pin-remove aria-label="Remove pin">@MatUi.Icon("trash")</button>
            </div>
            <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = string.Empty, DomId = "picker-map-pin-__pinId__", AllowTags = true, Placeholder = "No target", Options = Model.TilePickerOptions, ValueAttribute = "data-pin-field-target" })" />
            <div class="map-pin-row-main map-pin-row-main--pair" data-map-pin-device-row>
                <select class="mat-select mat-select--sm" data-pin-field="icon" aria-label="Device">
                    @foreach (var device in MonitoringMapDevices.All)
                    {
                        <option value="@device.Key">@device.Label</option>
                    }
                </select>
                <select class="mat-select mat-select--sm" data-pin-field="linkMapId" aria-label="Opens map">
                    <option value="">Opens no map</option>
                    @foreach (var option in Model.MapLinkOptions)
                    {
                        <option value="@option.Value">Opens: @option.Text</option>
                    }
                </select>
            </div>
            <div class="map-pin-row-geo" data-map-pin-geo hidden>
                <input type="number" step="0.0001" min="-90" max="90" class="mat-input mat-input--sm" data-pin-field="latitude" placeholder="Latitude" aria-label="Latitude" />
                <input type="number" step="0.0001" min="-180" max="180" class="mat-input mat-input--sm" data-pin-field="longitude" placeholder="Longitude" aria-label="Longitude" />
            </div>
        </div>
    </template>
    @* One extra-target row, cloned per token by the designer. Same element picker as everywhere else, with its
       DOM id rewritten per row - a duplicated id would make one row's picker drive another row's value. *@
    @* One link row, cloned per link by the designer and serialised into the tile's LinksJson. The two pin selects
       are filled from the tile's current pins. *@
    <template data-map-link-template>
        <div class="map-pin-row" data-map-link-row>
            <div class="map-pin-row-main map-pin-row-main--pair">
                <select class="mat-select mat-select--sm" data-link-field="fromPinId" aria-label="From"></select>
                <select class="mat-select mat-select--sm" data-link-field="toPinId" aria-label="To"></select>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-link-remove aria-label="Remove link">@MatUi.Icon("trash")</button>
            </div>
            <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = string.Empty, DomId = "picker-map-link-__linkId__", AllowTags = true, Placeholder = "No sensor (neutral line)", Options = Model.TilePickerOptions, ValueAttribute = "data-link-field-target" })" />
            <div class="map-pin-row-main">
                <input type="text" class="mat-input mat-input--sm" data-link-field="label" placeholder="Label (port, cable)" aria-label="Link label" />
                <label class="mat-check"><input type="checkbox" data-link-field="showTraffic" /><span class="mat-check__text">Traffic</span></label>
            </div>
        </div>
    </template>
    <template data-map-target-template>
        <div class="map-target-row" data-map-target-row>
            <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = string.Empty, DomId = "picker-map-target-__rowId__", AllowTags = true, Placeholder = "Pick an element or tag", Options = Model.TilePickerOptions, ValueAttribute = "data-map-target-value" })" />
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-target-remove aria-label="Remove target">@MatUi.Icon("trash")</button>
        </div>
    </template>
    <template data-map-tile-template>
        <article class="map-tile map-tile-editor"
                 data-map-tile
                 data-tile-index="__index__"
                 data-slide-id="__slideId__"
                 data-tile-id="__id__"
                 data-state="unknown"
                 data-kind="__kindLower__"
                 data-visual="__visual__"
                 data-density="__density__"
                 style="--tile-col: __column__; --tile-row: __row__; --tile-span: __colSpan__; --tile-rows: __rowSpan__">
            <input type="hidden" name="Input.Tiles[__index__].Id" value="__id__" />
            <input type="hidden" name="Input.Tiles[__index__].SlideId" value="__slideId__" data-map-tile-slide-id />
            <input type="hidden" name="Input.Tiles[__index__].IsDeleted" value="false" data-map-tile-deleted />
            <input type="hidden" name="Input.Tiles[__index__].Column" value="__column__" data-map-tile-column />
            <input type="hidden" name="Input.Tiles[__index__].Row" value="__row__" data-map-tile-row />
            <input type="hidden" name="Input.Tiles[__index__].Order" value="__order__" data-map-tile-order />

            @* First paint only - the designer immediately asks ?handler=TileMarkup for the real server render. It
               still mirrors _MapTile's anatomy (head / body / foot, and the density the row span implies), because
               a placeholder shaped differently from the thing it stands in for flashes a visibly different widget
               for one round trip. *@
            <div class="map-tile-head map-tile-drag-handle">
                <span class="map-tile-icon">@MatmonIcons.Render("square")</span>
                <strong data-tile-title>__title__</strong>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm map-tile-remove" data-map-remove-tile aria-label="Remove tile">@MatUi.Icon("trash")</button>
            </div>
            <div class="map-tile-body">
                <p data-tile-subtitle>No target selected</p>
            </div>
            <div class="map-tile-foot">
                <small data-map-tile-kind-label>__kindLabel__</small>
            </div>
            <span class="map-tile-size-badge" data-map-tile-size-badge aria-hidden="true">__colSpan__ × __rowSpan__</span>
            <span class="map-tile-resize-handle" data-map-resize-handle aria-hidden="true"></span>
        </article>
        @* Property panel for a freshly dropped tile. Kept field-for-field identical to the server-rendered one
           above. Any field added here must be added there too. *@
        <section class="map-property-panel" data-map-property-panel data-tile-index="__index__" hidden>
            <header class="mat-card map-property-head">
                <div class="mat-card__body map-property-head-body">
                    <span class="map-property-head-icon" data-map-property-head-icon>@MatmonIcons.Render("square")</span>
                    <span class="map-property-head-text">
                        <strong class="mat-card__title" data-map-property-head-title>__title__</strong>
                        <small data-map-property-head-kind>__kindLabel__</small>
                    </span>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-property-remove aria-label="Delete widget" data-tip="Delete widget">@MatUi.Icon("trash")</button>
                </div>
            </header>

            <div class="map-prop-group" data-map-prop-group="general">
                <div class="mat-field">
                    <label class="mat-label" for="@(TemplateTileId)Title">Title</label>
                    <input id="@(TemplateTileId)Title" name="Input.Tiles[__index__].Title" value="__title__" class="mat-input" data-map-property-title />
                </div>
                <div class="mat-field">
                    <span class="mat-label">Widget</span>
                    <input type="hidden" name="Input.Tiles[__index__].Kind" value="__kind__" data-map-property-kind />
                    <input type="hidden" name="Input.Tiles[__index__].VisualType" value="__visual__" data-map-property-visual-type />
                    <span class="map-property-readonly" data-map-property-kind-label>__kindLabel__</span>
                </div>
                <div class="mat-form__grid map-property-pair">
                    <div class="mat-field">
                        <label class="mat-label" for="@(TemplateTileId)ColumnSpan">Width (columns)</label>
                        <input id="@(TemplateTileId)ColumnSpan" name="Input.Tiles[__index__].ColumnSpan" value="__colSpan__" type="number" min="1" max="@Model.Input.Columns" class="mat-input" data-map-tile-column-span />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="@(TemplateTileId)RowSpan">Height (rows)</label>
                        <input id="@(TemplateTileId)RowSpan" name="Input.Tiles[__index__].RowSpan" value="__rowSpan__" type="number" min="1" max="@MonitoringMapTileConstraints.MaxRowSpan" class="mat-input" data-map-tile-row-span />
                    </div>
                </div>
                <p class="map-property-size-readout" data-map-property-size>Size __colSpan__ x __rowSpan__ cells</p>
                <p class="map-property-hint" data-map-property-hint></p>
            </div>

            <div class="map-prop-group" data-map-prop-group="data" hidden>
                <div class="mat-field" data-map-property-target>
                    <span class="mat-label">Target</span>
                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "Input.Tiles[__index__].TargetToken", DomId = "picker-map-tile-__index__", SelectedValue = null, AllowTags = true, Placeholder = "No element", Options = Model.TilePickerOptions, ValueAttribute = "data-map-property-element" })" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="@(TemplateTileId)LinkMapId">Opens map</label>
                    <select id="@(TemplateTileId)LinkMapId" name="Input.Tiles[__index__].LinkMapId" class="mat-select">
                        <option value="">Nothing</option>
                        @foreach (var option in Model.MapLinkOptions)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                    <span class="mat-hint">Without a target the tile shows the worst state on that map.</span>
                </div>
                <div class="mat-field" data-map-property-text-only>
                    <label class="mat-label" for="@(TemplateTileId)Text">Text</label>
                    <textarea id="@(TemplateTileId)Text" name="Input.Tiles[__index__].Text" class="mat-textarea" rows="4" data-map-property-text></textarea>
                </div>
                <div class="mat-field" data-map-property-graph-only>
                    <label class="mat-label" for="@(TemplateTileId)GraphType">Graph type</label>
                    <select id="@(TemplateTileId)GraphType" name="Input.Tiles[__index__].GraphType" class="mat-select" data-map-property-graph-type>
                        <option value="@MonitoringMapTileGraphType.Line">Line</option>
                        <option value="@MonitoringMapTileGraphType.Area">Area</option>
                        <option value="@MonitoringMapTileGraphType.Bars">Bars</option>
                        <option value="@MonitoringMapTileGraphType.Smooth">Smooth</option>
                    </select>
                </div>
                <div class="mat-field" data-map-property-graph-only>
                    <label class="mat-label" for="@(TemplateTileId)GraphWindowHours_graph">Time window</label>
                    <select id="@(TemplateTileId)GraphWindowHours_graph" name="Input.Tiles[__index__].GraphWindowHours" class="mat-select">
                        @foreach (var hours in MonitoringMapTile.GraphWindowChoices)
                        {
                            <option value="@hours" selected="@(hours == 24)">@WindowLabel(hours)</option>
                        }
                    </select>
                </div>
                <div class="mat-field" data-map-property-value-only>
                    <label class="mat-label" for="@(TemplateTileId)ChannelKey">Channel</label>
                    <input id="@(TemplateTileId)ChannelKey" name="Input.Tiles[__index__].ChannelKey" class="mat-input mat-mono" placeholder="Default channel" />
                </div>
                <div class="mat-form__grid map-property-pair" data-map-property-value-only>
                    <div class="mat-field">
                        <label class="mat-label" for="@(TemplateTileId)GaugeMin">Scale from</label>
                        <input id="@(TemplateTileId)GaugeMin" name="Input.Tiles[__index__].GaugeMin" type="number" step="any" class="mat-input" placeholder="0" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="@(TemplateTileId)GaugeMax">Scale to</label>
                        <input id="@(TemplateTileId)GaugeMax" name="Input.Tiles[__index__].GaugeMax" type="number" step="any" class="mat-input" placeholder="100" />
                    </div>
                </div>
                <p class="mat-hint" data-map-property-value-only>In the channel's own unit. Leave empty for a percentage channel; without a scale the tile shows the plain number.</p>
                <div class="mat-field" data-map-property-list-only>
                    <label class="mat-label" for="@(TemplateTileId)ListMode">Order</label>
                    <select id="@(TemplateTileId)ListMode" name="Input.Tiles[__index__].ListMode" class="mat-select">
                        <option value="@MonitoringMapListMode.Worst">Worst state first</option>
                        <option value="@MonitoringMapListMode.TopValue">Highest value first</option>
                        <option value="@MonitoringMapListMode.BottomValue">Lowest value first</option>
                        <option value="@MonitoringMapListMode.Alphabetical">By name</option>
                    </select>
                </div>
                <div class="mat-field" data-map-property-list-only>
                    <label class="mat-label" for="@(TemplateTileId)ListChannelKey_rank">Rank by channel</label>
                    <input id="@(TemplateTileId)ListChannelKey_rank" name="Input.Tiles[__index__].ListChannelKey" class="mat-input mat-mono" placeholder="Default channel" />
                    <span class="mat-hint">Empty = each sensor's default channel.</span>
                </div>
                <div class="mat-field" data-map-property-rows-only>
                    <label class="mat-label" for="@(TemplateTileId)ListLimit_rows">Rows</label>
                    <input id="@(TemplateTileId)ListLimit_rows" name="Input.Tiles[__index__].ListLimit" type="number" min="1" max="50" value="5" class="mat-input" />
                </div>
                <partial name="_MapCompareFields" model="@(new Matmon.Host.Pages.MapCompareFieldsModel("Input.Tiles[__index__]", null, 24, Model.CompareChannelOptions))" />
                <div class="mat-field" data-map-property-series-only>
                    <span class="mat-label">More targets</span>
                    <input type="hidden" name="Input.Tiles[__index__].TargetTokensText" data-map-targets-value />
                    <div class="map-target-rows" data-map-targets-editor></div>
                    <span class="mat-hint">Adds every sensor under each target.</span>
                </div>
                <div class="mat-field" data-map-property-series-only>
                    <label class="mat-label" for="@(TemplateTileId)ListLimit_lines">Lines</label>
                    <input id="@(TemplateTileId)ListLimit_lines" name="Input.Tiles[__index__].ListLimit" type="number" min="1" max="8" value="4" class="mat-input" />
                    <span class="mat-hint">At most 8.</span>
                </div>
                <div class="mat-field" data-map-property-sla-only>
                    <label class="mat-label" for="@(TemplateTileId)SlaWindowDays">Window (days)</label>
                    <input id="@(TemplateTileId)SlaWindowDays" name="Input.Tiles[__index__].SlaWindowDays" type="number" min="1" max="365" value="7" class="mat-input" />
                    <span class="mat-hint">A warning counts as up.</span>
                </div>
                <div class="mat-field" data-map-property-embed-only>
                    <label class="mat-label" for="@(TemplateTileId)EmbedUrl">Address</label>
                    <input id="@(TemplateTileId)EmbedUrl" name="Input.Tiles[__index__].EmbedUrl" type="url" class="mat-input mat-mono" placeholder="https://camera.local/snapshot.jpg" />
                    @* Checkbox BEFORE its hidden false partner: with both posted the binder takes the first value. *@
                    <label class="mat-check"><input type="checkbox" name="Input.Tiles[__index__].EmbedImage" value="true" /><span class="mat-check__text">A picture - reload it every "Refresh" seconds (Advanced, default 30)</span></label>
                    <input type="hidden" name="Input.Tiles[__index__].EmbedImage" value="false" />
                    <span class="mat-hint">A page whose server forbids framing stays empty; on the public wallboard every viewer's browser loads the address itself.</span>
                </div>
                <div class="mat-field" data-map-property-image-only>
                    <label class="mat-label" for="@(TemplateTileId)ImageFile">Picture</label>
                    <input type="hidden" name="Input.Tiles[__index__].ImageAssetId" data-map-property-image-id />
                    <div class="map-image-upload">
                        <input type="file" id="@(TemplateTileId)ImageFile" accept="image/png,image/jpeg" class="mat-input" data-map-image-file />
                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-image-clear>Remove</button>
                    </div>
                    <span class="mat-hint" data-map-image-status>PNG or JPEG, up to 4 MB.</span>
                </div>
                <div class="mat-field" data-map-property-image-only>
                    <label class="mat-label" for="@(TemplateTileId)ImageFit">Fit</label>
                    <select id="@(TemplateTileId)ImageFit" name="Input.Tiles[__index__].ImageFit" class="mat-select" data-map-property-image-fit>
                        <option value="@MonitoringMapImageFit.Contain">Fit inside (no cropping)</option>
                        <option value="@MonitoringMapImageFit.Cover">Fill and crop</option>
                        <option value="@MonitoringMapImageFit.Stretch">Stretch</option>
                    </select>
                </div>
                <div class="mat-field" data-map-property-pins-only>
                    <span class="mat-label">Pins</span>
                    <input type="hidden" name="Input.Tiles[__index__].PinsJson" data-map-property-pins />
                    <div class="map-pin-editor" data-map-pin-editor></div>
                    <div class="mat-row">
                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-pin-place>@MatUi.Icon("compass")<span>Place on picture</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-pin-add>@MatUi.Icon("plus")<span>Add pin</span></button>
                    </div>
                    <span class="mat-hint" data-map-pin-hint></span>
                </div>
                <div class="mat-field" data-map-property-pins-only>
                    <span class="mat-label">Links</span>
                    <input type="hidden" name="Input.Tiles[__index__].LinksJson" data-map-property-links />
                    <div class="map-pin-editor" data-map-link-editor></div>
                    <div class="mat-row">
                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-map-link-add>@MatUi.Icon("link")<span>Add link</span></button>
                    </div>
                    <span class="mat-hint">A line between two pins, coloured by its own target - an interface sensor writes its traffic on it.</span>
                </div>
            </div>

            <div class="map-prop-group" data-map-prop-group="display" hidden>
                <div class="mat-field icon-picker-field">
                    <span class="mat-label" id="@(TemplateTileId)IconKey_label">Icon</span>
                    <input type="hidden" name="Input.Tiles[__index__].IconKey" value="" data-map-property-icon data-icon-picker-value />
                    <button type="button" class="mat-select icon-picker-trigger" data-icon-picker-trigger aria-haspopup="dialog" aria-labelledby="@(TemplateTileId)IconKey_label @(TemplateTileId)IconKey_current">
                        <span class="icon-picker-trigger-glyph" data-icon-picker-trigger-glyph>@MatmonIcons.Render("square")</span>
                        <span class="icon-picker-trigger-label" id="@(TemplateTileId)IconKey_current" data-icon-picker-trigger-label>Auto (by type)</span>
                    </button>
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="@(TemplateTileId)BackgroundColor">Background</label>
                    <input id="@(TemplateTileId)BackgroundColor" name="Input.Tiles[__index__].BackgroundColor" class="mat-input mat-mono" placeholder="auto or #101827" data-map-property-background />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="@(TemplateTileId)AccentColor">Accent</label>
                    <input id="@(TemplateTileId)AccentColor" name="Input.Tiles[__index__].AccentColor" class="mat-input mat-mono" placeholder="auto or #78d5c8" data-map-property-accent />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="@(TemplateTileId)TextColor">Text colour</label>
                    <input id="@(TemplateTileId)TextColor" name="Input.Tiles[__index__].TextColor" class="mat-input mat-mono" placeholder="auto or #ffffff" data-map-property-text-color />
                </div>
                @* ⚠️ Each checkbox comes BEFORE its hidden "false" partner (the order ASP.NET's own tag helper
                   emits): with both posted the binder takes the FIRST value, so hidden-first read every switch back
                   as false. The partner sits after the track, so the track stays the checkbox's next sibling - which
                   is what draws the switch on. *@
                <div class="map-property-switches mat-stack mat-stack--sm">
                    <label class="mat-switch">
                        <input name="Input.Tiles[__index__].ShowCard" type="checkbox" value="true" checked data-map-property-show-card />
                        <span class="mat-switch__track"></span>
                        <span>Card background</span>
                        <input name="Input.Tiles[__index__].ShowCard" type="hidden" value="false" />
                    </label>
                    <label class="mat-switch">
                        <input name="Input.Tiles[__index__].ShowTitle" type="checkbox" value="true" checked data-map-property-show-title />
                        <span class="mat-switch__track"></span>
                        <span>Show title</span>
                        <input name="Input.Tiles[__index__].ShowTitle" type="hidden" value="false" />
                    </label>
                    <label class="mat-switch">
                        <input name="Input.Tiles[__index__].ShowStateBadge" type="checkbox" value="true" checked data-map-property-show-badge />
                        <span class="mat-switch__track"></span>
                        <span>Show state badge</span>
                        <input name="Input.Tiles[__index__].ShowStateBadge" type="hidden" value="false" />
                    </label>
                    <label class="mat-switch">
                        <input name="Input.Tiles[__index__].ShowElementName" type="checkbox" value="true" checked />
                        <span class="mat-switch__track"></span>
                        <span>Show target name</span>
                        <input name="Input.Tiles[__index__].ShowElementName" type="hidden" value="false" />
                    </label>
                </div>
            </div>

            @* The Advanced group has to exist in the template too - a freshly dropped tile otherwise showed an
               empty Advanced tab until the first save. *@
            <div class="map-prop-group" data-map-prop-group="advanced" hidden>
                <span class="mat-label">Colour rules</span>
                <div class="map-color-rules">
                    @foreach (var bucket in MonitoringMapColorRules.Buckets)
                    {
                        var ruleId = TemplateTileId + "ColorRules_" + bucket.Key;
                        <div class="map-color-rule">
                            <label class="map-color-rule-label" for="@ruleId">@bucket.Label</label>
                            <input type="color" class="map-color-swatch" value="@MonitoringMapColorRules.DefaultHex(bucket.Key)"
                                   data-map-color-swatch="@bucket.Key" aria-label="@bucket.Label colour" tabindex="-1" />
                            <input type="text" class="mat-input mat-input--sm mat-mono" id="@ruleId"
                                   name="Input.Tiles[__index__].ColorRules[@bucket.Key]" value=""
                                   placeholder="theme" data-map-color-rule="@bucket.Key" />
                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-map-color-clear="@bucket.Key"
                                    aria-label="Reset @bucket.Label to the theme colour" data-tip="Theme colour">@MatUi.Icon("x")</button>
                        </div>
                    }
                </div>
                <p class="mat-hint">#rrggbb. Empty = the theme colour.</p>
                <div class="mat-field">
                    <label class="mat-label" for="@(TemplateTileId)RefreshSeconds">Refresh (seconds)</label>
                    <input id="@(TemplateTileId)RefreshSeconds" name="Input.Tiles[__index__].RefreshSeconds" type="number" min="0" max="3600" class="mat-input" placeholder="0" />
                    <span class="mat-hint">0 = the board's own cadence.</span>
                </div>
            </div>
        </section>
    </template>

    <div class="mat-btn-row">
        <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save layout</span></button>
        <a class="mat-btn mat-btn--secondary" asp-page="/Maps" asp-route-mapId="@Model.Input.Id">@MatUi.Icon("back")<span>Back</span></a>
        @if (!Model.IsCreateMode)
        {
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" asp-page-handler="Delete" formnovalidate class="mat-btn mat-btn--danger"
                    data-confirm="Delete this map? Its slides and widgets go with it." data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete map</span></button>
        }
    </div>
</form>

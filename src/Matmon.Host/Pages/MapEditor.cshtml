@page "/Maps/Edit"
@model MapEditorModel
@{
    ViewData["Title"] = Model.IsCreateMode ? "New Map" : $"Edit {Model.Input.Name}";
    var logicalSize = MonitoringMap.LogicalSizeFor(Model.Input.AspectRatioWidth, Model.Input.AspectRatioHeight);
}

<section class="dashboard-shell maps-shell">
    @* Header per mockup: what this screen is, then the three board-level actions on the right with Save as
       the filled primary. Preview/Fullscreen open the read-only viewer rather than duplicating the board. *@
    <div class="page-header map-editor-header">
        <div class="page-title">
            <div>
                <h1>Layout &amp; Slides</h1>
                <p class="map-editor-subtitle">Design your wallboard. Use the grid, add widgets and configure the slide rotation.</p>
            </div>
        </div>
        <div class="page-actions">
            <a class="workspace-secondary-submit" asp-page="/Maps" asp-route-mapId="@Model.Input.Id">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
            @if (!Model.IsCreateMode)
            {
                <a class="workspace-secondary-submit" asp-page="/Maps" asp-route-mapId="@Model.Input.Id" target="_blank" rel="noopener">@MatmonIcons.Render("eye")<span>Preview</span></a>
                <button type="button" class="workspace-secondary-submit" data-map-fullscreen>@MatmonIcons.Render("move")<span>Fullscreen</span></button>
            }
            <button type="submit" form="map-editor-form" asp-page-handler="Save" class="workspace-submit">@MatmonIcons.Render("check")<span>Save layout</span></button>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="workspace-banner workspace-banner-error">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <span>@error.ErrorMessage</span>
            }
        </div>
    }

    <form method="post" id="map-editor-form" class="map-editor-form" data-map-designer-form>
        <input type="hidden" asp-for="Input.Id" />
        @* Grid geometry, ShowSlideHeaders and the public-link toggle are all real inputs in the Grid /
           Wallboard property tabs now. *@
        <script type="application/json" data-map-designer-config>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DesignerConfigJson))</script>
        <div class="icon-picker-modal" data-icon-picker-modal hidden>
            <div class="icon-picker-backdrop" data-icon-picker-close></div>
            <div class="icon-picker-dialog" role="dialog" aria-modal="true" aria-label="Choose icon">
                <div class="icon-picker-head">
                    <div class="icon-picker-search">
                        @MatmonIcons.Render("search")
                        <input type="text" class="form-control workspace-input" placeholder="Search icons…" data-icon-picker-search autocomplete="off" />
                    </div>
                    <button type="button" class="workspace-secondary-submit" data-icon-picker-close aria-label="Close">@MatmonIcons.Render("x")</button>
                </div>
                <div class="icon-picker-grid" data-icon-picker-grid>
                    <button type="button" class="icon-picker-cell is-clear" data-icon-key="" data-icon-search="auto default none clear">
                        <span class="icon-picker-glyph">@MatmonIcons.Render("square")</span>
                        <span class="icon-picker-name">Auto</span>
                    </button>
                    @foreach (var iconKey in Matmon.Host.Ui.MatmonIcons.Keys)
                    {
                        <button type="button" class="icon-picker-cell" data-icon-key="@iconKey" data-icon-search="@iconKey">
                            <span class="icon-picker-glyph">@MatmonIcons.Render(iconKey)</span>
                            <span class="icon-picker-name">@iconKey</span>
                        </button>
                    }
                </div>
                <div class="icon-picker-empty" data-icon-picker-empty hidden>No matching icons.</div>
            </div>
        </div>

        <section class="panel map-editor-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("move")<span>Designer</span></h2>
                <span class="panel-hint">Drag a widget onto the canvas, click it to edit its properties</span>
            </div>
            @* Top-level tabs, as in the mockup. The map's own settings moved OUT of the right-hand column
               into Display/Settings, so that column is now purely the SELECTED WIDGET's properties - which is
               what "Properties" means on the mockup. Uses the app-wide .sensor-tabs language; the per-widget
               and per-slide tab bars deliberately use their own data- attributes so initializeSensorTabs
               (which resolves panels per FORM) cannot fight with them. *@
            <div class="sensor-tabs map-editor-tabs" data-sensor-tabs>
                <button type="button" class="sensor-tab" data-sensor-tab-target="editor">@MatmonIcons.Render("move")<span>Editor</span></button>
                <button type="button" class="sensor-tab" data-sensor-tab-target="slides">@MatmonIcons.Render("copy")<span>Slides</span></button>
                <button type="button" class="sensor-tab" data-sensor-tab-target="display">@MatmonIcons.Render("eye")<span>Display</span></button>
                <button type="button" class="sensor-tab" data-sensor-tab-target="settings">@MatmonIcons.Render("gear")<span>Settings</span></button>
            </div>

            <div class="map-tab-panel" data-sensor-tab="editor">
            <div class="map-designer-shell">
                @* The palette is rendered from MapWidgetCatalog, not hand-written buttons: several entries are
                   the same tile Kind with a different VisualType (Gauge and Progress are both a Value tile),
                   which is the distinction a user picks by and the enum cannot express. Adding a widget is one
                   entry in that catalog. *@
                <aside class="map-toolbox" aria-label="Widget library">
                    <div class="map-designer-side-title">
                        @MatmonIcons.Render("spark")
                        <strong>Widgets</strong>
                    </div>
                    <div class="map-toolbox-search">
                        @MatmonIcons.Render("search")
                        <input type="text" class="form-control workspace-input" placeholder="Search widgets…" data-map-tool-search autocomplete="off" aria-label="Search widgets" />
                    </div>
                    <div class="map-toolbox-list">
                        @foreach (var group in MapWidgetCatalog.ByCategory())
                        {
                            <div class="map-toolbox-group" data-map-tool-group>
                                <span class="map-toolbox-group-label">@MapWidgetCatalog.CategoryLabel(group.Key)</span>
                                <div class="map-toolbox-group-items">
                                @foreach (var widget in group)
                                {
                                    @* A drawn preview, not a word: the description is what the entry MEANS,
                                       the schematic is what it LOOKS like, and on a wallboard the second is
                                       what you are actually choosing between. The description moves to the
                                       tooltip because two cards per row leaves no honest room for it. *@
                                    <button type="button" class="map-tool-button" draggable="true"
                                            title="@widget.Description"
                                            data-map-tool-widget="@widget.Key"
                                            data-map-tool-kind="@widget.Kind"
                                            data-map-tool-title="@widget.Label"
                                            data-map-tool-visual="@widget.VisualType"
                                            data-map-tool-search="@($"{widget.Label} {widget.Description} {widget.SearchTerms}".ToLowerInvariant())">
                                        <partial name="_MapWidgetPreview" model="@MapWidgetCatalog.PreviewKey(widget)" />
                                        <span class="map-tool-label"><strong>@widget.Label</strong></span>
                                    </button>
                                }
                                </div>
                            </div>
                        }
                        <div class="map-toolbox-empty" data-map-tool-empty hidden>No matching widget.</div>
                    </div>

                    <div class="map-toolbox-templates" data-map-layout-templates>
                        <span class="map-toolbox-group-label">Layouts</span>
                        <p class="map-toolbox-note">Fills the current slide with empty, correctly-sized widgets.</p>
                        @* Thumbnails, not word chips: the whole point of a layout is its shape, and the
                           shape is already declared as slots - so the preview is generated from the SAME
                           slots the template applies. A hand-drawn thumbnail could disagree with it. *@
                        <div class="map-layout-cards">
                        @foreach (var template in MapWidgetCatalog.LayoutTemplates)
                        {
                            <button type="button" class="map-layout-card" data-map-layout="@template.Key"
                                    data-layout-min-columns="@template.MinColumns" data-layout-min-rows="@template.MinRows"
                                    title="@template.Description">
                                <span class="map-layout-thumb" aria-hidden="true"
                                      style="grid-template-columns: repeat(@template.MinColumns, 1fr); grid-template-rows: repeat(@template.MinRows, 1fr);">
                                    @foreach (var slot in template.Slots)
                                    {
                                        <span style="grid-column: @slot.Column / span @slot.ColumnSpan; grid-row: @slot.Row / span @slot.RowSpan;"></span>
                                    }
                                </span>
                                <span class="map-layout-card-meta">
                                    <strong>@template.Label</strong>
                                    <small>@template.Description</small>
                                </span>
                            </button>
                        }
                        </div>
                        <div class="map-toolbox-note map-toolbox-note-warn" data-map-layout-too-small hidden>
                            Some layouts need a larger grid than this map has.
                        </div>
                    </div>
                </aside>

                <div class="map-designer-workbench">
                    @* Canvas header per mockup: which slide, the geometry facts underneath, and the view
                       controls on the right. Clicking the title still selects the board itself, which is how
                       you get back from a widget to the board-level settings. *@
                    <div class="map-canvas-head">
                        <button type="button" class="map-canvas-title" data-map-select-map>
                            <strong data-map-title-preview>@Model.Input.Name</strong>
                            <small>
                                Grid: <b data-map-grid-preview>@Model.Input.Columns &times; @Model.Input.Rows</b>
                                <span class="map-canvas-sep">|</span> Widget min: <b>2 &times; 2</b>
                                <span class="map-canvas-sep">|</span> Snap: <b class="is-on">ON</b>
                            </small>
                        </button>
                        <div class="map-canvas-tools">
                            <label class="map-canvas-zoom" title="Zoom the design canvas">
                                @* A select, not a slider: the mockup's discrete steps are what people actually
                                   want here, and a range input gives no way to hit exactly 100%. The old
                                   [data-map-scale] contract is unchanged, so the designer needs no change. *@
                                <select class="form-select workspace-select" data-map-scale>
                                    <option value="0.5">50%</option>
                                    <option value="0.75">75%</option>
                                    <option value="1" selected>100%</option>
                                    <option value="1.25">125%</option>
                                    <option value="1.5">150%</option>
                                    <option value="2">200%</option>
                                </select>
                                <span class="map-scale-output" data-map-scale-output hidden>100%</span>
                            </label>
                            <button type="button" class="workspace-secondary-submit map-canvas-fit" data-map-fit-grid title="Reset the zoom so the whole board fits">
                                @MatmonIcons.Render("move")<span>Fit to grid</span>
                            </button>
                        </div>
                    </div>

                    @* Rulers: the grid's own coordinates, so "put it in column 7" stops being guesswork. Each
                       label is positioned as a PERCENTAGE of the logical canvas, computed from the same
                       MapTileRender.GridCells the guide lines use - percentages survive the stage's uniform
                       scale transform, absolute px would not. *@
                    @{
                        var rulerMap = new MonitoringMap
                        {
                            Columns = Model.Input.Columns,
                            Rows = Model.Input.Rows,
                            TilePadding = Model.Input.TilePadding,
                            OuterMargin = Model.Input.OuterMargin,
                            LogicalWidth = logicalSize.Width,
                            LogicalHeight = logicalSize.Height
                        };
                        var rulerCells = MapTileRender.GridCells(rulerMap).ToArray();
                    }
                    <div class="map-canvas-frame" data-map-rulers>
                        <div class="map-ruler map-ruler-columns" aria-hidden="true">
                            @for (var column = 0; column < Model.Input.Columns; column++)
                            {
                                var cell = rulerCells[column];
                                var centre = (cell.X + cell.W / 2.0) / logicalSize.Width * 100;
                                <span style="left: @centre.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%">@(column + 1)</span>
                            }
                        </div>
                        <div class="map-ruler map-ruler-rows" aria-hidden="true">
                            @for (var row = 0; row < Model.Input.Rows; row++)
                            {
                                var cell = rulerCells[row * Model.Input.Columns];
                                var centre = (cell.Y + cell.H / 2.0) / logicalSize.Height * 100;
                                <span style="top: @centre.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%">@(row + 1)</span>
                            }
                        </div>
                    <div class="map-stage" data-map-stage data-map-fit="fit" style="--map-w: @logicalSize.Width; --map-h: @logicalSize.Height;">
                        <div class="map-slide map-slide-editable"
                             data-map-slide
                             data-map-designer
                             data-next-tile-index="@Model.Input.Tiles.Count"
                             style="--map-w: @logicalSize.Width; --map-h: @logicalSize.Height; --tile-gap: @(Model.Input.TilePadding)px;">
                            @* Grid guide lines lined up exactly with the real cells (replaces the old fixed 8px
                               background-grid pattern) - same MapTileRender.GridCells helper _MapSlide.cshtml uses. *@
                            <div class="map-grid-guides" aria-hidden="true">
                                @{
                                    var gridMap = new MonitoringMap
                                    {
                                        Columns = Model.Input.Columns,
                                        Rows = Model.Input.Rows,
                                        TilePadding = Model.Input.TilePadding,
                                        OuterMargin = Model.Input.OuterMargin,
                                        LogicalWidth = logicalSize.Width,
                                        LogicalHeight = logicalSize.Height
                                    };
                                }
                                @foreach (var cell in MapTileRender.GridCells(gridMap))
                                {
                                    <span class="map-grid-cell" style="left: @(cell.X)px; top: @(cell.Y)px; width: @(cell.W)px; height: @(cell.H)px;"></span>
                                }
                            </div>
                            @for (var index = 0; index < Model.TileRenderModels.Count; index++)
                            {
                                <partial name="_MapTile" model="Model.TileRenderModels[index]" />
                            }
                        </div>
                    </div>
                    </div>
                </div>

                <aside class="map-property-editor" aria-label="Properties">
                    <div class="map-designer-side-title">
                        @MatmonIcons.Render("gear")
                        <strong data-map-property-scope-label>Properties</strong>
                    </div>

                    @* Tab bar for the TILE panels. It sits outside them because only one tile panel is visible
                       at a time - keeping the bar here means the chosen tab survives clicking from tile to
                       tile, which a per-panel bar would not. Hidden unless a tile is selected. *@
                    <div class="map-property-tabs" data-map-property-tabs hidden role="tablist">
                        <button type="button" class="map-property-tab is-active" data-map-property-tab="general" role="tab" aria-selected="true">General</button>
                        <button type="button" class="map-property-tab" data-map-property-tab="data" role="tab" aria-selected="false">Data</button>
                        <button type="button" class="map-property-tab" data-map-property-tab="display" role="tab" aria-selected="false">Display</button>
                        <button type="button" class="map-property-tab" data-map-property-tab="advanced" role="tab" aria-selected="false">Advanced</button>
                    </div>

                    @* Nothing selected: the aside shows the CANVAS view settings instead of an empty box.
                       These are deliberately view-only (remembered per browser, never saved on the map) - the
                       board's own geometry stays in the Settings tab, so there is exactly one input per
                       stored property and the two can never drift apart. *@
                    <div class="map-property-empty" data-map-property-empty>
                        <p>Select a widget on the canvas to edit it. The board's own size, grid and wallboard
                           options live in the <strong>Display</strong> and <strong>Settings</strong> tabs.</p>
                        <div class="map-view-settings">
                            <span class="workspace-label">Canvas view</span>
                            <label class="map-switch">
                                <input type="checkbox" checked data-map-view-grid />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Show grid</span>
                            </label>
                            <label class="map-switch">
                                <input type="checkbox" checked data-map-view-rulers />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Show rulers</span>
                            </label>
                            <span class="workspace-inline-note">Affects this browser only - it does not change the board.
                                Widgets always snap: the layout is stored as grid cells, so there is no position between two of them.</span>
                        </div>
                    </div>
                    <div data-map-property-host>
                        @for (var index = 0; index < Model.Input.Tiles.Count; index++)
                        {
                            var tile = Model.Input.Tiles[index];
                            @* Grouped into the General/Data/Display tabs the aside's [data-map-property-tabs]
                               bar drives. The bar lives OUTSIDE the panels on purpose: only one panel is ever
                               visible, and a per-panel bar would reset the chosen tab every time you click a
                               different tile. Mirror any field change in the <template> below. *@
                            <section class="map-property-panel" data-map-property-panel data-tile-index="@index" hidden>
                                @* Header card per mockup: what you have selected, at a glance, with its one
                                   destructive action. It mirrors the tile - the designer keeps icon/title/kind
                                   in step, so the aside never claims to be editing a different widget. *@
                                <header class="map-property-head">
                                    <span class="map-property-head-icon" data-map-property-head-icon>@MatmonIcons.Render(string.IsNullOrWhiteSpace(tile.IconKey) ? "square" : tile.IconKey)</span>
                                    <span class="map-property-head-text">
                                        <strong data-map-property-head-title>@(string.IsNullOrWhiteSpace(tile.Title) ? MapTileRender.KindLabel(tile.Kind) : tile.Title)</strong>
                                        <small data-map-property-head-kind>@MapTileRender.KindLabel(tile.Kind)</small>
                                    </span>
                                    <button type="button" class="map-property-head-remove" data-map-property-remove title="Delete widget" aria-label="Delete widget">@MatmonIcons.Render("trash")</button>
                                </header>
                                <div data-map-prop-group="general">
                                    <label class="workspace-field">
                                        <span class="workspace-label">Title</span>
                                        <input asp-for="Input.Tiles[index].Title" class="form-control workspace-input" data-map-property-title />
                                    </label>
                                    <div class="workspace-field">
                                        <span class="workspace-label">Widget</span>
                                        <input type="hidden" asp-for="Input.Tiles[index].Kind" data-map-property-kind />
                                        <input type="hidden" asp-for="Input.Tiles[index].VisualType" data-map-property-visual-type />
                                        <span class="map-property-readonly" data-map-property-kind-label>@MapTileRender.KindLabel(tile.Kind)</span>
                                    </div>
                                    @* Size is editable here, not only by dragging the handle: a number field is
                                       keyboard reachable and lets you type an exact span, and it is the SAME
                                       input the drag writes into, so the two can never disagree. *@
                                    <div class="map-property-size">
                                        <label class="workspace-field">
                                            <span class="workspace-label">Width (cells)</span>
                                            <input asp-for="Input.Tiles[index].ColumnSpan" type="number" min="1" max="@Model.Input.Columns" class="form-control workspace-input" data-map-tile-column-span />
                                        </label>
                                        <label class="workspace-field">
                                            <span class="workspace-label">Height (cells)</span>
                                            <input asp-for="Input.Tiles[index].RowSpan" type="number" min="1" max="@Model.Input.Rows" class="form-control workspace-input" data-map-tile-row-span />
                                        </label>
                                    </div>
                                    <div class="map-property-size-readout" data-map-property-size>Size @tile.ColumnSpan &times; @tile.RowSpan cells</div>
                                    <div class="map-property-hint" data-map-property-hint></div>
                                </div>
                                <div data-map-prop-group="data" hidden>
                                    <label class="workspace-field" data-map-property-target>
                                        <span class="workspace-label">Target</span>
                                        <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = $"Input.Tiles[{index}].TargetToken", DomId = $"picker-map-tile-{index}", SelectedValue = Model.Input.Tiles[index].TargetToken, AllowTags = true, Placeholder = "No element", Options = Model.TilePickerOptions, ValueAttribute = "data-map-property-element" })" />
                                    </label>
                                    <label class="workspace-field" data-map-property-text-only>
                                        <span class="workspace-label">Text</span>
                                        <textarea asp-for="Input.Tiles[index].Text" class="form-control workspace-input" rows="4" data-map-property-text></textarea>
                                    </label>
                                    <label class="workspace-field" data-map-property-graph-only>
                                        <span class="workspace-label">Graph type</span>
                                        <select asp-for="Input.Tiles[index].GraphType" asp-items="Model.GraphTypeOptions" class="form-select workspace-select" data-map-property-graph-type></select>
                                    </label>
                                    <label class="workspace-field" data-map-property-list-only>
                                        <span class="workspace-label">Order</span>
                                        <select asp-for="Input.Tiles[index].ListMode" class="form-select workspace-select">
                                            <option value="@MonitoringMapListMode.Worst">Worst state first</option>
                                            <option value="@MonitoringMapListMode.TopValue">Highest value first</option>
                                            <option value="@MonitoringMapListMode.BottomValue">Lowest value first</option>
                                            <option value="@MonitoringMapListMode.Alphabetical">By name</option>
                                        </select>
                                    </label>
                                    @* A value / gauge / progress tile has to be told WHICH channel it shows -
                                       a host sensor reports CPU, memory, disk and SMART, and "whichever is
                                       default" is a coin toss. The scale is separate because a dial needs one:
                                       a percentage channel brings its own 0..100, anything else (latency,
                                       throughput, temperature) has to say where full is. *@
                                    <label class="workspace-field" data-map-property-value-only>
                                        <span class="workspace-label">Channel</span>
                                        <input asp-for="Input.Tiles[index].ChannelKey" class="form-control workspace-input" placeholder="Default channel" />
                                        <span class="workspace-inline-note">Channel keys differ per sensor type (e.g. <code>cpu</code>, <code>memory</code>, <code>latency</code>) - the Channels tab of the sensor lists them. Empty = the sensor's own default channel.</span>
                                    </label>
                                    <div class="workspace-field map-property-size" data-map-property-value-only>
                                        <label class="workspace-field">
                                            <span class="workspace-label">Scale from</span>
                                            <input asp-for="Input.Tiles[index].GaugeMin" type="number" step="any" class="form-control workspace-input" placeholder="0" />
                                        </label>
                                        <label class="workspace-field">
                                            <span class="workspace-label">Scale to</span>
                                            <input asp-for="Input.Tiles[index].GaugeMax" type="number" step="any" class="form-control workspace-input" placeholder="100" />
                                        </label>
                                    </div>
                                    <span class="workspace-inline-note" data-map-property-value-only>A gauge or bar needs a scale. Leave both empty for a percentage channel; for anything else set them in the channel's own unit, or the tile shows the plain number instead of inventing a dial position.</span>
                                    <label class="workspace-field" data-map-property-list-only>
                                        <span class="workspace-label">Rank by channel</span>
                                        <input asp-for="Input.Tiles[index].ListChannelKey" class="form-control workspace-input" placeholder="Default channel" />
                                        <span class="workspace-inline-note">Channel keys differ per sensor type - leave empty to use each sensor's default channel.</span>
                                    </label>
                                    <label class="workspace-field" data-map-property-rows-only>
                                        <span class="workspace-label">Rows</span>
                                        <input asp-for="Input.Tiles[index].ListLimit" type="number" min="1" max="50" class="form-control workspace-input" />
                                    </label>
                                    <label class="workspace-field" data-map-property-sla-only>
                                        <span class="workspace-label">Window (days)</span>
                                        <input asp-for="Input.Tiles[index].SlaWindowDays" type="number" min="1" max="365" class="form-control workspace-input" />
                                        <span class="workspace-inline-note">Uptime counts a warning as up - the sensor answered. Needs statistics buckets in the window.</span>
                                    </label>
                                    <div class="workspace-field" data-map-property-image-only>
                                        <span class="workspace-label">Picture</span>
                                        <input type="hidden" asp-for="Input.Tiles[index].ImageAssetId" data-map-property-image-id />
                                        <div class="map-image-upload">
                                            <input type="file" accept="image/png,image/jpeg" class="form-control workspace-input" data-map-image-file />
                                            <button type="button" class="workspace-secondary-submit" data-map-image-clear>Remove</button>
                                        </div>
                                        <span class="workspace-inline-note" data-map-image-status>PNG or JPEG, up to 4 MB. Stored on disk under data/uploads, not in workspace.json.</span>
                                    </div>
                                    <label class="workspace-field" data-map-property-image-only>
                                        <span class="workspace-label">Fit</span>
                                        <select asp-for="Input.Tiles[index].ImageFit" class="form-select workspace-select" data-map-property-image-fit>
                                            <option value="@MonitoringMapImageFit.Contain">Fit inside (no cropping)</option>
                                            <option value="@MonitoringMapImageFit.Cover">Fill and crop</option>
                                            <option value="@MonitoringMapImageFit.Stretch">Stretch</option>
                                        </select>
                                    </label>
                                    <div class="workspace-field" data-map-property-pins-only>
                                        <span class="workspace-label">Pins</span>
                                        <input type="hidden" asp-for="Input.Tiles[index].PinsJson" data-map-property-pins />
                                        <div class="map-pin-editor" data-map-pin-editor></div>
                                        <div class="map-pin-actions">
                                            <button type="button" class="workspace-secondary-submit" data-map-pin-place>Place on picture</button>
                                            <button type="button" class="workspace-secondary-submit" data-map-pin-add>Add pin</button>
                                        </div>
                                        <span class="workspace-inline-note" data-map-pin-hint></span>
                                    </div>
                                </div>
                                <div data-map-prop-group="display" hidden>
                                    <div class="workspace-field icon-picker-field">
                                        <span class="workspace-label">Icon</span>
                                        <input type="hidden" asp-for="Input.Tiles[index].IconKey" data-map-property-icon data-icon-picker-value />
                                        <button type="button" class="form-control workspace-input icon-picker-trigger" data-icon-picker-trigger>
                                            <span class="icon-picker-trigger-glyph" data-icon-picker-trigger-glyph>@MatmonIcons.Render(string.IsNullOrWhiteSpace(tile.IconKey) ? "square" : tile.IconKey)</span>
                                            <span class="icon-picker-trigger-label" data-icon-picker-trigger-label>@(string.IsNullOrWhiteSpace(tile.IconKey) ? "Auto (by type)" : tile.IconKey)</span>
                                            <span class="icon-picker-trigger-caret" aria-hidden="true">&#9662;</span>
                                        </button>
                                    </div>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Background</span>
                                        <input asp-for="Input.Tiles[index].BackgroundColor" class="form-control workspace-input" placeholder="auto or #101827" data-map-property-background />
                                    </label>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Accent</span>
                                        <input asp-for="Input.Tiles[index].AccentColor" class="form-control workspace-input" placeholder="auto or #78d5c8" data-map-property-accent />
                                    </label>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Text color</span>
                                        <input asp-for="Input.Tiles[index].TextColor" class="form-control workspace-input" placeholder="auto or #ffffff" data-map-property-text-color />
                                    </label>
                                    @* Pill toggles per mockup. Still real checkboxes underneath, so they post,
                                       take focus and need no JS - only the track is drawn from :checked. *@
                                    <div class="map-property-switches">
                                        <label class="map-switch">
                                            <input asp-for="Input.Tiles[index].ShowCard" data-map-property-show-card />
                                            <span class="map-switch-track" aria-hidden="true"></span>
                                            <span>Card background</span>
                                        </label>
                                        <label class="map-switch">
                                            <input asp-for="Input.Tiles[index].ShowTitle" data-map-property-show-title />
                                            <span class="map-switch-track" aria-hidden="true"></span>
                                            <span>Show title</span>
                                        </label>
                                        <label class="map-switch">
                                            <input asp-for="Input.Tiles[index].ShowStateBadge" data-map-property-show-badge />
                                            <span class="map-switch-track" aria-hidden="true"></span>
                                            <span>Show state badge</span>
                                        </label>
                                        <label class="map-switch">
                                            <input asp-for="Input.Tiles[index].ShowElementName" />
                                            <span class="map-switch-track" aria-hidden="true"></span>
                                            <span>Show target name</span>
                                        </label>
                                    </div>
                                </div>
                                <div data-map-prop-group="advanced" hidden>
                                    @* Four buckets, not six states: "up / warning / down / unknown" is how
                                       someone configuring a wallboard thinks. MonitoringMapColorRules is where
                                       the six SensorStates collapse into these four, in one place. *@
                                    <span class="workspace-label">Colour rules</span>
                                    <div class="map-color-rules">
                                        @foreach (var bucket in MonitoringMapColorRules.Buckets)
                                        {
                                            var current = tile.ColorRules.TryGetValue(bucket.Key, out var hex) ? hex : string.Empty;
                                            var swatch = BrandingSafety.SafeHexColor(current) ?? MonitoringMapColorRules.DefaultHex(bucket.Key);
                                            <div class="map-color-rule">
                                                <span class="map-color-rule-label">@bucket.Label</span>
                                                @* The swatch is a view control only - the TEXT field is what posts. A colour
                                                   input cannot express "leave it to the theme", which is the default and the
                                                   answer most boards want, so it seeds the text rather than replacing it. *@
                                                <input type="color" class="map-color-swatch" value="@swatch"
                                                       data-map-color-swatch="@bucket.Key" aria-label="@bucket.Label colour"
                                                       tabindex="-1" />
                                                <input type="text" class="form-control workspace-input"
                                                       name="Input.Tiles[@index].ColorRules[@bucket.Key]" value="@current"
                                                       placeholder="theme" data-map-color-rule="@bucket.Key" />
                                                <button type="button" class="map-color-rule-clear" data-map-color-clear="@bucket.Key"
                                                        title="Back to the theme colour" aria-label="Reset @bucket.Label to the theme colour">@MatmonIcons.Render("x")</button>
                                            </div>
                                        }
                                    </div>
                                    <span class="workspace-inline-note">Leave empty to use the theme's own state colours. Only #rrggbb is accepted; anything else is ignored at render time.</span>
                                    <label class="workspace-field">
                                        <span class="workspace-label">Refresh (seconds)</span>
                                        <input asp-for="Input.Tiles[index].RefreshSeconds" type="number" min="0" max="3600" class="form-control workspace-input" placeholder="0" />
                                        <span class="workspace-inline-note">A server-side cache lifetime, not a per-widget timer: 0 keeps the board's own cadence. Useful for a widget whose data is expensive or slow-changing.</span>
                                    </label>
                                </div>
                            </section>
                        }
                    </div>
                </aside>
            </div>

                @* Bottom row per mockup: the slide LIST (reorderable, with duration and a row menu), the
                   rotation settings that only make sense next to it, and a filmstrip preview of the running
                   order. The old plain slide tabs are gone - this replaces them. *@
                <div class="map-editor-bottom">
                    <section class="panel-subcard map-slides-list-card">
                        <div class="map-subcard-head">
                            <h3 class="map-settings-title">Slides <span class="map-count" data-map-slide-count>@Model.Input.Slides.Count</span></h3>
                            <button type="button" class="workspace-secondary-submit" data-map-slide-add>@MatmonIcons.Render("plus")<span>Add slide</span></button>
                        </div>
                        <div class="map-slide-rows" data-map-slide-tabs>
                            @for (var slideIndex = 0; slideIndex < Model.Input.Slides.Count; slideIndex++)
                            {
                                var slide = Model.Input.Slides[slideIndex];
                                <div class="map-slide-row @(slideIndex == 0 ? "is-active" : "")" data-map-slide-tab data-slide-id="@slide.Id"
                                     data-slide-title="@slide.Title" data-slide-subtitle="@slide.Subtitle"
                                     data-slide-duration="@slide.DurationSeconds" data-slide-bg="@slide.BackgroundColor"
                                     data-slide-show-header="@(slide.ShowHeader ? "true" : "false")"
                                     draggable="true">
                                    <span class="map-slide-row-grip" aria-hidden="true">@MatmonIcons.Render("move")</span>
                                    <span class="map-slide-row-index">@(slideIndex + 1)</span>
                                    <span class="map-slide-row-name">@slide.Name</span>
                                    <span class="map-slide-row-duration">@(slide.DurationSeconds is { } seconds ? $"{seconds}s" : "—")</span>
                                    <span class="map-slide-row-actions">
                                        <button type="button" class="map-slide-row-action" data-map-slide-settings title="Slide properties">@MatmonIcons.Render("gear")</button>
                                        <button type="button" class="map-slide-row-action" data-map-slide-duplicate title="Duplicate slide">@MatmonIcons.Render("copy")</button>
                                        <button type="button" class="map-slide-row-action is-danger" data-map-slide-delete title="Delete slide">@MatmonIcons.Render("trash")</button>
                                    </span>
                                </div>
                            }
                        </div>
                        <div data-map-slide-inputs hidden></div>
                    </section>

                    <section class="panel-subcard">
                        <div class="map-subcard-head">
                            <h3 class="map-settings-title">Slide rotation</h3>
                        </div>
                        <p class="map-toolbox-note">Autoplay slides on the operation wall. The in-app viewer stays on manual controls.</p>
                        <label class="map-switch">
                            <input asp-for="Input.AutoRotateEnabled" data-map-autorotate />
                            <span class="map-switch-track" aria-hidden="true"></span>
                            <span>Autoplay</span>
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Default duration</span>
                            @* The stored value is folded into the option list: a select can only post one of
                               its own options, so a board saved at 25 s would have been silently rewritten to
                               the first entry the moment anything else on this page was saved. *@
                            @{
                                var rotationChoices = new[] { 5, 10, 15, 20, 30, 45, 60, 120, 300 }
                                    .Append(Model.Input.AutoRotateSeconds).Distinct().OrderBy(value => value).ToArray();
                            }
                            <select asp-for="Input.AutoRotateSeconds" class="form-select workspace-select">
                                @foreach (var seconds in rotationChoices)
                                {
                                    <option value="@seconds">@seconds seconds</option>
                                }
                            </select>
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Page indicator</span>
                            <select asp-for="Input.PaginationMode" class="form-select workspace-select">
                                <option value="@MonitoringMapPaginationMode.Below">Below the board</option>
                                <option value="@MonitoringMapPaginationMode.OverlayAlways">Overlay - always visible</option>
                                <option value="@MonitoringMapPaginationMode.OverlayOnActivity">Overlay - on activity</option>
                                <option value="@MonitoringMapPaginationMode.Hidden">Hidden</option>
                            </select>
                        </label>
                    </section>

                    <section class="panel-subcard map-preview-card">
                        <div class="map-subcard-head">
                            <h3 class="map-settings-title">Preview &ndash; slide rotation</h3>
                            <span class="workspace-inline-note">@logicalSize.Width &times; @logicalSize.Height</span>
                        </div>
                        @* Real scaled miniatures of each slide, cloned from the live canvas by
                           renderSlidePreviews - a preview that can disagree with the board is worse than none. *@
                        <div class="map-slides-strip" data-map-slide-previews>
                            @for (var slideIndex = 0; slideIndex < Model.Input.Slides.Count; slideIndex++)
                            {
                                var slide = Model.Input.Slides[slideIndex];
                                <button type="button" class="map-slide-card @(slideIndex == 0 ? "is-active" : "")"
                                        data-map-slide-card data-slide-id="@slide.Id">
                                    <span class="map-slide-card-frame">
                                        <span class="map-slide-card-preview" data-map-slide-preview></span>
                                    </span>
                                    <span class="map-slide-card-meta">
                                        <strong>@(slideIndex + 1). @slide.Name</strong>
                                        <small>@(slide.DurationSeconds is { } d ? $"{d}s" : $"{Model.Input.AutoRotateSeconds}s")</small>
                                    </span>
                                </button>
                            }
                        </div>
                    </section>
                </div>
            </div>

            @* --- Slides ------------------------------------------------------------------------------- *@
            @* Slide PROPERTIES only - the filmstrip and the running order live under the canvas in the
               Editor tab (that is where the mockup puts them, and where you actually need them). Clicking a
               slide's gear switches here. *@
            <div class="map-tab-panel" data-sensor-tab="slides">
                <div class="map-settings-grid">

                    <section class="panel-subcard map-slide-panel" data-map-slide-panel>
                        <h3 class="map-settings-title">Selected slide</h3>
                        <label class="workspace-field">
                            <span class="workspace-label">Slide name</span>
                            <input type="text" class="form-control workspace-input" data-map-slide-field="name" />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Heading</span>
                            <input type="text" class="form-control workspace-input" data-map-slide-field="title" placeholder="Shown on the board" />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Sub-heading</span>
                            <input type="text" class="form-control workspace-input" data-map-slide-field="subtitle" />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Duration (seconds)</span>
                            <input type="number" min="3" max="600" class="form-control workspace-input" data-map-slide-field="durationSeconds" placeholder="Map default" />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Background</span>
                            <input type="text" class="form-control workspace-input" data-map-slide-field="backgroundColor" placeholder="auto or #0b1220" />
                        </label>
                        <div class="map-property-checks">
                            <label><input type="checkbox" data-map-slide-field="showHeader" /> <span>Show this slide heading</span></label>
                        </div>
                        <div class="map-property-hint">Duration overrides the map auto-rotate for this slide only. Drag a card to reorder.</div>
                        <div data-map-prop-group="advanced" hidden>
                            @* Four buckets, not six states: "up / warning / down / unknown" is how
                               someone configuring a wallboard thinks. MonitoringMapColorRules is where
                               the six SensorStates collapse into these four, in one place. *@
                            <span class="workspace-label">Colour rules</span>
                            <div class="map-color-rules">
                                @foreach (var bucket in MonitoringMapColorRules.Buckets)
                                {
                            var current = string.Empty;
                            <label class="map-color-rule">
                                <span>@bucket.Label</span>
                                <input type="text" class="form-control workspace-input"
                                       name="Input.Tiles[__index__].ColorRules[@bucket.Key]" value="@current"
                                       placeholder="theme" data-map-color-rule="@bucket.Key" />
                            </label>
                                }
                            </div>
                            <span class="workspace-inline-note">Leave empty to use the theme's own state colours. Only #rrggbb is accepted; anything else is ignored at render time.</span>
                            <label class="workspace-field">
                                <span class="workspace-label">Refresh (seconds)</span>
                                <input name="Input.Tiles[__index__].RefreshSeconds" value="0" type="number" min="0" max="3600" class="form-control workspace-input" placeholder="0" />
                                <span class="workspace-inline-note">A server-side cache lifetime, not a per-widget timer: 0 keeps the board's own cadence. Useful for a widget whose data is expensive or slow-changing.</span>
                            </label>
                        </div>
                    </section>
                </div>
            </div>

            @* --- Display ------------------------------------------------------------------------------- *@
            <div class="map-tab-panel" data-sensor-tab="display">
                <div class="map-settings-grid">
                    <section class="panel-subcard">
                        <h3 class="map-settings-title">Canvas</h3>
                        <div class="workspace-field">
                            <span class="workspace-label">Aspect ratio</span>
                            <div class="map-aspect-presets">
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="16" data-aspect-h="9">16:9</button>
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="16" data-aspect-h="10">16:10</button>
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="21" data-aspect-h="9">21:9</button>
                                <button type="button" class="map-aspect-preset" data-map-aspect-preset data-aspect-w="4" data-aspect-h="3">4:3</button>
                            </div>
                            <div class="map-aspect-custom">
                                <input asp-for="Input.AspectRatioWidth" type="number" min="1" max="64" class="form-control workspace-input" data-map-aspect-w aria-label="Aspect ratio width" />
                                <span class="map-aspect-colon">:</span>
                                <input asp-for="Input.AspectRatioHeight" type="number" min="1" max="64" class="form-control workspace-input" data-map-aspect-h aria-label="Aspect ratio height" />
                            </div>
                            <span class="workspace-inline-note">Only the ratio matters &mdash; the board scales to any screen. Widgets keep their grid cell position and size regardless of it.</span>
                        </div>
                        <label class="workspace-field">
                            <span class="workspace-label">Wallboard fit</span>
                            <select asp-for="Input.WallboardFit" class="form-select workspace-select">
                                <option value="@MonitoringMapWallboardFit.Fit">Keep ratio (letterbox)</option>
                                <option value="@MonitoringMapWallboardFit.Stretch">Stretch to fill screen</option>
                            </select>
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Board timezone</span>
                            <input asp-for="Input.DisplayTimeZoneId" class="form-control workspace-input" placeholder="Platform default, e.g. Europe/Berlin" list="map-timezone-list" />
                            <datalist id="map-timezone-list">
                                @foreach (var zone in TimeZoneInfo.GetSystemTimeZones().Select(z => z.Id).OrderBy(z => z, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@zone"></option>
                                }
                            </datalist>
                            <span class="workspace-inline-note">Used by the clock widget. Per map, because the public wallboard has nobody signed in whose preference could apply.</span>
                        </label>
                    </section>

                    <section class="panel-subcard">
                        <h3 class="map-settings-title">Rotation</h3>
                        @* Autoplay, the per-slide duration and the page indicator live beside the slide list on
                           the Editor tab - they are about the running order, and that is where you are looking
                           when you set them. They are NOT repeated here: two inputs bound to one property post
                           whichever the binder sees first, so the one you edited can silently lose. *@
                        <div class="map-property-hint">
                            Autoplay, the slide duration and the page indicator sit next to the slide list on the
                            <strong>Editor</strong> tab. They drive the public wallboard when a board has more than
                            one slide; the in-app viewer stays on manual controls.
                        </div>
                        <div class="map-property-switches">
                            <label class="map-switch">
                                <input asp-for="Input.ShowSlideHeaders" data-map-show-slide-headers />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Show slide headings on the board</span>
                            </label>
                        </div>
                    </section>
                </div>
            </div>

            @* --- Settings ------------------------------------------------------------------------------ *@
            <div class="map-tab-panel" data-sensor-tab="settings">
                <div class="map-settings-grid">
                    <section class="panel-subcard">
                        <h3 class="map-settings-title">Board</h3>
                        <label class="workspace-field">
                            <span class="workspace-label">Name</span>
                            <input asp-for="Input.Name" class="form-control workspace-input" data-map-name />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Description</span>
                            <input asp-for="Input.Description" class="form-control workspace-input" data-map-description />
                        </label>
                        <div class="map-property-checks">
                            <label><input asp-for="Input.PublicEnabled" data-map-public-enabled /> <span>Publish an anonymous link</span></label>
                        </div>
                        <div class="map-property-hint">
                            The public link needs no sign-in - anyone holding it sees the board. Turning this off makes the link 404 immediately, including its live-data endpoint. Copy or rotate the link on the Maps page.
                        </div>
                    </section>

                    @* Grid geometry is authoritative under v2 - this is exactly why cells were chosen over
                       pixels: change the column count and every widget flows with it instead of standing still. *@
                    <section class="panel-subcard">
                        <h3 class="map-settings-title">Grid</h3>
                        <div class="map-grid-fields">
                            <label class="workspace-field">
                                <span class="workspace-label">Columns</span>
                                <input asp-for="Input.Columns" type="number" min="2" max="48" class="form-control workspace-input" data-map-columns />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Rows</span>
                                <input asp-for="Input.Rows" type="number" min="2" max="32" class="form-control workspace-input" data-map-rows />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Gap (px)</span>
                                <input asp-for="Input.TilePadding" type="number" min="0" max="80" class="form-control workspace-input" data-map-tile-padding />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Margin (px)</span>
                                <input asp-for="Input.OuterMargin" type="number" min="0" max="160" class="form-control workspace-input" data-map-outer-margin />
                            </label>
                        </div>
                        <span class="workspace-inline-note">Gap and margin are in logical canvas pixels (the canvas is 1920 wide whatever the screen), so they scale with the board. Widgets are re-clamped into the new grid when you commit a change.</span>
                    </section>
                </div>
            </div>

            @* One pin row, cloned per pin by the designer. The target uses the SAME element picker as
               everything else (cloned, ids rewritten) rather than a long native select - pins are not special
               enough to deserve their own target UI. Nothing here is model-bound: the designer serialises the
               rows into the tile's single PinsJson field. *@
            <template data-map-pin-template>
                <div class="map-pin-row" data-map-pin-row data-pin-id="__pinId__">
                    <div class="map-pin-row-main">
                        <input type="text" class="form-control workspace-input" data-pin-field="label" placeholder="Label" />
                        <select class="form-select workspace-select" data-pin-field="style">
                            <option value="Dot">Dot</option>
                            <option value="Tile">Mini tile</option>
                        </select>
                        <button type="button" class="map-pin-row-remove" data-map-pin-remove aria-label="Remove pin">@MatmonIcons.Render("trash")</button>
                    </div>
                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = string.Empty, DomId = "picker-map-pin-__pinId__", AllowTags = true, Placeholder = "No target", Options = Model.TilePickerOptions, ValueAttribute = "data-pin-field-target" })" />
                    <div class="map-pin-row-geo" data-map-pin-geo hidden>
                        <input type="number" step="0.0001" min="-90" max="90" class="form-control workspace-input" data-pin-field="latitude" placeholder="Latitude" aria-label="Latitude" />
                        <input type="number" step="0.0001" min="-180" max="180" class="form-control workspace-input" data-pin-field="longitude" placeholder="Longitude" aria-label="Longitude" />
                    </div>
                </div>
            </template>
            <template data-map-tile-template>
                <article class="map-tile map-tile-editor"
                         data-map-tile
                         data-tile-index="__index__"
                         data-slide-id="__slideId__"
                         data-tile-id="__id__"
                         data-state="unknown"
                         data-kind="__kindLower__"
                         data-visual="__visual__"
                         style="--tile-x: 0; --tile-y: 0; --tile-w: 100; --tile-h: 100;">
                    <input type="hidden" name="Input.Tiles[__index__].Id" value="__id__" />
                    <input type="hidden" name="Input.Tiles[__index__].SlideId" value="__slideId__" data-map-tile-slide-id />
                    <input type="hidden" name="Input.Tiles[__index__].IsDeleted" value="false" data-map-tile-deleted />
                    <input type="hidden" name="Input.Tiles[__index__].Column" value="__column__" data-map-tile-column />
                    <input type="hidden" name="Input.Tiles[__index__].Row" value="__row__" data-map-tile-row />

                    <div class="map-tile-head map-tile-drag-handle" data-map-drag-handle>
                        <span class="map-tile-icon">@MatmonIcons.Render("square")</span>
                        <strong data-tile-title>__title__</strong>
                        <button type="button" class="map-tile-remove" data-map-remove-tile aria-label="Remove tile">@MatmonIcons.Render("trash")</button>
                    </div>
                    <p data-tile-subtitle>No target selected</p>
                    <small data-map-tile-kind-label>__kindLabel__</small>
                    <span class="map-tile-size-badge" data-map-tile-size-badge aria-hidden="true">__colSpan__ × __rowSpan__</span>
                    <span class="map-tile-resize-handle" data-map-resize-handle aria-hidden="true"></span>
                </article>
                @* Property panel for a freshly dropped tile. Kept field-for-field identical to the
                   server-rendered one above - only grouped into the same General/Data/Display tabs, which the
                   designer toggles via [data-map-prop-group]. Any field added here must be added there too. *@
                <section class="map-property-panel" data-map-property-panel data-tile-index="__index__" hidden>
                    <header class="map-property-head">
                        <span class="map-property-head-icon" data-map-property-head-icon>@MatmonIcons.Render("square")</span>
                        <span class="map-property-head-text">
                            <strong data-map-property-head-title>__title__</strong>
                            <small data-map-property-head-kind>__kindLabel__</small>
                        </span>
                        <button type="button" class="map-property-head-remove" data-map-property-remove title="Delete widget" aria-label="Delete widget">@MatmonIcons.Render("trash")</button>
                    </header>
                    <div data-map-prop-group="general">
                        <label class="workspace-field">
                            <span class="workspace-label">Title</span>
                            <input name="Input.Tiles[__index__].Title" value="__title__" class="form-control workspace-input" data-map-property-title />
                        </label>
                        <div class="workspace-field">
                            <span class="workspace-label">Widget</span>
                            <input type="hidden" name="Input.Tiles[__index__].Kind" value="__kind__" data-map-property-kind />
                            <input type="hidden" name="Input.Tiles[__index__].VisualType" value="__visual__" data-map-property-visual-type />
                            <span class="map-property-readonly" data-map-property-kind-label>__kindLabel__</span>
                        </div>
                        <div class="map-property-size">
                            <label class="workspace-field">
                                <span class="workspace-label">Width (cells)</span>
                                <input name="Input.Tiles[__index__].ColumnSpan" value="__colSpan__" type="number" min="1" max="@Model.Input.Columns" class="form-control workspace-input" data-map-tile-column-span />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Height (cells)</span>
                                <input name="Input.Tiles[__index__].RowSpan" value="__rowSpan__" type="number" min="1" max="@Model.Input.Rows" class="form-control workspace-input" data-map-tile-row-span />
                            </label>
                        </div>
                        <div class="map-property-size-readout" data-map-property-size>Size __colSpan__ x __rowSpan__ cells</div>
                        <div class="map-property-hint" data-map-property-hint></div>
                    </div>
                    <div data-map-prop-group="data" hidden>
                        <label class="workspace-field" data-map-property-target>
                            <span class="workspace-label">Target</span>
                            <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "Input.Tiles[__index__].TargetToken", DomId = "picker-map-tile-__index__", SelectedValue = null, AllowTags = true, Placeholder = "No element", Options = Model.TilePickerOptions, ValueAttribute = "data-map-property-element" })" />
                        </label>
                        <label class="workspace-field" data-map-property-text-only>
                            <span class="workspace-label">Text</span>
                            <textarea name="Input.Tiles[__index__].Text" class="form-control workspace-input" rows="4" data-map-property-text></textarea>
                        </label>
                        <label class="workspace-field" data-map-property-graph-only>
                            <span class="workspace-label">Graph type</span>
                            <select name="Input.Tiles[__index__].GraphType" class="form-select workspace-select" data-map-property-graph-type>
                                <option value="@MonitoringMapTileGraphType.Line">Line</option>
                                <option value="@MonitoringMapTileGraphType.Area">Area</option>
                                <option value="@MonitoringMapTileGraphType.Bars">Bars</option>
                                <option value="@MonitoringMapTileGraphType.Smooth">Smooth</option>
                            </select>
                        </label>
                        <label class="workspace-field" data-map-property-value-only>
                            <span class="workspace-label">Channel</span>
                            <input name="Input.Tiles[__index__].ChannelKey" class="form-control workspace-input" placeholder="Default channel" />
                        </label>
                        <div class="workspace-field map-property-size" data-map-property-value-only>
                            <label class="workspace-field">
                                <span class="workspace-label">Scale from</span>
                                <input name="Input.Tiles[__index__].GaugeMin" type="number" step="any" class="form-control workspace-input" placeholder="0" />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Scale to</span>
                                <input name="Input.Tiles[__index__].GaugeMax" type="number" step="any" class="form-control workspace-input" placeholder="100" />
                            </label>
                        </div>
                        <span class="workspace-inline-note" data-map-property-value-only>Leave the scale empty for a percentage channel; set it in the channel's own unit for anything else.</span>
                        <label class="workspace-field" data-map-property-list-only>
                            <span class="workspace-label">Order</span>
                            <select name="Input.Tiles[__index__].ListMode" class="form-select workspace-select">
                                <option value="@MonitoringMapListMode.Worst">Worst state first</option>
                                <option value="@MonitoringMapListMode.TopValue">Highest value first</option>
                                <option value="@MonitoringMapListMode.BottomValue">Lowest value first</option>
                                <option value="@MonitoringMapListMode.Alphabetical">By name</option>
                            </select>
                        </label>
                        <label class="workspace-field" data-map-property-list-only>
                            <span class="workspace-label">Rank by channel</span>
                            <input name="Input.Tiles[__index__].ListChannelKey" class="form-control workspace-input" placeholder="Default channel" />
                            <span class="workspace-inline-note">Channel keys differ per sensor type - leave empty to use each sensor's default channel.</span>
                        </label>
                        <label class="workspace-field" data-map-property-rows-only>
                            <span class="workspace-label">Rows</span>
                            <input name="Input.Tiles[__index__].ListLimit" type="number" min="1" max="50" value="5" class="form-control workspace-input" />
                        </label>
                        <label class="workspace-field" data-map-property-sla-only>
                            <span class="workspace-label">Window (days)</span>
                            <input name="Input.Tiles[__index__].SlaWindowDays" type="number" min="1" max="365" value="7" class="form-control workspace-input" />
                            <span class="workspace-inline-note">Uptime counts a warning as up - the sensor answered. Needs statistics buckets in the window.</span>
                        </label>
                        <div class="workspace-field" data-map-property-image-only>
                            <span class="workspace-label">Picture</span>
                            <input type="hidden" name="Input.Tiles[__index__].ImageAssetId" data-map-property-image-id />
                            <div class="map-image-upload">
                                <input type="file" accept="image/png,image/jpeg" class="form-control workspace-input" data-map-image-file />
                                <button type="button" class="workspace-secondary-submit" data-map-image-clear>Remove</button>
                            </div>
                            <span class="workspace-inline-note" data-map-image-status>PNG or JPEG, up to 4 MB. Stored on disk under data/uploads, not in workspace.json.</span>
                        </div>
                        <label class="workspace-field" data-map-property-image-only>
                            <span class="workspace-label">Fit</span>
                            <select name="Input.Tiles[__index__].ImageFit" class="form-select workspace-select" data-map-property-image-fit>
                                <option value="@MonitoringMapImageFit.Contain">Fit inside (no cropping)</option>
                                <option value="@MonitoringMapImageFit.Cover">Fill and crop</option>
                                <option value="@MonitoringMapImageFit.Stretch">Stretch</option>
                            </select>
                        </label>
                        <div class="workspace-field" data-map-property-pins-only>
                            <span class="workspace-label">Pins</span>
                            <input type="hidden" name="Input.Tiles[__index__].PinsJson" data-map-property-pins />
                            <div class="map-pin-editor" data-map-pin-editor></div>
                            <div class="map-pin-actions">
                                <button type="button" class="workspace-secondary-submit" data-map-pin-place>Place on picture</button>
                                <button type="button" class="workspace-secondary-submit" data-map-pin-add>Add pin</button>
                            </div>
                            <span class="workspace-inline-note" data-map-pin-hint></span>
                        </div>
                    </div>
                    <div data-map-prop-group="display" hidden>
                        <div class="workspace-field icon-picker-field">
                            <span class="workspace-label">Icon</span>
                            <input type="hidden" name="Input.Tiles[__index__].IconKey" value="" data-map-property-icon data-icon-picker-value />
                            <button type="button" class="form-control workspace-input icon-picker-trigger" data-icon-picker-trigger>
                                <span class="icon-picker-trigger-glyph" data-icon-picker-trigger-glyph>@MatmonIcons.Render("square")</span>
                                <span class="icon-picker-trigger-label" data-icon-picker-trigger-label>Auto (by type)</span>
                                <span class="icon-picker-trigger-caret" aria-hidden="true">&#9662;</span>
                            </button>
                        </div>
                        <label class="workspace-field">
                            <span class="workspace-label">Background</span>
                            <input name="Input.Tiles[__index__].BackgroundColor" class="form-control workspace-input" placeholder="auto or #101827" data-map-property-background />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Accent</span>
                            <input name="Input.Tiles[__index__].AccentColor" class="form-control workspace-input" placeholder="auto or #78d5c8" data-map-property-accent />
                        </label>
                        <label class="workspace-field">
                            <span class="workspace-label">Text color</span>
                            <input name="Input.Tiles[__index__].TextColor" class="form-control workspace-input" placeholder="auto or #ffffff" data-map-property-text-color />
                        </label>
                        <div class="map-property-switches">
                            <label class="map-switch">
                                <input name="Input.Tiles[__index__].ShowCard" type="checkbox" value="true" checked data-map-property-show-card /><input name="Input.Tiles[__index__].ShowCard" type="hidden" value="false" />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Card background</span>
                            </label>
                            <label class="map-switch">
                                <input name="Input.Tiles[__index__].ShowTitle" type="checkbox" value="true" checked data-map-property-show-title /><input name="Input.Tiles[__index__].ShowTitle" type="hidden" value="false" />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Show title</span>
                            </label>
                            <label class="map-switch">
                                <input name="Input.Tiles[__index__].ShowStateBadge" type="checkbox" value="true" checked data-map-property-show-badge /><input name="Input.Tiles[__index__].ShowStateBadge" type="hidden" value="false" />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Show state badge</span>
                            </label>
                            <label class="map-switch">
                                <input name="Input.Tiles[__index__].ShowElementName" type="checkbox" value="true" checked /><input name="Input.Tiles[__index__].ShowElementName" type="hidden" value="false" />
                                <span class="map-switch-track" aria-hidden="true"></span>
                                <span>Show target name</span>
                            </label>
                        </div>
                    </div>
                    @* The Advanced group has to exist in the template too - a freshly dropped tile otherwise
                       showed an empty Advanced tab until the first save. *@
                    <div data-map-prop-group="advanced" hidden>
                        <span class="workspace-label">Colour rules</span>
                        <div class="map-color-rules">
                            @foreach (var bucket in MonitoringMapColorRules.Buckets)
                            {
                                <div class="map-color-rule">
                                    <span class="map-color-rule-label">@bucket.Label</span>
                                    <input type="color" class="map-color-swatch" value="@MonitoringMapColorRules.DefaultHex(bucket.Key)"
                                           data-map-color-swatch="@bucket.Key" aria-label="@bucket.Label colour" tabindex="-1" />
                                    <input type="text" class="form-control workspace-input"
                                           name="Input.Tiles[__index__].ColorRules[@bucket.Key]" value=""
                                           placeholder="theme" data-map-color-rule="@bucket.Key" />
                                    <button type="button" class="map-color-rule-clear" data-map-color-clear="@bucket.Key"
                                            title="Back to the theme colour" aria-label="Reset @bucket.Label to the theme colour">@MatmonIcons.Render("x")</button>
                                </div>
                            }
                        </div>
                        <span class="workspace-inline-note">Leave empty to use the theme's own state colours. Only #rrggbb is accepted; anything else is ignored at render time.</span>
                        <label class="workspace-field">
                            <span class="workspace-label">Refresh (seconds)</span>
                            <input name="Input.Tiles[__index__].RefreshSeconds" type="number" min="0" max="3600" class="form-control workspace-input" placeholder="0" />
                            <span class="workspace-inline-note">A server-side cache lifetime, not a per-widget timer: 0 keeps the board's own cadence.</span>
                        </label>
                    </div>
                </section>
            </template>

            @* Save lives in the page header (mockup), so only the destructive action stays down here. *@
            <div class="page-actions workspace-toolbar">
                @if (!Model.IsCreateMode)
                {
                    <span class="workspace-form-actions-spacer"></span>
                    <button type="submit" asp-page-handler="Delete" formnovalidate class="workspace-danger-submit" onclick="return confirm('Delete this map?');">@MatmonIcons.Render("trash")<span>Delete map</span></button>
                }
            </div>
        </section>
    </form>
</section>

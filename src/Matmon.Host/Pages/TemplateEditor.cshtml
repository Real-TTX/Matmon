@page "/monitoring/template"
@model WorkspaceModel
@{
    var isCreateMode = Model.SelectedTemplateId is null || Model.TemplateEditor.Id == Guid.Empty;
    var backUrl = Model.GetSafeReturnUrl("/Templates");
    var isSensorScope = Model.TemplateEditor.TargetKind == MonitoringTemplateScope.Sensor;
    var selectedParentLabel = Model.TemplateEditor.ParentOptions.FirstOrDefault(option => option.Selected)?.Text ?? "No parent";
    var templateParameterCount = string.IsNullOrWhiteSpace(Model.TemplateEditor.ParametersText)
        ? 0
        : Model.TemplateEditor.ParametersText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length;
    var templateCredentialCount = Model.TemplateEditor.CredentialBundles.Count(credential => !credential.IsDeleted);
    var templateChannelCount = Model.TemplateEditor.SensorChannelThresholdFields.Count(field => !field.IsDeleted);
    var impactCount = Model.TemplateEditor.ImpactRows.Count;

    if (isCreateMode)
    {
        ViewData["Title"] = "New template";
        ViewData["Width"] = "narrow";
    }
    else
    {
        ViewData["Title"] = string.IsNullOrWhiteSpace(Model.TemplateEditor.Name) ? "Template" : Model.TemplateEditor.Name;
        ViewData["PageSub"] = $"{Model.TemplateEditor.TargetKind} template";
    }
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (isCreateMode)
{
    <form method="post" asp-page-handler="CreateTemplate" class="mat-form" novalidate data-template-scope-form>
        <input type="hidden" asp-for="ReturnUrl" />

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("template")<h2 class="mat-card__title">Scope</h2><span class="mat-text-muted mm-push-end">where it can be used</span></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewTemplate.Name">Name</label>
                        <input asp-for="NewTemplate.Name" class="mat-input" placeholder="Windows Health" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewTemplate.TargetKind">Scope</label>
                        <select asp-for="NewTemplate.TargetKind" class="mat-select" data-template-scope-select>
                            @foreach (var scope in Enum.GetValues<MonitoringTemplateScope>())
                            {
                                <option value="@((int)scope)">@scope</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("layers")<h2 class="mat-card__title">Inheritance</h2><span class="mat-text-muted mm-push-end">optional parent</span></div>
            <div class="mat-card__body mat-stack">
                <div class="mat-form__grid">
                    <div class="mat-field" data-template-sensor-only>
                        <label class="mat-label" asp-for="NewTemplate.SensorTypeKey">Sensor type</label>
                        <select asp-for="NewTemplate.SensorTypeKey" class="mat-select" asp-items="Model.View.SensorTypeOptions"></select>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-label" asp-for="NewTemplate.ParentTemplateId">Parent template</label>
                        <select asp-for="NewTemplate.ParentTemplateId" class="mat-select" asp-items="Model.View.TemplateParentOptions">
                            <option value="">No parent</option>
                        </select>
                    </div>
                </div>
                <p class="mat-muted">Parent templates are living defaults. Changes in the parent flow through unless this template overrides the same field.</p>
            </div>
        </section>

        <div class="mat-alert mat-alert--info">@MatUi.Icon("info")<div class="mat-alert__body"><span class="mat-alert__title">Configure - the next step</span>After creating the shell, Matmon opens this template again so you can define defaults, credentials, thresholds and impact in one place.</div></div>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary" data-default-submit>@MatUi.Icon("plus")<span>Create</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
        </div>
    </form>
}
else
{
    <div class="mat-grid mat-grid--4">
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Scope</span>
                <span class="mat-stat__value mat-text-truncate">@Model.TemplateEditor.TargetKind</span>
                @if (isSensorScope)
                {
                    <span class="mat-stat__delta mat-mono">@Model.TemplateEditor.SensorTypeKey</span>
                }
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Parent</span>
                <span class="mat-stat__value mat-text-truncate" title="@selectedParentLabel">@selectedParentLabel</span>
                <span class="mat-stat__delta">blank fields inherit</span>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Impact</span>
                <span class="mat-stat__value">@impactCount</span>
                <span class="mat-stat__delta">affected sensors</span>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Content</span>
                <span class="mat-stat__value mat-text-truncate">@templateCredentialCount creds</span>
                <span class="mat-stat__delta">@templateParameterCount params / @templateChannelCount channels</span>
            </div>
        </div>
    </div>

    <form method="post" asp-page-handler="SaveTemplate" class="mat-form" novalidate data-template-scope-form>
        <input type="hidden" asp-for="TemplateEditor.Id" />
        <input type="hidden" asp-for="ReturnUrl" />
        @* Rebuilds the parameter/threshold fields server-side when the sensor type changes. *@
        <button type="submit" asp-page-handler="PreviewSensorFields" formnovalidate hidden data-sensor-preview-submit>Preview</button>

        <div class="mat-alert mat-alert--danger" role="alert" data-validation-summary hidden>@MatUi.Icon("x-circle")<div class="mat-alert__body"><strong>Please check the form.</strong><ul class="mat-alert__list"></ul></div></div>

        <section data-tabs data-tab-hash>
            <div class="mat-tabs" role="tablist" aria-label="Template sections">
                <button type="button" class="mat-tab" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="true">General</button>
                <button type="button" class="mat-tab" role="tab" id="tab-parameters" aria-controls="panel-parameters" aria-selected="false" tabindex="-1">Parameters</button>
                <button type="button" class="mat-tab" role="tab" id="tab-credentials" aria-controls="panel-credentials" aria-selected="false" tabindex="-1">Credentials</button>
                <button type="button" class="mat-tab" role="tab" id="tab-thresholds" aria-controls="panel-thresholds" aria-selected="false" tabindex="-1">Channels</button>
                <button type="button" class="mat-tab" role="tab" id="tab-schedule" aria-controls="panel-schedule" aria-selected="false" tabindex="-1">Schedule</button>
                <button type="button" class="mat-tab" role="tab" id="tab-telemetry" aria-controls="panel-telemetry" aria-selected="false" tabindex="-1">Telemetry</button>
                <button type="button" class="mat-tab" role="tab" id="tab-impact" aria-controls="panel-impact" aria-selected="false" tabindex="-1">Impact</button>
            </div>

            @* ---------- GENERAL ---------- *@
            <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-general" aria-labelledby="tab-general">
                <section class="mat-card">
                    <div class="mat-card__head">@MatUi.Icon("template")<h2 class="mat-card__title">Scope &amp; inheritance</h2><span class="mat-text-muted mm-push-end">name, parent &amp; defaults</span></div>
                    <div class="mat-card__body mat-stack">
                        <div class="mat-form__grid">
                            <div class="mat-field mat-field--full">
                                <label class="mat-label" asp-for="TemplateEditor.Name">Name</label>
                                <input asp-for="TemplateEditor.Name" class="mat-input" />
                            </div>
                            <div class="mat-field mat-field--full">
                                <label class="mat-label" asp-for="TemplateEditor.TagsText">Tags</label>
                                <input asp-for="TemplateEditor.TagsText" class="mat-input" placeholder="prod, network" data-tag-input aria-describedby="template-tags-hint" />
                                <partial name="_TagSuggestions" model="Model.View.AllTags" />
                                <span class="mat-hint" id="template-tags-hint">Comma-separated. Merged into an element's tags when this template is applied.</span>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.TargetKind">Scope</label>
                                <select asp-for="TemplateEditor.TargetKind" class="mat-select" data-template-scope-select>
                                    @foreach (var scope in Enum.GetValues<MonitoringTemplateScope>())
                                    {
                                        <option value="@((int)scope)">@scope</option>
                                    }
                                </select>
                            </div>
                            <div class="mat-field" data-template-sensor-only>
                                <label class="mat-label" asp-for="TemplateEditor.SensorTypeKey">Sensor type</label>
                                <select asp-for="TemplateEditor.SensorTypeKey" class="mat-select" asp-items="Model.View.SensorTypeOptions" data-sensor-type-select></select>
                            </div>
                            @if (isSensorScope)
                            {
                                <div class="mat-field">
                                    <label class="mat-label" asp-for="TemplateEditor.Highlight">Highlight</label>
                                    <select asp-for="TemplateEditor.Highlight" class="mat-select">
                                        <option value="">@(string.IsNullOrWhiteSpace(Model.TemplateEditor.HighlightInheritedLabel) || string.Equals(Model.TemplateEditor.HighlightInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.TemplateEditor.HighlightInheritedLabel})")</option>
                                        <option value="true">on</option>
                                        <option value="false">off</option>
                                    </select>
                                </div>
                            }
                            <div class="mat-field mat-field--full">
                                <label class="mat-label" asp-for="TemplateEditor.ParentTemplateId">Parent</label>
                                <select asp-for="TemplateEditor.ParentTemplateId" class="mat-select" asp-items="Model.TemplateEditor.ParentOptions">
                                    <option value="">No parent</option>
                                </select>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.EnabledMode">Enabled</label>
                                <select asp-for="TemplateEditor.EnabledMode" class="mat-select">
                                    <option value="inherit">@(string.IsNullOrWhiteSpace(Model.TemplateEditor.EnabledInheritedLabel) || string.Equals(Model.TemplateEditor.EnabledInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.TemplateEditor.EnabledInheritedLabel})")</option>
                                    <option value="enabled">enabled</option>
                                    <option value="disabled">disabled</option>
                                </select>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.TimeoutSeconds">Timeout</label>
                                <input asp-for="TemplateEditor.TimeoutSeconds" type="number" min="1" class="mat-input" placeholder="@Model.TemplateEditor.TimeoutSecondsPlaceholder" />
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.RetryCount">Retries</label>
                                <input asp-for="TemplateEditor.RetryCount" type="number" min="0" class="mat-input" placeholder="@Model.TemplateEditor.RetryCountPlaceholder" />
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                        </div>
                        <p class="mat-muted">Parent templates are living defaults. Empty fields keep inheriting from the parent or from higher elements.</p>
                    </div>
                </section>
            </div>

            @* ---------- CREDENTIALS (bundles the template carries; a sensor template may pick one) ---------- *@
            <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-credentials" aria-labelledby="tab-credentials" hidden>
                <section class="mat-card">
                    <div class="mat-card__head">@MatUi.Icon("key")<h2 class="mat-card__title">Credentials</h2><span class="mat-text-muted mm-push-end">inherited access</span></div>
                    <div class="mat-card__body mat-stack">
                        <p class="mat-muted">Define reusable credentials here. Sensors automatically pick the first inherited bundle with the matching credential type. Sensor templates may optionally select a specific bundle.</p>

                        @if (isSensorScope)
                        {
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.SelectedCredentialId">Credential selection</label>
                                <select asp-for="TemplateEditor.SelectedCredentialId" class="mat-select" asp-items="Model.TemplateEditor.CredentialOptions"></select>
                            </div>
                        }

                        <div class="mat-stack" data-credential-section>
                            <p class="mat-text-muted" data-credential-empty hidden="@(Model.TemplateEditor.CredentialBundleVisibleCount > 0 ? "hidden" : null)">No credentials yet.</p>
                            <ul class="mat-listgroup credential-list" data-credential-list>
                                @for (var i = 0; i < Model.TemplateEditor.CredentialBundles.Count; i++)
                                {
                                    var credential = Model.TemplateEditor.CredentialBundles[i];
                                    var isHidden = i >= Model.TemplateEditor.CredentialBundleVisibleCount || credential.IsDeleted;
                                    var dialogId = $"template-credential-{i}";
                                    <li class="mat-listgroup__item credential-row" data-credential-row data-credential-deleted="@(credential.IsDeleted ? "true" : "false")" hidden="@(isHidden ? "hidden" : null)">
                                        <input type="hidden" asp-for="TemplateEditor.CredentialBundles[i].Id" />
                                        <input type="hidden" asp-for="TemplateEditor.CredentialBundles[i].IsDeleted" />
                                        @MatUi.Icon("key")
                                        <span class="mat-listgroup__text"><strong data-credential-name-label>@(string.IsNullOrWhiteSpace(credential.Name) ? "New credential" : credential.Name)</strong></span>
                                        <span class="mat-tag" data-credential-kind-label>@credential.Kind</span>
                                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-credential-edit data-dialog-open="@dialogId">@MatUi.Icon("edit")<span>Edit</span></button>
                                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-credential-delete aria-label="Delete credential" data-tip="Delete credential">@MatUi.Icon("trash")</button>

                                        <dialog class="mat-dialog" id="@dialogId" aria-labelledby="@(dialogId + "-title")" data-credential-modal>
                                            <div class="mat-dialog__form">
                                                <div class="mat-dialog__head">
                                                    @MatUi.Icon("key")
                                                    <h2 class="mat-dialog__title" id="@(dialogId + "-title")">Credential</h2>
                                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-credential-modal-close data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                                                </div>
                                                <div class="mat-dialog__body">
                                                    <div class="mat-form__grid">
                                                        <div class="mat-field">
                                                            <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].Name">Name</label>
                                                            <input asp-for="TemplateEditor.CredentialBundles[i].Name" class="mat-input" placeholder="Windows admin" />
                                                        </div>
                                                        <div class="mat-field">
                                                            <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].Kind">Kind</label>
                                                            <select asp-for="TemplateEditor.CredentialBundles[i].Kind" class="mat-select" data-credential-kind-select>
                                                                @* 'Ssh' is hidden (redundant with 'Linux'); PostgreSql/MySql have no dedicated typed bundle yet (use inline creds or a Generic bundle) - keep any kind the current bundle already is. *@
                                                                @foreach (var kind in Enum.GetValues<MonitoringCredentialKind>().Where(kind => (kind != MonitoringCredentialKind.Ssh && kind != MonitoringCredentialKind.PostgreSql && kind != MonitoringCredentialKind.MySql) || credential.Kind == kind))
                                                                {
                                                                    <option value="@kind">@kind</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="mat-field mat-field--full">
                                                            <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].Description">Description</label>
                                                            <input asp-for="TemplateEditor.CredentialBundles[i].Description" class="mat-input" placeholder="Optional note" />
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="windows" hidden="@(credential.Kind == MonitoringCredentialKind.Windows ? null : "hidden")">
                                                            <p class="mat-text-muted">Windows / WinRM credentials</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].WinrmUsername">Username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].WinrmUsername" class="mat-input" placeholder="monitor" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].WinrmPassword">Password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].WinrmPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="ssh" hidden="@((credential.Kind == MonitoringCredentialKind.Linux || credential.Kind == MonitoringCredentialKind.Ssh) ? null : "hidden")">
                                                            <p class="mat-text-muted">SSH / Linux credentials</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SshUsername">Username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SshUsername" class="mat-input" placeholder="monitor" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SshPassword">Password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SshPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                                <div class="mat-field mat-field--full">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SshPrivateKeyPath">Private key path</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SshPrivateKeyPath" class="mat-input mat-mono" placeholder="C:\\Users\\monitor\\.ssh\\id_ed25519" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="proxmox" hidden="@(credential.Kind == MonitoringCredentialKind.Proxmox ? null : "hidden")">
                                                            <p class="mat-text-muted">Proxmox API token - exactly as shown in the Proxmox UI (Token ID + secret).</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field mat-field--full">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].PveTokenId">Token ID</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].PveTokenId" class="mat-input mat-mono" placeholder="root@pam!monitoring" />
                                                                </div>
                                                                <div class="mat-field mat-field--full">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].PveTokenSecret">Token secret</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].PveTokenSecret" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="sqlserver" hidden="@(credential.Kind == MonitoringCredentialKind.SqlServer ? null : "hidden")">
                                                            <p class="mat-text-muted">SQL Server credentials</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].MssqlUsername">Username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].MssqlUsername" class="mat-input" placeholder="monitor" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].MssqlPassword">Password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].MssqlPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="snmp" hidden="@(credential.Kind == MonitoringCredentialKind.Snmp ? null : "hidden")">
                                                            <p class="mat-text-muted">SNMP credentials</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpCommunity">Community</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SnmpCommunity" class="mat-input" placeholder="public" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpV3Username">v3 username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SnmpV3Username" class="mat-input" placeholder="snmp-user" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpV3AuthProtocol">v3 auth protocol</label>
                                                                    <select asp-for="TemplateEditor.CredentialBundles[i].SnmpV3AuthProtocol" class="mat-select">
                                                                        <option value="">Not set</option>
                                                                        @foreach (var option in Matmon.Core.Domain.SnmpV3Crypto.AuthOptions) { <option value="@option.Value">@option.Label</option> }
                                                                        @if (Model.TemplateEditor.CredentialBundles[i].SnmpV3AuthProtocol is { Length: > 0 } stored && !Matmon.Core.Domain.SnmpV3Crypto.AuthOptions.Any(o => string.Equals(o.Value, stored, StringComparison.OrdinalIgnoreCase))) { <option value="@stored">@stored</option> }
                                                                    </select>
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpV3AuthPassword">v3 auth password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SnmpV3AuthPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpV3PrivacyProtocol">v3 privacy protocol</label>
                                                                    <select asp-for="TemplateEditor.CredentialBundles[i].SnmpV3PrivacyProtocol" class="mat-select">
                                                                        <option value="">Not set</option>
                                                                        @foreach (var option in Matmon.Core.Domain.SnmpV3Crypto.PrivOptions) { <option value="@option.Value">@option.Label</option> }
                                                                        @if (Model.TemplateEditor.CredentialBundles[i].SnmpV3PrivacyProtocol is { Length: > 0 } stored && !Matmon.Core.Domain.SnmpV3Crypto.PrivOptions.Any(o => string.Equals(o.Value, stored, StringComparison.OrdinalIgnoreCase))) { <option value="@stored">@stored</option> }
                                                                    </select>
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpV3PrivacyPassword">v3 privacy password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SnmpV3PrivacyPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                                <div class="mat-field mat-field--full">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].SnmpV3ContextName">v3 context</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].SnmpV3ContextName" class="mat-input" placeholder="optional" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="unifi" hidden="@(credential.Kind == MonitoringCredentialKind.Unifi ? null : "hidden")">
                                                            <p class="mat-text-muted">UniFi API key (sent as X-API-KEY)</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field mat-field--full">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].UnifiApiKey">API key</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].UnifiApiKey" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="generic" hidden="@(credential.Kind == MonitoringCredentialKind.Generic ? null : "hidden")">
                                                            <p class="mat-text-muted">Generic credentials - exposed to scripts as MATMON_USERNAME / MATMON_PASSWORD / MATMON_TOKEN.</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].GenericUsername">Username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].GenericUsername" class="mat-input" placeholder="monitor" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].GenericPassword">Password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].GenericPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                                <div class="mat-field mat-field--full">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].GenericToken">Token / API key</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].GenericToken" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mat-field--full mat-stack mat-stack--sm" data-credential-kind-group="mail" hidden="@(credential.Kind == MonitoringCredentialKind.Mail ? null : "hidden")">
                                                            <p class="mat-text-muted">Mail Health - the SMTP (send) and IMAP (receive) accounts. Both are stored encrypted at rest.</p>
                                                            <div class="mat-form__grid">
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].MailSmtpUsername">SMTP username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].MailSmtpUsername" class="mat-input" placeholder="monitor@account-a" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].MailSmtpPassword">SMTP password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].MailSmtpPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].MailImapUsername">IMAP username</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].MailImapUsername" class="mat-input" placeholder="mailbox@account-b" />
                                                                </div>
                                                                <div class="mat-field">
                                                                    <label class="mat-label" asp-for="TemplateEditor.CredentialBundles[i].MailImapPassword">IMAP password</label>
                                                                    <input asp-for="TemplateEditor.CredentialBundles[i].MailImapPassword" type="password" autocomplete="off" class="mat-input" placeholder="••••••••" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mat-dialog__foot">
                                                    <div class="mat-btn-row mat-btn-row--plain">
                                                        <button type="button" class="mat-btn mat-btn--primary" data-credential-modal-save data-dialog-close>@MatUi.Icon("check")<span>Done</span></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </dialog>
                                    </li>
                                }
                            </ul>
                            <div class="mat-actions">
                                <button type="button" class="mat-btn mat-btn--secondary" data-credential-add>@MatUi.Icon("plus")<span>Add credential</span></button>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            @* ---------- PARAMETERS (a sensor template gets the structured fields; any other scope key=value lines) ---------- *@
            @if (isSensorScope)
            {
                @await Html.PartialAsync("_SensorParameters", Model.TemplateEditor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "TemplateEditor" } })
            }
            else
            {
                <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-parameters" aria-labelledby="tab-parameters" hidden>
                    <section class="mat-card">
                        <div class="mat-card__head">@MatUi.Icon("settings")<h2 class="mat-card__title">Parameters</h2><span class="mat-text-muted mm-push-end">key=value per line</span></div>
                        <div class="mat-card__body mat-stack">
                            <p class="mat-muted">Blank means inherit. Placeholders show the inherited or default value.</p>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.ParametersText">Parameters</label>
                                <textarea asp-for="TemplateEditor.ParametersText" rows="4" class="mat-textarea mat-mono" placeholder="@Model.TemplateEditor.ParametersTextPlaceholder"></textarea>
                            </div>
                        </div>
                    </section>
                </div>
            }

            @* ---------- CHANNELS / THRESHOLDS ---------- *@
            @if (isSensorScope)
            {
                @await Html.PartialAsync("_SensorThresholds", Model.TemplateEditor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "TemplateEditor" } })
            }
            else
            {
                <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-thresholds" aria-labelledby="tab-thresholds" hidden>
                    @* data-template-nonsensor-only sits on the card, not on the panel: the scope switch must not fight the tabs over the panel's hidden. *@
                    <section class="mat-card" data-template-nonsensor-only>
                        <div class="mat-card__head">@MatUi.Icon("activity")<h2 class="mat-card__title">Thresholds</h2><span class="mat-text-muted mm-push-end">key=value per line</span></div>
                        <div class="mat-card__body">
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.ThresholdsText">Thresholds</label>
                                <textarea asp-for="TemplateEditor.ThresholdsText" rows="4" class="mat-textarea mat-mono" placeholder="@Model.TemplateEditor.ThresholdsTextPlaceholder"></textarea>
                            </div>
                        </div>
                    </section>
                </div>
            }

            @* ---------- SCHEDULE (shared partial, its own tab panel) ---------- *@
            @await Html.PartialAsync("_SensorSchedule", Model.TemplateEditor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "TemplateEditor" } })

            @* ---------- TELEMETRY / RETENTION ---------- *@
            <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-telemetry" aria-labelledby="tab-telemetry" hidden>
                <section class="mat-card">
                    <div class="mat-card__head">@MatUi.Icon("clock")<h2 class="mat-card__title">Retention</h2><span class="mat-text-muted mm-push-end">events, history, statistics</span></div>
                    <div class="mat-card__body mat-stack">
                        <p class="mat-muted">Leave empty to inherit. Placeholders show the inherited value.</p>
                        <div class="mat-form__grid">
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.EventRetentionDays">Event logs</label>
                                <input asp-for="TemplateEditor.EventRetentionDays" type="number" min="1" class="mat-input" placeholder="@Model.TemplateEditor.EventRetentionDaysPlaceholder" />
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.ObservationRetentionDays">History</label>
                                <input asp-for="TemplateEditor.ObservationRetentionDays" type="number" min="1" class="mat-input" placeholder="@Model.TemplateEditor.ObservationRetentionDaysPlaceholder" />
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.StatisticsRetentionDays">Statistics</label>
                                <input asp-for="TemplateEditor.StatisticsRetentionDays" type="number" min="1" class="mat-input" placeholder="@Model.TemplateEditor.StatisticsRetentionDaysPlaceholder" />
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" asp-for="TemplateEditor.StatisticsBucketMinutes">Bucket minutes</label>
                                <input asp-for="TemplateEditor.StatisticsBucketMinutes" type="number" min="1" class="mat-input" placeholder="@Model.TemplateEditor.StatisticsBucketMinutesPlaceholder" />
                                <span class="mat-error" aria-live="polite"></span>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            @* ---------- IMPACT (the sensors that came from this template, directly or through a chain) ---------- *@
            <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-impact" aria-labelledby="tab-impact" hidden>
                @if (impactCount == 0)
                {
                    <div class="mat-empty mat-empty--framed">
                        <span class="mat-empty__icon">@MatUi.Icon("activity")</span>
                        <div class="mat-empty__title">No sensors use this template yet</div>
                        <p>A sensor created from this template shows up here.</p>
                    </div>
                }
                else
                {
                    <p class="mat-muted">@impactCount @(impactCount == 1 ? "sensor uses" : "sensors use") this template.</p>
                    <div class="mat-table-wrap">
                        <table class="mat-table">
                            <caption class="mat-sr-only">Sensors that use this template</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Sensor</th>
                                    <th scope="col">Link</th>
                                    <th scope="col" class="mat-hide-sm">Type</th>
                                    <th scope="col" class="mat-hide-sm">Applied on</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.TemplateEditor.ImpactRows)
                                {
                                    var impactLabel = row.ImpactKind == "template" ? "template chain" : row.ImpactKind;
                                    <tr>
                                        <td data-label="Sensor" class="mat-table__primary">
                                            <a asp-page="/SensorDetails" asp-route-sensorId="@row.SensorId">@row.SensorName</a>
                                            <div class="mat-hint">@row.SensorPath</div>
                                        </td>
                                        <td data-label="Link"><span class="@MatUi.PillClass(row.ImpactKind == "direct" ? "accent" : "plain")">@impactLabel</span></td>
                                        <td data-label="Type" class="mat-hide-sm mat-mono">@row.SensorTypeKey</td>
                                        <td data-label="Applied on" class="mat-hide-sm">@row.AppliedOnKind: @row.AppliedOnName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary" data-default-submit>@MatUi.Icon("save")<span>Save</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" asp-page-handler="DeleteTemplate" formnovalidate class="mat-btn mat-btn--danger" data-confirm="Delete this template?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete</span></button>
        </div>
    </form>
}

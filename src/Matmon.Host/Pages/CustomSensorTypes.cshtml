@page "/monitoring/sensor-types"
@model Matmon.Host.Pages.CustomSensorTypesModel
@{
    ViewData["Title"] = "Custom sensor types";
}

<div class="workspace-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Custom sensor types</h1>
            <p class="page-subtitle">Author a reusable script sensor type once and use it like any built-in sensor. Types are stored in this workspace and included in the cloud config backup.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel workspace-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("template")<span>Your custom types</span></h2>
            <span class="panel-hint">@Model.Types.Count</span>
        </div>
        @if (Model.Types.Count == 0)
        {
            <div class="empty-state">No custom sensor types yet. Create one below.</div>
        }
        else
        {
            <div class="system-table" role="table" aria-label="Custom sensor types">
                <div class="system-table-row system-table-head" role="row">
                    <span role="columnheader">Name</span>
                    <span role="columnheader">Language</span>
                    <span role="columnheader">Output</span>
                    <span role="columnheader">Actions</span>
                </div>
                @foreach (var type in Model.Types)
                {
                    <div class="system-table-row" role="row">
                        <span role="cell"><strong>@type.DisplayName</strong>@(string.IsNullOrWhiteSpace(type.Description) ? "" : $" — {type.Description}")</span>
                        <span role="cell">@type.ScriptLanguage</span>
                        <span role="cell">@type.ScriptOutputFormat</span>
                        <span role="cell" style="display:flex;gap:8px;flex-wrap:wrap;">
                            <a class="workspace-secondary-submit" asp-page="/CustomSensorTypes" asp-route-key="@type.Key">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-key="@type.Key" onsubmit="return confirm('Delete custom sensor type &quot;@type.DisplayName&quot;? Sensors using it must be removed first.');">
                                <button type="submit" class="workspace-danger-submit">Delete</button>
                            </form>
                        </span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel workspace-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("plus")<span>@(Model.IsEditing ? "Edit custom type" : "New custom type")</span></h2>
        </div>
        <form method="post" asp-page-handler="Save" class="workspace-form" style="padding:18px 20px;">
            <input type="hidden" asp-for="EditKey" />
            <label class="workspace-field-primary">
                <span>Name</span>
                <input asp-for="Name" class="workspace-input" placeholder="Widget health" required />
            </label>
            <label>
                <span>Description</span>
                <input asp-for="Description" class="workspace-input" placeholder="What this type checks" />
            </label>

            <div class="workspace-form-grid">
                <label>
                    <span>Language</span>
                    <select asp-for="Language" class="form-select workspace-select">
                        <option value="pwsh">PowerShell (pwsh)</option>
                        <option value="bash">bash</option>
                        <option value="sh">sh</option>
                    </select>
                </label>
                <label>
                    <span>Output format</span>
                    <select asp-for="OutputFormat" class="form-select workspace-select">
                        <option value="auto">Auto</option>
                        <option value="json">JSON</option>
                        <option value="xml">XML</option>
                        <option value="regex">Regex (named groups)</option>
                        <option value="text">Text</option>
                    </select>
                </label>
            </div>

            <label>
                <span>Script</span>
                <textarea asp-for="ScriptBody" rows="16" class="form-control workspace-textarea" data-script-editor spellcheck="false" placeholder="# runs on the Matmon host/probe; MATMON_HOST / MATMON_TARGET are in the environment"></textarea>
            </label>

            <label>
                <span>Regex pattern <small class="workspace-hint">(only used when output format is Regex; named capture groups become channels)</small></span>
                <textarea asp-for="RegexPattern" rows="2" class="form-control workspace-textarea" spellcheck="false" placeholder="(?&lt;value&gt;\d+(?:\.\d+)?)"></textarea>
            </label>

            <p class="workspace-hint" style="max-width:640px;">The script runs on the Matmon host/probe with the same trust as the Local Script sensor. Available env: <code>MATMON_HOST</code>, <code>MATMON_TARGET</code>, <code>MATMON_SENSOR_TYPE</code>. Sensors of this type set only their target + schedule; the script lives on the type.</p>

            <div class="workspace-form-actions" style="margin-top:0.5rem;">
                <button type="submit" class="workspace-submit">@(Model.IsEditing ? "Save changes" : "Create type")</button>
                @if (Model.IsEditing)
                {
                    <a class="workspace-secondary-submit" asp-page="/CustomSensorTypes">Cancel</a>
                }
            </div>
        </form>
    </section>
</div>

@page "/Alerts"
@model WorkspaceModel
@inject Matmon.Host.Services.IMonitoringWorkspaceStore Store
@{
    ViewData["Title"] = "Alerts";
    ViewData["PageSub"] = "An alert stays open until it is acknowledged - also after its sensor recovered.";
    var returnUrl = Request.Path + Request.QueryString;
    var allAlerts = Model.View.Alerts;
    var activeMutes = Store.GetActiveAlertMutes();

    // Render every active alert, but cap the resolved history we render into the DOM - the client-side
    // table would otherwise materialise thousands of <tr> (a real instance had ~1000+ resolved alerts,
    // ~3 MB of HTML). Tab counts below still use the full set, so the numbers stay honest; only the
    // rendered/browsable history is capped to the most recent N.
    const int ResolvedRenderCap = 200;
    var renderedAlerts = allAlerts.Where(alert => alert.IsActive)
        .Concat(allAlerts.Where(alert => !alert.IsActive).Take(ResolvedRenderCap))
        .ToArray();

    string NormalizeAlertFilter(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "open" => "open",
        "error" => "error",
        "warning" => "warning",
        "ack" or "acknowledged" => "ack",
        "recovered" => "recovered",
        "paused" => "paused",
        "history" or "resolved" => "history",
        _ => "all"
    };

    var alertFilter = NormalizeAlertFilter(Request.Query["alertFilter"].ToString());
    bool IsTab(string filter) => string.Equals(alertFilter, filter, StringComparison.OrdinalIgnoreCase);

    var openAlertCount = allAlerts.Count(a => a.IsActive && !a.IsAcknowledged);
    var errorAlertCount = allAlerts.Count(a => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "error", StringComparison.OrdinalIgnoreCase));
    var warningAlertCount = allAlerts.Count(a => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "warning", StringComparison.OrdinalIgnoreCase));
    var acknowledgedAlertCount = allAlerts.Count(a => a.IsActive && a.IsAcknowledged);
    var recoveredAlertCount = allAlerts.Count(a => a.IsActive && a.IsRecovered);
    var pausedAlertCount = allAlerts.Count(a => a.IsActive && string.Equals(a.StateKey, "paused", StringComparison.OrdinalIgnoreCase));
    var activeAlertCount = allAlerts.Count(a => a.IsActive);
    var resolvedAlertCount = allAlerts.Count(a => !a.IsActive);

    // The count on a tab: toned while it has something in it (the word on the tab says what), soft otherwise.
    string BadgeClass(string filter, int count) => count == 0
        ? "mat-badge mat-badge--soft"
        : filter switch
        {
            "error" => "mat-badge mat-badge--error",
            "warning" => "mat-badge mat-badge--warn",
            "ack" => "mat-badge mat-badge--info",
            "recovered" => "mat-badge mat-badge--ok",
            _ => "mat-badge mat-badge--soft"
        };

    bool MatchesInitialFilter(WorkspaceAlertRow a) => alertFilter switch
    {
        "open" => a.IsActive && !a.IsAcknowledged,
        "error" => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "error", StringComparison.OrdinalIgnoreCase),
        "warning" => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "warning", StringComparison.OrdinalIgnoreCase),
        "ack" => a.IsActive && a.IsAcknowledged,
        "recovered" => a.IsActive && a.IsRecovered,
        "paused" => a.IsActive && string.Equals(a.StateKey, "paused", StringComparison.OrdinalIgnoreCase),
        "history" => !a.IsActive,
        _ => a.IsActive
    };
    // Render only the first page (active filter, the client's default 50/page) as visible so the
    // first paint already matches what the client-side script settles on - no flash of all rows
    // before the JS filters and pages. The script then drives every later filter/search/page change.
    const int InitialPageSize = 50;
    var initialVisibleIds = renderedAlerts.Where(MatchesInitialFilter).Take(InitialPageSize).Select(a => a.Id).ToHashSet();
    var initialMatchCount = renderedAlerts.Count(MatchesInitialFilter);
    var hiddenResolvedCount = resolvedAlertCount - renderedAlerts.Count(alert => !alert.IsActive);

    // The time filter and the sort order are client-side (alerts.js): radios in the Filter and Sort dialogs (LIST-03).
    var timeChoices = new (string Value, string Label)[]
    {
        ("all", "Any time"),
        ("24h", "Last 24 hours"),
        ("7d", "Last 7 days"),
        ("30d", "Last 30 days"),
        ("older-24h", "Older than 24 hours"),
        ("older-7d", "Older than 7 days")
    };
    var sortChoices = new (string Value, string Label)[]
    {
        ("default", "Default (active first)"),
        ("last-desc", "Last seen - newest"),
        ("last-asc", "Last seen - oldest"),
        ("first-desc", "First seen - newest"),
        ("first-asc", "First seen - oldest"),
        ("severity", "Severity"),
        ("element", "Element name")
    };
    var muteAction = Url.Page("/Alerts", "MuteAlert");
    var ackAction = Url.Page("/Alerts", "AcknowledgeAlert");
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<div class="mat-stack" data-alerts data-initial-filter="@alertFilter">
    @* The views of the list. They are links (the menu, the dashboard and the cloud open ?alertFilter=open|error|warning|ack);
       alerts.js switches them in place and keeps the address. *@
    <nav class="mat-tabs" aria-label="Alert filters">
        <a class="mat-tab@(IsTab("all") ? " is-active" : string.Empty)" aria-current="@(IsTab("all") ? "page" : null)" data-alert-filter="all" asp-page="/Alerts"><span>All</span><span class="@BadgeClass("all", activeAlertCount)">@activeAlertCount</span></a>
        <a class="mat-tab@(IsTab("open") ? " is-active" : string.Empty)" aria-current="@(IsTab("open") ? "page" : null)" data-alert-filter="open" asp-page="/Alerts" asp-route-alertFilter="open"><span>Open</span><span class="@BadgeClass("open", openAlertCount)">@openAlertCount</span></a>
        <a class="mat-tab@(IsTab("error") ? " is-active" : string.Empty)" aria-current="@(IsTab("error") ? "page" : null)" data-alert-filter="error" asp-page="/Alerts" asp-route-alertFilter="error"><span>Error</span><span class="@BadgeClass("error", errorAlertCount)">@errorAlertCount</span></a>
        <a class="mat-tab@(IsTab("warning") ? " is-active" : string.Empty)" aria-current="@(IsTab("warning") ? "page" : null)" data-alert-filter="warning" asp-page="/Alerts" asp-route-alertFilter="warning"><span>Warning</span><span class="@BadgeClass("warning", warningAlertCount)">@warningAlertCount</span></a>
        <a class="mat-tab@(IsTab("ack") ? " is-active" : string.Empty)" aria-current="@(IsTab("ack") ? "page" : null)" data-alert-filter="ack" asp-page="/Alerts" asp-route-alertFilter="ack"><span>Ack</span><span class="@BadgeClass("ack", acknowledgedAlertCount)">@acknowledgedAlertCount</span></a>
        <a class="mat-tab@(IsTab("recovered") ? " is-active" : string.Empty)" aria-current="@(IsTab("recovered") ? "page" : null)" data-alert-filter="recovered" asp-page="/Alerts" asp-route-alertFilter="recovered"><span>Recovered</span><span class="@BadgeClass("recovered", recoveredAlertCount)">@recoveredAlertCount</span></a>
        <a class="mat-tab@(IsTab("history") ? " is-active" : string.Empty)" aria-current="@(IsTab("history") ? "page" : null)" data-alert-filter="history" asp-page="/Alerts" asp-route-alertFilter="history"><span>History</span><span class="@BadgeClass("history", resolvedAlertCount)">@resolvedAlertCount</span></a>
        @if (pausedAlertCount > 0 || alertFilter == "paused")
        {
            <a class="mat-tab@(IsTab("paused") ? " is-active" : string.Empty)" aria-current="@(IsTab("paused") ? "page" : null)" data-alert-filter="paused" asp-page="/Alerts" asp-route-alertFilter="paused"><span>Paused</span><span class="@BadgeClass("paused", pausedAlertCount)">@pausedAlertCount</span></a>
        }
    </nav>

    @if (activeMutes.Count > 0)
    {
        <section class="mat-card">
            <div class="mat-card__head">
                @MatUi.Icon("bell")
                <h2 class="mat-card__title">Muted</h2>
                <span class="mat-card__sub mm-push-end">@activeMutes.Count element@(activeMutes.Count == 1 ? string.Empty : "s") won't alarm</span>
            </div>
            <div class="mat-table-wrap">
                <table class="mat-table mat-table--compact">
                    <caption class="mat-sr-only">Muted elements: no alert re-opens for them until the mute ends</caption>
                    <thead>
                        <tr>
                            <th scope="col">Element</th>
                            <th scope="col">Muted</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var muted in activeMutes)
                        {
                            <tr>
                                <td data-label="Element">
                                    <div class="mat-table__name"><span class="mat-min-w-0">@muted.ElementName<small class="mm-break">@muted.ElementPath</small></span></div>
                                </td>
                                <td data-label="Muted">@(muted.IsPermanent ? "until un-muted" : $"until {muted.MutedUntilUtc!.Value.ToDisplay().ToString("g")}")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <form method="post" asp-page-handler="UnmuteAlert" asp-route-returnUrl="@returnUrl">
                                            <input type="hidden" name="elementId" value="@muted.ElementId" />
                                            <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm">@MatUi.Icon("bell")<span>Un-mute</span></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (hiddenResolvedCount > 0)
    {
        <p class="mat-muted">Showing the most recent @ResolvedRenderCap of @resolvedAlertCount resolved alerts. Older history is trimmed automatically.</p>
    }

    <div class="mat-list" data-selectable>
        @if (allAlerts.Count == 0)
        {
            <div class="mat-empty mat-empty--first">
                <span class="mat-empty__icon">@MatUi.Icon("check-circle")</span>
                <div class="mat-empty__title">No alerts yet</div>
                <p>Everything is healthy.</p>
            </div>
        }
        else
        {
            <div class="mat-toolbar" role="toolbar" aria-label="Alert tools">
                <div class="mat-input-icon mat-toolbar__search">
                    @MatUi.Icon("search")
                    <input class="mat-input" type="search" id="alerts-search" placeholder="Element, path or message" aria-label="Search alerts"
                           autocomplete="off" enterkeyhint="search" data-shortcut="/" data-alerts-search />
                </div>
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info" aria-live="polite"><span data-alerts-count>@initialMatchCount</span> shown</span>
                <div class="mat-toolbar__end">
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn" data-dialog-open="alerts-filter" aria-haspopup="dialog" data-alerts-filter-button>
                        @MatUi.Icon("sliders")<span>Filter</span><span class="mat-badge" data-alerts-filter-badge hidden>1</span>
                    </button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn" data-dialog-open="alerts-sort" aria-haspopup="dialog" data-alerts-sort-button>
                        @MatUi.Icon("sort")<span>Sort</span><small data-alerts-sort-label>Default</small>
                    </button>
                </div>
            </div>

            <div class="mat-chips" role="group" aria-label="Filters in effect" data-alerts-chips hidden>
                <span class="mat-chip">First seen: <span data-alerts-time-label></span><button type="button" class="mat-chip__x" data-alerts-time-clear aria-label="Remove the time filter">@MatUi.Icon("x")</button></span>
            </div>

            <div class="mat-bulk" data-bulk-bar hidden role="status">
                <span class="mat-bulk__count"><strong data-bulk-count>0</strong> selected</span>
                <button type="submit" form="alerts-form" class="mat-btn mat-btn--primary mat-btn--sm" data-alerts-bulk-ack
                        data-confirm="Acknowledge the selected alerts?" data-confirm-ok="Acknowledge">
                    @MatUi.Icon("check")<span>Acknowledge selected</span>
                </button>
            </div>

            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Alerts, the active ones first</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="mat-table__select"><input type="checkbox" data-alerts-select-all aria-label="Select all on this page" /></th>
                            <th scope="col">Severity</th>
                            <th scope="col">Element</th>
                            <th scope="col">Message</th>
                            <th scope="col" class="mat-hide-sm">First seen</th>
                            <th scope="col">Last seen</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody data-alerts-body>
                        @foreach (var alert in renderedAlerts)
                        {
                            var canAck = alert.IsActive && !alert.IsAcknowledged;
                            var muteMenuId = $"alerts-mute-{alert.Id:N}";
                            <tr data-alert-row
                                hidden="@(initialVisibleIds.Contains(alert.Id) ? null : "hidden")"
                                data-active="@alert.IsActive.ToString().ToLowerInvariant()"
                                data-ack="@alert.IsAcknowledged.ToString().ToLowerInvariant()"
                                data-recovered="@alert.IsRecovered.ToString().ToLowerInvariant()"
                                data-state="@alert.StateKey"
                                data-search="@($"{alert.ElementName} {alert.ElementPath} {alert.Message}".ToLowerInvariant())"
                                data-first="@alert.FirstSeenSortKey"
                                data-last="@alert.LastSeenSortKey"
                                data-name="@alert.ElementName.ToLowerInvariant()">
                                <td data-label="Select" class="mat-table__select">
                                    @if (canAck)
                                    {
                                        <input type="checkbox" name="alertIds" value="@alert.Id" form="alerts-form" data-select-row data-alerts-check aria-label="Select the alert of @alert.ElementName" />
                                    }
                                </td>
                                <td data-label="Severity"><span class="@MatUi.PillClass(alert.StateKey)">@alert.StateLabel</span></td>
                                <td data-label="Element">
                                    <div class="mat-table__name">
                                        <span class="mat-tag">@alert.ElementKind</span>
                                        <span class="mat-min-w-0">@alert.ElementName<small class="mm-break">@alert.ElementPath</small></span>
                                    </div>
                                </td>
                                <td data-label="Message" class="mm-break">@alert.Message</td>
                                <td data-label="First seen" class="mat-hide-sm mat-mono mat-nowrap">@alert.FirstSeen</td>
                                <td data-label="Last seen" class="mat-mono mat-nowrap">@(alert.IsRecovered && alert.IsActive ? alert.RecoveredAt : (alert.IsActive ? alert.LastSeen : alert.ResolvedAt))</td>
                                <td data-label="Status">
                                    <span class="mat-row mat-row--nowrap mat-gap-2">
                                        @if (!alert.IsActive)
                                        {
                                            <span class="mat-pill mat-pill--ok">Resolved</span>
                                        }
                                        else if (alert.IsRecovered)
                                        {
                                            <span class="mat-pill mat-pill--ok">Recovered</span>
                                        }
                                        @if (alert.IsAcknowledged)
                                        {
                                            <span class="@MatUi.PillClass("ack")">Ack</span>
                                        }
                                        else if (alert.IsActive && !alert.IsRecovered)
                                        {
                                            <span class="mat-text-muted">Open</span>
                                        }
                                    </span>
                                </td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        @if (alert.ElementKind == MonitoringElementKind.Sensor)
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/SensorDetails" asp-route-sensorId="@alert.ElementId" aria-label="Details of @alert.ElementName" data-tip="Details">@MatUi.Icon("bar-chart")</a>
                                        }
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/ElementEditor" asp-route-selectedId="@alert.ElementId" asp-route-returnUrl="@returnUrl" aria-label="Edit @alert.ElementName" data-tip="Edit">@MatUi.Icon("edit")</a>
                                        @if (canAck)
                                        {
                                            <button type="submit" form="alerts-form" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm"
                                                    name="alertId" value="@alert.Id" formaction="@ackAction"
                                                    aria-label="Acknowledge the alert of @alert.ElementName" data-tip="Acknowledge"
                                                    data-confirm="Acknowledge this alert?" data-confirm-ok="Acknowledge">@MatUi.Icon("check")</button>
                                        }
                                        @if (alert.IsActive)
                                        {
                                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-menu-toggle="@muteMenuId" data-menu-place="bottom"
                                                    aria-haspopup="menu" aria-expanded="false" aria-label="Mute the alert of @alert.ElementName" data-tip="Mute">@MatUi.Icon("bell")</button>
                                            <div class="mat-menu" id="@muteMenuId" role="menu" aria-label="Mute and stop re-opening" hidden>
                                                <div class="mat-menu__head">
                                                    <div>
                                                        <strong>Mute &amp; stop re-opening</strong>
                                                        <small>Acknowledges it; no new alert until the mute ends</small>
                                                    </div>
                                                </div>
                                                <button type="submit" form="alerts-form" class="mat-menu__item" role="menuitem" name="mute" value="@(alert.ElementId):perm" formaction="@muteAction">@MatUi.Icon("bell")<span>Until I un-mute</span></button>
                                                <button type="submit" form="alerts-form" class="mat-menu__item" role="menuitem" name="mute" value="@(alert.ElementId):1h" formaction="@muteAction">@MatUi.Icon("clock")<span>For 1 hour</span></button>
                                                <button type="submit" form="alerts-form" class="mat-menu__item" role="menuitem" name="mute" value="@(alert.ElementId):24h" formaction="@muteAction">@MatUi.Icon("clock")<span>For 24 hours</span></button>
                                                <button type="submit" form="alerts-form" class="mat-menu__item" role="menuitem" name="mute" value="@(alert.ElementId):7d" formaction="@muteAction">@MatUi.Icon("calendar")<span>For 7 days</span></button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mat-empty" data-alerts-empty hidden>
                <span class="mat-empty__icon">@MatUi.Icon("search")</span>
                <div class="mat-empty__title">No alerts match this filter</div>
                <p>Choose another tab, or change the search or the time filter.</p>
            </div>

            <nav class="mat-pager" aria-label="Pagination" data-alerts-pager hidden>
                <span class="mat-pager__info" data-alerts-pager-info></span>
                <div class="mat-pager__pages">
                    <button type="button" class="mat-pager__btn" data-alerts-prev aria-label="Previous page">@MatUi.Icon("chevron-left")</button>
                    <button type="button" class="mat-pager__btn" data-alerts-next aria-label="Next page">@MatUi.Icon("chevron-right")</button>
                </div>
                <label class="alerts-page-size" for="alerts-page-size">
                    <span>Per page</span>
                    <select class="mat-select mat-select--sm mat-w-auto" id="alerts-page-size" data-alerts-page-size>
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                    </select>
                </label>
            </nav>
        }
    </div>

    @* The one form every acknowledge and mute posts through: the checks and the row buttons point at it with form="alerts-form",
       so the toolbar's search is in no form and Enter in it posts nothing. *@
    <form method="post" id="alerts-form" asp-page-handler="AcknowledgeAlerts" hidden>
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </form>

    <dialog class="mat-dialog mat-dialog--sm" id="alerts-filter" aria-labelledby="alerts-filter-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @MatUi.Icon("sliders")
                <h2 class="mat-dialog__title" id="alerts-filter-title">Filter</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-label">First seen</legend>
                    <div class="mat-options">
                        @foreach (var choice in timeChoices)
                        {
                            <label class="mat-option"><input type="radio" id="alerts-time-@choice.Value" name="alerts-time" value="@choice.Value" checked="@(choice.Value == "all")" data-alerts-time /><span>@choice.Label</span></label>
                        }
                    </div>
                </fieldset>
                <p class="mat-hint">By the age of the alert: "Older than 7 days" finds the long-standing problems. The list follows the choice at once.</p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" data-dialog-close>@MatUi.Icon("check")<span>Done</span></button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="alerts-sort" aria-labelledby="alerts-sort-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @MatUi.Icon("sort")
                <h2 class="mat-dialog__title" id="alerts-sort-title">Sort</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-label">Sort by</legend>
                    <div class="mat-options">
                        @foreach (var choice in sortChoices)
                        {
                            <label class="mat-option"><input type="radio" id="alerts-sort-@choice.Value" name="alerts-sort" value="@choice.Value" checked="@(choice.Value == "default")" data-alerts-sort /><span>@choice.Label</span></label>
                        }
                    </div>
                </fieldset>
                <p class="mat-hint">The list follows the choice at once.</p>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="button" class="mat-btn mat-btn--primary" data-dialog-close>@MatUi.Icon("check")<span>Done</span></button>
                </div>
            </div>
        </div>
    </dialog>
</div>

@page "/Alerts"
@model WorkspaceModel
@{
    ViewData["Title"] = "Alerts";
    var returnUrl = Request.Path + Request.QueryString;
    var allAlerts = Model.View.Alerts;

    // Render every active alert, but cap the resolved history we render into the DOM — the client-side
    // table would otherwise materialise thousands of <tr> (a real instance had ~1000+ resolved alerts,
    // ~3 MB of HTML). Tab counts below still use the full set, so the numbers stay honest; only the
    // rendered/browsable history is capped to the most recent N.
    const int ResolvedRenderCap = 200;
    var renderedAlerts = allAlerts.Where(alert => alert.IsActive)
        .Concat(allAlerts.Where(alert => !alert.IsActive).Take(ResolvedRenderCap))
        .ToArray();

    string NormalizeAlertFilter(string? value) => value?.Trim().ToLowerInvariant() switch
    {
        "open" => "open",
        "error" => "error",
        "warning" => "warning",
        "ack" or "acknowledged" => "ack",
        "paused" => "paused",
        "history" or "resolved" => "history",
        _ => "all"
    };

    var alertFilter = NormalizeAlertFilter(Request.Query["alertFilter"].ToString());
    string TabClass(string filter) => string.Equals(alertFilter, filter, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;

    var openAlertCount = allAlerts.Count(a => a.IsActive && !a.IsAcknowledged);
    var errorAlertCount = allAlerts.Count(a => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "error", StringComparison.OrdinalIgnoreCase));
    var warningAlertCount = allAlerts.Count(a => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "warning", StringComparison.OrdinalIgnoreCase));
    var acknowledgedAlertCount = allAlerts.Count(a => a.IsActive && a.IsAcknowledged);
    var pausedAlertCount = allAlerts.Count(a => a.IsActive && string.Equals(a.StateKey, "paused", StringComparison.OrdinalIgnoreCase));
    var activeAlertCount = allAlerts.Count(a => a.IsActive);
    var resolvedAlertCount = allAlerts.Count(a => !a.IsActive);

    bool MatchesInitialFilter(WorkspaceAlertRow a) => alertFilter switch
    {
        "open" => a.IsActive && !a.IsAcknowledged,
        "error" => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "error", StringComparison.OrdinalIgnoreCase),
        "warning" => a.IsActive && !a.IsAcknowledged && string.Equals(a.StateKey, "warning", StringComparison.OrdinalIgnoreCase),
        "ack" => a.IsActive && a.IsAcknowledged,
        "paused" => a.IsActive && string.Equals(a.StateKey, "paused", StringComparison.OrdinalIgnoreCase),
        "history" => !a.IsActive,
        _ => a.IsActive
    };
    // Render only the first page (active filter, the client's default 50/page) as visible so the
    // first paint already matches what the client-side script settles on — no flash of all rows
    // before the JS filters and pages. The script then drives every later filter/search/page change.
    const int InitialPageSize = 50;
    var initialVisibleIds = renderedAlerts.Where(MatchesInitialFilter).Take(InitialPageSize).Select(a => a.Id).ToHashSet();
    var initialMatchCount = renderedAlerts.Count(MatchesInitialFilter);
    var hiddenResolvedCount = resolvedAlertCount - renderedAlerts.Count(alert => !alert.IsActive);
}

<section class="dashboard-shell alerts-page" data-alerts data-initial-filter="@alertFilter">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("warning")
            <h1>Alerts</h1>
        </div>
    </div>

    <section class="panel panel-stack">
        <nav class="alert-filter-bar" aria-label="Alert filters">
            <a class="workspace-tab alert-filter-tab @TabClass("all")" data-alert-filter="all" asp-page="/Alerts"><span>All</span><strong>@activeAlertCount</strong></a>
            <a class="workspace-tab alert-filter-tab @TabClass("open")" data-alert-filter="open" asp-page="/Alerts" asp-route-alertFilter="open"><span>Open</span><strong>@openAlertCount</strong></a>
            <a class="workspace-tab alert-filter-tab @TabClass("error")" data-alert-filter="error" asp-page="/Alerts" asp-route-alertFilter="error" data-tone="error"><span>Error</span><strong>@errorAlertCount</strong></a>
            <a class="workspace-tab alert-filter-tab @TabClass("warning")" data-alert-filter="warning" asp-page="/Alerts" asp-route-alertFilter="warning" data-tone="warning"><span>Warning</span><strong>@warningAlertCount</strong></a>
            <a class="workspace-tab alert-filter-tab @TabClass("ack")" data-alert-filter="ack" asp-page="/Alerts" asp-route-alertFilter="ack" data-tone="ack"><span>Ack</span><strong>@acknowledgedAlertCount</strong></a>
            <a class="workspace-tab alert-filter-tab @TabClass("history")" data-alert-filter="history" asp-page="/Alerts" asp-route-alertFilter="history"><span>History</span><strong>@resolvedAlertCount</strong></a>
            @if (pausedAlertCount > 0 || alertFilter == "paused")
            {
                <a class="workspace-tab alert-filter-tab @TabClass("paused")" data-alert-filter="paused" asp-page="/Alerts" asp-route-alertFilter="paused" data-tone="paused"><span>Paused</span><strong>@pausedAlertCount</strong></a>
            }
        </nav>

        <div class="monitoring-filter-bar alerts-toolbar">
            <label class="monitoring-filter-field alerts-search-field">
                <span>@MatmonIcons.Render("search")<small>Search</small></span>
                <input type="search" class="form-control workspace-input" placeholder="Element, path or message" data-alerts-search autocomplete="off" aria-label="Search alerts" />
            </label>
            <label class="monitoring-filter-field alerts-sort-field">
                <span>@MatmonIcons.Render("clock")<small>Sort</small></span>
                <select class="form-select workspace-select" data-alerts-sort aria-label="Sort alerts">
                    <option value="default">Default (active first)</option>
                    <option value="last-desc">Last seen — newest</option>
                    <option value="last-asc">Last seen — oldest</option>
                    <option value="first-desc">First seen — newest</option>
                    <option value="first-asc">First seen — oldest</option>
                    <option value="severity">Severity</option>
                    <option value="element">Element name</option>
                </select>
            </label>
            <div class="alerts-bulkbar" data-alerts-bulkbar hidden>
                <span class="alerts-bulkbar-count"><strong data-alerts-selected>0</strong> selected</span>
                <button type="submit" form="alerts-form" class="workspace-primary-submit" data-alerts-bulk-ack
                        onclick="return confirm('Acknowledge the selected alerts?');">
                    @MatmonIcons.Render("check")<span>Acknowledge selected</span>
                </button>
            </div>
        </div>
    </section>

    <section class="panel panel-stack workspace-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("warning")<span>Alerts</span></h2>
            <span class="panel-hint"><strong data-alerts-count>@initialMatchCount</strong> shown</span>
        </div>

        @if (hiddenResolvedCount > 0)
        {
            <div class="workspace-filter-note">Showing the most recent @ResolvedRenderCap of @resolvedAlertCount resolved alerts. Older history is trimmed automatically.</div>
        }

    <form method="post" id="alerts-form" asp-page-handler="AcknowledgeAlerts">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="alerts-table-wrap">
            <table class="alerts-table">
                <thead>
                    <tr>
                        <th class="alerts-col-check"><input type="checkbox" data-alerts-select-all aria-label="Select all on this page" /></th>
                        <th class="alerts-col-state">Severity</th>
                        <th class="alerts-col-element">Element</th>
                        <th class="alerts-col-message">Message</th>
                        <th class="alerts-col-time">First seen</th>
                        <th class="alerts-col-time">Last seen</th>
                        <th class="alerts-col-status">Status</th>
                        <th class="alerts-col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody data-alerts-body>
                    @foreach (var alert in renderedAlerts)
                    {
                        var canAck = alert.IsActive && !alert.IsAcknowledged;
                        <tr class="alerts-row" data-alert-row
                            hidden="@(initialVisibleIds.Contains(alert.Id) ? null : "hidden")"
                            data-active="@alert.IsActive.ToString().ToLowerInvariant()"
                            data-ack="@alert.IsAcknowledged.ToString().ToLowerInvariant()"
                            data-state="@alert.StateKey"
                            data-search="@($"{alert.ElementName} {alert.ElementPath} {alert.Message}".ToLowerInvariant())"
                            data-first="@alert.FirstSeenSortKey"
                            data-last="@alert.LastSeenSortKey"
                            data-name="@alert.ElementName.ToLowerInvariant()">
                            <td class="alerts-col-check">
                                @if (canAck)
                                {
                                    <input type="checkbox" name="alertIds" value="@alert.Id" data-alerts-check aria-label="Select this alert" />
                                }
                            </td>
                            <td class="alerts-col-state"><span class="state-pill" data-state="@alert.StateKey">@alert.StateLabel</span></td>
                            <td class="alerts-col-element">
                                <span class="tree-kind" data-kind="@alert.ElementKind.ToString().ToLowerInvariant()">@alert.ElementKind</span>
                                <span class="alerts-element-text">
                                    <span class="alerts-element-name">@alert.ElementName</span>
                                    <span class="alerts-element-path">@alert.ElementPath</span>
                                </span>
                            </td>
                            <td class="alerts-col-message"><span title="@alert.Message">@alert.Message</span></td>
                            <td class="alerts-col-time">@alert.FirstSeen</td>
                            <td class="alerts-col-time">@(alert.IsRecovered && alert.IsActive ? alert.RecoveredAt : (alert.IsActive ? alert.LastSeen : alert.ResolvedAt))</td>
                            <td class="alerts-col-status">
                                @if (!alert.IsActive)
                                {
                                    <span class="state-pill" data-state="ok">Resolved</span>
                                }
                                else if (alert.IsRecovered)
                                {
                                    <span class="state-pill" data-state="ok">Recovered</span>
                                }
                                @if (alert.IsAcknowledged)
                                {
                                    <span class="state-pill" data-state="paused">Ack</span>
                                }
                            </td>
                            <td class="alerts-col-actions">
                                @if (alert.ElementKind == MonitoringElementKind.Sensor)
                                {
                                    <a class="alerts-action" title="Details" asp-page="/SensorDetails" asp-route-sensorId="@alert.ElementId">@MatmonIcons.Render("chart")</a>
                                }
                                <a class="alerts-action" title="Edit" asp-page="/ElementEditor" asp-route-selectedId="@alert.ElementId" asp-route-returnUrl="@returnUrl">@MatmonIcons.Render("pencil")</a>
                                @if (canAck)
                                {
                                    <button type="submit" class="alerts-action alerts-action-ack" title="Acknowledge"
                                            name="alertId" value="@alert.Id"
                                            formaction="@Url.Page("/Alerts", "AcknowledgeAlert")"
                                            onclick="return confirm('Acknowledge this alert?');">@MatmonIcons.Render("check")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (allAlerts.Count == 0)
        {
            <div class="empty-state">No alerts yet. Everything is healthy.</div>
        }
        <div class="empty-state" data-alerts-empty hidden>No alerts match this filter.</div>
    </form>

    <div class="alerts-pager" data-alerts-pager hidden>
        <button type="button" class="alerts-pager-btn" data-alerts-prev>@MatmonIcons.Render("arrow-left")<span>Prev</span></button>
        <span class="alerts-pager-info" data-alerts-pager-info></span>
        <button type="button" class="alerts-pager-btn" data-alerts-next><span>Next</span>@MatmonIcons.Render("arrow-right")</button>
        <label class="alerts-pager-size">
            <span>Per page</span>
            <select class="workspace-select" data-alerts-page-size>
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
            </select>
        </label>
    </div>
    </section>
</section>

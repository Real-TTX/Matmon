@page "/system/mibs"
@model Matmon.Host.Pages.MibsModel
@{
    ViewData["Title"] = "SNMP MIBs";
    var uploaded = Model.Modules.Where(module => module.Source == "Uploaded").ToList();
    var builtIn = Model.Modules.Where(module => module.Source != "Uploaded").ToList();
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<section class="mat-card">
    <div class="mat-card__head">@MatUi.Icon("upload")<h2 class="mat-card__title">Upload</h2></div>
    <div class="mat-card__body">
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mat-form" novalidate>
            <div class="mat-field">
                <label class="mat-label" for="mib-files">MIB files <span class="mat-req" aria-hidden="true">*</span></label>
                <div class="mat-upload" data-upload>
                    <input class="mat-upload__input" type="file" id="mib-files" name="files" multiple accept=".mib,.my,.txt,.zip" required data-msg-required="Choose at least one MIB file." aria-describedby="mib-files-hint" />
                </div>
                <span class="mat-hint" id="mib-files-hint">.mib, .my, .txt or a .zip; a new upload of a module replaces the old one.</span>
                <span class="mat-error" aria-live="polite"></span>
            </div>
            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("upload")<span>Upload</span></button>
            </div>
        </form>
    </div>
</section>

@if (Model.Missing.Count > 0)
{
    <div class="mat-alert mat-alert--warning" role="status">
        @MatUi.Icon("alert")
        <div class="mat-alert__body">
            <span class="mat-alert__title">Missing dependencies</span>
            <span>Imported by a loaded MIB but not loaded - dependent objects may stay unnamed. They usually come in the vendor's download:</span>
            <ul class="mat-alert__list">
                @foreach (var (module, neededBy) in Model.Missing)
                {
                    <li><code>@module</code> <span class="mat-text-muted">needed by @string.Join(", ", neededBy)</span></li>
                }
            </ul>
        </div>
    </div>
}

<section class="mat-card">
    <div class="mat-card__head">@MatUi.Icon("list")<h2 class="mat-card__title">Uploaded</h2><span class="mat-text-muted mm-push-end">@uploaded.Count</span></div>
    @if (uploaded.Count == 0)
    {
        <div class="mat-card__body">
            <p class="mat-muted">No MIBs uploaded yet.</p>
        </div>
    }
    else
    {
        <partial name="_MibModuleTable" model="uploaded" view-data="@(new ViewDataDictionary(ViewData) { ["MibUploadedAt"] = Model.UploadedAt, ["MibCanDelete"] = true, ["MibCaption"] = "Uploaded MIB modules" })" />
    }
</section>

<section class="mat-card">
    <div class="mat-card__head">@MatUi.Icon("check-circle")<h2 class="mat-card__title">Built in</h2><span class="mat-text-muted mm-push-end">@builtIn.Count standard modules (IETF, Net-SNMP)</span></div>
    <partial name="_MibModuleTable" model="builtIn" view-data="@(new ViewDataDictionary(ViewData) { ["MibCanDelete"] = false, ["MibCaption"] = "Built-in MIB modules" })" />
</section>

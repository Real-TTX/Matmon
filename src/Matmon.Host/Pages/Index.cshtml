@page
@model IndexModel
@{
    ViewData["Title"] = Model.IsSecondary ? "Secondary Probe" : "Dashboard";
    if (Model.IsSecondary)
    {
        // The probe's head carries its connection state next to the title.
        ViewData["OwnHead"] = true;
    }

    string FormatPercent(int count, int total)
    {
        if (total <= 0)
        {
            return "0%";
        }

        return $"{count * 100d / total:0}%";
    }

    // The width of one part of the status meter (data-value): unrounded and invariant, so the parts add up to the whole
    // bar whatever the server's culture writes as a decimal separator.
    string MeterValue(int count, int total)
    {
        if (total <= 0)
        {
            return "0";
        }

        return (Math.Max(0, count) * 100d / total).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    }

    string FormatLocalTimestamp(DateTimeOffset? timestamp)
    {
        return timestamp?.ToDisplay().ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
    }

    string FormatDueTimestamp(DateTimeOffset? timestamp)
    {
        if (timestamp is null)
        {
            return "-";
        }

        var nowUtc = DateTimeOffset.UtcNow;
        if (timestamp.Value <= nowUtc.AddSeconds(2))
        {
            return "due now";
        }

        var local = timestamp.Value.ToDisplay();
        var nowLocal = DateTimeOffset.UtcNow.ToDisplay();
        return local.Date == nowLocal.Date
            ? local.ToString("HH:mm:ss")
            : local.ToString("yyyy-MM-dd HH:mm");
    }

    bool IsDue(DateTimeOffset? timestamp)
    {
        return timestamp is not null && timestamp.Value <= DateTimeOffset.UtcNow.AddSeconds(2);
    }

    string TransferStateKey(bool? success)
    {
        return success switch
        {
            true => "ok",
            false => "error",
            _ => "unknown"
        };
    }
}

@if (Model.IsSecondary)
{
    var connected = Model.SlaveSnapshot.IsConnected;
    var connectionPill = MatUi.PillClass(connected ? "ok" : "error");
    var connectionLabel = connected ? "Connected" : "Disconnected";

    <div class="mat-page__head">
        <div class="mat-page__title">
            <h1>Secondary Probe</h1>
            <p class="mat-page__sub">Mode: Secondary · @Model.SlaveSnapshot.StatusMessage</p>
        </div>
        <span class="@connectionPill mm-push-end">@connectionLabel</span>
    </div>

    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("link")
            <h2 class="mat-card__title">Primary connection</h2>
        </div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Connection</dt>
                <dd><span class="@connectionPill">@connectionLabel</span></dd>
                <dt>Primary</dt>
                <dd class="mat-mono">@Model.RuntimeOptions.PrimaryUrl</dd>
                <dt>Probe</dt>
                <dd>@Model.RuntimeOptions.ProbeName <span class="mat-mono mat-text-muted">(@Model.RuntimeOptions.ProbeId)</span></dd>
                <dt>Heartbeat interval</dt>
                <dd class="mat-mono">@Model.RuntimeOptions.HeartbeatIntervalSeconds s</dd>
                <dt>Last heartbeat</dt>
                <dd class="mat-mono">@FormatLocalTimestamp(Model.SlaveSnapshot.LastHeartbeatUtc)</dd>
                <dt>Last assignment sync</dt>
                <dd class="mat-mono">@FormatLocalTimestamp(Model.SlaveSnapshot.LastAssignmentSyncUtc)</dd>
                <dt>Last result transfer</dt>
                <dd>
                    <span class="@MatUi.PillClass(TransferStateKey(Model.SlaveSnapshot.LastResultTransferSucceeded))">@(Model.SlaveSnapshot.LastResultTransferSucceeded == true ? "Successful" : Model.SlaveSnapshot.LastResultTransferSucceeded == false ? "Failed" : "No transfer")</span>
                    <span class="mat-mono">@FormatLocalTimestamp(Model.SlaveSnapshot.LastResultTransferAttemptUtc)</span>
                </dd>
                <dt>Status</dt>
                <dd>@Model.SlaveSnapshot.StatusMessage</dd>
            </dl>
        </div>
    </section>

    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("clock")
            <h2 class="mat-card__title">Next secondary sensor runs</h2>
            <span class="mat-card__sub mm-push-end">@Model.SlaveSnapshot.UpcomingExecutions.Count remote-executed sensor runs</span>
        </div>
        @if (Model.SlaveSnapshot.UpcomingExecutions.Count == 0)
        {
            <div class="mat-card__body">
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("clock")</span>
                    <div class="mat-empty__title">No runs yet</div>
                    <p>No remote-executed sensor runs yet.</p>
                </div>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table mat-table--compact">
                    <caption class="mat-sr-only">The next sensor runs of this probe, soonest first</caption>
                    <thead>
                        <tr>
                            <th scope="col">Next run</th>
                            <th scope="col">Sensor</th>
                            <th scope="col" class="mat-hide-sm">Type</th>
                            <th scope="col">Schedule</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.SlaveSnapshot.UpcomingExecutions)
                        {
                            <tr>
                                <td data-label="Next run" class="mat-nowrap">
                                    @if (IsDue(entry.NextDueUtc))
                                    {
                                        <span class="mat-pill mat-pill--warn">@FormatDueTimestamp(entry.NextDueUtc)</span>
                                    }
                                    else
                                    {
                                        <span class="mat-mono">@FormatDueTimestamp(entry.NextDueUtc)</span>
                                    }
                                </td>
                                <td data-label="Sensor">
                                    <div class="mat-table__name"><span>@entry.Name<small class="mm-break">@entry.Path</small></span></div>
                                </td>
                                <td data-label="Type" class="mat-hide-sm mat-mono">@entry.SensorTypeKey</td>
                                <td data-label="Schedule">@entry.ScheduleSummary</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("upload")
            <h2 class="mat-card__title">Last results</h2>
            <span class="mat-card__sub mm-push-end">@Model.SlaveSnapshot.LastResultTransferStatus</span>
        </div>
        @if (Model.SlaveSnapshot.ResultTransfers.Count == 0)
        {
            <div class="mat-card__body">
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("upload")</span>
                    <div class="mat-empty__title">Nothing sent yet</div>
                    <p>No local sensor results transferred yet.</p>
                </div>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table mat-table--compact">
                    <caption class="mat-sr-only">The latest results this probe sent to the primary</caption>
                    <thead>
                        <tr>
                            <th scope="col">Sensor</th>
                            <th scope="col">State</th>
                            <th scope="col" class="mat-hide-sm">Message</th>
                            <th scope="col">Transfer</th>
                            <th scope="col">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.SlaveSnapshot.ResultTransfers.Take(12))
                        {
                            <tr>
                                <td data-label="Sensor">
                                    <div class="mat-table__name"><span>@entry.Name<small class="mm-break">@entry.Path</small></span></div>
                                </td>
                                <td data-label="State"><span class="@MatUi.PillClass(entry.StateKey)">@entry.StateLabel</span></td>
                                <td data-label="Message" class="mat-hide-sm mm-break">@(entry.Message ?? "ok")</td>
                                <td data-label="Transfer"><span class="@MatUi.PillClass(TransferStateKey(entry.TransferSucceeded))">@(entry.TransferSucceeded == true ? "sent" : entry.TransferSucceeded == false ? "failed" : "pending")</span></td>
                                <td data-label="Time" class="mat-mono mat-nowrap">@entry.ExecutedUtc.ToDisplay().ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("list")
            <h2 class="mat-card__title">Transferred events</h2>
            <span class="mat-card__sub mm-push-end">@Model.SlaveSnapshot.Events.Count exchanged events</span>
        </div>
        @if (Model.SlaveSnapshot.Events.Count == 0)
        {
            <div class="mat-card__body">
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("list")</span>
                    <div class="mat-empty__title">No events yet</div>
                    <p>No probe events yet.</p>
                </div>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table mat-table--compact">
                    <caption class="mat-sr-only">What this probe exchanged with the primary</caption>
                    <thead>
                        <tr>
                            <th scope="col">Time</th>
                            <th scope="col">Direction</th>
                            <th scope="col">Kind</th>
                            <th scope="col">Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.SlaveSnapshot.Events)
                        {
                            <tr>
                                <td data-label="Time" class="mat-mono mat-nowrap">@entry.TimestampUtc.ToDisplay().ToString("HH:mm:ss")</td>
                                <td data-label="Direction">@entry.Direction</td>
                                <td data-label="Kind">
                                    @entry.Kind
                                    @if (entry.IsError)
                                    {
                                        <span class="mat-pill mat-pill--error">Error</span>
                                    }
                                </td>
                                <td data-label="Message" class="mm-break">@entry.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
else
{
    var snapshot = Model.Snapshot;
    // What a sensor said last (its message) - shown on a tile only while the sensor has a problem.
    var sensorMessages = snapshot.Nodes
        .Where(node => node.Kind == MonitoringElementKind.Sensor)
        .GroupBy(node => node.Id)
        .ToDictionary(group => group.Key, group => group.First().StateMessage);
    var liveSensors = snapshot.TelemetrySeries
        .OrderByDescending(series => series.StateKey?.ToLowerInvariant() switch
        {
            "error" => 4,
            "warning" => 3,
            "paused" => 2,
            "unknown" => 1,
            _ => 0
        })
        .ThenBy(series => series.Path)
        .Take(24)
        .ToArray();

    var sensorStatusTotal = Math.Max(0, snapshot.SensorCount);
    var alertTone = snapshot.ErrorAlertCount > 0 ? " mat-text-danger" : snapshot.ActiveAlertCount > 0 ? " mat-text-warning" : string.Empty;
    var statusLabel = $"{snapshot.HealthySensorCount} OK, {snapshot.WarningSensorCount} warning, {snapshot.AcknowledgedSensorCount} acknowledged, {snapshot.ErrorSensorCount} error, {snapshot.PausedSensorCount} paused, {snapshot.OtherSensorCount} other - of {sensorStatusTotal} sensors";
    var hostsWithProblems = snapshot.Nodes.Count(node => node.Kind == MonitoringElementKind.Host && node.StateKey is "error" or "warning");
    var probesDown = snapshot.Probes.Where(probe => probe.ConnectionStateKey != "ok").ToArray();
    var okShare = sensorStatusTotal == 0 ? 0 : (int)Math.Round(snapshot.HealthySensorCount * 100d / sensorStatusTotal);

    string ParentOf(string path)
    {
        var parts = path.Split(" / ");
        return parts.Length > 1 ? parts[^2] : string.Empty;
    }

    string? ProblemMessage(Matmon.Host.Services.TelemetrySeriesSnapshot series)
        => series.StateKey is "error" or "warning" && sensorMessages.TryGetValue(series.SensorId, out var message) ? message : null;

    // A check that failed without a reading has no current value - its placeholder 0 is not one.
    string FormatValue(Matmon.Host.Services.TelemetrySeriesSnapshot series)
        => !series.CurrentValue.HasValue || series.Points.Count > 0 && !series.Points[^1].HasReading ? "-" : series.CurrentValue.Value.ToString("0.#");

    @* The four things an operator looks at first, each a way into its list. Templates and notification rules used to have
       a tile each: they are configuration, not the state of the network. *@
    <div class="mat-grid mat-grid--4">
        <a class="mat-card" asp-page="/Alerts">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Open alerts</span>
                <span class="mat-stat__value@(alertTone)">@snapshot.ActiveAlertCount</span>
                <span class="mat-stat__delta">@(snapshot.ActiveAlertCount == 0 ? "none open" : $"{snapshot.ErrorAlertCount} error{(snapshot.ErrorAlertCount == 1 ? "" : "s")} · {snapshot.WarningAlertCount} warning{(snapshot.WarningAlertCount == 1 ? "" : "s")}")</span>
            </div>
        </a>
        <a class="mat-card" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Sensors</span>
                <span class="mat-stat__value">@snapshot.SensorCount</span>
                <span class="mat-stat__delta">@(snapshot.PausedSensorCount > 0 ? $"{snapshot.PausedSensorCount} paused" : "none paused")</span>
            </div>
        </a>
        <a class="mat-card" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="host">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Hosts</span>
                <span class="mat-stat__value">@snapshot.HostCount</span>
                <span class="mat-stat__delta@(hostsWithProblems > 0 ? " mat-text-danger" : string.Empty)">@(snapshot.HostCount == 0 ? "none yet" : hostsWithProblems == 0 ? "all OK" : $"{hostsWithProblems} with problems")</span>
            </div>
        </a>
        <a class="mat-card" asp-page="/Probes">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Probes</span>
                <span class="mat-stat__value">@snapshot.ConfiguredProbeCount</span>
                <span class="mat-stat__delta@(probesDown.Length > 0 ? " mat-text-danger" : string.Empty)">@(probesDown.Length == 0 ? "all connected" : probesDown.Length == 1 ? $"{probesDown[0].ProbeName} not connected" : $"{probesDown.Length} not connected")</span>
            </div>
        </a>
    </div>

    @* The status of every sensor as one bar: OK, warning, acknowledged and error each a part of it; paused and other are
       the rest of the track. The legend under it carries the words and the numbers (colour alone never says the state)
       and links to the list behind each number. dashboard.js keeps the numbers and the bar live. *@
    <section class="mat-card" data-dashboard-status-chart>
        <div class="mat-card__head">
            @MatUi.Icon("activity")
            <h2 class="mat-card__title">Sensor status</h2>
            <a class="mat-btn mat-btn--ghost mat-btn--sm mm-push-end" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor">@MatUi.Icon("arrow-right")<span>All sensors</span></a>
        </div>
        <div class="mat-card__body mm-dash-status">
            <div class="mm-dash-status__figure">
                <span class="mm-dash-status__share"><span data-role="status-ok-share">@okShare</span>%</span>
                <span class="mat-text-muted">OK of <span data-role="status-total">@sensorStatusTotal</span> sensors</span>
            </div>
            <div class="mm-dash-status__bar">
                <div class="mat-meter mat-meter--lg mat-meter--stack" role="img" aria-label="@statusLabel" data-role="status-meter">
                    <div class="mat-meter__fill" data-status-fill="ok" data-tone="ok" data-value="@MeterValue(snapshot.HealthySensorCount, sensorStatusTotal)"></div>
                    <div class="mat-meter__fill" data-status-fill="warning" data-tone="warn" data-value="@MeterValue(snapshot.WarningSensorCount, sensorStatusTotal)"></div>
                    <div class="mat-meter__fill" data-status-fill="ack" data-value="@MeterValue(snapshot.AcknowledgedSensorCount, sensorStatusTotal)"></div>
                    <div class="mat-meter__fill" data-status-fill="error" data-tone="error" data-value="@MeterValue(snapshot.ErrorSensorCount, sensorStatusTotal)"></div>
                </div>
                <div class="mm-dash-legend">
                    <a class="mm-dash-legend__item" data-tone="ok" data-dashboard-status-item="ok" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor" asp-route-monitoringState="ok">
                        <span>OK</span><strong data-role="status-ok-count">@snapshot.HealthySensorCount</strong><small data-role="status-ok-percent">@FormatPercent(snapshot.HealthySensorCount, sensorStatusTotal)</small>
                    </a>
                    <a class="mm-dash-legend__item" data-tone="warn" data-dashboard-status-item="warning" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor" asp-route-monitoringState="warning">
                        <span>Warning</span><strong data-role="status-warning-count">@snapshot.WarningSensorCount</strong><small data-role="status-warning-percent">@FormatPercent(snapshot.WarningSensorCount, sensorStatusTotal)</small>
                    </a>
                    <a class="mm-dash-legend__item" data-tone="info" data-dashboard-status-item="ack" asp-page="/Alerts" asp-route-alertFilter="ack">
                        <span>Acknowledged</span><strong data-role="status-ack-count">@snapshot.AcknowledgedSensorCount</strong><small data-role="status-ack-percent">@FormatPercent(snapshot.AcknowledgedSensorCount, sensorStatusTotal)</small>
                    </a>
                    <a class="mm-dash-legend__item" data-tone="error" data-dashboard-status-item="error" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor" asp-route-monitoringState="error">
                        <span>Error</span><strong data-role="status-error-count">@snapshot.ErrorSensorCount</strong><small data-role="status-error-percent">@FormatPercent(snapshot.ErrorSensorCount, sensorStatusTotal)</small>
                    </a>
                    <a class="mm-dash-legend__item" data-tone="plain" data-dashboard-status-item="paused" asp-page="/Paused" hidden="@(snapshot.PausedSensorCount == 0 ? "hidden" : null)">
                        <span>Paused</span><strong data-role="status-paused-count">@snapshot.PausedSensorCount</strong><small data-role="status-paused-percent">@FormatPercent(snapshot.PausedSensorCount, sensorStatusTotal)</small>
                    </a>
                    <a class="mm-dash-legend__item" data-tone="plain" data-dashboard-status-item="other" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor" hidden="@(snapshot.OtherSensorCount == 0 ? "hidden" : null)">
                        <span>No data</span><strong data-role="status-other-count">@snapshot.OtherSensorCount</strong><small data-role="status-other-percent">@FormatPercent(snapshot.OtherSensorCount, sensorStatusTotal)</small>
                    </a>
                </div>
            </div>
        </div>
    </section>

    @if (snapshot.HighlightedTelemetrySeries.Count > 0)
    {
        <section class="mat-section" data-dashboard-highlight-strip aria-labelledby="dashboard-highlights-title">
            <div class="mat-section__head">
                <h2 id="dashboard-highlights-title">Highlights</h2>
            </div>
            <div class="mm-dash-highlights">
                @foreach (var series in snapshot.HighlightedTelemetrySeries)
                {
                    <a class="mat-card mm-dash-graph" asp-page="/SensorDetails" asp-route-sensorId="@series.SensorId"
                       data-series-key="@series.Key" data-sensor-id="@series.SensorId" data-state="@series.StateKey">
                        <div class="mat-card__body mm-dash-graph__body">
                            <div class="mm-dash-graph__head">
                                <div class="mm-dash-graph__name">
                                    <strong data-role="sensor-title">@series.Title</strong>
                                    <small title="@series.Path">@ParentOf(series.Path)</small>
                                </div>
                                <span class="@MatUi.PillClass(series.StateKey)" data-role="state">@series.StateLabel</span>
                            </div>
                            <div class="mm-dash-graph__value">
                                <strong data-role="current-value">@FormatValue(series)</strong>
                                <span data-role="current-unit">@series.Unit</span>
                            </div>
                            <partial name="_DashboardTrend" model="@("lg")" />
                            <p class="mm-dash-graph__message" data-role="message" hidden="@(ProblemMessage(series) is null ? "hidden" : null)">@ProblemMessage(series)</p>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <section class="mat-section" aria-labelledby="dashboard-live-title">
        <div class="mm-dash-section-head">
            <h2 id="dashboard-live-title">Live sensors</h2>
            <a class="mat-btn mat-btn--ghost mat-btn--sm mm-push-end" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor">@MatUi.Icon("arrow-right")<span>All @snapshot.SensorCount</span></a>
        </div>

        @if (liveSensors.Length == 0)
        {
            <div class="mat-empty mat-empty--framed">
                <span class="mat-empty__icon">@MatUi.Icon("activity")</span>
                <div class="mat-empty__title">No sensor data yet</div>
                <p>The sensors show here with their latest value once they have run.</p>
                <a class="mat-btn mat-btn--secondary" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor">@MatUi.Icon("activity")<span>Open the sensors</span></a>
            </div>
        }
        else
        {
            <div class="mm-dash-tiles">
                @foreach (var series in liveSensors)
                {
                    <a class="mat-card mm-dash-tile" asp-page="/SensorDetails" asp-route-sensorId="@series.SensorId"
                       data-series-key="@series.Key" data-sensor-id="@series.SensorId" data-state="@series.StateKey">
                        <div class="mat-card__body mm-dash-tile__body">
                            <div class="mm-dash-tile__head">
                                <span class="mm-dash-tile__name">
                                    <strong data-role="sensor-title">@series.Title</strong>
                                    <small title="@series.Path">@(string.IsNullOrWhiteSpace(ParentOf(series.Path)) ? series.SensorTypeLabel : ParentOf(series.Path))</small>
                                </span>
                                <span class="@MatUi.PillClass(series.StateKey)" data-role="state">@series.StateLabel</span>
                            </div>
                            <div class="mm-dash-tile__value">
                                <strong data-role="current-value">@FormatValue(series)</strong>
                                <span data-role="current-unit">@series.Unit</span>
                                @if (series.IsHighlighted)
                                {
                                    <span class="mm-dash-tile__star" title="Highlight">@MatUi.Icon("star")</span>
                                }
                            </div>
                            <partial name="_DashboardTrend" model="@("sm")" />
                            <p class="mm-dash-tile__message" data-role="message" hidden="@(ProblemMessage(series) is null ? "hidden" : null)">@ProblemMessage(series)</p>
                        </div>
                    </a>
                }
            </div>

            @if (snapshot.SensorCount > liveSensors.Length)
            {
                <div class="mat-actions">
                    <a class="mat-btn mat-btn--ghost mat-btn--sm" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="sensor">@MatUi.Icon("arrow-right")<span>@(snapshot.SensorCount - liveSensors.Length) more sensors</span></a>
                </div>
            }
        }
    </section>
}

@page "/login"
@model LoginModel
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Login";
    ViewData["AnonymousMainExtraClass"] = "anonymous-main-top";
}

<section class="dashboard-shell auth-shell auth-shell-login">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("lock")
            <h1>Login</h1>
        </div>
    </div>

    <div class="panel auth-card">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("spark")<span>Access</span></h2>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="workspace-form auth-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <label class="workspace-field">
                <span>E-mail</span>
                <input asp-for="Email" class="workspace-input" type="email" autocomplete="email" />
            </label>

            <label class="workspace-field">
                <span>Password</span>
                <input asp-for="Password" class="workspace-input" type="password" autocomplete="current-password" />
            </label>

            <div class="auth-actions">
                <span class="auth-note">Sign in with your e-mail</span>
                <button type="submit" class="workspace-submit auth-submit">@MatmonIcons.Render("arrow-right")<span>Login</span></button>
            </div>
        </form>

        @if (Model.CloudSsoAvailable && !Model.Embedded)
        {
            <div style="display:flex;align-items:center;gap:10px;margin:16px 0 12px;color:var(--matmon-muted);font-size:0.85rem;">
                <span style="flex:1;height:1px;background:var(--matmon-border);"></span>or<span style="flex:1;height:1px;background:var(--matmon-border);"></span>
            </div>
            <a href="/signin-cloud?handler=Start" class="workspace-secondary-submit" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;">
                @MatmonIcons.Render("network")<span>Sign in with Matmon Cloud</span>
            </a>
        }
    </div>
</section>

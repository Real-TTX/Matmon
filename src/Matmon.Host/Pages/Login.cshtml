@page "/login"
@model LoginModel
@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Login";
    ViewData["AnonymousMainExtraClass"] = "anonymous-main-top";

    // Reseller co-branding on the sign-in card: the managing partner's logo + "Managed by" (mime clamped to a
    // raster type; the accent is applied by _AnonymousLayout). Absent when unmanaged or the customer opted out.
    var partner = WorkspaceStore.GetServicePartnerInfo();
    var partnerLogoMime = string.Equals(partner?.LogoContentType, "image/jpeg", StringComparison.OrdinalIgnoreCase) ? "image/jpeg" : "image/png";
}

<section class="dashboard-shell auth-shell auth-shell-login">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("lock")
            <h1>Login</h1>
        </div>
    </div>

    <div class="panel auth-card">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("spark")<span>Access</span></h2>
        </div>

        @if (partner is { HasPartner: true, BrandingSuppressed: false } && (partner.LogoPng is { Length: > 0 } || !string.IsNullOrWhiteSpace(partner.Name)))
        {
            <div style="display:flex;flex-direction:column;align-items:center;gap:6px;margin:4px 0 16px;">
                @if (partner.LogoPng is { Length: > 0 } logo)
                {
                    <img src="data:@partnerLogoMime;base64,@Convert.ToBase64String(logo)" alt="@partner.Name" style="max-height:48px;max-width:220px;" />
                }
                @if (!string.IsNullOrWhiteSpace(partner.Name))
                {
                    <span style="color:var(--matmon-muted);font-size:0.85rem;">Managed by @partner.Name</span>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="workspace-form auth-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <label class="workspace-field">
                <span>E-mail</span>
                <input asp-for="Email" class="workspace-input" type="email" autocomplete="email" />
            </label>

            <label class="workspace-field">
                <span>Password</span>
                <input asp-for="Password" class="workspace-input" type="password" autocomplete="current-password" />
            </label>

            <div class="auth-actions">
                <span class="auth-note">Sign in with your e-mail</span>
                <button type="submit" class="workspace-submit auth-submit">@MatmonIcons.Render("arrow-right")<span>Login</span></button>
            </div>
        </form>

        @if (Model.CloudSsoAvailable && !Model.Embedded)
        {
            <div style="display:flex;align-items:center;gap:10px;margin:16px 0 12px;color:var(--matmon-muted);font-size:0.85rem;">
                <span style="flex:1;height:1px;background:var(--matmon-border);"></span>or<span style="flex:1;height:1px;background:var(--matmon-border);"></span>
            </div>
            <a href="/signin-cloud?handler=Start" class="workspace-secondary-submit" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;">
                @MatmonIcons.Render("network")<span>Sign in with Matmon Cloud</span>
            </a>
        }
    </div>
</section>

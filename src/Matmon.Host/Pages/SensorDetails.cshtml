@page "/monitoring/sensor/{sensorId:guid}"
@model SensorDetailsModel
@{
    ViewData["Title"] = Model.View.Name;
    ViewData["WorkspaceSummarySuppress"] = true;
}

<section class="dashboard-shell">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <div class="page-header sensor-header" style="--sensor-state-color:@Model.View.StateColor">
        <div class="sensor-header-main">
            <div class="page-title">
                @MatmonIcons.Render("sensor")
                <h1>@Model.View.Name</h1>
            </div>
            <div class="sensor-path">@Model.View.Path</div>
            <div class="sensor-meta">
                <span class="sensor-chip">@Model.View.SensorTypeLabel</span>
                <span class="usage-level-pill" data-level="@Model.View.UsageLevelKey">@Model.View.UsageLevelLabel</span>
                <span class="sensor-chip">@Model.View.Target</span>
                <span class="sensor-chip">graph: @Model.View.DefaultChannelLabel</span>
                @if (!string.IsNullOrWhiteSpace(Model.View.ExecutionProbe))
                {
                    <span class="sensor-chip">probe: @Model.View.ExecutionProbe</span>
                }
                <span class="sensor-chip">@Model.View.SettingsSummary</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.View.StateMessage))
            {
                <div class="sensor-state-message">@Model.View.StateMessage</div>
            }
        </div>

        <div class="sensor-header-side">
            <span class="state-pill" data-state="@Model.View.StateKey">@Model.View.StateLabel</span>
            <div class="sensor-current-value">
                <strong>@Model.View.CurrentValueText</strong>
                @if (!string.IsNullOrWhiteSpace(Model.View.Unit))
                {
                    <span>@Model.View.Unit</span>
                }
            </div>
            @if (Model.View.UnitConversion is { } conversion)
            {
                <div class="sensor-unit-conversion" title="How the stored measurement is converted for display">
                    <span class="sensor-unit-conversion-tag">unit</span>
                    <span class="sensor-unit-conversion-body">
                        stored <strong>@conversion.RawUnit</strong> → shown <strong>@conversion.DisplayUnit</strong>
                        @if (!string.IsNullOrWhiteSpace(conversion.Example))
                        {
                            <span class="sensor-unit-conversion-example">@conversion.Example</span>
                        }
                    </span>
                </div>
            }
            <div class="sensor-header-meta">
                @if (!string.IsNullOrWhiteSpace(Model.View.LastSeenText))
                {
                    <span class="panel-hint">last @Model.View.LastSeenText</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.View.LastDurationText))
                {
                    <span class="panel-hint">duration @Model.View.LastDurationText</span>
                }
            </div>
            <div class="workspace-row-actions sensor-header-actions">
                <a class="workspace-action-link" asp-page="/ElementEditor" asp-route-selectedId="@Model.View.SensorId" asp-route-returnUrl="@Model.CurrentUrl">
                    @MatmonIcons.Render("pencil")
                    <span>Edit</span>
                </a>
                <form method="post" asp-page-handler="RunNow" asp-route-window="@Model.Window" asp-route-sensorId="@Model.View.SensorId">
                    <button type="submit" class="workspace-secondary-submit">
                        @MatmonIcons.Render("spark")
                        <span>Run now</span>
                    </button>
                </form>
                <form method="post" asp-page-handler="ToggleSensorPause" asp-route-window="@Model.Window" asp-route-sensorId="@Model.View.SensorId">
                    <button type="submit" class="workspace-secondary-submit">
                        @MatmonIcons.Render(Model.View.IsPaused ? "play" : "pause")
                        <span>@(Model.View.IsPaused ? "Resume" : "Pause")</span>
                    </button>
                </form>
                <a class="workspace-action-link" asp-page="/Monitoring">
                    @MatmonIcons.Render("arrow-left")
                    <span>Back</span>
                </a>
            </div>
        </div>
    </div>

    @{
        var statsTabActive = !string.IsNullOrWhiteSpace(Model.StatsGroup)
            || !string.IsNullOrWhiteSpace(Model.StatsFrom)
            || !string.IsNullOrWhiteSpace(Model.StatsTo);
    }
    <nav class="sensor-tabs sensor-detail-tabs" data-sensor-tabs data-tab-hash="true" data-active-tab="@(statsTabActive ? "statistics" : null)" role="tablist" aria-label="Sensor sections">
        <button type="button" class="sensor-tab" data-sensor-tab-target="general" role="tab">@MatmonIcons.Render("dashboard")<span>General</span></button>
        <button type="button" class="sensor-tab" data-sensor-tab-target="statistics" role="tab">@MatmonIcons.Render("chart")<span>Statistics</span></button>
        <button type="button" class="sensor-tab" data-sensor-tab-target="history" role="tab">@MatmonIcons.Render("clock")<span>History</span></button>
    </nav>

    <div class="sensor-detail-tabpanel" data-sensor-tab="general">
        <section class="panel panel-stack sensor-channels-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("signal")<span>Channels</span></h2>
                <span class="panel-hint">@Model.View.Channels.Count</span>
            </div>

            @if (Model.View.Channels.Count == 0)
            {
                <div class="empty-state">No channels yet.</div>
            }
            else
            {
                <div class="sensor-channel-list sensor-channel-grid">
                    @foreach (var channel in Model.View.Channels)
                    {
                        <article class="sensor-channel-row" data-state="@channel.StateKey" data-default="@(channel.IsDefault ? "true" : "false")">
                            <div class="sensor-channel-main">
                                <div class="sensor-channel-name">
                                    <span>@channel.Label</span>
                                    @if (channel.IsDefault)
                                    {
                                        <span class="state-pill" data-state="ok">Graph</span>
                                    }
                                </div>
                                <div class="sensor-channel-meta">
                                    @channel.Key
                                    @if (!string.IsNullOrWhiteSpace(channel.Message))
                                    {
                                        <text>| @channel.Message</text>
                                    }
                                </div>
                            </div>
                            <div class="sensor-channel-side">
                                <div class="sensor-channel-value">@channel.ValueText @channel.Unit</div>
                                @if (channel.VisualKey == "progress" && channel.FillPercent.HasValue)
                                {
                                    <div class="sensor-channel-meter" data-state="@channel.StateKey" title="@channel.FillPercent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">
                                        <span style="width:@channel.FillPercent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                    </div>
                                }
                                else if (channel.VisualKey == "gauge" && channel.FillPercent.HasValue)
                                {
                                    var gaugeDash = (channel.FillPercent.Value / 100d * 125.6d).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                                    <svg class="sensor-channel-gauge" viewBox="0 0 100 56" data-state="@channel.StateKey" aria-hidden="true" title="@channel.FillPercent.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%">
                                        <path class="sensor-channel-gauge-track" d="M10 50 A40 40 0 0 1 90 50" />
                                        <path class="sensor-channel-gauge-fill" d="M10 50 A40 40 0 0 1 90 50" style="stroke-dasharray:@gaugeDash 200" />
                                    </svg>
                                }
                                <span class="state-pill" data-state="@channel.StateKey">@channel.StateLabel</span>
                                <div class="sensor-channel-actions">
                                    <form method="post"
                                          asp-page-handler="SetDefaultChannel"
                                          asp-route-sensorId="@Model.View.SensorId"
                                          asp-route-window="@Model.Window"
                                          asp-route-channelKey="@channel.Key">
                                        <button type="submit" class="workspace-secondary-submit sensor-channel-default-button @(channel.IsDefault ? "is-active" : string.Empty)">
                                            @MatmonIcons.Render(channel.IsDefault ? "chart" : "spark")
                                            <span>@(channel.IsDefault ? "Graph" : "Set graph")</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="sensor-stats-grid">
        @foreach (var window in Model.View.Windows)
        {
            <article class="panel sensor-window-card @(window.Key == Model.View.SelectedWindow.Key ? "is-selected" : string.Empty)" data-state="@window.StateKey">
                <div class="sensor-window-head">
                    <span class="metric-label">@window.Label</span>
                    <span class="state-pill" data-state="@window.StateKey">@window.StateLabel</span>
                </div>
                <div class="sensor-window-figure">
                    <span>AVG</span>
                    <strong>@(window.Average?.ToString("0.###") ?? "-")</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.View.Unit))
                    {
                        <small>@Model.View.Unit</small>
                    }
                </div>
                <div class="sensor-window-mini">
                    <span>MIN @(window.Minimum?.ToString("0.###") ?? "-")</span>
                    <span>MAX @(window.Maximum?.ToString("0.###") ?? "-")</span>
                </div>
                <div class="sensor-window-mini">
                    <span>Samples @window.SampleCount</span>
                    <span>Latest @(window.LatestValue?.ToString("0.###") ?? "-")</span>
                </div>
            </article>
        }
        </div>

        <section class="panel panel-stack sensor-chart-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("chart")<span>@Model.View.SelectedWindow.Label</span></h2>
                <div class="sensor-window-tabs">
                    @foreach (var window in Model.View.Windows)
                    {
                        <a class="sensor-window-tab @(window.Key == Model.View.SelectedWindow.Key ? "is-active" : string.Empty)"
                           asp-page="/SensorDetails"
                           asp-route-sensorId="@Model.View.SensorId"
                           asp-route-window="@window.Key">
                            @window.Label
                        </a>
                    }
                </div>
            </div>

            @if (Model.View.SelectedWindow.SampleCount == 0)
            {
                <div class="empty-state">No history in this window.</div>
            }
            else
            {
                <div class="sensor-window-summary">
                    <span>AVG @(Model.View.SelectedWindow.Average?.ToString("0.###") ?? "-")@(string.IsNullOrWhiteSpace(Model.View.Unit) ? string.Empty : $" {Model.View.Unit}")</span>
                    <span>MIN @(Model.View.SelectedWindow.Minimum?.ToString("0.###") ?? "-")</span>
                    <span>MAX @(Model.View.SelectedWindow.Maximum?.ToString("0.###") ?? "-")</span>
                    <span>@Model.View.SelectedWindow.SampleCount samples</span>
                </div>
                <div class="sensor-chart-legend">
                    <span class="sensor-chart-legend-line" style="--series-color:@Model.View.SelectedWindow.LineColor"></span>
                    <span>Graph: @Model.View.DefaultChannelLabel</span>
                    <span class="panel-hint">used for overview and chart</span>
                </div>
                <svg class="sparkline sensor-chart" viewBox="0 0 100 40" preserveAspectRatio="none" style="--series-color:@Model.View.SelectedWindow.LineColor">
                    <path data-role="area" d="@Model.View.SelectedWindow.AreaPath"></path>
                    <path data-role="line" d="@Model.View.SelectedWindow.LinePath"></path>
                </svg>
                <div class="graph-footer">
                    <span>@Model.View.SelectedWindow.FromUtc.ToLocalTime().ToString("dd.MM HH:mm")</span>
                    <span>@Model.View.SelectedWindow.ToUtc.ToLocalTime().ToString("dd.MM HH:mm")</span>
                </div>
            }
        </section>

    </div>

    <div class="sensor-detail-tabpanel" data-sensor-tab="statistics">
        @if (Model.View.Statistics is { } stats)
        {
            <section class="panel panel-stack sensor-statistics-panel">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("chart")<span>Long-term statistics</span></h2>
                    <span class="panel-hint">@stats.Rows.Count @stats.GranularityLabel.ToLowerInvariant() period@(stats.Rows.Count == 1 ? string.Empty : "s") · @stats.BucketCount buckets</span>
                </div>

                <form method="get" asp-page="/SensorDetails" asp-route-sensorId="@Model.View.SensorId" class="sensor-statistics-controls">
                    <input type="hidden" name="window" value="@Model.Window" />
                    <label class="sensor-statistics-field">
                        <span>From</span>
                        <input type="date" name="StatsFrom" value="@stats.FromText" class="form-control workspace-input" />
                    </label>
                    <label class="sensor-statistics-field">
                        <span>To</span>
                        <input type="date" name="StatsTo" value="@stats.ToText" class="form-control workspace-input" />
                    </label>
                    <label class="sensor-statistics-field">
                        <span>Group by</span>
                        <select name="StatsGroup" class="form-select workspace-select">
                            <option value="native" selected="@(stats.SelectedGroup == "native")">Native</option>
                            <option value="day" selected="@(stats.SelectedGroup == "day")">Day</option>
                            <option value="month" selected="@(stats.SelectedGroup == "month")">Month</option>
                            <option value="year" selected="@(stats.SelectedGroup == "year")">Year</option>
                        </select>
                    </label>
                    <div class="sensor-statistics-actions">
                        <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("search")<span>Apply</span></button>
                        @if (!string.IsNullOrWhiteSpace(stats.FromText) || !string.IsNullOrWhiteSpace(stats.ToText) || stats.SelectedGroup != "native")
                        {
                            <a class="workspace-secondary-submit" href="@($"{Request.PathBase}/monitoring/sensor/{Model.View.SensorId}?window={Model.Window}")">@MatmonIcons.Render("close")<span>Reset</span></a>
                        }
                    </div>
                </form>

                @{
                    var chartRows = stats.Rows.Reverse().ToList();
                    var chartValues = chartRows.Where(r => r.AverageValue.HasValue).Select(r => r.AverageValue!.Value).ToList();
                }
                @if (chartValues.Count > 0)
                {
                    var inv = System.Globalization.CultureInfo.InvariantCulture;
                    var chartMax = chartValues.Max();
                    var chartMin = Math.Min(0d, chartValues.Min());
                    var chartRange = chartMax - chartMin;
                    if (chartRange <= 0d) { chartRange = 1d; }
                    var slot = 100d / chartRows.Count;
                    var barWidth = Math.Min(Math.Max(slot * 0.68d, 0.6d), 12d);
                    <div class="sensor-statistics-chart">
                        <svg viewBox="0 0 100 44" preserveAspectRatio="none" role="img" aria-label="Average per @stats.GranularityLabel.ToLowerInvariant() period">
                            @for (var i = 0; i < chartRows.Count; i++)
                            {
                                var cr = chartRows[i];
                                if (!cr.AverageValue.HasValue)
                                {
                                    continue;
                                }
                                var barHeight = Math.Max((cr.AverageValue.Value - chartMin) / chartRange * 40d, 0.6d);
                                var barX = (i * slot) + ((slot - barWidth) / 2d);
                                var barY = 42d - barHeight;
                                <rect class="sensor-statistics-bar" data-state="@cr.StateKey" x="@(barX.ToString("0.###", inv))" y="@(barY.ToString("0.###", inv))" width="@(barWidth.ToString("0.###", inv))" height="@(barHeight.ToString("0.###", inv))" rx="0.4"><title>@cr.PeriodText — @cr.AverageText</title></rect>
                            }
                        </svg>
                        <div class="sensor-statistics-chart-axis">
                            <span>@chartRows.First().PeriodText</span>
                            <span>@chartRows.Last().PeriodText</span>
                        </div>
                    </div>
                }

                <div class="sensor-statistics-scroll">
                    <table class="sensor-statistics-table">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Avg@(stats.Unit is null ? string.Empty : $" ({stats.Unit})")</th>
                                <th>Min</th>
                                <th>Max</th>
                                <th title="bottom 1 %">1 %</th>
                                <th title="top 1 %">99 %</th>
                                <th>Uptime</th>
                                <th>Samples</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in stats.Rows)
                            {
                                var drillHref = row.DrillGroup is null
                                    ? null
                                    : $"{Request.PathBase}/monitoring/sensor/{Model.View.SensorId}?window={Model.Window}&StatsFrom={row.DrillFrom}&StatsTo={row.DrillTo}&StatsGroup={row.DrillGroup}";
                                <tr data-state="@row.StateKey" class="@(drillHref is null ? null : "is-clickable")" data-href="@drillHref" title="@(drillHref is null ? null : $"Drill into {row.PeriodText}")">
                                    <td>@row.PeriodText@if (drillHref is not null) {<span class="sensor-statistics-drill">›</span>}</td>
                                    <td class="is-strong">@row.AverageText</td>
                                    <td>@row.MinimumText</td>
                                    <td>@row.MaximumText</td>
                                    <td>@row.LowPercentileText</td>
                                    <td>@row.HighPercentileText</td>
                                    <td>@(row.UptimeText ?? "—")</td>
                                    <td>@row.SampleCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (stats.Rows.Count == 0)
                    {
                        <div class="empty-state">No statistics in this range.</div>
                    }
                </div>
            </section>
        }
        else
        {
            <div class="panel empty-state">No long-term statistics collected yet.</div>
        }
    </div>

    <div class="sensor-detail-tabpanel" data-sensor-tab="history">
        <section class="panel panel-stack">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>Last results</span></h2>
                <span class="panel-hint">@Model.View.RecentObservations.Count</span>
            </div>

            @if (Model.View.RecentObservations.Count == 0)
            {
                <div class="empty-state">No measurements yet.</div>
            }
            else
            {
                <div class="sensor-observation-list">
                    @foreach (var observation in Model.View.RecentObservations)
                    {
                        <article class="sensor-observation-row" data-state="@observation.StateKey">
                            <div class="sensor-observation-main">
                                <div class="sensor-observation-name">
                                    <span>@observation.TimestampText</span>
                                    @if (observation.ChannelCount > 1)
                                    {
                                        <span class="state-pill" data-state="paused">@observation.ChannelCount channels</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(observation.ExecutionProbe))
                                    {
                                        <span class="state-pill" data-state="ok">@observation.ExecutionProbe</span>
                                    }
                                </div>
                                <div class="sensor-observation-meta">@observation.Message</div>
                            </div>
                            <div class="sensor-observation-side">
                                <div class="sensor-channel-value">@observation.ValueText @observation.Unit</div>
                                <span class="state-pill" data-state="@observation.StateKey">@observation.StateLabel</span>
                                <span class="sensor-observation-meta">duration @observation.DurationText</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>

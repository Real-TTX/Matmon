@page "/monitoring/sensor/{sensorId:guid}"
@model SensorDetailsModel
@{
    var view = Model.View;
    ViewData["Title"] = view.Name;
    ViewData["PageSub"] = view.Path;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // The Statistics tab opens when the address carries one of its filters (the server decides; "#name" in the
    // address opens a tab too - core.js).
    var statsTabActive = !string.IsNullOrWhiteSpace(Model.StatsGroup)
        || !string.IsNullOrWhiteSpace(Model.StatsRange)
        || !string.IsNullOrWhiteSpace(Model.StatsFrom)
        || !string.IsNullOrWhiteSpace(Model.StatsTo)
        || !string.IsNullOrWhiteSpace(Model.StatsChannel);

    string StateTextClass(string key) => key switch
    {
        "ok" => "mat-text-success",
        "warning" => "mat-text-warning",
        "error" => "mat-text-danger",
        _ => "mat-text-muted"
    };
    string? MeterTone(string key) => key switch
    {
        "ok" or "healthy" => "ok",
        "warning" => "warn",
        "error" or "critical" => "error",
        _ => null
    };
    string UsageTone(string key) => key switch
    {
        "low" => "ok",
        "high" => "error",
        _ => "warn"
    };
}

@* The actions of the sensor. One hidden form carries the anti-forgery token; every button posts it to its own handler
   (formaction), so the actions stay one row of buttons (MatUi keeps their order). *@
<form method="post" id="sensor-actions" hidden></form>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<div class="mat-actions">
    <button type="submit" form="sensor-actions" asp-page-handler="RunNow" asp-route-window="@Model.Window" asp-route-sensorId="@view.SensorId" class="mat-btn mat-btn--primary">@MatUi.Icon("refresh")<span>Run now</span></button>
    <button type="submit" form="sensor-actions" asp-page-handler="ToggleSensorPause" asp-route-window="@Model.Window" asp-route-sensorId="@view.SensorId" class="mat-btn mat-btn--secondary">@MatUi.Icon(view.IsPaused ? "play" : "pause")<span>@(view.IsPaused ? "Resume" : "Pause")</span></button>
    <a class="mat-btn mat-btn--secondary" asp-page="/ElementEditor" asp-route-selectedId="@view.SensorId" asp-route-returnUrl="@Model.CurrentUrl">@MatUi.Icon("edit")<span>Edit</span></a>
    @if (Model.SyslogLogRoute is { } syslogRoute)
    {
        <a class="mat-btn mat-btn--ghost" asp-page="/Events" asp-all-route-data="@syslogRoute" asp-fragment="syslog" data-tip="The messages this sensor counts">@MatUi.Icon("list")<span>Log</span></a>
    }
</div>

<div class="mat-grid mat-grid--4">
    <div class="mat-card">
        <div class="mat-card__body mat-stat">
            <span class="mat-stat__label">Current value</span>
            <span class="mat-stat__value sensor-current-value">
                <span>@view.CurrentValueText</span>
                @if (!string.IsNullOrWhiteSpace(view.Unit))
                {
                    <small>@view.Unit</small>
                }
            </span>
            <span class="mat-stat__delta">primary: @view.DefaultChannelLabel</span>
        </div>
    </div>
    <div class="mat-card">
        <div class="mat-card__body mat-stat">
            <span class="mat-stat__label">State</span>
            <span class="mat-stat__value @StateTextClass(view.StateKey)">@view.StateLabel</span>
            @if (view.IsAcknowledged)
            {
                <span class="mat-stat__delta"><span class="mat-pill mat-pill--info">Acknowledged</span></span>
            }
        </div>
    </div>
    <div class="mat-card">
        <div class="mat-card__body mat-stat">
            <span class="mat-stat__label">Last check</span>
            <span class="mat-stat__value">@(view.LastSeenText ?? "–")</span>
            @if (!string.IsNullOrWhiteSpace(view.LastDurationText))
            {
                <span class="mat-stat__delta">duration @view.LastDurationText</span>
            }
        </div>
    </div>
    <div class="mat-card">
        <div class="mat-card__body mat-stat">
            <span class="mat-stat__label">Type</span>
            <span class="mat-stat__value sensor-type-value">@view.SensorTypeLabel</span>
            <span class="mat-stat__delta"><span class="@MatUi.PillClass(UsageTone(view.UsageLevelKey))" data-tip="How much load a check puts on the target">@view.UsageLevelLabel usage</span></span>
        </div>
    </div>
</div>

<section data-tabs data-tab-hash>
    <div class="mat-tabs" role="tablist" aria-label="Sensor sections">
        <button type="button" class="mat-tab" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="@(statsTabActive ? "false" : "true")" tabindex="@(statsTabActive ? "-1" : null)">General</button>
        <button type="button" class="mat-tab" role="tab" id="tab-statistics" aria-controls="panel-statistics" aria-selected="@(statsTabActive ? "true" : "false")" tabindex="@(statsTabActive ? null : "-1")">Statistics</button>
        <button type="button" class="mat-tab" role="tab" id="tab-history" aria-controls="panel-history" aria-selected="false" tabindex="-1">History</button>
    </div>

    @* ---------- GENERAL ---------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-general" aria-labelledby="tab-general" hidden="@statsTabActive">
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("info")<h2 class="mat-card__title">Details</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @if (!string.IsNullOrWhiteSpace(view.StateMessage))
                    {
                        <dt>Message</dt>
                        <dd>@view.StateMessage</dd>
                    }
                    <dt>Target</dt>
                    <dd class="mat-mono">@view.Target</dd>
                    @if (!string.IsNullOrWhiteSpace(view.ExecutionProbe))
                    {
                        <dt>Probe</dt>
                        <dd>@view.ExecutionProbe</dd>
                    }
                    <dt>Settings</dt>
                    <dd>@view.SettingsSummary</dd>
                    @if (view.UnitConversion is { } conversion)
                    {
                        <dt>Unit</dt>
                        <dd data-tip="How the stored measurement is converted for display" data-tip-align="start">
                            stored <strong>@conversion.RawUnit</strong> → shown <strong>@conversion.DisplayUnit</strong>
                            @if (!string.IsNullOrWhiteSpace(conversion.Example))
                            {
                                <span class="mat-text-muted">@conversion.Example</span>
                            }
                        </dd>
                    }
                    @if (view.Tags.Count > 0)
                    {
                        <dt>Tags</dt>
                        <dd>
                            <span class="mat-chips">
                                @foreach (var tag in view.Tags)
                                {
                                    <span class="mat-tag @(tag.Inherited ? "sensor-tag--inherited" : null)" data-tip="@(tag.Inherited ? "inherited from a parent" : "tag")">
                                        @MatUi.Icon("tag")
                                        <span>@tag.Text</span>
                                        @if (tag.Inherited)
                                        {
                                            <span class="mat-sr-only">(inherited)</span>
                                        }
                                    </span>
                                }
                            </span>
                        </dd>
                    }
                </dl>
            </div>
        </section>

        <section class="mat-section">
            <div class="mat-row mat-row--between">
                <h2 class="sensor-section-title">@MatUi.Icon("activity")<span>Channels</span></h2>
                <span class="mat-badge mat-badge--soft">@view.Channels.Count<span class="mat-sr-only"> channels</span></span>
            </div>

            @if (view.Channels.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("activity")</span>
                    <div class="mat-empty__title">No channels yet</div>
                    <p>The channels appear after the sensor's first run - or press Run now.</p>
                </div>
            }
            else
            {
                <div class="sensor-channel-grid">
                    @foreach (var channel in view.Channels)
                    {
                        var fillText = channel.FillPercent?.ToString("0.#", inv);
                        <article class="mat-card sensor-channel" data-state="@channel.StateKey" data-default="@(channel.IsDefault ? "true" : "false")">
                            <div class="mat-card__body sensor-channel-body">
                                <div class="sensor-channel-main">
                                    <div class="mat-row sensor-channel-name">
                                        <strong>@channel.Label</strong>
                                        @if (channel.IsDefault)
                                        {
                                            <span class="mat-pill mat-pill--accent">Primary</span>
                                        }
                                    </div>
                                    <span class="mat-text-muted mat-mono sensor-channel-key">@channel.Key</span>
                                    @if (!string.IsNullOrWhiteSpace(channel.Message))
                                    {
                                        <span class="mat-text-muted sensor-channel-message">@channel.Message</span>
                                    }
                                </div>
                                <div class="sensor-channel-side">
                                    <span class="sensor-channel-value">@channel.ValueText @channel.Unit</span>
                                    @if (channel.VisualKey == "progress" && channel.FillPercent.HasValue)
                                    {
                                        <div class="sensor-channel-meter">
                                            <div class="mat-meter mat-meter--sm" role="progressbar" aria-valuenow="@fillText" aria-valuemin="0" aria-valuemax="100" aria-label="@channel.Label: @fillText %">
                                                <div class="mat-meter__fill" data-value="@fillText" data-tone="@MeterTone(channel.StateKey)"></div>
                                            </div>
                                        </div>
                                    }
                                    else if (channel.VisualKey == "gauge" && channel.FillPercent.HasValue)
                                    {
                                        @* pathLength="100": the dash is the percentage itself, no arc length to compute. *@
                                        <svg class="sensor-channel-gauge" viewBox="0 0 100 56" data-state="@channel.StateKey" aria-hidden="true" style="--gauge-fill: @fillText">
                                            <path class="sensor-channel-gauge-track" d="M10 50 A40 40 0 0 1 90 50" pathLength="100" />
                                            <path class="sensor-channel-gauge-fill" d="M10 50 A40 40 0 0 1 90 50" pathLength="100" />
                                        </svg>
                                    }
                                    <span class="@MatUi.PillClass(channel.StateKey)">@channel.StateLabel</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="mat-grid mat-grid--3">
            @foreach (var window in view.Windows)
            {
                var isSelected = window.Key == view.SelectedWindow.Key;
                <article class="mat-card @(isSelected ? "mat-card--accent" : null)">
                    <div class="mat-card__body mat-stat">
                        <div class="mat-row mat-row--between">
                            <span class="mat-stat__label">@window.Label</span>
                            <span class="@MatUi.PillClass(window.StateKey)">@window.StateLabel</span>
                        </div>
                        <span class="mat-stat__value sensor-window-value">
                            <small>avg</small>
                            <span>@(window.Average?.ToString("0.###") ?? "-")</span>
                            @if (!string.IsNullOrWhiteSpace(view.Unit))
                            {
                                <small>@view.Unit</small>
                            }
                        </span>
                        <span class="mat-stat__delta">min @(window.Minimum?.ToString("0.###") ?? "-") · max @(window.Maximum?.ToString("0.###") ?? "-")</span>
                        <span class="mat-stat__delta">@window.SampleCount checks · latest @(window.LatestValue?.ToString("0.###") ?? "-")</span>
                    </div>
                </article>
            }
        </div>

        @{
            var win = view.SelectedWindow;
        }
        <section class="mat-card sensor-chart-card" data-chart-state="@view.StateKey">
            <div class="mat-card__head">
                @MatUi.Icon("bar-chart")
                <h2 class="mat-card__title">@win.Label</h2>
                <nav class="mat-seg mm-push-end" aria-label="Time window">
                    @foreach (var window in view.Windows)
                    {
                        var isSelected = window.Key == win.Key;
                        <a class="mat-seg__btn @(isSelected ? "is-active" : null)" aria-current="@(isSelected ? "true" : null)"
                           asp-page="/SensorDetails"
                           asp-route-sensorId="@view.SensorId"
                           asp-route-window="@window.Key">@window.Label</a>
                    }
                </nav>
            </div>
            <div class="mat-card__body mat-stack">
                @if (win.SampleCount == 0)
                {
                    <p class="mat-muted">No history in this window.</p>
                }
                else
                {
                    var chartPointsJson = "[" + string.Join(",", win.Points.Select(p =>
                        $"[{p.TimestampUtc.ToUnixTimeMilliseconds()},{p.Value.ToString("0.######", inv)}]")) + "]";
                    <div class="sensor-window-summary">
                        <span>avg @(win.Average?.ToString("0.###") ?? "-")@(string.IsNullOrWhiteSpace(view.Unit) ? string.Empty : $" {view.Unit}")</span>
                        <span>min @(win.Minimum?.ToString("0.###") ?? "-")</span>
                        <span>max @(win.Maximum?.ToString("0.###") ?? "-")</span>
                        <span>@win.SampleCount checks</span>
                    </div>
                    <div class="sensor-chart-legend">
                        <span class="sensor-chart-legend-line" aria-hidden="true"></span>
                        <span>Primary: @view.DefaultChannelLabel</span>
                        <span class="mat-text-muted">used for overview, chart &amp; statistics</span>
                    </div>
                    <div class="sensor-chart-wrap" data-chart="line"
                         data-chart-points="@chartPointsJson"
                         data-chart-min="@win.GraphMin.ToString("0.######", inv)"
                         data-chart-max="@win.GraphMax.ToString("0.######", inv)"
                         data-chart-from="@win.FromUtc.ToUnixTimeMilliseconds()"
                         data-chart-to="@win.ToUtc.ToUnixTimeMilliseconds()"
                         data-chart-unit="@view.Unit">
                        <div class="sensor-chart-axis-y" aria-hidden="true">
                            <span>@win.GraphMax.ToString("0.##", inv)</span>
                            <span>@win.GraphMin.ToString("0.##", inv)</span>
                        </div>
                        <svg class="sparkline sensor-chart" viewBox="0 0 100 40" preserveAspectRatio="none" role="img" aria-label="@view.DefaultChannelLabel over @win.Label">
                            <path data-role="area" d="@win.AreaPath"></path>
                            <path data-role="line" d="@win.LinePath"></path>
                        </svg>
                    </div>
                    <div class="graph-footer">
                        <span>@win.FromUtc.ToDisplay().ToString("dd.MM HH:mm")</span>
                        <span>@win.ToUtc.ToDisplay().ToString("dd.MM HH:mm")</span>
                    </div>
                }
            </div>
        </section>
    </div>

    @* ---------- STATISTICS ---------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-statistics" aria-labelledby="tab-statistics" hidden="@(!statsTabActive)">
        @if (view.Statistics is { } stats)
        {
            var statsBase = $"{Request.PathBase}/monitoring/sensor/{view.SensorId}";
            var channelQuery = Uri.EscapeDataString(stats.SelectedChannelKey);
            var granularity = stats.GranularityLabel.ToLowerInvariant();
            var hasChannelChoice = stats.Channels.Count > 1;
            var selectedChannelLabel = stats.Channels.FirstOrDefault(c => c.IsSelected)?.Label ?? stats.SelectedChannelKey;
            var groupLabels = new Dictionary<string, string> { ["native"] = "Native", ["day"] = "Day", ["month"] = "Month", ["year"] = "Year" };

            // The address of the statistics without some of the filters in effect: the link of a chip's X. Every link
            // ends in #statistics so the tab stays open whatever is left.
            string StatsUrlWithout(params string[] keys)
            {
                var current = new (string Key, string? Value)[]
                {
                    ("window", Model.Window), ("StatsRange", Model.StatsRange), ("StatsFrom", Model.StatsFrom),
                    ("StatsTo", Model.StatsTo), ("StatsGroup", Model.StatsGroup), ("StatsChannel", Model.StatsChannel)
                };
                var parts = current
                    .Where(p => !string.IsNullOrWhiteSpace(p.Value) && !keys.Contains(p.Key, StringComparer.OrdinalIgnoreCase))
                    .Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value!)}");
                var query = string.Join("&", parts);
                return statsBase + (query.Length > 0 ? "?" + query : string.Empty) + "#statistics";
            }

            var showGroupChip = !string.IsNullOrWhiteSpace(Model.StatsGroup);
            var showPeriodChip = !string.IsNullOrWhiteSpace(Model.StatsFrom) || !string.IsNullOrWhiteSpace(Model.StatsTo);
            var showChannelChip = hasChannelChoice && !string.IsNullOrWhiteSpace(Model.StatsChannel);
            var activeFilters = (showGroupChip ? 1 : 0) + (showPeriodChip ? 1 : 0) + (showChannelChip ? 1 : 0);

            <div class="mat-toolbar" role="toolbar" aria-label="Statistics tools">
                <nav class="mat-seg" aria-label="Range">
                    @foreach (var rangeOption in new[] { ("24h", "24h"), ("7d", "7d"), ("30d", "30d"), ("90d", "90d"), ("all", "All") })
                    {
                        var isActive = stats.SelectedRange == rangeOption.Item1;
                        <a class="mat-seg__btn @(isActive ? "is-active" : null)" aria-current="@(isActive ? "true" : null)"
                           href="@($"{statsBase}?window={Model.Window}&StatsRange={rangeOption.Item1}&StatsChannel={channelQuery}#statistics")">@rangeOption.Item2</a>
                    }
                </nav>
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info" aria-live="polite">@stats.Rows.Count @granularity period@(stats.Rows.Count == 1 ? string.Empty : "s") · @stats.BucketCount buckets</span>
                <div class="mat-toolbar__end">
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(activeFilters > 0 ? "is-active" : null)" data-dialog-open="stats-filter" aria-haspopup="dialog">
                        @MatUi.Icon("sliders")<span>Filter</span>
                        @if (activeFilters > 0)
                        {
                            <span class="mat-badge">@activeFilters</span>
                        }
                    </button>
                </div>
            </div>

            @if (activeFilters > 0)
            {
                <div class="mat-chips" role="group" aria-label="Filters in effect">
                    @if (showChannelChip)
                    {
                        <span class="mat-chip">Channel: @selectedChannelLabel<a class="mat-chip__x" href="@StatsUrlWithout("StatsChannel")" aria-label="Remove the filter Channel">@MatUi.Icon("x")</a></span>
                    }
                    @if (showPeriodChip)
                    {
                        <span class="mat-chip">Period: @(stats.FromText ?? "…") – @(stats.ToText ?? "…")<a class="mat-chip__x" href="@StatsUrlWithout("StatsFrom", "StatsTo")" aria-label="Remove the filter Period">@MatUi.Icon("x")</a></span>
                    }
                    @if (showGroupChip)
                    {
                        <span class="mat-chip">Group by: @(groupLabels.TryGetValue(stats.SelectedGroup, out var groupLabel) ? groupLabel : stats.SelectedGroup)<a class="mat-chip__x" href="@StatsUrlWithout("StatsGroup")" aria-label="Remove the filter Group by">@MatUi.Icon("x")</a></span>
                    }
                </div>
            }

            <form id="stats-form" method="get" action="@($"{statsBase}#statistics")" hidden>
                <input type="hidden" name="window" value="@Model.Window" />
                <input type="hidden" name="StatsRange" value="@(stats.SelectedRange == "custom" ? string.Empty : stats.SelectedRange)" />
                @if (!hasChannelChoice)
                {
                    <input type="hidden" name="StatsChannel" value="@stats.SelectedChannelKey" />
                }
            </form>

            <dialog class="mat-dialog mat-dialog--sm" id="stats-filter" aria-labelledby="stats-filter-title">
                <div class="mat-dialog__form">
                    <div class="mat-dialog__head">
                        @MatUi.Icon("sliders")
                        <h2 class="mat-dialog__title" id="stats-filter-title">Filter</h2>
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                    </div>
                    <div class="mat-dialog__body mat-form">
                        @if (hasChannelChoice)
                        {
                            <div class="mat-field">
                                <label class="mat-label" for="stats-channel">Channel</label>
                                <select class="mat-select" id="stats-channel" name="StatsChannel" form="stats-form">
                                    @foreach (var channelOption in stats.Channels)
                                    {
                                        <option value="@channelOption.Key" selected="@channelOption.IsSelected">@channelOption.Label</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="mat-form__grid">
                            <div class="mat-field">
                                <label class="mat-label" for="stats-from">From</label>
                                <input class="mat-input mat-mono" type="date" id="stats-from" name="StatsFrom" value="@stats.FromText" form="stats-form" />
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" for="stats-to">To</label>
                                <input class="mat-input mat-mono" type="date" id="stats-to" name="StatsTo" value="@stats.ToText" form="stats-form" />
                            </div>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="stats-group">Group by</label>
                            <select class="mat-select" id="stats-group" name="StatsGroup" form="stats-form">
                                <option value="native" selected="@(stats.SelectedGroup == "native")">Native</option>
                                <option value="day" selected="@(stats.SelectedGroup == "day")">Day</option>
                                <option value="month" selected="@(stats.SelectedGroup == "month")">Month</option>
                                <option value="year" selected="@(stats.SelectedGroup == "year")">Year</option>
                            </select>
                        </div>
                    </div>
                    <div class="mat-dialog__foot">
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" form="stats-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sliders")<span>Apply</span></button>
                            <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                            @if (stats.SelectedRange != "7d" || stats.SelectedGroup != "day")
                            {
                                <span class="mat-btn-row__spacer"></span>
                                <a class="mat-btn mat-btn--ghost mat-btn--end" href="@($"{statsBase}?window={Model.Window}&StatsChannel={channelQuery}#statistics")">Reset everything</a>
                            }
                        </div>
                    </div>
                </div>
            </dialog>

            var chartRows = stats.Rows.Reverse().ToList();
            var chartValues = chartRows.Where(r => r.AverageValue.HasValue).Select(r => r.AverageValue!.Value).ToList();
            @if (chartValues.Count > 0)
            {
                var chartMax = chartValues.Max();
                var chartMin = Math.Min(0d, chartValues.Min());
                var chartRange = chartMax - chartMin;
                if (chartRange <= 0d) { chartRange = 1d; }
                var slot = 100d / chartRows.Count;
                var barWidth = Math.Min(Math.Max(slot * 0.68d, 0.6d), 12d);
                var unitSuffix = string.IsNullOrWhiteSpace(stats.Unit) ? string.Empty : $" {stats.Unit}";
                <section class="mat-card">
                    <div class="mat-card__head">
                        @MatUi.Icon("bar-chart")
                        <h2 class="mat-card__title">Long-term statistics</h2>
                        <span class="mat-text-muted mm-push-end">average per @granularity period</span>
                    </div>
                    <div class="mat-card__body">
                        <div class="sensor-statistics-chart sensor-chart-wrap" data-chart="bars">
                            <div class="sensor-chart-plot">
                                <div class="sensor-chart-axis-y" aria-hidden="true">
                                    <span>@chartMax.ToString("0.##", inv)</span>
                                    <span>@chartMin.ToString("0.##", inv)</span>
                                </div>
                                <svg viewBox="0 0 100 44" preserveAspectRatio="none" role="img" aria-label="Average per @granularity period">
                                    @for (var i = 0; i < chartRows.Count; i++)
                                    {
                                        var cr = chartRows[i];
                                        if (!cr.AverageValue.HasValue)
                                        {
                                            continue;
                                        }
                                        var barHeight = Math.Max((cr.AverageValue.Value - chartMin) / chartRange * 40d, 0.6d);
                                        var barX = (i * slot) + ((slot - barWidth) / 2d);
                                        var barY = 42d - barHeight;
                                        var barTip = $"{cr.PeriodText} · avg {cr.AverageText}{unitSuffix} · min {cr.MinimumText} · max {cr.MaximumText}" + (cr.UptimeText is null ? string.Empty : $" · {cr.UptimeText} OK") + $" · {cr.SampleCount} checks";
                                        <rect class="sensor-statistics-bar" data-state="@cr.StateKey" data-bar-tip="@barTip" x="@(barX.ToString("0.###", inv))" y="@(barY.ToString("0.###", inv))" width="@(barWidth.ToString("0.###", inv))" height="@(barHeight.ToString("0.###", inv))" rx="0.4"></rect>
                                    }
                                </svg>
                            </div>
                            <div class="sensor-statistics-chart-axis">
                                <span>@chartRows.First().PeriodText</span>
                                <span>@chartRows.Last().PeriodText</span>
                            </div>
                        </div>
                    </div>
                </section>
            }

            @if (stats.Rows.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("bar-chart")</span>
                    <div class="mat-empty__title">No statistics in this range</div>
                    <p>Choose a longer range, or reset the filters.</p>
                </div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table mat-table--compact sensor-statistics-table">
                        <caption class="mat-sr-only">Statistics per @granularity period of @selectedChannelLabel</caption>
                        <thead>
                            <tr>
                                <th scope="col">Period</th>
                                <th scope="col" class="mat-num">Avg@(stats.Unit is null ? string.Empty : $" ({stats.Unit})")</th>
                                <th scope="col" class="mat-num">Min</th>
                                <th scope="col" class="mat-num">Max</th>
                                <th scope="col" class="mat-num mat-hide-sm" title="bottom 1 %">1 %</th>
                                <th scope="col" class="mat-num mat-hide-sm" title="top 1 %">99 %</th>
                                <th scope="col" class="mat-num" title="share of checks in the OK state">OK %</th>
                                <th scope="col" class="mat-num">Checks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in stats.Rows)
                            {
                                var drillHref = row.DrillGroup is null
                                    ? null
                                    : $"{statsBase}?window={Model.Window}&StatsFrom={row.DrillFrom}&StatsTo={row.DrillTo}&StatsGroup={row.DrillGroup}&StatsChannel={channelQuery}#statistics";
                                <tr data-state="@row.StateKey" data-href="@drillHref">
                                    <td data-label="Period" class="mat-table__primary mat-mono">
                                        @if (drillHref is not null)
                                        {
                                            <a href="@drillHref" data-tip="Drill into @row.PeriodText" data-tip-align="start">@row.PeriodText</a>
                                        }
                                        else
                                        {
                                            @row.PeriodText
                                        }
                                    </td>
                                    <td data-label="Avg" class="mat-num mat-mono mat-table__keep-label"><strong>@row.AverageText</strong></td>
                                    <td data-label="Min" class="mat-num mat-mono mat-table__keep-label">@row.MinimumText</td>
                                    <td data-label="Max" class="mat-num mat-mono mat-table__keep-label">@row.MaximumText</td>
                                    <td data-label="1 %" class="mat-num mat-mono mat-hide-sm mat-table__keep-label">@row.LowPercentileText</td>
                                    <td data-label="99 %" class="mat-num mat-mono mat-hide-sm mat-table__keep-label">@row.HighPercentileText</td>
                                    <td data-label="OK %" class="mat-num mat-mono mat-table__keep-label">@(row.UptimeText ?? "-")</td>
                                    <td data-label="Checks" class="mat-num mat-mono mat-table__keep-label">@row.SampleCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="mat-empty mat-empty--framed">
                <span class="mat-empty__icon">@MatUi.Icon("bar-chart")</span>
                <div class="mat-empty__title">No long-term statistics yet</div>
                <p>Statistics are rolled up from the sensor's history every few minutes.</p>
            </div>
        }
    </div>

    @* ---------- HISTORY ---------- *@
    <div class="mat-tabpanel" role="tabpanel" id="panel-history" aria-labelledby="tab-history" hidden>
        @if (view.RecentObservations.Count == 0)
        {
            <div class="mat-empty mat-empty--framed">
                <span class="mat-empty__icon">@MatUi.Icon("clock")</span>
                <div class="mat-empty__title">No measurements yet</div>
                <p>The first result appears after the sensor has run - or press Run now.</p>
            </div>
        }
        else
        {
            <section class="mat-card">
                <div class="mat-card__head">
                    @MatUi.Icon("clock")
                    <h2 class="mat-card__title">Last results</h2>
                    <span class="mat-text-muted mm-push-end">@view.RecentObservations.Count shown</span>
                </div>
                <div class="mat-table-wrap sensor-history-table">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Last results of @view.Name</caption>
                        <thead>
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">State</th>
                                <th scope="col" class="mat-num">Value</th>
                                <th scope="col" class="mat-num mat-hide-sm">Duration</th>
                                <th scope="col" class="mat-hide-sm">Probe</th>
                                <th scope="col">Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var observation in view.RecentObservations)
                            {
                                <tr data-state="@observation.StateKey">
                                    <td data-label="Time" class="mat-mono">@observation.TimestampText</td>
                                    <td data-label="State"><span class="@MatUi.PillClass(observation.StateKey)">@observation.StateLabel</span></td>
                                    <td data-label="Value" class="mat-num mat-mono">
                                        @observation.ValueText @observation.Unit
                                        @if (observation.ChannelCount > 1)
                                        {
                                            <span class="mat-tag">@observation.ChannelCount channels</span>
                                        }
                                    </td>
                                    <td data-label="Duration" class="mat-num mat-mono mat-hide-sm">@observation.DurationText</td>
                                    <td data-label="Probe" class="mat-hide-sm">@observation.ExecutionProbe</td>
                                    <td data-label="Message" class="mm-break">@observation.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
</section>

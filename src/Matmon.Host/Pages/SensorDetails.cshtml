@page "/monitoring/sensor/{sensorId:guid}"
@model SensorDetailsModel
@{
    var view = Model.View;
    ViewData["Title"] = view.Name;
    ViewData["PageSub"] = view.Path;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // The Statistics tab opens when the address carries one of its filters (the server decides; "#name" in the
    // address opens a tab too - core.js).
    var statsTabActive = !string.IsNullOrWhiteSpace(Model.StatsGroup)
        || !string.IsNullOrWhiteSpace(Model.StatsRange)
        || !string.IsNullOrWhiteSpace(Model.StatsFrom)
        || !string.IsNullOrWhiteSpace(Model.StatsTo)
        || !string.IsNullOrWhiteSpace(Model.StatsChannel);

    // The same for the History tab: its view, a filter or a page of one of its lists in the address opens it.
    var activeTab = Model.HistoryRequested ? "history"
        : statsTabActive ? "statistics"
        : "general";
    statsTabActive = activeTab == "statistics";
    // History is ONE tab with three lists - the checks, the status history, the alerts - switched in its toolbar.
    var historyView = Model.ActiveHistoryView;

    // The address of this page with some query values replaced (null = removed), opening the History tab on the given
    // list (checks / status / alerts).
    string HistoryUrl(string list, params (string Key, string? Value)[] changes)
    {
        var values = Request.Query.ToDictionary(kv => kv.Key, kv => (string?)kv.Value.ToString(), StringComparer.OrdinalIgnoreCase);
        values["history"] = list;
        foreach (var (key, value) in changes)
        {
            values[key] = value;
        }

        var query = string.Join("&", values
            .Where(kv => !string.IsNullOrEmpty(kv.Value))
            .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));
        return $"{Request.PathBase}/monitoring/sensor/{view.SensorId}{(query.Length > 0 ? "?" + query : string.Empty)}#history";
    }

    // The switch in the History toolbar. Switching keeps each list's own filter and page out of the others' address.
    void HistorySwitch()
    {
        <nav class="mat-seg" aria-label="History">
            @foreach (var (list, label, icon) in new[] { ("checks", "Checks", "list"), ("status", "Status", "activity"), ("alerts", "Alerts", "bell") })
            {
                var on = historyView == list;
                <a class="mat-seg__btn@(on ? " is-active" : string.Empty)" href="@HistoryUrl(list, ("checks", list == "checks" ? Request.Query["checks"].ToString() : null), ("checksPage", null), ("status", list == "status" ? Request.Query["status"].ToString() : null), ("statusPage", null), ("alerts", list == "alerts" ? Request.Query["alerts"].ToString() : null), ("alertsPage", null))" aria-current="@(on ? "page" : null)">@MatUi.Icon(icon)<span>@label</span></a>
            }
        </nav>
    }

    // The pager of a history list (LIST-06): nothing for one page; the first, the last and two either side of the current.
    void Pager(string tab, string pageKey, int page, int pageCount, int total)
    {
        if (pageCount <= 1)
        {
            return;
        }

        var size = SensorDetailsModel.HistoryPageSize;
        var last = 0;
        <nav class="mat-pager" aria-label="Pagination">
            <span class="mat-pager__info">@((page - 1) * size + 1) to @Math.Min(page * size, total) of @MonitoringDisplay.FormatCount(total)</span>
            <div class="mat-pager__pages">
                @if (page > 1)
                {
                    <a class="mat-pager__btn" href="@HistoryUrl(tab, (pageKey, (page - 1).ToString(inv)))" aria-label="Previous page" rel="prev">@MatUi.Icon("chevron-left")</a>
                }
                else
                {
                    <span class="mat-pager__btn is-disabled" aria-hidden="true">@MatUi.Icon("chevron-left")</span>
                }
                @for (var p = 1; p <= pageCount; p++)
                {
                    if (p != 1 && p != pageCount && Math.Abs(p - page) > 2)
                    {
                        continue;
                    }

                    if (last != 0 && p - last > 1)
                    {
                        <span class="mat-pager__gap" aria-hidden="true">…</span>
                    }

                    last = p;
                    if (p == page)
                    {
                        <span class="mat-pager__btn is-current" aria-current="page">@p</span>
                    }
                    else
                    {
                        <a class="mat-pager__btn" href="@HistoryUrl(tab, (pageKey, p.ToString(inv)))" aria-label="Page @p">@p</a>
                    }
                }
                @if (page < pageCount)
                {
                    <a class="mat-pager__btn" href="@HistoryUrl(tab, (pageKey, (page + 1).ToString(inv)))" aria-label="Next page" rel="next">@MatUi.Icon("chevron-right")</a>
                }
                else
                {
                    <span class="mat-pager__btn is-disabled" aria-hidden="true">@MatUi.Icon("chevron-right")</span>
                }
            </div>
        </nav>
    }

    // The State tile takes the state's tone; any other state (paused, unknown) keeps a plain tile with a muted word.
    string? StateTileTone(string key) => key switch
    {
        "ok" => "mat-stat--success",
        "warning" => "mat-stat--warning",
        "error" => "mat-stat--danger",
        _ => null
    };
    string? MeterTone(string key) => key switch
    {
        "ok" or "healthy" => "ok",
        "warning" => "warn",
        "error" or "critical" => "error",
        _ => null
    };
    string UsageTone(string key) => key switch
    {
        "low" => "ok",
        "high" => "error",
        _ => "warn"
    };
}

@* The actions of the sensor. One hidden form carries the anti-forgery token; every button posts it to its own handler
   (formaction), so the actions stay one row of buttons (MatUi keeps their order). *@
<form method="post" id="sensor-actions" hidden></form>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (Model.Maintenance is { } maintenance)
{
    <div class="mat-alert mat-alert--info" role="status">@MatUi.Icon("wrench")<div class="mat-alert__body">In maintenance: <a asp-page="/Maintenance">@maintenance.Name</a> until @Matmon.Core.Domain.MaintenanceSchedule.Format(maintenance.EndsUtc, Matmon.Core.Domain.DisplayTimeZone.Current). No new alerts until then.</div></div>
}

@if (Model.Dependency is { HoldsThisSensor: true } holding)
{
    <div class="mat-alert mat-alert--info" role="status">@MatUi.Icon("link")<div class="mat-alert__body">Its dependency <a asp-page="/SensorDetails" asp-route-sensorId="@holding.SensorId">@holding.Name</a> is down - this sensor shows Unknown and raises no alert until it is up again.</div></div>
}

<div class="mat-actions">
    <button type="submit" form="sensor-actions" asp-page-handler="RunNow" asp-route-window="@Model.Window" asp-route-sensorId="@view.SensorId" class="mat-btn mat-btn--primary">@MatUi.Icon("refresh")<span>Run now</span></button>
    <button type="submit" form="sensor-actions" asp-page-handler="ToggleSensorPause" asp-route-window="@Model.Window" asp-route-sensorId="@view.SensorId" class="mat-btn mat-btn--secondary">@MatUi.Icon(view.IsPaused ? "play" : "pause")<span>@(view.IsPaused ? "Resume" : "Pause")</span></button>
    <a class="mat-btn mat-btn--secondary" asp-page="/ElementEditor" asp-route-selectedId="@view.SensorId" asp-route-returnUrl="@Model.CurrentUrl">@MatUi.Icon("edit")<span>Edit</span></a>
    <a class="mat-btn mat-btn--ghost" asp-page="/Reports" asp-route-target="@view.SensorId" data-tip="An availability report on this sensor">@MatUi.Icon("file-text")<span>Report</span></a>
    @if (Model.SyslogLogRoute is { } syslogRoute)
    {
        <a class="mat-btn mat-btn--ghost" asp-page="/Events" asp-all-route-data="@syslogRoute" asp-fragment="syslog" data-tip="The messages this sensor counts">@MatUi.Icon("list")<span>Log</span></a>
    }
</div>

@if (Model.PushUrl is { } pushUrl)
{
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("link")<h2 class="mat-card__title">Push address</h2></div>
        <div class="mat-card__body mat-stack mat-stack--sm">
            <div class="mm-snippet">
                <pre class="mat-code"><code id="push-url">@pushUrl</code></pre>
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#push-url">@MatUi.Icon("copy")<span>Copy</span></button>
            </div>
            <p class="mat-hint">GET or POST. Optional: <code>status=ok|warning|error</code>, <code>value=</code> a number, <code>message=</code> a line of text - in the query, a form or JSON. The address is the password; empty the token in the sensor's settings to get a new one.</p>
            <div class="mm-snippet">
                <pre class="mat-code"><code id="push-example-sh">curl -fsS "@(pushUrl)?status=ok&amp;message=backup+done" &gt;/dev/null</code></pre>
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#push-example-sh">@MatUi.Icon("copy")<span>Copy</span></button>
            </div>
            <div class="mm-snippet">
                <pre class="mat-code"><code id="push-example-ps">Invoke-RestMethod "@(pushUrl)?status=error&amp;message=backup+failed"</code></pre>
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#push-example-ps">@MatUi.Icon("copy")<span>Copy</span></button>
            </div>
        </div>
    </section>
}

<div class="mat-stats">
    <div class="mat-stat">
        <span class="mat-stat__label">Current value</span>
        <span class="mat-stat__value sensor-current-value">
            <span>@view.CurrentValueText</span>
            @if (!string.IsNullOrWhiteSpace(view.Unit))
            {
                <small>@view.Unit</small>
            }
        </span>
        <span class="mat-stat__delta">primary: @view.DefaultChannelLabel</span>
    </div>
    @{ var stateTone = StateTileTone(view.StateKey); }
    <div class="mat-stat @stateTone">
        <span class="mat-stat__label">State</span>
        <span class="mat-stat__value @(stateTone is null ? "mat-text-muted" : null)">@view.StateLabel</span>
        @if (view.IsAcknowledged)
        {
            <span class="mat-stat__delta"><span class="mat-pill mat-pill--info">Acknowledged</span></span>
        }
    </div>
    <div class="mat-stat">
        <span class="mat-stat__label">Last check</span>
        <span class="mat-stat__value">@(view.LastSeenText ?? "–")</span>
        @if (!string.IsNullOrWhiteSpace(view.LastDurationText))
        {
            <span class="mat-stat__delta">duration @view.LastDurationText</span>
        }
    </div>
    <div class="mat-stat">
        <span class="mat-stat__label">Type</span>
        <span class="mat-stat__value sensor-type-value">@view.SensorTypeLabel</span>
        <span class="mat-stat__delta"><span class="@MatUi.PillClass(UsageTone(view.UsageLevelKey))" data-tip="How much load a check puts on the target">@view.UsageLevelLabel usage</span></span>
    </div>
</div>

<section data-tabs data-tab-hash>
    <div class="mat-tabs mm-sensor-tabs" role="tablist" aria-label="Sensor sections">
        @foreach (var (tabKey, tabLabel) in new[] { ("general", "General"), ("statistics", "Statistics"), ("history", "History") })
        {
            var selected = activeTab == tabKey;
            <button type="button" class="mat-tab" role="tab" id="tab-@tabKey" aria-controls="panel-@tabKey" aria-selected="@(selected ? "true" : "false")" tabindex="@(selected ? null : "-1")">@tabLabel</button>
        }
    </div>

    @* ---------- GENERAL ---------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-general" aria-labelledby="tab-general" hidden="@(activeTab != "general")">
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("info")<h2 class="mat-card__title">Details</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    @if (!string.IsNullOrWhiteSpace(view.StateMessage))
                    {
                        <dt>Message</dt>
                        <dd>@view.StateMessage</dd>
                    }
                    <dt>Target</dt>
                    <dd class="mat-mono">@view.Target</dd>
                    @if (!string.IsNullOrWhiteSpace(view.ExecutionProbe))
                    {
                        <dt>Probe</dt>
                        <dd>@view.ExecutionProbe</dd>
                    }
                    @if (Model.Dependency is { } dependency)
                    {
                        <dt>Depends on</dt>
                        <dd>
                            <a asp-page="/SensorDetails" asp-route-sensorId="@dependency.SensorId">@dependency.Path</a>
                            @if (dependency.IsDown)
                            {
                                <span class="mat-pill mat-pill--error">down</span>
                            }
                        </dd>
                    }
                    <dt>Settings</dt>
                    <dd>@view.SettingsSummary</dd>
                    @if (view.UnitConversion is { } conversion)
                    {
                        <dt>Unit</dt>
                        <dd data-tip="How the stored measurement is converted for display" data-tip-align="start">
                            stored <strong>@conversion.RawUnit</strong> → shown <strong>@conversion.DisplayUnit</strong>
                            @if (!string.IsNullOrWhiteSpace(conversion.Example))
                            {
                                <span class="mat-text-muted">@conversion.Example</span>
                            }
                        </dd>
                    }
                    @if (view.Tags.Count > 0)
                    {
                        <dt>Tags</dt>
                        <dd>
                            <span class="mat-chips">
                                @foreach (var tag in view.Tags)
                                {
                                    <span class="mat-tag @(tag.Inherited ? "sensor-tag--inherited" : null)" data-tip="@(tag.Inherited ? "inherited from a parent" : "tag")">
                                        @MatUi.Icon("tag")
                                        <span>@tag.Text</span>
                                        @if (tag.Inherited)
                                        {
                                            <span class="mat-sr-only">(inherited)</span>
                                        }
                                    </span>
                                }
                            </span>
                        </dd>
                    }
                </dl>
            </div>
        </section>

        <section class="mat-section">
            <div class="mat-row mat-row--between">
                <h2 class="sensor-section-title">@MatUi.Icon("activity")<span>Channels</span></h2>
                <span class="mat-badge mat-badge--soft">@view.Channels.Count<span class="mat-sr-only"> channels</span></span>
            </div>

            @if (view.Channels.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("activity")</span>
                    <div class="mat-empty__title">No channels yet</div>
                    <p>Press Run now.</p>
                </div>
            }
            else
            {
                <div class="sensor-channel-grid">
                    @foreach (var channel in view.Channels)
                    {
                        var fillText = channel.FillPercent?.ToString("0.#", inv);
                        <article class="mat-card sensor-channel" data-state="@channel.StateKey" data-default="@(channel.IsDefault ? "true" : "false")">
                            <div class="mat-card__body sensor-channel-body">
                                <div class="sensor-channel-main">
                                    <div class="mat-row sensor-channel-name">
                                        <strong>@channel.Label</strong>
                                        @if (channel.IsDefault)
                                        {
                                            <span class="mat-pill mat-pill--accent">Primary</span>
                                        }
                                    </div>
                                    <span class="mat-text-muted mat-mono sensor-channel-key">@channel.Key</span>
                                    @if (!string.IsNullOrWhiteSpace(channel.Message))
                                    {
                                        <span class="mat-text-muted sensor-channel-message">@channel.Message</span>
                                    }
                                </div>
                                <div class="sensor-channel-side">
                                    <span class="sensor-channel-value">@channel.ValueText @channel.Unit</span>
                                    @if (channel.VisualKey == "progress" && channel.FillPercent.HasValue)
                                    {
                                        <div class="sensor-channel-meter">
                                            <div class="mat-meter mat-meter--sm" role="progressbar" aria-valuenow="@fillText" aria-valuemin="0" aria-valuemax="100" aria-label="@channel.Label: @fillText %">
                                                <div class="mat-meter__fill" data-value="@fillText" data-tone="@MeterTone(channel.StateKey)"></div>
                                            </div>
                                        </div>
                                    }
                                    else if (channel.VisualKey == "gauge" && channel.FillPercent.HasValue)
                                    {
                                        @* pathLength="100": the dash is the percentage itself, no arc length to compute. *@
                                        <svg class="sensor-channel-gauge" viewBox="0 0 100 56" data-state="@channel.StateKey" aria-hidden="true" style="--gauge-fill: @fillText">
                                            <path class="sensor-channel-gauge-track" d="M10 50 A40 40 0 0 1 90 50" pathLength="100" />
                                            <path class="sensor-channel-gauge-fill" d="M10 50 A40 40 0 0 1 90 50" pathLength="100" />
                                        </svg>
                                    }
                                    <span class="@MatUi.PillClass(channel.StateKey)">@channel.StateLabel</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="mat-stats">
            @foreach (var window in view.Windows)
            {
                var isSelected = window.Key == view.SelectedWindow.Key;
                <article class="mat-stat @(isSelected ? "mat-stat--accent" : null)">
                    <span class="mat-stat__label">@window.Label</span>
                    <span class="mat-stat__value sensor-window-value">
                        <small>avg</small>
                        <span>@(window.Average?.ToString("0.###") ?? "-")</span>
                        @if (!string.IsNullOrWhiteSpace(view.Unit))
                        {
                            <small>@view.Unit</small>
                        }
                    </span>
                    <span class="mat-stat__delta">min @(window.Minimum?.ToString("0.###") ?? "-") · max @(window.Maximum?.ToString("0.###") ?? "-")</span>
                    <span class="mat-stat__delta">@window.SampleCount checks · latest @(window.LatestValue?.ToString("0.###") ?? "-")</span>
                    <span class="mat-stat__delta"><span class="@MatUi.PillClass(window.StateKey)">@window.StateLabel</span></span>
                </article>
            }
        </div>

        @{
            var win = view.SelectedWindow;
        }
        <section class="mat-card sensor-chart-card" data-chart-state="@view.StateKey">
            <div class="mat-card__head">
                @MatUi.Icon("bar-chart")
                <h2 class="mat-card__title">@win.Label</h2>
                <nav class="mat-seg mm-push-end" aria-label="Time window">
                    @foreach (var window in view.Windows)
                    {
                        var isSelected = window.Key == win.Key;
                        <a class="mat-seg__btn @(isSelected ? "is-active" : null)" aria-current="@(isSelected ? "true" : null)"
                           asp-page="/SensorDetails"
                           asp-route-sensorId="@view.SensorId"
                           asp-route-window="@window.Key">@window.Label</a>
                    }
                </nav>
            </div>
            <div class="mat-card__body mat-stack">
                @if (win.SampleCount == 0)
                {
                    <p class="mat-muted">No history in this window.</p>
                }
                else
                {
                    var chartPointsJson = "[" + string.Join(",", win.Points.Select(p =>
                        $"[{p.TimestampUtc.ToUnixTimeMilliseconds()},{p.Value.ToString("0.######", inv)}]")) + "]";
                    <div class="sensor-window-summary">
                        <span>avg @(win.Average?.ToString("0.###") ?? "-")@(string.IsNullOrWhiteSpace(view.Unit) ? string.Empty : $" {view.Unit}")</span>
                        <span>min @(win.Minimum?.ToString("0.###") ?? "-")</span>
                        <span>max @(win.Maximum?.ToString("0.###") ?? "-")</span>
                        <span>@win.SampleCount checks</span>
                    </div>
                    <div class="sensor-chart-legend">
                        <span class="sensor-chart-legend-line" aria-hidden="true"></span>
                        <span>Primary: @view.DefaultChannelLabel</span>
                    </div>
                    <div class="sensor-chart-wrap" data-chart="line"
                         data-chart-points="@chartPointsJson"
                         data-chart-min="@win.GraphMin.ToString("0.######", inv)"
                         data-chart-max="@win.GraphMax.ToString("0.######", inv)"
                         data-chart-from="@win.FromUtc.ToUnixTimeMilliseconds()"
                         data-chart-to="@win.ToUtc.ToUnixTimeMilliseconds()"
                         data-chart-unit="@view.Unit">
                        <div class="sensor-chart-axis-y" aria-hidden="true">
                            <span>@win.GraphMax.ToString("0.##", inv)</span>
                            <span>@win.GraphMin.ToString("0.##", inv)</span>
                        </div>
                        <svg class="sparkline sensor-chart" viewBox="0 0 100 40" preserveAspectRatio="none" role="img" aria-label="@view.DefaultChannelLabel over @win.Label">
                            <path data-role="area" d="@win.AreaPath"></path>
                            <path data-role="line" d="@win.LinePath"></path>
                        </svg>
                    </div>
                    <div class="graph-footer">
                        <span>@win.FromUtc.ToDisplay().ToString("dd.MM HH:mm")</span>
                        <span>@win.ToUtc.ToDisplay().ToString("dd.MM HH:mm")</span>
                    </div>
                }
            </div>
        </section>
    </div>

    @* ---------- STATISTICS ---------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-statistics" aria-labelledby="tab-statistics" hidden="@(!statsTabActive)">
        @if (view.Statistics is { } stats)
        {
            var statsBase = $"{Request.PathBase}/monitoring/sensor/{view.SensorId}";
            var channelQuery = Uri.EscapeDataString(stats.SelectedChannelKey);
            var granularity = stats.GranularityLabel.ToLowerInvariant();
            var hasChannelChoice = stats.Channels.Count > 1;
            var selectedChannelLabel = stats.Channels.FirstOrDefault(c => c.IsSelected)?.Label ?? stats.SelectedChannelKey;
            var groupLabels = new Dictionary<string, string> { ["native"] = "Native", ["day"] = "Day", ["month"] = "Month", ["year"] = "Year" };

            // The address of the statistics without some of the filters in effect: the link of a chip's X. Every link
            // ends in #statistics so the tab stays open whatever is left.
            string StatsUrlWithout(params string[] keys)
            {
                var current = new (string Key, string? Value)[]
                {
                    ("window", Model.Window), ("StatsRange", Model.StatsRange), ("StatsFrom", Model.StatsFrom),
                    ("StatsTo", Model.StatsTo), ("StatsGroup", Model.StatsGroup), ("StatsChannel", Model.StatsChannel)
                };
                var parts = current
                    .Where(p => !string.IsNullOrWhiteSpace(p.Value) && !keys.Contains(p.Key, StringComparer.OrdinalIgnoreCase))
                    .Select(p => $"{p.Key}={Uri.EscapeDataString(p.Value!)}");
                var query = string.Join("&", parts);
                return statsBase + (query.Length > 0 ? "?" + query : string.Empty) + "#statistics";
            }

            var showGroupChip = !string.IsNullOrWhiteSpace(Model.StatsGroup);
            var showPeriodChip = !string.IsNullOrWhiteSpace(Model.StatsFrom) || !string.IsNullOrWhiteSpace(Model.StatsTo);
            var showChannelChip = hasChannelChoice && !string.IsNullOrWhiteSpace(Model.StatsChannel);
            var activeFilters = (showGroupChip ? 1 : 0) + (showPeriodChip ? 1 : 0) + (showChannelChip ? 1 : 0);

            <div class="mat-toolbar" role="toolbar" aria-label="Statistics tools">
                <nav class="mat-seg" aria-label="Range">
                    @foreach (var rangeOption in new[] { ("24h", "24h"), ("7d", "7d"), ("30d", "30d"), ("90d", "90d"), ("all", "All") })
                    {
                        var isActive = stats.SelectedRange == rangeOption.Item1;
                        <a class="mat-seg__btn @(isActive ? "is-active" : null)" aria-current="@(isActive ? "true" : null)"
                           href="@($"{statsBase}?window={Model.Window}&StatsRange={rangeOption.Item1}&StatsChannel={channelQuery}#statistics")">@rangeOption.Item2</a>
                    }
                </nav>
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info" aria-live="polite">@stats.Rows.Count @granularity period@(stats.Rows.Count == 1 ? string.Empty : "s") · @stats.BucketCount buckets</span>
                <div class="mat-toolbar__end">
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(activeFilters > 0 ? "is-active" : null)" data-dialog-open="stats-filter" aria-haspopup="dialog">
                        @MatUi.Icon("sliders")<span>Filter</span>
                        @if (activeFilters > 0)
                        {
                            <span class="mat-badge">@activeFilters</span>
                        }
                    </button>
                </div>
            </div>

            @if (activeFilters > 0)
            {
                <div class="mat-chips" role="group" aria-label="Filters in effect">
                    @if (showChannelChip)
                    {
                        <span class="mat-chip">Channel: @selectedChannelLabel<a class="mat-chip__x" href="@StatsUrlWithout("StatsChannel")" aria-label="Remove the filter Channel">@MatUi.Icon("x")</a></span>
                    }
                    @if (showPeriodChip)
                    {
                        <span class="mat-chip">Period: @(stats.FromText ?? "…") – @(stats.ToText ?? "…")<a class="mat-chip__x" href="@StatsUrlWithout("StatsFrom", "StatsTo")" aria-label="Remove the filter Period">@MatUi.Icon("x")</a></span>
                    }
                    @if (showGroupChip)
                    {
                        <span class="mat-chip">Group by: @(groupLabels.TryGetValue(stats.SelectedGroup, out var groupLabel) ? groupLabel : stats.SelectedGroup)<a class="mat-chip__x" href="@StatsUrlWithout("StatsGroup")" aria-label="Remove the filter Group by">@MatUi.Icon("x")</a></span>
                    }
                </div>
            }

            <form id="stats-form" method="get" action="@($"{statsBase}#statistics")" hidden>
                <input type="hidden" name="window" value="@Model.Window" />
                <input type="hidden" name="StatsRange" value="@(stats.SelectedRange == "custom" ? string.Empty : stats.SelectedRange)" />
                @if (!hasChannelChoice)
                {
                    <input type="hidden" name="StatsChannel" value="@stats.SelectedChannelKey" />
                }
            </form>

            <dialog class="mat-dialog mat-dialog--sm" id="stats-filter" aria-labelledby="stats-filter-title">
                <div class="mat-dialog__form">
                    <div class="mat-dialog__head">
                        @MatUi.Icon("sliders")
                        <h2 class="mat-dialog__title" id="stats-filter-title">Filter</h2>
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                    </div>
                    <div class="mat-dialog__body mat-form">
                        @if (hasChannelChoice)
                        {
                            <div class="mat-field">
                                <label class="mat-label" for="stats-channel">Channel</label>
                                <select class="mat-select" id="stats-channel" name="StatsChannel" form="stats-form">
                                    @foreach (var channelOption in stats.Channels)
                                    {
                                        <option value="@channelOption.Key" selected="@channelOption.IsSelected">@channelOption.Label</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="mat-form__grid">
                            <div class="mat-field">
                                <label class="mat-label" for="stats-from">From</label>
                                <input class="mat-input mat-mono" type="date" id="stats-from" name="StatsFrom" value="@stats.FromText" form="stats-form" />
                            </div>
                            <div class="mat-field">
                                <label class="mat-label" for="stats-to">To</label>
                                <input class="mat-input mat-mono" type="date" id="stats-to" name="StatsTo" value="@stats.ToText" form="stats-form" />
                            </div>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="stats-group">Group by</label>
                            <select class="mat-select" id="stats-group" name="StatsGroup" form="stats-form">
                                <option value="native" selected="@(stats.SelectedGroup == "native")">Native</option>
                                <option value="day" selected="@(stats.SelectedGroup == "day")">Day</option>
                                <option value="month" selected="@(stats.SelectedGroup == "month")">Month</option>
                                <option value="year" selected="@(stats.SelectedGroup == "year")">Year</option>
                            </select>
                        </div>
                    </div>
                    <div class="mat-dialog__foot">
                        <div class="mat-btn-row mat-btn-row--plain">
                            <button type="submit" form="stats-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sliders")<span>Apply</span></button>
                            <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                            @if (stats.SelectedRange != "7d" || stats.SelectedGroup != "day")
                            {
                                <span class="mat-btn-row__spacer"></span>
                                <a class="mat-btn mat-btn--ghost mat-btn--end" href="@($"{statsBase}?window={Model.Window}&StatsChannel={channelQuery}#statistics")">Reset everything</a>
                            }
                        </div>
                    </div>
                </div>
            </dialog>

            var chartRows = stats.Rows.Reverse().ToList();
            var chartValues = chartRows.Where(r => r.AverageValue.HasValue).Select(r => r.AverageValue!.Value).ToList();
            @if (chartValues.Count > 0)
            {
                var chartMax = chartValues.Max();
                var chartMin = Math.Min(0d, chartValues.Min());
                var chartRange = chartMax - chartMin;
                if (chartRange <= 0d) { chartRange = 1d; }
                var slot = 100d / chartRows.Count;
                var barWidth = Math.Min(Math.Max(slot * 0.68d, 0.6d), 12d);
                var unitSuffix = string.IsNullOrWhiteSpace(stats.Unit) ? string.Empty : $" {stats.Unit}";
                <section class="mat-card">
                    <div class="mat-card__head">
                        @MatUi.Icon("bar-chart")
                        <h2 class="mat-card__title">Long-term statistics</h2>
                        <span class="mat-text-muted mm-push-end">average per @granularity period</span>
                    </div>
                    <div class="mat-card__body">
                        <div class="sensor-statistics-chart sensor-chart-wrap" data-chart="bars">
                            <div class="sensor-chart-plot">
                                <div class="sensor-chart-axis-y" aria-hidden="true">
                                    <span>@chartMax.ToString("0.##", inv)</span>
                                    <span>@chartMin.ToString("0.##", inv)</span>
                                </div>
                                <svg viewBox="0 0 100 44" preserveAspectRatio="none" role="img" aria-label="Average per @granularity period">
                                    @for (var i = 0; i < chartRows.Count; i++)
                                    {
                                        var cr = chartRows[i];
                                        if (!cr.AverageValue.HasValue)
                                        {
                                            continue;
                                        }
                                        var barHeight = Math.Max((cr.AverageValue.Value - chartMin) / chartRange * 40d, 0.6d);
                                        var barX = (i * slot) + ((slot - barWidth) / 2d);
                                        var barY = 42d - barHeight;
                                        var barTip = $"{cr.PeriodText} · avg {cr.AverageText}{unitSuffix} · min {cr.MinimumText} · max {cr.MaximumText}" + (cr.UptimeText is null ? string.Empty : $" · {cr.UptimeText} OK") + $" · {cr.SampleCount} checks";
                                        <rect class="sensor-statistics-bar" data-state="@cr.StateKey" data-bar-tip="@barTip" x="@(barX.ToString("0.###", inv))" y="@(barY.ToString("0.###", inv))" width="@(barWidth.ToString("0.###", inv))" height="@(barHeight.ToString("0.###", inv))" rx="0.4"></rect>
                                    }
                                </svg>
                            </div>
                            <div class="sensor-statistics-chart-axis">
                                <span>@chartRows.First().PeriodText</span>
                                <span>@chartRows.Last().PeriodText</span>
                            </div>
                        </div>
                    </div>
                </section>
            }

            @if (stats.Rows.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("bar-chart")</span>
                    <div class="mat-empty__title">No statistics in this range</div>
                    <p>Choose a longer range, or reset the filters.</p>
                </div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table mat-table--compact sensor-statistics-table">
                        <caption class="mat-sr-only">Statistics per @granularity period of @selectedChannelLabel</caption>
                        <thead>
                            <tr>
                                <th scope="col">Period</th>
                                <th scope="col" class="mat-num">Avg@(stats.Unit is null ? string.Empty : $" ({stats.Unit})")</th>
                                <th scope="col" class="mat-num">Min</th>
                                <th scope="col" class="mat-num">Max</th>
                                <th scope="col" class="mat-num mat-hide-sm" title="bottom 1 %">1 %</th>
                                <th scope="col" class="mat-num mat-hide-sm" title="top 1 %">99 %</th>
                                <th scope="col" class="mat-num" title="share of checks in the OK state">OK %</th>
                                <th scope="col" class="mat-num">Checks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in stats.Rows)
                            {
                                var drillHref = row.DrillGroup is null
                                    ? null
                                    : $"{statsBase}?window={Model.Window}&StatsFrom={row.DrillFrom}&StatsTo={row.DrillTo}&StatsGroup={row.DrillGroup}&StatsChannel={channelQuery}#statistics";
                                <tr data-state="@row.StateKey" data-href="@drillHref">
                                    <td data-label="Period" class="mat-table__primary mat-mono">
                                        @if (drillHref is not null)
                                        {
                                            <a href="@drillHref" data-tip="Drill into @row.PeriodText" data-tip-align="start">@row.PeriodText</a>
                                        }
                                        else
                                        {
                                            @row.PeriodText
                                        }
                                    </td>
                                    <td data-label="Avg" class="mat-num mat-mono mat-table__keep-label"><strong>@row.AverageText</strong></td>
                                    <td data-label="Min" class="mat-num mat-mono mat-table__keep-label">@row.MinimumText</td>
                                    <td data-label="Max" class="mat-num mat-mono mat-table__keep-label">@row.MaximumText</td>
                                    <td data-label="1 %" class="mat-num mat-mono mat-hide-sm mat-table__keep-label">@row.LowPercentileText</td>
                                    <td data-label="99 %" class="mat-num mat-mono mat-hide-sm mat-table__keep-label">@row.HighPercentileText</td>
                                    <td data-label="OK %" class="mat-num mat-mono mat-table__keep-label">@(row.UptimeText ?? "-")</td>
                                    <td data-label="Checks" class="mat-num mat-mono mat-table__keep-label">@row.SampleCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="mat-empty mat-empty--framed">
                <span class="mat-empty__icon">@MatUi.Icon("bar-chart")</span>
                <div class="mat-empty__title">No long-term statistics yet</div>
            </div>
        }
    </div>

    @* ---------- CHECKS ---------- *@
    @{
        var checks = Model.Checks;
        var checksFilterLabel = checks.Options.FirstOrDefault(o => o.Key == checks.Filter)?.Label;
    }
    <div class="mat-tabpanel" role="tabpanel" id="panel-history" aria-labelledby="tab-history" hidden="@(activeTab != "history")">
    <div hidden="@(historyView != "checks")">
        <div class="mat-list">
            <div class="mat-toolbar" role="toolbar" aria-label="Checks tools">
                @{ HistorySwitch(); }
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info" aria-live="polite">@MonitoringDisplay.FormatCount(checks.Matching) check@(checks.Matching == 1 ? string.Empty : "s")@(checks.Filter is null ? string.Empty : $" of {MonitoringDisplay.FormatCount(checks.Total)}") · kept @checks.RetentionDays day@(checks.RetentionDays == 1 ? string.Empty : "s")</span>
                <div class="mat-toolbar__end">
                    <a class="mat-btn mat-btn--ghost mat-toolbar__btn" href="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}?handler=ExportHistory&list=checks&format=csv&checks={checks.Filter}")" data-tip="This list, with its filter, as CSV">@MatUi.Icon("download")<span>CSV</span></a>
                    <a class="mat-btn mat-btn--ghost mat-toolbar__btn" href="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}?handler=ExportHistory&list=checks&format=pdf&checks={checks.Filter}")" data-tip="This list, with its filter, as PDF">@MatUi.Icon("file-text")<span>PDF</span></a>
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(checks.Filter is null ? null : "is-active")" data-dialog-open="checks-filter" aria-haspopup="dialog">
                        @MatUi.Icon("sliders")<span>Filter</span>
                        @if (checks.Filter is not null)
                        {
                            <span class="mat-badge">1</span>
                        }
                    </button>
                </div>
            </div>

            @if (checksFilterLabel is not null)
            {
                <div class="mat-chips" role="group" aria-label="Filters in effect">
                    <span class="mat-chip">State: @checksFilterLabel<a class="mat-chip__x" href="@HistoryUrl("checks", ("checks", null), ("checksPage", null))" aria-label="Remove the filter State">@MatUi.Icon("x")</a></span>
                </div>
            }

            @if (checks.Rows.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("clock")</span>
                    @if (checks.Total == 0)
                    {
                        <div class="mat-empty__title">No checks yet</div>
                        <p>Press Run now.</p>
                    }
                    else
                    {
                        <div class="mat-empty__title">No @checksFilterLabel?.ToLowerInvariant() checks</div>
                        <p>Checks are kept for @checks.RetentionDays day@(checks.RetentionDays == 1 ? string.Empty : "s").</p>
                        <a class="mat-btn mat-btn--secondary" href="@HistoryUrl("checks", ("checks", null), ("checksPage", null))">Show every check</a>
                    }
                </div>
            }
            else
            {
                <div class="mat-table-wrap sensor-history-table">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Checks of @view.Name</caption>
                        <thead>
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">State</th>
                                <th scope="col" class="mat-num">Value</th>
                                <th scope="col" class="mat-num mat-hide-sm">Duration</th>
                                <th scope="col" class="mat-hide-sm">Probe</th>
                                <th scope="col">Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var observation in checks.Rows)
                            {
                                <tr data-state="@observation.StateKey">
                                    <td data-label="Time" class="mat-table__primary mat-mono mat-nowrap">@observation.TimestampText</td>
                                    <td data-label="State"><span class="@MatUi.PillClass(observation.StateKey)">@observation.StateLabel</span></td>
                                    <td data-label="Value" class="mat-num mat-mono">
                                        @observation.ValueText @observation.Unit
                                        @if (observation.ChannelCount > 1)
                                        {
                                            <span class="mat-tag">@observation.ChannelCount channels</span>
                                        }
                                    </td>
                                    <td data-label="Duration" class="mat-num mat-mono mat-hide-sm">@observation.DurationText</td>
                                    <td data-label="Probe" class="mat-hide-sm">@observation.ExecutionProbe</td>
                                    <td data-label="Message" class="mm-break">@observation.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                Pager("checks", "checksPage", checks.Page, checks.PageCount, checks.Matching);
            }
        </div>

        <form id="checks-form" method="get" action="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}#history")" hidden>
            <input type="hidden" name="history" value="checks" />
            @if (!string.IsNullOrWhiteSpace(Model.Window))
            {
                <input type="hidden" name="window" value="@Model.Window" />
            }
        </form>
        <dialog class="mat-dialog mat-dialog--sm" id="checks-filter" aria-labelledby="checks-filter-title">
            <div class="mat-dialog__form">
                <div class="mat-dialog__head">
                    @MatUi.Icon("sliders")
                    <h2 class="mat-dialog__title" id="checks-filter-title">Filter</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-form">
                    <div class="mat-field">
                        <label class="mat-label" for="checks-state">State</label>
                        <select class="mat-select" id="checks-state" name="checks" form="checks-form">
                            <option value="" selected="@(checks.Filter is null)">All (@MonitoringDisplay.FormatCount(checks.Total))</option>
                            @foreach (var option in checks.Options)
                            {
                                <option value="@option.Key" selected="@(option.Key == checks.Filter)">@option.Label (@MonitoringDisplay.FormatCount(option.Count))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" form="checks-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sliders")<span>Apply</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </div>
        </dialog>
    </div>

    @* ---------- STATUS HISTORY ---------- *@
    @{
        var status = Model.StatusHistory;
        var statusFilterLabel = status.Options.FirstOrDefault(o => o.Key == status.Filter)?.Label;
    }
    <div hidden="@(historyView != "status")">
        <div class="mat-list">
            <div class="mat-toolbar" role="toolbar" aria-label="Status history tools">
                @{ HistorySwitch(); }
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info" aria-live="polite">@MonitoringDisplay.FormatCount(status.Matching) entr@(status.Matching == 1 ? "y" : "ies")@(status.Filter is null ? string.Empty : $" of {MonitoringDisplay.FormatCount(status.Total)}") · kept @status.RetentionDays days</span>
                <div class="mat-toolbar__end">
                    <a class="mat-btn mat-btn--ghost mat-toolbar__btn" href="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}?handler=ExportHistory&list=status&format=csv&status={status.Filter}")" data-tip="This list, with its filter, as CSV">@MatUi.Icon("download")<span>CSV</span></a>
                    <a class="mat-btn mat-btn--ghost mat-toolbar__btn" href="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}?handler=ExportHistory&list=status&format=pdf&status={status.Filter}")" data-tip="This list, with its filter, as PDF">@MatUi.Icon("file-text")<span>PDF</span></a>
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(status.Filter is null ? null : "is-active")" data-dialog-open="status-filter" aria-haspopup="dialog">
                        @MatUi.Icon("sliders")<span>Filter</span>
                        @if (status.Filter is not null)
                        {
                            <span class="mat-badge">1</span>
                        }
                    </button>
                </div>
            </div>

            @if (statusFilterLabel is not null)
            {
                <div class="mat-chips" role="group" aria-label="Filters in effect">
                    <span class="mat-chip">Kind: @statusFilterLabel<a class="mat-chip__x" href="@HistoryUrl("status", ("status", null), ("statusPage", null))" aria-label="Remove the filter Kind">@MatUi.Icon("x")</a></span>
                </div>
            }

            @if (status.Rows.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("activity")</span>
                    <div class="mat-empty__title">@(status.Total == 0 ? "Nothing has happened yet" : $"No {statusFilterLabel?.ToLowerInvariant()}")</div>
                    <p>Changes are kept for @status.RetentionDays days.</p>
                    @if (status.Total > 0)
                    {
                        <a class="mat-btn mat-btn--secondary" href="@HistoryUrl("status", ("status", null), ("statusPage", null))">Show everything</a>
                    }
                </div>
            }
            else
            {
                <div class="mat-table-wrap sensor-status-table">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Status history of @view.Name</caption>
                        <thead>
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">What happened</th>
                                <th scope="col">State</th>
                                <th scope="col">Duration</th>
                                <th scope="col">By</th>
                                <th scope="col">Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in status.Rows)
                            {
                                <tr data-kind="@entry.KindKey" data-state="@entry.ToKey">
                                    <td data-label="Time" class="mat-table__primary mat-mono mat-nowrap">@entry.TimestampText</td>
                                    <td data-label="What happened" class="mat-nowrap">
                                        <span class="sensor-status-kind" data-tone="@entry.Tone">@MatUi.Icon(entry.Icon)<span>@entry.KindLabel</span></span>
                                    </td>
                                    <td data-label="State">
                                        @if (entry.FromLabel is not null || entry.ToLabel is not null)
                                        {
                                            <span class="sensor-status-transition">
                                                @if (entry.FromLabel is not null)
                                                {
                                                    <span class="@MatUi.PillClass(entry.FromKey!)">@entry.FromLabel</span>
                                                    @if (entry.ToLabel is not null)
                                                    {
                                                        <span class="mat-text-muted" aria-label="to">→</span>
                                                    }
                                                }
                                                @if (entry.ToLabel is not null)
                                                {
                                                    <span class="@MatUi.PillClass(entry.ToKey!)">@entry.ToLabel</span>
                                                }
                                            </span>
                                        }
                                    </td>
                                    <td data-label="Duration" class="mat-nowrap">@entry.DurationText</td>
                                    <td data-label="By">@entry.Actor</td>
                                    <td data-label="Message" class="mm-break">
                                        @entry.Message
                                        @if (entry.ChecksLink is not null)
                                        {
                                            <a class="sensor-status-link" href="@entry.ChecksLink">Failing checks</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                Pager("status", "statusPage", status.Page, status.PageCount, status.Matching);
            }
        </div>

        <form id="status-form" method="get" action="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}#history")" hidden>
            <input type="hidden" name="history" value="status" />
            @if (!string.IsNullOrWhiteSpace(Model.Window))
            {
                <input type="hidden" name="window" value="@Model.Window" />
            }
        </form>
        <dialog class="mat-dialog mat-dialog--sm" id="status-filter" aria-labelledby="status-filter-title">
            <div class="mat-dialog__form">
                <div class="mat-dialog__head">
                    @MatUi.Icon("sliders")
                    <h2 class="mat-dialog__title" id="status-filter-title">Filter</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-form">
                    <div class="mat-field">
                        <label class="mat-label" for="status-kind">Kind</label>
                        <select class="mat-select" id="status-kind" name="status" form="status-form">
                            <option value="" selected="@(status.Filter is null)">All (@MonitoringDisplay.FormatCount(status.Total))</option>
                            @foreach (var option in status.Options)
                            {
                                <option value="@option.Key" selected="@(option.Key == status.Filter)">@option.Label (@MonitoringDisplay.FormatCount(option.Count))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" form="status-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sliders")<span>Apply</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </div>
        </dialog>
    </div>

    @* ---------- ALERTS ---------- *@
    @{
        var alertList = Model.Alerts;
        var alertsFilterLabel = alertList.Options.FirstOrDefault(o => o.Key == alertList.Filter)?.Label;
    }
    <div hidden="@(historyView != "alerts")">
        <div class="mat-list">
            <div class="mat-toolbar" role="toolbar" aria-label="Alerts tools">
                @{ HistorySwitch(); }
                <span class="mat-toolbar__spacer"></span>
                <span class="mat-toolbar__info" aria-live="polite">@MonitoringDisplay.FormatCount(alertList.Matching) alert@(alertList.Matching == 1 ? string.Empty : "s")@(alertList.Filter is null ? string.Empty : $" of {MonitoringDisplay.FormatCount(alertList.Total)}")</span>
                <div class="mat-toolbar__end">
                    <a class="mat-btn mat-btn--ghost mat-toolbar__btn" href="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}?handler=ExportHistory&list=alerts&format=csv&alerts={alertList.Filter}")" data-tip="This list, with its filter, as CSV">@MatUi.Icon("download")<span>CSV</span></a>
                    <a class="mat-btn mat-btn--ghost mat-toolbar__btn" href="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}?handler=ExportHistory&list=alerts&format=pdf&alerts={alertList.Filter}")" data-tip="This list, with its filter, as PDF">@MatUi.Icon("file-text")<span>PDF</span></a>
                    <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn @(alertList.Filter is null ? null : "is-active")" data-dialog-open="alerts-filter" aria-haspopup="dialog">
                        @MatUi.Icon("sliders")<span>Filter</span>
                        @if (alertList.Filter is not null)
                        {
                            <span class="mat-badge">1</span>
                        }
                    </button>
                </div>
            </div>

            @if (alertsFilterLabel is not null)
            {
                <div class="mat-chips">
                    <span class="mat-chip">Status: @alertsFilterLabel<a class="mat-chip__x" href="@HistoryUrl("alerts", ("alerts", null), ("alertsPage", null))" aria-label="Remove the filter Status">@MatUi.Icon("x")</a></span>
                </div>
            }

            @if (alertList.Rows.Count == 0)
            {
                <div class="mat-empty mat-empty--framed">
                    <span class="mat-empty__icon">@MatUi.Icon("bell")</span>
                    <div class="mat-empty__title">@(alertList.Total == 0 ? "No alerts" : "No alert matches the filter")</div>
                    @if (alertList.Total > 0)
                    {
                        <a class="mat-btn mat-btn--secondary" href="@HistoryUrl("alerts", ("alerts", null), ("alertsPage", null))">Show every alert</a>
                    }
                </div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table mat-table--compact">
                        <caption class="mat-sr-only">Alerts of @view.Name</caption>
                        <thead>
                            <tr>
                                <th scope="col">Alert</th>
                                <th scope="col">Started</th>
                                <th scope="col">Problem</th>
                                <th scope="col">Handled</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in alertList.Rows)
                            {
                                <tr data-state="@row.StateKey">
                                    <td data-label="Alert">
                                        <div class="mm-alert-cell">
                                            <span class="mat-row">
                                                <span class="@MatUi.PillClass(row.StateKey)">@row.StateLabel</span>
                                                <span class="@MatUi.PillClass(row.PhaseKey == "open" ? "error" : row.PhaseKey == "recovered" ? "info" : "plain")">@row.PhaseLabel</span>
                                            </span>
                                            @if (row.Message is not null)
                                            {
                                                <span class="mat-small mat-text-muted mm-break">@row.Message</span>
                                            }
                                        </div>
                                    </td>
                                    <td data-label="Started" class="mat-mono mat-nowrap">@row.Started</td>
                                    <td data-label="Problem">
                                        <div class="mm-alert-cell">
                                            <strong class="@(row.Ongoing ? "mat-text-danger" : null)">@row.Problem</strong>
                                            <span class="mat-small mat-text-muted">
                                                last failing check <a class="mat-mono" href="@SensorDetailsModel.FailingChecksPath(Request.PathBase, view.SensorId)">@row.LastFailingCheck</a>@(row.Recovered is null ? string.Empty : " · " + row.Recovered)
                                            </span>
                                        </div>
                                    </td>
                                    <td data-label="Handled" class="@(row.AwaitsAcknowledgement ? "mat-text-warning" : "mat-text-muted")">@row.Handled</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                Pager("alerts", "alertsPage", alertList.Page, alertList.PageCount, alertList.Matching);
            }
        </div>

        <form id="alerts-form" method="get" action="@($"{Request.PathBase}/monitoring/sensor/{view.SensorId}#history")" hidden>
            <input type="hidden" name="history" value="alerts" />
            @if (!string.IsNullOrWhiteSpace(Model.Window))
            {
                <input type="hidden" name="window" value="@Model.Window" />
            }
        </form>
        <dialog class="mat-dialog mat-dialog--sm" id="alerts-filter" aria-labelledby="alerts-filter-title">
            <div class="mat-dialog__form">
                <div class="mat-dialog__head">
                    @MatUi.Icon("sliders")
                    <h2 class="mat-dialog__title" id="alerts-filter-title">Filter</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
                </div>
                <div class="mat-dialog__body mat-form">
                    <div class="mat-field">
                        <label class="mat-label" for="alerts-phase">Status</label>
                        <select class="mat-select" id="alerts-phase" name="alerts" form="alerts-form">
                            <option value="" selected="@(alertList.Filter is null)">All (@MonitoringDisplay.FormatCount(alertList.Total))</option>
                            @foreach (var option in alertList.Options)
                            {
                                <option value="@option.Key" selected="@(option.Key == alertList.Filter)">@option.Label (@MonitoringDisplay.FormatCount(option.Count))</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mat-dialog__foot">
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" form="alerts-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sliders")<span>Apply</span></button>
                        <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    </div>
                </div>
            </div>
        </dialog>
    </div>
    </div>
</section>

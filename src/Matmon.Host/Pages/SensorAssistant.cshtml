@page "/monitoring/sensor/assistant"
@model WorkspaceModel
@{
    ViewData["Title"] = "Sensor Assistant";
    ViewData["PageSub"] = "Enter the target and credentials, press Analyze, then keep only the channels you want.";
    // No tabs here: the shared editor partials draw their sections one below another instead of as tab panels.
    ViewData["SensorEditorPanels"] = false;
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
    var hasFixedChannels = Model.NewSensor.SensorChannelMode == SensorChannelMode.Fixed;
    var matchingTemplateCount = Model.NewSensor.TemplateOptions.Count(option => !string.IsNullOrWhiteSpace(option.Value));
    var isSnmpType = string.Equals(Model.NewSensor.SensorTypeKey, SnmpSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.NewSensor.SensorTypeKey, SynologyNasSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase);
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<section class="mat-card">
    <div class="mat-card__body mat-stack mat-stack--sm">
        <ol class="assistant-steps" aria-label="Sensor assistant steps">
            <li class="mat-pill mat-pill--accent">Basics</li>
            <li class="mat-pill mat-pill--accent">Connect</li>
            <li class="mat-pill mat-pill--accent" aria-current="step">Analyze</li>
            <li class="mat-pill mat-pill--plain">Save</li>
        </ol>
        <p class="mat-muted">Inherited values stay as placeholders so the form stays clean.</p>
    </div>
</section>

<form method="post" asp-page-handler="CreateSensor" class="mat-form" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="NewSensor.NameAutoGenerated" data-sensor-name-auto />

    <section class="mat-card">
        <div class="mat-card__head">
            <span class="mat-badge mat-badge--soft" aria-hidden="true">1</span>
            <h2 class="mat-card__title">Sensor type</h2>
            <span class="mat-text-muted mm-push-end">template optional</span>
        </div>
        <div class="mat-card__body mat-stack">
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewSensor.SensorTypeKey">Type</label>
                    <select asp-for="NewSensor.SensorTypeKey" class="mat-select" asp-items="Model.View.SensorTypeOptions" data-sensor-type-select></select>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewSensor.TemplateId">Template <span class="mat-opt">(optional)</span></label>
                    <select asp-for="NewSensor.TemplateId" class="mat-select" asp-items="Model.NewSensor.TemplateOptions" data-sensor-template-select></select>
                </div>
            </div>
            <p class="mat-hint">
                @(matchingTemplateCount == 0
                    ? "No matching sensor template for this type yet."
                    : $"{matchingTemplateCount} matching template{(matchingTemplateCount == 1 ? string.Empty : "s")} available. Choose one to prefill fields and keep the template link.")
            </p>
        </div>
    </section>

    <section class="mat-card">
        <div class="mat-card__head">
            <span class="mat-badge mat-badge--soft" aria-hidden="true">2</span>
            <h2 class="mat-card__title">Details</h2>
            <span class="mat-text-muted mm-push-end">where it runs</span>
        </div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewSensor.Name">Name</label>
                    <input asp-for="NewSensor.Name" class="mat-input" placeholder="Sensor name" data-sensor-name-input />
                </div>
                <div class="mat-field">
                    <label class="mat-label" for="picker-assistant-parent-trigger">Parent</label>
                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewSensor.ParentId", DomId = "picker-assistant-parent", SelectedId = Model.NewSensor.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.SensorParentOptions), ValueAttribute = "data-sensor-parent-select" })" />
                </div>
                @if (string.Equals(Model.NewSensor.SensorTypeKey, ProbeHeartbeatSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase))
                {
                    <p class="mat-field mat-field--full mat-muted">Target is auto-filled from the parent probe for heartbeat sensors.</p>
                }
                else
                {
                    <div class="mat-field mat-field--full">
                        <label class="mat-label" asp-for="NewSensor.Target">Target</label>
                        <input asp-for="NewSensor.Target" class="mat-input mat-mono" placeholder="@Model.NewSensor.TargetPlaceholder" />
                    </div>
                }
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_SensorCredentials", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

    @await Html.PartialAsync("_SensorParameters", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

    @if (isSnmpType)
    {
        <section class="mat-card sensor-snmp-section">
            <div class="mat-card__head">
                @MatUi.Icon("network")
                <h2 class="mat-card__title">Walk</h2>
                <span class="mat-text-muted mm-push-end">SNMP v1 / v2c / v3</span>
            </div>
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">Discover OIDs on the target, then tick the values you want to monitor. Selected OIDs are copied into <code>snmp.oids</code>. SNMPv3 fields appear in the parameter block above.</p>
                <div class="mat-field sensor-snmp-root">
                    <label class="mat-label" asp-for="NewSensor.SnmpWalkRootOid">Root OID</label>
                    <div class="mat-input-group">
                        <input asp-for="NewSensor.SnmpWalkRootOid" class="mat-input mat-mono" placeholder="1.3.6.1.2.1" />
                        <button type="submit" asp-page-handler="DiscoverSnmp" formnovalidate class="mat-btn mat-btn--secondary">@MatUi.Icon("search")<span>Walk</span></button>
                    </div>
                </div>
                <partial name="_SnmpWalkList" model="Model" />
            </div>
        </section>
    }

    @* The assistant's own, simpler channel list (no enable switches, display or logging options): the hooks are the
       same data-threshold-* attributes as _SensorThresholds, so initializeThresholdEditors drives both. *@
    <section class="mat-card sensor-threshold-section" data-threshold-section>
        <div class="mat-card__head">
            @MatUi.Icon("activity")
            <h2 class="mat-card__title">Channels &amp; thresholds</h2>
            @if (hasFixedChannels)
            {
                <span class="mat-pill mat-pill--ok mm-push-end" data-tip="The sensor type defines its channels">Fixed</span>
            }
            else
            {
                <span class="mat-pill mat-pill--accent mm-push-end" data-tip="The sensor reports its channels when it runs">Dynamic</span>
            }
        </div>
        <div class="mat-card__body mat-stack">
            @if (Model.NewSensor.SensorChannelThresholdFields.Count == 0)
            {
                <p class="mat-muted">No channels yet.</p>
            }
            else
            {
                <div class="sensor-threshold-list" data-threshold-list>
                    @for (var i = 0; i < Model.NewSensor.SensorChannelThresholdFields.Count; i++)
                    {
                        var field = Model.NewSensor.SensorChannelThresholdFields[i];
                        var isHidden = i >= Model.NewSensor.SensorChannelThresholdVisibleCount || field.IsDeleted;
                        var channelName = !string.IsNullOrWhiteSpace(field.ChannelLabel) ? field.ChannelLabel : "Channel";
                        <div class="sensor-threshold-card" data-threshold-row data-threshold-deleted="@(field.IsDeleted ? "true" : "false")" hidden="@isHidden">
                            <input type="hidden" asp-for="NewSensor.SensorChannelThresholdFields[i].IsDefault" />
                            <input type="hidden" asp-for="NewSensor.SensorChannelThresholdFields[i].IsDeleted" />
                            <div class="sensor-threshold-head">
                                <div class="sensor-threshold-title">
                                    <strong>@channelName</strong>
                                    <span class="mat-text-muted mat-mono sensor-threshold-key">
                                        @(!string.IsNullOrWhiteSpace(field.ChannelKey) ? field.ChannelKey : "channel key")
                                        @if (!string.IsNullOrWhiteSpace(field.Unit))
                                        {
                                            <text> / @field.Unit</text>
                                        }
                                    </span>
                                </div>
                                <div class="mat-row sensor-threshold-head-actions">
                                    @if (field.IsDefault)
                                    {
                                        <span class="mat-pill mat-pill--accent" data-tip="The primary channel: drawn in the graph">graph</span>
                                    }
                                    @if (!hasFixedChannels)
                                    {
                                        <button type="button" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" data-threshold-delete aria-label="Delete channel @channelName" data-tip="Delete channel">@MatUi.Icon("trash")</button>
                                    }
                                </div>
                            </div>

                            <div class="sensor-threshold-grid">
                                <div class="mat-field">
                                    <label class="mat-label" asp-for="NewSensor.SensorChannelThresholdFields[i].ChannelKey">Channel</label>
                                    <input asp-for="NewSensor.SensorChannelThresholdFields[i].ChannelKey" class="mat-input mat-mono" placeholder="latency" readonly="@hasFixedChannels" />
                                </div>
                                <div class="mat-field">
                                    <label class="mat-label mat-text-warning" asp-for="NewSensor.SensorChannelThresholdFields[i].WarningComparison">Warning</label>
                                    <div class="mat-input-group">
                                        <select asp-for="NewSensor.SensorChannelThresholdFields[i].WarningComparison" class="mat-select" asp-items="WorkspaceModel.ThresholdComparisonOptions"></select>
                                        <input asp-for="NewSensor.SensorChannelThresholdFields[i].WarningValue" type="number" step="any" class="mat-input mat-mono" placeholder="@field.WarningValuePlaceholder" aria-label="Warning value for @channelName" />
                                    </div>
                                </div>
                                <div class="mat-field">
                                    <label class="mat-label mat-text-danger" asp-for="NewSensor.SensorChannelThresholdFields[i].CriticalComparison">Critical</label>
                                    <div class="mat-input-group">
                                        <select asp-for="NewSensor.SensorChannelThresholdFields[i].CriticalComparison" class="mat-select" asp-items="WorkspaceModel.ThresholdComparisonOptions"></select>
                                        <input asp-for="NewSensor.SensorChannelThresholdFields[i].CriticalValue" type="number" step="any" class="mat-input mat-mono" placeholder="@field.CriticalValuePlaceholder" aria-label="Critical value for @channelName" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!hasFixedChannels && Model.NewSensor.SensorChannelThresholdFields.Count > Model.NewSensor.SensorChannelThresholdVisibleCount)
                {
                    <div class="mat-actions">
                        <button type="button" class="mat-btn mat-btn--secondary" data-threshold-add>@MatUi.Icon("plus")<span>Add channel</span></button>
                    </div>
                }
            }
        </div>
    </section>

    @await Html.PartialAsync("_SensorSchedule", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

    <details class="mat-collapse">
        <summary><span>More settings</span>@MatUi.Icon("chevron-down", "mat-accordion__chev")</summary>
        <div class="mat-accordion__body">
            <div class="mat-form__grid">
                <div class="mat-field mat-field--full">
                    <label class="mat-label" asp-for="NewSensor.Description">Description</label>
                    <input asp-for="NewSensor.Description" class="mat-input" placeholder="Description" />
                </div>
                <div class="mat-field mat-field--full">
                    <label class="mat-label" asp-for="NewSensor.TagsText">Tags</label>
                    <input asp-for="NewSensor.TagsText" class="mat-input" placeholder="prod, network" data-tag-input />
                    <partial name="_TagSuggestions" model="Model.View.AllTags" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewSensor.Highlight">Highlight</label>
                    <select asp-for="NewSensor.Highlight" class="mat-select">
                        <option value="">@(string.IsNullOrWhiteSpace(Model.NewSensor.HighlightInheritedLabel) || string.Equals(Model.NewSensor.HighlightInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.NewSensor.HighlightInheritedLabel})")</option>
                        <option value="true">on</option>
                        <option value="false">off</option>
                    </select>
                </div>
            </div>
        </div>
    </details>

    <partial name="_RemoteRunPreview" model="Model" />

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create</span></button>
        <button type="submit" asp-page-handler="RunSensorNow" formnovalidate class="mat-btn mat-btn--secondary">@MatUi.Icon("play")<span>Analyze</span></button>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
    <button type="submit" asp-page-handler="PreviewSensorFields" formnovalidate hidden data-sensor-preview-submit>Preview</button>
</form>

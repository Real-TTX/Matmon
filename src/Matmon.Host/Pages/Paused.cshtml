@page "/Paused"
@model WorkspaceModel
@{
    ViewData["Title"] = "Paused";
    var pausedSensors = Model.View.Nodes.Where(node => node.Kind == MonitoringElementKind.Sensor && node.IsPaused).ToArray();
    var countText = $"{pausedSensors.Length} {(pausedSensors.Length == 1 ? "sensor" : "sensors")} paused";
    var returnUrl = Request.Path + Request.QueryString;
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<div class="mat-list">
    @if (pausedSensors.Length == 0)
    {
        <div class="mat-empty mat-empty--first">
            <span class="mat-empty__icon">@MatUi.Icon("pause")</span>
            <div class="mat-empty__title">No paused sensors</div>
            <a class="mat-btn mat-btn--secondary" asp-page="/Monitoring">@MatUi.Icon("activity")<span>Open the sensors</span></a>
        </div>
    }
    else
    {
        <div class="mat-toolbar" role="toolbar" aria-label="Paused sensors tools">
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-toolbar__info" aria-live="polite">@countText</span>
        </div>

        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Paused sensors</caption>
                <thead>
                    <tr>
                        <th scope="col">Sensor</th>
                        <th scope="col" class="mat-hide-sm">Target</th>
                        <th scope="col">State</th>
                        <th scope="col" class="mat-hide-sm">Message</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var node in pausedSensors)
                    {
                        <tr>
                            <td data-label="Sensor" class="mat-table__primary">
                                <div class="mat-table__name">
                                    <span>
                                        <a asp-page="/SensorDetails" asp-route-sensorId="@node.Id">@node.Name</a>
                                        <small>@node.Path</small>
                                    </span>
                                </div>
                            </td>
                            <td data-label="Target" class="mat-hide-sm mat-mono">@node.Target</td>
                            <td data-label="State"><span class="@MatUi.PillClass("paused")">Paused</span></td>
                            <td data-label="Message" class="mat-hide-sm">@node.StateMessage</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/SensorDetails" asp-route-sensorId="@node.Id" aria-label="Details of @node.Name" data-tip="Details">@MatUi.Icon("bar-chart")</a>
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/ElementEditor" asp-route-selectedId="@node.Id" aria-label="Edit @node.Name" data-tip="Edit">@MatUi.Icon("edit")</a>
                                    <form method="post" asp-page-handler="ToggleSensorPause" asp-route-sensorId="@node.Id" asp-route-returnUrl="@returnUrl">
                                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Resume @node.Name" data-tip="Resume">@MatUi.Icon("play")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@page "/system/users/new"
@model UserCreateModel
@{
    ViewData["Title"] = "New user";
    var backUrl = Model.GetSafeReturnUrl("/Config?tab=users");
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("plus")
            <h1>New user</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-editor-panel">
        <form method="post" class="workspace-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <label class="workspace-field" style="margin-bottom:0.6rem;">
                <span class="workspace-label">Account type</span>
                <select asp-for="UserInput.AccountType" class="form-select workspace-select" data-usertype-select>
                    <option value="Local">Local — username + password</option>
                    <option value="Cloud">Matmon Cloud — e-mail, SSO (no local password)</option>
                </select>
            </label>

            <div class="workspace-form-grid">
                <label class="workspace-field" data-usertype="local">
                    <span class="workspace-label">Username</span>
                    <input asp-for="UserInput.Username" class="form-control workspace-input" autocomplete="username" />
                </label>

                <label class="workspace-field" data-usertype="local">
                    <span class="workspace-label">Password</span>
                    <input asp-for="UserInput.Password" type="password" class="form-control workspace-input" autocomplete="new-password" />
                </label>

                <label class="workspace-field" data-usertype="cloud" hidden>
                    <span class="workspace-label">Cloud account e-mail</span>
                    <input asp-for="UserInput.Email" type="email" class="form-control workspace-input" autocomplete="email" />
                </label>

                <label class="workspace-field">
                    <span class="workspace-label">Role</span>
                    <select asp-for="UserInput.Role" asp-items="Model.RoleOptions" class="form-select workspace-select"></select>
                </label>
            </div>

            <div class="workspace-inline-note" data-usertype="local">New users are created as enabled accounts.</div>
            <div class="workspace-inline-note" data-usertype="cloud" hidden>Cloud users sign in with “Sign in with Matmon Cloud” (SSO) — no local password is set. An admin can add one later on the user's page.</div>

            <script>
                (function () {
                    var sel = document.querySelector("[data-usertype-select]");
                    if (!sel) { return; }
                    function sync() {
                        var t = (sel.value || "Local").toLowerCase();
                        document.querySelectorAll("[data-usertype]").forEach(function (el) {
                            el.hidden = el.getAttribute("data-usertype") !== t;
                        });
                    }
                    sel.addEventListener("change", sync);
                    sync();
                })();
            </script>

            <div class="workspace-form-actions">
                <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create user</span></button>
            </div>
        </form>
    </section>
</section>

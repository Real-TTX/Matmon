@page "/system/users/new"
@model UserCreateModel
@{
    ViewData["Title"] = "New user";
    ViewData["Width"] = "narrow";
    var backUrl = Model.GetSafeReturnUrl("/Config?tab=users");
    var isCloud = Model.UserInput.AccountType == UserAccountType.Cloud;
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@* The account type decides the fields (data-show-if): a local account has a username and a password, a cloud account
   only the e-mail of its Matmon Cloud account. The server reads only the fields of the chosen type. *@
<form method="post" class="mat-form" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />

    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("user")<h2 class="mat-card__title">New user</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-field mat-field--full">
                    <label class="mat-label" for="UserInput_AccountType">Account type</label>
                    <select asp-for="UserInput.AccountType" class="mat-select">
                        <option value="Local">Local - username + password</option>
                        <option value="Cloud">Matmon Cloud - e-mail, SSO (no local password)</option>
                    </select>
                </div>

                <div class="mat-field mat-field--full" data-show-if="#UserInput_AccountType" data-show-value="Local" hidden="@isCloud">
                    <label class="mat-label" for="UserInput_Username">Username</label>
                    <input asp-for="UserInput.Username" class="mat-input" autocomplete="username" />
                </div>

                <div class="mat-field" data-show-if="#UserInput_AccountType" data-show-value="Local" hidden="@isCloud">
                    <label class="mat-label" for="UserInput_Password">Password</label>
                    <input asp-for="UserInput.Password" type="password" class="mat-input" autocomplete="new-password" />
                </div>

                <div class="mat-field" data-show-if="#UserInput_AccountType" data-show-value="Local" hidden="@isCloud">
                    <label class="mat-label" for="UserInput_PasswordConfirm">Confirm password</label>
                    <input asp-for="UserInput.PasswordConfirm" type="password" class="mat-input" autocomplete="new-password" />
                </div>

                <div class="mat-field mat-field--full" data-show-if="#UserInput_AccountType" data-show-value="Cloud" hidden="@(!isCloud)">
                    <label class="mat-label" for="UserInput_Email">Cloud account e-mail</label>
                    <input asp-for="UserInput.Email" type="email" class="mat-input" autocomplete="email" data-msg-type="Please enter a valid e-mail address." />
                    <span class="mat-error" aria-live="polite"></span>
                </div>

                <div class="mat-field">
                    <label class="mat-label" for="UserInput_Role">Role</label>
                    <select asp-for="UserInput.Role" asp-items="Model.RoleOptions" class="mat-select"></select>
                </div>
            </div>
        </div>
    </section>

    <p class="mat-muted" data-show-if="#UserInput_AccountType" data-show-value="Local" hidden="@isCloud">New users are created as enabled accounts.</p>
    <p class="mat-muted" data-show-if="#UserInput_AccountType" data-show-value="Cloud" hidden="@(!isCloud)">Cloud users sign in with “Sign in with Matmon Cloud” (SSO) - no local password is set. An admin can add one later on the user's page.</p>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create user</span></button>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
</form>

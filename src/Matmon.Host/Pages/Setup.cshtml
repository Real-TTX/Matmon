@page "/setup"
@model SetupModel
@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Setup";

    // The brand at the top of the card: a managing partner's logo, or nothing under a white label without one, else the
    // Matmon mark; a white label's product name replaces "Matmon" in the text.
    var partnerProductName = WorkspaceStore.GetServicePartnerProductName();
    var partnerHasLogo = WorkspaceStore.GetServicePartnerHasLogo();
    var brandName = partnerProductName ?? "Matmon";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @if (partnerHasLogo)
        {
            <img class="mm-auth-logo" src="/api/branding/logo" alt="" />
        }
        else if (partnerProductName is null)
        {
            <img src="/brand/matmon-mark.svg" alt="" width="56" height="56" />
        }
        <h1>Welcome to @brandName</h1>
        <p class="mat-muted">Create the administrator account to continue.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
    }

    <form method="post" class="mat-form" novalidate>
        <div class="mat-field">
            <label class="mat-label" for="Email">E-mail</label>
            <input asp-for="Email" type="email" class="mat-input" autocomplete="username" autofocus required
                   data-msg-required="Please enter the administrator's e-mail address." data-msg-type="Please enter an address like name@example.com." />
            <span class="mat-error" aria-live="polite"></span>
        </div>
        <div class="mat-field">
            <label class="mat-label" for="Password">Password</label>
            <div class="mat-input-icon mat-input-icon--end">
                <input asp-for="Password" type="password" class="mat-input" autocomplete="new-password" required minlength="8"
                       data-msg-required="Please choose a password." data-msg-range="The password needs at least 8 characters." />
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm mat-input-icon__btn" data-password-toggle="Password" aria-pressed="false" aria-label="Show the password" data-tip="Show or hide">@MatUi.Icon("eye", "mat-toggle-on")@MatUi.Icon("eye-off", "mat-toggle-off")</button>
            </div>
            <span class="mat-hint">At least 8 characters.</span>
            <span class="mat-error" aria-live="polite"></span>
        </div>
        <div class="mat-field">
            <label class="mat-label" for="ConfirmPassword">Repeat password</label>
            <input asp-for="ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" required data-msg-required="Please repeat the password." />
            <span class="mat-error" aria-live="polite"></span>
        </div>
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@MatUi.Icon("shield")<span>Create account</span></button>
        </div>
    </form>
</div>

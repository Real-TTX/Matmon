@page "/Discovery"
@model DiscoveryModel
@using System.Globalization
@using Matmon.Host.Services
@{
    ViewData["Title"] = "Discovery";
    var selectedJob = Model.View.SelectedJob;
    var runningJobs = Model.View.RunningJobs;
    var historyJobs = Model.View.HistoryJobs;
    var discoveryTabImport = Model.Import ? "true" : null;
    var showResults = selectedJob is not null || Model.Results.Count > 0;
    var selectedJobIsActive = selectedJob?.Status is DiscoveryJobStatus.Pending or DiscoveryJobStatus.Running;
    var selectedJobTone = selectedJob?.Status == DiscoveryJobStatus.Failed
        ? "error"
        : selectedJob?.Status == DiscoveryJobStatus.Completed
            ? "ok"
            : "warning";
    var canImport = selectedJob?.Status == DiscoveryJobStatus.Completed && Model.Results.Count > 0;
    var showImportAssistant = canImport && (Model.Import || selectedJob?.Status == DiscoveryJobStatus.Completed);
    var selectedHostAddresses = Model.SelectedHostAddresses
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var selectedSuggestionKeys = Model.SelectedSuggestionKeys
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .ToHashSet(StringComparer.Ordinal);
    var hasImportSelection = selectedHostAddresses.Count > 0 || selectedSuggestionKeys.Count > 0;
}

<section class="dashboard-shell">
    <div class="page-header has-summary">
        <div class="page-title">
            @MatmonIcons.Render("network")
            <h1>Discovery</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    @if (selectedJob is { } job)
    {
        <section class="panel panel-stack workspace-panel" data-discovery-job-panel data-discovery-job-id="@job.JobId" data-discovery-active="@selectedJobIsActive.ToString().ToLowerInvariant()">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>Probe job</span></h2>
                <span class="state-pill" data-discovery-job-status data-state="@selectedJobTone">@job.Status</span>
            </div>
            <div class="discovery-job-summary">
                <span>@job.ProbeName</span>
                <span>@job.Request.Network</span>
                <span data-discovery-job-message>@(job.Message ?? "Waiting for probe sync")</span>
            </div>
            <div class="discovery-progress" data-discovery-progress>
                <div class="discovery-progress-header">
                    <strong data-discovery-progress-percent>@job.ProgressPercent%</strong>
                    <span>
                        <span data-discovery-progress-scanned>@job.ScannedHosts</span>/<span data-discovery-progress-total>@job.TotalHosts</span>
                        checked
                    </span>
                </div>
                <div class="discovery-progress-track" aria-hidden="true">
                    <span data-discovery-progress-bar style="width: @job.ProgressPercent%"></span>
                </div>
            </div>
            @if (job.Status is DiscoveryJobStatus.Pending or DiscoveryJobStatus.Running)
            {
                <form method="post" asp-page-handler="Cancel" asp-route-jobId="@job.JobId" class="page-actions workspace-toolbar">
                    <span class="workspace-secondary-submit">@MatmonIcons.Render("clock")<span>Live refresh</span></span>
                    <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("x")<span>Cancel job</span></button>
                </form>
            }
            else if (canImport)
            {
                <div class="page-actions workspace-toolbar">
                    <a class="workspace-submit" asp-page="/Discovery" asp-route-jobId="@job.JobId" asp-route-import="true">@MatmonIcons.Render("plus")<span>Create selected</span></a>
                </div>
            }
        </section>
    }

    <div class="workspace-tabs discovery-tabs" role="tablist" aria-label="Discovery sections">
        <a class="workspace-tab @(Model.IsActiveTab("scan") ? "is-active" : "")" asp-page="/Discovery" asp-route-tab="scan" asp-route-jobId="@Model.JobId" asp-route-import="@discoveryTabImport">@MatmonIcons.Render("search")<span>Scan</span></a>
        <a class="workspace-tab @(Model.IsActiveTab("running") ? "is-active" : "")" asp-page="/Discovery" asp-route-tab="running" asp-route-jobId="@Model.JobId" asp-route-import="@discoveryTabImport">@MatmonIcons.Render("clock")<span>Running</span><span class="workspace-tab-count">@runningJobs.Count</span></a>
        <a class="workspace-tab @(Model.IsActiveTab("history") ? "is-active" : "")" asp-page="/Discovery" asp-route-tab="history" asp-route-jobId="@Model.JobId" asp-route-import="@discoveryTabImport">@MatmonIcons.Render("clock")<span>History</span><span class="workspace-tab-count">@historyJobs.Count</span></a>
    </div>

    @if (Model.IsActiveTab("scan"))
    {
        <section class="panel panel-stack workspace-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("search")<span>Scan</span></h2>
            <span class="panel-hint">CIDR, range or single IP</span>
        </div>

        <form method="post" asp-page-handler="Scan" class="workspace-form-grid discovery-form">
            <label class="workspace-field workspace-span-2">
                <span class="workspace-label">Probe / node</span>
                <select asp-for="Input.ProbeElementId" asp-items="Model.View.ProbeOptions" class="form-select workspace-select"></select>
            </label>

            <label class="workspace-field workspace-span-2">
                <span class="workspace-label">Network</span>
                <input asp-for="Input.Network" class="form-control workspace-input" placeholder="10.10.2.0/24 or 10.10.2.1-254" />
            </label>

            <div class="workspace-field">
                <span class="workspace-label">Checks</span>
                <label class="workspace-check"><input asp-for="Input.UsePing" /> Ping</label>
                <label class="workspace-check"><input asp-for="Input.PingFirst" /> Quick scan: ping first</label>
                <label class="workspace-check"><input asp-for="Input.UseTcpPorts" /> TCP ports</label>
                <label class="workspace-check"><input asp-for="Input.UseSnmp" /> SNMP probe</label>
                <label class="workspace-check"><input asp-for="Input.UseReverseDns" /> Reverse DNS</label>
                <span class="discovery-check-note">Quick scan runs the ping sweep in parallel and only deep-scans hosts that answer ICMP.</span>
            </div>

            <label class="workspace-field">
                <span class="workspace-label">TCP ports</span>
                <input asp-for="Input.TcpPortsText" class="form-control workspace-input" placeholder="22, 80, 443" />
            </label>

            <label class="workspace-field">
                <span class="workspace-label">SNMP community</span>
                <input asp-for="Input.SnmpCommunity" class="form-control workspace-input" placeholder="public" />
            </label>

            <label class="workspace-field">
                <span class="workspace-label">SNMP version</span>
                <select asp-for="Input.SnmpVersion" class="form-select workspace-select">
                    <option value="v2c">v2c</option>
                    <option value="v1">v1</option>
                </select>
            </label>

            <label class="workspace-field">
                <span class="workspace-label">Timeout ms</span>
                <input asp-for="Input.TimeoutMs" type="number" min="150" max="10000" class="form-control workspace-input" />
            </label>

            <label class="workspace-field">
                <span class="workspace-label">Max hosts</span>
                <input asp-for="Input.MaxHosts" type="number" min="1" max="65534" class="form-control workspace-input" />
            </label>

            <label class="workspace-field">
                <span class="workspace-label">Parallelism</span>
                <input asp-for="Input.Parallelism" type="number" min="1" max="128" class="form-control workspace-input" />
            </label>

            <div class="workspace-form-actions workspace-span-2">
                <button type="submit" class="workspace-submit">@MatmonIcons.Render("search")<span>Start discovery</span></button>
            </div>
        </form>
    </section>
    }

    @if (showResults)
    {
        <section class="panel panel-stack workspace-panel" data-discovery-results-panel data-discovery-import-mode="@showImportAssistant.ToString().ToLowerInvariant()">
                <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render(showImportAssistant ? "plus" : "host")<span>@(showImportAssistant ? "Create hosts and sensors" : "Discovery result")</span></h2>
                <span class="panel-hint"><span data-discovery-result-count>@Model.Results.Count</span> host@(Model.Results.Count == 1 ? string.Empty : "s") found</span>
            </div>

            @if (showImportAssistant)
            {
                <form method="post" asp-page-handler="CreateSelected" class="discovery-results-form" data-discovery-results-form>
                    <input type="hidden" asp-for="ImportJobId" />
                    <input type="hidden" asp-for="Input.ProbeElementId" />
                    <input type="hidden" asp-for="Input.Network" />
                    <input type="hidden" asp-for="Input.UsePing" />
                    <input type="hidden" asp-for="Input.PingFirst" />
                    <input type="hidden" asp-for="Input.UseTcpPorts" />
                    <input type="hidden" asp-for="Input.TcpPortsText" />
                    <input type="hidden" asp-for="Input.UseSnmp" />
                    <input type="hidden" asp-for="Input.SnmpCommunity" />
                    <input type="hidden" asp-for="Input.SnmpVersion" />
                    <input type="hidden" asp-for="Input.SnmpPort" />
                    <input type="hidden" asp-for="Input.UseReverseDns" />
                    <input type="hidden" asp-for="Input.TimeoutMs" />
                    <input type="hidden" asp-for="Input.MaxHosts" />
                    <input type="hidden" asp-for="Input.Parallelism" />
                    <input type="hidden" asp-for="Input.CreatePingSensor" />
                    <input type="hidden" asp-for="Input.CreatePortSensors" />
                    <input type="hidden" asp-for="Input.CreateHttpSensors" />
                    <input type="hidden" asp-for="Input.CreateSnmpSensor" />

                    <div class="page-actions workspace-toolbar discovery-assistant-actions">
                        <button type="button" class="workspace-secondary-submit" data-discovery-select-all>@MatmonIcons.Render("check")<span>Select all</span></button>
                        <button type="button" class="workspace-secondary-submit" data-discovery-select-none>@MatmonIcons.Render("x")<span>Select none</span></button>
                    </div>
                    <div class="workspace-inline-note">Select the hosts to create or reuse, then tick only the sensor suggestions you want below each host.</div>

                    <div class="empty-state" data-discovery-empty hidden="@(Model.Results.Count > 0 ? "hidden" : null)">No hosts discovered yet.</div>

                    <div class="discovery-result-tools">
                        <label class="monitoring-filter-field">
                            <span>@MatmonIcons.Render("search")<small>Filter</small></span>
                            <input type="search" class="form-control workspace-input" placeholder="Address, name, service" data-discovery-filter />
                        </label>
                        <label class="monitoring-filter-field">
                            <span>Service</span>
                            <select class="form-select workspace-select" data-discovery-service-filter>
                                <option value="all">All</option>
                                <option value="ping">Ping</option>
                                <option value="ports">Open ports</option>
                                <option value="snmp">SNMP</option>
                                <option value="sensors">Suggestions</option>
                            </select>
                        </label>
                        <span class="panel-hint"><span data-discovery-visible-count>@Model.Results.Count</span> visible</span>
                    </div>

                    <div class="discovery-result-table-wrap">
                        <table class="discovery-result-table">
                            <thead>
                                <tr>
                                    <th class="discovery-table-select">Use</th>
                                    <th><button type="button" data-discovery-sort="address">Address</button></th>
                                    <th><button type="button" data-discovery-sort="host">Name</button></th>
                                    <th><button type="button" data-discovery-sort="ping">Ping</button></th>
                                    <th><button type="button" data-discovery-sort="ports">Ports</button></th>
                                    <th>SNMP</th>
                                    <th><button type="button" data-discovery-sort="sensors">Found</button></th>
                                </tr>
                            </thead>
                            <tbody data-discovery-result-list>
                                @for (var index = 0; index < Model.Results.Count; index++)
                                {
                                    var result = Model.Results[index];
                                    var portCount = string.IsNullOrWhiteSpace(result.OpenPortsText)
                                        ? 0
                                        : result.OpenPortsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;
                                    var sensorCount = result.SuggestedSensors.Count;
                                    var searchText = $"{result.Address} {result.HostName} {result.OpenPortsText} {result.SnmpSummary} {result.Message} {string.Join(' ', result.SuggestedSensors.Select(sensor => $"{sensor.SensorTypeKey} {sensor.Name} {sensor.Target} {sensor.Reason}"))}";
                                    var hostChecked = !hasImportSelection || selectedHostAddresses.Contains(result.Address);

                                    <tr class="discovery-host-row"
                                        data-discovery-address="@result.Address"
                                        data-discovery-host="@result.HostName"
                                        data-discovery-text="@searchText"
                                        data-discovery-ping="@(result.PingAlive ? "ok" : "none")"
                                        data-discovery-ping-ms="@(result.PingMs?.ToString(CultureInfo.InvariantCulture) ?? "")"
                                        data-discovery-port-count="@portCount"
                                        data-discovery-snmp="@(result.SnmpResponded ? "true" : "false")"
                                        data-discovery-sensor-count="@sensorCount"
                                        data-discovery-expanded="false">
                                        <td class="discovery-table-select">
                                            <button type="button" class="discovery-row-toggle" data-discovery-toggle aria-expanded="false">+</button>
                                            <input type="checkbox" name="SelectedHostAddresses" value="@result.Address" checked="@hostChecked" />
                                        </td>
                                        <td class="discovery-address-cell"><span class="tree-kind" data-kind="host">@MatmonIcons.Render("host")<span>Host</span></span><strong>@result.Address</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(result.HostName) ? "-" : result.HostName)</td>
                                        <td>@(result.PingAlive ? $"{result.PingMs?.ToString("0.#")} ms" : "-")</td>
                                        <td title="@result.OpenPortsText">@(portCount == 0 ? "-" : $"{portCount} open")</td>
                                        <td>@(result.SnmpResponded ? "yes" : "-")</td>
                                        <td><span class="state-pill" data-state="@(sensorCount > 0 ? "ok" : "warning")">@sensorCount service@(sensorCount == 1 ? string.Empty : "s")</span></td>
                                    </tr>
                                    <tr class="discovery-suggestion-panel" data-discovery-parent-address="@result.Address" hidden>
                                        <td colspan="7">
                                            <div class="discovery-host-message">@result.Message</div>
                                            @if (result.SuggestedSensors.Count == 0)
                                            {
                                                <div class="empty-state">No sensor suggestions.</div>
                                            }
                                            else
                                            {
                                                <div class="discovery-suggestion-list">
                                                    @for (var sensorIndex = 0; sensorIndex < result.SuggestedSensors.Count; sensorIndex++)
                                                    {
                                                        var suggestion = result.SuggestedSensors[sensorIndex];
                                                        var suggestionKey = $"{result.Address}|{suggestion.SensorTypeKey}|{suggestion.Target}|{suggestion.Name}";
                                                        var suggestionChecked = !hasImportSelection || selectedSuggestionKeys.Contains(suggestionKey);
                                                        <label class="discovery-suggestion-row" data-discovery-suggestion-key="@suggestionKey">
                                                            <input type="checkbox" name="SelectedSuggestionKeys" value="@suggestionKey" checked="@suggestionChecked" />
                                                            <span class="sensor-chip">@suggestion.SensorTypeKey</span>
                                                            <span class="discovery-suggestion-name">@suggestion.Name</span>
                                                            @if (!string.IsNullOrWhiteSpace(suggestion.Target))
                                                            {
                                                                <span class="event-row-path">@suggestion.Target</span>
                                                            }
                                                            <span class="event-row-message">@suggestion.Reason</span>
                                                            <span class="state-pill" data-state="ok">@suggestion.Confidence%</span>

                                                        </label>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="page-actions workspace-toolbar">
                        <button type="submit" class="workspace-submit" data-discovery-import-button disabled="@(Model.Results.Count == 0 ? "disabled" : null)">@MatmonIcons.Render("plus")<span>Create selected hosts/sensors</span></button>
                        <a class="workspace-secondary-submit" asp-page="/Discovery">@MatmonIcons.Render("arrow-left")<span>New scan</span></a>
                    </div>
                </form>
            }
            else
            {
                <div class="empty-state" data-discovery-empty hidden="@(Model.Results.Count > 0 ? "hidden" : null)">No hosts discovered yet.</div>

                <div class="discovery-result-tools">
                    <label class="monitoring-filter-field">
                        <span>@MatmonIcons.Render("search")<small>Filter</small></span>
                        <input type="search" class="form-control workspace-input" placeholder="Address, name, service" data-discovery-filter />
                    </label>
                    <label class="monitoring-filter-field">
                        <span>Service</span>
                        <select class="form-select workspace-select" data-discovery-service-filter>
                            <option value="all">All</option>
                            <option value="ping">Ping</option>
                            <option value="ports">Open ports</option>
                            <option value="snmp">SNMP</option>
                            <option value="sensors">Suggestions</option>
                        </select>
                    </label>
                    <span class="panel-hint"><span data-discovery-visible-count>@Model.Results.Count</span> visible</span>
                </div>

                <div class="discovery-result-table-wrap">
                    <table class="discovery-result-table">
                        <thead>
                            <tr>
                                <th class="discovery-table-select"></th>
                                <th><button type="button" data-discovery-sort="address">Address</button></th>
                                <th><button type="button" data-discovery-sort="host">Name</button></th>
                                <th><button type="button" data-discovery-sort="ping">Ping</button></th>
                                <th><button type="button" data-discovery-sort="ports">Ports</button></th>
                                <th>SNMP</th>
                                <th><button type="button" data-discovery-sort="sensors">Found</button></th>
                            </tr>
                        </thead>
                        <tbody data-discovery-result-list>
                            @for (var index = 0; index < Model.Results.Count; index++)
                            {
                                var result = Model.Results[index];
                                var portCount = string.IsNullOrWhiteSpace(result.OpenPortsText)
                                    ? 0
                                    : result.OpenPortsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;
                                var sensorCount = result.SuggestedSensors.Count;
                                var searchText = $"{result.Address} {result.HostName} {result.OpenPortsText} {result.SnmpSummary} {result.Message} {string.Join(' ', result.SuggestedSensors.Select(sensor => $"{sensor.SensorTypeKey} {sensor.Name} {sensor.Target} {sensor.Reason}"))}";

                                <tr class="discovery-host-row"
                                    data-discovery-address="@result.Address"
                                    data-discovery-host="@result.HostName"
                                    data-discovery-text="@searchText"
                                    data-discovery-ping="@(result.PingAlive ? "ok" : "none")"
                                    data-discovery-ping-ms="@(result.PingMs?.ToString(CultureInfo.InvariantCulture) ?? "")"
                                    data-discovery-port-count="@portCount"
                                    data-discovery-snmp="@(result.SnmpResponded ? "true" : "false")"
                                    data-discovery-sensor-count="@sensorCount"
                                    data-discovery-expanded="false">
                                    <td class="discovery-table-select">
                                        <button type="button" class="discovery-row-toggle" data-discovery-toggle aria-expanded="false">+</button>
                                    </td>
                                    <td class="discovery-address-cell"><span class="tree-kind" data-kind="host">@MatmonIcons.Render("host")<span>Host</span></span><strong>@result.Address</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(result.HostName) ? "-" : result.HostName)</td>
                                    <td>@(result.PingAlive ? $"{result.PingMs?.ToString("0.#")} ms" : "-")</td>
                                    <td title="@result.OpenPortsText">@(portCount == 0 ? "-" : $"{portCount} open")</td>
                                    <td>@(result.SnmpResponded ? "yes" : "-")</td>
                                    <td><span class="state-pill" data-state="@(sensorCount > 0 ? "ok" : "warning")">@sensorCount service@(sensorCount == 1 ? string.Empty : "s")</span></td>
                                </tr>
                                <tr class="discovery-suggestion-panel" data-discovery-parent-address="@result.Address" hidden>
                                    <td colspan="7">
                                        <div class="discovery-host-message">@result.Message</div>
                                        @if (result.SuggestedSensors.Count == 0)
                                        {
                                            <div class="empty-state">No sensor suggestions.</div>
                                        }
                                        else
                                        {
                                            <div class="discovery-suggestion-list">
                                                @foreach (var suggestion in result.SuggestedSensors)
                                                {
                                                    <div class="discovery-suggestion-row discovery-suggestion-row-readonly">
                                                        <span class="sensor-chip">@suggestion.SensorTypeKey</span>
                                                        <span class="discovery-suggestion-name">@suggestion.Name</span>
                                                        @if (!string.IsNullOrWhiteSpace(suggestion.Target))
                                                        {
                                                            <span class="event-row-path">@suggestion.Target</span>
                                                        }
                                                        <span class="event-row-message">@suggestion.Reason</span>
                                                        <span class="state-pill" data-state="ok">@suggestion.Confidence%</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="page-actions workspace-toolbar">
                    @if (selectedJob is not null)
                    {
                        <a class="workspace-submit" asp-page="/Discovery" asp-route-jobId="@selectedJob.JobId" asp-route-import="true" data-discovery-import-link hidden="@(!canImport ? "hidden" : null)">@MatmonIcons.Render("plus")<span>Create sensors from result</span></a>
                    }
                    <a class="workspace-secondary-submit" asp-page="/Discovery">@MatmonIcons.Render("arrow-left")<span>New scan</span></a>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("running"))
    {
        <section class="panel panel-stack workspace-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>Running</span></h2>
                <span class="panel-hint">Active discovery jobs on probes</span>
            </div>

            @if (runningJobs.Count == 0)
            {
                <div class="empty-state">No running discovery...</div>
            }
            else
            {
                <div class="discovery-result-table-wrap">
                    <table class="discovery-result-table discovery-job-table">
                        <thead>
                            <tr>
                                <th>Probe</th>
                                <th>Network</th>
                                <th>Status</th>
                                <th>Progress</th>
                                <th>Message</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var running in runningJobs)
                            {
                                var runningTone = running.Status == DiscoveryJobStatus.Failed
                                    ? "error"
                                    : running.Status == DiscoveryJobStatus.Completed
                                        ? "ok"
                                        : "warning";
                                <tr>
                                    <td>
                                        <a class="tree-kind discovery-job-link" data-kind="probe" asp-page="/Discovery" asp-route-jobId="@running.JobId" asp-route-tab="running">@running.ProbeName</a>
                                    </td>
                                    <td>
                                        <a class="discovery-job-main-link" asp-page="/Discovery" asp-route-jobId="@running.JobId" asp-route-tab="running">
                                            <strong>@running.Request.Network</strong>
                                            <span>@(running.Message ?? running.Status.ToString())</span>
                                        </a>
                                    </td>
                                    <td><span class="state-pill" data-state="@runningTone">@running.Status</span></td>
                                    <td>@running.ProgressPercent%</td>
                                    <td>@(string.IsNullOrWhiteSpace(running.Message) ? "-" : running.Message)</td>
                                    <td>
                                        <div class="discovery-job-actions">
                                            <a class="workspace-action-link" asp-page="/Discovery" asp-route-jobId="@running.JobId" asp-route-tab="running">@MatmonIcons.Render("search")<span>Open</span></a>
                                            <form method="post" asp-page-handler="Cancel" asp-route-jobId="@running.JobId">
                                                <button type="submit" class="workspace-action-link workspace-danger-submit">@MatmonIcons.Render("x")<span>Cancel</span></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("history"))
    {
        <section class="panel panel-stack workspace-panel" data-discovery-jobs-panel>
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>History</span></h2>
                <span class="panel-hint"><span data-discovery-job-visible-count>@historyJobs.Count</span> / @historyJobs.Count visible</span>
            </div>

            <div class="discovery-result-tools">
                <label class="monitoring-filter-field">
                    <span>@MatmonIcons.Render("search")<small>Filter</small></span>
                    <input type="search" class="form-control workspace-input" placeholder="Probe, network, message" data-discovery-job-filter />
                </label>
                <label class="monitoring-filter-field">
                    <span>Status</span>
                    <select class="form-select workspace-select" data-discovery-job-status-filter>
                        <option value="all">All</option>
                        <option value="completed">Completed</option>
                        <option value="running">Running</option>
                        <option value="pending">Pending</option>
                        <option value="failed">Failed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </label>
            </div>

                <div class="discovery-result-table-wrap">
                    <table class="discovery-result-table discovery-job-table">
                        <thead>
                        <tr>
                            <th>Probe</th>
                            <th>Network</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Hosts</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (historyJobs.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">No discovery history yet.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var recent in historyJobs)
                        {
                            var recentCanImport = recent.Status == DiscoveryJobStatus.Completed && recent.Results.Count > 0;
                            var recentTone = recent.Status == DiscoveryJobStatus.Failed
                                ? "error"
                                : recent.Status == DiscoveryJobStatus.Completed
                                    ? "ok"
                                    : recent.Status == DiscoveryJobStatus.Cancelled
                                        ? "unknown"
                                        : "warning";
                            var recentSearchText = $"{recent.ProbeName} {recent.ProbeId} {recent.Request.Network} {recent.Status} {recent.Message}";
                            <tr data-discovery-job-row data-discovery-job-status="@recent.Status.ToString().ToLowerInvariant()" data-discovery-job-text="@recentSearchText">
                                <td>
                                    <a class="tree-kind discovery-job-link" data-kind="probe" asp-page="/Discovery" asp-route-jobId="@recent.JobId">@recent.ProbeName</a>
                                </td>
                                <td>
                                    <a class="discovery-job-main-link" asp-page="/Discovery" asp-route-jobId="@recent.JobId">
                                        <strong>@recent.Request.Network</strong>
                                        <span>@(recent.Message ?? recent.Status.ToString())</span>
                                    </a>
                                </td>
                                <td><span class="state-pill" data-state="@recentTone">@recent.Status</span></td>
                                <td>@recent.ProgressPercent%</td>
                                <td>@recent.Results.Count</td>
                                <td>@recent.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="discovery-job-actions">
                                        <a class="workspace-action-link" asp-page="/Discovery" asp-route-jobId="@recent.JobId">@MatmonIcons.Render("search")<span>Open</span></a>
                                        @if (recentCanImport)
                                        {
                                            <a class="workspace-action-link" asp-page="/Discovery" asp-route-jobId="@recent.JobId" asp-route-import="true">@MatmonIcons.Render("plus")<span>Create</span></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>

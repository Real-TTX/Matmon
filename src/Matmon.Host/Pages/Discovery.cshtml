@page "/Discovery"
@model DiscoveryModel
@using System.Globalization
@using Matmon.Host.Services
@{
    ViewData["Title"] = "Discovery";
    var selectedJob = Model.View.SelectedJob;
    var runningJobs = Model.View.RunningJobs;
    var historyJobs = Model.View.HistoryJobs;
    var showResults = selectedJob is not null || Model.Results.Count > 0;
    var selectedJobIsActive = selectedJob?.Status is DiscoveryJobStatus.Pending or DiscoveryJobStatus.Running;
    var selectedJobTone = selectedJob?.Status == DiscoveryJobStatus.Failed
        ? "error"
        : selectedJob?.Status == DiscoveryJobStatus.Completed
            ? "ok"
            : "warning";
    var canImport = selectedJob?.Status == DiscoveryJobStatus.Completed && Model.Results.Count > 0;
    var showImportAssistant = canImport && (Model.Import || selectedJob?.Status == DiscoveryJobStatus.Completed);
    var selectedHostAddresses = Model.SelectedHostAddresses
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var selectedSuggestionKeys = Model.SelectedSuggestionKeys
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .ToHashSet(StringComparer.Ordinal);
    var hasImportSelection = selectedHostAddresses.Count > 0 || selectedSuggestionKeys.Count > 0;
    var hostScopedImport = string.Equals(selectedJob?.Request.ScopeKind?.ToString(), "Host", StringComparison.OrdinalIgnoreCase);
    // A suggestion counts as "recommended" (default-selected, badged) at/above this confidence. Mirror in site.js.
    var recommendedMin = 80;
}

<section class="dashboard-shell">
    <div class="page-header has-summary">
        <div class="page-title">
            @MatmonIcons.Render("network")
            <h1>Discovery</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    @if (Model.Mode == "scan")
    {
        @* ---- Start a discovery (its own screen, reached via the "Discover" button) ---- *@
        <div class="page-actions workspace-toolbar">
            <a class="workspace-secondary-submit" asp-page="/Discovery">@MatmonIcons.Render("arrow-left")<span>Back to jobs</span></a>
        </div>

        <section class="panel panel-stack workspace-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("search")<span>Start a discovery</span></h2>
                <span class="panel-hint">whole subnet or known hosts</span>
            </div>

            <form method="post" asp-page-handler="Scan" class="workspace-form-grid discovery-form" data-discovery-scan-form>
                <label class="workspace-field workspace-span-2">
                    <span class="workspace-label">Probe / node</span>
                    <select asp-for="Input.ProbeElementId" asp-items="Model.View.ProbeOptions" class="form-select workspace-select"></select>
                </label>

                <div class="workspace-field workspace-span-2 discovery-scope">
                    <span class="workspace-label">Scan scope</span>
                    <div class="discovery-scope-options">
                        <label class="discovery-scope-option">
                            <input type="radio" asp-for="Input.ScanScope" value="network" />
                            <span class="discovery-scope-text">
                                <strong>Whole subnet / range</strong>
                                <small>Sweep a CIDR, range or single IP</small>
                            </span>
                        </label>
                        <label class="discovery-scope-option">
                            <input type="radio" asp-for="Input.ScanScope" value="known" />
                            <span class="discovery-scope-text">
                                <strong>Known hosts only</strong>
                                <small>Re-scan the @Model.View.KnownHostCount host@(Model.View.KnownHostCount == 1 ? string.Empty : "s") already under this probe</small>
                            </span>
                        </label>
                    </div>
                </div>

                <label class="workspace-field workspace-span-2" data-discovery-network-field>
                    <span class="workspace-label">Network</span>
                    <input asp-for="Input.Network" class="form-control workspace-input" placeholder="10.10.2.0/24 or 10.10.2.1-254" data-discovery-network-input />
                    @if (Model.View.SubnetSuggestions.Count > 0)
                    {
                        <div class="discovery-subnet-suggestions">
                            <span class="panel-hint">Suggested subnets:</span>
                            @foreach (var subnet in Model.View.SubnetSuggestions)
                            {
                                <button type="button" class="discovery-subnet-chip" data-discovery-subnet="@subnet">@subnet</button>
                            }
                        </div>
                    }
                </label>

                <div class="workspace-field workspace-span-2">
                    <span class="workspace-label">Options</span>
                    <label class="workspace-check"><input asp-for="Input.PingFirst" /> Quick scan — only deep-scan hosts that answer ping (faster; skips silent hosts)</label>
                    <span class="discovery-check-note">Matmon probes ping, common TCP services and SNMP automatically. SNMP lets it recognize the platform (e.g. a Synology NAS) and suggest the matching sensor — no scan tuning needed.</span>
                </div>

                <div class="workspace-form-actions workspace-span-2">
                    <button type="submit" class="workspace-submit">@MatmonIcons.Render("search")<span>Start discovery</span></button>
                </div>
            </form>
        </section>
    }
    else if (Model.Mode == "job")
    {
        @* ---- A selected job: its live detail + (when finished) the results / import assistant ---- *@
        <div class="page-actions workspace-toolbar">
            <a class="workspace-secondary-submit" asp-page="/Discovery">@MatmonIcons.Render("arrow-left")<span>Back to jobs</span></a>
        </div>

        @if (selectedJob is { } job)
        {
            <section class="panel panel-stack workspace-panel" data-discovery-job-panel data-discovery-job-id="@job.JobId" data-discovery-active="@selectedJobIsActive.ToString().ToLowerInvariant()">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("clock")<span>Probe job</span></h2>
                    <span class="state-pill" data-discovery-job-status data-state="@selectedJobTone">@job.Status</span>
                </div>
                <div class="discovery-job-summary">
                    <span>@job.ProbeName</span>
                    <span>@job.Request.Network</span>
                    <span data-discovery-job-message>@(job.Message ?? "Waiting for probe sync")</span>
                </div>
                <div class="discovery-progress" data-discovery-progress>
                    <div class="discovery-progress-header">
                        <strong data-discovery-progress-percent>@job.ProgressPercent%</strong>
                        <span>
                            <span data-discovery-progress-scanned>@job.ScannedHosts</span>/<span data-discovery-progress-total>@job.TotalHosts</span>
                            checked
                        </span>
                    </div>
                    <div class="discovery-progress-track" aria-hidden="true">
                        <span data-discovery-progress-bar style="width: @job.ProgressPercent%"></span>
                    </div>
                </div>
                @if (job.Status is DiscoveryJobStatus.Pending or DiscoveryJobStatus.Running)
                {
                    <form method="post" asp-page-handler="Cancel" asp-route-jobId="@job.JobId" class="page-actions workspace-toolbar">
                        <span class="workspace-secondary-submit">@MatmonIcons.Render("clock")<span>Live refresh</span></span>
                        <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("x")<span>Cancel job</span></button>
                    </form>
                }
                else if (canImport)
                {
                    <div class="page-actions workspace-toolbar">
                        <a class="workspace-submit" asp-page="/Discovery" asp-route-jobId="@job.JobId" asp-route-import="true">@MatmonIcons.Render("plus")<span>Create selected</span></a>
                    </div>
                }
            </section>
        }

        @if (showResults)
        {
            <section class="panel panel-stack workspace-panel" data-discovery-results-panel data-discovery-import-mode="@showImportAssistant.ToString().ToLowerInvariant()">
                    <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render(showImportAssistant ? "plus" : "host")<span>@(showImportAssistant ? (hostScopedImport ? "Create sensors" : "Create hosts and sensors") : "Discovery result")</span></h2>
                    <span class="panel-hint"><span data-discovery-result-count>@Model.Results.Count</span> host@(Model.Results.Count == 1 ? string.Empty : "s") found</span>
                </div>

                @if (showImportAssistant)
                {
                    <form method="post" asp-page-handler="CreateSelected" class="discovery-results-form" data-discovery-results-form>
                        <input type="hidden" asp-for="ImportJobId" />
                        <input type="hidden" asp-for="Input.ProbeElementId" />
                        <input type="hidden" asp-for="Input.Network" />
                        <input type="hidden" asp-for="Input.UsePing" />
                        <input type="hidden" asp-for="Input.PingFirst" />
                        <input type="hidden" asp-for="Input.UseTcpPorts" />
                        <input type="hidden" asp-for="Input.TcpPortsText" />
                        <input type="hidden" asp-for="Input.UseSnmp" />
                        <input type="hidden" asp-for="Input.SnmpCommunity" />
                        <input type="hidden" asp-for="Input.SnmpVersion" />
                        <input type="hidden" asp-for="Input.SnmpPort" />
                        <input type="hidden" asp-for="Input.UseReverseDns" />
                        <input type="hidden" asp-for="Input.TimeoutMs" />
                        <input type="hidden" asp-for="Input.MaxHosts" />
                        <input type="hidden" asp-for="Input.Parallelism" />
                        <input type="hidden" asp-for="Input.CreatePingSensor" />
                        <input type="hidden" asp-for="Input.CreatePortSensors" />
                        <input type="hidden" asp-for="Input.CreateHttpSensors" />
                        <input type="hidden" asp-for="Input.CreateSnmpSensor" />

                        <div class="page-actions workspace-toolbar discovery-assistant-actions discovery-presets">
                            <span class="panel-hint" style="margin-right:2px;">Preselect:</span>
                            <button type="button" class="discovery-preset is-active" data-discovery-preset="recommended">@MatmonIcons.Render("check")<span>Recommended</span></button>
                            <button type="button" class="discovery-preset" data-discovery-preset="all"><span>All</span></button>
                            <button type="button" class="discovery-preset" data-discovery-preset="none"><span>None</span></button>
                        </div>
                        <div class="workspace-inline-note">Pick the hosts to create, then the sensors under each. Unchecking a host greys it out - it won't be imported.</div>

                        <div class="empty-state" data-discovery-empty hidden="@(Model.Results.Count > 0 ? "hidden" : null)">No hosts discovered yet.</div>

                        <div class="discovery-result-tools">
                            <label class="monitoring-filter-field">
                                <span>@MatmonIcons.Render("search")<small>Filter</small></span>
                                <input type="search" class="form-control workspace-input" placeholder="Address, name, service" data-discovery-filter />
                            </label>
                            <label class="monitoring-filter-field">
                                <span>Service</span>
                                <select class="form-select workspace-select" data-discovery-service-filter>
                                    <option value="all">All</option>
                                    <option value="ping">Ping</option>
                                    <option value="ports">Open ports</option>
                                    <option value="snmp">SNMP</option>
                                    <option value="sensors">Suggestions</option>
                                </select>
                            </label>
                            <span class="panel-hint"><span data-discovery-visible-count>@Model.Results.Count</span> visible</span>
                        </div>

                        <div class="discovery-tree" data-discovery-result-list>
                            @for (var index = 0; index < Model.Results.Count; index++)
                            {
                                var result = Model.Results[index];
                                var portCount = string.IsNullOrWhiteSpace(result.OpenPortsText)
                                    ? 0
                                    : result.OpenPortsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;
                                var sensorCount = result.SuggestedSensors.Count;
                                // Pre-select a host only when it has at least one NEW sensor to add. A host that already
                                // exists and whose suggested sensors are all already present (or that has no suggestions)
                                // starts unchecked/greyed - importing it would be a no-op. Under the rank-based rule every
                                // host with a new suggestion has a recommended one, so this matches the per-sensor logic below.
                                var anyRecommended = result.SuggestedSensors.Any(sensor => !sensor.AlreadyExists);
                                var searchText = $"{result.Address} {result.HostName} {result.OpenPortsText} {result.SnmpSummary} {result.Message} {string.Join(' ', result.SuggestedSensors.Select(sensor => $"{sensor.SensorTypeKey} {sensor.Name} {sensor.Target} {sensor.Reason}"))}";
                                var hostChecked = hostScopedImport || (hasImportSelection ? selectedHostAddresses.Contains(result.Address) : anyRecommended);
                                var expanded = sensorCount > 0;

                                <div class="discovery-node @(hostChecked ? "is-selected" : "is-disabled")"
                                     data-discovery-address="@result.Address"
                                     data-discovery-host="@result.HostName"
                                     data-discovery-text="@searchText"
                                     data-discovery-ping="@(result.PingAlive ? "ok" : "none")"
                                     data-discovery-ping-ms="@(result.PingMs?.ToString(CultureInfo.InvariantCulture) ?? "")"
                                     data-discovery-port-count="@portCount"
                                     data-discovery-snmp="@(result.SnmpResponded ? "true" : "false")"
                                     data-discovery-sensor-count="@sensorCount"
                                     data-discovery-expanded="@(expanded ? "true" : "false")">
                                    <div class="discovery-node-head">
                                        @if (hostScopedImport)
                                        {
                                            <input type="hidden" name="SelectedHostAddresses" value="@result.Address" />
                                            <input type="checkbox" class="discovery-node-check" checked="checked" disabled="disabled" aria-label="Host selected for sensor import" />
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="discovery-node-check" name="SelectedHostAddresses" value="@result.Address" data-discovery-host-check checked="@hostChecked" />
                                        }
                                        <button type="button" class="discovery-node-toggle" data-discovery-toggle aria-expanded="@(expanded ? "true" : "false")">@(expanded ? "▾" : "▸")</button>
                                        <span class="tree-kind" data-kind="host">@MatmonIcons.Render("host")</span>
                                        <span class="discovery-node-title">
                                            <strong>@result.Address</strong>
                                            @if (!string.IsNullOrWhiteSpace(result.HostName))
                                            {
                                                <span class="discovery-node-sub">@result.HostName</span>
                                            }
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(result.ExistingHostName))
                                        {
                                            <span class="discovery-node-exists" title="Host already exists as '@result.ExistingHostName' — it won't be created again; only the new sensors below are added.">@MatmonIcons.Render("check")<span>Exists</span></span>
                                        }
                                        <span class="discovery-node-facts">
                                            @if (result.PingAlive)
                                            {
                                                <span class="discovery-fact" data-ok>@(result.PingMs?.ToString("0.#")) ms</span>
                                            }
                                            @if (portCount > 0)
                                            {
                                                <span class="discovery-fact" title="@result.OpenPortsText">@portCount port@(portCount == 1 ? string.Empty : "s")</span>
                                            }
                                            @if (result.SnmpResponded)
                                            {
                                                <span class="discovery-fact">SNMP</span>
                                            }
                                        </span>
                                        <span class="discovery-node-count">@sensorCount sensor@(sensorCount == 1 ? string.Empty : "s")</span>
                                    </div>
                                    <div class="discovery-node-body" hidden="@(expanded ? null : "hidden")">
                                        @if (!string.IsNullOrWhiteSpace(result.Message))
                                        {
                                            <div class="discovery-node-message">@result.Message</div>
                                        }
                                        @if (sensorCount == 0)
                                        {
                                            <div class="discovery-node-empty">No sensor suggestions.</div>
                                        }
                                        else
                                        {
                                            var hasPlatformHealth = result.SuggestedSensors.Any(sensor => SensorDiscoveryImportance.IsPlatformHealth(sensor.SensorTypeKey));
                                            // Recommended = Ping + platform-health always; if the host has no platform-health, also its single best (top-confidence non-ping) suggestion.
                                            var bestOtherType = result.SuggestedSensors
                                                .Where(sensor => !string.Equals(sensor.SensorTypeKey, SensorDiscoveryImportance.PingKey, StringComparison.OrdinalIgnoreCase))
                                                .OrderByDescending(sensor => sensor.Confidence)
                                                .Select(sensor => sensor.SensorTypeKey)
                                                .FirstOrDefault();
                                            var orderedSensors = result.SuggestedSensors
                                                .Select(suggestion =>
                                                {
                                                    var key = $"{result.Address}|{suggestion.SensorTypeKey}|{suggestion.Target}|{suggestion.Name}";
                                                    var rec = SensorDiscoveryImportance.IsRecommended(suggestion.SensorTypeKey)
                                                        || (!hasPlatformHealth && string.Equals(suggestion.SensorTypeKey, bestOtherType, StringComparison.OrdinalIgnoreCase));
                                                    // An already-present sensor is never pre-selected (import would skip it); an explicit
                                                    // re-render selection is still honoured so the user can override.
                                                    var chk = hasImportSelection ? selectedSuggestionKeys.Contains(key) : (rec && !suggestion.AlreadyExists);
                                                    return (Suggestion: suggestion, Key: key, Recommended: rec, Checked: chk, Extra: !rec && !chk);
                                                })
                                                .OrderByDescending(item => SensorDiscoveryImportance.Rank(item.Suggestion.SensorTypeKey))
                                                .ThenByDescending(item => item.Suggestion.Confidence)
                                                .ToList();
                                            var extraCount = orderedSensors.Count(item => item.Extra);
                                            <div class="discovery-node-sensors">
                                                @foreach (var item in orderedSensors)
                                                {
                                                    <label class="discovery-sensor@(item.Extra ? " is-extra" : string.Empty)@(item.Suggestion.AlreadyExists ? " is-present" : string.Empty)" data-discovery-suggestion-key="@item.Key" data-discovery-recommended="@(item.Recommended ? "true" : "false")">
                                                        <input type="checkbox" name="SelectedSuggestionKeys" value="@item.Key" data-discovery-sensor-check checked="@item.Checked" />
                                                        <span class="tree-kind" data-kind="sensor">@MatmonIcons.Render("sensor")</span>
                                                        <span class="sensor-chip">@item.Suggestion.SensorTypeKey</span>
                                                        <span class="discovery-sensor-name" title="@item.Suggestion.Reason">@item.Suggestion.Name</span>
                                                        @if (!string.IsNullOrWhiteSpace(item.Suggestion.Target))
                                                        {
                                                            <span class="discovery-sensor-target">@item.Suggestion.Target</span>
                                                        }
                                                        <span class="discovery-sensor-spacer"></span>
                                                        @if (item.Suggestion.AlreadyExists)
                                                        {
                                                            <span class="discovery-sensor-exists" title="Already monitored on this host — it won't be added again.">@MatmonIcons.Render("check")<span>Already added</span></span>
                                                        }
                                                        else
                                                        {
                                                            @if (item.Recommended)
                                                            {
                                                                <span class="discovery-sensor-badge">Recommended</span>
                                                            }
                                                            <span class="state-pill" data-state="@(item.Recommended ? "ok" : "warning")">@item.Suggestion.Confidence%</span>
                                                        }
                                                    </label>
                                                }
                                                @if (extraCount > 0)
                                                {
                                                    <button type="button" class="discovery-sensor-more" data-discovery-more aria-expanded="false">@MatmonIcons.Render("plus")<span class="discovery-more-show">@extraCount more sensor@(extraCount == 1 ? string.Empty : "s")</span><span class="discovery-more-hide">Hide extra sensors</span></button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="page-actions workspace-toolbar">
                            <button type="submit" class="workspace-submit" data-discovery-import-button disabled="@(Model.Results.Count == 0 ? "disabled" : null)">@MatmonIcons.Render("plus")<span>Create selected hosts/sensors</span></button>
                            <a class="workspace-secondary-submit" asp-page="/Discovery" asp-route-tab="scan">@MatmonIcons.Render("search")<span>New scan</span></a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="empty-state" data-discovery-empty hidden="@(Model.Results.Count > 0 ? "hidden" : null)">No hosts discovered yet.</div>

                    <div class="discovery-result-tools">
                        <label class="monitoring-filter-field">
                            <span>@MatmonIcons.Render("search")<small>Filter</small></span>
                            <input type="search" class="form-control workspace-input" placeholder="Address, name, service" data-discovery-filter />
                        </label>
                        <label class="monitoring-filter-field">
                            <span>Service</span>
                            <select class="form-select workspace-select" data-discovery-service-filter>
                                <option value="all">All</option>
                                <option value="ping">Ping</option>
                                <option value="ports">Open ports</option>
                                <option value="snmp">SNMP</option>
                                <option value="sensors">Suggestions</option>
                            </select>
                        </label>
                        <span class="panel-hint"><span data-discovery-visible-count>@Model.Results.Count</span> visible</span>
                    </div>

                    <div class="discovery-tree" data-discovery-result-list>
                        @for (var index = 0; index < Model.Results.Count; index++)
                        {
                            var result = Model.Results[index];
                            var portCount = string.IsNullOrWhiteSpace(result.OpenPortsText)
                                ? 0
                                : result.OpenPortsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;
                            var sensorCount = result.SuggestedSensors.Count;
                            var searchText = $"{result.Address} {result.HostName} {result.OpenPortsText} {result.SnmpSummary} {result.Message} {string.Join(' ', result.SuggestedSensors.Select(sensor => $"{sensor.SensorTypeKey} {sensor.Name} {sensor.Target} {sensor.Reason}"))}";
                            var expanded = sensorCount > 0;

                            <div class="discovery-node"
                                 data-discovery-address="@result.Address"
                                 data-discovery-host="@result.HostName"
                                 data-discovery-text="@searchText"
                                 data-discovery-ping="@(result.PingAlive ? "ok" : "none")"
                                 data-discovery-ping-ms="@(result.PingMs?.ToString(CultureInfo.InvariantCulture) ?? "")"
                                 data-discovery-port-count="@portCount"
                                 data-discovery-snmp="@(result.SnmpResponded ? "true" : "false")"
                                 data-discovery-sensor-count="@sensorCount"
                                 data-discovery-expanded="@(expanded ? "true" : "false")">
                                <div class="discovery-node-head">
                                    <button type="button" class="discovery-node-toggle" data-discovery-toggle aria-expanded="@(expanded ? "true" : "false")">@(expanded ? "▾" : "▸")</button>
                                    <span class="tree-kind" data-kind="host">@MatmonIcons.Render("host")</span>
                                    <span class="discovery-node-title">
                                        <strong>@result.Address</strong>
                                        @if (!string.IsNullOrWhiteSpace(result.HostName))
                                        {
                                            <span class="discovery-node-sub">@result.HostName</span>
                                        }
                                    </span>
                                    <span class="discovery-node-facts">
                                        @if (result.PingAlive)
                                        {
                                            <span class="discovery-fact" data-ok>@(result.PingMs?.ToString("0.#")) ms</span>
                                        }
                                        @if (portCount > 0)
                                        {
                                            <span class="discovery-fact" title="@result.OpenPortsText">@portCount port@(portCount == 1 ? string.Empty : "s")</span>
                                        }
                                        @if (result.SnmpResponded)
                                        {
                                            <span class="discovery-fact">SNMP</span>
                                        }
                                    </span>
                                    <span class="discovery-node-count">@sensorCount sensor@(sensorCount == 1 ? string.Empty : "s")</span>
                                </div>
                                <div class="discovery-node-body" hidden="@(expanded ? null : "hidden")">
                                    @if (!string.IsNullOrWhiteSpace(result.Message))
                                    {
                                        <div class="discovery-node-message">@result.Message</div>
                                    }
                                    @if (sensorCount == 0)
                                    {
                                        <div class="discovery-node-empty">No sensor suggestions.</div>
                                    }
                                    else
                                    {
                                        <div class="discovery-node-sensors">
                                            @foreach (var suggestion in result.SuggestedSensors)
                                            {
                                                var recommended = suggestion.Confidence >= recommendedMin;
                                                <div class="discovery-sensor is-readonly">
                                                    <span class="tree-kind" data-kind="sensor">@MatmonIcons.Render("sensor")</span>
                                                    <span class="sensor-chip">@suggestion.SensorTypeKey</span>
                                                    <span class="discovery-sensor-name" title="@suggestion.Reason">@suggestion.Name</span>
                                                    @if (!string.IsNullOrWhiteSpace(suggestion.Target))
                                                    {
                                                        <span class="discovery-sensor-target">@suggestion.Target</span>
                                                    }
                                                    <span class="discovery-sensor-spacer"></span>
                                                    <span class="state-pill" data-state="@(recommended ? "ok" : "warning")">@suggestion.Confidence%</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="page-actions workspace-toolbar">
                        @if (selectedJob is not null)
                        {
                            <a class="workspace-submit" asp-page="/Discovery" asp-route-jobId="@selectedJob.JobId" asp-route-import="true" data-discovery-import-link hidden="@(!canImport ? "hidden" : null)">@MatmonIcons.Render("plus")<span>@(hostScopedImport ? "Create sensors from host" : "Create sensors from result")</span></a>
                        }
                        <a class="workspace-secondary-submit" asp-page="/Discovery" asp-route-tab="scan">@MatmonIcons.Render("search")<span>New scan</span></a>
                    </div>
                }
            </section>
        }
    }
    else
    {
        @* ---- Home: Running section (with the Discover button) + the Jobs history list ---- *@
        <section class="panel panel-stack workspace-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>Running</span><span class="workspace-tab-count">@runningJobs.Count</span></h2>
                <span class="panel-hint">Active discovery jobs on probes</span>
            </div>

            @if (runningJobs.Count == 0)
            {
                <div class="empty-state">Nothing running right now. Start a scan with <strong>Discover</strong> below.</div>
            }
            else
            {
                <div class="discovery-result-table-wrap">
                    <table class="discovery-result-table discovery-job-table">
                        <thead>
                            <tr>
                                <th>Probe</th>
                                <th>Network</th>
                                <th>Status</th>
                                <th>Progress</th>
                                <th>Message</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var running in runningJobs)
                            {
                                var runningTone = running.Status == DiscoveryJobStatus.Failed
                                    ? "error"
                                    : running.Status == DiscoveryJobStatus.Completed
                                        ? "ok"
                                        : "warning";
                                <tr>
                                    <td>
                                        <a class="tree-kind discovery-job-link" data-kind="probe" asp-page="/Discovery" asp-route-jobId="@running.JobId">@running.ProbeName</a>
                                    </td>
                                    <td>
                                        <a class="discovery-job-main-link" asp-page="/Discovery" asp-route-jobId="@running.JobId">
                                            <strong>@running.Request.Network</strong>
                                            <span>@(running.Message ?? running.Status.ToString())</span>
                                        </a>
                                    </td>
                                    <td><span class="state-pill" data-state="@runningTone">@running.Status</span></td>
                                    <td>@running.ProgressPercent%</td>
                                    <td>@(string.IsNullOrWhiteSpace(running.Message) ? "-" : running.Message)</td>
                                    <td>
                                        <div class="discovery-job-actions">
                                            <a class="workspace-action-link" asp-page="/Discovery" asp-route-jobId="@running.JobId">@MatmonIcons.Render("search")<span>Open</span></a>
                                            <form method="post" asp-page-handler="Cancel" asp-route-jobId="@running.JobId">
                                                <button type="submit" class="workspace-action-link workspace-danger-submit">@MatmonIcons.Render("x")<span>Cancel</span></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="page-actions workspace-toolbar discovery-home-actions">
                <a class="workspace-submit" asp-page="/Discovery" asp-route-tab="scan">@MatmonIcons.Render("search")<span>Discover</span></a>
            </div>
        </section>

        <section class="panel panel-stack workspace-panel" data-discovery-jobs-panel>
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>Jobs</span></h2>
                <span class="panel-hint"><span data-discovery-job-visible-count>@historyJobs.Count</span> / @historyJobs.Count visible</span>
            </div>

            <div class="discovery-result-tools">
                <label class="monitoring-filter-field">
                    <span>@MatmonIcons.Render("search")<small>Filter</small></span>
                    <input type="search" class="form-control workspace-input" placeholder="Probe, network, message" data-discovery-job-filter />
                </label>
                <label class="monitoring-filter-field">
                    <span>Status</span>
                    <select class="form-select workspace-select" data-discovery-job-status-filter>
                        <option value="all">All</option>
                        <option value="completed">Completed</option>
                        <option value="running">Running</option>
                        <option value="pending">Pending</option>
                        <option value="failed">Failed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </label>
            </div>

                <div class="discovery-result-table-wrap">
                    <table class="discovery-result-table discovery-job-table">
                        <thead>
                        <tr>
                            <th>Probe</th>
                            <th>Network</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Hosts</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (historyJobs.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">No discovery history yet.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var recent in historyJobs)
                        {
                            var recentCanImport = recent.Status == DiscoveryJobStatus.Completed && recent.Results.Count > 0;
                            var recentTone = recent.Status == DiscoveryJobStatus.Failed
                                ? "error"
                                : recent.Status == DiscoveryJobStatus.Completed
                                    ? "ok"
                                    : recent.Status == DiscoveryJobStatus.Cancelled
                                        ? "unknown"
                                        : "warning";
                            var recentSearchText = $"{recent.ProbeName} {recent.ProbeId} {recent.Request.Network} {recent.Status} {recent.Message}";
                            <tr data-discovery-job-row data-discovery-job-status="@recent.Status.ToString().ToLowerInvariant()" data-discovery-job-text="@recentSearchText">
                                <td>
                                    <a class="tree-kind discovery-job-link" data-kind="probe" asp-page="/Discovery" asp-route-jobId="@recent.JobId">@recent.ProbeName</a>
                                </td>
                                <td>
                                    <a class="discovery-job-main-link" asp-page="/Discovery" asp-route-jobId="@recent.JobId">
                                        <strong>@recent.Request.Network</strong>
                                        <span>@(recent.Message ?? recent.Status.ToString())</span>
                                    </a>
                                </td>
                                <td><span class="state-pill" data-state="@recentTone">@recent.Status</span></td>
                                <td>@recent.ProgressPercent%</td>
                                <td>@recent.Results.Count</td>
                                <td>@recent.CreatedUtc.ToDisplay().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="discovery-job-actions">
                                        <a class="workspace-action-link" asp-page="/Discovery" asp-route-jobId="@recent.JobId">@MatmonIcons.Render("search")<span>Open</span></a>
                                        @if (recentCanImport)
                                        {
                                            <a class="workspace-action-link" asp-page="/Discovery" asp-route-jobId="@recent.JobId" asp-route-import="true">@MatmonIcons.Render("plus")<span>Create</span></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</section>

@page "/monitoring/probe/{probeElementId:guid}/usage"
@model ProbeUsageModel
@using System.Globalization
@{
    ViewData["Title"] = $"{Model.View.Name} Usage";
    ViewData["WorkspaceSummarySuppress"] = true;
    var isGroupedView = string.Equals(Model.View.ViewMode, "grouped", StringComparison.OrdinalIgnoreCase);
    var returnUrl = string.IsNullOrWhiteSpace(Model.ReturnUrl) ? "/Monitoring" : Model.ReturnUrl;
}

<section class="dashboard-shell">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <div class="page-header sensor-header probe-usage-header" style="--sensor-state-color:@Model.View.StatusColor">
        <div class="sensor-header-main">
            <div class="page-title">
                @MatmonIcons.Render("chart")
                <h1>Usage</h1>
            </div>
            <div class="sensor-path">@Model.View.Path</div>
            <div class="sensor-meta">
                <span class="sensor-chip">@Model.View.RoleLabel</span>
                <span class="sensor-chip">Probe: @Model.View.ProbeId</span>
                <span class="state-pill" data-state="@Model.View.StatusKey">@Model.View.StatusLabel</span>
                <span class="sensor-chip">Sensors @Model.View.SensorCount / @Model.View.TotalSensorCount</span>
                <span class="sensor-chip">Groups @Model.View.GroupCount / @Model.View.TotalGroupCount</span>
            </div>
            <div class="sensor-state-message">@Model.View.StatusMessage</div>
        </div>
    </div>

    <section class="panel panel-stack probe-usage-toolbar-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("filter")<span>Usage view</span></h2>
            <span class="panel-hint">@Model.View.FilterSummary</span>
        </div>

        <form method="get" class="probe-usage-toolbar">
            <input type="hidden" name="probeElementId" value="@Model.ProbeElementId" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="viewMode" value="@Model.View.ViewMode" />

            <div class="probe-usage-view-switch">
                <a class="workspace-tab @(isGroupedView ? "is-active" : string.Empty)"
                   asp-page="/ProbeUsage"
                   asp-route-probeElementId="@Model.ProbeElementId"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-viewMode="grouped"
                   asp-route-search="@Model.View.Search"
                   asp-route-usageFilter="@Model.View.UsageFilter"
                   asp-route-sortBy="@Model.View.SortBy"
                   asp-route-highlightedOnly="@Model.View.HighlightedOnly">
                    Grouped
                </a>
                <a class="workspace-tab @(!isGroupedView ? "is-active" : string.Empty)"
                   asp-page="/ProbeUsage"
                   asp-route-probeElementId="@Model.ProbeElementId"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-viewMode="table"
                   asp-route-search="@Model.View.Search"
                   asp-route-usageFilter="@Model.View.UsageFilter"
                   asp-route-sortBy="@Model.View.SortBy"
                   asp-route-highlightedOnly="@Model.View.HighlightedOnly">
                    Table
                </a>
            </div>

            <label class="monitoring-filter-field probe-usage-filter-field">
                <span>@MatmonIcons.Render("search")<small>Search</small></span>
                <input type="search" name="search" value="@Model.View.Search" class="form-control workspace-input" placeholder="Name, path, target, type" />
            </label>

            <label class="monitoring-filter-field probe-usage-filter-field">
                <span>@MatmonIcons.Render("sensor")<small>Usage</small></span>
                <select name="usageFilter" class="form-select workspace-select">
                    <option value="all" selected="@(Model.View.UsageFilter == "all" ? "selected" : null)">All</option>
                    <option value="low" selected="@(Model.View.UsageFilter == "low" ? "selected" : null)">Low</option>
                    <option value="moderate" selected="@(Model.View.UsageFilter == "moderate" ? "selected" : null)">Moderate</option>
                    <option value="high" selected="@(Model.View.UsageFilter == "high" ? "selected" : null)">High</option>
                </select>
            </label>

            <label class="monitoring-filter-field probe-usage-filter-field">
                <span>@MatmonIcons.Render("list")<small>Sort</small></span>
                <select name="sortBy" class="form-select workspace-select">
                    <option value="load" selected="@(Model.View.SortBy == "load" ? "selected" : null)">Load</option>
                    <option value="name" selected="@(Model.View.SortBy == "name" ? "selected" : null)">Name</option>
                    <option value="type" selected="@(Model.View.SortBy == "type" ? "selected" : null)">Type</option>
                    <option value="state" selected="@(Model.View.SortBy == "state" ? "selected" : null)">State</option>
                    <option value="bytes" selected="@(Model.View.SortBy == "bytes" ? "selected" : null)">Bytes</option>
                    <option value="log" selected="@(Model.View.SortBy == "log" ? "selected" : null)">Log entries</option>
                </select>
            </label>

            <label class="workspace-check probe-usage-highlight-check">
                <input type="checkbox" name="highlightedOnly" value="true" @(Model.View.HighlightedOnly ? "checked" : null) />
                Highlighted only
            </label>

            <button type="submit" class="workspace-submit">@MatmonIcons.Render("check")<span>Apply</span></button>
            <a class="workspace-secondary-submit"
               asp-page="/ProbeUsage"
               asp-route-probeElementId="@Model.ProbeElementId"
               asp-route-returnUrl="@Model.ReturnUrl"
               asp-route-viewMode="@Model.View.ViewMode">
                @MatmonIcons.Render("arrow-left")
                <span>Reset</span>
            </a>
        </form>

        <div class="probe-usage-overview" aria-label="Usage overview">
            <div class="probe-usage-overview-card">
                <span>Estimated bytes per second</span>
                <strong>@Model.View.EstimatedBytesPerSecondText</strong>
            </div>
            <div class="probe-usage-overview-card">
                <span>Estimated bytes per hour</span>
                <strong>@Model.View.EstimatedBytesPerHourText</strong>
            </div>
            <div class="probe-usage-overview-card">
                <span>Estimated bytes per day</span>
                <strong>@Model.View.EstimatedBytesPerDayText</strong>
            </div>
            <div class="probe-usage-overview-card probe-usage-overview-card-accent" title="Steady-state on-disk footprint once retention has caught up: raw samples over the raw-retention window + downsampled per-channel statistics over their window. Covers the whole probe (ignores filters).">
                <span>Estimated probe size <small>(at retention)</small></span>
                <strong>@Model.View.EstimatedProbeSizeText</strong>
            </div>
            <div class="probe-usage-overview-card">
                <span>Storage used</span>
                <strong>@Model.View.DataSizeText</strong>
            </div>
            <div class="probe-usage-overview-card">
                <span>Storage free</span>
                <strong>@Model.View.StorageFreeText</strong>
            </div>
        </div>

        <p class="probe-usage-overview-note">@MatmonIcons.Render("info")<span>Estimates = each sensor's poll rate × payload size × retention. Retention &amp; statistics roll-up run <strong>every 5 minutes</strong>, so disk space is reclaimed shortly after data ages out. The probe-size estimate covers all sensors (ignores the filters below).</span></p>

        <div class="probe-usage-distribution">
            <div class="probe-usage-distribution-header">
                <span class="workspace-label">Load distribution</span>
                <span class="panel-hint">@Model.View.DistributionLabel</span>
            </div>
            @if (Model.View.DistributionSegments.Count == 0)
            {
                <div class="empty-state probe-usage-distribution-empty">No visible load data for the current filters.</div>
            }
            else
            {
                <div class="probe-usage-distribution-bar" aria-label="Load distribution">
                    @foreach (var segment in Model.View.DistributionSegments)
                    {
                        <span class="probe-usage-distribution-segment"
                              data-level="@segment.UsageLevelKey"
                              title="@segment.Label @segment.Percent.ToString("0.#", CultureInfo.InvariantCulture)% - @segment.DetailText"
                              style="width:@segment.Percent.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                    }
                </div>
                <div class="probe-usage-distribution-legend">
                    @foreach (var segment in Model.View.DistributionSegments)
                    {
                        <span class="probe-usage-distribution-chip" data-level="@segment.UsageLevelKey" title="@segment.DetailText">
                            <strong>@segment.Label</strong>
                            <span>@segment.Percent.ToString("0.#", CultureInfo.InvariantCulture)%</span>
                        </span>
                    }
                </div>
            }
        </div>
    </section>

    @if (Model.View.TopLogSensors.Count > 0)
    {
        <section class="panel panel-stack probe-usage-logs-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("clock")<span>Largest logs</span></h2>
                <span class="panel-hint">stored entries per sensor · @Model.View.TotalStoredObservationCountText total</span>
            </div>
            <div class="probe-usage-log-hint">Sensors with the most stored history. An outlier here usually means an over-fast poll interval or too-long retention - a good place to spot misconfigured sensors.</div>
            <div class="probe-usage-log-list">
                @foreach (var logSensor in Model.View.TopLogSensors)
                {
                    <a class="probe-usage-log-row" data-level="@logSensor.UsageLevelKey"
                       asp-page="/SensorDetails" asp-route-sensorId="@logSensor.SensorId" title="@logSensor.Path">
                        <div class="probe-usage-log-main">
                            <span class="probe-usage-log-name">@logSensor.Name</span>
                            <span class="probe-usage-log-meta">@logSensor.SensorTypeLabel · @logSensor.ScheduleSummary</span>
                        </div>
                        <div class="probe-usage-log-bar" aria-hidden="true">
                            <span style="width:@logSensor.RelativeLogPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                        </div>
                        <span class="probe-usage-log-count">@logSensor.StoredObservationCountText</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="panel panel-stack">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("signal")<span>@(isGroupedView ? "Sensor groups" : "Sensors")</span></h2>
            <span class="panel-hint">@Model.View.SensorCount visible / @Model.View.TotalSensorCount total</span>
        </div>

        @if (Model.View.SensorCount == 0)
        {
            <div class="empty-state">No sensors match the current filters.</div>
        }
        else if (isGroupedView)
        {
            <div class="probe-usage-group-list">
                @foreach (var group in Model.View.Groups)
                {
                    <details class="probe-usage-group" @(group.IsExpanded ? "open" : null)>
                        <summary class="probe-usage-group-summary">
                            <div class="probe-usage-group-main">
                                <div class="probe-usage-group-title">
                                    <span class="probe-usage-group-name">@group.SensorTypeLabel</span>
                                    <span class="usage-level-pill" data-level="@group.UsageLevelKey">@group.UsageLevelLabel</span>
                                    <span class="probe-usage-group-count">@group.SensorCount sensors</span>
                                </div>
                                <div class="probe-usage-group-meta">
                                    <span>@group.SamplesPerHour checks/h</span>
                                    <span>@group.EstimatedBytesPerHourText / h</span>
                                    <span>@group.EstimatedBytesPerDayText / d</span>
                                </div>
                                <div class="probe-usage-load-bar" style="width:100%">
                                    <span style="width:@group.RelativeLoadPercent.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                                </div>
                            </div>
                            <div class="probe-usage-group-side">
                                <strong>@group.RelativeLoadPercent.ToString("0.#", CultureInfo.InvariantCulture)%</strong>
                                <span class="panel-hint">group share</span>
                            </div>
                        </summary>

                        <div class="probe-usage-group-table-wrap">
                            <table class="probe-usage-table probe-usage-sensor-table">
                                <colgroup>
                                    <col class="probe-usage-col-sensor" />
                                    <col class="probe-usage-col-state" />
                                    <col class="probe-usage-col-schedule" />
                                    <col class="probe-usage-col-load" />
                                    <col class="probe-usage-col-traffic" />
                                    <col class="probe-usage-col-actions" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Sensor</th>
                                        <th>Status</th>
                                        <th>Interval</th>
                                        <th>Load</th>
                                        <th>Data</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sensor in group.Sensors)
                                    {
                                        <tr class="probe-usage-table-row" data-state="@sensor.StateKey" data-level="@sensor.UsageLevelKey">
                                            <td class="probe-usage-cell-main">
                                                <div class="probe-usage-cell-title-row">
                                                    <strong>@sensor.Name</strong>
                                                    @if (sensor.IsHighlighted)
                                                    {
                                                        <span class="highlight-pill">@MatmonIcons.Render("star")<span>Highlight</span></span>
                                                        }
                                                    </div>
                                                    <div class="probe-usage-cell-detail-line">
                                                        <small class="probe-usage-cell-path" title="@sensor.Path">@sensor.Path</small>
                                                        @if (!string.IsNullOrWhiteSpace(sensor.Target))
                                                        {
                                                            <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                                            <small class="probe-usage-cell-target" title="@sensor.Target">Target: @sensor.Target</small>
                                                        }
                                                        <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                                        <small class="probe-usage-cell-summary" title="@sensor.SensorTypeLabel">@sensor.SensorTypeLabel</small>
                                                    </div>
                                            </td>
                                            <td class="probe-usage-cell-state">
                                                <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-state">
                                                    <span class="state-pill" data-state="@sensor.StateKey">@sensor.StateLabel</span>
                                                    <span class="usage-level-pill" data-level="@sensor.UsageLevelKey">@sensor.UsageLevelLabel</span>
                                                    @if (!string.IsNullOrWhiteSpace(sensor.StateMessage))
                                                    {
                                                        <small class="probe-usage-cell-inline-note" title="@sensor.StateMessage">@sensor.StateMessage</small>
                                                    }
                                                </div>
                                            </td>
                                            <td class="probe-usage-cell-schedule">
                                                <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-schedule">
                                                    <strong>@sensor.ScheduleSummary</strong>
                                                    <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                                    <small>Last @sensor.LastSeenText</small>
                                                </div>
                                            </td>
                                            <td class="probe-usage-cell-load">
                                                <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-load">
                                                    <strong>@sensor.RelativeLoadPercent.ToString("0.#", CultureInfo.InvariantCulture)%</strong>
                                                    <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                                    <small>@sensor.SamplesPerHourText checks/h</small>
                                                    <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                                    <small>@sensor.AverageDurationText avg</small>
                                                </div>
                                                <div class="probe-usage-load-bar">
                                                    <span style="width:@sensor.RelativeLoadPercent.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                                                </div>
                                            </td>
                                            <td class="probe-usage-cell-traffic">
                                                <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-traffic">
                                                    <strong>@sensor.EstimatedBytesPerHourText / h</strong>
                                                    <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                                    <small>@sensor.EstimatedBytesPerDayText / d</small>
                                                </div>
                                            </td>
                                            <td class="probe-usage-cell-actions">
                                                <div class="workspace-row-actions probe-usage-sensor-actions">
                                                    <a class="workspace-action-link" title="Details" aria-label="Details" asp-page="/SensorDetails" asp-route-sensorId="@sensor.SensorId" asp-route-window="1d">
                                                        @MatmonIcons.Render("chart")
                                                        <span>Details</span>
                                                    </a>
                                                    <a class="workspace-action-link" title="Edit" aria-label="Edit" asp-page="/ElementEditor" asp-route-selectedId="@sensor.SensorId" asp-route-returnUrl="@Model.CurrentUrl">
                                                        @MatmonIcons.Render("pencil")
                                                        <span>Edit</span>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="probe-usage-table-wrap">
                <table class="probe-usage-table probe-usage-flat-table">
                    <colgroup>
                        <col class="probe-usage-col-sensor" />
                        <col class="probe-usage-col-state" />
                        <col class="probe-usage-col-schedule" />
                        <col class="probe-usage-col-load" />
                        <col class="probe-usage-col-traffic" />
                        <col class="probe-usage-col-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Sensor</th>
                            <th>Status</th>
                            <th>Interval</th>
                            <th>Load</th>
                            <th>Data</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sensor in Model.View.Sensors)
                        {
                            <tr class="probe-usage-table-row" data-state="@sensor.StateKey" data-level="@sensor.UsageLevelKey">
                                <td class="probe-usage-cell-main">
                                <div class="probe-usage-cell-title-row">
                                    <strong>@sensor.Name</strong>
                                    @if (sensor.IsHighlighted)
                                    {
                                        <span class="highlight-pill">@MatmonIcons.Render("star")<span>Highlight</span></span>
                                    }
                                </div>
                                    <div class="probe-usage-cell-detail-line">
                                        <small class="probe-usage-cell-path" title="@sensor.Path">@sensor.Path</small>
                                        @if (!string.IsNullOrWhiteSpace(sensor.Target))
                                        {
                                            <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                            <small class="probe-usage-cell-target" title="@sensor.Target">Target: @sensor.Target</small>
                                        }
                                        <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                        <small class="probe-usage-cell-summary" title="@sensor.SensorTypeLabel">@sensor.SensorTypeLabel</small>
                                    </div>
                                </td>
                                <td class="probe-usage-cell-state">
                                    <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-state">
                                        <span class="state-pill" data-state="@sensor.StateKey">@sensor.StateLabel</span>
                                        <span class="usage-level-pill" data-level="@sensor.UsageLevelKey">@sensor.UsageLevelLabel</span>
                                        @if (!string.IsNullOrWhiteSpace(sensor.StateMessage))
                                        {
                                            <small class="probe-usage-cell-inline-note" title="@sensor.StateMessage">@sensor.StateMessage</small>
                                        }
                                    </div>
                                </td>
                                <td class="probe-usage-cell-schedule">
                                    <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-schedule">
                                        <strong>@sensor.ScheduleSummary</strong>
                                        <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                        <small>Last @sensor.LastSeenText</small>
                                    </div>
                                </td>
                                <td class="probe-usage-cell-load">
                                    <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-load">
                                        <strong>@sensor.RelativeLoadPercent.ToString("0.#", CultureInfo.InvariantCulture)%</strong>
                                        <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                        <small>@sensor.SamplesPerHourText checks/h</small>
                                        <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                        <small>@sensor.AverageDurationText avg</small>
                                    </div>
                                    <div class="probe-usage-load-bar">
                                        <span style="width:@sensor.RelativeLoadPercent.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                                    </div>
                                </td>
                                <td class="probe-usage-cell-traffic">
                                    <div class="probe-usage-cell-inline-line probe-usage-cell-inline-line-traffic">
                                        <strong>@sensor.EstimatedBytesPerHourText / h</strong>
                                        <span class="probe-usage-cell-dot">@Html.Raw("&middot;")</span>
                                        <small>@sensor.EstimatedBytesPerDayText / d</small>
                                    </div>
                                </td>
                                <td class="probe-usage-cell-actions">
                                    <div class="workspace-row-actions probe-usage-sensor-actions">
                                        <a class="workspace-action-link" title="Details" aria-label="Details" asp-page="/SensorDetails" asp-route-sensorId="@sensor.SensorId" asp-route-window="1d">
                                            @MatmonIcons.Render("chart")
                                            <span>Details</span>
                                        </a>
                                        <a class="workspace-action-link" title="Edit" aria-label="Edit" asp-page="/ElementEditor" asp-route-selectedId="@sensor.SensorId" asp-route-returnUrl="@Model.CurrentUrl">
                                            @MatmonIcons.Render("pencil")
                                            <span>Edit</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

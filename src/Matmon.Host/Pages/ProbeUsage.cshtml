@page "/monitoring/probe/{probeElementId:guid}/usage"
@model ProbeUsageModel
@using System.Globalization
@{
    var view = Model.View;
    ViewData["Title"] = $"{view.Name} usage";
    ViewData["OwnHead"] = true;
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("Probes", "/Probes"), new BreadcrumbItem($"{view.Name} usage") };
    var isGroupedView = string.Equals(view.ViewMode, "grouped", StringComparison.OrdinalIgnoreCase);
    var request = HttpContext.Request;
    var usageActive = !string.Equals(view.UsageFilter, "all", StringComparison.OrdinalIgnoreCase);
    var stateActive = !string.Equals(view.StateFilter, "all", StringComparison.OrdinalIgnoreCase);
    var filterCount = (usageActive ? 1 : 0) + (stateActive ? 1 : 0) + (view.HighlightedOnly ? 1 : 0);
    var usageLabels = new Dictionary<string, string> { ["all"] = "All", ["low"] = "Low", ["moderate"] = "Moderate", ["high"] = "High" };
    var stateLabels = new Dictionary<string, string> { ["ok"] = "OK", ["warning"] = "Warning", ["error"] = "Error", ["paused"] = "Paused", ["unknown"] = "Unknown", ["disabled"] = "Disabled" };
    var sortOptions = new (string Value, string Label)[] { ("load", "Load"), ("name", "Name"), ("type", "Type"), ("state", "State"), ("bytes", "Bytes"), ("log", "Log entries") };
    var sortLabel = sortOptions.FirstOrDefault(option => option.Value == view.SortBy).Label ?? "Load";

    string Percent(double value, string format = "0.#") => value.ToString(format, CultureInfo.InvariantCulture);
    var distributionAria = "Load distribution: " + string.Join(", ", view.DistributionSegments.Select(segment => $"{segment.Label} {Percent(segment.Percent)}%"));

    // A sensor type's usage level: low is calm, moderate and high are worth a look (the word is always in the pill).
    string UsagePill(string level) => level switch
    {
        "high" => "mat-pill mat-pill--error",
        "moderate" => "mat-pill mat-pill--warn",
        _ => "mat-pill mat-pill--plain"
    };
    string? UsageTone(string level) => level switch { "high" => "error", "moderate" => "warn", _ => null };

    // The address of this view without one filter: the link of a chip's X.
    string UrlWithout(string key)
    {
        var parts = request.Query
            .Where(kv => !string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase))
            .SelectMany(kv => kv.Value.Select(v => Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(v ?? string.Empty)))
            .ToList();
        return $"{request.PathBase}{request.Path}" + (parts.Count > 0 ? "?" + string.Join("&", parts) : string.Empty);
    }

    // One sensor row - the same in the grouped and the flat table. Async on purpose: markup with an href can bind a tag
    // helper (URL resolution), and a tag helper is awaited.
    async Task RenderSensorRow(ProbeUsageSensorRow sensor, bool grouped)
    {
        var detailsUrl = Url.Page("/SensorDetails", new { sensorId = sensor.SensorId, window = "1d" });
        var editUrl = Url.Page("/ElementEditor", new { selectedId = sensor.SensorId, returnUrl = Model.CurrentUrl });
        <tr class="@(grouped ? "mat-group__item" : null)">
            <td data-label="Sensor" class="mat-table__primary">
                <div class="probe-usage-sensor">
                    <span class="probe-usage-sensor__name">
                        <a href="@detailsUrl">@sensor.Name</a>
                        @if (sensor.IsHighlighted)
                        {
                            <span class="mat-pill mat-pill--accent">Highlight</span>
                        }
                    </span>
                    <span class="probe-usage-cell__note" title="@sensor.Path">@sensor.Path@(string.IsNullOrWhiteSpace(sensor.Target) ? string.Empty : $" · Target: {sensor.Target}") · @sensor.SensorTypeLabel</span>
                </div>
            </td>
            <td data-label="Status">
                <div class="probe-usage-cell">
                    <span class="@MatUi.PillClass(sensor.StateKey)">@sensor.StateLabel</span>
                    @if (!string.IsNullOrWhiteSpace(sensor.StateMessage))
                    {
                        <span class="probe-usage-cell__note" title="@sensor.StateMessage">@sensor.StateMessage</span>
                    }
                </div>
            </td>
            <td data-label="Interval" class="mat-hide-sm">
                <div class="probe-usage-cell">
                    <span>@sensor.ScheduleSummary</span>
                    <span class="probe-usage-cell__note">Last @sensor.LastSeenText</span>
                </div>
            </td>
            <td data-label="Load">
                <div class="probe-usage-cell">
                    <span class="probe-usage-cell__line">
                        <span class="@UsagePill(sensor.UsageLevelKey)">@sensor.UsageLevelLabel</span>
                        <span class="mat-mono">@Percent(sensor.RelativeLoadPercent)%</span>
                    </span>
                    <div class="probe-usage-meter">
                        <div class="mat-meter mat-meter--sm" role="progressbar" aria-valuenow="@Percent(sensor.RelativeLoadPercent, "0")" aria-valuemin="0" aria-valuemax="100" aria-label="Relative load of @sensor.Name"><div class="mat-meter__fill" data-value="@Percent(sensor.RelativeLoadPercent, "0.##")"></div></div>
                    </div>
                    <span class="probe-usage-cell__note">@sensor.SamplesPerHourText checks/h · @sensor.AverageDurationText avg</span>
                </div>
            </td>
            <td data-label="Data">
                <div class="probe-usage-cell">
                    <span class="mat-mono">@sensor.EstimatedBytesPerHourText / h</span>
                    <span class="probe-usage-cell__note mat-mono">@sensor.EstimatedBytesPerDayText / d</span>
                </div>
            </td>
            <td class="mat-table__cell-actions">
                <div class="mat-table__actions">
                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@detailsUrl" aria-label="Details of @sensor.Name" data-tip="Details">@MatUi.Icon("bar-chart")</a>
                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@editUrl" aria-label="Edit @sensor.Name" data-tip="Edit">@MatUi.Icon("edit")</a>
                </div>
            </td>
        </tr>
    }
}

<div class="mat-page__head">
    <div class="mat-page__title">
        <h1>@view.Name usage</h1>
        <p class="mat-page__sub"><span class="@MatUi.PillClass(view.StatusKey)">@view.StatusLabel</span> @view.StatusMessage · @view.RoleLabel · probe <span class="mat-mono">@view.ProbeId</span> · @view.Path</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<div class="mat-stack">
    <div class="mat-grid mat-grid--3">
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Bytes per second</span>
                <span class="mat-stat__value">@view.EstimatedBytesPerSecondText</span>
                <span class="mat-stat__delta">estimated</span>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Bytes per hour</span>
                <span class="mat-stat__value">@view.EstimatedBytesPerHourText</span>
                <span class="mat-stat__delta">estimated</span>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Bytes per day</span>
                <span class="mat-stat__value">@view.EstimatedBytesPerDayText</span>
                <span class="mat-stat__delta">estimated</span>
            </div>
        </div>
        <div class="mat-card mat-card--accent" title="Steady-state on-disk footprint once retention has caught up: raw samples over the raw-retention window + downsampled per-channel statistics over their window. Covers the whole probe (ignores filters).">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Probe size at retention</span>
                <span class="mat-stat__value">@view.EstimatedProbeSizeText</span>
                <span class="mat-stat__delta">estimated, all sensors</span>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Storage used</span>
                <span class="mat-stat__value">@view.DataSizeText</span>
                <span class="mat-stat__delta">data directory</span>
            </div>
        </div>
        <div class="mat-card">
            <div class="mat-card__body mat-stat">
                <span class="mat-stat__label">Storage free</span>
                <span class="mat-stat__value">@view.StorageFreeText</span>
                <span class="mat-stat__delta">on its drive</span>
            </div>
        </div>
    </div>
    <p class="mat-muted">Estimates = each sensor's poll rate × payload size × retention. Retention &amp; statistics roll-up run <strong>every 5 minutes</strong>, so disk space is reclaimed shortly after data ages out. The probe-size estimate covers all sensors (ignores the filters below).@(view.FiltersActive ? $" Filtered: the other figures cover the {view.SensorCount} of {view.TotalSensorCount} sensors shown below." : string.Empty)</p>
</div>

<section class="mat-card">
    <div class="mat-card__head">
        @MatUi.Icon("bar-chart")
        <h2 class="mat-card__title">Load distribution</h2>
        <span class="mat-text-muted mm-push-end">@view.DistributionLabel</span>
    </div>
    <div class="mat-card__body mat-stack mat-stack--sm">
        @if (view.DistributionSegments.Count == 0)
        {
            <p class="mat-muted">No visible load data for the current filters.</p>
        }
        else
        {
            <div class="mat-meter mat-meter--lg mat-meter--stack" role="img" aria-label="@distributionAria">
                @foreach (var segment in view.DistributionSegments)
                {
                    <div class="mat-meter__fill" data-value="@Percent(segment.Percent, "0.##")" data-tone="@UsageTone(segment.UsageLevelKey)" title="@segment.Label @Percent(segment.Percent)% - @segment.DetailText"></div>
                }
            </div>
            <div class="mat-row">
                @foreach (var segment in view.DistributionSegments)
                {
                    <span class="@UsagePill(segment.UsageLevelKey)" title="@segment.DetailText">@segment.Label @Percent(segment.Percent)%</span>
                }
            </div>
        }
    </div>
</section>

@if (view.TopLogSensors.Count > 0)
{
    <section class="mat-section">
        <div class="mat-section__head">
            <h2>Largest logs</h2>
            <p class="mat-section__lead">Stored entries per sensor, @view.TotalStoredObservationCountText in total. The sensors with the most stored history - an outlier here usually means an over-fast poll interval or too-long retention, a good place to spot misconfigured sensors.</p>
        </div>
        <div class="mat-table-wrap">
            <table class="mat-table mat-table--compact">
                <caption class="mat-sr-only">The sensors with the most stored history</caption>
                <thead>
                    <tr>
                        <th scope="col">Sensor</th>
                        <th scope="col" class="mat-hide-sm">Type and interval</th>
                        <th scope="col" class="mat-hide-sm">Share</th>
                        <th scope="col" class="mat-num">Entries</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var logSensor in view.TopLogSensors)
                    {
                        <tr>
                            <td data-label="Sensor" class="mat-table__primary"><a asp-page="/SensorDetails" asp-route-sensorId="@logSensor.SensorId" title="@logSensor.Path">@logSensor.Name</a></td>
                            <td data-label="Type and interval" class="mat-hide-sm mat-text-muted">@logSensor.SensorTypeLabel · @logSensor.ScheduleSummary</td>
                            <td data-label="Share" class="mat-hide-sm probe-usage-meter-cell">
                                <div class="probe-usage-meter">
                                    <div class="mat-meter" role="progressbar" aria-valuenow="@Percent(logSensor.RelativeLogPercent, "0")" aria-valuemin="0" aria-valuemax="100" aria-label="Stored entries of @logSensor.Name, compared with the largest log"><div class="mat-meter__fill" data-value="@Percent(logSensor.RelativeLogPercent)" data-tone="@UsageTone(logSensor.UsageLevelKey)"></div></div>
                                </div>
                            </td>
                            <td data-label="Entries" class="mat-num mat-mono">@logSensor.StoredObservationCountText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="mat-section">
    <div class="mat-section__head">
        <h2>@(isGroupedView ? "Sensor groups" : "Sensors")</h2>
        <p class="mat-section__lead">@view.SensorCount of @view.TotalSensorCount sensors in @view.GroupCount of @view.TotalGroupCount groups</p>
    </div>

    <div class="mat-list">
        <div class="mat-toolbar" role="toolbar" aria-label="Sensor tools">
            <div class="mat-input-icon mat-toolbar__search">
                @MatUi.Icon("search")
                <input class="mat-input" type="search" id="usage-q" name="search" form="usage-form" value="@view.Search" placeholder="Name, path, target, type"
                       aria-label="Search the sensors" autocomplete="off" enterkeyhint="search" data-shortcut="/" />
            </div>
            <span class="mat-toolbar__spacer"></span>
            <span class="mat-toolbar__info" aria-live="polite">@view.SensorCount of @view.TotalSensorCount sensors</span>
            <div class="mat-toolbar__end">
                <div class="mat-seg" role="group" aria-label="View">
                    <a class="mat-seg__btn@(isGroupedView ? " is-active" : string.Empty)" aria-current="@(isGroupedView ? "true" : null)"
                       asp-page="/ProbeUsage"
                       asp-route-probeElementId="@Model.ProbeElementId"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       asp-route-viewMode="grouped"
                       asp-route-search="@view.Search"
                       asp-route-usageFilter="@view.UsageFilter"
                       asp-route-sortBy="@view.SortBy"
                       asp-route-highlightedOnly="@view.HighlightedOnly">Grouped</a>
                    <a class="mat-seg__btn@(!isGroupedView ? " is-active" : string.Empty)" aria-current="@(!isGroupedView ? "true" : null)"
                       asp-page="/ProbeUsage"
                       asp-route-probeElementId="@Model.ProbeElementId"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       asp-route-viewMode="table"
                       asp-route-search="@view.Search"
                       asp-route-usageFilter="@view.UsageFilter"
                       asp-route-sortBy="@view.SortBy"
                       asp-route-highlightedOnly="@view.HighlightedOnly">Table</a>
                </div>
                <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn@(filterCount > 0 ? " is-active" : string.Empty)" data-dialog-open="usage-filter" aria-haspopup="dialog">
                    @MatUi.Icon("sliders")<span>Filter</span>@if (filterCount > 0) { <span class="mat-badge">@filterCount</span> }
                </button>
                <button type="button" class="mat-btn mat-btn--ghost mat-toolbar__btn@(view.SortBy != "load" ? " is-active" : string.Empty)" data-dialog-open="usage-sort" aria-haspopup="dialog">
                    @MatUi.Icon("sort")<span>Sort</span><small>@sortLabel</small>
                </button>
            </div>
        </div>

        @if (filterCount > 0)
        {
            <div class="mat-chips" role="group" aria-label="Filters in effect">
                @if (usageActive)
                {
                    <span class="mat-chip">Usage: @usageLabels.GetValueOrDefault(view.UsageFilter, view.UsageFilter)<a class="mat-chip__x" href="@UrlWithout("usageFilter")" aria-label="Remove the filter Usage">@MatUi.Icon("x")</a></span>
                }
                @if (stateActive)
                {
                    <span class="mat-chip">State: @stateLabels.GetValueOrDefault(view.StateFilter, view.StateFilter)<a class="mat-chip__x" href="@UrlWithout("stateFilter")" aria-label="Remove the filter State">@MatUi.Icon("x")</a></span>
                }
                @if (view.HighlightedOnly)
                {
                    <span class="mat-chip">Highlighted only<a class="mat-chip__x" href="@UrlWithout("highlightedOnly")" aria-label="Remove the filter Highlighted only">@MatUi.Icon("x")</a></span>
                }
            </div>
        }

        @if (view.SensorCount == 0)
        {
            if (view.TotalSensorCount == 0)
            {
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("activity")</span>
                    <div class="mat-empty__title">No sensors on this probe yet</div>
                    <p>Its usage shows here once sensors run on it.</p>
                </div>
            }
            else
            {
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("search")</span>
                    <div class="mat-empty__title">Nothing matches</div>
                    <p>No sensors match the current filters. Change the search or the filters, or reset them.</p>
                    <a class="mat-btn mat-btn--secondary" asp-page="/ProbeUsage" asp-route-probeElementId="@Model.ProbeElementId" asp-route-returnUrl="@Model.ReturnUrl" asp-route-viewMode="@view.ViewMode">@MatUi.Icon("refresh")<span>Reset</span></a>
                </div>
            }
        }
        else if (isGroupedView)
        {
            <div class="mat-table-wrap">
                <table class="mat-table" id="usage-groups" data-groups="probe-usage">
                    <caption class="mat-sr-only">Sensors grouped by sensor type, with their estimated load and data</caption>
                    <thead>
                        <tr>
                            <th scope="col"><span class="mat-row mat-row--nowrap">Sensor <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-groups-set="toggle" data-groups-target="#usage-groups" aria-label="Open or close all groups" data-tip="Open or close all">@MatUi.Icon("chevron-down")</button></span></th>
                            <th scope="col">Status</th>
                            <th scope="col" class="mat-hide-sm">Interval</th>
                            <th scope="col">Load</th>
                            <th scope="col">Data</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    @foreach (var group in view.Groups)
                    {
                        <tbody class="mat-group@(group.IsExpanded ? string.Empty : " is-collapsed")" data-group="@group.SensorTypeKey">
                            <tr class="mat-group__head">
                                <td class="mat-group__cell" colspan="6">
                                    <div class="mat-group__bar">
                                        <button type="button" class="mat-group__toggle" data-group-toggle aria-expanded="@(group.IsExpanded ? "true" : "false")">
                                            @MatUi.Icon("chevron-down", "mat-group__chev")
                                            <span class="mat-group__title">@group.SensorTypeLabel</span>
                                            <span class="mat-badge mat-badge--soft">@group.SensorCount<span class="mat-sr-only"> sensors</span></span>
                                        </button>
                                        <span class="probe-usage-group-facts">
                                            <span class="@UsagePill(group.UsageLevelKey)">@group.UsageLevelLabel</span>
                                            <span class="mat-hide-sm">@group.SamplesPerHour checks/h · @group.EstimatedBytesPerHourText / h · @group.EstimatedBytesPerDayText / d</span>
                                            <span class="mat-mono" title="The group's share of the load shown">@Percent(group.RelativeLoadPercent)%</span>
                                        </span>
                                    </div>
                                </td>
                            </tr>
                            @foreach (var sensor in group.Sensors)
                            {
                                await RenderSensorRow(sensor, true);
                            }
                        </tbody>
                    }
                </table>
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Sensors with their estimated load and data</caption>
                    <thead>
                        <tr>
                            <th scope="col">Sensor</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="mat-hide-sm">Interval</th>
                            <th scope="col">Load</th>
                            <th scope="col">Data</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sensor in view.Sensors)
                        {
                            await RenderSensorRow(sensor, false);
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* The toolbar's ONE hidden GET form: the search field and both dialogs point at it (form="usage-form"), so whatever is
       applied sends the whole state. A state filter (only reachable by its address) is kept until its chip removes it. *@
    <form id="usage-form" method="get" hidden>
        <input type="hidden" name="probeElementId" value="@Model.ProbeElementId" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <input type="hidden" name="viewMode" value="@view.ViewMode" />
        @if (stateActive)
        {
            <input type="hidden" name="stateFilter" value="@view.StateFilter" />
        }
    </form>

    <dialog class="mat-dialog mat-dialog--sm" id="usage-filter" aria-labelledby="usage-filter-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @MatUi.Icon("sliders")
                <h2 class="mat-dialog__title" id="usage-filter-title">Filter</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <div class="mat-field">
                    <label class="mat-label" for="usage-f-usage">Usage</label>
                    <select class="mat-select" id="usage-f-usage" name="usageFilter" form="usage-form">
                        @foreach (var option in usageLabels)
                        {
                            <option value="@option.Key" selected="@(view.UsageFilter == option.Key)">@option.Value</option>
                        }
                    </select>
                </div>
                <div class="mat-field">
                    <label class="mat-check"><input type="checkbox" id="usage-f-highlighted" name="highlightedOnly" value="true" form="usage-form" checked="@view.HighlightedOnly" /><span class="mat-check__text">Highlighted only</span></label>
                </div>
                @if (!string.IsNullOrWhiteSpace(view.Search))
                {
                    <p class="mat-hint">The search in effect is kept.</p>
                }
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" form="usage-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sliders")<span>Apply</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    <span class="mat-btn-row__spacer"></span>
                    <a class="mat-btn mat-btn--ghost mat-btn--end" asp-page="/ProbeUsage" asp-route-probeElementId="@Model.ProbeElementId" asp-route-returnUrl="@Model.ReturnUrl" asp-route-viewMode="@view.ViewMode">Reset everything</a>
                </div>
            </div>
        </div>
    </dialog>

    <dialog class="mat-dialog mat-dialog--sm" id="usage-sort" aria-labelledby="usage-sort-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @MatUi.Icon("sort")
                <h2 class="mat-dialog__title" id="usage-sort-title">Sort</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@MatUi.Icon("x")</button>
            </div>
            <div class="mat-dialog__body mat-form">
                <fieldset class="mat-field mat-fieldset">
                    <legend class="mat-label">Sort by</legend>
                    <div class="mat-options">
                        @foreach (var option in sortOptions)
                        {
                            <label class="mat-option"><input type="radio" id="usage-sort-@option.Value" name="sortBy" value="@option.Value" form="usage-form" checked="@(view.SortBy == option.Value)" /><span>@option.Label</span></label>
                        }
                    </div>
                </fieldset>
            </div>
            <div class="mat-dialog__foot">
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" form="usage-form" class="mat-btn mat-btn--primary">@MatUi.Icon("sort")<span>Apply</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-dialog-close>Cancel</button>
                    <span class="mat-btn-row__spacer"></span>
                    <a class="mat-btn mat-btn--ghost mat-btn--end" href="@UrlWithout("sortBy")">Default order</a>
                </div>
            </div>
        </div>
    </dialog>
</section>

@page "/monitoring/sensor/new"
@model WorkspaceModel
@{
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
    var sensorCredentialFields = Model.NewSensor.SensorParameterFields.Where(field => field.IsCredential).ToList();
    var matchingTemplateCount = Model.NewSensor.TemplateOptions.Count(option => !string.IsNullOrWhiteSpace(option.Value));
    var isSnmpType = string.Equals(Model.NewSensor.SensorTypeKey, SnmpSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.NewSensor.SensorTypeKey, SynologyNasSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase);
    var assistantUrl = $"{Request.PathBase}/monitoring/sensor/assistant?selectedId={Model.NewSensor.ParentId}&selectedTemplateId={Model.NewSensor.TemplateId}&returnUrl={Uri.EscapeDataString(backUrl)}";
    ViewData["Title"] = "New sensor";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<form method="post" asp-page-handler="CreateSensor" class="mat-form" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="NewSensor.NameAutoGenerated" data-sensor-name-auto />

    @* The tabs remember themselves in the address, and initializeTabHashOnSubmit carries the open one through the
       Test / Preview / Walk re-posts. The partials draw their own panels (panel-credentials, -thresholds, -schedule);
       the parameters panel is drawn here because the SNMP walk belongs to it. *@
    <div data-tabs data-tab-hash>
        <div class="mat-tabs" role="tablist" aria-label="Sensor">
            <button type="button" class="mat-tab" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="true">General</button>
            <button type="button" class="mat-tab" role="tab" id="tab-parameters" aria-controls="panel-parameters" aria-selected="false" tabindex="-1">Parameters</button>
            @if (sensorCredentialFields.Count > 0)
            {
                <button type="button" class="mat-tab" role="tab" id="tab-credentials" aria-controls="panel-credentials" aria-selected="false" tabindex="-1">Credentials</button>
            }
            <button type="button" class="mat-tab" role="tab" id="tab-thresholds" aria-controls="panel-thresholds" aria-selected="false" tabindex="-1">Channels</button>
            <button type="button" class="mat-tab" role="tab" id="tab-schedule" aria-controls="panel-schedule" aria-selected="false" tabindex="-1">Schedule</button>
        </div>

        @* ---------- GENERAL ---------- *@
        <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-general" aria-labelledby="tab-general">
            <section class="mat-card">
                <div class="mat-card__head">
                    @MatUi.Icon("activity")
                    <h2 class="mat-card__title">Sensor</h2>
                    <a class="mat-btn mat-btn--ghost mat-btn--sm mm-push-end" href="@assistantUrl">@MatUi.Icon("sparkles")<span>Assistant</span></a>
                </div>
                <div class="mat-card__body mat-stack">
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" asp-for="NewSensor.SensorTypeKey">Type</label>
                            <select asp-for="NewSensor.SensorTypeKey" class="mat-select" asp-items="Model.View.SensorTypeOptions" data-sensor-type-select></select>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" asp-for="NewSensor.TemplateId">Template <span class="mat-opt">(optional)</span></label>
                            <select asp-for="NewSensor.TemplateId" class="mat-select" asp-items="Model.NewSensor.TemplateOptions" data-sensor-template-select></select>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" asp-for="NewSensor.Name">Name</label>
                            <input asp-for="NewSensor.Name" class="mat-input" placeholder="Sensor name" data-sensor-name-input />
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="picker-sensor-parent-trigger">Parent</label>
                            <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewSensor.ParentId", DomId = "picker-sensor-parent", SelectedId = Model.NewSensor.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.SensorParentOptions), ValueAttribute = "data-sensor-parent-select" })" />
                        </div>
                        @if (string.Equals(Model.NewSensor.SensorTypeKey, ProbeHeartbeatSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="mat-field mat-field--full mat-muted">Target: the parent probe.</p>
                        }
                        else
                        {
                            <div class="mat-field mat-field--full">
                                <label class="mat-label" asp-for="NewSensor.Target">Target</label>
                                <input asp-for="NewSensor.Target" class="mat-input mat-mono" placeholder="@Model.NewSensor.TargetPlaceholder" />
                            </div>
                        }
                        <div class="mat-field mat-field--full">
                            <label class="mat-label" asp-for="NewSensor.TagsText">Tags</label>
                            <input asp-for="NewSensor.TagsText" class="mat-input" placeholder="prod, network, berlin" data-tag-input />
                            <partial name="_TagSuggestions" model="Model.View.AllTags" />
                            <span class="mat-hint">Comma-separated.</span>
                        </div>
                    </div>
                    @if (matchingTemplateCount > 0)
                    {
                        <p class="mat-hint">@($"{matchingTemplateCount} matching template{(matchingTemplateCount == 1 ? string.Empty : "s")} available.")</p>
                    }
                </div>
            </section>

            <section class="mat-card">
                <div class="mat-card__head">
                    @MatUi.Icon("settings")
                    <h2 class="mat-card__title">Details</h2>
                </div>
                <div class="mat-card__body">
                    <div class="mat-form__grid">
                        <div class="mat-field mat-field--full">
                            <label class="mat-label" asp-for="NewSensor.Description">Description <span class="mat-opt">(optional)</span></label>
                            <input asp-for="NewSensor.Description" class="mat-input" placeholder="Notes about this sensor" />
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" asp-for="NewSensor.Highlight">Highlight</label>
                            <select asp-for="NewSensor.Highlight" class="mat-select">
                                <option value="">@(string.IsNullOrWhiteSpace(Model.NewSensor.HighlightInheritedLabel) || string.Equals(Model.NewSensor.HighlightInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.NewSensor.HighlightInheritedLabel})")</option>
                                <option value="true">on</option>
                                <option value="false">off</option>
                            </select>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @* ---------- PARAMETERS (+ the SNMP walk) ---------- *@
        <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-parameters" aria-labelledby="tab-parameters" hidden>
            @await Html.PartialAsync("_SensorParameters", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" }, ["SensorEditorPanels"] = false })

            @if (isSnmpType)
            {
                <section class="mat-card sensor-snmp-section">
                    <div class="mat-card__head">
                        @MatUi.Icon("network")
                        <h2 class="mat-card__title">Walk</h2>
                        <span class="mat-text-muted mm-push-end">SNMP v1 / v2c / v3</span>
                    </div>
                    <div class="mat-card__body mat-stack">
                        <p class="mat-muted">Tick the values to monitor; they are copied into <code>snmp.oids</code>.</p>
                        <div class="mat-field sensor-snmp-mib-root">
                            <label class="mat-label" for="snmp-walk-mib-root">From a MIB <span class="mat-text-muted">(optional)</span></label>
                            <div class="mat-picker" data-picker="select" data-source-url="@Url.Page(null, "MibRoots")" data-placeholder="Pick a MIB or one of its groups" data-snmp-mib-root>
                                <input class="mat-picker__input" id="snmp-walk-mib-root" />
                                <div class="mat-picker__options" hidden></div>
                            </div>
                            <span class="mat-hint">Sets the Root OID, so the walk reads only what that MIB describes.</span>
                        </div>
                        <div class="mat-field sensor-snmp-root">
                            <label class="mat-label" asp-for="NewSensor.SnmpWalkRootOid">Root OID</label>
                            <div class="mat-input-group">
                                <input asp-for="NewSensor.SnmpWalkRootOid" class="mat-input mat-mono" placeholder="1.3.6.1.2.1" />
                                <button type="submit" asp-page-handler="DiscoverSnmp" formnovalidate class="mat-btn mat-btn--secondary">@MatUi.Icon("search")<span>Walk</span></button>
                            </div>
                        </div>
                        <partial name="_SnmpWalkList" model="Model" />
                    </div>
                </section>
            }
        </div>

        @await Html.PartialAsync("_SensorCredentials", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

        @await Html.PartialAsync("_SensorThresholds", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

        @await Html.PartialAsync("_SensorSchedule", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })
    </div>

    <partial name="_RemoteRunPreview" model="Model" />

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create</span></button>
        <button type="submit" asp-page-handler="RunSensorNow" formnovalidate class="mat-btn mat-btn--secondary">@MatUi.Icon("play")<span>Test</span></button>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
    <button type="submit" asp-page-handler="PreviewSensorFields" formnovalidate hidden data-sensor-preview-submit>Preview</button>
</form>

@page "/monitoring/sensor/new"
@model WorkspaceModel
@{
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
    var hasFixedChannels = Model.NewSensor.SensorChannelMode == SensorChannelMode.Fixed;
    var sensorCredentialFields = Model.NewSensor.SensorParameterFields.Where(field => field.IsCredential).ToList();
    var matchingTemplateCount = Model.NewSensor.TemplateOptions.Count(option => !string.IsNullOrWhiteSpace(option.Value));
    ViewData["Title"] = "Sensor";
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("sensor")
            <h1>Sensor</h1>
        </div>
        <div class="workspace-inline-actions">
            <a class="workspace-action-link" href="@($"{Request.PathBase}/monitoring/sensor/assistant?selectedId={Model.NewSensor.ParentId}&selectedTemplateId={Model.NewSensor.TemplateId}&returnUrl={Uri.EscapeDataString(backUrl)}")">
                @MatmonIcons.Render("spark")
                <span>Assistant</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-panel">
        <form method="post" asp-page-handler="CreateSensor" class="workspace-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="NewSensor.NameAutoGenerated" data-sensor-name-auto />

            <div class="sensor-tabs" data-sensor-tabs role="tablist">
                <button type="button" class="sensor-tab" data-sensor-tab-target="general" role="tab">@MatmonIcons.Render("sensor")<span>General</span></button>
                <button type="button" class="sensor-tab" data-sensor-tab-target="parameters" role="tab">@MatmonIcons.Render("settings")<span>Parameters</span></button>
                @if (sensorCredentialFields.Count > 0)
                {
                    <button type="button" class="sensor-tab" data-sensor-tab-target="credentials" role="tab">@MatmonIcons.Render("key")<span>Credentials</span></button>
                }
                <button type="button" class="sensor-tab" data-sensor-tab-target="thresholds" role="tab">@MatmonIcons.Render("signal")<span>Channels</span></button>
                <button type="button" class="sensor-tab" data-sensor-tab-target="schedule" role="tab">@MatmonIcons.Render("clock")<span>Schedule</span></button>
            </div>

            <div class="sensor-overview-section workspace-span-2" data-sensor-tab="general">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("sensor")<span>Sensor</span></h2>
                    <span class="panel-hint">type, name &amp; target</span>
                </div>
                <div class="workspace-form-grid workspace-core-grid">
                    <label>
                        <span>Type</span>
                        <select asp-for="NewSensor.SensorTypeKey" class="form-select workspace-select" asp-items="Model.View.SensorTypeOptions" data-sensor-type-select></select>
                    </label>
                    <label>
                        <span>Template <em>optional</em></span>
                        <select asp-for="NewSensor.TemplateId" class="form-select workspace-select" asp-items="Model.NewSensor.TemplateOptions" data-sensor-template-select></select>
                    </label>
                    <label>
                        <span>Name</span>
                        <input asp-for="NewSensor.Name" class="form-control workspace-input" placeholder="Sensor name" data-sensor-name-input />
                    </label>
                    <label>
                        <span>Parent</span>
                        <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewSensor.ParentId", DomId = "picker-sensor-parent", SelectedId = Model.NewSensor.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.SensorParentOptions), ValueAttribute = "data-sensor-parent-select" })" />
                    </label>
                    @if (string.Equals(Model.NewSensor.SensorTypeKey, ProbeHeartbeatSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="workspace-span-2 workspace-inline-note">Target is auto-filled from the parent probe for heartbeat sensors.</div>
                    }
                    else
                    {
                        <label class="workspace-span-2">
                            <span>Target</span>
                            <input asp-for="NewSensor.Target" class="form-control workspace-input" placeholder="@Model.NewSensor.TargetPlaceholder" />
                        </label>
                    }
                    <label class="workspace-span-2">
                        <span>Tags</span>
                        <input asp-for="NewSensor.TagsText" class="form-control workspace-input" placeholder="prod, network, berlin" data-tag-input />
                        <partial name="_TagSuggestions" model="Model.View.AllTags" />
                        <small class="workspace-field-hint">Comma-separated. Tags cascade to children and power tree filtering, maps &amp; the sensor picker.</small>
                    </label>
                </div>
                <div class="workspace-hint">
                    @(matchingTemplateCount == 0
                        ? "The name is generated from the type - change the type and it updates, unless you edit the name yourself."
                        : $"{matchingTemplateCount} matching template{(matchingTemplateCount == 1 ? string.Empty : "s")} available; choosing one copies its values in and remembers it as the origin (you can restore from it later).")
                </div>
            </div>

            @await Html.PartialAsync("_SensorCredentials", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

            @await Html.PartialAsync("_SensorParameters", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

            @if (string.Equals(Model.NewSensor.SensorTypeKey, SnmpSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(Model.NewSensor.SensorTypeKey, SynologyNasSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase))
            {
                <div class="workspace-span-2 sensor-snmp-section" data-sensor-tab="parameters">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("network")<span>Walk</span></h2>
                        <span class="panel-hint">snmp v1 / v2c / v3</span>
                    </div>
                    <div class="workspace-inline-note">Discover OIDs on the target, then tick the values you want to monitor. Selected OIDs are copied into <code>snmp.oids</code>. SNMPv3 fields appear in the parameter block above.</div>

                    <div class="workspace-form-grid sensor-snmp-toolbar">
                        <label>
                            <span>Root OID</span>
                            <input asp-for="NewSensor.SnmpWalkRootOid" class="form-control workspace-input" placeholder="1.3.6.1.2.1" />
                        </label>
                        <div class="workspace-form-actions workspace-span-2">
                            <button type="submit" asp-page-handler="DiscoverSnmp" formnovalidate class="workspace-secondary-submit">
                                @MatmonIcons.Render("search")
                                <span>Walk</span>
                            </button>
                        </div>
                    </div>

                    @if (Model.NewSensor.SnmpWalkItems.Count > 0)
                    {
                        <div class="snmp-walk-list">
                            @for (var i = 0; i < Model.NewSensor.SnmpWalkItems.Count; i++)
                            {
                                var item = Model.NewSensor.SnmpWalkItems[i];
                                <label class="snmp-walk-row @(item.IsNumeric ? "is-numeric" : "is-text")">
                                    <input type="hidden" asp-for="NewSensor.SnmpWalkItems[i].Oid" />
                                    <input type="hidden" asp-for="NewSensor.SnmpWalkItems[i].Syntax" />
                                    <input type="hidden" asp-for="NewSensor.SnmpWalkItems[i].Value" />
                                    <input type="hidden" asp-for="NewSensor.SnmpWalkItems[i].IsNumeric" />
                                    <input asp-for="NewSensor.SnmpWalkItems[i].Selected" type="checkbox" class="form-check-input" />
                                    <div class="snmp-walk-main">
                                        <div class="snmp-walk-oid">@item.Oid</div>
                                        <div class="snmp-walk-value">@item.Value</div>
                                    </div>
                                    <div class="snmp-walk-meta">
                                        <span class="snmp-walk-type">@item.Syntax</span>
                                        @if (item.IsNumeric)
                                        {
                                            <span class="sensor-required">numeric</span>
                                        }
                                    </div>
                                </label>
                            }
                        </div>
                    }
                </div>
            }

            @await Html.PartialAsync("_SensorSchedule", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

            @await Html.PartialAsync("_SensorThresholds", Model.NewSensor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "NewSensor" } })

            <div class="sensor-overview-section workspace-span-2" data-sensor-tab="general">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("settings")<span>Details</span></h2>
                    <span class="panel-hint">optional</span>
                </div>
                <div class="workspace-form-grid">
                    <label class="workspace-span-2">
                        <span>Description <em>optional</em></span>
                        <input asp-for="NewSensor.Description" class="form-control workspace-input" placeholder="Notes about this sensor" />
                    </label>
                    <label>
                        <span>Highlight</span>
                        <select asp-for="NewSensor.Highlight" class="form-select workspace-select">
                            <option value="">@(string.IsNullOrWhiteSpace(Model.NewSensor.HighlightInheritedLabel) || string.Equals(Model.NewSensor.HighlightInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.NewSensor.HighlightInheritedLabel})")</option>
                            <option value="true">on</option>
                            <option value="false">off</option>
                        </select>
                    </label>
                </div>
            </div>

            <div class="workspace-form-actions">
                <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create</span></button>
                <button type="submit" asp-page-handler="RunSensorNow" formnovalidate class="workspace-secondary-submit">@MatmonIcons.Render("spark")<span>Test</span></button>
            </div>
            <partial name="_RemoteRunPreview" model="Model" />
            <button type="submit" asp-page-handler="PreviewSensorFields" formnovalidate class="d-none" data-sensor-preview-submit>Preview</button>
        </form>
    </section>
</section>

@page "/system/probes/new"
@model WorkspaceModel
@{
    ViewData["Title"] = "New probe";
    var backUrl = Model.GetSafeReturnUrl("/Config?tab=probes");
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("probe")
            <h1>New probe</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-panel">
        <form method="post" asp-page-handler="CreateProbe" class="workspace-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="workspace-field workspace-field-primary">
                <span class="workspace-label">Probe name</span>
                <input asp-for="NewProbe.Name" class="form-control workspace-input" placeholder="e.g. Remote site probe" autofocus />
            </label>
            <label class="workspace-field">
                <span class="workspace-label">Parent</span>
                <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewProbe.ParentId", DomId = "picker-probe-parent", SelectedId = Model.NewProbe.ParentId, Placeholder = "Root (no parent)", Options = Model.PickerOptionsFor(Model.View.ProbeParentOptions) })" />
            </label>
            <label class="workspace-field">
                <span class="workspace-label">Description <em>optional</em></span>
                <input asp-for="NewProbe.Description" class="form-control workspace-input" placeholder="Notes about this probe" />
            </label>
            <div class="workspace-form-actions">
                <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create probe</span></button>
            </div>
        </form>
    </section>
</section>

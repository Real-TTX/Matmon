@page "/system/probes/new"
@model WorkspaceModel
@{
    ViewData["Title"] = "New probe";
    ViewData["Width"] = "narrow";
    var backUrl = Model.GetSafeReturnUrl("/Probes");
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<form method="post" asp-page-handler="CreateProbe" class="mat-form" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("server")<h2 class="mat-card__title">Probe</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-field">
                <label class="mat-label" asp-for="NewProbe.Name">Probe name</label>
                <input asp-for="NewProbe.Name" class="mat-input" placeholder="e.g. Remote site probe" autofocus />
            </div>
            <div class="mat-field" role="group" aria-labelledby="probe-parent-label">
                <span class="mat-label" id="probe-parent-label">Parent</span>
                <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewProbe.ParentId", DomId = "picker-probe-parent", SelectedId = Model.NewProbe.ParentId, Placeholder = "Root (no parent)", Options = Model.PickerOptionsFor(Model.View.ProbeParentOptions) })" />
            </div>
            <div class="mat-field">
                <label class="mat-label" asp-for="NewProbe.Description">Description <span class="mat-text-muted">(optional)</span></label>
                <input asp-for="NewProbe.Description" class="mat-input" placeholder="Notes about this probe" />
            </div>
        </div>
    </section>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create probe</span></button>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
</form>

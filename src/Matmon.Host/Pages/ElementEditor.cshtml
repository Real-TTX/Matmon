@page "/monitoring/element"
@model WorkspaceModel
@{
    ViewData["Title"] = "Element";
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
    var isSensor = Model.ElementEditor.Kind == "Sensor";
    var sensorCredentialFields = Model.ElementEditor.SensorParameterFields.Where(field => field.IsCredential).ToList();
    var sensorGeneralFields = Model.ElementEditor.SensorParameterFields.Where(field => !field.IsCredential).ToList();
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("pencil")
            <h1>Element</h1>
        </div>
        @if (isSensor)
        {
            <div class="workspace-inline-actions">
                <a class="workspace-action-link"
                   href="@($"{Request.PathBase}/monitoring/sensor/assistant?selectedId={(Model.ElementEditor.ParentId ?? Model.ElementEditor.Id)}&returnUrl={Uri.EscapeDataString(backUrl)}")">
                    @MatmonIcons.Render("spark")
                    <span>Assistant</span>
                </a>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("pencil")<span>Edit</span></h2>
            <span class="panel-hint">@Model.View.SelectedElementKind</span>
            @if (isSensor && Model.ElementEditor.IsPaused)
            {
                <span class="state-pill" data-state="paused">Paused</span>
            }
        </div>

        @if (Model.ElementEditor.Id == Guid.Empty)
        {
            <div class="empty-state">Select an element.</div>
        }
        else
        {
            <form method="post" asp-page-handler="SaveElement" class="workspace-form">
                <input type="hidden" asp-for="ElementEditor.Id" />
                <input type="hidden" asp-for="ElementEditor.Kind" />

                <div class="sensor-tabs" data-sensor-tabs role="tablist">
                    <button type="button" class="sensor-tab" data-sensor-tab-target="general" role="tab">@MatmonIcons.Render("pencil")<span>General</span></button>
                    @if (isSensor)
                    {
                        <button type="button" class="sensor-tab" data-sensor-tab-target="parameters" role="tab">@MatmonIcons.Render("settings")<span>Parameters</span></button>
                        <button type="button" class="sensor-tab" data-sensor-tab-target="thresholds" role="tab">@MatmonIcons.Render("signal")<span>Thresholds</span></button>
                    }
                    <button type="button" class="sensor-tab" data-sensor-tab-target="schedule" role="tab">@MatmonIcons.Render("clock")<span>Schedule</span></button>
                    <button type="button" class="sensor-tab" data-sensor-tab-target="telemetry" role="tab">@MatmonIcons.Render("chart")<span>Telemetry</span></button>
                    <button type="button" class="sensor-tab" data-sensor-tab-target="advanced" role="tab">@MatmonIcons.Render("settings")<span>Advanced</span></button>
                </div>

                @* ---------- GENERAL ---------- *@
                <div class="sensor-overview-section workspace-span-2" data-sensor-tab="general">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("pencil")<span>@Model.View.SelectedElementKind</span></h2>
                        <span class="panel-hint">name, parent &amp; target</span>
                    </div>
                    <div class="workspace-form-grid">
                        <label>
                            <span>Name</span>
                            <input asp-for="ElementEditor.Name" class="form-control workspace-input" />
                        </label>

                        @if (Model.ElementEditor.ParentOptions.Count > 0)
                        {
                            <label class="workspace-span-2">
                                <span>Parent</span>
                                @if (isSensor)
                                {
                                    <select asp-for="ElementEditor.ParentId" class="form-select workspace-select" asp-items="Model.ElementEditor.ParentOptions" data-sensor-parent-select></select>
                                }
                                else
                                {
                                    <select asp-for="ElementEditor.ParentId" class="form-select workspace-select" asp-items="Model.ElementEditor.ParentOptions"></select>
                                }
                            </label>
                        }
                        else
                        {
                            <div class="workspace-span-2 empty-state">Root probe fixed.</div>
                        }

                        @if (Model.ElementEditor.Kind == "Probe")
                        {
                            <label>
                                <span>Probe ID</span>
                                <input asp-for="ElementEditor.ProbeId" class="form-control workspace-input" />
                            </label>
                            <label>
                                <span>Token</span>
                                <input asp-for="ElementEditor.EnrollmentToken" class="form-control workspace-input" />
                            </label>
                            <div class="workspace-span-2">
                                <span class="workspace-label">Snippet</span>
                                <pre class="workspace-code">@Model.ElementEditor.BootstrapSnippet</pre>
                            </div>
                        }

                        @if (Model.ElementEditor.Kind == "Host")
                        {
                            <label class="workspace-span-2">
                                <span>Address</span>
                                <input asp-for="ElementEditor.Address" class="form-control workspace-input" />
                            </label>
                        }

                        @if (isSensor)
                        {
                            <label>
                                <span>Type</span>
                                <select class="form-select workspace-select" asp-items="Model.ElementEditor.SensorTypeOptions" disabled aria-disabled="true" title="The sensor type is fixed after creation"></select>
                                <input type="hidden" asp-for="ElementEditor.SensorTypeKey" />
                                <small class="workspace-field-hint">Fixed after creation — history, channels &amp; statistics all depend on it. Create a new sensor to use a different type.</small>
                            </label>
                            @if (string.Equals(Model.ElementEditor.SensorTypeKey, ProbeHeartbeatSensorExecutor.Definition.Key, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="workspace-span-2 workspace-inline-note">Target is auto-filled from the parent probe for heartbeat sensors.</div>
                            }
                            else
                            {
                                <label>
                                    <span>Target</span>
                                    <input asp-for="ElementEditor.Target" class="form-control workspace-input" placeholder="@Model.ElementEditor.TargetPlaceholder" />
                                </label>
                            }
                        }

                        <label class="workspace-span-2">
                            <span>Description</span>
                            <input asp-for="ElementEditor.Description" class="form-control workspace-input" />
                        </label>

                        @if (isSensor)
                        {
                            <label>
                                <span>Highlight</span>
                                <select asp-for="ElementEditor.Highlight" class="form-select workspace-select">
                                    <option value="">@(string.IsNullOrWhiteSpace(Model.ElementEditor.HighlightInheritedLabel) || string.Equals(Model.ElementEditor.HighlightInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.ElementEditor.HighlightInheritedLabel})")</option>
                                    <option value="true">on</option>
                                    <option value="false">off</option>
                                </select>
                            </label>
                        }

                        <label>
                            <span>Enabled</span>
                            <select asp-for="ElementEditor.EnabledMode" class="form-select workspace-select">
                                <option value="inherit">@(string.IsNullOrWhiteSpace(Model.ElementEditor.EnabledInheritedLabel) || string.Equals(Model.ElementEditor.EnabledInheritedLabel, "inherit", StringComparison.OrdinalIgnoreCase) ? "inherit" : $"inherit ({Model.ElementEditor.EnabledInheritedLabel})")</option>
                                <option value="enabled">enabled</option>
                                <option value="disabled">disabled</option>
                            </select>
                        </label>
                        <label>
                            <span>Timeout</span>
                            <input asp-for="ElementEditor.TimeoutSeconds" type="number" min="1" class="form-control workspace-input" placeholder="@Model.ElementEditor.TimeoutSecondsPlaceholder" />
                        </label>
                        <label>
                            <span>Retries</span>
                            <input asp-for="ElementEditor.RetryCount" type="number" min="0" class="form-control workspace-input" placeholder="@Model.ElementEditor.RetryCountPlaceholder" />
                        </label>
                    </div>
                </div>

                @if (isSensor)
                {
                    @* ---------- PARAMETERS ---------- *@
                    @if (sensorCredentialFields.Count > 0)
                    {
                    <div class="workspace-span-2 sensor-credential-section" data-sensor-tab="parameters">
                        <div class="panel-header">
                            <h2 class="section-title">@MatmonIcons.Render("key")<span>Credentials</span></h2>
                            <span class="panel-hint">auto by type</span>
                        </div>
                        <div class="workspace-inline-note">Auto / inherit uses the first inherited credential with the matching sensor type. Select a specific bundle only when this sensor should override that automatic choice.</div>

                        @if (Model.ElementEditor.CredentialOptions.Count > 0)
                        {
                            <label class="workspace-span-2">
                                <span>Credential selection</span>
                                <select asp-for="ElementEditor.SelectedCredentialId" class="form-select workspace-select" asp-items="Model.ElementEditor.CredentialOptions" data-sensor-credential-select></select>
                            </label>
                        }

                        <div class="sensor-parameter-list">
                            @for (var i = 0; i < Model.ElementEditor.SensorParameterFields.Count; i++)
                            {
                                var field = Model.ElementEditor.SensorParameterFields[i];
                                if (!field.IsCredential)
                                {
                                    continue;
                                }

                                <div class="sensor-parameter-card"
                                     data-sensor-parameter-field
                                     data-parameter-key="@field.Key"
                                     data-visible-when-key="@field.VisibleWhenParameterKey"
                                     data-visible-when-values="@field.VisibleWhenValuesText"
                                     data-inherited-value="@field.InheritedValue"
                                     data-effective-value="@field.EffectiveValue"
                                     hidden="@(!field.IsVisible ? "hidden" : null)">
                                    <input type="hidden" asp-for="ElementEditor.SensorParameterFields[i].Key" />
                                    <div class="sensor-parameter-head">
                                        <div>
                                            <div class="sensor-parameter-name">@field.Label</div>
                                            @if (!string.IsNullOrWhiteSpace(field.Description))
                                            {
                                                <div class="sensor-parameter-help">@field.Description</div>
                                            }
                                        </div>
                                        @if (field.Required)
                                        {
                                            <span class="sensor-required">required</span>
                                        }
                                    </div>

                                    @switch (field.Kind)
                                    {
                                        case SensorParameterKind.ValueList:
                                            <select asp-for="ElementEditor.SensorParameterFields[i].Value" class="form-select workspace-select" asp-items="field.Options"></select>
                                            break;
                                        case SensorParameterKind.Boolean:
                                            <select asp-for="ElementEditor.SensorParameterFields[i].Value" class="form-select workspace-select" asp-items="field.Options"></select>
                                            break;
                                        case SensorParameterKind.Integer:
                                            <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="number" step="@(field.Step ?? "1")" min="@field.Min" max="@field.Max" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                            break;
                                        case SensorParameterKind.Decimal:
                                            <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="number" step="@(field.Step ?? "any")" min="@field.Min" max="@field.Max" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                            break;
                                        case SensorParameterKind.Multiline:
                                            <textarea asp-for="ElementEditor.SensorParameterFields[i].Value" rows="4" class="form-control workspace-textarea" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)"></textarea>
                                            break;
                                        case SensorParameterKind.Secret:
                                            <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="password" autocomplete="off" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                            break;
                                        default:
                                            <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="text" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                            break;
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    }

                    <div class="sensor-parameter-section" data-sensor-tab="parameters">
                        <div class="panel-header">
                            <h2 class="section-title">@MatmonIcons.Render("sensor")<span>Parameters</span></h2>
                            <span class="panel-hint">@Model.ElementEditor.SensorTypeKey</span>
                        </div>
                        <div class="workspace-inline-note">Blank means inherit. Placeholders show the inherited or default value.</div>

                        @if (sensorGeneralFields.Count == 0)
                        {
                            <div class="empty-state">No fields defined.</div>
                        }
                        else
                        {
                            var generalGroups = sensorGeneralFields
                                .Select(f => string.IsNullOrWhiteSpace(f.Group) ? string.Empty : f.Group!.Trim())
                                .Distinct()
                                .ToList();
                            var showGroupTitles = generalGroups.Count > 1 || generalGroups.Any(g => g.Length > 0);

                            foreach (var group in generalGroups)
                            {
                                if (showGroupTitles)
                                {
                                    <div class="sensor-parameter-group-title">@(group.Length == 0 ? "General" : group)</div>
                                }
                                <div class="sensor-parameter-list">
                                    @for (var i = 0; i < Model.ElementEditor.SensorParameterFields.Count; i++)
                                    {
                                        var field = Model.ElementEditor.SensorParameterFields[i];
                                        if (field.IsCredential)
                                        {
                                            continue;
                                        }
                                        var fieldGroup = string.IsNullOrWhiteSpace(field.Group) ? string.Empty : field.Group!.Trim();
                                        if (!string.Equals(fieldGroup, group, StringComparison.Ordinal))
                                        {
                                            continue;
                                        }

                                        <div class="sensor-parameter-card"
                                             data-sensor-parameter-field
                                             data-parameter-key="@field.Key"
                                             data-visible-when-key="@field.VisibleWhenParameterKey"
                                             data-visible-when-values="@field.VisibleWhenValuesText"
                                             data-inherited-value="@field.InheritedValue"
                                             data-effective-value="@field.EffectiveValue"
                                             hidden="@(!field.IsVisible ? "hidden" : null)">
                                            <input type="hidden" asp-for="ElementEditor.SensorParameterFields[i].Key" />
                                            <div class="sensor-parameter-head">
                                                <div>
                                                    <div class="sensor-parameter-name">@field.Label</div>
                                                    @if (!string.IsNullOrWhiteSpace(field.Description))
                                                    {
                                                        <div class="sensor-parameter-help">@field.Description</div>
                                                    }
                                                </div>
                                                @if (field.Required)
                                                {
                                                    <span class="sensor-required">required</span>
                                                }
                                            </div>

                                            @switch (field.Kind)
                                            {
                                                case SensorParameterKind.ValueList:
                                                    <select asp-for="ElementEditor.SensorParameterFields[i].Value" class="form-select workspace-select" asp-items="field.Options"></select>
                                                    break;
                                                case SensorParameterKind.Boolean:
                                                    <select asp-for="ElementEditor.SensorParameterFields[i].Value" class="form-select workspace-select" asp-items="field.Options"></select>
                                                    break;
                                                case SensorParameterKind.Integer:
                                                    <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="number" step="@(field.Step ?? "1")" min="@field.Min" max="@field.Max" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                                    break;
                                                case SensorParameterKind.Decimal:
                                                    <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="number" step="@(field.Step ?? "any")" min="@field.Min" max="@field.Max" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                                    break;
                                                case SensorParameterKind.Multiline:
                                                    <textarea asp-for="ElementEditor.SensorParameterFields[i].Value" rows="4" class="form-control workspace-textarea" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)"></textarea>
                                                    break;
                                                case SensorParameterKind.Secret:
                                                    <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="password" autocomplete="off" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                                    break;
                                                default:
                                                    <input asp-for="ElementEditor.SensorParameterFields[i].Value" type="text" class="form-control workspace-input" placeholder="@(field.DisplayPlaceholder ?? field.Placeholder)" />
                                                    break;
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }

                        <input type="hidden" asp-for="ElementEditor.SensorAdvancedParametersText" />
                    </div>

                    @* ---------- THRESHOLDS ---------- *@
                    @await Html.PartialAsync("_SensorThresholds", Model.ElementEditor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "ElementEditor" } })
                }

                @* ---------- SCHEDULE ---------- *@
                @await Html.PartialAsync("_SensorSchedule", Model.ElementEditor, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "ElementEditor" } })

                @* ---------- TELEMETRY ---------- *@
                <div class="sensor-telemetry-section workspace-span-2" data-sensor-tab="telemetry">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("chart")<span>Telemetry &amp; retention</span></h2>
                        <span class="panel-hint">how long data is kept</span>
                    </div>
                    <p class="workspace-section-intro">
                        Every poll is kept as full-resolution detail for a short window, then continuously
                        summarised into average / min / max plus the 1&nbsp;% and 99&nbsp;% bands and an uptime
                        figure. Raw data answers <em>“what just happened”</em>; the summaries answer
                        <em>“how has this trended”</em> over weeks without storing every sample forever.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.ElementEditor.TelemetryProfileSummary))
                    {
                        <div class="telemetry-profile-pill">@MatmonIcons.Render("spark")<span>@Model.ElementEditor.TelemetryProfileSummary</span></div>
                    }
                    <div class="workspace-inline-note">Leave a field empty to inherit — the placeholder shows the value in effect.</div>
                    <div class="workspace-form-grid">
                        <label>
                            <span>Raw history (days)</span>
                            <input asp-for="ElementEditor.ObservationRetentionDays" type="number" min="1" class="form-control workspace-input" placeholder="@Model.ElementEditor.ObservationRetentionDaysPlaceholder" />
                            <small class="workspace-field-hint">Full-resolution samples behind the live graph.</small>
                        </label>
                        <label>
                            <span>Summary granularity (min)</span>
                            <input asp-for="ElementEditor.StatisticsBucketMinutes" type="number" min="1" list="telemetry-bucket-presets" class="form-control workspace-input" placeholder="@Model.ElementEditor.StatisticsBucketMinutesPlaceholder" />
                            <small class="workspace-field-hint">60 = hourly · 1440 = daily.</small>
                        </label>
                        <label>
                            <span>Summaries kept (days)</span>
                            <input asp-for="ElementEditor.StatisticsRetentionDays" type="number" min="1" class="form-control workspace-input" placeholder="@Model.ElementEditor.StatisticsRetentionDaysPlaceholder" />
                            <small class="workspace-field-hint">Long-term avg / min / max / 1 % / 99 %.</small>
                        </label>
                        <label>
                            <span>Event log (days)</span>
                            <input asp-for="ElementEditor.EventRetentionDays" type="number" min="1" class="form-control workspace-input" placeholder="@Model.ElementEditor.EventRetentionDaysPlaceholder" />
                            <small class="workspace-field-hint">State changes &amp; alerts.</small>
                        </label>
                    </div>
                    <datalist id="telemetry-bucket-presets">
                        <option value="60">Hourly</option>
                        <option value="360">Every 6 hours</option>
                        <option value="720">Every 12 hours</option>
                        <option value="1440">Daily</option>
                    </datalist>

                    @if (isSensor)
                    {
                        <div class="workspace-inline-note workspace-subnote">@MatmonIcons.Render("chart") Graph axis — fix the y-axis for comparable graphs. Leave empty to auto-scale from data (in the channel's native unit).</div>
                        <div class="workspace-form-grid">
                            <label>
                                <span>Y-axis min</span>
                                <input asp-for="ElementEditor.GraphMinValue" type="number" step="any" class="form-control workspace-input" placeholder="auto" />
                            </label>
                            <label>
                                <span>Y-axis max</span>
                                <input asp-for="ElementEditor.GraphMaxValue" type="number" step="any" class="form-control workspace-input" placeholder="auto" />
                            </label>
                        </div>
                    }
                </div>

                @* ---------- ADVANCED ---------- *@
                <div class="sensor-overview-section workspace-span-2" data-sensor-tab="advanced">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("settings")<span>Advanced</span></h2>
                        <span class="panel-hint">templates &amp; raw overrides</span>
                    </div>

                    <div class="workspace-form-grid">
                        <label class="workspace-span-2">
                            <span>Templates</span>
                            <select asp-for="ElementEditor.AppliedTemplateIds" class="form-select workspace-select" asp-items="Model.ElementEditor.TemplateOptions" multiple size="6"></select>
                        </label>
                    </div>

                    @if (isSensor)
                    {
                        <details class="workspace-details workspace-details-nested">
                            <summary>
                                @MatmonIcons.Render("settings")
                                <span>Raw values</span>
                            </summary>
                            <div class="workspace-details-body">
                                <div class="workspace-inline-note">Use this only if you need manual overrides. Blank values keep inheritance intact.</div>
                                <div class="workspace-form-grid">
                                    <label class="workspace-span-2">
                                        <span>Parameters</span>
                                        <textarea asp-for="ElementEditor.ParametersText" rows="4" class="form-control workspace-textarea" placeholder="@Model.ElementEditor.ParametersTextPlaceholder"></textarea>
                                    </label>
                                    <label class="workspace-span-2">
                                        <span>Thresholds</span>
                                        <textarea asp-for="ElementEditor.ThresholdsText" rows="4" class="form-control workspace-textarea" placeholder="@Model.ElementEditor.ThresholdsTextPlaceholder"></textarea>
                                    </label>
                                </div>
                            </div>
                        </details>
                    }

                    @if (!isSensor)
                    {
                    <div class="workspace-span-2 workspace-credential-section">
                        <div class="panel-header">
                            <h2 class="section-title">@MatmonIcons.Render("key")<span>Credentials</span></h2>
                            <span class="panel-hint">inherited access</span>
                        </div>
                        <div class="workspace-inline-note">Define reusable credentials here. Child sensors automatically pick the first inherited bundle with the matching credential type, or can explicitly select one.</div>

                        @if (Model.ElementEditor.CredentialBundles.Count == 0)
                        {
                            <div class="empty-state">No credentials yet.</div>
                        }
                        else
                        {
                            <div class="sensor-parameter-list" data-credential-section>
                                @for (var i = 0; i < Model.ElementEditor.CredentialBundles.Count; i++)
                                {
                                    var credential = Model.ElementEditor.CredentialBundles[i];
                                    var isHidden = i >= Model.ElementEditor.CredentialBundleVisibleCount || credential.IsDeleted;
                                    <div class="sensor-parameter-card" data-credential-row data-credential-deleted="@(credential.IsDeleted ? "true" : "false")" hidden="@(isHidden ? "hidden" : null)">
                                        <input type="hidden" asp-for="ElementEditor.CredentialBundles[i].Id" />
                                        <input type="hidden" asp-for="ElementEditor.CredentialBundles[i].IsDeleted" />
                                        <div class="sensor-parameter-head">
                                            <div>
                                                <div class="sensor-parameter-name">Credential</div>
                                                <div class="sensor-parameter-help">Reusable access bundle for one sensor family</div>
                                            </div>
                                            <div class="sensor-threshold-head-actions">
                                                <button type="button"
                                                        class="workspace-danger-submit sensor-threshold-delete"
                                                        data-credential-delete
                                                        aria-label="Delete credential"
                                                        title="Delete credential">
                                                    @MatmonIcons.Render("trash")
                                                    <span class="workspace-sr-only">Delete credential</span>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="sensor-threshold-grid">
                                            <label>
                                                <span>Name</span>
                                                <input asp-for="ElementEditor.CredentialBundles[i].Name" class="form-control workspace-input" placeholder="Windows admin" />
                                            </label>
                                            <label>
                                                <span>Kind</span>
                                                <select asp-for="ElementEditor.CredentialBundles[i].Kind" class="form-select workspace-select" data-credential-kind-select>
                                                    @foreach (var kind in Enum.GetValues<MonitoringCredentialKind>())
                                                    {
                                                        <option value="@kind">@kind</option>
                                                    }
                                                </select>
                                            </label>
                                            <label class="workspace-span-2">
                                                <span>Description</span>
                                                <input asp-for="ElementEditor.CredentialBundles[i].Description" class="form-control workspace-input" placeholder="Optional note" />
                                            </label>

                                            <div class="workspace-span-2 credential-kind-panel" data-credential-kind-group="windows" hidden="@(credential.Kind == MonitoringCredentialKind.Windows ? null : "hidden")">
                                                <div class="workspace-inline-note">Windows / WinRM credentials</div>
                                                <div class="sensor-threshold-grid">
                                                    <label>
                                                        <span>Username</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].WinrmUsername" class="form-control workspace-input" placeholder="monitor" />
                                                    </label>
                                                    <label>
                                                        <span>Password</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].WinrmPassword" type="password" autocomplete="off" class="form-control workspace-input" placeholder="••••••••" />
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="workspace-span-2 credential-kind-panel" data-credential-kind-group="ssh" hidden="@((credential.Kind == MonitoringCredentialKind.Linux || credential.Kind == MonitoringCredentialKind.Ssh) ? null : "hidden")">
                                                <div class="workspace-inline-note">SSH / Linux credentials</div>
                                                <div class="sensor-threshold-grid">
                                                    <label>
                                                        <span>Username</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SshUsername" class="form-control workspace-input" placeholder="monitor" />
                                                    </label>
                                                    <label>
                                                        <span>Password</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SshPassword" type="password" autocomplete="off" class="form-control workspace-input" placeholder="••••••••" />
                                                    </label>
                                                    <label class="workspace-span-2">
                                                        <span>Private key path</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SshPrivateKeyPath" class="form-control workspace-input" placeholder="C:\\Users\\monitor\\.ssh\\id_ed25519" />
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="workspace-span-2 credential-kind-panel" data-credential-kind-group="proxmox" hidden="@(credential.Kind == MonitoringCredentialKind.Proxmox ? null : "hidden")">
                                                <div class="workspace-inline-note">Proxmox API token credentials</div>
                                                <div class="sensor-threshold-grid">
                                                    <label>
                                                        <span>API user</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].PveUser" class="form-control workspace-input" placeholder="root@pam" />
                                                    </label>
                                                    <label>
                                                        <span>Token ID</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].PveTokenId" class="form-control workspace-input" placeholder="monitoring" />
                                                    </label>
                                                    <label class="workspace-span-2">
                                                        <span>Token secret</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].PveTokenSecret" type="password" autocomplete="off" class="form-control workspace-input" placeholder="••••••••" />
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="workspace-span-2 credential-kind-panel" data-credential-kind-group="sqlserver" hidden="@(credential.Kind == MonitoringCredentialKind.SqlServer ? null : "hidden")">
                                                <div class="workspace-inline-note">SQL Server credentials</div>
                                                <div class="sensor-threshold-grid">
                                                    <label>
                                                        <span>Username</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].MssqlUsername" class="form-control workspace-input" placeholder="monitor" />
                                                    </label>
                                                    <label>
                                                        <span>Password</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].MssqlPassword" type="password" autocomplete="off" class="form-control workspace-input" placeholder="••••••••" />
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="workspace-span-2 credential-kind-panel" data-credential-kind-group="snmp" hidden="@(credential.Kind == MonitoringCredentialKind.Snmp ? null : "hidden")">
                                                <div class="workspace-inline-note">SNMP credentials</div>
                                                <div class="sensor-threshold-grid">
                                                    <label>
                                                        <span>Community</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpCommunity" class="form-control workspace-input" placeholder="public" />
                                                    </label>
                                                    <label>
                                                        <span>v3 username</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpV3Username" class="form-control workspace-input" placeholder="snmp-user" />
                                                    </label>
                                                    <label>
                                                        <span>v3 auth protocol</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpV3AuthProtocol" class="form-control workspace-input" placeholder="sha1" />
                                                    </label>
                                                    <label>
                                                        <span>v3 auth password</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpV3AuthPassword" type="password" autocomplete="off" class="form-control workspace-input" placeholder="••••••••" />
                                                    </label>
                                                    <label>
                                                        <span>v3 privacy protocol</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpV3PrivacyProtocol" class="form-control workspace-input" placeholder="aes128" />
                                                    </label>
                                                    <label>
                                                        <span>v3 privacy password</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpV3PrivacyPassword" type="password" autocomplete="off" class="form-control workspace-input" placeholder="••••••••" />
                                                    </label>
                                                    <label class="workspace-span-2">
                                                        <span>v3 context</span>
                                                        <input asp-for="ElementEditor.CredentialBundles[i].SnmpV3ContextName" class="form-control workspace-input" placeholder="optional" />
                                                    </label>
                                                </div>
                                            </div>

                                            <details class="workspace-details workspace-details-nested workspace-span-2">
                                                <summary>@MatmonIcons.Render("spark")<span>Advanced values</span></summary>
                                                <div class="workspace-details-body">
                                                    <div class="workspace-inline-note">Use this for any extra key=value pairs that are not covered above.</div>
                                                    <label>
                                                        <span>Values</span>
                                                        <textarea asp-for="ElementEditor.CredentialBundles[i].ValuesText" rows="4" class="form-control workspace-textarea" placeholder="key=value per line"></textarea>
                                                    </label>
                                                </div>
                                            </details>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (Model.ElementEditor.CredentialBundles.Count > Model.ElementEditor.CredentialBundleVisibleCount)
                            {
                                <div class="sensor-threshold-actions">
                                    <button type="button" class="workspace-secondary-submit" data-credential-add>@MatmonIcons.Render("plus")<span>Add credential</span></button>
                                </div>
                            }
                        }
                    </div>
                    }
                </div>

                <div class="workspace-form-actions">
                    <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                    <button type="submit" class="workspace-submit">@MatmonIcons.Render("check")<span>Save</span></button>
                    @if (isSensor)
                    {
                        <button type="submit" asp-page-handler="RunSensorNow" formnovalidate class="workspace-secondary-submit">@MatmonIcons.Render("spark")<span>Test</span></button>
                    }
                </div>

                <button type="submit" asp-page-handler="PreviewSensorFields" formnovalidate class="d-none" data-sensor-preview-submit>Preview</button>
            </form>

            @if (isSensor)
            {
                <div class="workspace-inline-actions">
                    <form method="post"
                          asp-page-handler="ToggleSensorPause"
                          asp-route-sensorId="@Model.ElementEditor.Id"
                          asp-route-returnUrl="@(Request.Path + Request.QueryString)">
                        <button type="submit" class="workspace-secondary-submit">
                            @MatmonIcons.Render(Model.ElementEditor.IsPaused ? "play" : "pause")
                            <span>@(Model.ElementEditor.IsPaused ? "Resume" : "Pause")</span>
                        </button>
                    </form>
                </div>
            }

            @if (Model.ElementEditor.Kind == "Probe")
            {
                <div class="workspace-inline-actions">
                    <form method="post" asp-page-handler="RotateToken">
                        <input type="hidden" asp-for="ElementEditor.Id" />
                        <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("arrow-right")<span>Rotate</span></button>
                    </form>
                </div>
            }

            @if (!(isSensor && string.Equals(Model.ElementEditor.SensorTypeKey, "probe-heartbeat", StringComparison.OrdinalIgnoreCase)))
            {
                <div class="workspace-inline-actions">
                    <form method="post" asp-page-handler="DeleteElement" onsubmit="return confirm('Delete this element and all children?');">
                        <input type="hidden" asp-for="ElementEditor.Id" />
                        <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("trash")<span>Delete</span></button>
                    </form>
                </div>
            }
            else
            {
                <div class="workspace-inline-note">System sensor. Managed by the probe.</div>
            }
        }
    </section>
</section>

@page "/Maps"
@model MapsModel
@inject Matmon.Host.Services.IMonitoringWorkspaceStore Store
@{
    var map = Model.SelectedMap;

    // The FULL address (PublicLinks): through the cloud console the request only knows the instance's internal host,
    // and a bare path was what got copied. When the address cannot be known here, the path is shown with a word on
    // where to set it.
    string PublicPath(MonitoringMap candidate) => Url.Page("/MapPublic", null, new { token = candidate.PublicToken }) ?? $"/Maps/Public/{candidate.PublicToken}";
    var publicAddressKnown = Matmon.Host.Ui.PublicLinks.Absolute(ViewContext.HttpContext, Store, "/") is not null;
    string PublicUrl(MonitoringMap candidate) => Matmon.Host.Ui.PublicLinks.Absolute(ViewContext.HttpContext, Store, PublicPath(candidate)) ?? PublicPath(candidate);

    // The viewer is a page of its own: the map's name is the title and the breadcrumb leads back to the
    // library (it used to be a "Map Library" button above the board).
    var selectedPublicUrl = map is null ? null : PublicUrl(map);
    if (map is not null && Model.Display is not null)
    {
        ViewData["Title"] = map.Name;
        ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("Maps", "/Maps"), new BreadcrumbItem(map.Name) };
    }
    else
    {
        ViewData["Title"] = "Maps";
    }
}

@section TopbarActions {
    @if (map is not null && Model.Display is not null)
    {
        <div class="mat-topbar__actions">
            @* A NOC's two switches, kept per browser: dim what is fine, and beep when something turns red. *@
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-map-focus-toggle aria-pressed="false" aria-label="Show only problems" data-tip="Only problems">@MatUi.Icon("filter")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-map-sound-toggle aria-pressed="false" aria-label="Beep when a tile turns red" data-tip="Alert sound">@MatUi.Icon("volume")</button>
        </div>
    }
    @if (map is not null && Model.Display is not null && Model.CanEditMaps)
    {
        <div class="mat-topbar__actions">
            @if (Model.Maps.Count > 1)
            {
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-menu-toggle="map-switch-menu" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false" aria-label="Switch to another map" data-tip="Switch map">@MatUi.Icon("layers")</button>
            }
            @if (map.PublicEnabled)
            {
                <a class="mat-btn mat-btn--ghost mat-btn--icon" href="@selectedPublicUrl" target="_blank" rel="noopener" aria-label="Open the public wallboard" data-tip="Public wallboard">@MatUi.Icon("external")</a>
            }
            <a class="mat-btn mat-btn--ghost mat-btn--icon" asp-page="/MapEditor" asp-route-mapId="@map.Id" aria-label="Edit @map.Name" data-tip="Edit">@MatUi.Icon("edit")</a>
        </div>
    }
}

@if (map is null)
{
    <partial name="_MapsTabs" model="@("maps")" />
}

@if (Model.Maps.Count == 0)
{
    <div class="mat-list">
        <div class="mat-empty mat-empty--first">
            <span class="mat-empty__icon">@MatUi.Icon("globe")</span>
            <div class="mat-empty__title">No maps yet</div>
            @if (Model.CanEditMaps)
            {
                <a class="mat-btn mat-btn--primary" asp-page="/MapEditor">@MatUi.Icon("plus")<span>New map</span></a>
            }
            else
            {
                <p>An administrator can create one.</p>
            }
        </div>
        @if (Model.CanEditMaps)
        {
            <div class="mat-actions">
                <a class="mat-btn mat-btn--primary" asp-page="/MapEditor">@MatUi.Icon("plus")<span>New map</span></a>
                <a class="mat-btn mat-btn--secondary" asp-page="/MapGenerate">@MatUi.Icon("sparkles")<span>Generate from the tree</span></a>
            </div>
        }
    </div>
}
else if (map is null)
{
    <div class="mat-list">
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Maps</caption>
                <thead>
                    <tr>
                        <th scope="col">Map</th>
                        <th scope="col" class="mat-num">Slides</th>
                        <th scope="col" class="mat-num mat-hide-sm">Columns</th>
                        <th scope="col">Public link</th>
                        <th scope="col" class="mat-hide-sm">Updated</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Model.Maps)
                    {
                        var publicUrl = PublicUrl(candidate);
                        var slideCount = candidate.EffectiveSlides().Count;
                        <tr>
                            <td data-label="Map" class="mat-table__primary">
                                <a asp-page="/Maps" asp-route-mapId="@candidate.Id">@candidate.Name</a>
                            </td>
                            <td data-label="Slides" class="mat-num">@slideCount</td>
                            <td data-label="Columns" class="mat-num mat-hide-sm">@Math.Max(1, candidate.Columns)</td>
                            <td data-label="Public link">
                                <div class="map-library-public">
                                    <span class="@MatUi.PillClass(candidate.PublicEnabled ? "ok" : "plain")">@(candidate.PublicEnabled ? "On" : "Off")</span>
                                    @if (Model.CanEditMaps && candidate.PublicEnabled)
                                    {
                                        <span class="mat-mono map-library-url" title="@publicUrl">@publicUrl</span>
                                    }
                                </div>
                            </td>
                            <td data-label="Updated" class="mat-mono mat-hide-sm">@candidate.UpdatedUtc.LocalDateTime.ToString("g")</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/Maps" asp-route-mapId="@candidate.Id" aria-label="Open @candidate.Name" data-tip="Open">@MatUi.Icon("eye")</a>
                                    @if (Model.CanEditMaps)
                                    {
                                        if (candidate.PublicEnabled)
                                        {
                                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-copy="@publicUrl" aria-label="Copy the public link of @candidate.Name" data-tip="Copy public link">@MatUi.Icon("copy")</button>
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="@publicUrl" target="_blank" rel="noopener" aria-label="Open the public wallboard of @candidate.Name" data-tip="Public wallboard">@MatUi.Icon("external")</a>
                                        }
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/MapEditor" asp-route-mapId="@candidate.Id" aria-label="Edit @candidate.Name" data-tip="Edit">@MatUi.Icon("edit")</a>
                                        if (candidate.PublicEnabled)
                                        {
                                            <form method="post" asp-page-handler="RotatePublicLink" asp-route-mapId="@candidate.Id">
                                                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="New public link for @candidate.Name" data-tip="New public link"
                                                        data-confirm="Generate a new link for @(candidate.Name)? The current one stops working immediately." data-confirm-ok="New link" data-confirm-danger>@MatUi.Icon("refresh")</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.CanEditMaps)
        {
            <div class="mat-actions">
                <a class="mat-btn mat-btn--primary" asp-page="/MapEditor">@MatUi.Icon("plus")<span>New map</span></a>
                <a class="mat-btn mat-btn--secondary" asp-page="/MapGenerate">@MatUi.Icon("sparkles")<span>Generate from the tree</span></a>
            </div>
        }
    </div>
}
else if (Model.Display is not null)
{
    var mapNav = Model.Display.Slides.Count > 1
        ? new Matmon.Host.Ui.MapCarouselNavModel(Model.Display.Slides.Select(s => s.Slide.Name).ToArray(), map.PaginationMode)
        : null;

    @if (Model.CanEditMaps && Model.Maps.Count > 1)
    {
        <div class="mat-menu" id="map-switch-menu" role="menu" aria-label="Switch map" hidden>
            @foreach (var candidate in Model.Maps)
            {
                var isCurrent = candidate.Id == map.Id;
                <a class="mat-menu__item" role="menuitem" asp-page="/Maps" asp-route-mapId="@candidate.Id" aria-current="@(isCurrent ? "page" : null)">@MatUi.Icon(isCurrent ? "check" : "globe")<span>@candidate.Name</span></a>
            }
        </div>
    }

    <div class="mat-stack">
        @* The in-app viewer patches itself from the same JSON the public board polls, so a map on a second
           monitor stays current without a reload throwing the carousel back to slide 1. *@
        <div class="map-view"
             data-map-noc
             data-map-live="/Maps?mapId=@map.Id&amp;handler=Data"
             data-map-live-interval="30"
             data-map-live-revision="@Matmon.Host.Ui.MapLiveData.Build(Model.Display).Revision">
            <div class="map-stage" data-map-stage>
                <div class="map-carousel" data-map-carousel>
                    @for (var slideIndex = 0; slideIndex < Model.Display.Slides.Count; slideIndex++)
                    {
                        var slide = Model.Display.Slides[slideIndex];
                        var slideModel = new MapSlideRenderModel
                        {
                            Slide = slide.Slide,
                            Map = map,
                            SlideIndex = slideIndex,
                            Tiles = slide.Tiles.Select(tile => MapTileRenderModel.FromDisplay(tile, map)).ToArray()
                        };
                        <partial name="_MapSlide" model="slideModel" />
                    }
                </div>
                @if (mapNav is not null && Model.Display.Map.PaginationMode != MonitoringMapPaginationMode.Below)
                {
                    <partial name="_MapCarouselNav" model="mapNav" />
                }
            </div>
            @if (mapNav is not null && Model.Display.Map.PaginationMode == MonitoringMapPaginationMode.Below)
            {
                <partial name="_MapCarouselNav" model="mapNav" />
            }
        </div>

        @* Share panel for the public link. The QR is the point of it: a wallboard is usually set up by
           someone standing at the TV, and typing a 32-character token by hand is the worst part of the job. *@
        @if (map.PublicEnabled && Model.CanEditMaps)
        {
            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("link")<h2 class="mat-card__title">Public link</h2><span class="mat-text-muted mm-push-end">Anyone with the link sees this board</span></div>
                <div class="mat-card__body map-share">
                    <div class="mat-stack">
                        <div class="mat-field">
                            <label class="mat-label" for="map-public-url">Link</label>
                            <div class="mat-input-group">
                                <input type="text" class="mat-input mat-mono" id="map-public-url" value="@selectedPublicUrl" readonly />
                                <button type="button" class="mat-btn mat-btn--secondary" data-copy="#map-public-url">@MatUi.Icon("copy")<span>Copy</span></button>
                            </div>
                            @if (!publicAddressKnown)
                            {
                                <span class="mat-hint">The address of this instance is not known here - set it under <a asp-page="/Config" asp-route-tab="general">System &gt; General</a>, or open Matmon once directly.</span>
                            }
                        </div>
                        <span class="mat-muted">
                            <strong>Kiosk:</strong> open the link in the display browser and press <kbd>F11</kbd>.
                            @if (Model.Display.Slides.Count > 1)
                            {
                                <text> Slides rotate every @map.AutoRotateSeconds s.</text>
                            }
                        </span>
                        <form method="post" asp-page-handler="RotatePublicLink" asp-route-mapId="@map.Id" class="mat-row">
                            <button type="submit" class="mat-btn mat-btn--secondary"
                                    data-confirm="Generate a new link? The current one stops working immediately." data-confirm-ok="New link" data-confirm-danger>
                                @MatUi.Icon("refresh")<span>New link</span>
                            </button>
                        </form>
                    </div>
                    @* Drawn black on transparent, so it sits on a white plate in both themes - on the dark theme it
                       would otherwise be black on near-black and no phone would read it. Rendered offline. *@
                    @if (publicAddressKnown)
                    {
                    <figure class="map-share-qr">
                        <div class="mm-qr" role="img" aria-label="QR code for the public link">@Html.Raw(Matmon.Host.Services.TotpQr.Render(selectedPublicUrl!, 3, QRCoder.QRCodeGenerator.ECCLevel.M))</div>
                        <figcaption class="mat-hint">Scan to open on a phone</figcaption>
                    </figure>
                    }
                </div>
            </section>
        }
    </div>
}

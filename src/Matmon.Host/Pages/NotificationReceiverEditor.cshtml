@page "/notifications/receiver"
@model WorkspaceModel
@{
    ViewData["Title"] = "Notification receiver";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumbs"] = new[]
    {
        new BreadcrumbItem("Monitoring", "/Index"),
        new BreadcrumbItem("Notifications", "/Notifications"),
        new BreadcrumbItem("Receivers", "/NotificationReceivers"),
        new BreadcrumbItem("Notification receiver")
    };
    var isCreateMode = Model.SelectedNotificationReceiverId is null || Model.NotificationReceiverEditor.Id == Guid.Empty;
    var backUrl = Model.GetSafeReturnUrl("/NotificationReceivers");
    var receiverKind = isCreateMode ? Model.NewNotificationReceiver.Kind : Model.NotificationReceiverEditor.Kind;
    var targetLabel = receiverKind == NotificationEndpointKind.Webhook ? "Webhook URL" : "Email address";
}

<nav class="mat-tabs" aria-label="Notifications">
    <a class="mat-tab" asp-page="/Notifications">Rules</a>
    <a class="mat-tab" asp-page="/Notifications" asp-fragment="senders">Senders</a>
    <a class="mat-tab is-active" aria-current="true" asp-page="/Notifications" asp-fragment="receivers">Receivers</a>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (isCreateMode)
{
    <form method="post" asp-page-handler="CreateNotificationReceiver" class="mat-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("users")<h2 class="mat-card__title">Create receiver</h2></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationReceiver.Name">Name</label>
                        <input asp-for="NewNotificationReceiver.Name" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationReceiver.Kind">Kind</label>
                        <select asp-for="NewNotificationReceiver.Kind" class="mat-select" data-notification-kind-select>
                            <option value="Email">Email</option>
                            <option value="Webhook">Webhook</option>
                        </select>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-label" asp-for="NewNotificationReceiver.Target">@targetLabel</label>
                        <input asp-for="NewNotificationReceiver.Target" class="mat-input mat-mono" placeholder="target" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationReceiver.TimeoutSeconds">Timeout seconds</label>
                        <input asp-for="NewNotificationReceiver.TimeoutSeconds" type="number" min="1" class="mat-input mat-mono" data-msg-range="The timeout is 1 second or more." />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationReceiver.Secret">Secret</label>
                        <input asp-for="NewNotificationReceiver.Secret" type="password" class="mat-input" />
                        <span class="mat-hint">Leave blank to keep the current one.</span>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-switch"><input asp-for="NewNotificationReceiver.Enabled" /><span class="mat-switch__track"></span><span>Enabled</span></label>
                    </div>
                </div>
            </div>
        </section>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create receiver</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
        </div>
    </form>
}
else
{
    <form method="post" asp-page-handler="SaveNotificationReceiver" class="mat-form" novalidate>
        <input type="hidden" asp-for="NotificationReceiverEditor.Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <section class="mat-card">
            <div class="mat-card__head">
                @MatUi.Icon("users")<h2 class="mat-card__title">Edit receiver</h2>
                @if (!string.IsNullOrWhiteSpace(Model.View.SelectedNotificationReceiverKind))
                {
                    <span class="mat-text-muted mm-push-end">@Model.View.SelectedNotificationReceiverKind</span>
                }
            </div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationReceiverEditor.Name">Name</label>
                        <input asp-for="NotificationReceiverEditor.Name" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationReceiverEditor.Kind">Kind</label>
                        <select asp-for="NotificationReceiverEditor.Kind" class="mat-select" data-notification-kind-select>
                            <option value="Email">Email</option>
                            <option value="Webhook">Webhook</option>
                        </select>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-label" asp-for="NotificationReceiverEditor.Target">@targetLabel</label>
                        <input asp-for="NotificationReceiverEditor.Target" class="mat-input mat-mono" placeholder="target" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationReceiverEditor.TimeoutSeconds">Timeout seconds</label>
                        <input asp-for="NotificationReceiverEditor.TimeoutSeconds" type="number" min="1" class="mat-input mat-mono" data-msg-range="The timeout is 1 second or more." />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationReceiverEditor.Secret">Secret</label>
                        <input asp-for="NotificationReceiverEditor.Secret" type="password" class="mat-input" />
                        <span class="mat-hint">Leave blank to keep the current one.</span>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-switch"><input asp-for="NotificationReceiverEditor.Enabled" /><span class="mat-switch__track"></span><span>Enabled</span></label>
                    </div>
                </div>
            </div>
        </section>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save receiver</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" asp-page-handler="DeleteNotificationReceiver" formnovalidate class="mat-btn mat-btn--danger" data-confirm="Delete this notification receiver?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete receiver</span></button>
        </div>
    </form>
}

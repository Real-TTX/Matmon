@page "/system/syslog"
@model Matmon.Host.Pages.SystemSyslogModel
@using Matmon.Core.Syslog
@using Matmon.Host.Services
@{
    // Syslog is a tab of System (it comes with the syslog collector plugin): the same h1 as the Config page, the tab strip
    // says where in System this is.
    ViewData["Title"] = "System";
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("System", "/Config"), new BreadcrumbItem("Syslog") };
    var storage = Model.Storage;
    var head = Model.Head;
    var newest = storage.NewestUtc;
    var (localUdp, localTcp) = Model.LocalPorts;
    var udpPort = localUdp ?? SyslogSettings.DefaultPort;
}

@functions {
    private static string FormatBytes(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : bytes < 1024L * 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.#} MB"
        : $"{bytes / (1024.0 * 1024 * 1024):0.##} GB";
}

<partial name="_SystemTabs" model="@("syslog")" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<section class="mat-card">
    <div class="mat-card__body mat-row">
        <span class="@MatUi.PillClass(head.State)">@head.Label</span>
        <span>@head.Text</span>
        <span class="mat-text-muted">@storage.Messages.ToString("N0") stored@(newest is { } latest ? $" · newest {Model.Ago(latest)}" : string.Empty)</span>
        @if (Model.Active || storage.Messages > 0)
        {
            <a class="mat-btn mat-btn--secondary mat-btn--sm mm-push-end" asp-page="/Events" asp-fragment="syslog">@MatUi.Icon("list")<span>Read the log</span></a>
        }
    </div>
</section>

<div class="mat-grid mat-grid--2">
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("plug")<h2 class="mat-card__title">Collectors</h2></div>
        <div class="mat-card__body mat-stack">
            @if (Model.Collectors.Count == 0)
            {
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("plug")</span>
                    <div class="mat-empty__title">No collector</div>
                    <p>Add the syslog collector to this machine or to a probe or agent near the devices - it opens the port there.</p>
                </div>
            }
            else
            {
                <ul class="mat-listgroup">
                    @foreach (var collector in Model.Collectors)
                    {
                        var (tone, label) = collector.Pill;
                        <li class="mat-listgroup__item">
                            <div class="mat-listgroup__text">
                                <strong>@(collector.Location?.Name ?? "a deleted probe")</strong>
                                <small class="mat-d-block mat-text-muted">@collector.Detail</small>
                            </div>
                            <span class="@MatUi.PillClass(tone)">@label</span>
                            <a class="mat-btn mat-btn--ghost mat-btn--sm" asp-page="/SystemPlugins" asp-route-edit="@collector.Assignment.Id">@MatUi.Icon("edit")<span>Settings</span></a>
                        </li>
                    }
                </ul>
            }
            <div class="mat-btn-row">
                <a class="mat-btn mat-btn--secondary" asp-page="/SystemPlugins" asp-route-add="syslog-collector">@MatUi.Icon("plus")<span>Add a collector</span></a>
            </div>
            <p class="mat-hint">Ports and allowed sources are the collector's settings.</p>
        </div>
    </section>

    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("database")<h2 class="mat-card__title">Storage</h2></div>
        <div class="mat-card__body mat-stack">
            @if (!storage.Available)
            {
                <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">The log database cannot be used: @storage.Error</div></div>
            }

            <form method="post" asp-page-handler="SaveStorage" class="mat-form" novalidate>
                @if (!string.IsNullOrWhiteSpace(Model.FormError))
                {
                    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.FormError</div></div>
                }
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" for="Input_RetentionDays">Keep for (days)</label>
                        <input asp-for="Input.RetentionDays" type="number" min="@SyslogSettings.MinRetentionDays" max="@SyslogSettings.MaxRetentionDays" class="mat-input mat-mono" />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="Input_MaxMessages">Keep at most (messages)</label>
                        <input asp-for="Input.MaxMessages" type="number" min="@SyslogSettings.MinMessages" max="@SyslogSettings.MaxMessagesLimit" step="10000" class="mat-input mat-mono" />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                </div>
                <p class="mat-hint">Whichever limit is reached first deletes the oldest messages.</p>
                <div class="mat-btn-row">
                    <button type="submit" class="mat-btn mat-btn--primary" data-default-submit>@MatUi.Icon("save")<span>Save</span></button>
                </div>
            </form>

            <dl class="mat-kv">
                <dt>Stored</dt>
                <dd><span class="mat-mono">@storage.Messages.ToString("N0")</span> messages · <span class="mat-mono">@FormatBytes(storage.DatabaseBytes)</span></dd>
                <dt>Oldest</dt>
                <dd class="mat-mono">@(storage.OldestUtc is { } oldest ? oldest.ToDisplay().ToString("g") : "-")</dd>
                <dt>Lost</dt>
                <dd><span class="mat-mono">@storage.Dropped.ToString("N0")</span> <span class="mat-text-muted">@(storage.Dropped > 0 ? "messages that could not be written - the log was flooded or the disk refused them" : "none")</span></dd>
            </dl>

            @* Two handlers in one button row: each button posts its own hidden form (form=), which carries the anti-forgery token. *@
            <form method="post" asp-page-handler="Test" id="syslog-test" hidden></form>
            <form method="post" asp-page-handler="Clear" id="syslog-clear" hidden></form>
            <div class="mat-btn-row">
                @if (Model.LocalCollector is { IsRunning: true })
                {
                    <button type="submit" form="syslog-test" class="mat-btn mat-btn--secondary" data-tip="Sends one message to the collector on this machine and checks it was stored">@MatUi.Icon("activity")<span>Send a test message</span></button>
                }
                <span class="mat-btn-row__spacer"></span>
                <button type="submit" form="syslog-clear" class="mat-btn mat-btn--danger"
                        data-confirm="Delete every stored syslog message? This cannot be undone." data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete all messages</span></button>
            </div>
        </div>
    </section>
</div>

<section class="mat-card">
    <div class="mat-card__head">@MatUi.Icon("server")<h2 class="mat-card__title">Who has been sending</h2></div>
    <div class="mat-card__body mat-stack">
        @* The time range as link pills: each is a plain GET (?Days=), so the list changes without a script. *@
        <nav class="mat-tabs mat-tabs--pills" aria-label="Time range">
            @foreach (var choice in Model.SourceWindows)
            {
                var isActive = Model.Days == choice.Days;
                <a class="mat-tab@(isActive ? " is-active" : string.Empty)" aria-current="@(isActive ? "page" : null)" asp-page="/SystemSyslog" asp-route-Days="@choice.Days">@choice.Label</a>
            }
        </nav>

        @if (Model.Sources.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@MatUi.Icon("server")</span>
                @if (!Model.Active && storage.Messages == 0)
                {
                    <div class="mat-empty__title">Nothing received</div>
                    <p>Nothing has been received - no collector runs.</p>
                }
                else if (storage.Messages == 0)
                {
                    <div class="mat-empty__title">Nothing yet</div>
                    <p>Nothing has arrived yet. Point a device's syslog setting at this machine and it appears here within seconds.</p>
                }
                else
                {
                    <div class="mat-empty__title">Nobody sent anything</div>
                    <p>Nobody sent anything in this time range.</p>
                }
            </div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Senders</caption>
                    <thead>
                        <tr>
                            <th scope="col">Sender</th>
                            <th scope="col" class="mat-num">Messages</th>
                            <th scope="col" class="mat-num">Errors</th>
                            <th scope="col">Last message</th>
                            <th scope="col" class="mat-hide-sm">In your tree</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Sources)
                        {
                            var sender = row.Sender;
                            var messagesSensor = row.Sensors.FirstOrDefault(sensor => string.Equals(sensor.SensorTypeKey, SyslogSensorTypes.Messages, StringComparison.OrdinalIgnoreCase));
                            var shownWindow = Model.Days == 0 ? 0 : Model.Days * 1440;

                            <tr>
                                <td data-label="Sender" class="mat-table__primary">
                                    <div class="mat-table__name">
                                        <span>
                                            @if (sender.SharedAddress && sender.Hostname is not null)
                                            {
                                                @* behind a relay or Docker's gateway the name is the device; the address is only the way in *@
                                                @sender.Hostname
                                                <small class="mat-mono" title="Several devices send through this address - they are told apart by the host name in their messages">via @sender.SourceAddress</small>
                                            }
                                            else
                                            {
                                                <span class="mat-mono">@sender.SourceAddress</span>
                                                @if (sender.Hostname is not null)
                                                {
                                                    <small>@sender.Hostname</small>
                                                }
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Messages" class="mat-num mat-mono">@sender.Messages.ToString("N0")</td>
                                <td data-label="Errors" class="mat-num">
                                    @if (sender.Errors > 0)
                                    {
                                        <span class="mat-pill mat-pill--error">@sender.Errors.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="mat-text-muted mat-mono">0</span>
                                    }
                                </td>
                                <td data-label="Last message" title="@sender.LastReceivedUtc.ToDisplay().ToString("g")">@Model.Ago(sender.LastReceivedUtc)</td>
                                <td data-label="In your tree" class="mat-hide-sm">
                                    @if (row.Host is { } host)
                                    {
                                        <strong>@host.Name</strong>
                                        @if (row.Sensors.Count > 0)
                                        {
                                            <span class="mat-chips">
                                                @foreach (var sensor in row.Sensors)
                                                {
                                                    <a class="mat-tag" asp-page="/SensorDetails" asp-route-sensorId="@sensor.Id" title="Open the sensor">@sensor.Name</a>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <small class="mat-d-block mat-text-muted">no syslog sensor yet</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="mat-text-muted" title="No host in the tree has this address or name">not in your tree</span>
                                    }
                                </td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <a class="mat-btn mat-btn--ghost mat-btn--sm" asp-page="/Events" asp-route-source="@sender.Filter" asp-route-window="@shownWindow" asp-fragment="syslog" title="Show this sender's messages">@MatUi.Icon("list")<span>Messages</span></a>
                                        @if (row.Host is { } monitorHost && messagesSensor is null)
                                        {
                                            <form method="post" asp-page-handler="Monitor" asp-route-days="@Model.Days">
                                                <input type="hidden" name="hostId" value="@monitorHost.Id" />
                                                <input type="hidden" name="source" value="@row.WatchSender" />
                                                <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm" title="Add a Syslog Messages sensor to @monitorHost.Name">@MatUi.Icon("eye")<span>Watch</span></button>
                                            </form>
                                        }
                                        else if (row.Host is null)
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--sm" asp-page="/HostCreate" title="Add this device as a host, then watch its log">@MatUi.Icon("plus")<span>Add host</span></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mat-muted">"Watch" adds a Syslog Messages sensor that warns on the device's first error.</p>
        }
    </div>
</section>

<section class="mat-card">
    <div class="mat-card__head">@MatUi.Icon("network")<h2 class="mat-card__title">Pointing a device at it</h2></div>
    <div class="mat-card__body mat-stack">
        @if (Model.LocalCollector is not null)
        {
            <p class="mat-muted">In the device's remote logging (syslog) settings, enter this machine as the server: <code>@Model.ReceiverHost</code> on port <code>@udpPort</code> (UDP)@(localTcp is { } tcpPort ? $" or {tcpPort} (TCP)" : string.Empty).</p>
        }
        else
        {
            <p class="mat-muted">Point the device at the machine its collector runs on - a probe or agent near it, or this machine once the collector runs here - on the collector's port (514 by default).</p>
        }
        <details class="mat-collapse">
            <summary><span>Examples</span>@MatUi.Icon("chevron-down", "mat-accordion__chev")</summary>
            <div class="mat-accordion__body">
<pre class="mat-code"><code>Cisco IOS     logging host @Model.ReceiverHost
              logging trap informational

Linux         echo '*.* @@@Model.ReceiverHost:@udpPort' > /etc/rsyslog.d/90-matmon.conf
              systemctl restart rsyslog

MikroTik      /system logging action add name=matmon target=remote remote=@Model.ReceiverHost
              /system logging add action=matmon topics=info,warning,error,critical

Synology      Log Center > Log Sending > Create (server @Model.ReceiverHost, port @udpPort, UDP)</code></pre>
            </div>
        </details>
        <p class="mat-muted"><strong>Running Matmon in Docker?</strong> Publish the port: add <code>-p @udpPort:@udpPort/udp -p @(localTcp ?? SyslogSettings.DefaultPort):@(localTcp ?? SyslogSettings.DefaultPort)/tcp</code> to <code>docker run</code>, or the same two lines under <code>ports:</code> in the compose file. On Docker Desktop (Windows, macOS) messages arrive from Docker's gateway address - give the sensors the device's <em>host name</em> as their Sender.</p>
    </div>
</section>

@page
@model ErrorModel
@{
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Error";
}

<section class="dashboard-shell auth-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("warning")
            <h1>Error</h1>
        </div>
    </div>

    <section class="panel auth-card">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("warning")<span>Something went wrong</span></h2>
            <span class="panel-hint">request diagnostics</span>
        </div>

        <p class="workspace-inline-note">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <dl class="config-list compact-config-list">
                <div class="config-row">
                    <dt>Request ID</dt>
                    <dd><code>@Model.RequestId</code></dd>
                </div>
            </dl>
        }

        <div class="page-actions workspace-toolbar">
            <a class="workspace-secondary-submit" asp-page="/Index">@MatmonIcons.Render("arrow-left")<span>Back to monitoring</span></a>
        </div>
    </section>
</section>

@page "/monitoring/folder/new"
@model WorkspaceModel
@{
    ViewData["Title"] = "New folder";
    ViewData["Width"] = "narrow";
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<form method="post" asp-page-handler="CreateFolder" class="mat-form" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("folder")<h2 class="mat-card__title">Folder</h2></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-field">
                <label class="mat-label" asp-for="NewFolder.Name">Folder name</label>
                <input asp-for="NewFolder.Name" class="mat-input" placeholder="e.g. Network devices" autofocus />
            </div>
            <div class="mat-field" role="group" aria-labelledby="folder-parent-label">
                <span class="mat-label" id="folder-parent-label">Parent</span>
                <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewFolder.ParentId", DomId = "picker-folder-parent", SelectedId = Model.NewFolder.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.FolderParentOptions) })" />
            </div>
            <div class="mat-field">
                <label class="mat-label" asp-for="NewFolder.Description">Description <span class="mat-text-muted">(optional)</span></label>
                <input asp-for="NewFolder.Description" class="mat-input" placeholder="Notes about this folder" />
            </div>
        </div>
    </section>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create folder</span></button>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
</form>

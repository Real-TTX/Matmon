@page "/monitoring/folder/new"
@model WorkspaceModel
@{
    ViewData["Title"] = "New folder";
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("folder")
            <h1>New folder</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-panel">
        <form method="post" asp-page-handler="CreateFolder" class="workspace-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="workspace-field workspace-field-primary">
                <span class="workspace-label">Folder name</span>
                <input asp-for="NewFolder.Name" class="form-control workspace-input" placeholder="e.g. Network devices" autofocus />
            </label>
            <label class="workspace-field">
                <span class="workspace-label">Parent</span>
                <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewFolder.ParentId", DomId = "picker-folder-parent", SelectedId = Model.NewFolder.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.FolderParentOptions) })" />
            </label>
            <label class="workspace-field">
                <span class="workspace-label">Description <em>optional</em></span>
                <input asp-for="NewFolder.Description" class="form-control workspace-input" placeholder="Notes about this folder" />
            </label>
            <div class="workspace-form-actions">
                <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create folder</span></button>
            </div>
        </form>
    </section>
</section>

@page "/About"
@model AboutModel
@{
    ViewData["Title"] = "About";
    var channelKey = Model.Channel.ToLowerInvariant();
}

<section class="dashboard-shell about-page">
    <div class="about-hero">
        <span class="about-hero-mark">@MatmonIcons.Render("monitoring")</span>
        <div class="about-hero-copy">
            <span class="about-hero-kicker">About</span>
            <h1>Matmon</h1>
            <p>Lightweight, self-hosted network monitoring.</p>
            <div class="about-version-row">
                <span class="about-version-tag">@Model.Version</span>
                <span class="about-channel-badge" data-channel="@channelKey">@Model.Channel</span>
            </div>
        </div>
    </div>

    <div class="about-meta">
        <a class="about-link" href="https://matmon.eu" target="_blank" rel="noopener">
            @MatmonIcons.Render("signal")<span>matmon.eu</span>
        </a>
        <span class="about-copyright">© @Model.Year Matmon · All rights reserved</span>
    </div>
</section>

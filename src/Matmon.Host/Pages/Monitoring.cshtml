@page "/monitoring"
@model WorkspaceModel
@{
    ViewData["Title"] = "Sensors";
    var isListView = string.Equals(Model.View.MonitoringViewMode, "list", StringComparison.OrdinalIgnoreCase);
    var nodes = Model.View.MonitoringVisibleNodes;
    var treeRoots = Model.View.MonitoringTreeRoots;
    var returnUrl = Request.Path + Request.QueryString;
    var isAdmin = User.IsInRole(MatmonUserRole.Admin.ToString());
}

@* Tile size is a client-only preference written to <html> BEFORE the first paint, so
   navigating to the page never renders a default size and then jumps to the stored
   one. There is no URL round-trip and no redirect (the old redirect was the main
   cause of the M→S flash). site.js only toggles this attribute + localStorage live. *@
<script>
    try {
        var s = String(localStorage.getItem("matmon-monitoring-size") || "m").trim().toLowerCase();
        document.documentElement.dataset.monitoringSize = (s === "s" || s === "l") ? s : "m";
    } catch (e) { document.documentElement.dataset.monitoringSize = "m"; }

    // Hide the saved-collapsed subtrees with an injected stylesheet BEFORE the tree is
    // parsed, so the tree never renders expanded and then visibly collapses ("builds
    // up"). site.js converts these into is-collapsed classes on load and removes this
    // style, so expand/collapse keeps working afterwards.
    try {
        var collapsed = JSON.parse(localStorage.getItem("matmon-monitoring-tree-collapsed") || "[]");
        if (Array.isArray(collapsed) && collapsed.length) {
            var selector = collapsed
                .filter(function (id) { return typeof id === "string"; })
                .map(function (id) { return '.monitoring-tree-node[data-tree-node-id="' + id.replace(/[^a-zA-Z0-9-]/g, "") + '"] > .monitoring-tree-children'; })
                .join(",");
            if (selector) {
                var preCollapse = document.createElement("style");
                preCollapse.id = "matmon-precollapse";
                preCollapse.textContent = selector + "{display:none!important}";
                document.head.appendChild(preCollapse);
            }
        }
    } catch (e) { /* collapse pre-paint is best-effort */ }
</script>

<section class="dashboard-shell">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <div class="workspace-banner workspace-banner-info monitoring-tree-move-banner" data-tree-move-banner hidden>
        <div class="monitoring-tree-move-banner-main">
            @MatmonIcons.Render("move")
            <span data-tree-move-label></span>
        </div>
        <button type="button" class="workspace-secondary-submit" data-tree-move-cancel aria-label="Cancel move">
            @MatmonIcons.Render("x")
            <span>Cancel</span>
        </button>
    </div>

    <div class="page-header has-summary">
        <div class="page-title">
            @MatmonIcons.Render("sensor")
            <div>
                <div class="eyebrow">Monitoring</div>
                <h1>Sensors</h1>
            </div>
        </div>
    </div>

    <form method="post" asp-page-handler="MoveElement" hidden data-tree-move-form>
        <input type="hidden" name="elementId" data-tree-move-element />
        <input type="hidden" name="parentId" data-tree-move-parent />
        <input type="hidden" name="returnUrl" value="@(Request.Path + Request.QueryString)" />
    </form>

    <section class="panel panel-stack monitoring-controls" data-monitoring-shell data-monitoring-view="@Model.View.MonitoringViewMode">
        <form method="get" class="monitoring-filter-bar">
            <input type="hidden" name="monitoringView" value="@Model.View.MonitoringViewMode" />

            <details class="workspace-action-menu monitoring-display-menu">
                <summary class="workspace-secondary-submit monitoring-display-trigger" aria-label="Display options" title="Display options">
                    @MatmonIcons.Render("dashboard")<span>Display</span>
                </summary>
                <div class="workspace-action-menu-panel monitoring-display-panel">
                    <span class="monitoring-display-label">View</span>
                    <div class="monitoring-view-switch">
                        <a class="workspace-action-link @(isListView ? string.Empty : "is-active")"
                           asp-page="/Monitoring"
                           asp-route-monitoringView="tree"
                           asp-route-monitoringKind="@Model.View.MonitoringKindFilter"
                           asp-route-monitoringState="@Model.View.MonitoringStateFilter"
                           asp-route-monitoringTag="@Model.View.MonitoringTagFilter"
                           asp-route-monitoringSearch="@Model.View.MonitoringSearch">
                            @MatmonIcons.Render("monitoring")
                            <span>Tree</span>
                        </a>
                        <a class="workspace-action-link @(isListView ? "is-active" : string.Empty)"
                           asp-page="/Monitoring"
                           asp-route-monitoringView="list"
                           asp-route-monitoringKind="@Model.View.MonitoringKindFilter"
                           asp-route-monitoringState="@Model.View.MonitoringStateFilter"
                           asp-route-monitoringTag="@Model.View.MonitoringTagFilter"
                           asp-route-monitoringSearch="@Model.View.MonitoringSearch">
                            @MatmonIcons.Render("list")
                            <span>List</span>
                        </a>
                    </div>

                    @* Size is a live, client-only preference (no reload) - see the pre-paint
                       script at the top of the page. site.js marks the active button. *@
                    <span class="monitoring-display-label">Size</span>
                    <div class="monitoring-size-switch" aria-label="Tile size" data-monitoring-size-switch>
                        <button type="button" class="workspace-action-link" data-monitoring-size-set="s"><span>S</span></button>
                        <button type="button" class="workspace-action-link" data-monitoring-size-set="m"><span>M</span></button>
                        <button type="button" class="workspace-action-link" data-monitoring-size-set="l"><span>L</span></button>
                    </div>

                    @if (!isListView)
                    {
                        <span class="monitoring-display-label">Expand</span>
                        <div class="monitoring-tree-bulk">
                            <button type="button" class="workspace-action-link" data-tree-expand-all>@MatmonIcons.Render("plus")<span>Expand all</span></button>
                            <button type="button" class="workspace-action-link" data-tree-collapse-all>@MatmonIcons.Render("x")<span>Collapse all</span></button>
                            <button type="button" class="workspace-action-link" data-tree-collapse-level title="Show probes + their first level, collapse the rest">@MatmonIcons.Render("probe")<span>Probes + 1 level</span></button>
                        </div>
                    }
                </div>
            </details>

            <label class="monitoring-filter-field">
                <span>@MatmonIcons.Render("search")<small>Search</small></span>
                <input type="search" name="monitoringSearch" value="@Model.View.MonitoringSearch" class="form-control workspace-input" placeholder="Name, path, text" />
            </label>

                <label class="monitoring-filter-field">
                <span>@MatmonIcons.Render("sensor")<small>Type</small></span>
                <select name="monitoringKind" class="form-select workspace-select">
                    <option value="all" selected="@(Model.View.MonitoringKindFilter == "all" ? "selected" : null)">All</option>
                    @foreach (var kind in Enum.GetValues<MonitoringElementKind>())
                    {
                        <option value="@kind.ToString().ToLowerInvariant()" selected="@(string.Equals(Model.View.MonitoringKindFilter, kind.ToString().ToLowerInvariant(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@kind</option>
                    }
                </select>
            </label>

            <label class="monitoring-filter-field">
                <span>@MatmonIcons.Render("warning")<small>State</small></span>
                <select name="monitoringState" class="form-select workspace-select">
                    <option value="all" selected="@(Model.View.MonitoringStateFilter == "all" ? "selected" : null)">All</option>
                    <option value="ok" selected="@(Model.View.MonitoringStateFilter == "ok" ? "selected" : null)">OK</option>
                    <option value="warning" selected="@(Model.View.MonitoringStateFilter == "warning" ? "selected" : null)">Warning</option>
                    <option value="error" selected="@(Model.View.MonitoringStateFilter == "error" ? "selected" : null)">Error</option>
                    <option value="paused" selected="@(Model.View.MonitoringStateFilter == "paused" ? "selected" : null)">Paused</option>
                    <option value="unknown" selected="@(Model.View.MonitoringStateFilter == "unknown" ? "selected" : null)">Unknown</option>
                    <option value="disabled" selected="@(Model.View.MonitoringStateFilter == "disabled" ? "selected" : null)">Disabled</option>
                </select>
            </label>

            @if (Model.View.AllTags.Count > 0)
            {
                <label class="monitoring-filter-field">
                    <span>@MatmonIcons.Render("tag")<small>Tag</small></span>
                    <select name="monitoringTag" class="form-select workspace-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.View.MonitoringTagFilter) ? "selected" : null)">All tags</option>
                        @foreach (var tag in Model.View.AllTags)
                        {
                            <option value="@tag" selected="@(string.Equals(Model.View.MonitoringTagFilter, tag, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@tag</option>
                        }
                    </select>
                </label>
            }

            <button type="submit" class="workspace-submit">@MatmonIcons.Render("check")<span>Apply</span></button>
            <a class="workspace-secondary-submit" asp-page="/Monitoring">@MatmonIcons.Render("arrow-left")<span>Reset</span></a>
        </form>
    </section>

    <section class="panel panel-stack workspace-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("sensor")<span>@(isListView ? "List" : "Tree")</span></h2>
            <span class="panel-hint">@Model.View.MonitoringVisibleCount shown</span>
        </div>

        @if (nodes.Count == 0)
        {
            <div class="empty-state">No matching nodes.</div>
        }
        else if (isListView)
        {
            <div class="monitoring-list-shell">
                <div class="monitoring-list-head" role="row">
                    <span>Status</span>
                    <span>Object</span>
                    <span>Endpoint</span>
                    <span>Information</span>
                    <span>Actions</span>
                </div>
                @foreach (var node in nodes)
                {
                    var canAddFolder = isAdmin && (node.Kind == MonitoringElementKind.Probe || node.Kind == MonitoringElementKind.Folder);
                    var canAddHost = isAdmin && (node.Kind == MonitoringElementKind.Probe || node.Kind == MonitoringElementKind.Folder);
                    var canAddSensor = isAdmin && node.Kind != MonitoringElementKind.Sensor;
                    var canDiscover = isAdmin && node.Kind is MonitoringElementKind.Probe or MonitoringElementKind.Folder or MonitoringElementKind.Host;
                    var hasChildActions = canAddFolder || canAddHost || canAddSensor;
                    var canDelete = isAdmin && !(node.Kind == MonitoringElementKind.Probe && node.Depth == 0);
                    var kindKey = node.Kind.ToString().ToLowerInvariant();
                    var rowState = string.IsNullOrWhiteSpace(node.StateKey) ? "neutral" : node.StateKey;
                    var hasState = !string.IsNullOrWhiteSpace(node.StateKey) && !string.IsNullOrWhiteSpace(node.StateLabel);
                    var endpointLabel = node.Kind switch
                    {
                        MonitoringElementKind.Sensor when !string.IsNullOrWhiteSpace(node.Target) => node.Target,
                        MonitoringElementKind.Sensor => "(no target)",
                        MonitoringElementKind.Host when !string.IsNullOrWhiteSpace(node.Address) => node.Address,
                        MonitoringElementKind.Probe when !string.IsNullOrWhiteSpace(node.ProbeId) => node.ProbeId,
                        _ => "-"
                    };
                    var endpointHint = node.Kind switch
                    {
                        MonitoringElementKind.Sensor when !string.IsNullOrWhiteSpace(node.SensorTypeKey) => node.SensorTypeKey,
                        MonitoringElementKind.Host => "host address",
                        MonitoringElementKind.Probe => "probe id",
                        MonitoringElementKind.Folder => "folder",
                        _ => node.Kind.ToString()
                    };
                    var primaryInfo = !string.IsNullOrWhiteSpace(node.Details)
                        ? node.Details
                        : !string.IsNullOrWhiteSpace(node.SettingsSummary)
                            ? node.SettingsSummary
                            : "No extra information";

                    <article class="monitoring-list-row" data-state="@rowState" data-kind="@kindKey" data-depth="@node.Depth" data-acknowledged="@(node.IsAcknowledged ? "true" : null)">
                        <div class="monitoring-list-status">
                            <span class="monitoring-list-state-dot" aria-hidden="true"></span>
                            @if (hasState)
                            {
                                <span class="state-pill" data-state="@node.StateKey">@node.StateLabel</span>
                            }
                            else
                            {
                                <span class="monitoring-list-muted-pill">@node.Kind</span>
                            }
                            @if (node.IsAcknowledged)
                            {
                                <span class="state-pill" data-state="ack">Ack</span>
                            }
                            @if (node.IsHighlighted)
                            {
                                <span class="highlight-pill">@MatmonIcons.Render("star")<span>Highlight</span></span>
                            }
                        </div>

                        <div class="monitoring-list-main">
                            <div class="monitoring-list-title-row">
                                <span class="tree-kind" data-kind="@kindKey" title="@node.Kind">
                                    @MatmonIcons.Render(node.KindIconKey)
                                </span>
                                @if (node.Kind == MonitoringElementKind.Sensor)
                                {
                                    <a class="monitoring-list-title" asp-page="/SensorDetails" asp-route-sensorId="@node.Id">@node.Name</a>
                                }
                                else if (isAdmin)
                                {
                                    <a class="monitoring-list-title" asp-page="/ElementEditor" asp-route-selectedId="@node.Id" asp-route-returnUrl="@returnUrl">@node.Name</a>
                                }
                                else
                                {
                                    <span class="monitoring-list-title">@node.Name</span>
                                }
                            </div>
                            <div class="monitoring-list-path">@node.Path</div>
                            @if (node.OwnTags.Count > 0)
                            {
                                <div class="tree-tags">
                                    @foreach (var tag in node.OwnTags)
                                    {
                                        <span class="tree-tag">@MatmonIcons.Render("tag")<span>@tag</span></span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="monitoring-list-endpoint">
                            <strong>@endpointLabel</strong>
                            <small>@endpointHint</small>
                        </div>

                        <div class="monitoring-list-info">
                            <span>@primaryInfo</span>
                            @if (!string.IsNullOrWhiteSpace(node.TemplateSummary))
                            {
                                <small>@node.TemplateSummary</small>
                            }
                        </div>

                        <div class="monitoring-list-side">
                            <div class="workspace-row-actions">
                                @if (node.Kind == MonitoringElementKind.Sensor)
                                {
                                    <a class="workspace-action-link monitoring-list-icon-action" asp-page="/SensorDetails" asp-route-sensorId="@node.Id" aria-label="Open sensor details" title="Open sensor details">@MatmonIcons.Render("chart")<span>Details</span></a>
                                }

                                @if (isAdmin)
                                {
                                <details class="workspace-action-menu">
                                    <summary class="workspace-secondary-submit monitoring-list-icon-action" aria-label="Element actions" title="Element actions">
                                        @MatmonIcons.Render("more")
                                        <span>Actions</span>
                                    </summary>
                                    <div class="workspace-action-menu-panel">
                                        @if (canDiscover)
                                        {
                                            <form method="post" asp-page="/Discovery" asp-page-handler="Scope">
                                                <input type="hidden" name="scopeElementId" value="@node.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="workspace-action-menu-link">
                                                    @MatmonIcons.Render("search")
                                                    <span>Discover sensors</span>
                                                </button>
                                            </form>
                                        }
                                        @if (isAdmin)
                                        {
                                            <a class="workspace-action-menu-link" asp-page="/ElementEditor" asp-route-selectedId="@node.Id" asp-route-returnUrl="@returnUrl">
                                                @MatmonIcons.Render("pencil")
                                                <span>Edit</span>
                                            </a>
                                        }
                                        @if (hasChildActions)
                                        {
                                            <div class="workspace-action-menu-separator" aria-hidden="true"></div>
                                            @if (canAddFolder)
                                            {
                                                <a class="workspace-action-menu-link" asp-page="/FolderCreate" asp-route-selectedId="@node.Id" asp-route-returnUrl="@returnUrl">
                                                    @MatmonIcons.Render("folder")
                                                    <span>Folder</span>
                                                </a>
                                            }
                                            @if (canAddHost)
                                            {
                                                <a class="workspace-action-menu-link" asp-page="/HostCreate" asp-route-selectedId="@node.Id" asp-route-returnUrl="@returnUrl">
                                                    @MatmonIcons.Render("host")
                                                    <span>Host</span>
                                                </a>
                                            }
                                            @if (canAddSensor)
                                            {
                                                <a class="workspace-action-menu-link" asp-page="/SensorCreate" asp-route-selectedId="@node.Id" asp-route-returnUrl="@returnUrl">
                                                    @MatmonIcons.Render("sensor")
                                                    <span>Sensor</span>
                                                </a>
                                            }
                                        }
                                        @if (node.Kind != MonitoringElementKind.Sensor)
                                        {
                                            <div class="workspace-action-menu-separator" aria-hidden="true"></div>
                                            <form method="post" asp-page-handler="PauseElement" asp-route-returnUrl="@returnUrl">
                                                <input type="hidden" name="elementId" value="@node.Id" />
                                                <input type="hidden" name="paused" value="true" />
                                                <button type="submit" class="workspace-action-menu-link">@MatmonIcons.Render("pause")<span>Pause all</span></button>
                                            </form>
                                            <form method="post" asp-page-handler="PauseElement" asp-route-returnUrl="@returnUrl">
                                                <input type="hidden" name="elementId" value="@node.Id" />
                                                <input type="hidden" name="paused" value="false" />
                                                <button type="submit" class="workspace-action-menu-link">@MatmonIcons.Render("play")<span>Resume all</span></button>
                                            </form>
                                        }
                                        @if (node.Kind == MonitoringElementKind.Sensor)
                                        {
                                            <div class="workspace-action-menu-separator" aria-hidden="true"></div>
                                            <form method="post"
                                                  asp-page-handler="ToggleSensorPause"
                                                  asp-route-sensorId="@node.Id"
                                                  asp-route-returnUrl="@(Request.Path + Request.QueryString)">
                                                <button type="submit" class="workspace-action-menu-link">
                                                    @MatmonIcons.Render(node.IsPaused ? "play" : "pause")
                                                    <span>@(node.IsPaused ? "Resume" : "Pause")</span>
                                                </button>
                                            </form>
                                        }
                                        @if (canDelete)
                                        {
                                            <div class="workspace-action-menu-separator" aria-hidden="true"></div>
                                            <form method="post"
                                                  asp-page-handler="DeleteElement"
                                                  onsubmit="return confirm('Delete this element and all children?');">
                                                <input type="hidden" name="ElementEditor.Id" value="@node.Id" />
                                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                                <button type="submit" class="workspace-action-menu-link">
                                                    @MatmonIcons.Render("trash")
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </details>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="monitoring-tree" data-monitoring-tree>
                @for (var i = 0; i < treeRoots.Count; i++)
                {
                    var rootViewData = new ViewDataDictionary(ViewData)
                    {
                        ["PrevSiblingId"] = i > 0 ? treeRoots[i - 1].Id : (Guid?)null,
                        ["NextSiblingId"] = i < treeRoots.Count - 1 ? treeRoots[i + 1].Id : (Guid?)null
                    };
                    <partial name="_MonitoringTreeNode" model="treeRoots[i]" view-data="rootViewData" />
                }
            </div>
        }
    </section>
</section>

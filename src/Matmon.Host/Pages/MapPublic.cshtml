@page "/Maps/Public/{token}"
@model MapPublicModel
@inject Matmon.Host.Ui.MatUiToolkit Toolkit
@{
    // The TV wallboard: its own full-screen page, no menu and no header bar, but drawn with MatUi like every other
    // page (the toolkit, the app styles and scripts, the sprite). It is always dark - a wall display in a dimmed
    // operations room - which is why data-theme is written here rather than left to the browser.
    Layout = null;
    var display = Model.Display!;
    var map = display.Map;
    ViewData["Title"] = map.Name;
    var showPagination = display.Slides.Count > 1 && map.PaginationMode != MonitoringMapPaginationMode.Hidden;
    var navModel = new Matmon.Host.Ui.MapCarouselNavModel(display.Slides.Select(s => s.Slide.Name).ToArray(), map.PaginationMode);
}
<!DOCTYPE html>
<html lang="en" data-app="matmon" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark" />
    <title>@map.Name - Matmon</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script src="~/js/matmon.boot.js" asp-append-version="true"></script>
    <script src="/matui/matui.boot.js?v=@Toolkit.Hash"></script>
    <link rel="stylesheet" href="/matui/matui.css?v=@Toolkit.Hash" />
    <partial name="_AppStyles" />
</head>
<body class="public-map-body"
      data-map-noc
      data-map-alert-sound="@(map.AlertSound ? "true" : "false")"
      data-map-live="/Maps/Public/@map.PublicToken?handler=Data"
      data-map-live-interval="@Math.Clamp(map.AutoRotateSeconds, 10, 120)"
      data-map-live-revision="@Matmon.Host.Ui.MapLiveData.Build(display).Revision">
    @Html.Raw(Toolkit.Sprite)
    <main class="public-map-shell">
        <div class="map-stage" data-map-stage>
            <div class="map-carousel" data-map-carousel data-map-carousel-autoplay="@(map.AutoRotateEnabled ? "true" : "false")" data-map-carousel-interval="@map.AutoRotateSeconds">
                @for (var slideIndex = 0; slideIndex < display.Slides.Count; slideIndex++)
                {
                    var slide = display.Slides[slideIndex];
                    var slideModel = new MapSlideRenderModel
                    {
                        Slide = slide.Slide,
                        Map = map,
                        SlideIndex = slideIndex,
                        Tiles = slide.Tiles.Select(tile => MapTileRenderModel.FromDisplay(tile, map)).ToArray()
                    };
                    <partial name="_MapSlide" model="slideModel" />
                }
            </div>
            @if (showPagination && map.PaginationMode != MonitoringMapPaginationMode.Below)
            {
                <partial name="_MapCarouselNav" model="navModel" />
            }
        </div>
        @if (showPagination && map.PaginationMode == MonitoringMapPaginationMode.Below)
        {
            <partial name="_MapCarouselNav" model="navModel" />
        }
    </main>
    <script src="/matui/matui.js?v=@Toolkit.Hash"></script>
    <partial name="_AppScripts" />
</body>
</html>

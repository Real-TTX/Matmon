@page "/Maps/Public/{token}"
@model MapPublicModel
@{
    Layout = null;
    var display = Model.Display!;
    var map = display.Map;
    ViewData["Title"] = map.Name;
    var showPagination = display.Slides.Count > 1 && map.PaginationMode != MonitoringMapPaginationMode.Hidden;
}
<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    @* Reloads the whole page every 30s so a structural change (a new/removed tile, slide, etc.) always
       reaches the wallboard even without the (still-todo, Phase C) live-JSON in-place patch. *@
    <meta http-equiv="refresh" content="30" />
    <title>@map.Name - Matmon</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-map-body">
    <main class="public-map-shell">
        <div class="map-stage"
             data-map-stage
             data-map-fit="@map.WallboardFit.ToString().ToLowerInvariant()"
             style="--map-w: @map.LogicalWidth; --map-h: @map.LogicalHeight;">
            <div class="map-carousel" data-map-carousel data-map-carousel-autoplay data-map-carousel-interval="@map.AutoRotateSeconds">
                @for (var slideIndex = 0; slideIndex < display.Slides.Count; slideIndex++)
                {
                    var slide = display.Slides[slideIndex];
                    var slideModel = new MapSlideRenderModel
                    {
                        Slide = slide.Slide,
                        Map = map,
                        SlideIndex = slideIndex,
                        Tiles = slide.Tiles.Select(tile => MapTileRenderModel.FromDisplay(tile)).ToArray()
                    };
                    <partial name="_MapSlide" model="slideModel" />
                }
            </div>
            @if (showPagination)
            {
                <div class="map-carousel-nav" data-map-carousel-nav>
                    <button type="button" class="map-carousel-arrow" data-map-carousel-prev aria-label="Previous slide">@MatmonIcons.Render("arrow-left")</button>
                    <div class="map-carousel-dots">
                        @for (var dot = 0; dot < display.Slides.Count; dot++)
                        {
                            <button type="button" class="map-carousel-dot @(dot == 0 ? "is-active" : "")" data-map-carousel-dot data-slide-index="@dot">@display.Slides[dot].Slide.Name</button>
                        }
                    </div>
                    <button type="button" class="map-carousel-arrow" data-map-carousel-next aria-label="Next slide">@MatmonIcons.Render("arrow-right")</button>
                </div>
            }
        </div>
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

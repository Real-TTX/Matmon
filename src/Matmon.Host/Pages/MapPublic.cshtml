@page "/Maps/Public/{token}"
@model MapPublicModel
@{
    Layout = null;
    var display = Model.Display!;
    var map = display.Map;
    ViewData["Title"] = map.Name;
    var showPagination = display.Slides.Count > 1 && map.PaginationMode != MonitoringMapPaginationMode.Hidden;
    var navModel = new Matmon.Host.Ui.MapCarouselNavModel(display.Slides.Select(s => s.Slide.Name).ToArray(), map.PaginationMode);
}
<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@map.Name - Matmon</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-map-body"
      data-map-live="/Maps/Public/@map.PublicToken?handler=Data"
      data-map-live-interval="@Math.Clamp(map.AutoRotateSeconds, 10, 120)"
      data-map-live-revision="@Matmon.Host.Ui.MapLiveData.Build(display).Revision">
    <main class="public-map-shell">
        <div class="map-stage" data-map-stage>
            <div class="map-carousel" data-map-carousel data-map-carousel-autoplay="@(map.AutoRotateEnabled ? "" : null)" data-map-carousel-interval="@map.AutoRotateSeconds">
                @for (var slideIndex = 0; slideIndex < display.Slides.Count; slideIndex++)
                {
                    var slide = display.Slides[slideIndex];
                    var slideModel = new MapSlideRenderModel
                    {
                        Slide = slide.Slide,
                        Map = map,
                        SlideIndex = slideIndex,
                        Tiles = slide.Tiles.Select(tile => MapTileRenderModel.FromDisplay(tile, map)).ToArray()
                    };
                    <partial name="_MapSlide" model="slideModel" />
                }
            </div>
            @if (showPagination && map.PaginationMode != MonitoringMapPaginationMode.Below)
            {
                <partial name="_MapCarouselNav" model="navModel" />
            }
        </div>
        @if (showPagination && map.PaginationMode == MonitoringMapPaginationMode.Below)
        {
            <partial name="_MapCarouselNav" model="navModel" />
        }
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

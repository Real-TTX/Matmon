@page "/system/probes/install"
@model ProbeInstallModel
@{
    ViewData["Title"] = "Install probe";
    var backUrl = Model.GetSafeReturnUrl("/Probes");
    var probe = Model.Probe;
    var stateTone = probe is null
        ? null
        : probe.State.Equals("Offline", StringComparison.OrdinalIgnoreCase)
            ? "error"
            : probe.State.Equals("Waiting", StringComparison.OrdinalIgnoreCase) ? "warning" : "ok";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (probe is null)
{
    <div class="mat-empty mat-empty--framed">
        <span class="mat-empty__icon">@MatUi.Icon("server")</span>
        <div class="mat-empty__title">No probe selected</div>
        <p>Open this page from a probe in the probe list to see its install commands.</p>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
}
else
{
    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("server")
            <h2 class="mat-card__title">@probe.Name</h2>
            <span class="@MatUi.PillClass(stateTone) mm-push-end">@probe.State</span>
        </div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Role</dt><dd>@probe.Role</dd>
                <dt>Probe ID</dt><dd class="mat-mono">@probe.ProbeId</dd>
                <dt>Status</dt><dd>@probe.State - @probe.Message</dd>
                <dt>Token</dt><dd>@(Model.CanInstall ? "Ready" : "Missing")</dd>
            </dl>
        </div>
    </section>

    @if (!Model.CanInstall)
    {
        <div class="mat-alert mat-alert--warning" role="status">
            @MatUi.Icon("alert")
            <div class="mat-alert__body">This probe cannot be installed yet. Only secondary probes with an enrollment token can be deployed.</div>
        </div>
    }
    else
    {
        <section class="mat-card">
            <div class="mat-card__head">
                @MatUi.Icon("whale")
                <h2 class="mat-card__title">Install commands</h2>
                <span class="mat-text-muted mm-push-end">run them on the target host</span>
            </div>
            <div class="mat-card__body mat-stack">
                <div data-tabs>
                    <div class="mat-tabs" role="tablist" aria-label="How to start the probe">
                        <button type="button" class="mat-tab" role="tab" id="tab-install-docker" aria-controls="panel-install-docker" aria-selected="true">Docker run</button>
                        <button type="button" class="mat-tab" role="tab" id="tab-install-compose" aria-controls="panel-install-compose" aria-selected="false" tabindex="-1">Compose</button>
                        <button type="button" class="mat-tab" role="tab" id="tab-install-curl" aria-controls="panel-install-curl" aria-selected="false" tabindex="-1">Curl installer</button>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-install-docker" aria-labelledby="tab-install-docker">
                        <div class="mm-snippet">
                            <pre class="mat-code"><code id="probe-install-docker">@Model.BuildDockerRun()</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#probe-install-docker">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-install-compose" aria-labelledby="tab-install-compose" hidden>
                        <p class="mat-muted">Save it as <code>docker-compose.yml</code> and run <code>docker compose up -d</code>.</p>
                        <div class="mm-snippet">
                            <pre class="mat-code"><code id="probe-install-compose">@Model.BuildCompose()</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#probe-install-compose">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                    <div class="mat-tabpanel mat-stack mat-stack--sm" role="tabpanel" id="panel-install-curl" aria-labelledby="tab-install-curl" hidden>
                        <div class="mm-snippet">
                            <pre class="mat-code"><code id="probe-install-curl">@Model.BuildCurlInstaller()</code></pre>
                            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-copy="#probe-install-curl">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                </div>
                <p class="mat-hint">If primary and secondary run on the same Docker host, change the left side of <code>-p 8099:8099</code> to a free port, for example <code>-p 8101:8099</code>.</p>
            </div>
        </section>
    }

    <div class="mat-btn-row">
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
}

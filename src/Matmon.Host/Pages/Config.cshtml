@page
@model ConfigModel
@{
    ViewData["Title"] = "System";
    var storage = Model.Overview.Storage;
    var telemetry = Model.StorageTelemetry;
    var usedPercent = storage.DriveFreePercent.HasValue
        ? Math.Clamp(100 - storage.DriveFreePercent.Value, 0, 100)
        : 0;
    var canManageSystem = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
    var canManageUsers = canManageSystem;
}

<section class="dashboard-shell">
    <div class="page-header has-summary">
        <div class="page-title">
            @MatmonIcons.Render("gear")
            <h1>System</h1>
        </div>
    </div>

    <div class="sensor-tabs system-tabs" role="tablist" aria-label="System sections">
        <a class="sensor-tab @(Model.IsActiveTab("general") ? "is-active" : "")" asp-page="/Config" asp-route-tab="general">Overview</a>
        <a class="sensor-tab @(Model.IsActiveTab("probes") ? "is-active" : "")" asp-page="/Config" asp-route-tab="probes">Probes</a>
        <a class="sensor-tab @(Model.IsActiveTab("storage") ? "is-active" : "")" asp-page="/Config" asp-route-tab="storage">Storage</a>
        @if (canManageSystem)
        {
            <a class="sensor-tab @(Model.IsActiveTab("backup") ? "is-active" : "")" asp-page="/Config" asp-route-tab="backup">Backup</a>
        }
        @if (canManageUsers)
        {
            <a class="sensor-tab @(Model.IsActiveTab("users") ? "is-active" : "")" asp-page="/Config" asp-route-tab="users">Users</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    @if (Model.IsActiveTab("general"))
    {
        <div class="config-grid">
            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("gear")<span>Runtime</span></h2>
                    <a class="panel-hint config-about-link" asp-page="/About">About →</a>
                </div>

                <dl class="config-list">
                    <div class="config-row">
                        <dt>Version</dt>
                        <dd>@Matmon.Host.Services.MatmonVersion.Current <span class="config-channel-tag" data-channel="@Matmon.Host.Services.MatmonVersion.Channel.ToLowerInvariant()">@Matmon.Host.Services.MatmonVersion.Channel</span></dd>
                    </div>
                    <div class="config-row">
                        <dt>Mode</dt>
                        <dd>@Model.Overview.Mode</dd>
                    </div>
                    <div class="config-row">
                        <dt>Heartbeat</dt>
                        <dd>@Model.Overview.HeartbeatIntervalSeconds s</dd>
                    </div>
                    <div class="config-row">
                        <dt>Probe ID</dt>
                        <dd>@(Model.Overview.ProbeId ?? "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Probe name</dt>
                        <dd>@(Model.Overview.ProbeName ?? "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Primary URL</dt>
                        <dd>@(Model.Overview.MasterUrl ?? "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Workspace</dt>
                        <dd>@Model.Overview.WorkspacePath</dd>
                    </div>
                    <div class="config-row">
                        <dt>Seed login</dt>
                        <dd>@Model.Overview.AuthUsername / @Model.Overview.AuthPassword</dd>
                    </div>
                </dl>
            </section>

            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("signal")<span>Endpoints</span></h2>
                    <span class="panel-hint">anonymous health</span>
                </div>

                <dl class="config-list">
                    <div class="config-row"><dt>Health</dt><dd><a href="/healthz" target="_blank" rel="noopener">/healthz</a></dd></div>
                    <div class="config-row"><dt>Mode API</dt><dd><a href="/api/mode" target="_blank" rel="noopener">/api/mode</a></dd></div>
                    <div class="config-row"><dt>About</dt><dd><a asp-page="/About">/About</a></dd></div>
                </dl>

                <p class="workspace-inline-note">Configuration changes are made on the topology and editor pages; the snippets below are reference only.</p>
            </section>
        </div>

        <details class="workspace-details config-reference">
            <summary>
                @MatmonIcons.Render("settings")
                <span>Deployment reference (Docker env &amp; appsettings)</span>
            </summary>
            <div class="workspace-details-body">
                <div class="config-grid">
                    <section class="panel config-block">
                        <div class="panel-header">
                            <h2 class="section-title">@MatmonIcons.Render("arrow-right")<span>Docker env</span></h2>
                            <span class="panel-hint">primary / secondary</span>
                        </div>
                        <pre class="config-code">@Model.Overview.DockerMasterSnippet</pre>
                        <div class="mt-3"></div>
                        <pre class="config-code">@Model.Overview.DockerSlaveSnippet</pre>
                    </section>

                    <section class="panel config-block">
                        <div class="panel-header">
                            <h2 class="section-title">@MatmonIcons.Render("spark")<span>Local appsettings</span></h2>
                            <span class="panel-hint">src/Matmon.Host/appsettings.json</span>
                        </div>
                        <pre class="config-code">@Model.Overview.AppSettingsSnippet</pre>
                    </section>
                </div>
            </div>
        </details>
    }
    else if (Model.IsActiveTab("probes"))
    {
        <section class="panel config-block system-probe-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("probe")<span>Probe status</span></h2>
                <span class="panel-hint">@Model.Overview.Probes.Count configured</span>
            </div>

            <div class="system-table system-probe-table" role="table" aria-label="Configured probes">
                <div class="system-table-row system-table-head system-probe-row @(canManageSystem ? "has-actions" : string.Empty)" role="row">
                    <span role="columnheader">Probe</span>
                    <span role="columnheader">Role</span>
                    <span role="columnheader">Status</span>
                    <span role="columnheader">Last seen</span>
                    <span role="columnheader">Sensors</span>
                    <span role="columnheader">Token</span>
                    @if (canManageSystem)
                    {
                        <span role="columnheader">Actions</span>
                    }
                </div>
                @foreach (var probe in Model.Overview.Probes)
                {
                    var state = probe.State.Equals("Offline", StringComparison.OrdinalIgnoreCase)
                        ? "error"
                        : probe.State.Equals("Waiting", StringComparison.OrdinalIgnoreCase) ? "warning" : "ok";
                    <div class="system-table-row system-probe-row @(canManageSystem ? "has-actions" : string.Empty)" role="row">
                        <span role="cell">
                            <strong>@probe.Name</strong>
                            <small>@probe.ProbeId</small>
                        </span>
                        <span role="cell">@probe.Role</span>
                        <span role="cell">
                            <span class="state-pill" data-state="@state">@probe.State</span>
                            <small>@probe.Message</small>
                        </span>
                        <span role="cell">@Model.FormatDateTime(probe.LastSeenUtc)</span>
                        <span role="cell">@probe.SensorCount</span>
                        <span role="cell">@(probe.EnrollmentToken ?? "-")</span>
                        @if (canManageSystem)
                        {
                            <span role="cell" class="system-probe-actions">
                                <a class="workspace-secondary-submit" asp-page="/ElementEditor" asp-route-selectedId="@probe.ElementId" asp-route-returnUrl="/Config?tab=probes">
                                    @MatmonIcons.Render("pencil")
                                    <span>Edit</span>
                                </a>
                                @if (Model.CanInstallProbe(probe))
                                {
                                    <a class="workspace-secondary-submit" asp-page="/ProbeInstall" asp-route-probeId="@probe.ElementId" asp-route-returnUrl="/Config?tab=probes">
                                        @MatmonIcons.Render("play")
                                        <span>Install</span>
                                    </a>
                                }
                                <form method="post" asp-page-handler="RotateProbeToken" asp-route-probeId="@probe.ElementId">
                                    <button type="submit" class="workspace-secondary-submit">
                                        @MatmonIcons.Render("arrow-right")
                                        <span>Rotate</span>
                                    </button>
                                </form>
                            </span>
                        }
                    </div>
                }
            </div>

            @if (canManageSystem)
            {
                <div class="page-actions workspace-toolbar system-probe-create-actions">
                    <a class="workspace-submit" asp-page="/ProbeCreate" asp-route-returnUrl="/Config?tab=probes">
                        @MatmonIcons.Render("plus")
                        <span>New probe</span>
                    </a>
                </div>
            }
        </section>

        @if (string.Equals(Model.Overview.Mode, "Secondary", StringComparison.OrdinalIgnoreCase))
        {
            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("signal")<span>Secondary exchange</span></h2>
                    <span class="panel-hint">@Model.Overview.SlaveRuntime.StatusMessage</span>
                </div>

                <dl class="config-list compact-config-list">
                    <div class="config-row">
                        <dt>Connected</dt>
                        <dd>@(Model.Overview.SlaveRuntime.IsConnected ? "yes" : "no")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Last heartbeat</dt>
                        <dd>@Model.FormatDateTime(Model.Overview.SlaveRuntime.LastHeartbeatUtc)</dd>
                    </div>
                    <div class="config-row">
                        <dt>Assignments</dt>
                        <dd>@Model.Overview.SlaveRuntime.AssignedSensorCount</dd>
                    </div>
                    <div class="config-row">
                        <dt>Last results</dt>
                        <dd>@Model.Overview.SlaveRuntime.LastExecutedSensorCount</dd>
                    </div>
                </dl>
            </section>
        }
    }
    else if (Model.IsActiveTab("storage"))
    {
        var workspaceBytes = storage.WorkspaceFileBytes ?? 0;
        var telemetryBytes = storage.TelemetryFileBytes ?? 0;
        var backupBytes = storage.BackupFileBytes ?? 0;
        var totalDataBytes = storage.DataDirectoryBytes;
        var otherBytes = Math.Max(0, totalDataBytes - workspaceBytes - telemetryBytes - backupBytes);
        string SegWidth(long part) => (totalDataBytes > 0 ? Math.Round((double)part / totalDataBytes * 100, 3) : 0)
            .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

        <div class="storage-layout">
            <section class="panel config-block storage-hero">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("chart")<span>Storage breakdown</span></h2>
                    <span class="panel-hint">@storage.DataFileCount files</span>
                </div>

                <div class="storage-hero-total">
                    <strong>@storage.FormatBytes(totalDataBytes)</strong>
                    <span>total Matmon data in @storage.DataPath</span>
                </div>

                <div class="storage-stack" role="img" aria-label="Storage breakdown by area">
                    <span class="storage-stack-seg" data-kind="telemetry" style="width:@SegWidth(telemetryBytes)%" title="Telemetry DB"></span>
                    <span class="storage-stack-seg" data-kind="workspace" style="width:@SegWidth(workspaceBytes)%" title="Workspace"></span>
                    <span class="storage-stack-seg" data-kind="backup" style="width:@SegWidth(backupBytes)%" title="Backups"></span>
                    <span class="storage-stack-seg" data-kind="other" style="width:@SegWidth(otherBytes)%" title="Other"></span>
                </div>

                <ul class="storage-legend">
                    <li data-kind="telemetry"><span class="storage-legend-dot"></span><span class="storage-legend-label">Telemetry DB</span><strong>@storage.FormatBytes(telemetryBytes)</strong></li>
                    <li data-kind="workspace"><span class="storage-legend-dot"></span><span class="storage-legend-label">Workspace</span><strong>@storage.FormatBytes(workspaceBytes)</strong></li>
                    <li data-kind="backup"><span class="storage-legend-dot"></span><span class="storage-legend-label">Backups</span><strong>@storage.FormatBytes(backupBytes)</strong></li>
                    <li data-kind="other"><span class="storage-legend-dot"></span><span class="storage-legend-label">Other</span><strong>@storage.FormatBytes(otherBytes)</strong></li>
                </ul>
            </section>

            <div class="storage-cards">
                <section class="panel config-block storage-card">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("signal")<span>Disk capacity</span></h2>
                        <span class="panel-hint">@storage.DriveName</span>
                    </div>

                    <div class="storage-gauge-value">
                        <strong>@ConfigModel.FormatPercent(storage.DriveFreePercent)</strong>
                        <span>free</span>
                    </div>
                    <div class="storage-meter" aria-label="Host disk usage">
                        <span style="width: @usedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                    </div>
                    <dl class="config-list compact-config-list">
                        <div class="config-row">
                            <dt>Available</dt>
                            <dd>@(storage.DriveAvailableGigabytes.HasValue ? $"{storage.DriveAvailableGigabytes.Value:0.##} GB" : "-")</dd>
                        </div>
                        <div class="config-row">
                            <dt>Total</dt>
                            <dd>@(storage.DriveTotalGigabytes.HasValue ? $"{storage.DriveTotalGigabytes.Value:0.##} GB" : "-")</dd>
                        </div>
                    </dl>
                </section>

                <section class="panel config-block storage-card">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("chart")<span>Telemetry database</span></h2>
                        <span class="panel-hint">SQLite · WAL</span>
                    </div>

                    <div class="storage-gauge-value">
                        <strong>@storage.FormatBytes(storage.TelemetryFileBytes)</strong>
                        <span>@(storage.TelemetryFileExists ? "telemetry.db incl. WAL" : "not created yet")</span>
                    </div>
                    <div class="storage-db-counts">
                        <div><strong>@ConfigModel.FormatCount(telemetry.SensorHistoryCount)</strong><span>Observations</span></div>
                        <div><strong>@ConfigModel.FormatCount(telemetry.StatisticsBucketCount)</strong><span>Statistics</span></div>
                        <div><strong>@ConfigModel.FormatCount(telemetry.EventCount)</strong><span>Events</span></div>
                    </div>
                </section>

                <section class="panel config-block storage-card">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("folder")<span>Locations</span></h2>
                        <span class="panel-hint">@(storage.DataDirectoryExists ? "data dir ready" : "data dir missing")</span>
                    </div>
                    <dl class="config-list storage-paths">
                        <div class="config-row"><dt>Workspace</dt><dd title="@storage.WorkspacePath">@storage.WorkspacePath</dd></div>
                        <div class="config-row"><dt>Telemetry</dt><dd title="@storage.TelemetryPath">@storage.TelemetryPath</dd></div>
                        <div class="config-row"><dt>Backups</dt><dd title="@storage.BackupPath">@storage.BackupPath</dd></div>
                    </dl>
                </section>
            </div>
        </div>

        <section class="panel config-block system-cleanup-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("trash")<span>Cleanup</span></h2>
                <span class="panel-hint">Remove old telemetry without touching the structure</span>
            </div>

            @if (canManageSystem)
            {
                <form method="post" asp-page-handler="CleanupStorage" class="workspace-form-grid storage-cleanup-form" onsubmit="return confirm('Cleanup permanently removes the selected historical data. Continue?');">
                    <label class="workspace-field">
                        <span>Scope</span>
                        <select asp-for="StorageCleanup.Scope" asp-items="Model.StorageCleanupScopeOptions"></select>
                    </label>
                    <label class="workspace-field">
                        <span>Delete</span>
                        <select asp-for="StorageCleanup.OlderThanDays" asp-items="Model.StorageCleanupAgeOptions"></select>
                    </label>
                    <p class="workspace-inline-note workspace-span-2">
                        Current topology, templates, credentials and alerts stay untouched. If you choose "All selected data", graphs and latest values are rebuilt on the next sensor runs.
                    </p>
                    <div class="workspace-form-actions workspace-span-2">
                        <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("trash")<span>Run cleanup</span></button>
                    </div>
                </form>
            }
            else
            {
                <p class="workspace-inline-note">Only admins can run storage cleanup.</p>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(storage.ErrorMessage))
        {
            <section class="workspace-banner workspace-banner-warning">
                @MatmonIcons.Render("warning")
                <span>@storage.ErrorMessage</span>
            </section>
        }
    }
    else if (Model.IsActiveTab("backup") && canManageSystem)
    {
        <div class="config-grid config-grid-stack backup-overview-layout">
            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("clock")<span>Backup jobs</span></h2>
                    <span class="panel-hint">@Model.BackupJobs.Count jobs</span>
                </div>

                @if (Model.BackupJobs.Count == 0)
                {
                    <div class="empty-state">No backup jobs configured yet.</div>
                }
                else
                {
                    <div class="backup-job-list" role="list" aria-label="Backup jobs">
                        @foreach (var job in Model.BackupJobs)
                        {
                            var statusState = string.Equals(job.LastStatus, "ok", StringComparison.OrdinalIgnoreCase)
                                ? "ok"
                                : string.Equals(job.LastStatus, "running", StringComparison.OrdinalIgnoreCase)
                                    ? "warning"
                                    : "error";
                            <article class="backup-job-card" role="listitem">
                                <div class="backup-job-card-head">
                                    <div class="backup-job-card-main">
                                        <strong>@job.Name</strong>
                                        <small>@(job.Description ?? "-")</small>
                                    </div>
                                    <div class="backup-job-card-side">
                                        <span class="state-pill" data-state="@statusState">@(job.LastStatus ?? "idle")</span>
                                        <small>@job.Schedule.Summary()</small>
                                    </div>
                                </div>

                                <div class="backup-job-card-meta">
                                    <div class="backup-job-card-meta-item">
                                        <span>Sections</span>
                                        <strong>@ConfigModel.FormatBackupSections(job.Sections)</strong>
                                    </div>
                                    <div class="backup-job-card-meta-item">
                                        <span>Next run</span>
                                        <strong>@Model.FormatDateTime(job.NextRunUtc)</strong>
                                    </div>
                                    <div class="backup-job-card-meta-item">
                                        <span>Last run</span>
                                        <strong>@Model.FormatDateTime(job.LastRunUtc)</strong>
                                    </div>
                                    <div class="backup-job-card-meta-item">
                                        <span>Last message</span>
                                        <strong>@(job.LastMessage ?? "-")</strong>
                                    </div>
                                </div>

                                <div class="backup-job-card-actions">
                                    <a class="workspace-secondary-submit" asp-page="/BackupJobEditor" asp-route-jobId="@job.Id" asp-route-returnUrl="/Config?tab=backup">
                                        @MatmonIcons.Render("pencil")
                                        <span>Edit</span>
                                    </a>
                                    <form method="post" asp-page-handler="RunBackupJob" asp-route-backupJobId="@job.Id">
                                        <button type="submit" class="workspace-secondary-submit">
                                            @MatmonIcons.Render("spark")
                                            <span>Run now</span>
                                        </button>
                                    </form>
                                    @if (!string.IsNullOrWhiteSpace(job.LastSnapshotFileName))
                                    {
                                        <a class="workspace-secondary-submit" asp-page="/BackupRestore" asp-route-fileName="@job.LastSnapshotFileName">
                                            @MatmonIcons.Render("arrow-right")
                                            <span>Restore</span>
                                        </a>
                                    }
                                    <form method="post" asp-page-handler="DeleteBackupJob" asp-route-backupJobId="@job.Id" onsubmit="return confirm('Delete backup job @job.Name?');">
                                        <button type="submit" class="workspace-danger-submit">
                                            @MatmonIcons.Render("trash")
                                            <span>Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }

                <div class="page-actions workspace-toolbar system-backup-create-actions">
                    <a class="workspace-submit" asp-page="/BackupJobEditor" asp-route-returnUrl="/Config?tab=backup">
                        @MatmonIcons.Render("plus")
                        <span>New backup job</span>
                    </a>
                </div>
            </section>

            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("folder")<span>Snapshots</span></h2>
                    <span class="panel-hint">@Model.BackupSnapshots.Count files</span>
                </div>

                @if (Model.BackupSnapshots.Count == 0)
                {
                    <div class="empty-state">No backups have been created yet.</div>
                }
                else
                {
                    <div class="system-table system-backup-snapshot-table" role="table" aria-label="Backup snapshots">
                        <div class="system-table-row system-table-head" role="row">
                            <span role="columnheader">Snapshot</span>
                            <span role="columnheader">Created</span>
                            <span role="columnheader">Size</span>
                            <span role="columnheader">Contents</span>
                            <span role="columnheader">Actions</span>
                        </div>
                        @foreach (var snapshot in Model.BackupSnapshots)
                        {
                            <div class="system-table-row system-backup-row system-backup-snapshot-row" role="row">
                                <span role="cell">
                                    <strong>@snapshot.DisplayName</strong>
                                    <small>@(snapshot.Description ?? "-")</small>
                                    <small>@snapshot.FileName</small>
                                </span>
                                <span role="cell">@Model.FormatDateTime(snapshot.CreatedUtc)</span>
                                <span role="cell">@storage.FormatBytes(snapshot.Bytes)</span>
                                <span role="cell">
                                    <span class="state-pill" data-state="ok">@snapshot.SectionsLabel</span>
                                    <small>@snapshot.ProbeCount probes, @snapshot.SensorCount sensors</small>
                                </span>
                                <span role="cell" class="system-backup-actions">
                                    <a class="workspace-secondary-submit" asp-page="/BackupRestore" asp-route-fileName="@snapshot.FileName">
                                        @MatmonIcons.Render("arrow-right")
                                        <span>Restore</span>
                                    </a>
                                    <a class="workspace-secondary-submit" asp-page="/BackupRestore" asp-page-handler="Download" asp-route-fileName="@snapshot.FileName">
                                        @MatmonIcons.Render("download")
                                        <span>Download</span>
                                    </a>
                                </span>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="panel config-block backup-upload-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("upload")<span>Import backup</span></h2>
                <span class="panel-hint">upload a backup file from disk</span>
            </div>

            <form method="post" asp-page-handler="UploadBackupSnapshot" enctype="multipart/form-data" class="workspace-form backup-upload-form">
                <div class="workspace-form-grid workspace-core-grid">
                    <label class="workspace-field workspace-span-2">
                        <span>Backup file</span>
                        <input type="file" asp-for="BackupUpload" accept=".json,application/json" class="form-control workspace-input" />
                    </label>
                    <p class="workspace-inline-note workspace-span-2">
                        Matmon backup files are stored as JSON. Uploading a file validates it and copies it into the backup archive before opening the restore assistant.
                    </p>
                    <div class="workspace-form-actions workspace-span-2">
                        <button type="submit" class="workspace-submit">
                            @MatmonIcons.Render("upload")
                            <span>Upload backup</span>
                        </button>
                    </div>
                </div>
            </form>
        </section>
    }
    else if (Model.IsActiveTab("users") && canManageUsers)
    {
        <section class="panel config-block">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("lock")<span>Users</span></h2>
            </div>

            <div class="system-table system-user-table" role="table" aria-label="Matmon users">
                <div class="system-table-row system-table-head" role="row">
                    <span role="columnheader">User</span>
                    <span role="columnheader">Role</span>
                    <span role="columnheader">Enabled</span>
                    <span role="columnheader">Updated</span>
                    <span role="columnheader">Actions</span>
                </div>
                @foreach (var user in Model.Users)
                {
                    <div class="system-table-row system-user-row" role="row">
                        <span role="cell">
                            <strong>@user.Username</strong>
                            <small>@user.Id</small>
                            @if (Model.IsCurrentUser(user))
                            {
                                <span class="state-pill" data-state="ok">Current</span>
                            }
                        </span>
                        <span role="cell">@user.Role</span>
                        <span role="cell">
                            <span class="state-pill" data-state="@(user.IsEnabled ? "ok" : "error")">@(user.IsEnabled ? "Enabled" : "Disabled")</span>
                        </span>
                        <span role="cell">@Model.FormatDateTime(user.UpdatedUtc)</span>
                        <span role="cell" class="system-user-actions">
                            @if (!Model.IsCurrentUser(user))
                            {
                                <a class="workspace-secondary-submit" asp-page="/UserEdit" asp-route-userId="@user.Id" asp-route-returnUrl="/Config?tab=users">
                                    @MatmonIcons.Render("pencil")
                                    <span>Edit</span>
                                </a>
                                <form method="post" asp-page-handler="DeleteUser" asp-route-userId="@user.Id" onsubmit="return confirm('Delete user @user.Username?');">
                                    <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("trash")<span>Delete</span></button>
                                </form>
                            }
                            else
                            {
                                <span class="workspace-inline-note">Current account</span>
                            }
                        </span>
                    </div>
                }
            </div>
            <div class="page-actions workspace-toolbar system-user-create-actions">
                <a class="workspace-submit" asp-page="/UserCreate" asp-route-returnUrl="/Config?tab=users">
                    @MatmonIcons.Render("plus")
                    <span>Create user</span>
                </a>
            </div>
        </section>
    }
</section>

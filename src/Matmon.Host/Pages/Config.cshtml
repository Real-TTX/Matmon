@page
@model ConfigModel
@{
    ViewData["Title"] = "System";
    var storage = Model.Overview.Storage;
    var telemetry = Model.StorageTelemetry;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var usedPercent = storage.DriveFreePercent.HasValue
        ? Math.Clamp(100 - storage.DriveFreePercent.Value, 0, 100)
        : 0;
    var canManageSystem = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
    var canManageUsers = canManageSystem;
    // The delivery channel as a pill: a release is the good news, a nightly build the accent, a local build neither.
    var channelTone = Matmon.Probe.MatmonVersion.Channel.ToLowerInvariant() switch
    {
        "release" => "ok",
        "nightly" => "accent",
        _ => "plain"
    };
}

<partial name="_SystemTabs" model="Model.ActiveTab" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (Model.IsActiveTab("general"))
{
    @* A secondary (Docker probe) node shows how its exchange with the primary goes - it has no Probes page of its own. *@
    @if (string.Equals(Model.Overview.Mode, "Secondary", StringComparison.OrdinalIgnoreCase))
    {
        var slave = Model.Overview.SlaveRuntime;
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("activity")<h2 class="mat-card__title">Secondary exchange</h2><span class="mat-text-muted mm-push-end">@slave.StatusMessage</span></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>Connected</dt><dd><span class="@MatUi.PillClass(slave.IsConnected ? "ok" : "error")">@(slave.IsConnected ? "Connected" : "Not connected")</span></dd>
                    <dt>Last heartbeat</dt><dd class="mat-mono">@Model.FormatDateTime(slave.LastHeartbeatUtc)</dd>
                    <dt>Assignments</dt><dd class="mat-mono">@slave.AssignedSensorCount</dd>
                    <dt>Last results</dt><dd class="mat-mono">@slave.LastExecutedSensorCount</dd>
                </dl>
            </div>
        </section>
    }

    <div class="mat-grid mat-grid--2">
        <section class="mat-card">
            <div class="mat-card__head">
                @MatUi.Icon("settings")<h2 class="mat-card__title">Runtime</h2>
                <a class="mat-btn mat-btn--ghost mat-btn--sm mm-push-end" asp-page="/About">@MatUi.Icon("info")<span>About</span></a>
            </div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>Version</dt>
                    <dd>
                        <span class="mat-mono">@Matmon.Probe.MatmonVersion.Current</span>
                        <span class="@MatUi.PillClass(channelTone)">@Matmon.Probe.MatmonVersion.Channel</span>
                    </dd>
                    <dt>Mode</dt><dd>@Model.Overview.Mode</dd>
                    <dt>Heartbeat</dt><dd class="mat-mono">@Model.Overview.HeartbeatIntervalSeconds s</dd>
                    <dt>Polling workers</dt><dd class="mat-mono">@Model.Overview.PollingWorkers</dd>
                    <dt>Probe ID</dt><dd class="mat-mono">@(Model.Overview.ProbeId ?? "-")</dd>
                    <dt>Probe name</dt><dd>@(Model.Overview.ProbeName ?? "-")</dd>
                    <dt>Primary URL</dt><dd class="mat-mono">@(Model.Overview.MasterUrl ?? "-")</dd>
                    <dt>Workspace</dt><dd class="mat-mono">@Model.Overview.WorkspacePath</dd>
                    @* The seed admin's user name only - its password is never shown (it used to be, in plain text). *@
                    <dt>Seed login</dt><dd class="mat-mono">@(string.IsNullOrWhiteSpace(Model.Overview.AuthUsername) ? "-" : Model.Overview.AuthUsername)</dd>
                </dl>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("activity")<h2 class="mat-card__title">Endpoints</h2><span class="mat-text-muted mm-push-end">anonymous health</span></div>
            <div class="mat-card__body mat-stack">
                <dl class="mat-kv">
                    <dt>Health</dt><dd class="mat-mono"><a href="/healthz" target="_blank" rel="noopener">/healthz</a></dd>
                    <dt>Mode API</dt><dd class="mat-mono"><a href="/api/mode" target="_blank" rel="noopener">/api/mode</a></dd>
                    <dt>About</dt><dd class="mat-mono"><a asp-page="/About">/About</a></dd>
                </dl>
                <p class="mat-muted">Configuration changes are made on the topology and editor pages.</p>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("network")<h2 class="mat-card__title">SNMP MIBs</h2><span class="mat-text-muted mm-push-end">names for SNMP walks</span></div>
            <div class="mat-card__body">
                <p class="mat-muted">Upload vendor MIB files so SNMP walks show names, status texts and units instead of bare OIDs. The standard MIBs (interfaces, system, storage, IP, Net-SNMP / UCD) are built in.</p>
            </div>
            <div class="mat-card__foot">
                <a class="mat-btn mat-btn--secondary" href="/system/mibs">@MatUi.Icon("upload")<span>Manage MIBs</span></a>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("terminal")<h2 class="mat-card__title">Local program allow-list</h2><span class="mat-text-muted mm-push-end">Local Program sensor</span></div>
            <div class="mat-card__body mat-stack">
                @{
                    var allowedPrograms = Matmon.Core.Domain.LocalProgramSensorExecutor.ReadAllowList();
                }
                @if (allowedPrograms.Count == 0)
                {
                    <p class="mat-muted">No program paths are allowed yet. The <strong>Local Program</strong> sensor only runs executables listed here - set the <code>Matmon__AllowedProgramPaths</code> environment variable (semicolon-separated absolute paths or directories), then restart.</p>
                }
                else
                {
                    <dl class="mat-kv">
                        @foreach (var allowed in allowedPrograms)
                        {
                            <dt>Allowed</dt><dd class="mat-mono">@allowed</dd>
                        }
                    </dl>
                    <p class="mat-muted">Configured via <code>Matmon__AllowedProgramPaths</code>. Each entry is an exact executable path or a directory whose programs may run.</p>
                }
            </div>
        </section>

        @if (canManageSystem)
        {
            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("clock")<h2 class="mat-card__title">Display timezone</h2><span class="mat-text-muted mm-push-end">system default</span></div>
                <div class="mat-card__body">
                    <form method="post" asp-page-handler="DisplayTimeZone" class="mat-form" novalidate>
                        <div class="mat-field">
                            <label class="mat-label" for="DisplayTimeZoneId">Timezone</label>
                            <select asp-for="DisplayTimeZoneId" asp-items="Model.TimeZoneItems" class="mat-select"></select>
                            <span class="mat-hint">Default zone for rendering timestamps. Each user can override it on their own <a asp-page="/Account">Account</a> page. Data is always stored in UTC.</span>
                        </div>
                        <div class="mat-btn-row">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save</span></button>
                        </div>
                    </form>
                </div>
            </section>

            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("sparkles")<h2 class="mat-card__title">Setup assistant</h2><span class="mat-text-muted mm-push-end">guided setup</span></div>
                <div class="mat-card__body">
                    <p class="mat-muted">Re-run the guided setup any time - reconnect the cloud, add networks, run discovery, enable two-factor. Nothing is reset; each step is optional and picks up your current configuration.</p>
                </div>
                <div class="mat-card__foot">
                    <a class="mat-btn mat-btn--primary" href="/setup/wizard">@MatUi.Icon("sparkles")<span>Launch setup assistant</span></a>
                </div>
            </section>
        }
    </div>
}
else if (Model.IsActiveTab("storage"))
{
    var workspaceBytes = storage.WorkspaceFileBytes ?? 0;
    var telemetryBytes = storage.TelemetryFileBytes ?? 0;
    var backupBytes = storage.BackupFileBytes ?? 0;
    var totalDataBytes = storage.DataDirectoryBytes;
    var otherBytes = Math.Max(0, totalDataBytes - workspaceBytes - telemetryBytes - backupBytes);
    string SegWidth(long part) => (totalDataBytes > 0 ? Math.Round((double)part / totalDataBytes * 100, 3) : 0)
        .ToString("0.###", invariant);
    var usedValue = usedPercent.ToString("0.##", invariant);
    var diskTone = usedPercent >= 90 ? "error" : usedPercent >= 80 ? "warn" : "ok";

    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("bar-chart")<h2 class="mat-card__title">Storage breakdown</h2><span class="mat-text-muted mm-push-end">@storage.DataFileCount files</span></div>
        <div class="mat-card__body mat-stack">
            <div class="mat-stat">
                <span class="mat-stat__value">@storage.FormatBytes(totalDataBytes)</span>
                <span class="mat-stat__label">total Matmon data in <span class="mat-mono mm-break">@storage.DataPath</span></span>
            </div>
            <div class="mat-meter mat-meter--lg mat-meter--stack" role="img"
                 aria-label="Storage breakdown: Telemetry DB @storage.FormatBytes(telemetryBytes), Workspace @storage.FormatBytes(workspaceBytes), Backups @storage.FormatBytes(backupBytes), Other @storage.FormatBytes(otherBytes)">
                <div class="mat-meter__fill" data-value="@SegWidth(telemetryBytes)"></div>
                <div class="mat-meter__fill" data-value="@SegWidth(workspaceBytes)" data-tone="ok"></div>
                <div class="mat-meter__fill" data-value="@SegWidth(backupBytes)" data-tone="warn"></div>
            </div>
            <div class="mat-row">
                <span class="mat-pill mat-pill--accent">Telemetry DB @storage.FormatBytes(telemetryBytes)</span>
                <span class="mat-pill mat-pill--ok">Workspace @storage.FormatBytes(workspaceBytes)</span>
                <span class="mat-pill mat-pill--warn">Backups @storage.FormatBytes(backupBytes)</span>
                <span class="mat-pill mat-pill--plain">Other @storage.FormatBytes(otherBytes)</span>
            </div>
        </div>
    </section>

    <div class="mat-grid mat-grid--3">
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("hard-drive")<h2 class="mat-card__title">Disk capacity</h2><span class="mat-text-muted mat-mono mm-push-end">@storage.DriveName</span></div>
            <div class="mat-card__body mat-stack">
                <div class="mat-stat">
                    <span class="mat-stat__value">@ConfigModel.FormatPercent(storage.DriveFreePercent)</span>
                    <span class="mat-stat__label">free</span>
                </div>
                <div class="mat-meter" role="progressbar" aria-valuenow="@usedValue" aria-valuemin="0" aria-valuemax="100" aria-label="Host disk usage">
                    <div class="mat-meter__fill" data-value="@usedValue" data-tone="@diskTone"></div>
                </div>
                <dl class="mat-kv">
                    <dt>Available</dt><dd class="mat-mono">@(storage.DriveAvailableGigabytes.HasValue ? $"{storage.DriveAvailableGigabytes.Value:0.##} GB" : "-")</dd>
                    <dt>Total</dt><dd class="mat-mono">@(storage.DriveTotalGigabytes.HasValue ? $"{storage.DriveTotalGigabytes.Value:0.##} GB" : "-")</dd>
                </dl>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("database")<h2 class="mat-card__title">Telemetry database</h2><span class="mat-text-muted mm-push-end">SQLite · WAL</span></div>
            <div class="mat-card__body mat-stack">
                <div class="mat-stat">
                    <span class="mat-stat__value">@storage.FormatBytes(storage.TelemetryFileBytes)</span>
                    <span class="mat-stat__label">@(storage.TelemetryFileExists ? "telemetry.db incl. WAL" : "not created yet")</span>
                </div>
                <dl class="mat-kv">
                    <dt>Observations</dt><dd class="mat-mono">@ConfigModel.FormatCount(telemetry.SensorHistoryCount)</dd>
                    <dt>Statistics</dt><dd class="mat-mono">@ConfigModel.FormatCount(telemetry.StatisticsBucketCount)</dd>
                    <dt>Events</dt><dd class="mat-mono">@ConfigModel.FormatCount(telemetry.EventCount)</dd>
                </dl>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("folder")<h2 class="mat-card__title">Locations</h2><span class="mat-text-muted mm-push-end">@(storage.DataDirectoryExists ? "data dir ready" : "data dir missing")</span></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>Workspace</dt><dd class="mat-mono" title="@storage.WorkspacePath">@storage.WorkspacePath</dd>
                    <dt>Telemetry</dt><dd class="mat-mono" title="@storage.TelemetryPath">@storage.TelemetryPath</dd>
                    <dt>Backups</dt><dd class="mat-mono" title="@storage.BackupPath">@storage.BackupPath</dd>
                </dl>
            </div>
        </section>
    </div>

    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("broom")<h2 class="mat-card__title">Cleanup</h2><span class="mat-text-muted mm-push-end">Remove old telemetry without touching the structure</span></div>
        <div class="mat-card__body">
            @if (canManageSystem)
            {
                <form method="post" asp-page-handler="CleanupStorage" class="mat-form" novalidate>
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="StorageCleanup_Scope">Scope</label>
                            <select asp-for="StorageCleanup.Scope" asp-items="Model.StorageCleanupScopeOptions" class="mat-select"></select>
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="StorageCleanup_OlderThanDays">Delete</label>
                            <select asp-for="StorageCleanup.OlderThanDays" asp-items="Model.StorageCleanupAgeOptions" class="mat-select"></select>
                        </div>
                    </div>
                    <p class="mat-muted">Current topology, templates, credentials and alerts stay untouched. If you choose "All selected data", graphs and latest values are rebuilt on the next sensor runs.</p>
                    <div class="mat-btn-row">
                        <span class="mat-btn-row__spacer"></span>
                        <button type="submit" class="mat-btn mat-btn--danger" data-confirm="Cleanup permanently removes the selected historical data. Continue?" data-confirm-ok="Run cleanup">@MatUi.Icon("trash")<span>Run cleanup</span></button>
                    </div>
                </form>
            }
            else
            {
                <p class="mat-muted">Only admins can run storage cleanup.</p>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(storage.ErrorMessage))
    {
        <div class="mat-alert mat-alert--warning" role="status">@MatUi.Icon("alert")<div class="mat-alert__body">@storage.ErrorMessage</div></div>
    }
}
else if (Model.IsActiveTab("backup") && canManageSystem)
{
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("clock")<h2 class="mat-card__title">Backup jobs</h2><span class="mat-text-muted mm-push-end">@Model.BackupJobs.Count jobs</span></div>
        @if (Model.BackupJobs.Count == 0)
        {
            <div class="mat-card__body"><p class="mat-muted">No backup jobs configured yet.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Backup jobs</caption>
                    <thead>
                        <tr>
                            <th scope="col">Job</th>
                            <th scope="col">Status</th>
                            <th scope="col">Destination</th>
                            <th scope="col" class="mat-hide-sm">Next run</th>
                            <th scope="col" class="mat-hide-sm">Last run</th>
                            <th scope="col" class="mat-hide-sm">Last message</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.BackupJobs)
                        {
                            var statusTone = job.LastStatus is null
                                ? "plain"
                                : string.Equals(job.LastStatus, "ok", StringComparison.OrdinalIgnoreCase)
                                    ? "ok"
                                    : string.Equals(job.LastStatus, "running", StringComparison.OrdinalIgnoreCase)
                                        ? "warning"
                                        : "error";
                            var isCloud = job.Destination == BackupDestination.Cloud;
                            <tr>
                                <td data-label="Job" class="mat-table__primary">
                                    <div class="mat-table__name">
                                        <span>
                                            <a asp-page="/BackupJobEditor" asp-route-jobId="@job.Id" asp-route-returnUrl="/Config?tab=backup">@job.Name</a>
                                            <small>@(job.Description ?? "-")</small>
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <span class="@MatUi.PillClass(statusTone)">@(job.LastStatus ?? "idle")</span>
                                    <small class="mat-d-block mat-text-muted">@job.Schedule.Summary()</small>
                                </td>
                                <td data-label="Destination">
                                    @(isCloud ? "Matmon.Cloud (off-site)" : "Local disk")
                                    <small class="mat-d-block mat-text-muted">@(isCloud ? "Config only (off-site)" : ConfigModel.FormatBackupSections(job.Sections))</small>
                                </td>
                                <td data-label="Next run" class="mat-hide-sm mat-mono">@Model.FormatDateTime(job.NextRunUtc)</td>
                                <td data-label="Last run" class="mat-hide-sm mat-mono">@Model.FormatDateTime(job.LastRunUtc)</td>
                                <td data-label="Last message" class="mat-hide-sm">@(job.LastMessage ?? "-")</td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/BackupJobEditor" asp-route-jobId="@job.Id" asp-route-returnUrl="/Config?tab=backup" aria-label="Edit @job.Name" data-tip="Edit">@MatUi.Icon("edit")</a>
                                        <form method="post" asp-page-handler="RunBackupJob" asp-route-backupJobId="@job.Id">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Run @job.Name now" data-tip="Run now">@MatUi.Icon("play")</button>
                                        </form>
                                        @if (!string.IsNullOrWhiteSpace(job.LastSnapshotFileName))
                                        {
                                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/BackupRestore" asp-route-fileName="@job.LastSnapshotFileName" aria-label="Restore the last backup of @job.Name" data-tip="Restore">@MatUi.Icon("restore")</a>
                                        }
                                        <form method="post" asp-page-handler="DeleteBackupJob" asp-route-backupJobId="@job.Id">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Delete @job.Name" data-tip="Delete"
                                                    data-confirm="Delete backup job @job.Name?" data-confirm-ok="Delete">@MatUi.Icon("trash")</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" asp-page="/BackupJobEditor" asp-route-returnUrl="/Config?tab=backup">@MatUi.Icon("plus")<span>New backup job</span></a>
    </div>

    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("cloud")<h2 class="mat-card__title">Cloud backup</h2>
            @if (Model.CloudBackupsAvailable)
            {
                <span class="mat-text-muted mm-push-end">@Model.CloudBackups.Count in cloud</span>
            }
        </div>
        @if (Model.CloudSettings?.Configured == true || Model.CloudBackupsAvailable)
        {
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">Store this instance's configuration (topology, sensors, templates, notifications, maps) in Matmon.Cloud for disaster recovery or re-provisioning. Telemetry and local users are excluded; the newest 10 are kept. <strong>Set a passphrase</strong> to make the backup <strong>portable</strong> - its credentials then restore onto <em>any</em> instance that has the passphrase; without one, secrets restore only on this same instance.</p>
                <form method="post" asp-page-handler="CloudBackupNow" class="mat-form mat-form--inline" novalidate>
                    <div class="mat-field">
                        <label class="mat-label" for="cloud-backup-passphrase">Passphrase <span class="mat-text-muted">(optional)</span></label>
                        <input type="password" id="cloud-backup-passphrase" name="passphrase" class="mat-input" placeholder="Optional passphrase (portable secrets)" autocomplete="new-password" />
                    </div>
                    <div class="mat-field mat-field--auto">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("cloud")<span>Back up to cloud now</span></button>
                    </div>
                </form>
                <p class="mat-hint">Keep the passphrase safe - it cannot be recovered, and without it the credentials in a portable backup can't be restored.</p>
                @if (Model.CloudBackups.Count == 0)
                {
                    <p class="mat-muted">@(Model.CloudBackupsAvailable ? "No cloud backups yet." : "Cloud backups are currently unavailable (cloud offline?).")</p>
                }
            </div>
            @if (Model.CloudBackups.Count > 0)
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">Cloud backups</caption>
                        <thead>
                            <tr>
                                <th scope="col">Backup</th>
                                <th scope="col">Created</th>
                                <th scope="col" class="mat-num">Size</th>
                                <th scope="col"><span class="mat-sr-only">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cloudBackup in Model.CloudBackups)
                            {
                                <tr>
                                    <td data-label="Backup" class="mat-table__primary">@cloudBackup.Label</td>
                                    <td data-label="Created" class="mat-mono">@cloudBackup.CreatedUtc.ToLocalTime().ToString("g")</td>
                                    <td data-label="Size" class="mat-num mat-mono">@($"{cloudBackup.SizeBytes / 1024.0:0.#} KB")</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            <form method="post" asp-page-handler="CloudRestoreBackup" asp-route-backupId="@cloudBackup.Id" class="system-restore-form">
                                                <div class="mat-input-group mat-input-group--sm">
                                                    <input type="password" name="passphrase" class="mat-input" placeholder="Passphrase (if encrypted)" autocomplete="off" aria-label="Passphrase for @cloudBackup.Label (if encrypted)" />
                                                    <button type="submit" class="mat-btn mat-btn--secondary"
                                                            data-confirm="Restore this cloud backup? It overwrites the current configuration." data-confirm-ok="Restore">@MatUi.Icon("restore")<span>Restore</span></button>
                                                </div>
                                            </form>
                                            <form method="post" asp-page-handler="CloudDeleteBackup" asp-route-backupId="@cloudBackup.Id">
                                                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Delete @cloudBackup.Label" data-tip="Delete"
                                                        data-confirm="Delete this cloud backup?" data-confirm-ok="Delete">@MatUi.Icon("trash")</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="mat-card__body">
                <div class="mat-empty">
                    <span class="mat-empty__icon">@MatUi.Icon("cloud")</span>
                    <div class="mat-empty__title">Not connected</div>
                    <p>Connect this instance to Matmon.Cloud (System → Cloud) to store backups off-site.</p>
                    <a class="mat-btn mat-btn--secondary" asp-page="/Config" asp-route-tab="cloud">@MatUi.Icon("cloud")<span>Open Cloud</span></a>
                </div>
            </div>
        }
    </section>

    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("archive")<h2 class="mat-card__title">Snapshots</h2><span class="mat-text-muted mm-push-end">@Model.BackupSnapshots.Count files</span></div>
        @if (Model.BackupSnapshots.Count == 0)
        {
            <div class="mat-card__body"><p class="mat-muted">No backups have been created yet.</p></div>
        }
        else
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Backup snapshots</caption>
                    <thead>
                        <tr>
                            <th scope="col">Snapshot</th>
                            <th scope="col">Created</th>
                            <th scope="col" class="mat-num">Size</th>
                            <th scope="col" class="mat-hide-sm">Contents</th>
                            <th scope="col"><span class="mat-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var snapshot in Model.BackupSnapshots)
                        {
                            <tr>
                                <td data-label="Snapshot" class="mat-table__primary">
                                    <div class="mat-table__name">
                                        <span>
                                            <a asp-page="/BackupRestore" asp-route-fileName="@snapshot.FileName">@snapshot.DisplayName</a>
                                            <small>@(snapshot.Description ?? "-")</small>
                                            <small class="mat-mono mm-break">@snapshot.FileName</small>
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Created" class="mat-mono">@Model.FormatDateTime(snapshot.CreatedUtc)</td>
                                <td data-label="Size" class="mat-num mat-mono">@storage.FormatBytes(snapshot.Bytes)</td>
                                <td data-label="Contents" class="mat-hide-sm">
                                    <span class="mat-tag">@snapshot.SectionsLabel</span>
                                    <small class="mat-d-block mat-text-muted">@snapshot.ProbeCount probes, @snapshot.SensorCount sensors</small>
                                </td>
                                <td class="mat-table__cell-actions">
                                    <div class="mat-table__actions">
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/BackupRestore" asp-route-fileName="@snapshot.FileName" aria-label="Restore @snapshot.DisplayName" data-tip="Restore">@MatUi.Icon("restore")</a>
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/BackupRestore" asp-page-handler="Download" asp-route-fileName="@snapshot.FileName" aria-label="Download @snapshot.DisplayName" data-tip="Download">@MatUi.Icon("download")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("upload")<h2 class="mat-card__title">Import backup</h2><span class="mat-text-muted mm-push-end">upload a backup file from disk</span></div>
        <div class="mat-card__body">
            <form method="post" asp-page-handler="UploadBackupSnapshot" enctype="multipart/form-data" class="mat-form" novalidate>
                <div class="mat-field">
                    <label class="mat-label" for="BackupUpload">Backup file</label>
                    <div class="mat-upload mat-upload--compact" data-upload>
                        <input type="file" asp-for="BackupUpload" accept=".json,application/json" class="mat-upload__input" aria-describedby="backup-upload-hint" />
                    </div>
                    <span class="mat-hint" id="backup-upload-hint">Matmon backup files are stored as JSON. Uploading a file validates it and copies it into the backup archive before opening the restore assistant.</span>
                </div>
                <div class="mat-btn-row">
                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("upload")<span>Upload backup</span></button>
                </div>
            </form>
        </div>
    </section>
}
else if (Model.IsActiveTab("reports") && canManageSystem)
{
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("mail")<h2 class="mat-card__title">Summary report</h2><span class="mat-text-muted mm-push-end">Moved to Notifications</span></div>
        <div class="mat-card__body">
            <p class="mat-muted">The scheduled summary report now lives with the other notifications - as the <strong>Scheduled</strong> entry in the unified Notifications list, with the same Sender/Receiver options.</p>
        </div>
        <div class="mat-card__foot">
            <a class="mat-btn mat-btn--primary" asp-page="/NotificationReportEditor">@MatUi.Icon("mail")<span>Open scheduled report</span></a>
        </div>
    </section>
}
else if (Model.IsActiveTab("cloud") && canManageSystem)
{
    var linkActive = Model.CloudLinkActive;
    var lastStatus = Model.CloudConnection.LastStatus;
    var ok = string.Equals(lastStatus, "ok", StringComparison.OrdinalIgnoreCase);
    var overLimit = !Model.License.IsUnlimited && Model.ProbeCount > Model.License.ProbeLimit;
    // The link and the tunnel as pills with words (COLOR-04); the full sentence stays next to the pill when it says more.
    var statusTone = ok ? "ok" : lastStatus is null ? "busy" : "warn";
    var statusWord = ok ? "Connected" : lastStatus is null ? "Connecting" : "Problem";
    var tunnel = Model.TunnelStatus;
    var tunnelTone = !tunnel.Enabled || tunnel.NotIncludedInPlan ? "plain" : tunnel.Connected ? "ok" : "warn";
    var tunnelWord = !tunnel.Enabled ? "Off" : tunnel.NotIncludedInPlan ? "Not in plan" : tunnel.Connected ? "Connected" : "Not connected";

    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("key")<h2 class="mat-card__title">Plan</h2>
            <a class="mat-btn mat-btn--ghost mat-btn--sm mm-push-end" asp-page="/Config" asp-route-tab="license">@MatUi.Icon("arrow-right")<span>License</span></a>
        </div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Plan</dt><dd>@Model.License.DisplayName@(Model.License.IsFallback ? " (unlicensed)" : "")</dd>
                <dt>Probes</dt>
                <dd>
                    <span class="mat-mono">@Model.ProbeCount / @Model.License.ProbeLimitDisplay</span>
                    @if (Model.AgentCount > 0)
                    {
                        <span class="mat-text-muted">+ @Model.AgentCount agent@(Model.AgentCount == 1 ? "" : "s") (not counted)</span>
                    }
                    @if (overLimit)
                    {
                        <span class="mat-pill mat-pill--error">Over limit - can't add more</span>
                    }
                </dd>
                <dt>Sensors</dt><dd class="mat-mono">@Model.SensorCount / @Model.License.SensorLimitDisplay</dd>
                <dt>Full Access</dt><dd>@(Model.License.TunnelEnabled ? "included" : "not included")</dd>
                @if (Model.License.CloudSensorsEnabled)
                {
                    <dt>Cloud sensors</dt><dd class="mat-mono">@(Model.License.CloudSensorLimit < 0 ? "∞" : Model.License.CloudSensorLimit.ToString())</dd>
                }
                @if (Model.License.ExpiresUtc is not null)
                {
                    <dt>Expires</dt><dd class="mat-mono">@Model.FormatDateTime(Model.License.ExpiresUtc)</dd>
                }
            </dl>
        </div>
    </section>

    @if (linkActive)
    {
        @* Connected: the connection identity is locked (disconnect to change). Only the display name is editable. *@
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("cloud")<h2 class="mat-card__title">Matmon.Cloud connection</h2></div>
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">Link this instance to the Matmon.Cloud control plane (heartbeat, public status, notification gateway).</p>

                @if (Model.CloudEnvLinkActive)
                {
                    <div class="mat-alert mat-alert--warning" role="status">
                        @MatUi.Icon("alert")
                        <div class="mat-alert__body">
                            <span class="mat-alert__title">This link comes from environment variables</span>
                            <span>(<code>Matmon__CloudInstanceId</code> and <code>Matmon__CloudInstanceToken</code>), not from this instance's own data. A fresh installation started with the same environment links itself to the same cloud instance again - license included. Keep the link here, or unlink to make this installation a different instance.</span>
                            <div class="mat-alert__actions">
                                <form method="post" asp-page-handler="CloudKeepEnvLink">
                                    <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm">@MatUi.Icon("check")<span>Keep this link</span></button>
                                </form>
                                <form method="post" asp-page-handler="CloudUnlinkEnvLink">
                                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm"
                                            data-confirm="Unlink this installation from the cloud instance set in the environment?" data-confirm-ok="Unlink">@MatUi.Icon("plug")<span>Unlink</span></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <dl class="mat-kv">
                    <dt>Cloud URL</dt><dd class="mat-mono">@(Model.CloudUrl ?? "–")</dd>
                    <dt>Instance id</dt><dd class="mat-mono">@(Model.CloudConnection.InstanceId?.ToString() ?? Model.CloudSettings.InstanceId ?? "–")</dd>
                    <dt>Status</dt>
                    <dd>
                        <span class="@MatUi.PillClass(statusTone)">@statusWord</span>
                        @if (!ok && lastStatus is not null)
                        {
                            <span class="mat-text-muted">@lastStatus</span>
                        }
                    </dd>
                    <dt>Last heartbeat</dt>
                    <dd>
                        <span class="mat-mono">@Model.FormatDateTime(Model.CloudConnection.LastHeartbeatUtc)</span>
                        @if (Model.HeartbeatStale)
                        {
                            <span class="mat-pill mat-pill--warn">Link degraded</span>
                            <span class="mat-text-muted">no recent successful heartbeat</span>
                        }
                    </dd>
                    <dt>Full Access</dt>
                    <dd>
                        <span class="@MatUi.PillClass(tunnelTone)">@tunnelWord</span>
                        @if (!string.Equals(Model.TunnelStatusText, tunnelWord, StringComparison.Ordinal))
                        {
                            <span class="mat-text-muted">@Model.TunnelStatusText</span>
                        }
                    </dd>
                </dl>

                @if (Model.CloudStatusUnauthorized || Model.CloudStatusDeactivated)
                {
                    <div class="mat-alert mat-alert--warning" role="alert">
                        @MatUi.Icon("alert")
                        <div class="mat-alert__body">
                            @if (Model.CloudStatusDeactivated)
                            {
                                <span>This instance was <strong>deactivated by the cloud administrator</strong>. Contact your provider to reactivate it - reconnecting won't lift an admin deactivation.</span>
                            }
                            else
                            {
                                <span>Matmon.Cloud no longer accepts this instance's token (it was disconnected in the cloud, or the token was rotated). <strong>Reconnect</strong> to link it again with a fresh token.</span>
                                <form method="post" asp-page-handler="CloudReconnect" class="mat-alert__actions">
                                    <button type="submit" class="mat-btn mat-btn--secondary mat-btn--sm">@MatUi.Icon("refresh")<span>Disconnect &amp; reconnect</span></button>
                                </form>
                            }
                        </div>
                    </div>
                }

                <p class="mat-muted">Connection details are locked while connected - <strong>Disconnect</strong> to change the cloud URL or link a different instance. Takes effect within a few seconds, no restart needed.</p>
                <form method="post" asp-page-handler="CloudDisconnect">
                    <div class="mat-btn-row">
                        <span class="mat-btn-row__spacer"></span>
                        <button type="submit" class="mat-btn mat-btn--danger"
                                data-confirm="Disconnect this instance from Matmon.Cloud? The heartbeat stops, and the alert relay and Full Access are switched off - turn them on again after reconnecting." data-confirm-ok="Disconnect">@MatUi.Icon("plug")<span>Disconnect</span></button>
                    </div>
                </form>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("settings")<h2 class="mat-card__title">Name and heartbeat</h2></div>
            <div class="mat-card__body mat-stack">
                <form method="post" asp-page-handler="CloudRename" class="mat-form mat-form--inline" novalidate>
                    <div class="mat-field">
                        <label class="mat-label" for="CloudRenameName">Cloud display name</label>
                        <input asp-for="CloudRenameName" class="mat-input" placeholder="@(Model.CloudSettings.InstanceId is null ? "This instance" : "Name shown in Matmon.Cloud")" autocomplete="off" />
                    </div>
                    <div class="mat-field mat-field--auto">
                        <button type="submit" class="mat-btn mat-btn--secondary">@MatUi.Icon("save")<span>Update name</span></button>
                    </div>
                </form>
                <p class="mat-hint">Sets how this instance is named across Matmon.Cloud (switcher, dashboard).</p>

                <form method="post" asp-page-handler="CloudBeat" class="mat-form mat-form--inline" novalidate>
                    <div class="mat-field">
                        <label class="mat-label" for="CloudHeartbeatSeconds">Heartbeat interval (seconds)</label>
                        <input asp-for="CloudHeartbeatSeconds" type="number" min="15" step="5" class="mat-input mat-mono" data-msg-range="At least 15 seconds." />
                    </div>
                    <div class="mat-field mat-field--auto">
                        <button type="submit" class="mat-btn mat-btn--secondary">@MatUi.Icon("save")<span>Update interval</span></button>
                    </div>
                </form>
                <p class="mat-hint">How often this instance checks in with the cloud (min 15s, default 30s). The cloud derives its offline grace from this value, so any cadence is safe - a slower beat just means the cloud notices an outage a little later.</p>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("bell")<h2 class="mat-card__title">Alert relay</h2></div>
            <div class="mat-card__body">
                <form method="post" asp-page-handler="CloudRelay" class="mat-form" novalidate>
                    <p class="mat-muted">Let Matmon.Cloud deliver your alerts - useful when this instance has no SMTP of its own. When enabled, a <strong>Matmon Cloud</strong> notification sender becomes available: pick it in a <a asp-page="/Notifications">notification rule</a> and the cloud delivers to that rule's receiver. No SMTP or recipients to configure here.</p>
                    <label class="mat-switch">
                        <input asp-for="CloudRelay.RelayAlerts" type="checkbox" />
                        <span class="mat-switch__track"></span>
                        <span>Enable the Matmon Cloud sender</span>
                    </label>
                    <div class="mat-btn-row">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save relay settings</span></button>
                    </div>
                </form>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("monitor")<h2 class="mat-card__title">Full Access</h2><span class="@MatUi.PillClass(tunnelTone) mm-push-end">@tunnelWord</span></div>
            <div class="mat-card__body">
                <form method="post" asp-page-handler="CloudFullAccess" class="mat-form" novalidate>
                    <p class="mat-muted">Keep an outbound tunnel open so you can operate this instance's UI directly from Matmon.Cloud (no inbound port). You still sign in on this instance.</p>
                    <label class="mat-switch">
                        <input asp-for="CloudFullAccess" type="checkbox" />
                        <span class="mat-switch__track"></span>
                        <span>Allow operating this instance through Matmon.Cloud</span>
                    </label>
                    <div class="mat-btn-row">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save Full Access</span></button>
                    </div>
                </form>
            </div>
        </section>
    }
    else
    {
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("cloud")<h2 class="mat-card__title">Matmon.Cloud connection</h2><span class="mat-pill mat-pill--plain mm-push-end">Not connected</span></div>
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">Link this instance to the Matmon.Cloud control plane (heartbeat, public status, notification gateway).</p>
                <p>Give this instance a name, then <strong>Connect</strong> - you'll sign in to Matmon.Cloud in your browser and confirm. The instance links itself to your account automatically; no password is entered here.</p>
                <form method="post" asp-page-handler="CloudClaim" class="mat-form" novalidate>
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="CloudProvision_Url">Cloud URL</label>
                            <input asp-for="CloudProvision.Url" class="mat-input mat-mono" placeholder="https://cloud.matmon.eu" autocomplete="off" />
                        </div>
                        <div class="mat-field">
                            <label class="mat-label" for="CloudProvision_Name">Instance name</label>
                            <input asp-for="CloudProvision.Name" class="mat-input" />
                        </div>
                    </div>
                    <div class="mat-btn-row">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("link")<span>Connect</span></button>
                    </div>
                </form>

                <details class="mat-collapse">
                    <summary><span>Advanced - connect with e-mail + password, or an existing instance id + token</span>@MatUi.Icon("chevron-down", "mat-accordion__chev")</summary>
                    <div class="mat-accordion__body">
                        <div class="mat-form__section">
                            <div class="mat-form__section-head">
                                <h3>With e-mail and password</h3>
                                <p>Headless sign-in: register this instance with your cloud account credentials.</p>
                            </div>
                            <form method="post" asp-page-handler="CloudProvision" class="mat-form" novalidate>
                                <div class="mat-form__grid">
                                    <div class="mat-field mat-field--full">
                                        <label class="mat-label" for="provision-url">Cloud URL</label>
                                        <input asp-for="CloudProvision.Url" id="provision-url" class="mat-input mat-mono" placeholder="https://cloud.matmon.eu" autocomplete="off" />
                                    </div>
                                    <div class="mat-field">
                                        <label class="mat-label" for="provision-email">Cloud account e-mail</label>
                                        <input asp-for="CloudProvision.Email" id="provision-email" type="email" class="mat-input" autocomplete="off" />
                                    </div>
                                    <div class="mat-field">
                                        <label class="mat-label" for="provision-password">Password</label>
                                        <input asp-for="CloudProvision.Password" id="provision-password" type="password" class="mat-input" autocomplete="off" />
                                    </div>
                                    <div class="mat-field mat-field--full">
                                        <label class="mat-label" for="provision-name">Instance name</label>
                                        <input asp-for="CloudProvision.Name" id="provision-name" class="mat-input" />
                                    </div>
                                    <div class="mat-field mat-field--full">
                                        <label class="mat-check">
                                            <input asp-for="CloudProvision.TakeOver" id="provision-takeover" type="checkbox" />
                                            <span class="mat-check__text">
                                                <span>Take over my existing <em>offline</em> instance with this name</span>
                                                <small class="mat-muted">Keeps its plan, license and history; the installation that used it before can no longer connect. Unchecked, this becomes a new instance.</small>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="mat-btn-row">
                                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("login")<span>Connect with password</span></button>
                                </div>
                            </form>
                        </div>

                        <div class="mat-form__section">
                            <div class="mat-form__section-head">
                                <h3>With an instance id and token</h3>
                                <p>Manual: paste an instance id + token already created in the cloud UI.</p>
                            </div>
                            <form method="post" asp-page-handler="CloudConnect" class="mat-form" novalidate>
                                <div class="mat-form__grid">
                                    <div class="mat-field mat-field--full">
                                        <label class="mat-label" for="CloudConnect_Url">Cloud URL</label>
                                        <input asp-for="CloudConnect.Url" class="mat-input mat-mono" placeholder="https://cloud.matmon.eu" autocomplete="off" />
                                    </div>
                                    <div class="mat-field">
                                        <label class="mat-label" for="CloudConnect_InstanceId">Instance id</label>
                                        <input asp-for="CloudConnect.InstanceId" class="mat-input mat-mono" placeholder="GUID from the cloud UI" autocomplete="off" />
                                    </div>
                                    <div class="mat-field">
                                        <label class="mat-label" for="CloudConnect_Token">Instance token</label>
                                        <input asp-for="CloudConnect.Token" type="password" class="mat-input mat-mono" autocomplete="new-password" placeholder="token from the cloud UI" />
                                    </div>
                                </div>
                                <div class="mat-btn-row">
                                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("key")<span>Connect with token</span></button>
                                </div>
                            </form>
                        </div>

                        <div class="mat-form__section">
                            <div class="mat-form__section-head">
                                <h3>Offline license</h3>
                                <p>Offline / air-gapped: paste a long-lived license token a platform admin issued for this instance (cloud Admin → the instance → Offline token). No network needed - it is verified locally. A connected instance's licence is cloud-managed and would overwrite this.</p>
                            </div>
                            <form method="post" asp-page-handler="CloudOfflineToken" class="mat-form" novalidate>
                                <div class="mat-field">
                                    <label class="mat-label" for="OfflineLicenseToken">Offline license token</label>
                                    <textarea asp-for="OfflineLicenseToken" class="mat-textarea mat-mono mm-break" rows="4" placeholder="paste the token issued in the cloud"></textarea>
                                </div>
                                <div class="mat-btn-row">
                                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("check")<span>Apply offline license</span></button>
                                </div>
                            </form>
                        </div>
                    </div>
                </details>

                @if (Model.CloudEnvBootstrapSet && !Model.CloudSettings.Configured)
                {
                    <p class="mat-muted">Currently bootstrapped from environment variables - connecting here makes it UI-managed.</p>
                }
            </div>
        </section>
    }
}
else if (Model.IsActiveTab("license") && canManageSystem)
{
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("key")<h2 class="mat-card__title">License</h2><span class="mat-text-muted mm-push-end">@Model.License.DisplayName@(Model.License.IsFallback ? " · unlicensed (free, personal use only)" : "")</span></div>
        <div class="mat-card__body mat-stack">
            <dl class="mat-kv">
                <dt>Plan</dt><dd><strong>@Model.License.DisplayName</strong></dd>
                <dt>Probes</dt><dd><span class="mat-mono">@Model.ProbeCount / @Model.License.ProbeLimitDisplay</span> <span class="mat-text-muted">- agents do not count@(Model.AgentCount > 0 ? $" ({Model.AgentCount} in use)" : "")</span></dd>
                <dt>Sensors</dt><dd class="mat-mono">@Model.SensorCount / @Model.License.SensorLimitDisplay</dd>
                <dt>Cloud sensors</dt><dd class="mat-mono">@(Model.License.CloudSensorsEnabled ? (Model.License.CloudSensorLimit < 0 ? "unlimited" : Model.License.CloudSensorLimit.ToString()) : "-")</dd>
                <dt>Full Access</dt><dd>@(Model.License.TunnelEnabled ? "included" : "not included")</dd>
                <dt>Valid until</dt><dd class="mat-mono">@(Model.License.ExpiresUtc is null ? "never" : Model.FormatDateTime(Model.License.ExpiresUtc))</dd>
            </dl>
            <p class="mat-muted">
                The license is a short <strong>lease</strong>, verified <strong>offline</strong> against Matmon's public key. While
                connected, Matmon.Cloud renews it on every heartbeat, so the "valid until" date keeps rolling forward - you don't
                need to do anything. If this instance can't reach the cloud for about two weeks (or its license is revoked), the
                lease lapses and it falls back to the free <strong>Personal</strong> plan (personal use only, one probe) until it checks in again.
            </p>

            @if (Model.CloudLinkActive && Model.License.IsFallback)
            {
                <div class="mat-alert mat-alert--warning" role="status">
                    @MatUi.Icon("alert")
                    <div class="mat-alert__body">Connected to Matmon.Cloud, but no valid license token has arrived yet - this instance is on the free <strong>Personal</strong> fallback. If Matmon.Cloud shows a paid plan for it, the cloud likely can't <strong>sign</strong> the token (its <code>License__PrivateKey</code> is unset or doesn't match Matmon's baked public key). It applies automatically once a valid token is issued.</div>
                </div>
            }

            @if (Model.CloudLinkActive)
            {
                <p class="mat-muted">Manual license entry is disabled while connected to Matmon.Cloud - the license is managed by the cloud and refreshed on each heartbeat. <strong>Disconnect</strong> the cloud (System → Cloud) to license this instance offline.</p>
            }
        </div>
    </section>

    @if (!Model.CloudLinkActive)
    {
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("upload")<h2 class="mat-card__title">Apply a token manually</h2></div>
            <div class="mat-card__body">
                @if (Model.HasStoredLicenseToken)
                {
                    @* "Clear" posts its own handler: a hidden form of its own, so it sits in the same button row as "Apply". *@
                    <form method="post" asp-page-handler="ClearLicenseToken" id="license-clear" hidden></form>
                }
                <form method="post" asp-page-handler="SetLicenseToken" class="mat-form" novalidate>
                    <p class="mat-muted">For an offline / air-gapped instance: paste the signed license token issued by Matmon.Cloud. It's validated before it's stored - an invalid or expired token is rejected.</p>
                    <div class="mat-field">
                        <label class="mat-label" for="LicenseTokenInput">License token</label>
                        <textarea asp-for="LicenseTokenInput" class="mat-textarea mat-mono mm-break" rows="4" placeholder="paste the signed token here"></textarea>
                    </div>
                    <div class="mat-btn-row">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("check")<span>Apply token</span></button>
                        @if (Model.HasStoredLicenseToken)
                        {
                            <span class="mat-btn-row__spacer"></span>
                            <button type="submit" form="license-clear" class="mat-btn mat-btn--danger"
                                    data-confirm="Clear the cached license token? The instance drops to the free Personal plan until the cloud re-issues one." data-confirm-ok="Clear">@MatUi.Icon("trash")<span>Clear license token</span></button>
                        }
                    </div>
                </form>
            </div>
        </section>
    }
}
else if (Model.IsActiveTab("partner") && canManageSystem && Model.ServicePartnerInfo?.HasPartner == true)
{
    var sp = Model.ServicePartnerInfo;
    var safeContactUrl = ConfigModel.SafeContactUrl(sp.ContactUrl);
    var brandColor = ConfigModel.IsHexColor(sp.BrandColor) ? sp.BrandColor : null;
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("briefcase")<h2 class="mat-card__title">Service partner</h2><span class="mat-text-muted mm-push-end">@sp.Name</span></div>
        <div class="mat-card__body mat-stack">
            @if (sp.LogoPng is { Length: > 0 } || safeContactUrl is not null)
            {
                <div class="mat-row mat-gap-4">
                    @if (sp.LogoPng is { Length: > 0 } logo)
                    {
                        <img class="system-partner-logo" src="data:@(string.IsNullOrWhiteSpace(sp.LogoContentType) ? "image/png" : sp.LogoContentType);base64,@Convert.ToBase64String(logo)" alt="@sp.Name logo" />
                    }
                    <div class="mat-stack mat-stack--sm">
                        <span class="mat-row mat-row--nowrap mat-gap-2">
                            @if (brandColor is not null)
                            {
                                <span class="mat-dot" data-colour="@brandColor" aria-hidden="true"></span>
                            }
                            <strong>Managed by @sp.Name</strong>
                        </span>
                        @if (safeContactUrl is not null)
                        {
                            <a href="@safeContactUrl" target="_blank" rel="noopener noreferrer">Support &amp; contact</a>
                        }
                    </div>
                </div>
            }
            <dl class="mat-kv">
                <dt>Partner</dt><dd>@sp.Name</dd>
                @if (!string.IsNullOrWhiteSpace(sp.ContactEmail))
                {
                    <dt>Contact</dt><dd><a href="mailto:@sp.ContactEmail">@sp.ContactEmail</a></dd>
                }
                @if (!string.IsNullOrWhiteSpace(sp.ContactPhone))
                {
                    <dt>Phone</dt><dd class="mat-mono">@sp.ContactPhone</dd>
                }
                <dt>Access</dt><dd><span class="@MatUi.PillClass(sp.CanManage ? "ok" : "warn")">@(sp.CanManage ? "Allowed" : "Not allowed")</span></dd>
            </dl>

            <form method="post" asp-page-handler="ServicePartnerConsent" class="mat-form" novalidate>
                <label class="mat-check">
                    <input type="checkbox" id="partner-can-manage" name="canManage" value="true" checked="@sp.CanManage" />
                    <span class="mat-check__text">
                        <span>Allow <strong>@sp.Name</strong> to access and operate this instance via Matmon.Cloud (Full Access + reporting).</span>
                        <small class="mat-muted">This is your consent for the partner shown above. It's stored in Matmon.Cloud and re-synced on each heartbeat; revoking it stops their access.</small>
                    </span>
                </label>
                <div class="mat-btn-row">
                    <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save consent</span></button>
                </div>
            </form>
        </div>
    </section>
}
else if (Model.IsActiveTab("users") && canManageUsers)
{
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("users")<h2 class="mat-card__title">Users</h2><span class="mat-text-muted mm-push-end">@Model.Users.Count</span></div>
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Matmon users</caption>
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Role</th>
                        <th scope="col">Enabled</th>
                        <th scope="col" class="mat-hide-sm">Updated</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        var hasLocalPw = Model.HasLocalPassword(user);
                        var isCurrent = Model.IsCurrentUser(user);
                        // Deleting a cloud-linked account only clears the LOCAL shadow: the cloud owns membership, and the
                        // account is re-created on the next SSO/tunnel access while they are still a member. The confirm says so.
                        var deleteConfirm = user.CloudLinked
                            ? $"Delete {user.Username}? This clears only the LOCAL account. If they are still a member of this instance in Matmon.Cloud it is re-created on their next cloud sign-in - to fully revoke access, remove them in the cloud (Instance members)."
                            : $"Delete user {user.Username}?";
                        <tr>
                            <td data-label="User" class="mat-table__primary">
                                <div class="mat-table__name">
                                    <span>
                                        @if (isCurrent)
                                        {
                                            @user.Username
                                        }
                                        else
                                        {
                                            <a asp-page="/UserEdit" asp-route-userId="@user.Id" asp-route-returnUrl="/Config?tab=users">@user.Username</a>
                                        }
                                        <small class="mat-mono">@user.Id</small>
                                        @if (user.LastLoginUtc is not null)
                                        {
                                            <small>Last login: @Model.FormatDateTime(user.LastLoginUtc)</small>
                                        }
                                    </span>
                                </div>
                                @* An account can sign in locally (password) and/or via Cloud SSO - show both. *@
                                <span class="mat-chips">
                                    @if (hasLocalPw)
                                    {
                                        <span class="mat-tag" data-tip="Can sign in with a local e-mail + password">Local</span>
                                    }
                                    @if (user.CloudLinked)
                                    {
                                        <span class="mat-tag" data-tip="Signs in via Matmon.Cloud (SSO / tunnel). Access is governed by cloud membership - remove them in the cloud to revoke; deleting here only clears the local copy.">Cloud</span>
                                    }
                                    @if (!hasLocalPw && !user.CloudLinked)
                                    {
                                        <span class="mat-tag" data-tip="Local account">Local</span>
                                    }
                                    @if (isCurrent)
                                    {
                                        <span class="mat-pill mat-pill--info">Current</span>
                                    }
                                </span>
                            </td>
                            <td data-label="Role">@user.Role</td>
                            <td data-label="Enabled"><span class="@MatUi.PillClass(user.IsEnabled ? "ok" : "error")">@(user.IsEnabled ? "Enabled" : "Disabled")</span></td>
                            <td data-label="Updated" class="mat-hide-sm mat-mono">@Model.FormatDateTime(user.UpdatedUtc)</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    @if (!isCurrent)
                                    {
                                        <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" asp-page="/UserEdit" asp-route-userId="@user.Id" asp-route-returnUrl="/Config?tab=users" aria-label="Edit @user.Username" data-tip="Edit">@MatUi.Icon("edit")</a>
                                        <form method="post" asp-page-handler="DeleteUser" asp-route-userId="@user.Id">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="Delete @user.Username" data-tip="Delete"
                                                    data-confirm="@deleteConfirm" data-confirm-ok="Delete">@MatUi.Icon("trash")</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="mat-text-muted">Current account</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" asp-page="/UserCreate" asp-route-returnUrl="/Config?tab=users">@MatUi.Icon("plus")<span>Create user</span></a>
    </div>
}

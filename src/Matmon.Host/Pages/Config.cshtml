@page
@model ConfigModel
@{
    ViewData["Title"] = "System";
    var storage = Model.Overview.Storage;
    var telemetry = Model.StorageTelemetry;
    var usedPercent = storage.DriveFreePercent.HasValue
        ? Math.Clamp(100 - storage.DriveFreePercent.Value, 0, 100)
        : 0;
    var canManageSystem = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
    var canManageUsers = canManageSystem;
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("gear")
            <h1>System</h1>
        </div>
        <div class="mode-chip">
            <span>Mode</span>
            <strong>@Model.Overview.Mode</strong>
        </div>
    </div>

    <div class="workspace-tabs system-tabs" role="tablist" aria-label="System sections">
        <a class="workspace-tab @(Model.IsActiveTab("general") ? "is-active" : "")" asp-page="/Config" asp-route-tab="general">General</a>
        <a class="workspace-tab @(Model.IsActiveTab("probes") ? "is-active" : "")" asp-page="/Config" asp-route-tab="probes">Probes</a>
        <a class="workspace-tab @(Model.IsActiveTab("storage") ? "is-active" : "")" asp-page="/Config" asp-route-tab="storage">Storage</a>
        @if (canManageUsers)
        {
            <a class="workspace-tab @(Model.IsActiveTab("users") ? "is-active" : "")" asp-page="/Config" asp-route-tab="users">Users</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    @if (Model.IsActiveTab("general"))
    {
        <div class="config-grid">
            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("gear")<span>Runtime</span></h2>
                    <span class="panel-hint">current values</span>
                </div>

                <dl class="config-list">
                    <div class="config-row">
                        <dt>Mode</dt>
                        <dd>@Model.Overview.Mode</dd>
                    </div>
                    <div class="config-row">
                        <dt>Heartbeat</dt>
                        <dd>@Model.Overview.HeartbeatIntervalSeconds s</dd>
                    </div>
                    <div class="config-row">
                        <dt>Probe ID</dt>
                        <dd>@(Model.Overview.ProbeId ?? "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Probe name</dt>
                        <dd>@(Model.Overview.ProbeName ?? "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Master URL</dt>
                        <dd>@(Model.Overview.MasterUrl ?? "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Workspace</dt>
                        <dd>@Model.Overview.WorkspacePath</dd>
                    </div>
                    <div class="config-row">
                        <dt>Login</dt>
                        <dd>@Model.Overview.AuthUsername / @Model.Overview.AuthPassword</dd>
                    </div>
                </dl>
            </section>

            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("arrow-right")<span>Docker env</span></h2>
                    <span class="panel-hint">master / slave</span>
                </div>

                <pre class="config-code">@Model.Overview.DockerMasterSnippet</pre>
                <div class="mt-3"></div>
                <pre class="config-code">@Model.Overview.DockerSlaveSnippet</pre>
            </section>
        </div>

        <section class="panel config-block">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("spark")<span>Local appsettings</span></h2>
                <span class="panel-hint">src/Matmon.Host/appsettings.json</span>
            </div>

            <pre class="config-code">@Model.Overview.AppSettingsSnippet</pre>
        </section>
    }
    else if (Model.IsActiveTab("probes"))
    {
        <section class="panel config-block">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("probe")<span>Probe status</span></h2>
                <span class="panel-hint">@Model.Overview.Probes.Count configured</span>
            </div>

            <div class="system-table system-probe-table" role="table" aria-label="Configured probes">
                <div class="system-table-row system-table-head system-probe-row @(canManageSystem ? "has-actions" : string.Empty)" role="row">
                    <span role="columnheader">Probe</span>
                    <span role="columnheader">Role</span>
                    <span role="columnheader">Status</span>
                    <span role="columnheader">Last seen</span>
                    <span role="columnheader">Sensors</span>
                    <span role="columnheader">Token</span>
                    @if (canManageSystem)
                    {
                        <span role="columnheader">Actions</span>
                    }
                </div>
                @foreach (var probe in Model.Overview.Probes)
                {
                    var state = probe.State.Equals("Offline", StringComparison.OrdinalIgnoreCase)
                        ? "error"
                        : probe.State.Equals("Waiting", StringComparison.OrdinalIgnoreCase) ? "warning" : "ok";
                    <div class="system-table-row system-probe-row @(canManageSystem ? "has-actions" : string.Empty)" role="row">
                        <span role="cell">
                            <strong>@probe.Name</strong>
                            <small>@probe.ProbeId</small>
                        </span>
                        <span role="cell">@probe.Role</span>
                        <span role="cell">
                            <span class="state-pill" data-state="@state">@probe.State</span>
                            <small>@probe.Message</small>
                        </span>
                        <span role="cell">@Model.FormatDateTime(probe.LastSeenUtc)</span>
                        <span role="cell">@probe.SensorCount</span>
                        <span role="cell">@(probe.EnrollmentToken ?? "-")</span>
                        @if (canManageSystem)
                        {
                            <span role="cell" class="system-probe-actions">
                                <a class="workspace-secondary-submit" asp-page="/ElementEditor" asp-route-selectedId="@probe.ElementId" asp-route-returnUrl="/Config?tab=probes">
                                    @MatmonIcons.Render("pencil")
                                    <span>Edit</span>
                                </a>
                                <form method="post" asp-page-handler="RotateProbeToken" asp-route-probeId="@probe.ElementId">
                                    <button type="submit" class="workspace-secondary-submit">
                                        @MatmonIcons.Render("arrow-right")
                                        <span>Rotate</span>
                                    </button>
                                </form>
                            </span>
                        }
                    </div>
                }
            </div>

            @if (canManageSystem)
            {
                <div class="page-actions workspace-toolbar system-probe-create-actions">
                    <a class="workspace-submit" asp-page="/ProbeCreate" asp-route-returnUrl="/Config?tab=probes">
                        @MatmonIcons.Render("plus")
                        <span>New probe</span>
                    </a>
                </div>
            }
        </section>

        @if (string.Equals(Model.Overview.Mode, "Slave", StringComparison.OrdinalIgnoreCase))
        {
            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("signal")<span>Slave exchange</span></h2>
                    <span class="panel-hint">@Model.Overview.SlaveRuntime.StatusMessage</span>
                </div>

                <dl class="config-list compact-config-list">
                    <div class="config-row">
                        <dt>Connected</dt>
                        <dd>@(Model.Overview.SlaveRuntime.IsConnected ? "yes" : "no")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Last heartbeat</dt>
                        <dd>@Model.FormatDateTime(Model.Overview.SlaveRuntime.LastHeartbeatUtc)</dd>
                    </div>
                    <div class="config-row">
                        <dt>Assignments</dt>
                        <dd>@Model.Overview.SlaveRuntime.AssignedSensorCount</dd>
                    </div>
                    <div class="config-row">
                        <dt>Last results</dt>
                        <dd>@Model.Overview.SlaveRuntime.LastExecutedSensorCount</dd>
                    </div>
                </dl>
            </section>
        }
    }
    else if (Model.IsActiveTab("storage"))
    {
        <div class="system-storage-grid">
            <section class="panel config-block system-storage-summary">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("chart")<span>Storage usage</span></h2>
                    <span class="panel-hint">@storage.DriveName</span>
                </div>

                <div class="storage-number">
                    <strong>@storage.FormatBytes(storage.DataDirectoryBytes)</strong>
                    <span>Matmon data</span>
                </div>

                <div class="storage-meter" aria-label="Disk usage">
                    <span style="width: @usedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                </div>

                <dl class="config-list compact-config-list">
                    <div class="config-row">
                        <dt>Drive free</dt>
                        <dd>@ConfigModel.FormatPercent(storage.DriveFreePercent)</dd>
                    </div>
                    <div class="config-row">
                        <dt>Drive available</dt>
                        <dd>@(storage.DriveAvailableGigabytes.HasValue ? $"{storage.DriveAvailableGigabytes.Value:0.##} GB" : "-")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Drive total</dt>
                        <dd>@(storage.DriveTotalGigabytes.HasValue ? $"{storage.DriveTotalGigabytes.Value:0.##} GB" : "-")</dd>
                    </div>
                </dl>
            </section>

            <section class="panel config-block">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("list")<span>Files</span></h2>
                    <span class="panel-hint">@storage.DataFileCount files</span>
                </div>

                <dl class="config-list">
                    <div class="config-row">
                        <dt>Data path</dt>
                        <dd>@storage.DataPath</dd>
                    </div>
                    <div class="config-row">
                        <dt>Data directory</dt>
                        <dd>@(storage.DataDirectoryExists ? "available" : "missing")</dd>
                    </div>
                    <div class="config-row">
                        <dt>Workspace file</dt>
                        <dd>@storage.FormatBytes(storage.WorkspaceFileBytes)</dd>
                    </div>
                    <div class="config-row">
                        <dt>Workspace backup</dt>
                        <dd>@storage.FormatBytes(storage.BackupFileBytes)</dd>
                    </div>
                    <div class="config-row">
                        <dt>Workspace path</dt>
                        <dd>@storage.WorkspacePath</dd>
                    </div>
                </dl>
            </section>
        </div>

        <section class="panel config-block system-cleanup-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("trash")<span>Cleanup</span></h2>
                <span class="panel-hint">Remove old telemetry without touching the structure</span>
            </div>

            <div class="storage-cleanup-metrics" aria-label="Stored telemetry entries">
                <div>
                    <strong>@ConfigModel.FormatCount(telemetry.SensorHistoryCount)</strong>
                    <span>History</span>
                </div>
                <div>
                    <strong>@ConfigModel.FormatCount(telemetry.StatisticsBucketCount)</strong>
                    <span>Statistics</span>
                </div>
                <div>
                    <strong>@ConfigModel.FormatCount(telemetry.EventCount)</strong>
                    <span>Events</span>
                </div>
                <div>
                    <strong>@ConfigModel.FormatCount(telemetry.TotalEntryCount)</strong>
                    <span>Total</span>
                </div>
            </div>

            @if (canManageSystem)
            {
                <form method="post" asp-page-handler="CleanupStorage" class="workspace-form-grid storage-cleanup-form" onsubmit="return confirm('Cleanup permanently removes the selected historical data. Continue?');">
                    <label class="workspace-field">
                        <span>Scope</span>
                        <select asp-for="StorageCleanup.Scope" asp-items="Model.StorageCleanupScopeOptions"></select>
                    </label>
                    <label class="workspace-field">
                        <span>Delete</span>
                        <select asp-for="StorageCleanup.OlderThanDays" asp-items="Model.StorageCleanupAgeOptions"></select>
                    </label>
                    <p class="workspace-inline-note workspace-span-2">
                        Current topology, templates, credentials and alerts stay untouched. If you choose "All selected data", graphs and latest values are rebuilt on the next sensor runs.
                    </p>
                    <div class="workspace-form-actions workspace-span-2">
                        <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("trash")<span>Run cleanup</span></button>
                    </div>
                </form>
            }
            else
            {
                <p class="workspace-inline-note">Only admins can run storage cleanup.</p>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(storage.ErrorMessage))
        {
            <section class="workspace-banner workspace-banner-warning">
                @MatmonIcons.Render("warning")
                <span>@storage.ErrorMessage</span>
            </section>
        }
    }
    else if (Model.IsActiveTab("users") && canManageUsers)
    {
        <section class="panel config-block">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("lock")<span>Users</span></h2>
                <span class="panel-hint">Admin, User, Viewer</span>
            </div>

            <div class="system-table system-user-table" role="table" aria-label="Matmon users">
                <div class="system-table-row system-table-head" role="row">
                    <span role="columnheader">User</span>
                    <span role="columnheader">Role</span>
                    <span role="columnheader">Enabled</span>
                    <span role="columnheader">Password</span>
                    <span role="columnheader">Actions</span>
                </div>
                @foreach (var user in Model.Users)
                {
                    <form method="post" asp-page-handler="UpdateUser" class="system-table-row system-user-row" role="row">
                        <input type="hidden" name="UserInput.Id" value="@user.Id" />
                        <span role="cell">
                            <input class="form-control workspace-input" name="UserInput.Username" value="@user.Username" />
                            <small>Updated @Model.FormatDateTime(user.UpdatedUtc)</small>
                        </span>
                        <span role="cell">
                            <select class="form-select workspace-select" name="UserInput.Role">
                                @foreach (var role in Enum.GetValues<MatmonUserRole>().OrderByDescending(role => role))
                                {
                                    <option value="@role" selected="@(role == user.Role ? "selected" : null)">@role</option>
                                }
                            </select>
                        </span>
                        <span role="cell">
                            <label class="workspace-check">
                                <input type="checkbox" name="UserInput.IsEnabled" value="true" checked="@(user.IsEnabled ? "checked" : null)" />
                                <input type="hidden" name="UserInput.IsEnabled" value="false" />
                                Active
                            </label>
                        </span>
                        <span role="cell">
                            <input class="form-control workspace-input" type="password" name="UserInput.Password" placeholder="leave unchanged" autocomplete="new-password" />
                        </span>
                        <span role="cell" class="system-user-actions">
                            <button type="submit" class="workspace-secondary-submit">@MatmonIcons.Render("check")<span>Save</span></button>
                            <button type="submit" asp-page-handler="DeleteUser" asp-route-userId="@user.Id" class="workspace-danger-submit">@MatmonIcons.Render("trash")<span>Delete</span></button>
                        </span>
                    </form>
                }
            </div>
        </section>

        <section class="panel config-block">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("plus")<span>New user</span></h2>
                <span class="panel-hint">Admin can manage all areas, User can acknowledge alerts, Viewer is read-only.</span>
            </div>

            <form method="post" asp-page-handler="CreateUser" class="workspace-form-grid">
                <label class="workspace-field">
                    <span class="workspace-label">Username</span>
                    <input asp-for="UserInput.Username" class="form-control workspace-input" autocomplete="username" />
                </label>
                <label class="workspace-field">
                    <span class="workspace-label">Password</span>
                    <input asp-for="UserInput.Password" type="password" class="form-control workspace-input" autocomplete="new-password" />
                </label>
                <label class="workspace-field">
                    <span class="workspace-label">Role</span>
                    <select asp-for="UserInput.Role" asp-items="Model.RoleOptions" class="form-select workspace-select"></select>
                </label>
                <div class="workspace-form-actions workspace-span-2">
                    <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create user</span></button>
                </div>
            </form>
        </section>
    }
</section>

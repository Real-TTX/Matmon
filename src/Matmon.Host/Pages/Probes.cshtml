@page "/Probes"
@model Matmon.Host.Pages.ProbesModel
@{
    ViewData["Title"] = "Probes";
    var probes = Model.Probes;
    ViewData["PageSub"] = $"{probes.Count} configured: the local primary, remote probes and agents - where the sensors run.";
    var isAdmin = Matmon.Host.Services.MatmonSecurity.IsAdmin(User);
}

<div class="mat-list">
    @if (probes.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@MatUi.Icon("server")</span>
            <div class="mat-empty__title">No probes configured yet</div>
            <p>A probe runs the sensors: the local primary, a remote Docker probe or an agent on the machine it monitors.</p>
        </div>
    }
    else
    {
        <div class="mat-table-wrap">
            <table class="mat-table">
                <caption class="mat-sr-only">Probes with their state</caption>
                <thead>
                    <tr>
                        <th scope="col">Probe</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="mat-hide-sm">Last seen</th>
                        <th scope="col" class="mat-num">Sensors</th>
                        <th scope="col"><span class="mat-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var probe in probes)
                    {
                        var state = probe.State.Equals("Offline", StringComparison.OrdinalIgnoreCase)
                            ? "error"
                            : probe.State.Equals("Waiting", StringComparison.OrdinalIgnoreCase) ? "warning" : "ok";

                        <tr>
                            <td data-label="Probe">
                                <div class="probe-cell">
                                    <strong>@probe.Name</strong>
                                    <span class="probe-cell__meta mat-mono">@probe.ProbeId</span>
                                    @if (!string.IsNullOrWhiteSpace(probe.OperatingSystem) && probe.OperatingSystem != "-")
                                    {
                                        <span class="probe-cell__meta">@probe.OperatingSystem@(string.IsNullOrWhiteSpace(probe.Host) || probe.Host == "-" ? string.Empty : $" · {probe.Host}")@(string.IsNullOrWhiteSpace(probe.Version) ? string.Empty : $" · {probe.Version}")</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(probe.Version))
                                    {
                                        <span class="probe-cell__meta mat-mono">@probe.Version</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(probe.DuplicateWarning))
                                    {
                                        <span class="probe-cell__warn" title="Two processes share this probe id, so every other sensor result comes from the other one.">@MatUi.Icon("alert")<span>Duplicate probe: @probe.DuplicateWarning</span></span>
                                    }
                                    @if (probe.Networks is { Count: > 0 })
                                    {
                                        <span class="mat-chips">
                                            @foreach (var net in probe.Networks)
                                            {
                                                <span class="mat-tag mat-mono">@net</span>
                                            }
                                        </span>
                                    }
                                </div>
                            </td>
                            <td data-label="Role">
                                <div class="probe-cell">
                                    <span>@probe.Role</span>
                                    @if (probe.IsAgent)
                                    {
                                        <span class="mat-tag" title="Enrolled agent - installed on the machine it monitors">Agent</span>
                                    }
                                </div>
                            </td>
                            <td data-label="Status">
                                <div class="probe-cell">
                                    <span class="@MatUi.PillClass(state)">@probe.State</span>
                                    <span class="probe-cell__meta">@probe.Message</span>
                                </div>
                            </td>
                            <td data-label="Last seen" class="mat-hide-sm mat-mono">@(probe.LastSeenUtc.HasValue ? probe.LastSeenUtc.Value.ToDisplay().ToString("g") : "-")</td>
                            <td data-label="Sensors" class="mat-num mat-mono">@probe.SensorCount</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-menu-toggle="probe-menu-@probe.ElementId" data-menu-place="bottom"
                                            aria-haspopup="menu" aria-expanded="false" aria-label="Actions for @probe.Name" data-tip="Actions">@MatUi.Icon("more-horizontal")</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* The row menus. A menu item that posts uses the one hidden form (it carries the anti-forgery token) and names its own
   handler: a Docker probe moving onto the machine it monitors, or an agent being reinstalled, gets a code that hands the
   new install THIS probe (and its sensors), not a new, empty one. *@
<form method="post" id="probe-row-actions" hidden></form>
@foreach (var probe in probes)
{
    <div class="mat-menu" id="probe-menu-@probe.ElementId" role="menu" aria-label="Actions for @probe.Name" hidden>
        <a class="mat-menu__item" role="menuitem" asp-page="/Monitoring" asp-route-monitoringView="list" asp-route-monitoringKind="probe">@MatUi.Icon("activity")<span>Sensors</span></a>
        <a class="mat-menu__item" role="menuitem" asp-page="/ProbeUsage" asp-route-probeElementId="@probe.ElementId">@MatUi.Icon("bar-chart")<span>Usage</span></a>
        @if (isAdmin && probe.Role != "Primary")
        {
            <div class="mat-menu__sep" role="separator"></div>
            <button type="submit" form="probe-row-actions" class="mat-menu__item" role="menuitem"
                    asp-page="/Agents" asp-page-handler="CreateForProbe" name="probeElementId" value="@probe.ElementId">@MatUi.Icon("key")<span>@(probe.IsAgent ? "New install code" : "Move to an agent")</span></button>
        }
    </div>
}

@page
@model BackupRestoreModel
@{
    ViewData["Title"] = "Restore backup";
}

<section class="dashboard-shell">
    <div class="page-header has-summary">
        <div class="page-title">
            @MatmonIcons.Render("arrow-right")
            <h1>Restore backup</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    @if (Model.Snapshot is null)
    {
        <section class="panel config-block">
            <div class="empty-state">Backup snapshot not found.</div>
        </section>
    }
    else
    {
        <form method="post" class="workspace-form">
            <input type="hidden" asp-for="FileName" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="config-grid backup-restore-grid backup-restore-layout">
                <section class="panel config-block">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("folder")<span>Snapshot</span></h2>
                        <span class="panel-hint">@Model.Snapshot.DisplayName</span>
                    </div>

                    <div class="workspace-summary-card backup-restore-snapshot-summary">
                        <div class="workspace-summary-main">
                            <span class="workspace-summary-kicker">Archive</span>
                            <strong>@Model.Snapshot.FileName</strong>
                        </div>
                        <div class="workspace-summary-metrics">
                            <span class="workspace-summary-chip">
                                @MatmonIcons.Render("clock")
                                <strong>@Model.FormatDateTime(Model.Snapshot.CreatedUtc)</strong>
                                <span>Created</span>
                            </span>
                            <span class="workspace-summary-chip">
                                @MatmonIcons.Render("chart")
                                <strong>@Model.Snapshot.Bytes.ToString("N0")</strong>
                                <span>Bytes</span>
                            </span>
                            <span class="workspace-summary-chip">
                                @MatmonIcons.Render("folder")
                                <strong>@BackupRestoreModel.FormatCount(BackupRestoreModel.CountSections(Model.Snapshot.Sections))</strong>
                                <span>Sections</span>
                            </span>
                        </div>
                    </div>

                    <dl class="config-list compact-config-list backup-restore-meta">
                        <div class="config-row">
                            <dt>File</dt>
                            <dd>@Model.Snapshot.FileName</dd>
                        </div>
                        <div class="config-row">
                            <dt>Job</dt>
                            <dd>@(Model.Snapshot.JobName ?? "-")</dd>
                        </div>
                        <div class="config-row">
                            <dt>Description</dt>
                            <dd>@(Model.Snapshot.Description ?? "-")</dd>
                        </div>
                        <div class="config-row">
                            <dt>Created</dt>
                            <dd>@Model.FormatDateTime(Model.Snapshot.CreatedUtc)</dd>
                        </div>
                        <div class="config-row">
                            <dt>Size</dt>
                            <dd>@Model.Snapshot.Bytes.ToString("N0") bytes</dd>
                        </div>
                        <div class="config-row">
                            <dt>Contains</dt>
                            <dd>@Model.FormatSections(Model.Snapshot.Sections)</dd>
                        </div>
                    </dl>
                </section>

                <section class="panel config-block">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("spark")<span>Restore scope</span></h2>
                        <span class="panel-hint">review the content before restoring</span>
                    </div>

                    <div class="backup-restore-section-grid">
                        @foreach (var restoreSection in Model.SectionItems)
                        {
                            <label class="backup-restore-section-card @(restoreSection.Included ? string.Empty : "is-disabled")">
                                <input type="checkbox"
                                       name="@restoreSection.FieldName"
                                       value="true"
                                       checked="@(restoreSection.Selected ? "checked" : null)"
                                       disabled="@(restoreSection.Included ? null : "disabled")" />
                                <div class="backup-restore-section-card-body">
                                    <div class="backup-restore-section-card-head">
                                        <strong>@restoreSection.Label</strong>
                                        <span class="backup-restore-section-count">@BackupRestoreModel.FormatCount(restoreSection.ItemCount)</span>
                                    </div>
                                    <span class="backup-restore-section-description">@restoreSection.Description</span>
                                    <div class="backup-restore-section-summary">
                                        <span>@restoreSection.Summary</span>
                                        <small>@(restoreSection.Included ? "included in backup" : "not present")</small>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                </section>
            </div>

            <div asp-validation-summary="All" class="workspace-inline-note"></div>

            <div class="page-actions workspace-toolbar">
                <a class="workspace-secondary-submit" asp-page="/Config" asp-route-tab="backup">
                    @MatmonIcons.Render("arrow-left")
                    <span>Back</span>
                </a>
                <a class="workspace-secondary-submit" asp-page="/BackupRestore" asp-page-handler="Download" asp-route-fileName="@Model.FileName">
                    @MatmonIcons.Render("download")
                    <span>Download</span>
                </a>
                <button type="submit" class="workspace-danger-submit" onclick="return confirm('Restore selected sections from this backup?');">
                    @MatmonIcons.Render("arrow-right")
                    <span>Restore now</span>
                </button>
            </div>
        </form>
    }
</section>

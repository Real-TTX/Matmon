@page
@model BackupRestoreModel
@{
    ViewData["Title"] = "Restore backup";
    var errors = ViewData.ModelState.Values.SelectMany(entry => entry.Errors).Select(error => error.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).ToList();
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (Model.Snapshot is null)
{
    <div class="mat-empty mat-empty--framed">
        <span class="mat-empty__icon">@MatUi.Icon("archive")</span>
        <div class="mat-empty__title">Backup snapshot not found</div>
        <p>The file is not in the backup archive.</p>
        <a class="mat-btn mat-btn--secondary" asp-page="/Config" asp-route-tab="backup">@MatUi.Icon("back")<span>Back to the backups</span></a>
    </div>
}
else
{
    <form method="post" class="mat-form" novalidate>
        <input type="hidden" asp-for="FileName" />
        <input type="hidden" asp-for="ReturnUrl" />

        @if (errors.Count > 0)
        {
            <div class="mat-alert mat-alert--danger" role="alert">
                @MatUi.Icon("x-circle")
                <div class="mat-alert__body">
                    <ul class="mat-alert__list">
                        @foreach (var message in errors)
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="mat-grid mat-grid--2">
            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("archive")<h2 class="mat-card__title">Snapshot</h2><span class="mat-text-muted mm-push-end">@Model.Snapshot.DisplayName</span></div>
                <div class="mat-card__body">
                    <dl class="mat-kv">
                        <dt>File</dt><dd class="mat-mono">@Model.Snapshot.FileName</dd>
                        <dt>Job</dt><dd>@(Model.Snapshot.JobName ?? "-")</dd>
                        <dt>Description</dt><dd>@(Model.Snapshot.Description ?? "-")</dd>
                        <dt>Created</dt><dd class="mat-mono">@Model.FormatDateTime(Model.Snapshot.CreatedUtc)</dd>
                        <dt>Size</dt><dd class="mat-mono">@Model.Snapshot.Bytes.ToString("N0") bytes</dd>
                        <dt>Sections</dt><dd class="mat-mono">@BackupRestoreModel.FormatCount(BackupRestoreModel.CountSections(Model.Snapshot.Sections))</dd>
                        <dt>Contains</dt><dd>@Model.FormatSections(Model.Snapshot.Sections)</dd>
                    </dl>
                </div>
            </section>

            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("layers")<h2 class="mat-card__title">Restore scope</h2></div>
                <div class="mat-card__body">
                    @* Raw checkboxes named after the section (Input.Sections.<Section>): an unticked one posts nothing, and the model
                       starts from "nothing selected", so only what is ticked here is restored. *@
                    <fieldset class="mat-field mat-fieldset">
                        <legend class="mat-sr-only">Sections to restore</legend>
                        <div class="mat-checks">
                            @foreach (var restoreSection in Model.SectionItems)
                            {
                                <label class="mat-check">
                                    <input type="checkbox"
                                           name="@restoreSection.FieldName"
                                           value="true"
                                           checked="@restoreSection.Selected"
                                           disabled="@(!restoreSection.Included)" />
                                    <span class="mat-check__text">
                                        <strong>@restoreSection.Label <span class="mat-badge mat-badge--soft">@BackupRestoreModel.FormatCount(restoreSection.ItemCount)</span></strong>
                                        <small class="mat-muted">@restoreSection.Description</small>
                                        <small class="mat-muted">@restoreSection.Summary · @(restoreSection.Included ? "included in backup" : "not present")</small>
                                    </span>
                                </label>
                            }
                        </div>
                    </fieldset>
                </div>
            </section>
        </div>

        <section class="mat-card">
            <div class="mat-card__body">
                <div class="mat-field">
                    <label class="mat-label" for="Passphrase">Passphrase <span class="mat-text-muted">(only for an encrypted/portable backup)</span></label>
                    <input asp-for="Passphrase" type="password" class="mat-input" autocomplete="off" placeholder="leave blank for a normal backup" />
                </div>
            </div>
        </section>

        <div class="mat-btn-row">
            <a class="mat-btn mat-btn--secondary" asp-page="/Config" asp-route-tab="backup">@MatUi.Icon("back")<span>Back</span></a>
            <a class="mat-btn mat-btn--secondary" asp-page="/BackupRestore" asp-page-handler="Download" asp-route-fileName="@Model.FileName">@MatUi.Icon("download")<span>Download</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" class="mat-btn mat-btn--danger" data-confirm="Restore selected sections from this backup?" data-confirm-ok="Restore">@MatUi.Icon("restore")<span>Restore now</span></button>
        </div>
    </form>
}

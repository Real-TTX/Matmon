@page "/signin-cloud"
@model SigninCloudModel
@{
    // Every handler of this page redirects (out to the cloud's sign-in, back to the sign-in page with an error, or into
    // the app). The card is only what shows should a browser ever stop here.
    Layout = "_AnonymousLayout";
    ViewData["Title"] = "Signing in…";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        <h1>Signing in…</h1>
        <p class="mat-muted">Signing in with Matmon.Cloud…</p>
    </div>
</div>

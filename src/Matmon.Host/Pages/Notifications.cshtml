@page "/notifications"
@model WorkspaceModel
@using Matmon.Core.Domain
@inject Matmon.Host.Services.IMonitoringWorkspaceStore WorkspaceStore
@{
    ViewData["Title"] = "Notifications";
    var returnUrl = Request.Path + Request.QueryString;

    // The single scheduled "summary report" is shown as one row in the same list as the trigger rules.
    var report = WorkspaceStore.GetSummaryReportSettings();
    var ws = WorkspaceStore.Workspace;
    var reportSender = report.SenderId is { } sid
        ? (ws.NotificationSenders.FirstOrDefault(s => s.Id == sid)?.Name ?? "unknown sender")
        : "Default SMTP";
    var reportReceiver = report.ReceiverId is { } rid
        ? (ws.NotificationReceivers.FirstOrDefault(r => r.Id == rid)?.Name ?? "unknown receiver")
        : (string.IsNullOrWhiteSpace(report.Recipients) ? "no recipients" : report.Recipients);
    var reportSchedule = report.Cadence == SummaryReportCadence.Weekly
        ? $"Weekly · {report.DayOfWeek} {report.HourOfDay:00}:00"
        : $"Daily · {report.HourOfDay:00}:00";
}

<section class="dashboard-shell">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <div class="page-header has-summary">
        <div class="page-title">
            @MatmonIcons.Render("bell")
            <h1>Notifications</h1>
        </div>
    </div>

    <div class="sensor-tabs">
        <a class="sensor-tab is-active" asp-page="/Notifications">@MatmonIcons.Render("bell")<span>Notifications</span></a>
        <a class="sensor-tab" asp-page="/NotificationSettings">@MatmonIcons.Render("mail")<span>Senders</span></a>
        <a class="sensor-tab" asp-page="/NotificationReceivers">@MatmonIcons.Render("inbox")<span>Receivers</span></a>
    </div>

    <section class="panel panel-stack monitoring-controls">
        <form class="monitoring-filter-bar" data-notif-filter onsubmit="return false;">
            <label class="monitoring-filter-field">
                <span>@MatmonIcons.Render("search")<small>Search</small></span>
                <input type="search" class="form-control workspace-input" data-notif-search placeholder="Name, sender, target" aria-label="Search notifications" />
            </label>
            <label class="monitoring-filter-field">
                <span>@MatmonIcons.Render("bell")<small>Type</small></span>
                <select class="form-select workspace-select" data-notif-type-filter aria-label="Filter by type">
                    <option value="all">All</option>
                    <option value="trigger">Trigger</option>
                    <option value="scheduled">Scheduled</option>
                </select>
            </label>
        </form>
    </section>

    <section class="panel panel-stack workspace-panel">
        <style>
            .notif-type-chip { display:inline-block; padding:0.05rem 0.5rem; border:1px solid var(--matmon-border); border-radius:999px; font-size:0.72rem; color:var(--matmon-muted); margin-left:6px; }
        </style>
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("bell")<span>Notification rules</span></h2>
            <span class="panel-hint">@(Model.View.NotificationRuleCount) trigger · 1 scheduled</span>
        </div>

        <div class="notification-rule-list">
            @* Scheduled: the summary report (single) *@
            <article class="notification-rule-row" data-notif-row data-notif-type="scheduled" data-notif-name="summary report @report.Subject">
                <div class="notification-rule-main">
                    <div class="notification-rule-name">Summary report <span class="notif-type-chip">Scheduled</span></div>
                    <div class="notification-rule-meta">@reportSender -> @reportReceiver</div>
                    <div class="notification-rule-meta">@reportSchedule@(report.AttachPdf ? " | +PDF" : "")</div>
                </div>
                <div class="notification-rule-side">
                    <span class="notification-rule-state @(report.Enabled ? "is-enabled" : "is-disabled")">@(report.Enabled ? "Enabled" : "Disabled")</span>
                    <div class="workspace-row-actions">
                        <a class="workspace-action-link" asp-page="/NotificationReportEditor">@MatmonIcons.Render("pencil")<span>Edit</span></a>
                    </div>
                </div>
            </article>

            @* Trigger: the alert-based rules *@
            @foreach (var rule in Model.View.NotificationRules)
            {
                <article class="notification-rule-row @(Model.NotificationRuleEditor.Id == rule.Id ? "is-selected" : string.Empty)"
                         data-notif-row data-notif-type="trigger" data-notif-name="@rule.Name">
                    <div class="notification-rule-main">
                        <div class="notification-rule-name">@rule.Name <span class="notif-type-chip">Trigger</span></div>
                        <div class="notification-rule-meta">@rule.Sender -> @rule.Receiver</div>
                        <div class="notification-rule-meta">@rule.Target | @rule.Triggers | @rule.Cooldown</div>
                    </div>
                    <div class="notification-rule-side">
                        <span class="notification-rule-state @(rule.Enabled ? "is-enabled" : "is-disabled")">@(rule.Enabled ? "Enabled" : "Disabled")</span>
                        <div class="workspace-row-actions">
                            <a class="workspace-action-link" asp-page="/NotificationRuleEditor" asp-route-selectedNotificationRuleId="@rule.Id">@MatmonIcons.Render("pencil")<span>Edit</span></a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="page-actions">
            <a class="workspace-action-link" asp-page="/NotificationRuleEditor" asp-route-returnUrl="@returnUrl">@MatmonIcons.Render("plus")<span>Trigger notification</span></a>
            <a class="workspace-action-link" asp-page="/NotificationReportEditor">@MatmonIcons.Render("clock")<span>Scheduled report</span></a>
        </div>
    </section>
</section>

<script>
    (function () {
        var root = document.querySelector("[data-notif-filter]");
        if (!root) { return; }
        var rows = Array.prototype.slice.call(document.querySelectorAll("[data-notif-row]"));
        var search = root.querySelector("[data-notif-search]");
        var typeSelect = root.querySelector("[data-notif-type-filter]");
        function apply() {
            var q = ((search && search.value) || "").trim().toLowerCase();
            var activeType = (typeSelect && typeSelect.value) || "all";
            rows.forEach(function (row) {
                var t = row.getAttribute("data-notif-type");
                var n = (row.getAttribute("data-notif-name") || "").toLowerCase();
                var show = (activeType === "all" || activeType === t) && (q === "" || n.indexOf(q) >= 0);
                row.hidden = !show;
            });
        }
        if (typeSelect) { typeSelect.addEventListener("change", apply); }
        if (search) { search.addEventListener("input", apply); }
        apply();
    })();
</script>

@page "/syslog"
@model Matmon.Host.Pages.SyslogModel
@using Matmon.Core.Syslog
@{
    ViewData["Title"] = "Syslog";
    var isAdmin = Model.IsAdmin;
    var settings = Model.Settings;
    var receiver = Model.Receiver;
    var storage = Model.Storage;

    var listening = new List<string>();
    if (receiver.Udp.IsListening) { listening.Add($"UDP {settings.UdpPort}"); }
    if (receiver.Tcp.IsListening) { listening.Add($"TCP {settings.TcpPort}"); }

    string headState;
    string headLabel;
    string headText;
    if (!storage.Available)
    {
        headState = "error";
        headLabel = "Log unusable";
        headText = "The log database cannot be used: " + storage.Error;
    }
    else if (!settings.Enabled)
    {
        headState = "paused";
        headLabel = "Receiver off";
        headText = "Nothing new is collected. Messages that are already stored can still be read.";
    }
    else if (receiver.Udp.State == "error" || receiver.Tcp.State == "error")
    {
        headState = "error";
        headLabel = "Problem";
        headText = "A listener could not start - the details are under Settings.";
    }
    else if (listening.Count > 0)
    {
        headState = "ok";
        headLabel = "Receiving";
        headText = "Listening on " + string.Join(" and ", listening) + ".";
    }
    else
    {
        headState = "warning";
        headLabel = "Starting";
        headText = "The receiver is starting - this page shows its state again in a few seconds.";
    }

    var newest = storage.NewestUtc;
    var windowKnown = Model.Windows.Any(choice => choice.Minutes == Model.Window);
}

@functions {
    private static string FormatBytes(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : bytes < 1024L * 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.#} MB"
        : $"{bytes / (1024.0 * 1024 * 1024):0.##} GB";

    private static string ListenerState(Matmon.Host.Services.SyslogListenerStatus status) =>
        status.State switch { "listening" => "ok", "error" => "error", _ => "paused" };

    private static string ListenerLabel(Matmon.Host.Services.SyslogListenerStatus status) =>
        status.State switch { "listening" => "Listening", "error" => "Problem", _ => "Off" };
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("list")
            <div>
                <div class="eyebrow">Logs</div>
                <h1>Syslog</h1>
            </div>
        </div>
        <span class="panel-hint">What your switches, routers and servers report - kept here after they reboot and forget it</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel syslog-status">
        <span class="state-pill" data-state="@headState">@headLabel</span>
        <span class="syslog-status-text">@headText</span>
        <span class="syslog-status-meta">
            @storage.Messages.ToString("N0") stored@(newest is { } latest ? $" · newest {Model.Ago(latest)}" : string.Empty)
        </span>
        @if (isAdmin && !settings.Enabled)
        {
            <a class="workspace-submit" href="#settings" data-syslog-goto="settings">@MatmonIcons.Render("gear")<span>Turn it on</span></a>
        }
    </section>

    @* A refused settings form is rendered on the page that posted it - open the tab it belongs to, or the reason sits unseen on a hidden tab. *@
    <div class="sensor-tabs" data-sensor-tabs data-tab-hash="true" data-active-tab="@(Model.FormError is null ? null : "settings")">
        <button type="button" class="sensor-tab is-active" data-sensor-tab-target="messages">@MatmonIcons.Render("list")<span>Messages</span></button>
        <button type="button" class="sensor-tab" data-sensor-tab-target="senders">@MatmonIcons.Render("host")<span>Senders</span></button>
        @if (isAdmin)
        {
            <button type="button" class="sensor-tab" data-sensor-tab-target="settings">@MatmonIcons.Render("gear")<span>Settings</span></button>
        }
    </div>

    @* ---- Messages ------------------------------------------------------------------------------------------------ *@
    <div data-sensor-tab="messages" id="syslog-messages" data-page-size="@Model.PageSize" data-stored="@storage.Messages" data-enabled="@(settings.Enabled ? "true" : "false")">
        <section class="panel panel-stack monitoring-controls">
            <div class="monitoring-filter-bar syslog-filter-bar">
                <label class="monitoring-filter-field syslog-filter-select">
                    <span>Time</span>
                    <select id="slWindow" class="form-select workspace-select">
                        @foreach (var choice in Model.Windows)
                        {
                            <option value="@choice.Minutes" selected="@(Model.Window == choice.Minutes)">@choice.Label</option>
                        }
                        @if (!windowKnown)
                        {
                            <option value="@Model.Window" selected>Last @Model.Window minutes</option>
                        }
                    </select>
                </label>
                <label class="monitoring-filter-field syslog-filter-sender">
                    <span>Sender</span>
                    <input id="slSource" class="workspace-input" list="slSenders" value="@Model.Source" placeholder="IP or host name" autocomplete="off" />
                    <datalist id="slSenders">
                        @foreach (var name in Model.KnownSenders)
                        {
                            <option value="@name"></option>
                        }
                    </datalist>
                </label>
                <label class="monitoring-filter-field syslog-filter-select">
                    <span>Severity</span>
                    <select id="slSeverity" class="form-select workspace-select">
                        @foreach (var choice in Model.SeverityChoices)
                        {
                            <option value="@choice.Value" selected="@((Model.Severity ?? string.Empty) == choice.Value)">@choice.Label</option>
                        }
                    </select>
                </label>
                <label class="monitoring-filter-field syslog-filter-search">
                    <span>Search</span>
                    <input id="slSearch" class="workspace-input" value="@Model.Q" placeholder="text in the message…" autocomplete="off" />
                </label>
                <label class="monitoring-filter-field monitoring-filter-inline" title="Treat the search as a regular expression">
                    <span>Regex</span>
                    <input type="checkbox" id="slRegex" checked="@Model.Regex" />
                </label>
                <label class="monitoring-filter-field monitoring-filter-inline">
                    <span>Live</span>
                    <input type="checkbox" id="slLive" checked />
                </label>
                <div class="monitoring-filter-actions">
                    <button type="button" id="slRefresh" class="workspace-secondary-submit">Refresh</button>
                </div>
            </div>
            <p id="slError" class="syslog-filter-error" role="alert" hidden></p>
        </section>

        <div class="panel workspace-panel syslog-messages-panel">
            <div class="panel-header">
                <h2 class="section-title"><span>Messages</span></h2>
                <span class="syslog-summary" id="slSummary" aria-live="polite"></span>
            </div>
            <div class="log-viewport">
                <table class="log-table syslog-table">
                    <thead>
                        <tr>
                            <th class="log-col-time syslog-col-time">Received</th>
                            <th class="log-col-lvl">Severity</th>
                            <th class="log-col-src">Sender</th>
                            <th class="syslog-col-app">Program</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody id="slRows"></tbody>
                </table>
                <p id="slEmpty" class="panel-hint syslog-empty" hidden></p>
            </div>
            <div class="syslog-more">
                <button type="button" id="slMore" class="workspace-secondary-submit" hidden>Load older messages</button>
            </div>
        </div>
    </div>

    @* ---- Senders ------------------------------------------------------------------------------------------------- *@
    <div data-sensor-tab="senders" hidden>
        <section class="panel panel-stack workspace-panel">
            <div class="panel-header">
                <h2 class="section-title">@MatmonIcons.Render("host")<span>Who has been sending</span></h2>
                <form method="get" asp-page="/Syslog" asp-fragment="senders" class="syslog-days-form">
                    <select name="Days" class="form-select workspace-select" aria-label="Time range" onchange="this.form.submit()">
                        @foreach (var choice in Model.SourceWindows)
                        {
                            <option value="@choice.Days" selected="@(Model.Days == choice.Days)">@choice.Label</option>
                        }
                    </select>
                </form>
            </div>

            @if (Model.Sources.Count == 0)
            {
                <div class="empty-state">
                    @if (!settings.Enabled && storage.Messages == 0)
                    {
                        <span>Nothing has been received - the receiver is off.</span>
                    }
                    else if (storage.Messages == 0)
                    {
                        <span>Nothing has arrived yet. Point a device's syslog setting at this machine and it appears here within seconds.</span>
                    }
                    else
                    {
                        <span>Nobody sent anything in this time range.</span>
                    }
                </div>
            }
            else
            {
                <div class="system-table syslog-source-table" role="table" aria-label="Senders">
                    <div class="system-table-row system-table-head syslog-source-row" role="row">
                        <span role="columnheader">Sender</span>
                        <span role="columnheader">Messages</span>
                        <span role="columnheader">Errors</span>
                        <span role="columnheader">Last message</span>
                        <span role="columnheader">In your tree</span>
                        <span role="columnheader"></span>
                    </div>

                    @foreach (var row in Model.Sources)
                    {
                        var sender = row.Sender;
                        var messagesSensor = row.Sensors.FirstOrDefault(sensor => string.Equals(sensor.SensorTypeKey, SyslogSensorTypes.Messages, StringComparison.OrdinalIgnoreCase));
                        var shownWindow = Model.Days == 0 ? 0 : Model.Days * 1440;

                        <div class="system-table-row syslog-source-row" role="row">
                            <span role="cell">
                                @if (sender.SharedAddress && sender.Hostname is not null)
                                {
                                    @* behind a relay or Docker's gateway the name is the device; the address is only the way in *@
                                    <strong>@sender.Hostname</strong>
                                    <small title="Several devices send through this address - they are told apart by the host name in their messages">via @sender.SourceAddress</small>
                                }
                                else
                                {
                                    <strong>@sender.SourceAddress</strong>
                                    @if (sender.Hostname is not null)
                                    {
                                        <small>@sender.Hostname</small>
                                    }
                                }
                            </span>
                            <span role="cell">@sender.Messages.ToString("N0")</span>
                            <span role="cell">
                                @if (sender.Errors > 0)
                                {
                                    <span class="state-pill" data-state="error">@sender.Errors.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="syslog-none">0</span>
                                }
                            </span>
                            <span role="cell" title="@sender.LastReceivedUtc.ToDisplay().ToString("g")">@Model.Ago(sender.LastReceivedUtc)</span>
                            <span role="cell">
                                @if (row.Host is { } host)
                                {
                                    <strong>@host.Name</strong>
                                    @if (row.Sensors.Count > 0)
                                    {
                                        <small>
                                            @foreach (var sensor in row.Sensors)
                                            {
                                                <a class="sensor-chip" asp-page="/SensorDetails" asp-route-sensorId="@sensor.Id" title="Open the sensor">@sensor.Name</a>
                                            }
                                        </small>
                                    }
                                    else
                                    {
                                        <small>no syslog sensor yet</small>
                                    }
                                }
                                else
                                {
                                    <span class="syslog-none" title="No host in the tree has this address or name">not in your tree</span>
                                }
                            </span>
                            <span role="cell" class="syslog-source-actions">
                                <a class="workspace-secondary-submit" asp-page="/Syslog" asp-route-source="@sender.Filter" asp-route-window="@shownWindow" title="Show this sender's messages">
                                    @MatmonIcons.Render("list")
                                    <span>Messages</span>
                                </a>
                                @if (isAdmin)
                                {
                                    if (row.Host is { } monitorHost && messagesSensor is null)
                                    {
                                        <form method="post" asp-page-handler="Monitor">
                                            <input type="hidden" name="hostId" value="@monitorHost.Id" />
                                            <input type="hidden" name="source" value="@row.WatchSender" />
                                            <button type="submit" class="workspace-submit" title="Add a Syslog Messages sensor to @monitorHost.Name">
                                                @MatmonIcons.Render("plus")
                                                <span>Watch</span>
                                            </button>
                                        </form>
                                    }
                                    else if (row.Host is null)
                                    {
                                        <a class="workspace-secondary-submit" asp-page="/HostCreate" title="Add this device as a host, then watch its log">
                                            @MatmonIcons.Render("plus")
                                            <span>Add host</span>
                                        </a>
                                    }
                                }
                            </span>
                        </div>
                    }
                </div>
                <p class="panel-hint">A sender is matched to a host by its address, or by the host name it puts in its messages. "Watch" adds a Syslog Messages sensor that counts the device's errors and warnings and goes into warning on the first error.</p>
            }
        </section>
    </div>

    @* ---- Settings (admins) --------------------------------------------------------------------------------------- *@
    @if (isAdmin)
    {
        <div data-sensor-tab="settings" hidden>
            <div class="syslog-settings-grid">
                <section class="panel panel-stack workspace-panel">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("gear")<span>Receiver</span></h2>
                        <span class="panel-hint">changes apply within a few seconds</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.FormError))
                    {
                        <div class="workspace-banner workspace-banner-error">@Model.FormError</div>
                    }

                    <form method="post" asp-page-handler="SaveSettings" class="workspace-form">
                        <div>
                            <label class="workspace-check-field syslog-check">
                                <input asp-for="Input.Enabled" type="checkbox" value="true" />
                                <span><strong>Receive syslog messages</strong></span>
                            </label>
                            <small class="workspace-hint">Off by default: switching it on opens a network port that takes messages from the sources allowed below.</small>
                        </div>

                        <div class="syslog-proto">
                            <div>
                                <label class="workspace-check-field syslog-check">
                                    <input asp-for="Input.UdpEnabled" type="checkbox" value="true" />
                                    <span><strong>UDP</strong></span>
                                </label>
                                <small class="workspace-hint">What most switches, routers and firewalls send.</small>
                            </div>
                            <label class="workspace-field syslog-port">
                                <span class="workspace-label">Port</span>
                                <input asp-for="Input.UdpPort" type="number" min="1" max="65535" class="form-control workspace-input" />
                            </label>
                        </div>

                        <div class="syslog-proto">
                            <div>
                                <label class="workspace-check-field syslog-check">
                                    <input asp-for="Input.TcpEnabled" type="checkbox" value="true" />
                                    <span><strong>TCP</strong></span>
                                </label>
                                <small class="workspace-hint">For devices that cannot afford to lose a message.</small>
                            </div>
                            <label class="workspace-field syslog-port">
                                <span class="workspace-label">Port</span>
                                <input asp-for="Input.TcpPort" type="number" min="1" max="65535" class="form-control workspace-input" />
                            </label>
                        </div>

                        <label class="workspace-field">
                            <span class="workspace-label">Allowed sources <em>optional - empty accepts anyone who can reach the port</em></span>
                            <textarea asp-for="Input.AllowedSources" class="form-control workspace-input" rows="3" placeholder="192.168.1.0/24, 10.0.0.5"></textarea>
                            <small class="panel-hint">IP addresses and ranges, separated by commas or new lines. Syslog has no login, so this list is the only thing that decides who may write to the log.</small>
                        </label>

                        <div class="syslog-limits">
                            <label class="workspace-field">
                                <span class="workspace-label">Keep for (days)</span>
                                <input asp-for="Input.RetentionDays" type="number" min="@SyslogSettings.MinRetentionDays" max="@SyslogSettings.MaxRetentionDays" class="form-control workspace-input" />
                            </label>
                            <label class="workspace-field">
                                <span class="workspace-label">Keep at most (messages)</span>
                                <input asp-for="Input.MaxMessages" type="number" min="@SyslogSettings.MinMessages" max="@SyslogSettings.MaxMessagesLimit" step="10000" class="form-control workspace-input" />
                            </label>
                        </div>
                        <small class="panel-hint">Whichever limit is reached first deletes the oldest messages. A device that reboots in a loop can write thousands of lines a minute - the message limit is what keeps it from filling the disk.</small>

                        @if (settings.Enabled && string.IsNullOrWhiteSpace(settings.AllowedSources))
                        {
                            <div class="workspace-banner workspace-banner-warning">Anyone who can reach the port can send messages. Restrict it with Allowed sources.</div>
                        }

                        <div class="workspace-form-actions">
                            <button type="submit" class="workspace-submit">@MatmonIcons.Render("check")<span>Save</span></button>
                        </div>
                    </form>
                </section>

                <section class="panel panel-stack workspace-panel">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("signal")<span>Status</span></h2>
                        <span class="panel-hint">since the last start</span>
                    </div>

                    @if (!storage.Available)
                    {
                        <div class="workspace-banner workspace-banner-error">The log database cannot be used: @storage.Error</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(receiver.Warning))
                    {
                        <div class="workspace-banner workspace-banner-warning">@receiver.Warning</div>
                    }

                    <dl class="syslog-facts">
                        <div>
                            <dt>UDP</dt>
                            <dd>
                                <span class="state-pill" data-state="@ListenerState(receiver.Udp)">@ListenerLabel(receiver.Udp)</span>
                                @if (!string.IsNullOrWhiteSpace(receiver.Udp.Detail)) { <small>@receiver.Udp.Detail</small> }
                            </dd>
                        </div>
                        <div>
                            <dt>TCP</dt>
                            <dd>
                                <span class="state-pill" data-state="@ListenerState(receiver.Tcp)">@ListenerLabel(receiver.Tcp)</span>
                                @if (!string.IsNullOrWhiteSpace(receiver.Tcp.Detail)) { <small>@receiver.Tcp.Detail</small> }
                                @if (receiver.TcpConnections > 0) { <small>@receiver.TcpConnections open connection(s)</small> }
                            </dd>
                        </div>
                        <div>
                            <dt>Received</dt>
                            <dd>@receiver.Received.ToString("N0")@(receiver.LastReceivedUtc is { } lastReceived ? $" · last {Model.Ago(lastReceived)}" : string.Empty)</dd>
                        </div>
                        <div>
                            <dt>Refused</dt>
                            <dd>@receiver.Rejected.ToString("N0") <small>from addresses not in Allowed sources</small></dd>
                        </div>
                        <div>
                            <dt>Stored</dt>
                            <dd>@storage.Messages.ToString("N0") messages · @FormatBytes(storage.DatabaseBytes)</dd>
                        </div>
                        <div>
                            <dt>Oldest</dt>
                            <dd>@(storage.OldestUtc is { } oldest ? oldest.ToDisplay().ToString("g") : "-")</dd>
                        </div>
                        <div>
                            <dt>Lost</dt>
                            <dd>@storage.Dropped.ToString("N0") <small>@(storage.Dropped > 0 ? "messages that could not be written - the log was flooded or the disk refused them" : "none")</small></dd>
                        </div>
                    </dl>

                    <div class="workspace-form-actions syslog-status-actions">
                        <form method="post" asp-page-handler="Test">
                            <button type="submit" class="workspace-secondary-submit" title="Sends one message to this machine's own receiver and checks it was stored">@MatmonIcons.Render("signal")<span>Send a test message</span></button>
                        </form>
                        <form method="post" asp-page-handler="Clear" onsubmit="return confirm('Delete every stored syslog message? This cannot be undone.');">
                            <button type="submit" class="workspace-danger-submit">@MatmonIcons.Render("trash")<span>Delete all messages</span></button>
                        </form>
                    </div>
                </section>

                <section class="panel panel-stack workspace-panel syslog-howto">
                    <div class="panel-header">
                        <h2 class="section-title">@MatmonIcons.Render("network")<span>Pointing a device at it</span></h2>
                    </div>
                    <p class="panel-hint">In the device's remote logging (syslog) settings, enter this machine as the server: <code>@Model.ReceiverHost</code> on port <code>@settings.UdpPort</code> (UDP)@(settings.TcpEnabled ? $" or {settings.TcpPort} (TCP)" : string.Empty). Messages appear here within seconds. The device's own clock does not matter: they are ordered by when they arrive, which is what you want from a switch that has just rebooted.</p>
                    <details class="syslog-examples">
                        <summary>Examples</summary>
<pre class="config-code">Cisco IOS     logging host @Model.ReceiverHost
              logging trap informational

Linux         echo '*.* @@@Model.ReceiverHost:@settings.UdpPort' > /etc/rsyslog.d/90-matmon.conf
              systemctl restart rsyslog

MikroTik      /system logging action add name=matmon target=remote remote=@Model.ReceiverHost
              /system logging add action=matmon topics=info,warning,error,critical

Synology      Log Center > Log Sending > Create (server @Model.ReceiverHost, port @settings.UdpPort, UDP)</pre>
                    </details>
                    <p class="panel-hint"><strong>Running Matmon in Docker?</strong> The container listens on its own ports, but nothing outside can reach them until they are published: add <code>-p @settings.UdpPort:@settings.UdpPort/udp -p @settings.TcpPort:@settings.TcpPort/tcp</code> to <code>docker run</code>, or the same two lines under <code>ports:</code> in the compose file. On Docker Desktop (Windows, macOS) every message then arrives from Docker's own gateway address instead of the device's - the sender's <em>host name</em> still identifies it, so give the sensors that host name as their Sender.</p>
                </section>
            </div>
        </div>
    }
</section>

<script>
    (function () {
        var root = document.getElementById("syslog-messages");
        var els = {
            window: document.getElementById("slWindow"),
            source: document.getElementById("slSource"),
            severity: document.getElementById("slSeverity"),
            search: document.getElementById("slSearch"),
            regex: document.getElementById("slRegex"),
            live: document.getElementById("slLive"),
            refresh: document.getElementById("slRefresh"),
            rows: document.getElementById("slRows"),
            empty: document.getElementById("slEmpty"),
            more: document.getElementById("slMore"),
            summary: document.getElementById("slSummary"),
            error: document.getElementById("slError")
        };
        var PAGE = Number(root.dataset.pageSize) || 200;
        var MAX_ROWS = 5000;
        var stored = Number(root.dataset.stored) || 0;
        var enabled = root.dataset.enabled === "true";

        var rows = [];      // what is on screen, newest first
        var hasMore = false;
        var busy = false;
        var timer = null;
        var generation = 0; // bumps when the filter changes, so a slow answer for an old filter is dropped

        function params(extra) {
            var p = new URLSearchParams({
                window: els.window.value,
                source: els.source.value,
                severity: els.severity.value,
                q: els.search.value,
                regex: els.regex.checked ? "true" : "false"
            });
            Object.keys(extra || {}).forEach(function (key) { p.set(key, extra[key]); });
            return p;
        }

        function get(handler, extra) {
            var p = params(extra);
            p.set("handler", handler);
            return fetch("?" + p.toString(), { headers: { "X-Requested-With": "fetch" }, credentials: "same-origin" })
                .then(function (response) {
                    if (!response.ok) { throw new Error("HTTP " + response.status); }
                    return response.json();
                });
        }

        function cell(tag, className, text, title) {
            var el = document.createElement(tag);
            if (className) { el.className = className; }
            if (text !== null && text !== undefined) { el.textContent = text; }
            if (title) { el.title = title; }
            return el;
        }

        // Everything below puts message content on the page with textContent: any device on the network can send a
        // syslog line, so what it says is never treated as markup.
        function buildRow(m) {
            var tr = document.createElement("tr");
            tr.className = "log-row syslog-row";

            var received = m.ts + (m.deviceTime ? "  (the device's own clock said: " + m.deviceTime + ")" : "");
            tr.appendChild(cell("td", "log-time", m.time, received));

            var tdSev = document.createElement("td");
            tdSev.appendChild(cell("span", "log-lvl log-lvl-" + m.sevClass, m.sevName, "severity " + m.sev + ", facility " + m.facility));
            tr.appendChild(tdSev);

            var tdSrc = cell("td", "log-source syslog-sender", m.source, m.source);
            if (m.host && m.host !== m.source) {
                tdSrc.appendChild(cell("small", null, m.host));
            }
            tr.appendChild(tdSrc);

            var tdApp = cell("td", "log-source syslog-app", m.app || "", m.app || "");
            if (m.procId && m.app) { tdApp.title = m.app + "[" + m.procId + "]"; }
            if (m.msgId && m.msgId !== m.app) { tdApp.appendChild(cell("small", null, m.msgId)); }
            tr.appendChild(tdApp);

            var tdMsg = cell("td", "log-msg");
            tdMsg.appendChild(cell("div", null, m.text));
            tr.appendChild(tdMsg);
            return tr;
        }

        function syncEmpty() {
            if (rows.length > 0) { els.empty.hidden = true; return; }
            els.empty.hidden = false;
            els.empty.textContent = stored === 0
                ? (enabled
                    ? "Nothing has arrived yet. Point a device's syslog setting at this machine and its messages appear here within seconds."
                    : "The receiver is off, so nothing has been collected. Turn it on under Settings, then point your devices at this machine.")
                : "No message matches this filter.";
        }

        function renderAll() {
            els.rows.textContent = "";
            var fragment = document.createDocumentFragment();
            rows.forEach(function (m) { fragment.appendChild(buildRow(m)); });
            els.rows.appendChild(fragment);
            els.more.hidden = !hasMore;
            syncEmpty();
        }

        function showError(message) {
            els.error.hidden = !message;
            els.error.textContent = message || "";
        }

        function chip(className, text) {
            return cell("span", "syslog-count " + className, text);
        }

        function showCounts(counts) {
            if (!counts) { return; }
            els.summary.textContent = "";
            els.summary.appendChild(chip(counts.errors > 0 ? "syslog-count-error" : "", counts.errors.toLocaleString() + (counts.errors === 1 ? " error" : " errors")));
            els.summary.appendChild(chip(counts.warnings > 0 ? "syslog-count-warning" : "", counts.warnings.toLocaleString() + (counts.warnings === 1 ? " warning" : " warnings")));
            els.summary.appendChild(chip("", counts.total.toLocaleString() + (counts.total === 1 ? " message" : " messages")));
        }

        function reload() {
            var mine = ++generation;
            busy = true;
            get("Data", { counts: "true" })
                .then(function (d) {
                    if (mine !== generation) { return; }
                    showError(d.error);
                    rows = d.items || [];
                    hasMore = !!d.hasMore;
                    renderAll();
                    if (d.error) { els.summary.textContent = ""; } else { showCounts(d.counts); }
                })
                .catch(function () { /* keep the last view on a transient error */ })
                .then(function () { busy = false; });
        }

        function refreshCounts(mine) {
            get("Counts").then(function (d) {
                if (mine === generation) { showCounts(d.counts); }
            }).catch(function () { });
        }

        function tick() {
            if (busy || document.hidden) { return; }
            var mine = generation;
            var topId = rows.length ? rows[0].id : 0;
            busy = true;
            get("Data", { counts: "false" })
                .then(function (d) {
                    if (mine !== generation) { return; }
                    showError(d.error);
                    var items = d.items || [];
                    var fresh = items.filter(function (m) { return m.id > topId; });
                    if (fresh.length === 0) { return; }

                    if (fresh.length === items.length && items.length >= PAGE) {
                        // A whole page of news: there may be more between it and what is shown. Start over.
                        rows = items;
                        hasMore = !!d.hasMore;
                        renderAll();
                    } else {
                        var fragment = document.createDocumentFragment();
                        fresh.forEach(function (m) { fragment.appendChild(buildRow(m)); });
                        els.rows.insertBefore(fragment, els.rows.firstChild);
                        rows = fresh.concat(rows);
                        if (rows.length > MAX_ROWS) {
                            rows.length = MAX_ROWS;
                            while (els.rows.children.length > MAX_ROWS) { els.rows.removeChild(els.rows.lastChild); }
                            hasMore = true;
                            els.more.hidden = false;
                        }
                        syncEmpty();
                    }
                    refreshCounts(mine);
                })
                .catch(function () { })
                .then(function () { busy = false; });
        }

        function schedule() {
            if (timer) { clearInterval(timer); timer = null; }
            if (els.live.checked) { timer = setInterval(tick, 4000); }
        }

        els.more.addEventListener("click", function () {
            if (busy || rows.length === 0) { return; }
            var mine = generation;
            busy = true;
            els.more.disabled = true;
            get("Data", { before: rows[rows.length - 1].id, counts: "false" })
                .then(function (d) {
                    if (mine !== generation) { return; }
                    var items = d.items || [];
                    var fragment = document.createDocumentFragment();
                    items.forEach(function (m) { fragment.appendChild(buildRow(m)); });
                    els.rows.appendChild(fragment);
                    rows = rows.concat(items);
                    hasMore = !!d.hasMore && rows.length < MAX_ROWS;
                    els.more.hidden = !hasMore;
                })
                .catch(function () { })
                .then(function () { busy = false; els.more.disabled = false; });
        });

        ["change"].forEach(function (name) {
            els.window.addEventListener(name, reload);
            els.severity.addEventListener(name, reload);
            els.regex.addEventListener(name, reload);
            els.source.addEventListener(name, reload);
        });
        var debounce;
        [els.search, els.source].forEach(function (input) {
            input.addEventListener("input", function () {
                clearTimeout(debounce);
                debounce = setTimeout(reload, 300);
            });
        });
        els.refresh.addEventListener("click", reload);
        els.live.addEventListener("change", schedule);

        // "Turn it on" and similar links jump to a tab the same way a click on the tab does.
        document.querySelectorAll("[data-syslog-goto]").forEach(function (link) {
            link.addEventListener("click", function (event) {
                var target = document.querySelector('[data-sensor-tab-target="' + link.dataset.syslogGoto + '"]');
                if (target) { event.preventDefault(); target.click(); }
            });
        });

        reload();
        schedule();
    })();
</script>

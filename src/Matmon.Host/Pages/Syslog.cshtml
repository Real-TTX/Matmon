@page "/syslog"
@using Microsoft.AspNetCore.Mvc
@* The log is a tab of Events now and its settings are under System > Syslog; this keeps the address an earlier build
   offered (and the links built on it) working, filter and all. Nothing is rendered. *@
@functions {
    public IActionResult OnGet()
    {
        var filter = new Dictionary<string, object?>();
        foreach (var key in new[] { "source", "window", "severity", "q", "regex" })
        {
            var value = Request.Query[key].ToString();
            if (!string.IsNullOrWhiteSpace(value))
            {
                filter[key] = value;
            }
        }

        return RedirectToPage("/Events", pageHandler: null, routeValues: filter, fragment: "syslog");
    }
}

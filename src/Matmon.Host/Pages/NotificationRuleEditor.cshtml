                                <label class="mat-check"><input type="checkbox" id="edit-rule-state-@option.Value" name="NotificationRuleEditor.TriggerStates" value="@option.Value" checked="@(editRuleStates.Contains(option.Value ?? string.Empty))" /><span class="mat-check__text">@option.Text</span></label>
                            }

@page "/notifications/rule"
@model WorkspaceModel
@{
    ViewData["Title"] = "Notification rule";
    var isCreateMode = Model.SelectedNotificationRuleId is null || Model.NotificationRuleEditor.Id == Guid.Empty;
    var backUrl = Model.GetSafeReturnUrl("/Notifications");
    var targetPickerOptions = Model.View.Nodes
        .Select(node => new ElementPickerOption(node.Id, node.Name, node.Path, node.Kind, node.Kind.ToString(), node.KindIconKey, node.Tags, node.Depth))
        .ToList();
    // The trigger states are checkboxes now (they were a multi-select): ticked = in the bound list, exactly what the
    // select tag helper used to mark as selected.
    var newRuleStates = Model.NewNotificationRule.TriggerStates.Select(state => state.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var editRuleStates = Model.NotificationRuleEditor.TriggerStates.Select(state => state.ToString()).ToHashSet(StringComparer.OrdinalIgnoreCase);

    // The placeholders and the preview, the same for the create and the edit form (beside each other, under the templates).
    void RenderTemplateHelp()
    {
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("code")<h2 class="mat-card__title">Placeholders</h2></div>
            <div class="mat-card__body notification-placeholders">
                <p class="mat-muted">The preview uses the latest matching alert or sensor data available in the workspace.</p>
                @foreach (var group in Model.View.NotificationTemplateGroups)
                {
                    <div class="notification-placeholders__group">
                        <h3 class="notification-placeholders__title">@group.Title</h3>
                        <dl class="notification-placeholders__list">
                            @foreach (var placeholder in group.Placeholders)
                            {
                                <dt><code>@((placeholder.IsHtmlSnippet ? "{{{" : "{{") + placeholder.Key + (placeholder.IsHtmlSnippet ? "}}}" : "}}"))</code></dt>
                                <dd>@placeholder.Description</dd>
                            }
                        </dl>
                    </div>
                }
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("eye")<h2 class="mat-card__title">Preview</h2></div>
            <div class="mat-card__body mat-stack">
                <p class="mat-muted">@Model.View.NotificationRulePreviewSummary</p>
                <dl class="mat-kv">
                    <dt>Subject</dt>
                    <dd><strong>@Model.View.NotificationRulePreviewSubject</strong></dd>
                    <dt>Short message</dt>
                    <dd>@Model.View.NotificationRulePreviewShort</dd>
                </dl>
                <pre class="mat-code mm-prewrap mm-break"><code>@Model.View.NotificationRulePreviewText</code></pre>
                <div class="notification-preview-html">
                    @Html.Raw(Model.View.NotificationRulePreviewHtml)
                </div>
            </div>
        </section>
    }
}

<nav class="mat-tabs" aria-label="Notifications">
    <a class="mat-tab is-active" aria-current="true" asp-page="/Notifications">Rules</a>
    <a class="mat-tab" asp-page="/Notifications" asp-fragment="senders">Senders</a>
    <a class="mat-tab" asp-page="/Notifications" asp-fragment="receivers">Receivers</a>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (isCreateMode)
{
    <form method="post" asp-page-handler="CreateNotificationRule" class="mat-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("bell")<h2 class="mat-card__title">Create rule</h2></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationRule.Name">Name</label>
                        <input asp-for="NewNotificationRule.Name" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationRule.SenderId">Sender</label>
                        <select asp-for="NewNotificationRule.SenderId" class="mat-select" asp-items="Model.NewNotificationRule.SenderOptions"></select>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationRule.ReceiverId">Receiver</label>
                        <select asp-for="NewNotificationRule.ReceiverId" class="mat-select" asp-items="Model.NewNotificationRule.ReceiverOptions"></select>
                    </div>
                    <div class="mat-field">
                        <span class="mat-label">Target</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "NewNotificationRule.TargetToken", DomId = "picker-new-rule-target", SelectedValue = Model.NewNotificationRule.TargetToken, AllowTags = true, Placeholder = "All sensors (no target)", Options = targetPickerOptions })" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationRule.CooldownMinutes">Cooldown window (min)</label>
                        <input asp-for="NewNotificationRule.CooldownMinutes" type="number" min="1" class="mat-input mat-mono" data-msg-range="The window is 1 minute or more." />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationRule.Threshold">Threshold (max per window)</label>
                        <input asp-for="NewNotificationRule.Threshold" type="number" min="1" placeholder="1" class="mat-input mat-mono" data-msg-range="The threshold is 1 or more." />
                        <span class="mat-hint">Send at most this many alerts per window (e.g. window 15 / threshold 5). Blank = 1.</span>
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input asp-for="NewNotificationRule.Enabled" /><span class="mat-switch__track"></span><span>Enabled</span></label>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input asp-for="NewNotificationRule.IncludeDescendants" /><span class="mat-switch__track"></span><span>Include descendants</span></label>
                    </div>
                    <fieldset class="mat-field mat-fieldset mat-field--full">
                        <legend class="mat-legend">Trigger states</legend>
                        <div class="mat-checks mat-checks--inline">
                            @foreach (var option in Model.NewNotificationRule.TriggerStateOptions)
                            {
                                <label class="mat-check"><input type="checkbox" id="new-rule-state-@option.Value" name="NewNotificationRule.TriggerStates" value="@option.Value" checked="@(newRuleStates.Contains(option.Value ?? string.Empty))" /><span class="mat-check__text">@option.Text</span></label>
                            }
                        </div>
                    </fieldset>
                </div>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("file-text")<h2 class="mat-card__title">Message templates</h2></div>
            <div class="mat-card__body mat-form">
                <p class="mat-muted">Use <code>{{...}}</code> in text and <code>{{{...}}}</code> for raw HTML snippets.</p>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewNotificationRule.SubjectTemplate">Subject template</label>
                    <input asp-for="NewNotificationRule.SubjectTemplate" class="mat-input mat-mono" placeholder="{{state.label}}: {{element.path}}" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewNotificationRule.ShortTemplate">Short message (push, chat)</label>
                    <input asp-for="NewNotificationRule.ShortTemplate" class="mat-input mat-mono" placeholder="{{state.label}}: {{element.path}} - {{message}}" />
                    <span class="mat-hint">One line, at most 300 characters - what a webhook sends as <code>{{summary}}</code>.</span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewNotificationRule.TextTemplate">Text template</label>
                    <textarea asp-for="NewNotificationRule.TextTemplate" rows="6" class="mat-textarea mat-mono"></textarea>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewNotificationRule.HtmlTemplate">HTML template</label>
                    <textarea asp-for="NewNotificationRule.HtmlTemplate" rows="10" class="mat-textarea mat-mono"></textarea>
                </div>
            </div>
        </section>

        <div class="notification-template-layout">
            @{ RenderTemplateHelp(); }
        </div>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create rule</span></button>
            <button type="submit" asp-page-handler="TestNotificationRule" class="mat-btn mat-btn--secondary">@MatUi.Icon("bell")<span>Send test</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
        </div>
    </form>
}
else
{
    <form method="post" asp-page-handler="SaveNotificationRule" class="mat-form" novalidate>
        <input type="hidden" asp-for="NotificationRuleEditor.Id" />
        <input type="hidden" asp-for="ReturnUrl" />


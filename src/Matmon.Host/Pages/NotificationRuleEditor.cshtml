@page "/notifications/rule"
@using Matmon.Host.Ui
@model WorkspaceModel
@{
    ViewData["Title"] = "Notification rule";
    var isCreateMode = Model.SelectedNotificationRuleId is null || Model.NotificationRuleEditor.Id == Guid.Empty;
    var backUrl = Model.GetSafeReturnUrl("/Notifications");
    var targetPickerOptions = Model.View.Nodes
        .Select(node => new ElementPickerOption(node.Id, node.Name, node.Path, node.Kind, node.Kind.ToString(), node.KindIconKey, node.Tags, node.Depth))
        .ToList();
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("bell")
            <h1>Notification rule</h1>
        </div>
    </div>

    <div class="sensor-tabs">
        <a class="sensor-tab is-active" asp-page="/Notifications">@MatmonIcons.Render("bell")<span>Rules</span></a>
        <a class="sensor-tab" asp-page="/NotificationSettings">@MatmonIcons.Render("mail")<span>Senders</span></a>
        <a class="sensor-tab" asp-page="/NotificationReceivers">@MatmonIcons.Render("inbox")<span>Receivers</span></a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-editor-panel">
        <div class="panel-header">
            <h2 class="section-title">@MatmonIcons.Render("bell")<span>@(isCreateMode ? "Create rule" : "Edit rule")</span></h2>
            <span class="panel-hint">@Model.View.SelectedNotificationRuleKind</span>
        </div>

        @if (isCreateMode)
        {
            <form method="post" asp-page-handler="CreateNotificationRule" class="workspace-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="workspace-form-grid">
                    <label>
                        <span>Name</span>
                        <input asp-for="NewNotificationRule.Name" class="form-control workspace-input" />
                    </label>
                    <label>
                        <span>Sender</span>
                        <select asp-for="NewNotificationRule.SenderId" class="form-select workspace-select" asp-items="Model.NewNotificationRule.SenderOptions"></select>
                    </label>
                    <label>
                        <span>Receiver</span>
                        <select asp-for="NewNotificationRule.ReceiverId" class="form-select workspace-select" asp-items="Model.NewNotificationRule.ReceiverOptions"></select>
                    </label>
                    <label>
                        <span>Target</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "NewNotificationRule.TargetElementId", DomId = "picker-new-rule-target", SelectedId = Model.NewNotificationRule.TargetElementId, Placeholder = "All sensors (no target)", Options = targetPickerOptions })" />
                    </label>
                    <label>
                        <span>Enabled</span>
                        <select asp-for="NewNotificationRule.Enabled" class="form-select workspace-select">
                            <option value="true">true</option>
                            <option value="false">false</option>
                        </select>
                    </label>
                    <label>
                        <span>Include descendants</span>
                        <select asp-for="NewNotificationRule.IncludeDescendants" class="form-select workspace-select">
                            <option value="true">true</option>
                            <option value="false">false</option>
                        </select>
                    </label>
                    <label>
                        <span>Cooldown minutes</span>
                        <input asp-for="NewNotificationRule.CooldownMinutes" type="number" min="1" class="form-control workspace-input" />
                    </label>
                    <label class="workspace-span-2">
                        <span>Trigger states</span>
                        <select asp-for="NewNotificationRule.TriggerStates" class="form-select workspace-select" asp-items="Model.NewNotificationRule.TriggerStateOptions" multiple size="5"></select>
                    </label>
                </div>

                <section class="workspace-notification-template-block">
                    <div class="panel-header workspace-subsection-header">
                        <h3 class="section-title">Message templates</h3>
                        <span class="panel-hint">Use <code>{{...}}</code> in text and <code>{{{...}}}</code> for raw HTML snippets</span>
                    </div>

                    <div class="workspace-form-grid">
                        <label class="workspace-span-2">
                            <span>Subject template</span>
                            <input asp-for="NewNotificationRule.SubjectTemplate" class="form-control workspace-input" placeholder="{{state.label}}: {{element.path}}" />
                        </label>
                        <label class="workspace-span-2">
                            <span>Text template</span>
                            <textarea asp-for="NewNotificationRule.TextTemplate" rows="6" class="form-control workspace-textarea"></textarea>
                        </label>
                        <label class="workspace-span-2">
                            <span>HTML template</span>
                            <textarea asp-for="NewNotificationRule.HtmlTemplate" rows="10" class="form-control workspace-textarea"></textarea>
                        </label>
                    </div>

                    <div class="notification-template-layout">
                        <div class="notification-template-help panel">
                            <div class="notification-template-panel-title">Placeholders</div>
                            <div class="notification-template-help-note">The preview uses the latest matching alert or sensor data available in the workspace.</div>

                            @foreach (var group in Model.View.NotificationTemplateGroups)
                            {
                                <div class="notification-template-group">
                                    <div class="notification-template-group-title">@group.Title</div>
                                    <div class="notification-template-group-items">
                                        @foreach (var placeholder in group.Placeholders)
                                        {
                                            <div class="notification-template-placeholder">
                                                <code>@((placeholder.IsHtmlSnippet ? "{{{" : "{{") + placeholder.Key + (placeholder.IsHtmlSnippet ? "}}}" : "}}"))</code>
                                                <span>@placeholder.Description</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="notification-template-preview panel">
                            <div class="notification-template-panel-title">Preview</div>
                            <div class="notification-template-preview-summary">@Model.View.NotificationRulePreviewSummary</div>
                            <div class="notification-template-preview-subject">
                                <span>Subject</span>
                                <strong>@Model.View.NotificationRulePreviewSubject</strong>
                            </div>
                            <pre class="notification-template-preview-text">@Model.View.NotificationRulePreviewText</pre>
                            <div class="notification-template-preview-html">
                                @Html.Raw(Model.View.NotificationRulePreviewHtml)
                            </div>
                        </div>
                    </div>
                </section>

                <div class="workspace-form-actions">
                    <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                    <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create rule</span></button>
                </div>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="SaveNotificationRule" class="workspace-form">
                <input type="hidden" asp-for="NotificationRuleEditor.Id" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="workspace-form-grid">
                    <label>
                        <span>Name</span>
                        <input asp-for="NotificationRuleEditor.Name" class="form-control workspace-input" />
                    </label>
                    <label>
                        <span>Sender</span>
                        <select asp-for="NotificationRuleEditor.SenderId" class="form-select workspace-select" asp-items="Model.NotificationRuleEditor.SenderOptions"></select>
                    </label>
                    <label>
                        <span>Receiver</span>
                        <select asp-for="NotificationRuleEditor.ReceiverId" class="form-select workspace-select" asp-items="Model.NotificationRuleEditor.ReceiverOptions"></select>
                    </label>
                    <label>
                        <span>Target</span>
                        <partial name="_ElementPicker" model="@(new ElementPickerModel { FieldName = "NotificationRuleEditor.TargetElementId", DomId = "picker-edit-rule-target", SelectedId = Model.NotificationRuleEditor.TargetElementId, Placeholder = "All sensors (no target)", Options = targetPickerOptions })" />
                    </label>
                    <label>
                        <span>Enabled</span>
                        <select asp-for="NotificationRuleEditor.Enabled" class="form-select workspace-select">
                            <option value="true">true</option>
                            <option value="false">false</option>
                        </select>
                    </label>
                    <label>
                        <span>Include descendants</span>
                        <select asp-for="NotificationRuleEditor.IncludeDescendants" class="form-select workspace-select">
                            <option value="true">true</option>
                            <option value="false">false</option>
                        </select>
                    </label>
                    <label>
                        <span>Cooldown minutes</span>
                        <input asp-for="NotificationRuleEditor.CooldownMinutes" type="number" min="1" class="form-control workspace-input" />
                    </label>
                    <label class="workspace-span-2">
                        <span>Trigger states</span>
                        <select asp-for="NotificationRuleEditor.TriggerStates" class="form-select workspace-select" asp-items="Model.NotificationRuleEditor.TriggerStateOptions" multiple size="5"></select>
                    </label>
                </div>

                <section class="workspace-notification-template-block">
                    <div class="panel-header workspace-subsection-header">
                        <h3 class="section-title">Message templates</h3>
                        <span class="panel-hint">Use <code>{{...}}</code> in text and <code>{{{...}}}</code> for raw HTML snippets</span>
                    </div>

                    <div class="workspace-form-grid">
                        <label class="workspace-span-2">
                            <span>Subject template</span>
                            <input asp-for="NotificationRuleEditor.SubjectTemplate" class="form-control workspace-input" placeholder="{{state.label}}: {{element.path}}" />
                        </label>
                        <label class="workspace-span-2">
                            <span>Text template</span>
                            <textarea asp-for="NotificationRuleEditor.TextTemplate" rows="6" class="form-control workspace-textarea"></textarea>
                        </label>
                        <label class="workspace-span-2">
                            <span>HTML template</span>
                            <textarea asp-for="NotificationRuleEditor.HtmlTemplate" rows="10" class="form-control workspace-textarea"></textarea>
                        </label>
                    </div>

                    <div class="notification-template-layout">
                        <div class="notification-template-help panel">
                            <div class="notification-template-panel-title">Placeholders</div>
                            <div class="notification-template-help-note">The preview uses the latest matching alert or sensor data available in the workspace.</div>

                            @foreach (var group in Model.View.NotificationTemplateGroups)
                            {
                                <div class="notification-template-group">
                                    <div class="notification-template-group-title">@group.Title</div>
                                    <div class="notification-template-group-items">
                                        @foreach (var placeholder in group.Placeholders)
                                        {
                                            <div class="notification-template-placeholder">
                                                <code>@((placeholder.IsHtmlSnippet ? "{{{" : "{{") + placeholder.Key + (placeholder.IsHtmlSnippet ? "}}}" : "}}"))</code>
                                                <span>@placeholder.Description</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="notification-template-preview panel">
                            <div class="notification-template-panel-title">Preview</div>
                            <div class="notification-template-preview-summary">@Model.View.NotificationRulePreviewSummary</div>
                            <div class="notification-template-preview-subject">
                                <span>Subject</span>
                                <strong>@Model.View.NotificationRulePreviewSubject</strong>
                            </div>
                            <pre class="notification-template-preview-text">@Model.View.NotificationRulePreviewText</pre>
                            <div class="notification-template-preview-html">
                                @Html.Raw(Model.View.NotificationRulePreviewHtml)
                            </div>
                        </div>
                    </div>
                </section>

                <div class="workspace-form-actions">
                    <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                    <button type="submit" class="workspace-submit">@MatmonIcons.Render("check")<span>Save rule</span></button>
                    <span class="workspace-form-actions-spacer"></span>
                    <button type="submit" asp-page-handler="DeleteNotificationRule" formnovalidate class="workspace-danger-submit" onclick="return confirm('Delete this notification rule?');">@MatmonIcons.Render("trash")<span>Delete rule</span></button>
                </div>
            </form>
        }
    </section>
</section>

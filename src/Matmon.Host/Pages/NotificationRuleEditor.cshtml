            <div class="mat-card__head">
                @MatUi.Icon("bell")<h2 class="mat-card__title">Edit rule</h2>
                @if (!string.IsNullOrWhiteSpace(Model.View.SelectedNotificationRuleKind))
                {
                    <span class="mat-text-muted mm-push-end">@Model.View.SelectedNotificationRuleKind</span>
                }
            </div>
            <div class="mat-card__body">
                <div class="mat-form__grid">

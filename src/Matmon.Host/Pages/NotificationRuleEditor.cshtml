                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationRuleEditor.Threshold">Threshold (max per window)</label>
                        <input asp-for="NotificationRuleEditor.Threshold" type="number" min="1" placeholder="1" class="mat-input mat-mono" data-msg-range="The threshold is 1 or more." />
                        <span class="mat-hint">Send at most this many alerts per window (e.g. window 15 / threshold 5). Blank = 1.</span>
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input asp-for="NotificationRuleEditor.Enabled" /><span class="mat-switch__track"></span><span>Enabled</span></label>
                    </div>
                    <div class="mat-field">
                        <label class="mat-switch"><input asp-for="NotificationRuleEditor.IncludeDescendants" /><span class="mat-switch__track"></span><span>Include descendants</span></label>
                    </div>
                    <fieldset class="mat-field mat-fieldset mat-field--full">
                        <legend class="mat-legend">Trigger states</legend>
                        <div class="mat-checks mat-checks--inline">

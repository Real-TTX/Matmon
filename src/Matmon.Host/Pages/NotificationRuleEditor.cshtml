                    </fieldset>
                </div>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("file-text")<h2 class="mat-card__title">Message templates</h2></div>
            <div class="mat-card__body mat-form">
                <p class="mat-muted">Use <code>{{...}}</code> in text and <code>{{{...}}}</code> for raw HTML snippets.</p>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NotificationRuleEditor.SubjectTemplate">Subject template</label>
                    <input asp-for="NotificationRuleEditor.SubjectTemplate" class="mat-input mat-mono" placeholder="{{state.label}}: {{element.path}}" />
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NotificationRuleEditor.ShortTemplate">Short message (push, chat)</label>
                    <input asp-for="NotificationRuleEditor.ShortTemplate" class="mat-input mat-mono" placeholder="{{state.label}}: {{element.path}} - {{message}}" />
                    <span class="mat-hint">One line, at most 300 characters - what a webhook sends as <code>{{summary}}</code>.</span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NotificationRuleEditor.TextTemplate">Text template</label>
                    <textarea asp-for="NotificationRuleEditor.TextTemplate" rows="6" class="mat-textarea mat-mono"></textarea>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NotificationRuleEditor.HtmlTemplate">HTML template</label>
                    <textarea asp-for="NotificationRuleEditor.HtmlTemplate" rows="10" class="mat-textarea mat-mono"></textarea>
                </div>
            </div>
        </section>

        <div class="notification-template-layout">
            @{ RenderTemplateHelp(); }
        </div>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save rule</span></button>
            <button type="submit" asp-page-handler="TestNotificationRule" class="mat-btn mat-btn--secondary">@MatUi.Icon("bell")<span>Send test</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" asp-page-handler="DeleteNotificationRule" formnovalidate class="mat-btn mat-btn--danger" data-confirm="Delete this notification rule?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete rule</span></button>
        </div>
    </form>
}

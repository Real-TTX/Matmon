@page "/notifications/sender"
@model WorkspaceModel
@{
    ViewData["Title"] = "Notification sender";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumbs"] = new[]
    {
        new BreadcrumbItem("Notifications", "/Notifications"),
        new BreadcrumbItem("Senders", "/Notifications#senders"),
        new BreadcrumbItem("Notification sender")
    };
    var isCreateMode = Model.SelectedNotificationSenderId is null || Model.NotificationSenderEditor.Id == Guid.Empty;
    var backUrl = Model.GetSafeReturnUrl("/NotificationSettings");
    var senderKind = isCreateMode ? Model.NewNotificationSender.Kind : Model.NotificationSenderEditor.Kind;
}

<nav class="mat-tabs" aria-label="Notifications">
    <a class="mat-tab" asp-page="/Notifications">Rules</a>
    <a class="mat-tab is-active" aria-current="true" asp-page="/Notifications" asp-fragment="senders">Senders</a>
    <a class="mat-tab" asp-page="/Notifications" asp-fragment="receivers">Receivers</a>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (isCreateMode)
{
    <form method="post" asp-page-handler="CreateNotificationSender" class="mat-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("mail")<h2 class="mat-card__title">Create sender</h2></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.Name">Name</label>
                        <input asp-for="NewNotificationSender.Name" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.Kind">Type</label>
                        <select asp-for="NewNotificationSender.Kind" class="mat-select" data-notification-kind-select>
                            <option value="Email">Email</option>
                            <option value="Webhook">Webhook (push, chat, any HTTP service)</option>
                        </select>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-switch"><input asp-for="NewNotificationSender.Enabled" /><span class="mat-switch__track"></span><span>Enabled</span></label>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card" data-notification-kind-panel="email" hidden="@(senderKind != NotificationEndpointKind.Email)">
            <div class="mat-card__head">@MatUi.Icon("mail")<h2 class="mat-card__title">E-mail (SMTP)</h2></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.SenderName">Sender name</label>
                        <input asp-for="NewNotificationSender.SenderName" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.SenderEmail">Sender email</label>
                        <input asp-for="NewNotificationSender.SenderEmail" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.SmtpHost">SMTP host</label>
                        <input asp-for="NewNotificationSender.SmtpHost" class="mat-input mat-mono" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.SmtpPort">SMTP port</label>
                        <input asp-for="NewNotificationSender.SmtpPort" type="number" min="1" class="mat-input mat-mono" data-msg-range="The port is 1 or higher." />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.Username">Username</label>
                        <input asp-for="NewNotificationSender.Username" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NewNotificationSender.Password">Password</label>
                        <input asp-for="NewNotificationSender.Password" type="password" class="mat-input" />
                        <span class="mat-hint">Leave blank to keep the current one.</span>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-switch"><input asp-for="NewNotificationSender.UseSsl" /><span class="mat-switch__track"></span><span>Use SSL</span></label>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card" data-notification-kind-panel="webhook" hidden="@(senderKind != NotificationEndpointKind.Webhook)">
            <div class="mat-card__head">@MatUi.Icon("link")<h2 class="mat-card__title">Webhook</h2></div>
            <div class="mat-card__body">
                <partial name="_WebhookSenderFields" for="NewNotificationSender" />
            </div>
        </section>

        <section class="mat-card" data-notification-kind-panel="cloud" hidden="@(senderKind != NotificationEndpointKind.Cloud)">
            <div class="mat-card__head">@MatUi.Icon("cloud")<h2 class="mat-card__title">Matmon Cloud</h2></div>
            <div class="mat-card__body">
                <p class="mat-muted">Enable the relay in <a asp-page="/Config" asp-route-tab="cloud">System → Cloud</a> first.</p>
            </div>
        </section>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create sender</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
        </div>
    </form>
}
else
{
    <form method="post" asp-page-handler="SaveNotificationSender" class="mat-form" novalidate>
        <input type="hidden" asp-for="NotificationSenderEditor.Id" />
        <input type="hidden" asp-for="ReturnUrl" />

        <section class="mat-card">
            <div class="mat-card__head">
                @MatUi.Icon("mail")<h2 class="mat-card__title">Edit sender</h2>
                @if (!string.IsNullOrWhiteSpace(Model.View.SelectedNotificationSenderKind))
                {
                    <span class="mat-text-muted mm-push-end">@Model.View.SelectedNotificationSenderKind</span>
                }
            </div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.Name">Name</label>
                        <input asp-for="NotificationSenderEditor.Name" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        @if (senderKind is NotificationEndpointKind.Cloud or NotificationEndpointKind.Push)
                        {
                            @* The built-in senders' type is fixed - read-only. *@
                            <label class="mat-label" for="sender-kind-fixed">Type</label>
                            <input type="text" id="sender-kind-fixed" class="mat-input" value="@(senderKind == NotificationEndpointKind.Push ? "Browser notifications" : "Cloud")" readonly />
                            <input type="hidden" asp-for="NotificationSenderEditor.Kind" />
                        }
                        else
                        {
                            <label class="mat-label" asp-for="NotificationSenderEditor.Kind">Type</label>
                            <select asp-for="NotificationSenderEditor.Kind" class="mat-select" data-notification-kind-select>
                                <option value="Email">Email</option>
                                <option value="Webhook">Webhook (push, chat, any HTTP service)</option>
                            </select>
                        }
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-switch"><input asp-for="NotificationSenderEditor.Enabled" /><span class="mat-switch__track"></span><span>Enabled</span></label>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card" data-notification-kind-panel="email" hidden="@(senderKind != NotificationEndpointKind.Email)">
            <div class="mat-card__head">@MatUi.Icon("mail")<h2 class="mat-card__title">E-mail (SMTP)</h2></div>
            <div class="mat-card__body">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.SenderName">Sender name</label>
                        <input asp-for="NotificationSenderEditor.SenderName" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.SenderEmail">Sender email</label>
                        <input asp-for="NotificationSenderEditor.SenderEmail" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.SmtpHost">SMTP host</label>
                        <input asp-for="NotificationSenderEditor.SmtpHost" class="mat-input mat-mono" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.SmtpPort">SMTP port</label>
                        <input asp-for="NotificationSenderEditor.SmtpPort" type="number" min="1" class="mat-input mat-mono" data-msg-range="The port is 1 or higher." />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.Username">Username</label>
                        <input asp-for="NotificationSenderEditor.Username" class="mat-input" />
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" asp-for="NotificationSenderEditor.Password">Password</label>
                        <input asp-for="NotificationSenderEditor.Password" type="password" class="mat-input" />
                        <span class="mat-hint">Leave blank to keep the current one.</span>
                    </div>
                    <div class="mat-field mat-field--full">
                        <label class="mat-switch"><input asp-for="NotificationSenderEditor.UseSsl" /><span class="mat-switch__track"></span><span>Use SSL</span></label>
                    </div>
                </div>
            </div>
        </section>

        <section class="mat-card" data-notification-kind-panel="webhook" hidden="@(senderKind != NotificationEndpointKind.Webhook)">
            <div class="mat-card__head">@MatUi.Icon("link")<h2 class="mat-card__title">Webhook</h2></div>
            <div class="mat-card__body">
                <partial name="_WebhookSenderFields" for="NotificationSenderEditor" />
            </div>
        </section>

        <section class="mat-card" data-notification-kind-panel="cloud" hidden="@(senderKind != NotificationEndpointKind.Cloud)">
            <div class="mat-card__head">@MatUi.Icon("cloud")<h2 class="mat-card__title">Matmon Cloud</h2></div>
            <div class="mat-card__body">
                <p class="mat-muted">Enable the relay in <a asp-page="/Config" asp-route-tab="cloud">System → Cloud</a> first.</p>
            </div>
        </section>

        <section class="mat-card" hidden="@(senderKind != NotificationEndpointKind.Push)">
            <div class="mat-card__head">@MatUi.Icon("bell")<h2 class="mat-card__title">Browser notifications</h2></div>
            <div class="mat-card__body">
                <p class="mat-muted">Reaches the devices where users turned notifications on (Account → Notifications). The rule's receiver must name users: a user group or a receiver with users' e-mail addresses. Needs Matmon on https.</p>
            </div>
        </section>

        <div class="mat-btn-row">
            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save sender</span></button>
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
            <span class="mat-btn-row__spacer"></span>
            <button type="submit" asp-page-handler="DeleteNotificationSender" formnovalidate class="mat-btn mat-btn--danger" data-confirm="Delete this notification sender?" data-confirm-ok="Delete">@MatUi.Icon("trash")<span>Delete sender</span></button>
        </div>
    </form>
}

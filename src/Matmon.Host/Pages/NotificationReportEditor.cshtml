@page "/notifications/report"
@model NotificationReportEditorModel
@{
    ViewData["Title"] = "Scheduled report";
    ViewData["Width"] = "narrow";
    ViewData["Breadcrumbs"] = new[]
    {
        new BreadcrumbItem("Notifications", "/Notifications"),
        new BreadcrumbItem("Rules", "/Notifications"),
        new BreadcrumbItem("Scheduled report")
    };
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}
@if (!Model.HasSmtp)
{
    <div class="mat-alert mat-alert--warning" role="status">@MatUi.Icon("alert")<div class="mat-alert__body">No SMTP sender is configured yet - add one under <a asp-page="/NotificationSettings">Senders</a> so the report can be delivered.</div></div>
}

<form method="post" class="mat-form" novalidate>
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("clock")<h2 class="mat-card__title">Summary report</h2></div>
        <div class="mat-card__body mat-form">
            <label class="mat-switch"><input asp-for="Enabled" type="checkbox" value="true" /><span class="mat-switch__track"></span><span>Enabled - send this report on schedule</span></label>

            <div class="mat-form__grid mat-form__grid--3">
                <div class="mat-field">
                    <label class="mat-label" asp-for="Cadence">Cadence</label>
                    <select asp-for="Cadence" class="mat-select">
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                    </select>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="HourOfDay">Hour of day (0–23)</label>
                    <input asp-for="HourOfDay" type="number" min="0" max="23" class="mat-input mat-mono" data-msg-range="Please enter an hour from 0 to 23." />
                    <span class="mat-error" aria-live="polite"></span>
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="DayOfWeek">Weekday (weekly)</label>
                    <select asp-for="DayOfWeek" class="mat-select">
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                        <option value="Sunday">Sunday</option>
                    </select>
                </div>
            </div>

            <div class="mat-field">
                <label class="mat-label" asp-for="SenderId">Sender</label>
                <select asp-for="SenderId" asp-items="Model.Senders" class="mat-select">
                    <option value="">Default SMTP (workspace / first e-mail sender)</option>
                </select>
                <span class="mat-hint">Which SMTP endpoint sends the report. Manage endpoints under <a asp-page="/NotificationSettings">Senders</a>.</span>
            </div>

            <div class="mat-field">
                <label class="mat-label" asp-for="ReceiverId">Receiver</label>
                <select asp-for="ReceiverId" asp-items="Model.Receivers" class="mat-select">
                    <option value="">- use the recipient list below -</option>
                </select>
                <span class="mat-hint">Pick a saved receiver, or leave empty and enter addresses below. Manage under <a asp-page="/NotificationReceivers">Receivers</a>.</span>
            </div>

            <div class="mat-field">
                <label class="mat-label" asp-for="Recipients">Recipients (when no receiver is picked)</label>
                <input asp-for="Recipients" class="mat-input" placeholder="ops@example.com, manager@example.com" />
            </div>

            <div class="mat-field">
                <label class="mat-label" asp-for="Subject">Subject</label>
                <input asp-for="Subject" class="mat-input" />
            </div>

            <label class="mat-check"><input asp-for="AttachPdf" type="checkbox" value="true" /><span class="mat-check__text">Attach a PDF audit report to the e-mail</span></label>

            @if (Model.LastSentUtc is { } sent)
            {
                <p class="mat-muted">Last sent: <span class="mat-mono">@sent.ToDisplay().ToString("g")</span></p>
            }
        </div>
    </section>

    <div class="mat-btn-row">
        <button type="submit" asp-page-handler="Save" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save</span></button>
        <a class="mat-btn mat-btn--secondary" asp-page="/Notifications">@MatUi.Icon("back")<span>Back</span></a>
        <button type="submit" asp-page-handler="Preview" class="mat-btn mat-btn--secondary">@MatUi.Icon("eye")<span>Preview</span></button>
        <button type="submit" asp-page-handler="SendTest" class="mat-btn mat-btn--secondary">@MatUi.Icon("mail")<span>Send now</span></button>
        <button type="submit" asp-page-handler="DownloadPdf" class="mat-btn mat-btn--secondary">@MatUi.Icon("download")<span>Download audit PDF</span></button>
    </div>
</form>

@if (Model.PreviewHtml is not null)
{
    <section class="mat-card">
        <div class="mat-card__head">
            @MatUi.Icon("eye")<h2 class="mat-card__title">Report preview</h2>
            @if (!string.IsNullOrWhiteSpace(Model.PreviewSubject))
            {
                <span class="mat-text-muted mm-push-end">@Model.PreviewSubject</span>
            }
        </div>
        <div class="mat-card__body mat-stack">
            <p class="mat-muted">Rendered from live data - exactly what the scheduled e-mail contains. Nothing was sent.</p>
            <iframe class="notification-report-frame" title="Report preview" sandbox srcdoc="@Model.PreviewHtml"></iframe>
        </div>
    </section>
}

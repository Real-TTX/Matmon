@page "/monitoring/host/new"
@model WorkspaceModel
@{
    ViewData["Title"] = "New host";
    ViewData["Width"] = "narrow";
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<form method="post" asp-page-handler="CreateHost" class="mat-form" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("monitor")<h2 class="mat-card__title">Host</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-field mat-field--full">
                    <label class="mat-label" asp-for="NewHost.Name">Host name</label>
                    <input asp-for="NewHost.Name" class="mat-input" placeholder="e.g. Office NAS" autofocus />
                </div>
                <div class="mat-field">
                    <label class="mat-label" asp-for="NewHost.Address">Address</label>
                    <input asp-for="NewHost.Address" class="mat-input mat-mono" placeholder="192.168.1.10" aria-describedby="host-address-hint" />
                    <span class="mat-hint" id="host-address-hint">Default target for sensors on this host.</span>
                </div>
                <div class="mat-field" role="group" aria-labelledby="host-parent-label">
                    <span class="mat-label" id="host-parent-label">Parent</span>
                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewHost.ParentId", DomId = "picker-host-parent", SelectedId = Model.NewHost.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.HostParentOptions) })" />
                </div>
                <div class="mat-field mat-field--full">
                    <label class="mat-label" asp-for="NewHost.Description">Description <span class="mat-text-muted">(optional)</span></label>
                    <input asp-for="NewHost.Description" class="mat-input" placeholder="Notes about this host" />
                </div>
            </div>
        </div>
    </section>
    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("plus")<span>Create host</span></button>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
    </div>
</form>

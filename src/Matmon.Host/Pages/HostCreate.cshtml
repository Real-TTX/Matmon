@page "/monitoring/host/new"
@model WorkspaceModel
@{
    ViewData["Title"] = "New host";
    var backUrl = Model.GetSafeReturnUrl("/Monitoring");
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">
            @MatmonIcons.Render("host")
            <h1>New host</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section class="panel panel-stack workspace-panel">
        <form method="post" asp-page-handler="CreateHost" class="workspace-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="workspace-field workspace-field-primary">
                <span class="workspace-label">Host name</span>
                <input asp-for="NewHost.Name" class="form-control workspace-input" placeholder="e.g. Office NAS" autofocus />
            </label>
            <div class="workspace-form-grid">
                <label class="workspace-field">
                    <span class="workspace-label">Address</span>
                    <input asp-for="NewHost.Address" class="form-control workspace-input" placeholder="192.168.1.10" />
                    <small class="workspace-hint">Reused as the default target for sensors on this host.</small>
                </label>
                <label class="workspace-field">
                    <span class="workspace-label">Parent</span>
                    <partial name="_ElementPicker" model="@(new Matmon.Host.Ui.ElementPickerModel { FieldName = "NewHost.ParentId", DomId = "picker-host-parent", SelectedId = Model.NewHost.ParentId, AllowClear = false, Placeholder = "Select parent…", Options = Model.PickerOptionsFor(Model.View.HostParentOptions) })" />
                </label>
            </div>
            <label class="workspace-field">
                <span class="workspace-label">Description <em>optional</em></span>
                <input asp-for="NewHost.Description" class="form-control workspace-input" placeholder="Notes about this host" />
            </label>
            <div class="workspace-form-actions">
                <a class="workspace-secondary-submit" href="@backUrl">@MatmonIcons.Render("arrow-left")<span>Back</span></a>
                <button type="submit" class="workspace-submit">@MatmonIcons.Render("plus")<span>Create host</span></button>
            </div>
        </form>
    </section>
</section>

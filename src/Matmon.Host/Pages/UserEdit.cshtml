@page "/system/users/edit"
@model UserEditModel
@{
    ViewData["Title"] = "Edit user";
    ViewData["Width"] = "narrow";
    var backUrl = Model.GetSafeReturnUrl("/Config?tab=users");
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

@if (Model.UserRecord is null)
{
    <div class="mat-empty mat-empty--framed">
        <span class="mat-empty__icon">@MatUi.Icon("user")</span>
        <div class="mat-empty__title">User not found</div>
        <p>The account may have been deleted in the meantime.</p>
        <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back to the users</span></a>
    </div>
}
else
{
    <section class="mat-card">
        <div class="mat-card__head">@MatUi.Icon("user")<h2 class="mat-card__title">@Model.UserRecord.Username</h2></div>
        <div class="mat-card__body">
            <dl class="mat-kv">
                <dt>Id</dt><dd class="mat-mono">@Model.UserRecord.Id</dd>
                <dt>Role</dt><dd>@Model.UserRecord.Role</dd>
                <dt>Status</dt><dd><span class="@MatUi.PillClass(Model.UserRecord.IsEnabled ? "ok" : "error")">@(Model.UserRecord.IsEnabled ? "Enabled" : "Disabled")</span></dd>
            </dl>
        </div>
    </section>

    @if (!Model.CanEdit)
    {
        <div class="mat-alert mat-alert--warning" role="status">@MatUi.Icon("alert")<div class="mat-alert__body">Your own account cannot be edited here.</div></div>
        <div class="mat-btn-row">
            <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
        </div>
    }
    else
    {
        <form method="post" class="mat-form" novalidate>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="ReturnUrl" />

            <section class="mat-card">
                <div class="mat-card__head">@MatUi.Icon("edit")<h2 class="mat-card__title">Account</h2></div>
                <div class="mat-card__body">
                    <div class="mat-form__grid">
                        <div class="mat-field">
                            <label class="mat-label" for="UserInput_Username">Username</label>
                            <input asp-for="UserInput.Username" class="mat-input" autocomplete="username" />
                        </div>

                        <div class="mat-field">
                            <label class="mat-label" for="UserInput_Role">Role</label>
                            <select asp-for="UserInput.Role" asp-items="Model.RoleOptions" class="mat-select"></select>
                        </div>

                        <div class="mat-field">
                            <label class="mat-label" for="UserInput_Password">Password</label>
                            <input asp-for="UserInput.Password" type="password" class="mat-input" autocomplete="new-password" placeholder="leave unchanged" />
                        </div>

                        <div class="mat-field">
                            <label class="mat-label" for="UserInput_PasswordConfirm">Confirm password</label>
                            <input asp-for="UserInput.PasswordConfirm" type="password" class="mat-input" autocomplete="new-password" placeholder="repeat new password" />
                        </div>

                        <div class="mat-field mat-field--full">
                            <label class="mat-switch">
                                <input asp-for="UserInput.IsEnabled" />
                                <span class="mat-switch__track"></span>
                                <span>Active</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>

            <div class="mat-btn-row">
                <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save</span></button>
                <a class="mat-btn mat-btn--secondary" href="@backUrl">@MatUi.Icon("back")<span>Back</span></a>
            </div>
        </form>
    }
}

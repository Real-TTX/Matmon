@page "/account"
@model AccountModel
@{
    ViewData["Title"] = "Account";
    // An error, an enrollment in progress or the answer of a two-factor action opens the Security tab (decided here, not in script).
    var security = Model.ShowSecurityTab;
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mat-alert mat-alert--success" role="status">@MatUi.Icon("check-circle")<div class="mat-alert__body">@Model.StatusMessage</div></div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="mat-alert mat-alert--danger" role="alert">@MatUi.Icon("x-circle")<div class="mat-alert__body">@Model.ErrorMessage</div></div>
}

<section data-tabs data-tab-hash>
    <div class="mat-tabs" role="tablist" aria-label="Account">
        <button type="button" class="mat-tab" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="@(security ? "false" : "true")" tabindex="@(security ? "-1" : null)">General</button>
        <button type="button" class="mat-tab" role="tab" id="tab-security" aria-controls="panel-security" aria-selected="@(security ? "true" : "false")" tabindex="@(security ? null : "-1")">Security</button>
        <button type="button" class="mat-tab" role="tab" id="tab-notifications" aria-controls="panel-notifications" aria-selected="false" tabindex="-1">Notifications</button>
    </div>

    @* ---------------- Notifications: browser notifications on this device, and the user's devices ---------------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-notifications" aria-labelledby="tab-notifications" hidden>
        <section class="mat-card" data-push-device data-push-endpoints="@System.Text.Json.JsonSerializer.Serialize(Model.Devices.Select(device => device.Endpoint))">
            <div class="mat-card__head">@MatUi.Icon("bell")<h2 class="mat-card__title">This device</h2></div>
            <div class="mat-card__body mat-stack">
                <p role="status" aria-live="polite" data-push-state>Checking whether this browser can show notifications…</p>
                <div class="mat-btn-row">
                    <button type="button" class="mat-btn mat-btn--primary" data-push-enable hidden>@MatUi.Icon("bell")<span>Turn on notifications here</span></button>
                    <button type="button" class="mat-btn mat-btn--secondary" data-push-disable hidden>@MatUi.Icon("x")<span>Turn them off here</span></button>
                </div>
                <p class="mat-hint">What arrives is what the notification rules with the <strong>Browser notifications</strong> sender say - out of the box warnings and errors of every sensor (the rule "Browser notifications" on the Notifications page). On iPhone and iPad they work in the installed app: Share → Add to Home Screen, then open Matmon from there and turn them on here.</p>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("smartphone")<h2 class="mat-card__title">My devices</h2><span class="mat-text-muted mm-push-end">@Model.Devices.Count</span></div>
            @if (Model.Devices.Count == 0)
            {
                <div class="mat-card__body">
                    <div class="mat-empty">
                        <div class="mat-empty__icon">@MatUi.Icon("smartphone")</div>
                        <div class="mat-empty__title">No device yet</div>
                        <p>Turn notifications on above, in every browser or installed app that should get them.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="mat-table-wrap">
                    <table class="mat-table">
                        <caption class="mat-sr-only">Devices with notifications on</caption>
                        <thead>
                            <tr>
                                <th scope="col">Device</th>
                                <th scope="col">Turned on</th>
                                <th scope="col">Last notification</th>
                                <th scope="col"><span class="mat-sr-only">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in Model.Devices)
                            {
                                <tr>
                                    <td data-label="Device" class="mat-table__primary">@device.Name</td>
                                    <td data-label="Turned on">@device.CreatedUtc.ToDisplay().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td data-label="Last notification">@(device.LastUsedUtc is { } used ? used.ToDisplay().ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                    <td class="mat-table__cell-actions">
                                        <div class="mat-table__actions">
                                            <form method="post" asp-page-handler="TestDevice" asp-route-id="@device.Id">
                                                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm">@MatUi.Icon("bell")<span>Send a test</span></button>
                                            </form>
                                            <form method="post" asp-page-handler="RemoveDevice" asp-route-id="@device.Id">
                                                <button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm mat-btn--icon" data-tip="Remove" aria-label="Remove @device.Name" data-confirm="Remove this device? It gets no more notifications." data-confirm-ok="Remove">@MatUi.Icon("trash")</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    @* ---------------- General ---------------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-general" aria-labelledby="tab-general" hidden="@security">
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("user")<h2 class="mat-card__title">Profile</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>E-mail</dt><dd>@Model.AccountName</dd>
                    <dt>Role</dt><dd><span class="mat-tag">@Model.Role</span></dd>
                    <dt>Sign-in</dt><dd>@(Model.HasPassword ? "E-mail + password (local)" : "Matmon.Cloud SSO only - no local password set")</dd>
                </dl>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("clock")<h2 class="mat-card__title">Preferences</h2></div>
            <div class="mat-card__body">
                <form method="post" asp-page-handler="TimeZone" class="mat-form" novalidate>
                    <div class="mat-field">
                        <label class="mat-label" for="TimeZoneId">Display timezone</label>
                        <select asp-for="TimeZoneId" asp-items="Model.TimeZoneItems" class="mat-select"></select>
                        <span class="mat-hint">Timestamps across the UI are shown in this zone. <strong>System default</strong> uses the server/admin setting. Data is always stored in UTC.</span>
                    </div>
                    <div class="mat-btn-row">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("save")<span>Save timezone</span></button>
                    </div>
                </form>
            </div>
        </section>
    </div>

    @* ---------------- Security ---------------- *@
    <div class="mat-tabpanel mat-stack" role="tabpanel" id="panel-security" aria-labelledby="tab-security" hidden="@(!security)">
        <section class="mat-card">
            <div class="mat-card__head">@MatUi.Icon("lock")<h2 class="mat-card__title">@(Model.HasPassword ? "Change password" : "Set a local password")</h2></div>
            <div class="mat-card__body mat-stack">
                @if (!Model.HasPassword)
                {
                    <p class="mat-muted">This account signs in via Matmon.Cloud. Set a local password so you can also sign in with e-mail + password when the cloud is unreachable.</p>
                }
                <form method="post" class="mat-form" novalidate>
                    @if (Model.HasPassword)
                    {
                        <div class="mat-field">
                            <label class="mat-label" for="CurrentPassword">Current password <span class="mat-req" aria-hidden="true">*</span></label>
                            <input asp-for="CurrentPassword" type="password" class="mat-input" autocomplete="current-password" required data-msg-required="Please enter your current password." />
                            <span class="mat-error" aria-live="polite"></span>
                        </div>
                    }
                    <div class="mat-field">
                        <label class="mat-label" for="NewPassword">New password <span class="mat-req" aria-hidden="true">*</span></label>
                        <input asp-for="NewPassword" type="password" class="mat-input" autocomplete="new-password" required minlength="8" data-msg-required="Please enter a new password." data-msg-range="Use at least 8 characters." />
                        <span class="mat-hint">At least 8 characters.</span>
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-field">
                        <label class="mat-label" for="ConfirmPassword">Confirm new password <span class="mat-req" aria-hidden="true">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="mat-input" autocomplete="new-password" required data-msg-required="Please repeat the new password." />
                        <span class="mat-error" aria-live="polite"></span>
                    </div>
                    <div class="mat-btn-row">
                        <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("key")<span>@(Model.HasPassword ? "Change password" : "Set password")</span></button>
                    </div>
                </form>
            </div>
        </section>

        <section class="mat-card">
            <div class="mat-card__head">
                @MatUi.Icon("shield")<h2 class="mat-card__title">Two-factor authentication</h2>
                <span class="@MatUi.PillClass(Model.TwoFactorEnabled ? "ok" : null) mm-push-end">@(Model.TwoFactorEnabled ? "On" : "Off")</span>
            </div>
            <div class="mat-card__body mat-stack">
                @if (Model.Enrollment is not null)
                {
                    <p>Scan this QR with your authenticator app (or enter the key manually), then enter the 6-digit code to confirm.</p>
                    @* A QR is a picture to scan: black on white in both themes (COLOR-07). *@
                    <div class="mm-qr">@Html.Raw(Model.QrSvg)</div>
                    <div class="mat-field">
                        <label class="mat-label" for="totp-manual-key">Manual key</label>
                        <div class="mat-input-group">
                            <input class="mat-input mat-mono" id="totp-manual-key" value="@Model.Enrollment.SecretBase32" readonly data-select-on-focus />
                            <button type="button" class="mat-btn mat-btn--secondary" data-copy="#totp-manual-key">@MatUi.Icon("copy")<span>Copy</span></button>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="ConfirmTotp" class="mat-form" novalidate>
                        <div class="mat-field">
                            <label class="mat-label" for="TotpCode">Code from your app <span class="mat-req" aria-hidden="true">*</span></label>
                            <div class="mat-otp" data-otp data-length="6" data-chars="digits">
                                <input asp-for="TotpCode" class="mat-otp__input" inputmode="numeric" autocomplete="one-time-code" required pattern="[0-9]{6}" data-msg-required="Please enter the six digits of the code." data-msg-pattern="The code has six digits." />
                            </div>
                            <span class="mat-error" aria-live="polite"></span>
                        </div>
                        <div class="mat-btn-row">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("check")<span>Enable two-factor</span></button>
                        </div>
                    </form>
                }
                else if (Model.TwoFactorEnabled)
                {
                    <p>Two-factor is <strong>enabled</strong>@(Model.TwoFactorSince is { } since ? $" since {since.ToDisplay():yyyy-MM-dd}" : ""). At sign-in you enter a code from your authenticator (or request a one-time code by e-mail).</p>
                    @* "E-mail me a code" posts its own handler: a hidden form of its own, so it sits in the same button row without
                       sending (or validating) the code field of the disable form. *@
                    <form method="post" asp-page-handler="SendDisableCode" id="send-disable-code" hidden></form>
                    <form method="post" asp-page-handler="DisableTotp" class="mat-form" novalidate>
                        <div class="mat-field">
                            <label class="mat-label" for="TotpCode">Authenticator code - or an e-mailed code <span class="mat-req" aria-hidden="true">*</span></label>
                            <div class="mat-otp" data-otp data-length="6" data-chars="digits">
                                <input asp-for="TotpCode" class="mat-otp__input" inputmode="numeric" autocomplete="one-time-code" required pattern="[0-9]{6}" data-msg-required="Please enter the six digits of the code." data-msg-pattern="The code has six digits." />
                            </div>
                            <span class="mat-hint">To confirm that it is you.</span>
                            <span class="mat-error" aria-live="polite"></span>
                        </div>
                        <div class="mat-btn-row">
                            <button type="submit" form="send-disable-code" class="mat-btn mat-btn--secondary">@MatUi.Icon("mail")<span>Lost your authenticator? E-mail me a code</span></button>
                            <span class="mat-btn-row__spacer"></span>
                            <button type="submit" class="mat-btn mat-btn--danger" data-confirm="Disable two-factor authentication?" data-confirm-ok="Disable">@MatUi.Icon("x-circle")<span>Disable two-factor</span></button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="mat-muted">Add a second step at sign-in with an authenticator app (TOTP). If you lose your device, you can get a one-time code by e-mail.</p>
                    <form method="post" asp-page-handler="StartTotp">
                        <div class="mat-btn-row">
                            <button type="submit" class="mat-btn mat-btn--primary">@MatUi.Icon("shield")<span>Set up two-factor</span></button>
                        </div>
                    </form>
                }
            </div>
        </section>
    </div>
</section>

@page "/account"
@model AccountModel
@{
    ViewData["Title"] = "Account";
    ViewData["WorkspaceSummarySuppress"] = "true";
}

<section class="dashboard-shell">
    <div class="page-header">
        <div class="page-title">@MatmonIcons.Render("lock")<h1>Account</h1></div>
        <span class="panel-hint">@Model.AccountName</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="workspace-banner workspace-banner-success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="workspace-banner workspace-banner-error">@Model.ErrorMessage</div>
    }

    <section data-tabs>
        <div class="sensor-tabs" data-sensor-tabs data-tab-hash="true" data-active-tab="@(Model.ShowSecurityTab ? "security" : null)">
            <button type="button" class="sensor-tab" data-sensor-tab-target="general">General</button>
            <button type="button" class="sensor-tab" data-sensor-tab-target="security">Security</button>
        </div>

        <div data-sensor-tab="general">
            <div class="panel">
                <div class="panel-header"><h2 class="section-title">@MatmonIcons.Render("spark")<span>Profile</span></h2></div>
                <div style="padding:14px 18px;">
                    <dl class="account-facts">
                        <div><dt>E-mail</dt><dd>@Model.AccountName</dd></div>
                        <div><dt>Role</dt><dd><span class="account-role-chip">@Model.Role</span></dd></div>
                        <div><dt>Sign-in</dt><dd>@(Model.HasPassword ? "E-mail + password (local)" : "Matmon.Cloud SSO only - no local password set")</dd></div>
                    </dl>
                </div>
            </div>

            <div class="panel" style="margin-top:16px;">
                <div class="panel-header"><h2 class="section-title">@MatmonIcons.Render("clock")<span>Preferences</span></h2></div>
                <div style="padding:16px 18px;">
                    <form method="post" asp-page-handler="TimeZone" class="workspace-form">
                        <label class="workspace-field">
                            <span>Display timezone</span>
                            <select asp-for="TimeZoneId" asp-items="Model.TimeZoneItems" class="form-select workspace-select"></select>
                            <span class="panel-hint" style="margin-top:4px;">Timestamps across the UI are shown in this zone. <strong>System default</strong> uses the server/admin setting. Data is always stored in UTC.</span>
                        </label>
                        <button type="submit" class="workspace-submit">Save timezone</button>
                    </form>
                </div>
            </div>
        </div>

        <div data-sensor-tab="security" hidden>
            <div class="panel">
                <div class="panel-header"><h2 class="section-title"><span>@(Model.HasPassword ? "Change password" : "Set a local password")</span></h2></div>
                <div style="padding:16px 18px;">
                    @if (!Model.HasPassword)
                    {
                        <p class="panel-hint" style="margin-top:0;">This account signs in via Matmon.Cloud. Set a local password so you can also sign in with e-mail + password when the cloud is unreachable.</p>
                    }
                    <form method="post" class="workspace-form">
                        @if (Model.HasPassword)
                        {
                            <label class="workspace-field">
                                <span>Current password</span>
                                <input asp-for="CurrentPassword" type="password" class="workspace-input" autocomplete="current-password" />
                            </label>
                        }
                        <label class="workspace-field">
                            <span>New password (min. 8 characters)</span>
                            <input asp-for="NewPassword" type="password" class="workspace-input" autocomplete="new-password" />
                        </label>
                        <label class="workspace-field">
                            <span>Confirm new password</span>
                            <input asp-for="ConfirmPassword" type="password" class="workspace-input" autocomplete="new-password" />
                        </label>
                        <button type="submit" class="workspace-submit">@(Model.HasPassword ? "Change password" : "Set password")</button>
                    </form>
                </div>
            </div>

            <div class="panel" style="margin-top:16px;">
                <div class="panel-header">
                    <h2 class="section-title">@MatmonIcons.Render("lock")<span>Two-factor authentication</span></h2>
                    <span class="panel-hint">@(Model.TwoFactorEnabled ? "On" : "Off")</span>
                </div>
                <div style="padding:16px 18px;">
                    @if (Model.Enrollment is not null)
                    {
                        <p class="panel-hint" style="margin-top:0;">Scan this QR with your authenticator app (or enter the key manually), then enter the 6-digit code to confirm.</p>
                        <div style="background:#fff;padding:10px;border-radius:10px;width:max-content;max-width:100%;margin:0 0 12px;">@Html.Raw(Model.QrSvg)</div>
                        <p style="margin:0 0 12px;">Manual key: <code style="user-select:all;">@Model.Enrollment.SecretBase32</code></p>
                        <form method="post" asp-page-handler="ConfirmTotp" class="workspace-form">
                            <label class="workspace-field">
                                <span>Code from your app</span>
                                <input asp-for="TotpCode" class="workspace-input" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" />
                            </label>
                            <button type="submit" class="workspace-submit">Enable two-factor</button>
                        </form>
                    }
                    else if (Model.TwoFactorEnabled)
                    {
                        <p style="margin-top:0;">Two-factor is <strong>enabled</strong>@(Model.TwoFactorSince is { } since ? $" since {since.ToDisplay():yyyy-MM-dd}" : ""). At sign-in you enter a code from your authenticator (or request a one-time code by e-mail).</p>
                        <form method="post" asp-page-handler="DisableTotp" class="workspace-form" onsubmit="return confirm('Disable two-factor authentication?');">
                            <label class="workspace-field">
                                <span>Authenticator code — or an e-mailed code (to confirm)</span>
                                <input asp-for="TotpCode" class="workspace-input" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" />
                            </label>
                            <button type="submit" class="workspace-danger-submit">Disable two-factor</button>
                        </form>
                        <form method="post" asp-page-handler="SendDisableCode" style="margin-top:8px;">
                            <button type="submit" class="workspace-secondary-submit">Lost your authenticator? E-mail me a code</button>
                        </form>
                    }
                    else
                    {
                        <p class="panel-hint" style="margin-top:0;">Add a second step at sign-in with an authenticator app (TOTP). If you lose your device, you can get a one-time code by e-mail.</p>
                        <form method="post" asp-page-handler="StartTotp">
                            <button type="submit" class="workspace-submit">Set up two-factor</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </section>
</section>

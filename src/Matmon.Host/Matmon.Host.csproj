<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Matmon.Core\Matmon.Core.csproj" />
    <ProjectReference Include="..\Matmon.Probe\Matmon.Probe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SMTP delivery for notifications (System.Net.Mail.SmtpClient is obsolete/limited). -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Pin the patched System.Security.Cryptography.Pkcs (10.x line - MimeKit needs >= 10.0.0) so the
         transitive 10.0.0 with GHSA-846f-f764-76mx (High) and GHSA-2fmv-rv2c-59x7 (Moderate) is not used.
         Flows into Matmon.Tests; Matmon.Core pins the 9.x line for the projects without MimeKit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- PDF audit reports (Community license configured in Program.cs). -->
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <!-- QR codes for TOTP two-factor enrollment (offline, managed renderer - no System.Drawing). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The standard MIBs (IETF + Net-SNMP, see mibs/README.md) ship next to the binaries; uploads go to data/mibs. -->
    <None Include="mibs\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The few decisions that are internal on purpose but worth a unit test of their own (where a sensor is polled). -->
    <InternalsVisibleTo Include="Matmon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Display-timezone extensions (ToDisplay) are used across pages/services. -->
    <Using Include="Matmon.Core.Domain" />
    <!-- The probe side (Secondary mode, discovery, version) lives in Matmon.Probe, which the agent shares. -->
    <Using Include="Matmon.Probe" />
  </ItemGroup>

</Project>

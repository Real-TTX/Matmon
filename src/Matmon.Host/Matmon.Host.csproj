<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Matmon.Core\Matmon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SMTP delivery for notifications (System.Net.Mail.SmtpClient is obsolete/limited). -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- PDF audit reports (Community license configured in Program.cs). -->
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <!-- QR codes for TOTP two-factor enrollment (offline, managed renderer - no System.Drawing). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Display-timezone extensions (ToDisplay) are used across pages/services. -->
    <Using Include="Matmon.Core.Domain" />
  </ItemGroup>

</Project>

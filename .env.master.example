# Copy to .env.master and adjust before starting docker-compose.master.yml.

# Web UI
MATMON_HTTP_BIND=0.0.0.0
MATMON_HTTP_PORT=8099

# Login
MATMON_ADMIN_USER=admin
MATMON_ADMIN_PASSWORD=admin

# Persistent Docker volume for /app/data
MATMON_DATA_VOLUME=matmon-data

# Runtime
MATMON_HEARTBEAT_SECONDS=30
MATMON_CONTAINER_NAME=matmon-master
MATMON_NETWORK_NAME=matmon

# Plain install defaults. Keep these false for production.
MATMON_SEED_SAMPLE_DATA=false
MATMON_PROVISION_LOCAL_DOCKER_PROBE=false
MATMON_PROVISION_DEMO_SENSORS=false
MATMON_AUTO_CREATE_PROBE_SYSTEM_SENSORS=false
MATMON_CREATE_STARTER_MAP=false

# Published GitHub Container Registry image
MATMON_IMAGE=ghcr.io/real-ttx/matmon:latest
MATMON_PULL_POLICY=always
